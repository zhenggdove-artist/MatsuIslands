    <div id="sinPortalPasswordGroup" data-layout-target="slots" style="--portal-slot-text-offset-x: 0%; --portal-slot-text-offset-y: -19%; --portal-slot-text-scale: 1.1; --portal-slot-text-weight: 700; left: 48.8572%; top: 77.6423%; width: 40.4791%; height: 5.05989%; --portal-slot-gap: 0.35px; --portal-slot-font-size: 3px; --portal-slot-radius: 1px;">
      <div id="sinPortalPasswordSlots" aria-live="polite"><span class="sin-portal-password-slot" data-slot="0"><img class="sin-portal-password-slot-art" src="./media/400d13361c2c2611372dc4ac34d342e928f294300ebc39aeb7603c6a7e1a60be.png" alt="" aria-hidden="true"><b class="sin-portal-password-character"><span class="sin-portal-password-character-glyph">0</span></b></span><span class="sin-portal-password-slot" data-slot="1"><img class="sin-portal-password-slot-art" src="./media/400d13361c2c2611372dc4ac34d342e928f294300ebc39aeb7603c6a7e1a60be.png" alt="" aria-hidden="true"><b class="sin-portal-password-character"><span class="sin-portal-password-character-glyph">0</span></b></span><span class="sin-portal-password-slot" data-slot="2"><img class="sin-portal-password-slot-art" src="./media/400d13361c2c2611372dc4ac34d342e928f294300ebc39aeb7603c6a7e1a60be.png" alt="" aria-hidden="true"><b class="sin-portal-password-character"><span class="sin-portal-password-character-glyph">0</span></b></span><span class="sin-portal-password-slot selected" data-slot="3"><img class="sin-portal-password-slot-art" src="./media/400d13361c2c2611372dc4ac34d342e928f294300ebc39aeb7603c6a7e1a60be.png" alt="" aria-hidden="true"><b class="sin-portal-password-character"><span class="sin-portal-password-character-glyph">0</span></b></span></div>
      <div class="sin-portal-layout-outline" aria-hidden="true"><i class="sin-portal-layout-handle" data-handle="nw" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="n" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="ne" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="e" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="se" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="s" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="sw" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="w" aria-hidden="true"></i></div>
