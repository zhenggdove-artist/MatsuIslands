function paintSinPortalStream(stream,result){
  if(stream.disposed||sinPortalSmooth.stream!==stream)return;
  showSinPortalCanvas(stream.width,stream.height);
  sinPortalSmooth.canvas.getContext('2d').putImageData(new ImageData(new Uint8ClampedArray(result.pixels),stream.width,stream.height),0,0);
  stream.recycle=result.pixels;sinPortalSmooth.index=result.index;
}
async function prepareSinPortalSmooth(){
  if(!sinPortalPasswordVisible())return;
  const source=getSinTowerPortalPasswordGifSource();if(sinPortalSmooth.source===source)return sinPortalSmooth.promise;
  const s=sinPortalSmooth,token=++s.generation;s.source=source;cancelAnimationFrame(s.raf);for(const frame of s.frames)frame.close();s.frames=[];
  if(s.stream){s.stream.disposed=true;s.stream.slot.loads--;s.stream.slot.worker.postMessage({type:'release',key:s.stream.key});s.stream=null;}
  if(s.canvas)s.canvas.hidden=true;const original=$('sinPortalPasswordFrame');if(original){original.style.visibility='';original.setAttribute('src',source);}
  s.promise=(async()=>{
    // Safari cannot rely on ImageDecoder or filtered native GIF repainting.
    // Explicit full-resolution worker frames keep the filter invalidated, with bounded memory.
    if(typeof ImageDecoder!=='function'||!await ImageDecoder.isTypeSupported('image/gif')){await prepareSinPortalStream(source,token);return;}
    const data=await (await fetch(source)).arrayBuffer(),decoder=new ImageDecoder({data,type:'image/gif',preferAnimation:true}),frames=[],durations=[];
    try{await decoder.tracks.ready;const count=decoder.tracks.selectedTrack.frameCount;
      for(let index=0;index<count;index++){const {image}=await decoder.decode({frameIndex:index});try{if(image.displayWidth*image.displayHeight*count*4>192*1024*1024)throw Error('Full-resolution animation exceeds cache budget');durations.push(Math.max(20,(image.duration||100000)/1000));frames.push(await createImageBitmap(image));}finally{image.close();}if(token!==s.generation)throw Error('superseded');}
      if(!frames.length)return;s.frames=frames;s.durations=durations;s.cycle=durations.reduce((a,b)=>a+b,0);s.start=performance.now();
      showSinPortalCanvas(frames[0].width,frames[0].height);drawSinPortalSmooth();
    }catch(error){for(const frame of frames)frame.close();if(token===s.generation){s.frames=[];await prepareSinPortalStream(source,token);}}finally{decoder.close();}
  })().catch(error=>{if(token===s.generation){
