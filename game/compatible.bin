}

async function applySinTowerStoneTextureToId(id, file, statusPrefix='已套用石塊個別材質'){
  const stone = getSinTowerEditorObjectById(id, 'stone');
  if(!stone || !file){ setStatus('請先選取石塊。'); return false; }
  stone.textureDataUrl = await readAsDataURL(file, {maxSize:SIN_TOWER_EDITOR.perf.textureMaxSize, preserveAlpha:true, mimeType:'image/png'});
  stone.textureName = file.name || '';
  stone.useSharedMaterial = false;
  rebuildSinTowerEditorRuntime();
  scheduleSinTowerRuntimeSave();
  syncSinProEditor();
  syncSinTowerStonePickPanel();
  setStatus(`${statusPrefix}：${file.name}`);
  return true;
}

async function applySinTowerSelectedStoneTexture(file){
  const id = SIN_TOWER_EDITOR.selectedObjectType === 'stone' ? SIN_TOWER_EDITOR.selectedObjectId : null;
  return applySinTowerStoneTextureToId(id, file);
}

function applySinTowerSharedMaterialToAllStones(){
  const activeScene = getSinTowerActiveScene();
  const sharedSrc = activeScene?.sharedStoneTextureDataUrl || null;
  if(!sharedSrc){
    setStatus('請先匯入共用石材質，再套用到全部石塊。');
    return false;
  }
  let changed = 0;
  for(const stone of SIN_TOWER_EDITOR.stones.filter(item=>item.sceneId === activeScene?.id)){
    if(stone.useSharedMaterial === false || stone.textureDataUrl){
      stone.useSharedMaterial = true;
      stone.textureDataUrl = null;
      changed++;
    }
  }
  rebuildSinTowerEditorRuntime();
  scheduleSinTowerRuntimeSave();
  syncSinProEditor();
  setStatus(`已將目前場景的共用材質套用到 ${changed} 塊石頭；其他場景不會被改動。`);
  return true;
}

function applySinTowerEditorStoneFromUi(){
  const stone = getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId, 'stone');
  if(!stone){ setStatus('尚未選取石塊。'); return; }
  Object.assign(stone, sinTowerStoneFromUi(stone));
  rebuildSinTowerEditorRuntime();
  scheduleSinTowerRuntimeSave();
  setStatus('已更新石塊。');
}

function deleteSinTowerSelectedStone(){
  const id = SIN_TOWER_EDITOR.selectedObjectType === 'stone' ? SIN_TOWER_EDITOR.selectedObjectId : null;
  if(!id){ setStatus('尚未選取石塊。'); return; }
  if(sinTowerStoneCarry.id === id){ sinTowerStoneCarry.active = false; sinTowerStoneCarry.id = null; }
  SIN_TOWER_EDITOR.stones = SIN_TOWER_EDITOR.stones.filter(s=>s.id !== id);
  SIN_TOWER_EDITOR.selectedObjectId = null;
  SIN_TOWER_EDITOR.selectedObjectType = null;
  rebuildSinTowerEditorRuntime();
  scheduleSinTowerRuntimeSave();
  setStatus('已刪除石塊。');
}

function generateSinTowerChurchFromUi(){
  const requestedDimensions=sinTowerEditorDimensions({w:sinProNumber('sinChurchWidth',20),h:sinProNumber('sinChurchHeight',11),d:sinProNumber('sinChurchDepth',32)},{w:20,h:11,d:32});
  const seed=sinProNumber('sinChurchSeed',23061993),targetCount=clamp(Math.floor(sinProNumber('sinChurchBlocks',150)),72,320),decay=clamp(sinProNumber('sinChurchRoughness',.68),0,1);
  let active=getSinTowerActiveScene();
  if(!active||active.type==='stairs'){createSinTowerEditorScene('church',{withPortal:true,dimensions:requestedDimensions});active=getSinTowerActiveScene();}
  active.type='church';active.dimensions=requestedDimensions;active.skybox=sanitizeSinTowerEditorSkybox(active.skybox,'church');
  const d=active.dimensions,color=sinProValue('sinStoneColor','#62594a'),dark='#302c26',roles=['floor','wall','column','roof','window','cross','furniture','altar','rubble'];
  const buckets=Object.fromEntries(roles.map(role=>[role,{essential:[],optional:[]}])) ;let serial=0;
  const random=n=>sinTowerRand(seed+n*23.71),signed=n=>sinTowerSignedRand(seed+n*19.31),jitter=(n,amount)=>signed(n)*amount*decay,pick=(values,salt)=>values[Math.floor(random(salt)*values.length)%values.length],damaged=(salt,factor=1)=>random(salt)<decay*factor;
  const add=(role,essential,title,shape,position,scale,rotation={x:0,y:0,z:0},surface='free',tint=color,useSharedMaterial=true)=>{serial++;const stone=sanitizeSinTowerEditorStone({id:uid('stone'),sceneId:active.id,title,shape,position,scale,rotation,surface,generated:true,generatedRole:role,color:tint,useSharedMaterial,seed:seed+serial*37.17});stone.generatedRole=role;buckets[role][essential?'essential':'optional'].push(stone);return stone;};
  const topology=pick(['rotunda','square','basilica','star','oval','greekCross'],11);
  const topologyLabels={rotunda:'圓形穹頂聖堂',square:'方形集中式教堂',basilica:'長方巴西利卡',star:'八芒星放射教堂',oval:'橢圓巴洛克聖堂',greekCross:'希臘十字教堂'};
  const profile={seed,decay,topology,floorPlan:topologyLabels[topology],completeness:Math.round((1-decay)*100),ruinLabel:decay<.2?'近乎完整':decay<.45?'輕度破敗':decay<.7?'殘破':decay<.88?'嚴重崩毀':'只剩遺構',columnStyle:pick(['科林斯凹槽柱','螺旋所羅門柱','雙柱束','雕花壁柱'],17),roofStyle:topology==='rotunda'||topology==='oval'?'肋骨圓頂':topology==='star'?'放射星形穹頂':pick(['巴洛克筒拱','交叉肋拱','分段山牆'],23),windowStyle:pick(['橢圓玫瑰窗','雙聯圓拱窗','破裂花瓣窗','高聳拱窗'],31),crossStyle:pick(['百合端拉丁十字','雙橫十字','環形十字','放射十字'],41),furnitureStyle:pick(['雕花長椅列','祈禱椅群','弧形會眾席','斷裂胡桃木椅'],47),altarStyle:pick(['渦卷山牆祭壇','半圓後殿祭壇','雙層雕花祭台','柱廊聖龕'],53)};
  profile.signature=[profile.floorPlan,profile.columnStyle,profile.roofStyle,profile.windowStyle,profile.crossStyle,profile.furnitureStyle,profile.altarStyle].join('／');
  const regular=(count,rx,rz,inner=1,phase=Math.PI/2)=>Array.from({length:count},(_,i)=>{const a=phase+i/count*Math.PI*2,r=i%2?inner:1;return{x:Math.cos(a)*rx*r,z:Math.sin(a)*rz*r};});
  let outline;
  if(topology==='rotunda')outline=regular(24,d.w*.43,d.d*.34,1);
  else if(topology==='oval')outline=regular(28,d.w*.43,d.d*.43,1);
  else if(topology==='star')outline=regular(16,d.w*.45,d.d*.43,.55);
  else if(topology==='square'){const r=Math.min(d.w,d.d)*.43;outline=[{x:-r,z:r},{x:r,z:r},{x:r,z:-r},{x:-r,z:-r}];}
  else if(topology==='greekCross'){const ax=d.w*.2,az=d.d*.19,rx=d.w*.45,rz=d.d*.43;outline=[{x:-ax,z:rz},{x:ax,z:rz},{x:ax,z:az},{x:rx,z:az},{x:rx,z:-az},{x:ax,z:-az},{x:ax,z:-rz},{x:-ax,z:-rz},{x:-ax,z:-az},{x:-rx,z:-az},{x:-rx,z:az},{x:-ax,z:az}];}
  else{const rx=d.w*.43,front=d.d*.43,rear=-d.d*.32;outline=[{x:-rx,z:front},{x:rx,z:front},{x:rx,z:rear}];for(let i=0;i<=8;i++){const a=i/8*Math.PI;outline.push({x:Math.cos(a)*rx,z:rear-Math.sin(a)*d.w*.22});}outline.push({x:-rx,z:rear});}
  const minZ=Math.min(...outline.map(p=>p.z)),maxZ=Math.max(...outline.map(p=>p.z));active.spawn={x:0,y:.24,z:maxZ-Math.min(3.2,d.d*.12)};
  const inside=(x,z)=>{let hit=false;for(let i=0,j=outline.length-1;i<outline.length;j=i++){const a=outline[i],b=outline[j],cross=(a.z>z)!==(b.z>z)&&x<(b.x-a.x)*(z-a.z)/(b.z-a.z+.000001)+a.x;if(cross)hit=!hit;}return hit;};
  const blockH=clamp(d.h/7.2,.82,1.5),wallThickness=clamp(Math.min(d.w,d.d)*.032,.4,.72),courses=Math.max(5,Math.min(7,Math.round(d.h/blockH*.72)));
  let floorIndex=0,cell=clamp(Math.min(d.w,d.d)/6.5,2.2,3.6);
  for(let z=minZ+cell*.55;z<maxZ-cell*.25;z+=cell)for(let x=-d.w*.46+cell*.5;x<d.w*.46;x+=cell){if(!inside(x,z))continue;const essential=floorIndex<8;if(!essential&&damaged(100+floorIndex,.18))continue;add('floor',essential,'雕邊地坪 '+(++floorIndex),'ashlar',{x:x+jitter(130+floorIndex,.06),y:.105,z:z+jitter(160+floorIndex,.06)},{x:cell*.96,y:.21,z:cell*.96},{x:jitter(190+floorIndex,.5),y:jitter(220+floorIndex,2),z:jitter(250+floorIndex,.5)},'floor');}
  let wallIndex=0,windowAnchors=[];
  for(let edge=0;edge<outline.length;edge++){
    const a=outline[edge],b=outline[(edge+1)%outline.length],dx=b.x-a.x,dz=b.z-a.z,length=Math.hypot(dx,dz),segments=Math.max(1,Math.round(length/2.15)),ux=dx/segments,uz=dz/segments,segmentLength=length/segments,rotY=-Math.atan2(dz,dx);
