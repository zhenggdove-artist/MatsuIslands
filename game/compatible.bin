function setSinTowerPortalPasswordOverlay(visible){
  const overlay=$('sinPortalPasswordOverlay');if(!overlay)return;
  overlay.classList.toggle('open',!!visible);overlay.setAttribute('aria-hidden',visible?'false':'true');
  if(!visible){restoreSinPortalPad();cancelAnimationFrame(sinPortalSmooth.raf);}
  if(visible){
    const fx=getScreenFxConfig(),sky=$('sinPortalPasswordSky'),src=STATE?.skyTexture||SIN_TOWER_BUNDLED_STAIR_BACKGROUND,frame=$('sinPortalPasswordFrame');
    syncSinTowerPortalScreenFx(fx);
    if(sky&&src&&sky.getAttribute('src')!==src)sky.setAttribute('src',src);
    applySinTowerPortalPasswordGifSource();applySinTowerPortalPasswordSlotArtSource();requestAnimationFrame(applySinTowerPortalPasswordLayout);
    void prepareSinPortalSmooth().then(drawSinPortalSmooth);
  }
}
function syncSinTowerPortalPasswordUi(message=''){
  for(const slot of document.querySelectorAll('#sinPortalPasswordSlots [data-slot]')){const index=Number(slot.dataset.slot),character=slot.querySelector('.sin-portal-password-character-glyph');if(character)character.textContent=sinTowerPortalGate.values[index]||'0';slot.classList.toggle('selected',index===sinTowerPortalGate.selected);}
  const output=$('sinPortalPasswordMessage');if(output)output.textContent=message;
}
function resetSinTowerPortalGate(restoreLook=true){
  clearSinTowerPortalGateTimers();sinTowerPortalGate.sequence++;
  setSinTowerPortalPasswordOverlay(false);$('sinPortalPasswordOverlay')?.classList.remove('wrong','success');setSinTowerPortalFade(false,250);
  const resume=sinTowerPortalGate.previousAutoRun;
  Object.assign(sinTowerPortalGate,{active:false,mode:'idle',phase:'idle',portalId:null,sourceSceneId:null,targetSceneId:null,values:['0','0','0','0'],selected:3,changed:false,deadline:0,countdown:-1,previousAutoRun:false});
  clearMovementKeys();SIN_TOWER_STAIRCASE.autoRun=!!resume;sinTowerEditorRuntime.lastPortalAt=performance.now();
  if(restoreLook&&isPlayMode())restoreSinTowerPlayLook(false);
}
function prepareSinTowerPortalTransition(portal,mode){
  if(sinTowerPortalGate.active||!portal||!getSinTowerSceneById(portal.targetSceneId))return false;
  clearSinTowerPortalGateTimers();sinTowerPortalGate.sequence++;
  Object.assign(sinTowerPortalGate,{active:true,mode,phase:'fade-out',portalId:portal.id,sourceSceneId:portal.sceneId,targetSceneId:portal.targetSceneId,values:['0','0','0','0'],selected:3,changed:false,deadline:0,countdown:-1,previousAutoRun:!!SIN_TOWER_STAIRCASE.autoRun});
  SIN_TOWER_STAIRCASE.autoRun=false;clearMovementKeys();playAction('idle');setSinTowerModalCursorFree();
  setSinTowerPortalPasswordOverlay(false);$('sinPortalPasswordOverlay')?.classList.remove('wrong','success');setSinTowerPortalFade(true,1000);return true;
}
function beginSinTowerPortalPassword(portal){
  if(!prepareSinTowerPortalTransition(portal,'password'))return false;
  syncSinTowerPortalPasswordUi();
  scheduleSinTowerPortalGate(()=>{sinTowerPortalGate.phase='input';sinTowerPortalGate.deadline=performance.now()+30000;sinTowerPortalGate.countdown=30;const countdown=$('sinPortalPasswordCountdown');if(countdown)countdown.textContent='30';setSinTowerPortalPasswordOverlay(true);setSinTowerPortalFade(false,1000);},1000);
  return true;
}
function finishSinTowerPortalTravel(){
  const target=sinTowerPortalGate.targetSceneId;if(!target)return resetSinTowerPortalGate(true);
  sinTowerPortalGate.phase='travel-fade-out';sinTowerPortalGate.deadline=0;$('sinPortalPasswordOverlay')?.classList.add('success');syncSinTowerPortalPasswordUi();setSinTowerPortalFade(true,1000);
  scheduleSinTowerPortalGate(()=>{setSinTowerActiveScene(target,{fromPortal:true});setSinTowerPortalPasswordOverlay(false);sinTowerPortalGate.phase='travel-fade-in';setSinTowerPortalFade(false,1000);scheduleSinTowerPortalGate(()=>resetSinTowerPortalGate(true),1000);},1000);
}
function beginSinTowerPortalDirectTravel(portal){
  if(!prepareSinTowerPortalTransition(portal,'direct'))return false;
  scheduleSinTowerPortalGate(()=>{setSinTowerActiveScene(sinTowerPortalGate.targetSceneId,{fromPortal:true});sinTowerPortalGate.phase='travel-fade-in';setSinTowerPortalFade(false,700);scheduleSinTowerPortalGate(()=>resetSinTowerPortalGate(true),700);},1000);
  return true;
}
function beginSinTowerPortalTravel(portal){
  const now=performance.now();
  if(!portal||isSinTowerPortalTemporarilyDisabled(portal,now)||sinTowerPortalCooldownRemaining(now)>0)return false;
  const started=portal.passwordEnabled?beginSinTowerPortalPassword(portal):beginSinTowerPortalDirectTravel(portal);
  if(started)sinTowerEditorRuntime.lastPortalAt=now;
  return started;
}
function checkSinTowerPortalPassword(){
  if(!sinTowerPortalGate.active||sinTowerPortalGate.mode!=='password'||sinTowerPortalGate.phase!=='input')return false;
  const portal=SIN_TOWER_EDITOR.portals.find(item=>item.id===sinTowerPortalGate.portalId),entered=sinTowerPortalGate.values.join(''),expected=sanitizeSinTowerPortalPassword(portal?.password);
  if(sinTowerPortalGate.changed&&entered===expected){finishSinTowerPortalTravel();return true;}
  const overlay=$('sinPortalPasswordOverlay');overlay?.classList.remove('wrong');void overlay?.offsetWidth;overlay?.classList.add('wrong');syncSinTowerPortalPasswordUi();scheduleSinTowerPortalGate(()=>{overlay?.classList.remove('wrong');if(sinTowerPortalGate.phase==='input')syncSinTowerPortalPasswordUi();},650);return false;
}
function finishSinTowerPortalPasswordTimeout(){
  if(sinTowerPortalGate.phase!=='input')return false;
  const source=getSinTowerSceneById(sinTowerPortalGate.sourceSceneId),stairs=source?.type==='stairs'?source:SIN_TOWER_EDITOR.scenes.find(sceneState=>sceneState.type==='stairs');
  sinTowerPortalGate.targetSceneId=stairs?.id||sinTowerPortalGate.sourceSceneId;sinTowerPortalGate.mode='timeout';sinTowerPortalGate.phase='timeout-fade-out';sinTowerPortalGate.deadline=0;setSinTowerPortalFade(true,1000);
  scheduleSinTowerPortalGate(()=>{setSinTowerActiveScene(sinTowerPortalGate.targetSceneId,{fromPortal:true,timeout:true});setSinTowerPortalPasswordOverlay(false);sinTowerPortalGate.phase='timeout-fade-in';setSinTowerPortalFade(false,1000);scheduleSinTowerPortalGate(()=>resetSinTowerPortalGate(true),1000);},1000);return true;
}
function updateSinTowerPortalPasswordCountdown(){
  if(!sinTowerPortalGate.active||sinTowerPortalGate.mode!=='password'||sinTowerPortalGate.phase!=='input'||!sinTowerPortalGate.deadline)return;
  const remaining=Math.max(0,Math.ceil((sinTowerPortalGate.deadline-performance.now())/1000));
  if(remaining!==sinTowerPortalGate.countdown){sinTowerPortalGate.countdown=remaining;const output=$('sinPortalPasswordCountdown');if(output)output.textContent=String(remaining).padStart(2,'0');}
  if(remaining<=0)finishSinTowerPortalPasswordTimeout();
}

function handleSinTowerPortalPasswordKey(event){
  if(!sinTowerPortalGate.active)return false;
  const handled=['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','Enter','Escape'].includes(event.code);
  if(handled){event.preventDefault();event.stopPropagation();event.stopImmediatePropagation?.();}
  if(sinTowerPortalGate.mode!=='password'||sinTowerPortalGate.phase!=='input')return handled;
  if(event.code==='Escape'){if(SIN_TOWER_PUBLISHED||EXPORTED_GALLERY_VIEWER)resetSinTowerPortalGate(true);else{resetSinTowerPortalGate(false);enterSinTowerEditorMode();}return true;}
  if(event.repeat&&event.code==='Enter')return true;
  if(event.code==='ArrowLeft')sinTowerPortalGate.selected=Math.max(0,sinTowerPortalGate.selected-1);
  else if(event.code==='ArrowRight')sinTowerPortalGate.selected=Math.min(3,sinTowerPortalGate.selected+1);
  else if(event.code==='ArrowUp'||event.code==='ArrowDown'){
    const current=SIN_TOWER_PORTAL_PASSWORD_CHARS.indexOf(sinTowerPortalGate.values[sinTowerPortalGate.selected]),delta=event.code==='ArrowUp'?1:-1;
    sinTowerPortalGate.values[sinTowerPortalGate.selected]=SIN_TOWER_PORTAL_PASSWORD_CHARS[(current+delta+16)%16];sinTowerPortalGate.changed=true;
  }else if(event.code==='Enter'){checkSinTowerPortalPassword();return true;}
  syncSinTowerPortalPasswordUi();
  if(sinTowerPortalGate.changed){const portal=SIN_TOWER_EDITOR.portals.find(item=>item.id===sinTowerPortalGate.portalId);if(sinTowerPortalGate.values.join('')===sanitizeSinTowerPortalPassword(portal?.password))finishSinTowerPortalTravel();}
  return handled;
}
if(location.hostname==='127.0.0.1'||location.hostname==='localhost'){
  window.__sinTowerTestSetPortalCountdown=ms=>{if(sinTowerPortalGate.phase==='input')sinTowerPortalGate.deadline=performance.now()+Math.max(0,ms);};
  window.__sinTowerTestPortalTravel=id=>{const portal=SIN_TOWER_EDITOR.portals.find(item=>item.id===id);return beginSinTowerPortalTravel(portal);};
  window.__sinTowerTestSelectPortal=id=>selectSinTowerPlayPortal(id);
  window.__sinTowerTestOpenPortalLayoutEditor=openSinTowerPortalLayoutEditor;
  window.__sinTowerTestClosePortalLayoutEditor=closeSinTowerPortalLayoutEditor;
}

function sanitizeSinTowerEditorStone(raw){
  const textureDataUrl = typeof raw?.textureDataUrl === 'string' && (raw.textureDataUrl.startsWith('data:image/')||sinPublishedAssetMatches(raw.textureDataUrl,"data:image/")) ? raw.textureDataUrl : null;
  const rawTitle = String(raw?.title || '').toLowerCase();
  const guessedSurface = raw?.surface || (rawTitle.includes('ceiling') ? 'ceiling' : rawTitle.includes('left') ? 'left' : rawTitle.includes('right') ? 'right' : 'floor');
  return {
    id:String(raw?.id || uid('stone')),
    sceneId:String(raw?.sceneId || SIN_TOWER_EDITOR.activeSceneId || 'stairs_main'),
    title:sinTowerEditorLegacyTitle(raw?.title || '石塊').slice(0,80),
    shape:['layered','boulder','stalactite','slab','masonry','pillar','ashlar','flutedPillar','capital','cornice','voussoir','rosette','baluster','carvedPanel'].includes(raw?.shape) ? raw.shape : 'layered',
    surface:['floor','ceiling','left','right','free'].includes(guessedSurface) ? guessedSurface : 'floor',
    position:sinTowerEditorVec3(raw?.position, {x:0,y:.6,z:-6}),
    rotation:sinTowerEditorVec3(raw?.rotation, {x:0,y:0,z:0}),
    scale:sinTowerEditorVec3(raw?.scale, {x:2.2,y:1.4,z:1.8}),
    color:validColor(raw?.color) ? raw.color : '#6e6256',
    useSharedMaterial:raw?.useSharedMaterial !== false,
    textureDataUrl,
    textureName:String(raw?.textureName || '').slice(0,160),
    textureMapping:sanitizeSinTowerStoneTextureMapping(raw?.textureMapping, 'box'),
    generated:raw?.generated === true || /(?:floor|ceiling|left|right)/i.test(rawTitle),
    generatedRole:String(raw?.generatedRole || 'structure').slice(0,30),
    seed:safeFinite(raw?.seed, Math.random() * 100000),
    audio:sanitizeSinTowerAudio(raw?.audio,true)
  };
}

function ensureSinTowerEditorState(raw=null){
  const source = raw || SIN_TOWER_EDITOR;
  const legacySharedTexture = typeof source.sharedStoneTextureDataUrl === 'string' && (source.sharedStoneTextureDataUrl.startsWith('data:image/')||sinPublishedAssetMatches(source.sharedStoneTextureDataUrl,"data:image/")) ? source.sharedStoneTextureDataUrl : null;
  const rawScenes = Array.isArray(source.scenes) ? source.scenes : [];
  const scenes = rawScenes.map(item=>{
    const scene = sanitizeSinTowerEditorScene(item);
    // v91 stored one global texture. Migrate it only to the active scene once.
    if(legacySharedTexture && !Object.prototype.hasOwnProperty.call(item || {}, 'sharedStoneTextureDataUrl') && scene.id === source.activeSceneId){
      scene.sharedStoneTextureDataUrl = legacySharedTexture;
    }
    return scene;
  });
  if(!scenes.length){
    scenes.push(sanitizeSinTowerEditorScene({id:'stairs_main', title:'樓梯場景', type:'stairs', spawn:{x:0,y:.18,z:5.8}, dimensions:{w:18,h:80,d:500}}));
  }
  const activeSceneId = scenes.some(s=>s.id === source.activeSceneId) ? source.activeSceneId : scenes[0].id;
  SIN_TOWER_EDITOR.version = 2;
  SIN_TOWER_EDITOR.activeSceneId = activeSceneId;
  SIN_TOWER_EDITOR.selectedObjectId = source.selectedObjectId || null;
  SIN_TOWER_EDITOR.selectedObjectType = source.selectedObjectType || null;
  SIN_TOWER_EDITOR.ui = {
    activeTab:['scenes','props','models','portals','stones','infection','perf'].includes(source.ui?.activeTab) ? source.ui.activeTab : 'scenes',
    legacyVisible:!!source.ui?.legacyVisible
  };
  SIN_TOWER_EDITOR.perf = {
    spriteMaxSize:clamp(safeFinite(source.perf?.spriteMaxSize, 768), 128, 2048),
    textureMaxSize:clamp(safeFinite(source.perf?.textureMaxSize, 1536), 256, 4096),
    textureQuality:clamp(safeFinite(source.perf?.textureQuality, .78), .3, .95)
  };
  SIN_TOWER_EDITOR.sharedStoneTextureDataUrl = typeof source.sharedStoneTextureDataUrl === 'string' && (source.sharedStoneTextureDataUrl.startsWith('data:image/')||sinPublishedAssetMatches(source.sharedStoneTextureDataUrl,"data:image/")) ? source.sharedStoneTextureDataUrl : null;
  SIN_TOWER_EDITOR.scenes = scenes;
  SIN_TOWER_EDITOR.props = (Array.isArray(source.props) ? source.props : []).map(sanitizeSinTowerEditorProp).filter(p=>scenes.some(s=>s.id===p.sceneId) && p.id !== 'bundled_giant_eye_01');
  SIN_TOWER_EDITOR.models = (Array.isArray(source.models) ? source.models : []).map(sanitizeSinTowerEditorModel).filter(model=>scenes.some(sceneState=>sceneState.id===model.sceneId));
  SIN_TOWER_EDITOR.bundledBookInitialized = source.bundledBookInitialized === true;
  if(!SIN_TOWER_EDITOR.bundledBookInitialized){
    const churchScene = scenes.find(sceneState=>sceneState.type === 'church');
    if(churchScene) ensureSinTowerBundledBookModel(churchScene);
  }
  SIN_TOWER_EDITOR.portals = (Array.isArray(source.portals) ? source.portals : []).map(sanitizeSinTowerEditorPortal).filter(p=>scenes.some(s=>s.id===p.sceneId) && scenes.some(s=>s.id===p.targetSceneId));
  SIN_TOWER_EDITOR.stones = (Array.isArray(source.stones) ? source.stones : []).map(sanitizeSinTowerEditorStone).filter(st=>scenes.some(s=>s.id===st.sceneId)).slice(0,600);
  if(SIN_TOWER_EDITOR.selectedObjectId && !getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId, SIN_TOWER_EDITOR.selectedObjectType)){
    SIN_TOWER_EDITOR.selectedObjectId = null;
    SIN_TOWER_EDITOR.selectedObjectType = null;
  }
  return SIN_TOWER_EDITOR;
}

function getSinTowerSceneById(id){
  return SIN_TOWER_EDITOR.scenes.find(s=>s.id === id) || SIN_TOWER_EDITOR.scenes[0];
}

function getSinTowerActiveScene(){
  return getSinTowerSceneById(SIN_TOWER_EDITOR.activeSceneId);
}

function getSinTowerStoneSharedTexture(stone){
  const sceneInfo = getSinTowerSceneById(stone?.sceneId);
  return sceneInfo?.sharedStoneTextureDataUrl || null;
}

function getSinTowerStoneTextureMapping(stone){
  if(stone?.useSharedMaterial !== false){
    const sceneInfo = getSinTowerSceneById(stone?.sceneId);
    return sanitizeSinTowerStoneTextureMapping(sceneInfo?.stoneTextureMapping, 'box');
  }
  return sanitizeSinTowerStoneTextureMapping(stone?.textureMapping, 'box');
}

function isSinTowerStairSceneActive(){
  return getSinTowerActiveScene()?.type === 'stairs';
}

const sinTowerEditorObjectIndexes={
  prop:{source:null,length:-1,map:new Map()},
  model:{source:null,length:-1,map:new Map()},
  portal:{source:null,length:-1,map:new Map()},
  stone:{source:null,length:-1,map:new Map()}
};

function getSinTowerEditorObjectList(type){
  if(type==='prop')return SIN_TOWER_EDITOR.props;
  if(type==='model')return SIN_TOWER_EDITOR.models;
  if(type==='portal')return SIN_TOWER_EDITOR.portals;
  if(type==='stone')return SIN_TOWER_EDITOR.stones;
  return null;
}

function getSinTowerEditorObjectIndex(type){
  const list=getSinTowerEditorObjectList(type),cache=sinTowerEditorObjectIndexes[type];
  if(!list||!cache)return null;
  if(cache.source!==list||cache.length!==list.length){
    cache.source=list;cache.length=list.length;cache.map=new Map();
    for(const object of list)if(object?.id)cache.map.set(object.id,object);
  }
  return cache.map;
}

function getSinTowerEditorObjectById(id,type=null){
  if(!id)return null;
  if(type)return getSinTowerEditorObjectIndex(type)?.get(id)||null;
  return getSinTowerEditorObjectIndex('prop').get(id)||getSinTowerEditorObjectIndex('model').get(id)||getSinTowerEditorObjectIndex('portal').get(id)||getSinTowerEditorObjectIndex('stone').get(id)||null;
}

function sinTowerWorldPositionFromStep(step=0, offset={x:0,y:0,z:0}){
  const c = SIN_TOWER_STAIRCASE;
  const s = Math.max(0, Math.floor(safeFinite(step, 0)));
  return new THREE.Vector3(
    c.startX + safeFinite(offset?.x,0),
    c.baseY + (s + 1) * c.rise + safeFinite(offset?.y,0),
    c.startZ + c.directionZ * (s * c.depth + c.depth * .5 + safeFinite(offset?.z,0))
  );
}

function sinTowerEditorWorldPosition(sceneState, item){
  const sceneInfo = sceneState || getSinTowerActiveScene();
  if(sceneInfo?.type === 'stairs' && item?.followStairs !== false) return sinTowerWorldPositionFromStep(item?.step || 0, item?.offset || {});
  const p = item?.position || item?.offset || {x:0,y:0,z:0};
  return new THREE.Vector3(safeFinite(p.x,0), safeFinite(p.y,0), safeFinite(p.z,0));
}

function ensureSinTowerEditorGroup(){
  if(!scene) return null;
  if(!sinTowerEditorGroup){
    sinTowerEditorGroup = new THREE.Group();
    sinTowerEditorGroup.name = 'Sin Tower Professional Editor Runtime';
    scene.add(sinTowerEditorGroup);
  }
  return sinTowerEditorGroup;
}

function clearSinTowerEditorSceneRoot(){
  sinTowerEditorRuntime.generation++;
  for(const rec of sinTowerEditorRuntime.props.values()){
    try{ rec.video?.pause?.(); }catch(e){}
    if(rec.video){ rec.video.removeAttribute('src'); rec.video.load?.(); }
    for(const frame of rec.frames || []){
      frame.disposeGif?.();
      frame.material?.dispose?.();
      frame.texture?.dispose?.();
    }
  }
  if(sinTowerEditorSceneRoot){
    sinTowerEditorGroup?.remove(sinTowerEditorSceneRoot);
    disposeObjectTree(sinTowerEditorSceneRoot);
  }
  sinTowerEditorSceneRoot = null;
  sinTowerEditorRuntime.props.clear();
  sinTowerEditorRuntime.models.clear();
  sinTowerEditorRuntime.portals.clear();
  sinTowerEditorRuntime.stones.clear();
  sinTowerEditorRuntime.floors.clear();
  sinTowerEditorRuntime.stoneSpatial.cells.clear();
  sinTowerEditorRuntime.stoneSpatial.global.length=0;
  sinTowerEditorRuntime.stoneSpatial.candidateScratch.length=0;
}

function makeSinTowerEditorFloor(sceneState){
  if(!sceneState || sceneState.type === 'stairs') return;
  const d = sceneState.dimensions || {w:20,h:11,d:32};
  if(sceneState.type === 'church'){
    const shellMat = new THREE.MeshStandardMaterial({color:0x171411, roughness:1, metalness:0, side:THREE.BackSide, transparent:true, opacity:.26, depthWrite:false});
    const shell = new THREE.Group();
    shell.name = `${sceneState.title}｜open box shell`;
    shell.userData.locked = true;
    shell.userData.sinTowerCaveShell = true;
    const addShellPlane = (name, geometry, position, rotation) => {
      const plane = new THREE.Mesh(geometry, shellMat);
      plane.name = `${sceneState.title}｜${name}`;
      plane.position.copy(position);
      plane.rotation.copy(rotation);
      plane.receiveShadow = true;
      plane.userData.locked = true;
      plane.userData.sinTowerCaveShell = true;
    shell.add(plane);
    };
    addShellPlane('floor boundary', new THREE.PlaneGeometry(d.w, d.d), new THREE.Vector3(0,0,0), new THREE.Euler(-Math.PI/2,0,0));
    addShellPlane('ceiling boundary', new THREE.PlaneGeometry(d.w, d.d), new THREE.Vector3(0,d.h,0), new THREE.Euler(Math.PI/2,0,0));
    addShellPlane('left boundary', new THREE.PlaneGeometry(d.d, d.h), new THREE.Vector3(-d.w/2,d.h/2,0), new THREE.Euler(0,Math.PI/2,0));
    addShellPlane('right boundary', new THREE.PlaneGeometry(d.d, d.h), new THREE.Vector3(d.w/2,d.h/2,0), new THREE.Euler(0,-Math.PI/2,0));
    // The rock shells already close these four inner surfaces. Rendering the
    // old helper planes creates giant two-triangle panels and false black
    // seams, so keep the boundary only as metadata and lighting context.
    shell.visible = false;
    sinTowerEditorSceneRoot.add(shell);
    const churchAmbient = new THREE.AmbientLight(0xf0d890, .42);
    churchAmbient.userData.locked = true;
    churchAmbient.userData.sinTowerChurchLight = true;
    sinTowerEditorSceneRoot.add(churchAmbient);
    const churchFill = new THREE.HemisphereLight(0xffecb2, 0x18283d, .92);
    churchFill.position.set(0, d.h, 0);
    churchFill.userData.locked = true;
    churchFill.userData.sinTowerChurchLight = true;
    sinTowerEditorSceneRoot.add(churchFill);
    const churchKeyTarget = new THREE.Object3D();
    churchKeyTarget.position.set(0, d.h * .34, -d.d * .12);
    const churchKey = new THREE.DirectionalLight(0xffe5a8, 2.65);
    churchKey.position.set(-d.w * .42, d.h * 1.25, d.d * .28);
    churchKey.target = churchKeyTarget;
    churchKey.castShadow = true;
    churchKey.shadow.mapSize.set(1024,1024);
    churchKey.shadow.camera.left = -d.w*.7;
    churchKey.shadow.camera.right = d.w*.7;
    churchKey.shadow.camera.top = d.h*1.25;
    churchKey.shadow.camera.bottom = -1;
    churchKey.shadow.camera.near = .5;
    churchKey.shadow.camera.far = Math.max(80,d.d*2.5);
    churchKey.shadow.bias = -.00035;
    churchKey.userData.locked = true;
    churchKey.userData.sinTowerChurchLight = true;
    churchKeyTarget.userData.locked = true;
    sinTowerEditorSceneRoot.add(churchKeyTarget, churchKey);
    const churchCoreLight = new THREE.PointLight(0xffd47a, 2.4, Math.max(d.w,d.h,d.d) * 1.15, 1.8);
    churchCoreLight.position.set(0, d.h * .38, d.d * .08);
    churchCoreLight.castShadow = false;
    churchCoreLight.userData.locked = true;
    churchCoreLight.userData.sinTowerChurchLight = true;
    sinTowerEditorSceneRoot.add(churchCoreLight);
  }
  const mat = new THREE.MeshStandardMaterial({color:sceneState.type === 'church' ? 0x453d32 : 0x1b1d20, roughness:.92, metalness:0});
  const floor = new THREE.Mesh(new THREE.BoxGeometry(d.w, .08, d.d), mat);
  floor.name = `${sceneState.title}｜floor`;
  floor.position.set(0, -.04, 0);
  floor.receiveShadow = true;
  floor.userData.locked = true;
  sinTowerEditorSceneRoot.add(floor);
  sinTowerEditorRuntime.floors.set(sceneState.id, floor);
}

function makeSinTowerEditorSceneSkybox(sceneState){
  if(!sceneState || sceneState.type === 'stairs' || !sinTowerEditorSceneRoot) return;
  const d = sceneState.dimensions || {w:20,h:11,d:32};
  const radius = Math.max(d.w, d.h, d.d) * 2.4 + 18;
  const material = new THREE.MeshBasicMaterial({
    color:new THREE.Color(sceneState.skybox?.color || (sceneState.type === 'church' ? '#d8bc62' : '#101216')),
    side:THREE.BackSide,
    depthWrite:false,
    depthTest:false,
    fog:false
  });
  const sky = new THREE.Mesh(new THREE.SphereGeometry(radius, 32, 18), material);
  sky.name = `${sceneState.title}|scene skybox`;
  sky.renderOrder = -10000;
  sky.frustumCulled = false;
  sky.userData.locked = true;
  sky.userData.sinTowerSceneSkybox = true;
  sky.userData.sinTowerSceneId = sceneState.id;
  sinTowerEditorSceneRoot.add(sky);
}

function tintSinTowerPrimitiveGeometry(geometry, seed=1, style='masonry', mapping='box'){
  const position = geometry.getAttribute('position');
  const colors = [];
  for(let i=0;i<position.count;i++){
    const x = position.getX(i), y = position.getY(i), z = position.getZ(i);
    const tone = .78 + sinTowerRand(seed + i * 3.17 + x * 7.1 + y * 11.3 + z * 13.7) * .22;
    colors.push(tone, tone * .94, tone * .82);
  }
  geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
  geometry.computeVertexNormals();
  geometry.computeBoundingBox();
  geometry.computeBoundingSphere();
  geometry.userData.sinTowerStoneBoulder = true;
  geometry.userData.sinTowerStoneStyle = style;
  geometry.userData.sinTowerStoneTextureMapping = mapping;
  return geometry;
}

function makeSinTowerBeveledBlockGeometry(seed=1,style='ashlar',mapping='box',bevel=.055){
  const shape=new THREE.Shape();
  shape.moveTo(-.5,-.5);shape.lineTo(.5,-.5);shape.lineTo(.5,.5);shape.lineTo(-.5,.5);shape.closePath();
  const geometry=new THREE.ExtrudeGeometry(shape,{depth:1,steps:1,bevelEnabled:true,bevelThickness:bevel,bevelSize:bevel,bevelOffset:-bevel*.35,bevelSegments:2,curveSegments:1});
  geometry.translate(0,0,-.5);
  return tintSinTowerPrimitiveGeometry(geometry,seed,style,mapping);
}

function makeSinTowerBalusterGeometry(seed=1,mapping='box'){
  const points=[new THREE.Vector2(.36,-.5),new THREE.Vector2(.38,-.43),new THREE.Vector2(.24,-.36),new THREE.Vector2(.15,-.18),new THREE.Vector2(.25,-.02),new THREE.Vector2(.18,.15),new THREE.Vector2(.14,.34),new THREE.Vector2(.31,.42),new THREE.Vector2(.34,.5)];
  return tintSinTowerPrimitiveGeometry(new THREE.LatheGeometry(points,20),seed,'baluster',mapping);
}

function makeSinTowerStoneGeometry(seed=1, shape='layered', textureMapping='box'){
  const allowed=['layered','boulder','stalactite','slab','masonry','pillar','ashlar','flutedPillar','capital','cornice','voussoir','rosette','baluster','carvedPanel'];
  const stoneShape=allowed.includes(shape)?shape:'layered';
  const mapping=sanitizeSinTowerStoneTextureMapping(textureMapping,'box');
  if(['masonry','ashlar','cornice','voussoir','carvedPanel'].includes(stoneShape))return makeSinTowerBeveledBlockGeometry(seed,stoneShape,mapping,stoneShape==='cornice'?.075:.052);
  if(stoneShape==='pillar')return tintSinTowerPrimitiveGeometry(new THREE.CylinderGeometry(.5,.58,1,12,2,false),seed,stoneShape,mapping);
  if(stoneShape==='flutedPillar')return tintSinTowerPrimitiveGeometry(new THREE.CylinderGeometry(.46,.52,1,24,4,false),seed,stoneShape,mapping);
  if(stoneShape==='capital')return tintSinTowerPrimitiveGeometry(new THREE.CylinderGeometry(.66,.42,1,20,3,false),seed,stoneShape,mapping);
  if(stoneShape==='rosette')return tintSinTowerPrimitiveGeometry(new THREE.CylinderGeometry(.5,.5,.18,24,2,false),seed,stoneShape,mapping);
  if(stoneShape==='baluster')return makeSinTowerBalusterGeometry(seed,mapping);
  const profile=stoneShape==='boulder'?{height:1.18,depth:.92,taper:.22,ridge:.28}:stoneShape==='stalactite'?{height:1.92,depth:.72,taper:.78,ridge:.62}:stoneShape==='slab'?{height:1.28,depth:.54,taper:.42,ridge:.36}:{height:1.52,depth:.82,taper:.56,ridge:.52};
  const radialSegments=12,rings=5,ringStride=radialSegments+1,vertices=[],indices=[],colors=[],uvs=[],ringPositions=[];
  const phase=sinTowerRand(seed+9.17)*Math.PI*2,leanX=sinTowerSignedRand(seed+21.4)*.14,leanZ=sinTowerSignedRand(seed+37.8)*.11;
  const ringRadii=[.78,1+sinTowerSignedRand(seed+43.1)*.06,1.06+sinTowerSignedRand(seed+47.2)*.07,.86+sinTowerSignedRand(seed+53.8)*.06,Math.max(.18,.48-profile.taper*.12)];
  const stoneUv=(x,y,z,u,t)=>{const v=clamp(y/profile.height+.5,0,1);if(mapping==='planar')return[clamp(x/2.2+.5,0,1),v];if(mapping==='rockUv')return[u*2,t*2];if(mapping==='cylindrical')return[u,v];return[u,t];};
  const pushVertex=(x,y,z,uv,tone)=>{vertices.push(x,y,z);uvs.push(uv[0],uv[1]);colors.push(tone,tone*.92,tone*.8);return vertices.length/3-1;};
  const ringVertex=(t,i)=>{const u=i/radialSegments,angle=i/radialSegments*Math.PI*2+phase,ridge=.035*Math.sin(angle*3+phase)+.022*Math.sin(angle*5-phase*.7),shoulder=.035*Math.sin(t*Math.PI*2+phase+angle*2),radius=Math.max(.16,ringRadii[Math.min(ringRadii.length-1,Math.round(t*(rings-1)))]*(1+ridge+shoulder*(1-t))),x=leanX*Math.pow(t,1.35)+Math.cos(angle)*radius,z=leanZ*Math.pow(t,1.25)+Math.sin(angle)*radius*(profile.depth+.05*Math.sin(angle*2+phase)),y=-profile.height*.5+t*profile.height+.018*Math.sin(angle*2+phase)*(1-t),strata=.92+.1*(.5+.5*Math.sin(t*Math.PI*5+phase+angle*.7));pushVertex(x,y,z,stoneUv(x,y,z,u,t),strata);return{x,y,z,strata};};
  for(let ring=0;ring<rings;ring++){const t=ring/(rings-1),positions=[];for(let i=0;i<=radialSegments;i++)positions.push(ringVertex(t,i));ringPositions.push(positions);}
  const bottomCapStart=vertices.length/3;for(let i=0;i<radialSegments;i++){const p=ringPositions[0][i];pushVertex(p.x,p.y,p.z,[clamp(p.x/2.2+.5,0,1),clamp(p.z/(profile.depth*2.2)+.5,0,1)],p.strata);}
  const bottomCenter=pushVertex(0,-profile.height*.52,0,[.5,.5],.88),topCapStart=vertices.length/3;
  for(let i=0;i<radialSegments;i++){const p=ringPositions[rings-1][i];pushVertex(p.x,p.y,p.z,[clamp(p.x/2.2+.5,0,1),clamp(p.z/(profile.depth*2.2)+.5,0,1)],p.strata);}
  const topCenter=pushVertex(leanX,profile.height*.52,leanZ,[.5,.5],1);
  for(let i=0;i<radialSegments;i++){const next=(i+1)%radialSegments;indices.push(bottomCenter,bottomCapStart+i,bottomCapStart+next);}
  for(let ring=0;ring<rings-1;ring++){const start=ring*ringStride,nextStart=(ring+1)*ringStride;for(let i=0;i<radialSegments;i++){const a=start+i,b=start+i+1,c=nextStart+i+1,d=nextStart+i;indices.push(a,d,b,b,d,c);}}
  for(let i=0;i<radialSegments;i++){const next=(i+1)%radialSegments;indices.push(topCapStart+i,topCenter,topCapStart+next);}
  const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute(vertices,3));geo.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));geo.setAttribute('uv',new THREE.Float32BufferAttribute(uvs,2));geo.setIndex(indices);geo.computeVertexNormals();geo.computeBoundingBox();geo.computeBoundingSphere();geo.userData.sinTowerStoneBoulder=true;geo.userData.sinTowerStoneStyle=stoneShape;geo.userData.sinTowerStoneTextureMapping=mapping;return geo;
}

function sinTowerStoneTextureImageReady(texture){
  const image = texture?.image;
  return !!image && !!(image.width || image.naturalWidth || image.videoWidth);
}

function configureSinTowerStoneTexture(texture){
  if(!texture) return;
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.wrapS = texture.wrapT = THREE.RepeatWrapping;
  texture.repeat.set(1, 1);
  texture.anisotropy = Math.min(8, renderer?.capabilities?.getMaxAnisotropy?.() || 1);
  texture.minFilter = THREE.LinearMipmapLinearFilter;
  texture.magFilter = THREE.LinearFilter;
  texture.userData.sharedTexture = true;
}

function refreshSinTowerStoneTextureEntry(entry, texture=null){
  if(!entry) return;
  const loaded = texture || entry.texture;
  if(!loaded) return;
  configureSinTowerStoneTexture(loaded);
  const ready = sinTowerStoneTextureImageReady(loaded);
  for(const material of entry.materials){
    if(!material || material.userData?.sinTowerStoneTextureKey !== entry.key) continue;
    material.map = loaded;
    if(ready) material.color.set('#ffffff');
    material.needsUpdate = true;
  }
  if(ready) loaded.needsUpdate = true;
}

function bindSinTowerStoneTexture(material, src){
  if(!material || !src) return;
  const key = textureCacheKey(src, [1,1], 'srgb');
  let entry = sinTowerStoneTextureCache.get(key);
  if(!entry){
    entry = {key, src, texture:null, materials:new Set(), status:'loading'};
    sinTowerStoneTextureCache.set(key, entry);
    const texture = textureLoader.load(src, loaded=>{
      entry.texture = loaded;
      entry.status = 'ready';
      refreshSinTowerStoneTextureEntry(entry, loaded);
    }, undefined, err=>{
      entry.status = 'error';
      if(sinTowerStoneTextureCache.get(key) === entry) sinTowerStoneTextureCache.delete(key);
      for(const bound of entry.materials){
        if(bound?.userData?.sinTowerStoneTextureKey === key){
          bound.map = null;
          bound.color.copy(bound.userData.sinTowerStoneBaseColor || new THREE.Color('#6e6256'));
          bound.needsUpdate = true;
        }
      }
      console.warn('Sin Tower stone texture failed', err);
      setStatus('石塊材質載入失敗，請確認圖片檔案可讀。');
    });
    entry.texture = texture;
    configureSinTowerStoneTexture(texture);
  }
  entry.materials.add(material);
  material.userData.sinTowerStoneTextureKey = key;
  material.userData.sinTowerStoneBaseColor = material.color.clone();
  if(entry.texture) refreshSinTowerStoneTextureEntry(entry, entry.texture);
}

function makeSinTowerStoneMaterial(stone){
  const sharedSrc = getSinTowerStoneSharedTexture(stone);
  const src = stone.useSharedMaterial !== false ? sharedSrc : (stone.textureDataUrl || sharedSrc);
  const baseColor = new THREE.Color(stone.color || '#6e6256');
  const smooth=['flutedPillar','capital','rosette','baluster'].includes(stone.shape);
  const mat = new THREE.MeshStandardMaterial({color:baseColor, roughness:.92, metalness:0, side:THREE.FrontSide, flatShading:!smooth, vertexColors:true, emissive:baseColor.clone().multiplyScalar(.10), emissiveIntensity:1});
  mat.userData.sinTowerStoneBaseColor = baseColor.clone();
  if(src) bindSinTowerStoneTexture(mat, src);
  return mat;
}

function prepareSinTowerMergedStoneGeometry(geometry,matrix=null){
  if(geometry.index){const indexed=geometry;geometry=indexed.toNonIndexed();indexed.dispose?.();}
  if(!geometry.getAttribute('normal'))geometry.computeVertexNormals();
  const count=geometry.getAttribute('position')?.count||0;
  if(!geometry.getAttribute('uv'))geometry.setAttribute('uv',new THREE.Float32BufferAttribute(new Float32Array(count*2),2));
  if(!geometry.getAttribute('color')){const colors=new Float32Array(count*3);colors.fill(1);geometry.setAttribute('color',new THREE.Float32BufferAttribute(colors,3));}
  if(matrix)geometry.applyMatrix4(matrix);
  return geometry;
}

function buildSinTowerEditorStone(stone){
  const sceneInfo=getSinTowerSceneById(stone.sceneId);
  if(sceneInfo.id!==SIN_TOWER_EDITOR.activeSceneId)return;
  const mapping=getSinTowerStoneTextureMapping(stone),material=makeSinTowerStoneMaterial(stone),parts=[prepareSinTowerMergedStoneGeometry(makeSinTowerStoneGeometry(stone.seed,stone.shape,mapping))];
  const addDetail=(geometry,position,scale,rotation)=>{
    const matrix=new THREE.Matrix4().compose(
      new THREE.Vector3(position[0],position[1],position[2]),
      new THREE.Quaternion().setFromEuler(new THREE.Euler(rotation?.[0]||0,rotation?.[1]||0,rotation?.[2]||0)),
      new THREE.Vector3(scale[0],scale[1],scale[2])
    );
    parts.push(prepareSinTowerMergedStoneGeometry(geometry,matrix));
  };
  if(stone.shape==='flutedPillar'){
    for(const y of [-.46,-.39,.39,.46])addDetail(new THREE.TorusGeometry(.52,.045,6,20),[0,y,0],[1,1,1],[Math.PI/2,0,0]);
    for(let i=0;i<12;i++){const a=i/12*Math.PI*2,r=.475;addDetail(new THREE.BoxGeometry(.055,.72,.045),[Math.cos(a)*r,0,Math.sin(a)*r],[1,1,1],[0,-a,0]);}
  }else if(stone.shape==='capital'){
    addDetail(makeSinTowerBeveledBlockGeometry(stone.seed+11,'capital-abacus',mapping,.07),[0,.43,0],[1.35,.18,1.35]);
    addDetail(new THREE.TorusGeometry(.54,.07,7,20),[0,-.36,0],[1,1,1],[Math.PI/2,0,0]);
    for(let i=0;i<8;i++){const a=i/8*Math.PI*2,r=.49;addDetail(new THREE.ConeGeometry(.13,.48,5),[Math.cos(a)*r,.05,Math.sin(a)*r],[1,.75,.55],[0,-a,Math.PI]);}
  }else if(stone.shape==='cornice'){
    addDetail(makeSinTowerBeveledBlockGeometry(stone.seed+21,'cornice-band',mapping,.045),[0,.33,0],[1.08,.18,1.18]);
    addDetail(makeSinTowerBeveledBlockGeometry(stone.seed+31,'cornice-band',mapping,.035),[0,-.34,0],[1.04,.16,1.1]);
  }else if(stone.shape==='voussoir'){
    addDetail(makeSinTowerBeveledBlockGeometry(stone.seed+41,'voussoir-face',mapping,.04),[0,0,.43],[.72,.72,.16]);
  }else if(stone.shape==='rosette'){
    for(let i=0;i<12;i++){const a=i/12*Math.PI*2,r=.31;addDetail(new THREE.SphereGeometry(.12,8,6),[Math.cos(a)*r,0,Math.sin(a)*r],[.7,.36,1.65],[0,-a,0]);}
    addDetail(new THREE.CylinderGeometry(.12,.12,.24,16),[0,0,0],[1,1,1],[Math.PI/2,0,0]);
  }else if(stone.shape==='baluster'){
    addDetail(makeSinTowerBeveledBlockGeometry(stone.seed+51,'baluster-base',mapping,.055),[0,-.47,0],[1.2,.12,1.2]);
    addDetail(makeSinTowerBeveledBlockGeometry(stone.seed+61,'baluster-cap',mapping,.055),[0,.47,0],[1.15,.12,1.15]);
  }else if(stone.shape==='carvedPanel'){
    for(const side of [-1,1]){addDetail(makeSinTowerBeveledBlockGeometry(stone.seed+71+side,'panel-frame',mapping,.035),[side*.42,0,.5],[.08,.9,.08]);addDetail(makeSinTowerBeveledBlockGeometry(stone.seed+81+side,'panel-frame',mapping,.035),[0,side*.42,.5],[.9,.08,.08]);}
    addDetail(new THREE.CylinderGeometry(.18,.18,.1,18),[0,0,.53],[1,1,1],[Math.PI/2,0,0]);
  }else if(stone.shape==='ashlar'&&stone.generatedRole==='wall'&&sinTowerRand(stone.seed+515)<.18){
    addDetail(makeSinTowerBeveledBlockGeometry(stone.seed+91,'ashlar-carving',mapping,.025),[0,0,.51],[.64,.55,.05]);
  }
  const merged=mergeGeometries(parts,false);
  if(!merged)throw new Error('教堂石件幾何合併失敗：'+(stone.title||stone.id));
  for(const part of parts)part.dispose?.();
  merged.computeBoundingBox();merged.computeBoundingSphere();merged.userData.sinTowerMergedStone=true;merged.userData.sinTowerStoneStyle=stone.shape;
  const mesh=new THREE.Mesh(merged,material);mesh.name=stone.title||'Stone';
  const p=stone.position||{x:0,y:0,z:0};mesh.position.set(safeFinite(p.x,0),safeFinite(p.y,0),safeFinite(p.z,0));mesh.rotation.set(deg(stone.rotation.x),deg(stone.rotation.y),deg(stone.rotation.z));mesh.scale.set(clamp(safeFinite(stone.scale?.x,1),.05,40),clamp(safeFinite(stone.scale?.y,1),.05,40),clamp(safeFinite(stone.scale?.z,1),.05,40));
  mesh.userData.sinTowerEditorType='stone';mesh.userData.sinTowerEditorId=stone.id;mesh.castShadow=true;mesh.receiveShadow=true;
  sinTowerEditorSceneRoot.add(mesh);mesh.updateMatrixWorld(true);
  const rec={stone,mesh,collisionBounds:new THREE.Box3().setFromObject(mesh)};rec.collisionItem={id:stone.id,mesh,stone,type:'sinTowerStone',collisionBounds:rec.collisionBounds};sinTowerEditorRuntime.stones.set(stone.id,rec);
}

function getSinTowerCarriedStone(){
  if(!sinTowerStoneCarry.active || !sinTowerStoneCarry.id) return null;
  return getSinTowerEditorObjectById(sinTowerStoneCarry.id, 'stone');
}

function sinTowerStoneCarryPosition(){
  const forward = getPlayerForward().normalize();
  const position = player.position.clone().addScaledVector(forward, 2.15);
  position.y += 1.0;
  const bounds = getSinTowerActiveSceneBounds();
  if(bounds){
    position.x = clamp(position.x, bounds.minX + .8, bounds.maxX - .8);
    position.z = clamp(position.z, bounds.minZ + .8, bounds.maxZ - .8);
    const scene = getSinTowerActiveScene();
    position.y = clamp(position.y, .3, Math.max(.3, safeFinite(scene?.dimensions?.h, 9) - .5));
  }
  return position;
}

function updateSinTowerCarriedStone(){
  const stone = getSinTowerCarriedStone();
  if(!stone) return;
  if(stone.sceneId !== SIN_TOWER_EDITOR.activeSceneId){
    sinTowerStoneCarry.active = false;
    sinTowerStoneCarry.id = null;
    return;
  }
  const position = sinTowerStoneCarryPosition();
  stone.position = {x:position.x, y:position.y, z:position.z};
  const rec = sinTowerEditorRuntime.stones.get(stone.id);
  if(rec?.mesh){
    rec.mesh.position.copy(position);
    rec.mesh.updateMatrixWorld(true);
    rec.collisionBounds = new THREE.Box3().setFromObject(rec.mesh);
  }
}

function getSinTowerStoneCollisionBounds(rec){
  if(!rec?.mesh) return null;
  if(!rec.collisionBounds){
    rec.mesh.updateMatrixWorld(true);
    rec.collisionBounds = new THREE.Box3().setFromObject(rec.mesh);
  }
  return rec.collisionBounds;
}

function rebuildSinTowerStoneSpatialIndex(){
  const spatial=sinTowerEditorRuntime.stoneSpatial,cellSize=spatial.cellSize;spatial.cells.clear();spatial.global.length=0;
  for(const rec of sinTowerEditorRuntime.stones.values()){
    const bounds=getSinTowerStoneCollisionBounds(rec);if(!bounds)continue;
    if(rec.collisionItem)rec.collisionItem.collisionBounds=bounds;
    const minX=Math.floor(bounds.min.x/cellSize),maxX=Math.floor(bounds.max.x/cellSize),minZ=Math.floor(bounds.min.z/cellSize),maxZ=Math.floor(bounds.max.z/cellSize),span=(maxX-minX+1)*(maxZ-minZ+1);
    if(span>256){spatial.global.push(rec);continue;}
    for(let x=minX;x<=maxX;x++)for(let z=minZ;z<=maxZ;z++){const key=x+','+z;let bucket=spatial.cells.get(key);if(!bucket){bucket=[];spatial.cells.set(key,bucket);}bucket.push(rec);}
  }
}

function querySinTowerStoneRecords(x,z,pad=.4){
  const spatial=sinTowerEditorRuntime.stoneSpatial,cellSize=spatial.cellSize,result=spatial.candidateScratch;result.length=0;
  const seen=new Set(),minX=Math.floor((x-pad)/cellSize),maxX=Math.floor((x+pad)/cellSize),minZ=Math.floor((z-pad)/cellSize),maxZ=Math.floor((z+pad)/cellSize),append=rec=>{if(rec&&!seen.has(rec)){seen.add(rec);result.push(rec);}};
  for(const rec of spatial.global)append(rec);
  for(let cx=minX;cx<=maxX;cx++)for(let cz=minZ;cz<=maxZ;cz++)for(const rec of spatial.cells.get(cx+','+cz)||[])append(rec);
  return result;
}

function getSinTowerStoneCollisionItems(pos=player.position,pad=0){
  const active=getSinTowerActiveScene();if(!active||active.type!=='church')return [];
  const radius=safeFinite(player?.radius,.32)+pad,items=[];
  for(const rec of querySinTowerStoneRecords(safeFinite(pos?.x,0),safeFinite(pos?.z,0),radius+.08)){
    if(rec?.stone?.sceneId!==active.id||rec.mesh?.visible===false||(sinTowerStoneCarry.active&&rec.stone.id===sinTowerStoneCarry.id))continue;
    if(rec.collisionItem){rec.collisionItem.collisionBounds=getSinTowerStoneCollisionBounds(rec);items.push(rec.collisionItem);}
  }
  return items;
}

function getSinTowerStoneSupportHeightAt(x,z){
  const active=getSinTowerActiveScene();if(!active||active.type!=='church')return 0;
  const radius=safeFinite(player?.radius,.32);let highest=0;
  for(const rec of querySinTowerStoneRecords(x,z,radius+.08)){
    const stone=rec?.stone;if(!stone||stone.sceneId!==active.id||stone.surface!=='floor'||(sinTowerStoneCarry.active&&stone.id===sinTowerStoneCarry.id))continue;
    const bounds=getSinTowerStoneCollisionBounds(rec);if(!bounds)continue;
    if(x>=bounds.min.x-radius&&x<=bounds.max.x+radius&&z>=bounds.min.z-radius&&z<=bounds.max.z+radius)highest=Math.max(highest,bounds.max.y);
  }
  return Math.max(0,highest);
}

function sinTowerStoneCollisionHit(item, pos, pad=0){
  const stone = item?.stone;
  const mesh = item?.mesh;
  const active = getSinTowerActiveScene();
  if(!stone || !mesh || active?.type !== 'church' || stone.sceneId !== active.id) return null;
  if(sinTowerStoneCarry.active && stone.id === sinTowerStoneCarry.id) return null;

  const bodyHeight = Math.max(.1, safeFinite(player?.height, 1.8));
  const radius = safeFinite(player?.radius, .32) + pad;
  const bounds = item.collisionBounds;
  if(bounds && (pos.x < bounds.min.x - radius || pos.x > bounds.max.x + radius || pos.z < bounds.min.z - radius || pos.z > bounds.max.z + radius)) return null;
  // A floor rock is walkable from above, but remains solid if something tries
  // to enter it from below before gravity has placed the player on its top.
  if(stone.surface === 'floor' && bounds && safeFinite(pos.y, 0) >= bounds.max.y - .08) return null;

  mesh.updateMatrixWorld(true);
  const geometry = mesh.geometry;
  if(!geometry) return null;
  if(!geometry.boundingBox) geometry.computeBoundingBox();
  const localBox = geometry.boundingBox;
  if(!localBox) return null;
  const inv = new THREE.Matrix4().copy(mesh.matrixWorld).invert();
  const pWorld = new THREE.Vector3(pos.x, safeFinite(pos.y, 0) + bodyHeight * .5, pos.z);
  const pLocal = pWorld.clone().applyMatrix4(inv);
  const center = localBox.min.clone().add(localBox.max).multiplyScalar(.5);
  const localHalf = localBox.max.clone().sub(localBox.min).multiplyScalar(.5);
  const scale = getWorldScaleSafe(mesh);
  const halfX = localHalf.x + radius / scale.x;
  const halfY = localHalf.y + bodyHeight * .5 / scale.y;
  const halfZ = localHalf.z + radius / scale.z;
  const dx = pLocal.x - center.x;
  const dy = pLocal.y - center.y;
  const dz = pLocal.z - center.z;
  if(Math.abs(dx) > halfX || Math.abs(dy) > halfY || Math.abs(dz) > halfZ) return null;

  const penX = (halfX - Math.abs(dx)) * scale.x;
  const penZ = (halfZ - Math.abs(dz)) * scale.z;
  const resolvedLocal = pLocal.clone();
  const axis = penZ <= penX ? 'z' : 'x';
  if(axis === 'z') resolvedLocal.z = center.z + (dz >= 0 ? 1 : -1) * halfZ;
  else resolvedLocal.x = center.x + (dx >= 0 ? 1 : -1) * halfX;
  const resolvedWorld = resolvedLocal.applyMatrix4(mesh.matrixWorld);
  return {item, axis:`sinTowerStone${axis.toUpperCase()}`, penetration:Math.min(penX, penZ), resolvedWorld};
}

function startSinTowerStoneCarry(id=null){
  const stoneId = id || (SIN_TOWER_EDITOR.selectedObjectType === 'stone' ? SIN_TOWER_EDITOR.selectedObjectId : null);
  const stone = getSinTowerEditorObjectById(stoneId, 'stone');
  if(!stone){ setStatus('請先選取石塊，再按「角色攜帶選取石塊」。'); return false; }
  if(stone.sceneId !== SIN_TOWER_EDITOR.activeSceneId){ setStatus('只能攜帶目前場景的石塊。'); return false; }
  confirmOtherPendingObjects('sinTowerStone', stone.id);
  pushUndoState('follow stone');
  SIN_TOWER_EDITOR.selectedObjectType = 'stone';
  SIN_TOWER_EDITOR.selectedObjectId = stone.id;
  sinTowerStoneCarry.active = true;
  sinTowerStoneCarry.id = stone.id;
  updateSinTowerCarriedStone();
  syncSinProEditor();
  setStatus(`石塊「${stone.title}」已由主角攜帶。使用 WASD 移動主角，按 Enter 或「放置石塊」固定位置。`);
  return true;
}

function placeSinTowerCarriedStone(){
  const stone = getSinTowerCarriedStone();
  if(!stone){ setStatus('目前沒有由主角攜帶的石塊。'); return false; }
  updateSinTowerCarriedStone();
  sinTowerStoneCarry.active = false;
  sinTowerStoneCarry.id = null;
  rebuildSinTowerStoneSpatialIndex();
  syncSinProEditor();
  scheduleSinTowerRuntimeSave();
  setStatus(`已放置石塊「${stone.title}」。可繼續調整位置、尺寸、旋轉、形狀與材質。`);
  return true;
}

function getSinTowerBillboardAlphaContour(frameInput){
  const frames=(Array.isArray(frameInput)?frameInput:[frameInput]).filter(Boolean),frame=frames[0];
  if(!frame)return null;
  if(frame.sinTowerAlphaContour)return frame.sinTowerAlphaContour;
  const primary=frame.gifCanvas||frame.texture?.image;
  const width=Math.max(1,primary?.naturalWidth||primary?.videoWidth||primary?.displayWidth||primary?.width||0);
  const height=Math.max(1,primary?.naturalHeight||primary?.videoHeight||primary?.displayHeight||primary?.height||0);
  if(!width||!height)return null;
  const scale=Math.min(1,192/Math.max(width,height));
  const sampleW=Math.max(8,Math.round(width*scale)),sampleH=Math.max(8,Math.round(height*scale));
  try{
    const canvas=document.createElement('canvas');canvas.width=sampleW;canvas.height=sampleH;
    const ctx=canvas.getContext('2d',{alpha:true,willReadFrequently:true});ctx.clearRect(0,0,sampleW,sampleH);
    const sources=[];
    for(const sourceFrame of frames){
      if(sourceFrame.gifFrames?.length)sources.push(...sourceFrame.gifFrames);
      else sources.push(sourceFrame.gifCanvas||sourceFrame.texture?.image);
    }
    for(const source of sources)if(source)ctx.drawImage(source,0,0,sampleW,sampleH);
    const pixels=ctx.getImageData(0,0,sampleW,sampleH).data,solid=new Uint8Array(sampleW*sampleH);
    for(let i=0;i<solid.length;i++)solid[i]=pixels[i*4+3]>=24?1:0;
    const contour=[];
    for(let y=1;y<sampleH-1;y++)for(let x=1;x<sampleW-1;x++){
      const i=y*sampleW+x;if(!solid[i])continue;
      if(!solid[i-1]||!solid[i+1]||!solid[i-sampleW]||!solid[i+sampleW])contour.push({x:(x/(sampleW-1)-.5)*2,y:1-y/(sampleH-1)*2});
    }
    frame.sinTowerAlphaContour=contour.length?contour:null;
    frame.sinTowerAlphaContourResolution={width:sampleW,height:sampleH,points:contour.length};
    return frame.sinTowerAlphaContour;
  }catch(error){console.warn('Sin Tower alpha contour sampling failed',error);frame.sinTowerAlphaContour=null;return null;}
}

function normalizeSinTowerParticleAxes(raw){
  const axes={x:raw?.x===true,y:raw?.y!==false,z:raw?.z===true};
  if(!axes.x&&!axes.y&&!axes.z)axes.y=true;
  return axes;
}

function setSinTowerParticleWorldAxes(points,raw){
  if(points?.userData){const axes=points.userData.particleAxes||(points.userData.particleAxes={x:false,y:true,z:false});axes.x=raw?.x===true;axes.y=raw?.y!==false;axes.z=raw?.z===true;if(!axes.x&&!axes.y&&!axes.z)axes.y=true;}
  return points;
}

function configureSinTowerRisingParticleData(points,basePositions,seed,rise=.55,drift=.12,originKind='outline'){
  const count=Math.floor(basePositions.length/3),phase=new Float32Array(count),speed=new Float32Array(count),sway=new Float32Array(count),angle=new Float32Array(count);
  for(let i=0;i<count;i++){phase[i]=sinTowerRand(seed+i*17.31);speed[i]=.13+sinTowerRand(seed+i*31.73)*.22;sway[i]=(.38+sinTowerRand(seed+i*53.11)*.62)*drift;angle[i]=sinTowerRand(seed+i*79.17)*Math.PI*2;}
  const geometry=points.geometry,uniforms={uSinTime:{value:0},uSinRise:{value:rise},uSinRiseAxis:{value:new THREE.Vector3(0,1,0)},uSinSideA:{value:new THREE.Vector3(1,0,0)},uSinSideB:{value:new THREE.Vector3(0,0,1)}};
  geometry.setAttribute('sinPhase',new THREE.BufferAttribute(phase,1));geometry.setAttribute('sinSpeed',new THREE.BufferAttribute(speed,1));geometry.setAttribute('sinSway',new THREE.BufferAttribute(sway,1));geometry.setAttribute('sinAngle',new THREE.BufferAttribute(angle,1));geometry.computeBoundingSphere();if(geometry.boundingSphere)geometry.boundingSphere.radius+=rise+drift*2;
  const material=points.material;material.userData.sinTowerParticleUniforms=uniforms;material.onBeforeCompile=shader=>{
    Object.assign(shader.uniforms,uniforms);
    shader.vertexShader='attribute float sinPhase;\nattribute float sinSpeed;\nattribute float sinSway;\nattribute float sinAngle;\nuniform float uSinTime;\nuniform float uSinRise;\nuniform vec3 uSinRiseAxis;\nuniform vec3 uSinSideA;\nuniform vec3 uSinSideB;\n'+shader.vertexShader;
    shader.vertexShader=shader.vertexShader.replace('#include <begin_vertex>','float sinCycle=mod(uSinTime*sinSpeed+sinPhase,1.0);\nfloat sinFade=sin(sinCycle*3.14159265359);\nfloat sinSwayA=sin(sinAngle+sinCycle*7.53982236862)*sinSway*sinFade;\nfloat sinSwayB=cos(sinAngle+sinCycle*5.34070751110)*sinSway*sinFade*0.34;\nvec3 transformed=position+uSinRiseAxis*(sinCycle*uSinRise)+uSinSideA*sinSwayA+uSinSideB*sinSwayB;');
  };material.customProgramCacheKey=()=> 'sin-tower-rising-particles-gpu-v1';material.needsUpdate=true;
  points.userData.sinTowerInteractiveParticles=true;points.userData.sinTowerGpuParticles=true;points.userData.particleCount=count;points.userData.particlePhase=phase;points.userData.particleSpeed=speed;points.userData.particleSway=sway;points.userData.particleAngle=angle;points.userData.particleRise=rise;points.userData.particleAxes={x:false,y:true,z:false};points.userData.particleOriginKind=originKind;points.userData.particleLastUpdate=-1;
  return points;
}

function updateSinTowerRisingParticles(points,t){
  const data=points?.userData,uniforms=points?.material?.userData?.sinTowerParticleUniforms;if(!data||!uniforms)return;
  const tick=Math.floor(t*30);if(data.particleLastUpdate===tick)return;data.particleLastUpdate=tick;
  const axes=data.particleAxes||(data.particleAxes={x:false,y:true,z:false}),scratch=data.particleScratch||(data.particleScratch={worldAxis:new THREE.Vector3(),worldOrigin:new THREE.Vector3(),localOrigin:new THREE.Vector3(),axisPoint:new THREE.Vector3(),riseAxis:new THREE.Vector3(),sideA:new THREE.Vector3(),sideB:new THREE.Vector3()});
  const worldAxis=scratch.worldAxis.set(axes.x?1:0,axes.y?1:0,axes.z?1:0);if(worldAxis.lengthSq()<.0001)worldAxis.set(0,1,0);else worldAxis.normalize();
  points.updateWorldMatrix(true,false);points.getWorldPosition(scratch.worldOrigin);scratch.localOrigin.copy(scratch.worldOrigin);points.worldToLocal(scratch.localOrigin);scratch.axisPoint.copy(scratch.worldOrigin).add(worldAxis);points.worldToLocal(scratch.axisPoint);const riseAxis=scratch.riseAxis.copy(scratch.axisPoint).sub(scratch.localOrigin).normalize();
  const sideA=scratch.sideA.set(Math.abs(riseAxis.y)<.88?0:1,Math.abs(riseAxis.y)<.88?1:0,0).cross(riseAxis).normalize(),sideB=scratch.sideB.copy(riseAxis).cross(sideA).normalize();
  uniforms.uSinTime.value=t;uniforms.uSinRiseAxis.value.copy(riseAxis);uniforms.uSinSideA.value.copy(sideA);uniforms.uSinSideB.value.copy(sideB);
}

function makeSinTowerInteractiveParticleHalo(seed=1,count=840,frame=null){
  count=clamp(Math.round(safeFinite(count,840)),120,2400);
  const contour=getSinTowerBillboardAlphaContour(frame),positions=new Float32Array(count*3);
  for(let i=0;i<count;i++){
    let x=0,y=0,z=(sinTowerRand(seed+i*71.9)-.5)*.025;
    if(contour?.length){
      const p=contour[Math.floor(sinTowerRand(seed+i*37.17)*contour.length)%contour.length],len=Math.max(.001,Math.hypot(p.x,p.y));
      const offset=.012+sinTowerRand(seed+i*47.83)*.035;x=p.x+p.x/len*offset;y=p.y+p.y/len*offset;
    }else{
      const edge=i%4,u=sinTowerRand(seed+i*37.17)*2-1;
      if(edge===0){x=u;y=1.035;}else if(edge===1){x=1.035;y=u;}else if(edge===2){x=u;y=-1.035;}else{x=-1.035;y=u;}
    }
    positions[i*3]=x;positions[i*3+1]=y;positions[i*3+2]=z;
  }
  const geometry=new THREE.BufferGeometry();geometry.setAttribute('position',new THREE.BufferAttribute(positions,3));
  const material=new THREE.PointsMaterial({color:0xffe68b,size:.68,sizeAttenuation:false,transparent:true,opacity:.74,depthWrite:false,depthTest:false,blending:THREE.AdditiveBlending,toneMapped:false});
  const points=new THREE.Points(geometry,material);points.name=contour?.length?'透明內容輪廓上升微粒':'可互動物件上升微粒';configureSinTowerRisingParticleData(points,positions,seed,.58,.075,contour?.length?'alpha-contour-union':'frame-fallback');points.renderOrder=6;points.frustumCulled=true;return points;
}

function makeSinTowerModelContourParticles(rec,count=840){
  count=clamp(Math.round(safeFinite(count,840)),120,2400);
  rec.group.updateMatrixWorld(true);rec.object.updateMatrixWorld(true);
  const sources=[];rec.object.traverse(node=>{const attr=node.isMesh?node.geometry?.getAttribute?.('position'):null;if(attr?.count)sources.push({node,attr});});
  if(!sources.length)return makeSinTowerInteractiveParticleHalo(safeFinite(rec.model?.id?.length,1)*131,count);
  const positions=new Float32Array(count*3),center=new THREE.Box3().setFromObject(rec.object).getCenter(new THREE.Vector3());rec.group.worldToLocal(center);
  const point=new THREE.Vector3();
  for(let i=0;i<count;i++){
    const source=sources[i%sources.length],index=Math.floor(sinTowerRand(i*91.7+safeFinite(rec.model?.id?.length,1)*313)*source.attr.count);
    point.fromBufferAttribute(source.attr,index);source.node.localToWorld(point);rec.group.worldToLocal(point);
    const direction=point.clone().sub(center);if(direction.lengthSq()>.000001)point.addScaledVector(direction.normalize(),.012+sinTowerRand(i*19.3)*.018);
    positions[i*3]=point.x;positions[i*3+1]=point.y;positions[i*3+2]=point.z;
  }
  const geometry=new THREE.BufferGeometry();geometry.setAttribute('position',new THREE.BufferAttribute(positions,3));
  const material=new THREE.PointsMaterial({color:0xffe68b,size:.68,sizeAttenuation:false,transparent:true,opacity:.74,depthWrite:false,depthTest:false,blending:THREE.AdditiveBlending,toneMapped:false});
  const points=new THREE.Points(geometry,material),size=new THREE.Box3().setFromObject(rec.object).getSize(new THREE.Vector3());points.name='3D 模型輪廓上升微粒';configureSinTowerRisingParticleData(points,positions,safeFinite(rec.model?.id?.length,1)*313,Math.max(.12,size.y*.48),Math.max(.025,Math.max(size.x,size.z)*.035),'model-surface');points.renderOrder=6;points.frustumCulled=true;return points;
}

function getSinTowerInteractiveGlowTexture(){
  if(sinTowerInteractiveGlowTexture) return sinTowerInteractiveGlowTexture;
  const canvas = document.createElement('canvas');
  canvas.width = canvas.height = 128;
  const ctx = canvas.getContext('2d');
  const g = ctx.createRadialGradient(64,64,12,64,64,62);
  g.addColorStop(0,'rgba(255,238,172,.60)');
  g.addColorStop(.38,'rgba(255,207,92,.24)');
  g.addColorStop(1,'rgba(255,190,70,0)');
  ctx.fillStyle = g;
  ctx.fillRect(0,0,128,128);
  const tex = new THREE.CanvasTexture(canvas);
  tex.colorSpace = THREE.SRGBColorSpace;
  tex.minFilter = THREE.LinearFilter;
  tex.magFilter = THREE.LinearFilter;
  tex.generateMipmaps = false;
  tex.userData.sharedTexture = true;
  sinTowerInteractiveGlowTexture = tex;
  return tex;
}

function removeSinTowerInteractiveParticles(points){
  if(!points) return;
  points.parent?.remove(points);
  points.geometry?.dispose?.();
  points.material?.dispose?.();
}

function removeSinTowerInteractiveAura(aura){
  if(!aura) return;
  aura.parent?.remove(aura);
  aura.material?.dispose?.();
}

function makeSinTowerInteractiveAura(){
  const aura=new THREE.Sprite(new THREE.SpriteMaterial({map:getSinTowerInteractiveGlowTexture(),color:0xbfeeff,transparent:true,opacity:.24,depthWrite:false,depthTest:false,blending:THREE.AdditiveBlending,toneMapped:false}));
  aura.name='可互動物件立體微光';
  aura.center.set(.5,.5);
  aura.renderOrder=5;
  aura.frustumCulled=false;
  return aura;
}

function setSinTowerPropVisualGlowEnabled(visual,prop,enabled){
  if(!visual?.group)return;
  removeSinTowerInteractiveAura(visual.glow);visual.glow=null;
  const count=clamp(Math.round(safeFinite(prop?.interaction?.particleCount,840)),120,2400);
  if(enabled){
    if(!visual.particles||visual.particles.userData?.particleCount!==count){removeSinTowerInteractiveParticles(visual.particles);visual.particles=makeSinTowerInteractiveParticleHalo(safeFinite(prop?.repeatSeed,1)+safeFinite(visual.slot,0)*97,count,visual.frames||visual.frame||null);visual.group.add(visual.particles);}
    setSinTowerParticleWorldAxes(visual.particles,prop?.interaction?.particleAxes);
  }else{removeSinTowerInteractiveParticles(visual.particles);visual.particles=null;}
}

function syncSinTowerModelInteractiveFx(rec){
  if(!rec?.group||!rec.object)return;
  const current=getSinTowerEditorObjectById(rec.model?.id,'model');if(current)rec.model=current;
  removeSinTowerInteractiveAura(rec.aura);rec.aura=null;
  const enabled=!!(rec.model?.interaction?.enabled&&rec.model.interaction.glowEnabled!==false);
  if(!enabled){removeSinTowerInteractiveParticles(rec.particles);rec.particles=null;return;}
  const count=clamp(Math.round(safeFinite(rec.model.interaction.particleCount,840)),120,2400);
  if(!rec.particles||rec.particles.userData?.particleCount!==count){removeSinTowerInteractiveParticles(rec.particles);rec.particles=makeSinTowerModelContourParticles(rec,count);rec.group.add(rec.particles);}
  setSinTowerParticleWorldAxes(rec.particles,rec.model?.interaction?.particleAxes);
}

function createSinTowerEditorPropVisual(rec, step=null, slot=0){
  if(!rec?.root || !rec.frames?.length) return null;
  const prop = rec.prop;
  const frame = rec.frames[0];
  const group = new THREE.Group();
  group.name = prop.title || (prop.mediaType === 'video' ? 'Video Prop' : 'PNG Prop');
  let glow=null;
  let particles=null;
  if(prop.interaction?.enabled&&prop.interaction?.glowEnabled!==false){particles=makeSinTowerInteractiveParticleHalo(safeFinite(prop.repeatSeed,1)+slot*97,prop.interaction.particleCount,rec.frames);setSinTowerParticleWorldAxes(particles,prop.interaction.particleAxes);group.add(particles);}
  const sprite = new THREE.Sprite(frame.material);
  sprite.center.set(.5, 0);
  sprite.frustumCulled = true;
  sprite.renderOrder = 0;
  group.add(sprite);
  const shadow = new THREE.Mesh(new THREE.CircleGeometry(.42, 18), new THREE.MeshBasicMaterial({color:0x000000, transparent:true, opacity:.20, depthWrite:false}));
  shadow.rotation.x = -Math.PI / 2;
  shadow.position.y = .018;
  shadow.scale.set(1,.42,1);
  group.add(shadow);
  let base;
  if(rec.sceneInfo?.type === 'stairs' && prop.followStairs !== false && Number.isFinite(step)) base = sinTowerWorldPositionFromStep(step, prop.offset);
  else base = sinTowerEditorWorldPosition(rec.sceneInfo, prop);
  group.position.copy(base);
  group.userData.basePosition = base.clone();
  group.userData.sinTowerEditorType = 'prop';
  group.userData.sinTowerEditorId = prop.id;
  group.userData.sinTowerRepeatStep = step;
  rec.root.add(group);
  const visual = {group,sprite,glow,particles,frame,frames:rec.frames,step:Number.isFinite(step) ? step : prop.step,slot};
  rec.visuals.push(visual);
  return visual;
}

function disposeSinTowerEditorPropVisual(rec, visual){
  if(!visual?.group) return;
  // Sprite frames are shared by every repeated instance. Detach the sprite
  // before disposing the holder so recycling one slot cannot destroy the
  // texture/material still used by the other slots.
  if(visual.sprite?.parent === visual.group) visual.group.remove(visual.sprite);
  rec?.root?.remove(visual.group);
  disposeObjectTree(visual.group);
}

function refreshSinTowerEditorPropRepeats(rec, force=false){
  const prop = rec?.prop;
  if(!rec?.root || !prop || rec.sceneInfo?.type !== 'stairs' || prop.followStairs === false || !prop.repeatOnStairs) return;
  const current = getSinTowerCurrentStepIndex();
  if(!force && Math.abs(current - safeFinite(rec.lastRepeatAnchor,current)) < 6) return;
  for(const visual of rec.visuals) disposeSinTowerEditorPropVisual(rec, visual);
  rec.visuals.length = 0;
  rec.lastRepeatAnchor = current;
  const minGap = clamp(Math.round(safeFinite(prop.repeatEvery,20)),1,1000);
  const variance = clamp(Math.round(safeFinite(prop.repeatVariance,20)),0,1000);
  const visibleWindow = Math.max(36, safeFinite(SIN_TOWER_MONKS.visibleStepWindow,50) + 36);
  let step = Math.max(Math.floor(prop.step), current - 6);
  const maxInstances = clamp(Math.ceil((visibleWindow + 18) / Math.max(1,minGap)) + 3, 3, 32);
  for(let slot=0;slot<maxInstances && step <= current + visibleWindow;slot++){
    createSinTowerEditorPropVisual(rec, step, slot);
    const randomExtra = Math.floor(sinTowerRand(safeFinite(prop.repeatSeed,1) + (step + slot * 17.17) * 9.31) * (variance + 1));
    step += minGap + randomExtra;
  }
}

async function buildSinTowerEditorProp(prop){
  const sceneInfo = getSinTowerSceneById(prop.sceneId);
  const buildGeneration = sinTowerEditorRuntime.generation;
  const hasSource = prop.mediaType === 'video' ? !!prop.videoDataUrl : prop.mediaType === 'gif' ? !!prop.gifDataUrl : !!prop.frames?.length;
  if(sceneInfo.id !== SIN_TOWER_EDITOR.activeSceneId || !hasSource) return;
  const frames = [];
  let video = null;
  if(prop.mediaType === 'video'){
    try{
      video = document.createElement('video');
      video.muted = true;
      video.loop = true;
      video.playsInline = true;
      video.preload = 'auto';
      video.src = prop.videoDataUrl;
      const texture = new THREE.VideoTexture(video);
      texture.colorSpace = THREE.SRGBColorSpace;
      texture.minFilter = THREE.LinearFilter;
      texture.magFilter = THREE.LinearFilter;
      texture.generateMipmaps = false;
      const material = new THREE.SpriteMaterial({map:texture, transparent:true, alphaTest:.02, depthWrite:false, depthTest:true, sizeAttenuation:true});
      frames.push({texture,material,ratio:prop.videoRatio || 16/9,video});
      video.play().catch(()=>{});
    }catch(err){ console.warn('Sin Tower video prop failed', err); }
  }else if(prop.mediaType === 'gif'){
    try{
      const built = await makeSinTowerGifFrameFromDataUrl({dataUrl:prop.gifDataUrl,ratio:prop.gifRatio,name:prop.gifName});
      if(built) frames.push(built);
    }catch(err){ console.warn('Sin Tower GIF prop failed',err); }
  }else{
    for(const frame of prop.frames){
      try{ const built = await makeSinTowerSpriteFrameFromDataUrl(frame); if(built) frames.push(built); }
      catch(err){ console.warn('Sin Tower prop frame failed', err); }
    }
  }
  if(buildGeneration !== sinTowerEditorRuntime.generation || !frames.length || !sinTowerEditorSceneRoot){
    try{ video?.pause?.(); }catch(e){}
    for(const frame of frames){ frame.disposeGif?.(); frame.material?.dispose?.(); frame.texture?.dispose?.(); }
    return;
  }
  const root = new THREE.Group();
  root.name = prop.title || 'Billboard Prop';
  sinTowerEditorSceneRoot.add(root);
  const rec = {prop,sceneInfo,root,visuals:[],frames,video,frame:-1,lastRepeatAnchor:-Infinity};
  sinTowerEditorRuntime.props.set(prop.id, rec);
  if(sceneInfo.type === 'stairs' && prop.followStairs !== false && prop.repeatOnStairs) refreshSinTowerEditorPropRepeats(rec, true);
  else createSinTowerEditorPropVisual(rec, sceneInfo.type === 'stairs' ? prop.step : null, 0);
  updateSinTowerEditorPropRecord(rec, performance.now() * .001);
}

function applySinTowerEditorModelTransform(rec){
  if(!rec?.group) return;
  const current=getSinTowerEditorObjectById(rec.model?.id,'model');
  if(current) rec.model=current;
  const model=rec.model,group=rec.group;
  if(!model) return;
  group.position.set(safeFinite(model.position?.x,0),safeFinite(model.position?.y,0),safeFinite(model.position?.z,0));
  group.rotation.set(deg(safeFinite(model.rotation?.x,0)),deg(safeFinite(model.rotation?.y,0)),deg(safeFinite(model.rotation?.z,0)));
  group.scale.set(Math.max(.01,safeFinite(model.scale?.x,1)),Math.max(.01,safeFinite(model.scale?.y,1)),Math.max(.01,safeFinite(model.scale?.z,1)));
  group.updateMatrixWorld(true);
}

async function buildSinTowerEditorModel(model){
  const sceneInfo = getSinTowerSceneById(model.sceneId);
  const generation = sinTowerEditorRuntime.generation;
  const sourceUrl = model.modelDataUrl || model.sourceUrl;
  if(sceneInfo.id !== SIN_TOWER_EDITOR.activeSceneId || !sourceUrl || !sinTowerEditorSceneRoot) return;
  try{
    const loader = new GLTFLoader();
    let gltf;
    if(model._runtimeArrayBuffer instanceof ArrayBuffer){
      gltf = await loader.parseAsync(model._runtimeArrayBuffer.slice(0), '');
    }else if(model.modelDataUrl){
      const binary = await (await fetch(model.modelDataUrl)).arrayBuffer();
      gltf = await loader.parseAsync(binary, '');
    }else{
      gltf = await loader.loadAsync(sourceUrl);
    }
    if(generation !== sinTowerEditorRuntime.generation || !sinTowerEditorSceneRoot){
      disposeObjectTree(gltf.scene);
      return;
    }
    const group = new THREE.Group();
    group.name = model.title || '3D Model';
    group.userData.sinTowerEditorType = 'model';
    group.userData.sinTowerEditorId = model.id;
    const object = gltf.scene;
    group.add(object);
    let overrideTexture = null;
    if(model.textureDataUrl){
      overrideTexture = await new THREE.TextureLoader().loadAsync(model.textureDataUrl);
      overrideTexture.colorSpace = THREE.SRGBColorSpace;
      overrideTexture.flipY = false;
      overrideTexture.wrapS = THREE.RepeatWrapping;
      overrideTexture.wrapT = THREE.RepeatWrapping;
      overrideTexture.needsUpdate = true;
    }
    object.traverse(node=>{
      if(!node.isMesh) return;
      node.userData.sinTowerEditorType = 'model';
      node.userData.sinTowerEditorId = model.id;
      node.castShadow = true;
      node.receiveShadow = true;
      const sourceMaterials = Array.isArray(node.material) ? node.material : [node.material];
      const materials = sourceMaterials.map(material=>{
        const clone = material?.clone?.() || new THREE.MeshStandardMaterial({color:0xffffff,roughness:.85});
        if(overrideTexture){ clone.map = overrideTexture; clone.color?.set?.(0xffffff); }
        clone.needsUpdate = true;
        return clone;
      });
      node.material = Array.isArray(node.material) ? materials : materials[0];
    });
    sinTowerEditorSceneRoot.add(group);
    const rec={model,sceneInfo,group,object,overrideTexture,particles:null,aura:null};
    syncSinTowerModelInteractiveFx(rec);
    sinTowerEditorRuntime.models.set(model.id,rec);
    applySinTowerEditorModelTransform(rec);
    if(model._runtimeArrayBuffer) model._runtimeArrayBuffer = null;
    if(model._importPending){
      model._importPending = false;
      setStatus('3D 模型匯入完成：' + (model.title || model.modelName || '未命名模型') + '。現在可從物件清單選取、移動與縮放。');
      syncSinProEditor?.();
    }
  }catch(error){
    console.warn('Sin Tower 3D model failed',model.title,error);
    model._importPending = false;
    const detail = String(error?.message || error || '未知錯誤').slice(0,180);
    setStatus('3D 模型載入失敗：' + (model.title || model.modelName || '未命名模型') + '｜' + detail);
  }
}

function makeSinTowerPortalPointCloud(portal,preset,count,layer=0){
  const positions=new Float32Array(count*3);
  const arms=Math.max(2,preset.arms+(layer===1?1:0));
  for(let i=0;i<count;i++){
    const u=(i+.5)/count;
    const arm=i%arms;
    const progress=((i-arm)/arms+.5)/(count/arms);
    const radius=.035+.455*Math.pow(clamp(progress,0,1),.68+layer*.08);
    const noise=sinTowerSignedRand(i*17+portal.portalStyle*101+layer*911)*.018;
    const angle=preset.direction*(preset.turns+layer*.7)*Math.PI*2*progress+arm*Math.PI*2/arms+layer*.37;
    positions[i*3]=Math.cos(angle)*(radius+noise);
    positions[i*3+1]=Math.sin(angle)*(radius+noise);
    positions[i*3+2]=Math.sin(angle*preset.depth+i*.071)*.008+sinTowerSignedRand(i*29+layer*71)*.006;
  }
  const geometry=new THREE.BufferGeometry();
  geometry.setAttribute('position',new THREE.BufferAttribute(positions,3));
  const primary=new THREE.Color(portal.color||preset.color);
  const accent=primary.clone().offsetHSL(preset.hue*(layer?-.65:1),layer?.04:.01,layer?.24:.34);
  const material=new THREE.PointsMaterial({color:accent,size:layer?.011:.015,sizeAttenuation:true,transparent:true,opacity:layer?.76:.96,depthTest:false,depthWrite:false,blending:THREE.AdditiveBlending,alphaTest:.01,toneMapped:false});
  const points=new THREE.Points(geometry,material);
  points.frustumCulled=true;points.renderOrder=layer?4:3;
  return points;
}

function makeSinTowerPortalHalo(portal,preset){
  const count=220;
  const positions=new Float32Array(count*3);
  for(let i=0;i<count;i++){
    const a=i/count*Math.PI*2;
    const r=.492+Math.sin(a*preset.wave)*.012+sinTowerSignedRand(i*43+portal.portalStyle*59)*.006;
    positions[i*3]=Math.cos(a)*r;positions[i*3+1]=Math.sin(a)*r;positions[i*3+2]=.006+sinTowerSignedRand(i*13)*.004;
  }
  const geometry=new THREE.BufferGeometry();geometry.setAttribute('position',new THREE.BufferAttribute(positions,3));
  return new THREE.Points(geometry,new THREE.PointsMaterial({color:new THREE.Color(portal.color||preset.color).offsetHSL(0,-.05,.32),size:.011,sizeAttenuation:true,transparent:true,opacity:1,depthTest:false,depthWrite:false,blending:THREE.AdditiveBlending,toneMapped:false}));
}

function makeSinTowerPortalSpiralThreads(portal,preset){
  const group=new THREE.Group();
  const color=new THREE.Color(portal.color||preset.color).offsetHSL(preset.hue*.35,-.08,.38);
  for(let arm=0;arm<preset.arms;arm++){
    const points=[];
    for(let i=0;i<86;i++){
      const u=i/85;
      const radius=.025+.46*Math.pow(u,.7);
      const angle=preset.direction*preset.turns*Math.PI*2*u+arm*Math.PI*2/preset.arms;
      points.push(new THREE.Vector3(Math.cos(angle)*radius,Math.sin(angle)*radius,.018+Math.sin(angle*preset.depth)*.004));
    }
    const line=new THREE.Line(new THREE.BufferGeometry().setFromPoints(points),new THREE.LineBasicMaterial({color,transparent:true,opacity:.42,depthTest:false,depthWrite:false,blending:THREE.AdditiveBlending,toneMapped:false}));
    line.renderOrder=2;group.add(line);
  }
  return group;
}

function applySinTowerEditorPortalTransform(rec,force=false){
  let portal=rec?.portal;const current=portal?.id?getSinTowerEditorObjectById(portal.id,'portal'):null;if(current){portal=current;rec.portal=current;}
  if(!portal||!rec.group)return false;
  const position=sinTowerEditorWorldPosition(rec.sceneInfo,portal),rotation=deg(safeFinite(portal.rotationY,0)),signature=[position.x,position.y,position.z,rotation].join('|');
  if(force||rec.portalTransformSignature!==signature){rec.group.position.copy(position);rec.group.rotation.set(0,rotation,0);rec.portalTransformSignature=signature;}
  const pulse=safeFinite(rec.pulse,1);rec.visual?.scale.set(safeFinite(portal.width,1.8)*pulse,safeFinite(portal.height,2.6)*pulse,1);return true;
}

function buildSinTowerEditorPortal(portal){
  const sceneInfo=getSinTowerSceneById(portal.sceneId);
  if(sceneInfo.id!==SIN_TOWER_EDITOR.activeSceneId) return;
  const preset=getSinTowerPortalStylePreset(portal.portalStyle);
  const group=new THREE.Group();group.name=portal.title||'Portal';
  const visual=new THREE.Group();
  const color=new THREE.Color(portal.color||preset.color);
  const luminous=color.clone().offsetHSL(0,-.04,.3);
  const fill=new THREE.Mesh(new THREE.CircleGeometry(.475,96),new THREE.MeshBasicMaterial({color:luminous,transparent:true,opacity:.1,depthTest:false,depthWrite:false,side:THREE.DoubleSide,blending:THREE.AdditiveBlending,toneMapped:false}));
  const rim=new THREE.Mesh(new THREE.TorusGeometry(.5,.006,4,128),new THREE.MeshBasicMaterial({color:luminous,transparent:true,opacity:.96,depthTest:false,depthWrite:false,blending:THREE.AdditiveBlending,toneMapped:false}));
  fill.renderOrder=1;rim.renderOrder=5;
  const threads=makeSinTowerPortalSpiralThreads(portal,preset);
  const spiralA=makeSinTowerPortalPointCloud(portal,preset,560,0);
  const spiralB=makeSinTowerPortalPointCloud(portal,preset,340,1);
  const halo=makeSinTowerPortalHalo(portal,preset);halo.renderOrder=4;
  visual.add(fill,threads,spiralA,spiralB,halo,rim);group.add(visual);
  group.userData.sinTowerEditorType='portal';group.userData.sinTowerEditorId=portal.id;
  group.traverse(node=>{node.userData.sinTowerEditorType='portal';node.userData.sinTowerEditorId=portal.id;});
  sinTowerEditorSceneRoot.add(group);
  const rec={portal,sceneInfo,group,visual,fill,rim,threads,spiralA,spiralB,halo,preset,pulse:1,particleCount:1120};
  sinTowerEditorRuntime.portals.set(portal.id,rec);
  applySinTowerEditorPortalTransform(rec,true);
}

function updateSinTowerPortalFx(rec,t){
  if(!rec?.visual||!rec.portal) return;
  const current=getSinTowerEditorObjectById(rec.portal.id,'portal');
  if(current) rec.portal=current;
  const preset=rec.preset||getSinTowerPortalStylePreset(rec.portal.portalStyle);
  rec.pulse=1+Math.sin(t*(1.35+preset.speed*.25)+rec.portal.portalStyle)*.012;
  rec.threads.rotation.z=t*preset.speed*preset.direction;
  rec.spiralA.rotation.z=t*preset.speed*preset.direction;
  rec.spiralB.rotation.z=-t*preset.speed*.43*preset.direction+.4;
  rec.halo.rotation.z=t*.11*preset.direction;
  rec.spiralA.material.opacity=.9+Math.sin(t*1.7+rec.portal.portalStyle)*.08;
  rec.spiralB.material.opacity=.68+Math.sin(t*1.13)*.08;
  rec.fill.material.opacity=.085+Math.sin(t*.9+rec.portal.portalStyle)*.02;
  applySinTowerEditorPortalTransform(rec);
}

function applySinTowerEditorSceneVisibility(){
  const active = getSinTowerActiveScene();
  const stairVisible = active?.type === 'stairs';
  if(skyMesh) skyMesh.visible = stairVisible;
  if(atmosphereVolumeMesh) atmosphereVolumeMesh.visible = stairVisible;
  if(atmospherePoints) atmospherePoints.visible = stairVisible;
  if(sinTowerStairGroup) sinTowerStairGroup.visible = stairVisible;
  if(sinTowerMonkGroup) sinTowerMonkGroup.visible = stairVisible;
  if(lightRigGroup) lightRigGroup.visible = stairVisible;
  for(const g of [roomGroup, customWallGroup, floorTileGroup, waterGroup, referenceArchitectureGroup, artworkGroup]){
    if(g) g.visible = stairVisible;
  }
  if(scene){
    if(stairVisible) applyEnvironmentColors();
    else{
      scene.fog = null;
      scene.background = new THREE.Color(active?.skybox?.color || (active?.type === 'church' ? '#d8bc62' : '#101216'));
    }
  }
  requestSinTowerSceneShadowRefresh();
}

function rebuildSinTowerEditorRuntime(){
  ensureSinTowerEditorState();
  const root = ensureSinTowerEditorGroup();
  if(!root) return;
  clearSinTowerEditorSceneRoot();
  sinTowerEditorSceneRoot = new THREE.Group();
  sinTowerEditorSceneRoot.name = `Sin Tower Scene｜${getSinTowerActiveScene()?.title || ''}`;
  sinTowerEditorSceneRoot.userData.sinTowerSceneId = getSinTowerActiveScene()?.id || null;
  sinTowerEditorSceneRoot.userData.sinTowerSceneType = getSinTowerActiveScene()?.type || null;
  root.add(sinTowerEditorSceneRoot);
  const activeScene = getSinTowerActiveScene();
  makeSinTowerEditorSceneSkybox(activeScene);
  makeSinTowerEditorFloor(activeScene);
  for(const stone of SIN_TOWER_EDITOR.stones) buildSinTowerEditorStone(stone);
  rebuildSinTowerStoneSpatialIndex();
  for(const portal of SIN_TOWER_EDITOR.portals) buildSinTowerEditorPortal(portal);
  const loadState=window.__sinSceneLoad={generation:sinTowerEditorRuntime.generation,pending:0,errors:[]};
  function trackBuild(item,type,task){
    if(item.sceneId!==SIN_TOWER_EDITOR.activeSceneId)return;
    loadState.pending++;
    Promise.resolve(task).then(()=>{
      if(loadState!==window.__sinSceneLoad)return;
      const hasSource=type==='model'?!!(item.modelDataUrl||item.sourceUrl):item.mediaType==='gif'?!!item.gifDataUrl:item.mediaType==='video'?!!item.videoDataUrl:!!item.frames?.length;
      if(hasSource&&!sinTowerEditorRuntime[type==='model'?'models':'props'].has(item.id))throw Error('Asset did not initialize: '+item.id);
    }).catch(error=>loadState.errors.push(String(error.message||error))).finally(()=>{loadState.pending--;});
  }
  for(const prop of SIN_TOWER_EDITOR.props)trackBuild(prop,'prop',buildSinTowerEditorProp(prop));
  for(const model of SIN_TOWER_EDITOR.models)trackBuild(model,'model',buildSinTowerEditorModel(model));
  applySinTowerEditorSceneVisibility();
  syncSinProEditor?.();
}

function getSinTowerActiveSceneBounds(){
  const active = getSinTowerActiveScene();
  if(!active || active.type === 'stairs') return null;
  const d = active.dimensions || {w:20,d:30};
  return {minX:-d.w/2, maxX:d.w/2, minZ:-d.d/2, maxZ:d.d/2};
}

function getSinTowerEditorGroundY(){
  const active = getSinTowerActiveScene();
  if(!active || active.type === 'stairs') return null;
  return getSinTowerStoneSupportHeightAt(player.position.x, player.position.z);
}

function placePlayerAtSinTowerSceneSpawn(sceneState=getSinTowerActiveScene()){
  const target = sceneState || getSinTowerActiveScene();
  if(!target || !player) return;
  const spawn = sinTowerEditorVec3(target.spawn, target.type === 'stairs'
    ? {x:0,y:SIN_TOWER_STAIRCASE.rise,z:SIN_TOWER_STAIRCASE.startZ}
    : {x:0,y:0,z:0});
  player.position.set(spawn.x, spawn.y, spawn.z);
  playerVelocityY = 0;
  player.position.y = Math.max(spawn.y, safeFinite(getPlayerGroundY(), spawn.y));
  playerGroup?.position.copy(player.position);
}

function setSinTowerActiveScene(id, opts={}){
  closeSinTowerInteraction(false,false,true);
  closeSinTowerPlayAddPanel(false);
  const target = getSinTowerSceneById(id);
  if(!target) return;
  if(sinTowerStoneCarry.active) placeSinTowerCarriedStone();
  if(sinTowerModelCarry.active){ sinTowerModelCarry.active=false; sinTowerModelCarry.id=null; }
  SIN_TOWER_EDITOR.activeSceneId = target.id;
  SIN_TOWER_EDITOR.selectedObjectId = null;
  SIN_TOWER_EDITOR.selectedObjectType = null;
  rebuildSinTowerEditorRuntime();
  placePlayerAtSinTowerSceneSpawn(target);
  camYaw = target.type === 'stairs' ? 0 : camYaw;
  updateCamera();
  scheduleSinTowerRuntimeSave();
  if(!opts.silent) setStatus(`Scene: ${target.title}`);
}

function sinTowerIrregularDriftWave(t,seed,axis,irregularity){
  const phase=seed*.017+axis*2.173;
  const a=Math.sin(t+phase);
  const b=Math.sin(t*(1.73+axis*.11)+phase*1.91);
  const c=Math.sin(t*(2.61-axis*.08)+phase*.47);
  const mix=clamp(irregularity,0,1);
  return (a+b*.48*mix+c*.25*mix)/(1+.73*mix);
}

function applySinTowerObjectDrift(group,object,t,slot=0){
  if(!group||!object?.driftEnabled) return;
  const speed=clamp(safeFinite(object.driftSpeed,.65),.05,5);
  const distance=clamp(safeFinite(object.driftDistance,2),.05,20);
  const irregularity=clamp(safeFinite(object.driftIrregularity,.45),0,1);
  const seed=safeFinite(object.driftSeed,1)+slot*31.7;
  const axes=object.driftAxes||{x:true,y:false,z:false};
  if(axes.x) group.position.x+=sinTowerIrregularDriftWave(t*speed,seed,0,irregularity)*distance;
  if(axes.y) group.position.y+=sinTowerIrregularDriftWave(t*speed,seed,1,irregularity)*distance;
  if(axes.z) group.position.z+=sinTowerIrregularDriftWave(t*speed,seed,2,irregularity)*distance;
}

function sinTowerPropVisualMayBeOnScreen(visual,width,height){
  if(!visual?.group||!camera)return true;
  const point=visual.group.position,dx=point.x-camera.position.x,dy=point.y+height*.5-camera.position.y,dz=point.z-camera.position.z,far=Math.max(120,camera.far||120);
  if(dx*dx+dy*dy+dz*dz>far*far)return false;
  const projected=sinTowerPerfProjectionPoint.copy(point);projected.y+=height*.5;projected.project(camera);const margin=Math.min(2.5,.12+Math.max(width,height)*.04);return projected.z>=-1.2&&projected.z<=1.2&&Math.abs(projected.x)<=1+margin&&Math.abs(projected.y)<=1+margin;
}
const sinTowerPerfProjectionPoint=new THREE.Vector3();

function updateSinTowerEditorPropRecord(rec,t){
  if(!rec?.root||!rec.frames?.length)return;
  const current=getSinTowerEditorObjectById(rec.prop?.id,'prop');if(current)rec.prop=current;const prop=rec.prop;if(!prop)return;
  if(prop.interaction?.consumed){if(rec.root.visible)rec.root.visible=false;return;}if(!rec.root.visible)rec.root.visible=true;if(prop.interaction?.dissolving)return;
  refreshSinTowerEditorPropRepeats(rec);
  const fps=clamp(safeFinite(prop.fps,12),1,60),frame=prop.mediaType==='video'||prop.mediaType==='gif'?0:Math.floor((t*fps)%rec.frames.length),h=clamp(safeFinite(prop.height,2),.1,600),ratio=clamp(safeFinite(rec.frames[frame]?.ratio,.65),.02,20),spriteW=h*ratio*clamp(safeFinite(prop.widthMul,1),.1,12),glowEnabled=!!(prop.interaction?.enabled&&prop.interaction.glowEnabled!==false),particleCount=safeFinite(prop.interaction?.particleCount,840),axes=normalizeSinTowerParticleAxes(prop.interaction?.particleAxes);
  const styleSignature=[h,ratio,prop.widthMul,prop.rotationZ,glowEnabled,particleCount,axes.x,axes.y,axes.z,rec.lastRepeatAnchor,rec.visuals.length].join('|'),styleChanged=rec.visualStyleSignature!==styleSignature,frameChanged=rec.frame!==frame,dynamic=!!(prop.driftEnabled||prop.motion==='float'||prop.motion==='patrol');
  if(prop.mediaType==='gif'){let visible=false;for(const visual of rec.visuals)if(sinTowerPropVisualMayBeOnScreen(visual,spriteW,h)){visible=true;break;}updateSinTowerGifFrame(rec.frames[0],t,visible);}
  rec.frames[frame].material.rotation=deg(safeFinite(prop.rotationZ,0));
  for(const visual of rec.visuals){
    if(glowEnabled!==!!visual.particles||safeFinite(visual.particles?.userData?.particleCount,0)!==particleCount||!!visual.glow)setSinTowerPropVisualGlowEnabled(visual,prop,glowEnabled);
    if(prop.mediaType==='video'){if(prop.monoFilter===false)visual.sprite.layers.enable(SIN_TOWER_COLOR_BYPASS_LAYER);else visual.sprite.layers.disable(SIN_TOWER_COLOR_BYPASS_LAYER);}
    if(frameChanged||visual.sprite.material!==rec.frames[frame].material)visual.sprite.material=rec.frames[frame].material;
    if(styleChanged)visual.sprite.scale.set(spriteW,h,1);
    if(visual.glow){removeSinTowerInteractiveAura(visual.glow);visual.glow=null;}
    if(visual.particles){const particlePulse=1+Math.sin(t*1.35+visual.slot*.71)*.008;visual.particles.position.set(0,h*.5,.02);visual.particles.scale.set(spriteW*.5*particlePulse,h*.5*particlePulse,Math.max(.04,spriteW*.025));setSinTowerParticleWorldAxes(visual.particles,prop.interaction?.particleAxes);updateSinTowerRisingParticles(visual.particles,t+visual.slot*.19);visual.particles.material.opacity=.64+.16*(Math.sin(t*1.17+visual.slot)*.5+.5);}
    if(dynamic){const base=visual.group.userData.basePosition||visual.group.position;visual.group.position.copy(base);const phase=safeFinite(visual.step,prop.step);if(prop.driftEnabled)applySinTowerObjectDrift(visual.group,prop,t,visual.slot);else if(prop.motion==='float')visual.group.position.y+=Math.sin(t*safeFinite(prop.patrolSpeed,.65)*Math.PI*2+phase)*safeFinite(prop.floatAmp,.18);else{const axis=['x','y','z'].includes(prop.patrolAxis)?prop.patrolAxis:'x';visual.group.position[axis]+=Math.sin(t*safeFinite(prop.patrolSpeed,.65)+phase)*safeFinite(prop.patrolDistance,2);}}
  }
  rec.frame=frame;rec.visualStyleSignature=styleSignature;
}

function updateSinTowerInteractiveModelFx(rec,t){
  if(!rec?.group)return;const current=getSinTowerEditorObjectById(rec.model?.id,'model');if(current)rec.model=current;const model=rec.model;if(!model)return;
  if(model.interaction?.consumed){if(rec.group.visible)rec.group.visible=false;return;}if(!rec.group.visible)rec.group.visible=true;if(model.interaction?.dissolving)return;
  const glowEnabled=!!(model.interaction?.enabled&&model.interaction.glowEnabled!==false),count=clamp(Math.round(safeFinite(model.interaction?.particleCount,840)),120,2400);
  if(glowEnabled!==!!rec.particles||safeFinite(rec.particles?.userData?.particleCount,0)!==count||!!rec.aura)syncSinTowerModelInteractiveFx(rec);
  if(model.driftEnabled){rec.group.position.set(safeFinite(model.position?.x,0),safeFinite(model.position?.y,0),safeFinite(model.position?.z,0));applySinTowerObjectDrift(rec.group,model,t,0);}
  if(rec.particles){setSinTowerParticleWorldAxes(rec.particles,model.interaction?.particleAxes);updateSinTowerRisingParticles(rec.particles,t);rec.particles.material.opacity=.64+.18*(Math.sin(t*1.37)*.5+.5);}
}

function updateSinTowerEditorRuntime(dt){
  const t = performance.now() * .001;
  updateSinTowerModelCarry();
  updateSinTowerFollowedProp();
  updateSinTowerCarriedStone();
  for(const rec of sinTowerEditorRuntime.props.values()) updateSinTowerEditorPropRecord(rec, t);
  for(const rec of sinTowerEditorRuntime.models.values()) updateSinTowerInteractiveModelFx(rec,t);
  for(const rec of sinTowerEditorRuntime.portals.values()) updateSinTowerPortalFx(rec,t);
  updateSinTowerEditorPortals();
  updateSinTowerQuestionDissolves();
  updateSinTowerPortalPasswordCountdown();
}

function updateSinTowerEditorPortals(){
  if(sinAfterVideoSession)return;
  if(!isPlayMode()||sinTowerPortalGate.active)return;
  const now = performance.now();
  if(sinTowerPortalCooldownRemaining(now)>0) return;
  for(const rec of sinTowerEditorRuntime.portals.values()){
    const portal = rec.portal;
    if(sinTowerPortalGate.active)return;
    if(!portal || portal.sceneId !== SIN_TOWER_EDITOR.activeSceneId || !rec.group?.visible || isSinTowerPortalTemporarilyDisabled(portal,now)) continue;
    const p = rec.group.position;
    const dx = player.position.x - p.x;
    const dz = player.position.z - p.z;
    const dy = Math.abs(player.position.y + player.height * .45 - p.y);
    const radius = Math.max(.55, safeFinite(portal.width,1.8) * .42);
    if(dx*dx + dz*dz <= radius * radius && dy <= safeFinite(portal.height,2.6) * .62){
      if(beginSinTowerPortalTravel(portal)) break;
    }
  }
}

function isSinTowerAutoRunActive(){
  return !!(SIN_TOWER_STAIRCASE.enabled && SIN_TOWER_STAIRCASE.autoRun && !sinTowerRunFinished && isSinTowerStairSceneActive());
}


function sinTowerRand(seed){
  const x = Math.sin(seed * 12.9898 + 78.233) * 43758.5453123;
  return x - Math.floor(x);
}

function sinTowerSignedRand(seed){
  return sinTowerRand(seed) * 2 - 1;
}

function createSinTowerMonkFallback(){
  const g = new THREE.Group();
  const robeMat = new THREE.MeshStandardMaterial({color:0x786552, roughness:.9, metalness:0});
  const skinMat = new THREE.MeshStandardMaterial({color:0xd7b089, roughness:.82, metalness:0});
  const body = new THREE.Mesh(new THREE.CapsuleGeometry(.28,.58,6,12), robeMat);
  body.position.y = .58;
  body.rotation.x = deg(18);
  const head = new THREE.Mesh(new THREE.SphereGeometry(.16,16,12), skinMat);
  head.position.set(0,.98,-.16);
  const armGeo = new THREE.CapsuleGeometry(.055,.42,5,8);
  const armL = new THREE.Mesh(armGeo, skinMat);
  armL.position.set(-.16,.7,-.30); armL.rotation.set(deg(70),0,deg(-18));
  const armR = armL.clone(); armR.position.x = .16; armR.rotation.z = deg(18);
  const kneeGeo = new THREE.CapsuleGeometry(.07,.38,5,8);
  const kneeL = new THREE.Mesh(kneeGeo, robeMat);
  kneeL.position.set(-.16,.22,.13); kneeL.rotation.x = deg(82);
  const kneeR = kneeL.clone(); kneeR.position.x = .16;
  for(const o of [body,head,armL,armR,kneeL,kneeR]){ o.castShadow=true; o.receiveShadow=true; }
  g.add(body,head,armL,armR,kneeL,kneeR);
  g.userData.isFallbackMonk = true;
  return g;
}

function normaliseSinTowerMonkModel(model, targetHeight=1.08){
  model.updateMatrixWorld(true);
  const box = new THREE.Box3().setFromObject(model);
  const size = new THREE.Vector3();
  box.getSize(size);
  const scale = targetHeight / Math.max(size.y, .001);
  model.scale.multiplyScalar(scale);
  model.updateMatrixWorld(true);
  const box2 = new THREE.Box3().setFromObject(model);
  const center = new THREE.Vector3();
  box2.getCenter(center);
  model.position.x -= center.x;
  model.position.z -= center.z;
  model.position.y -= box2.min.y;
}

function repairSinTowerMonkMaterials(model){
  // v59：匯入大模型卡頓常見原因不是「模型一個就不能跑」，而是匯入後又為每隻僧侶複製骨架、材質、貼圖與 AnimationMixer。
  // 這裡不再把所有材質強制重建成新 MeshStandardMaterial，保留原材質與貼圖，並開啟 frustum culling 讓鏡頭外 mesh 不送進渲染。
  model.traverse(o=>{
    if(!o.isMesh && !o.isSkinnedMesh) return;
    o.castShadow = true;
    o.receiveShadow = true;
    o.frustumCulled = true;
    const mats = Array.isArray(o.material) ? o.material : [o.material];
    for(const m of mats){
      if(!m) continue;
      if('roughness' in m && m.roughness === undefined) m.roughness = .88;
      if('metalness' in m && m.metalness === undefined) m.metalness = 0;
      m.needsUpdate = true;
    }
    if(!o.material){
      o.material = new THREE.MeshStandardMaterial({color:0x8c7865, roughness:.88, metalness:0, skinning:!!o.isSkinnedMesh});
    }
  });
}

function getSinTowerCurrentStepIndex(){
  return Math.max(0, sinTowerStepIndexAtWorld(player.position.x, player.position.z));
}

function sinTowerMonkPlacement(index, anchorStep=null, slotSeed=null){
  const c = SIN_TOWER_STAIRCASE;
  const m = SIN_TOWER_MONKS;
  const slot = safeFinite(slotSeed, index);
  const r1 = sinTowerRand(m.seed + slot * 17.17);
  const r2 = sinTowerRand(m.seed + slot * 29.31);
  const r3 = sinTowerRand(m.seed + slot * 41.63);
  const visibleWindow = Math.max(m.minStep + 2, safeFinite(m.visibleStepWindow, 50));
  const span = Math.max(1, Math.min(m.maxStep - m.minStep, visibleWindow - m.minStep));
  const base = c.infinite ? Math.max(0, Math.floor(safeFinite(anchorStep, getSinTowerCurrentStepIndex()))) : 0;
  const step = Math.floor(base + m.minStep + r1 * span);
  // Use the full stair width, but keep the central running lane readable.
  // The old three lanes (-.88 / 0 / .88) made every monk pile up in the middle.
  const halfUsable = Math.max(2, c.width / 2 - 1.05);
  const centreClear = Math.min(1.65, halfUsable * .38);
  let lane = (r2 * 2 - 1) * halfUsable;
  if(Math.abs(lane) < centreClear){
    const side = lane < 0 ? -1 : 1;
    lane = side * (centreClear + r3 * Math.max(.1, halfUsable - centreClear));
  }
  const x = clamp(c.startX + lane, c.startX - halfUsable, c.startX + halfUsable);
  const z = c.startZ + c.directionZ * (step * c.depth + c.depth * (.38 + r3 * .32));
  const y = c.baseY + (step + 1) * c.rise + .015;
  const yaw = (c.directionZ < 0 ? 0 : Math.PI) + sinTowerSignedRand(m.seed + slot * 71.5) * .22;
  return {x,y,z,step,yaw,slot};
}

function applySinTowerMonkPlacement(rec, placement){
  if(!rec?.group || !placement) return;
  rec.group.position.set(placement.x, placement.y, placement.z);
  rec.group.rotation.y = placement.yaw;
  rec.group.userData.baseY = placement.y;
  rec.group.userData.step = placement.step;
  rec.group.userData.slot = placement.slot;
  rec.step = placement.step;
  rec.hit = false;
  rec.group.visible = true;
  rec.group.scale.setScalar(1);
  rec.group.userData.hitAt = 0;
}

function refreshInfiniteSinTowerMonkWindow(){
  if(!SIN_TOWER_STAIRCASE.infinite || !sinTowerMonks?.length) return;
  const current = getSinTowerCurrentStepIndex();
  const m = SIN_TOWER_MONKS;
  for(let i=0;i<sinTowerMonks.length;i++){
    const rec = sinTowerMonks[i];
    if(!rec?.group) continue;
    const visibleWindow = Math.max(m.minStep + 2, safeFinite(m.visibleStepWindow, 50));
    const tooFarBehind = rec.step < current - 8;
    const tooFarAhead = rec.step > current + visibleWindow;
    const hiddenAfterHit = rec.hit && rec.group.visible === false;
    if(tooFarBehind || tooFarAhead || hiddenAfterHit){
      rec.respawnSlot = Math.max(safeFinite(rec.respawnSlot, i), current + i + performance.now() * .001);
      rec.respawnSlot += sinTowerMonks.length + 7;
      const p = sinTowerMonkPlacement(i, current + Math.floor(i * 2.1), rec.respawnSlot);
      applySinTowerMonkPlacement(rec, p);
    }
  }
}

function placeSinTowerMonkInstance(model,index){
  if(!sinTowerMonkGroup) return;
  const p = sinTowerMonkPlacement(index, getSinTowerCurrentStepIndex(), index);
  const holder = new THREE.Group();
  holder.name = `斷罪塔｜跪地僧侶 ${String(index+1).padStart(2,'0')}`;
  holder.position.set(p.x,p.y,p.z);
  holder.rotation.y = p.yaw;
  holder.userData.baseY = p.y;
  holder.userData.seed = SIN_TOWER_MONKS.seed + index * 101;
  holder.userData.step = p.step;
  holder.add(model);
  sinTowerMonkGroup.add(holder);
  const rec = {group:holder, model, hit:false, step:p.step, respawnSlot:index, radius:SIN_TOWER_MONKS.hitRadius, mixer:null, action:null, kind:model?.userData?.isMonkSprite ? 'sprite' : 'model'};
  if(model.animations?.length){
    rec.mixer = new THREE.AnimationMixer(model);
    // Praying.fbx 已經是祈禱跪拜動畫，這裡不要 strip 掉 position track，避免又回到 T pose。
    rec.action = rec.mixer.clipAction(model.animations[0]);
    rec.action.enabled = true;
    rec.action.setLoop(THREE.LoopRepeat, Infinity);
    rec.action.timeScale = .88 + sinTowerRand(SIN_TOWER_MONKS.seed + index * 137.7) * .22;
    rec.action.play();
    rec.action.time = sinTowerRand(SIN_TOWER_MONKS.seed + index * 131.3) * Math.max(.1, rec.action.getClip().duration || 1);
    sinTowerMonkMixers.push(rec.mixer);
  }
  sinTowerMonks.push(rec);
  return rec;
}

function queueSinTowerMonkClone(rec, baseModel, index){
  if(!rec || !baseModel) return;
  rec.pendingCustomMonk = true;
  sinTowerMonkCloneQueue.push({rec, baseModel, index});
  scheduleSinTowerMonkClonePump();
}

function replaceSinTowerMonkRecordModel(rec, baseModel, index){
  if(!rec?.group || !baseModel) return;
  const old = rec.model;
  let instance;
  try{
    instance = SkeletonUtils.clone(baseModel);
    instance.animations = baseModel.animations || [];
  }catch(err){
    console.warn('monk clone failed', err);
    rec.pendingCustomMonk = false;
    return;
  }
  if(old?.parent === rec.group){
    rec.group.remove(old);
    // fallback 或舊 clone 移除後走分幀清理，避免匯入瞬間 dispose 卡死。
    const dq = SIN_TOWER_INFECTION.disposeQueue || (SIN_TOWER_INFECTION.disposeQueue = []);
    dq.push(old);
  }
  rec.model = instance;
  rec.group.add(instance);
  if(rec.mixer){ rec.mixer.stopAllAction?.(); rec.mixer = null; rec.action = null; }
  if(instance.animations?.length){
    rec.mixer = new THREE.AnimationMixer(instance);
    rec.action = rec.mixer.clipAction(instance.animations[0]);
    rec.action.enabled = true;
    rec.action.setLoop(THREE.LoopRepeat, Infinity);
    rec.action.timeScale = .88 + sinTowerRand(SIN_TOWER_MONKS.seed + index * 137.7) * .22;
    rec.action.play();
    rec.action.time = sinTowerRand(SIN_TOWER_MONKS.seed + index * 131.3) * Math.max(.1, rec.action.getClip().duration || 1);
  }
  rec.pendingCustomMonk = false;
}

function processSinTowerMonkCloneQueue(maxJobs=1){
  if(!sinTowerMonkCloneQueue.length) return;
  let jobs = 0;
  const current = getSinTowerCurrentStepIndex();
  const visibleWindow = Math.max(SIN_TOWER_MONKS.minStep + 2, safeFinite(SIN_TOWER_MONKS.visibleStepWindow, 50));
  // 先處理離玩家最近、即將進入畫面的僧侶；遠處不急著 clone。
  sinTowerMonkCloneQueue.sort((a,b)=>Math.abs((a.rec?.step||0)-current)-Math.abs((b.rec?.step||0)-current));
  while(sinTowerMonkCloneQueue.length && jobs < maxJobs){
    const job = sinTowerMonkCloneQueue.shift();
    if(!job?.rec?.group || !job.baseModel) continue;
    if(job.rec.step > current + visibleWindow + 8 || job.rec.step < current - 12){
      // 還不在使用者會看到的範圍，放回隊尾，避免匯入時一次把所有遠處模型 clone 完。
      sinTowerMonkCloneQueue.push(job);
      break;
    }
    replaceSinTowerMonkRecordModel(job.rec, job.baseModel, job.index);
    jobs++;
  }
}

function scheduleSinTowerMonkClonePump(){
  if(sinTowerMonkClonePumpActive) return;
  sinTowerMonkClonePumpActive = true;
  const pump = deadline=>{
    sinTowerMonkClonePumpActive = false;
    processSinTowerMonkCloneQueue(1);
    if(sinTowerMonkCloneQueue.length){
      sinTowerMonkClonePumpActive = true;
      if('requestIdleCallback' in window) requestIdleCallback(pump, {timeout:220});
      else setTimeout(()=>pump({timeRemaining:()=>3}), 40);
    }
  };
  if('requestIdleCallback' in window) requestIdleCallback(pump, {timeout:220});
  else setTimeout(()=>pump({timeRemaining:()=>3}), 40);
}

function populateSinTowerMonks(baseModel=null){
  if(!sinTowerMonkGroup) return;
  sinTowerMonkCloneQueue = [];
  for(const child of [...sinTowerMonkGroup.children]){
    sinTowerMonkGroup.remove(child);
    const dq = SIN_TOWER_INFECTION.disposeQueue || (SIN_TOWER_INFECTION.disposeQueue = []);
    dq.push(child);
  }
  sinTowerMonks = [];
  sinTowerMonkMixers = [];
  const count = clamp(Math.min(SIN_TOWER_MONKS.count, safeFinite(SIN_TOWER_MONKS.poolCount, 16)), 0, 36);
  for(let i=0;i<count;i++){
    if(SIN_TOWER_MONKS.useSpriteSequence && SIN_TOWER_MONKS.spriteFrames?.length){
      const spriteMonk = createSinTowerMonkSpriteModel(i);
      const rec = placeSinTowerMonkInstance(spriteMonk,i);
      if(rec) rec.kind = 'sprite';
      continue;
    }
    // v59：不要在匯入當下同步 SkeletonUtils.clone(baseModel) N 次。
    // 先用輕量 placeholder 建立碰撞/位置，再用 idle queue 一隻一隻替換成自訂動畫模型。
    const placeholder = createSinTowerMonkFallback();
    const rec = placeSinTowerMonkInstance(placeholder,i);
    if(baseModel && rec) queueSinTowerMonkClone(rec, baseModel, i);
  }
  if(SIN_TOWER_MONKS.useSpriteSequence && SIN_TOWER_MONKS.spriteFrames?.length) setStatus(`已改用 PNG 序列和尚：${SIN_TOWER_MONKS.spriteFrames.length} 格。`);
  else if(baseModel) setStatus(`和尚模型已排入背景替換：不再一次複製全部僧侶；會依視線前方 ${SIN_TOWER_MONKS.visibleStepWindow} 階逐步換成匯入模型。`);
}

function naturalSinTowerFileSort(a,b){
  return String(a.name || a.webkitRelativePath || '').localeCompare(String(b.name || b.webkitRelativePath || ''), undefined, {numeric:true, sensitivity:'base'});
}

function disposeSinTowerMonkSpriteAssets(){
  for(const u of SIN_TOWER_MONKS.spriteUrls || []){ try{ URL.revokeObjectURL(u); }catch(e){} }
  for(const f of SIN_TOWER_MONKS.spriteFrames || []){
    f.material?.dispose?.();
    f.texture?.dispose?.();
  }
  SIN_TOWER_MONKS.spriteUrls = [];
  SIN_TOWER_MONKS.spriteFrames = [];
  SIN_TOWER_MONKS.useSpriteSequence = false;
}

function createSinTowerMonkSpriteModel(index=0){
  const frames = SIN_TOWER_MONKS.spriteFrames || [];
  if(!frames.length) return createSinTowerMonkFallback();
  const g = new THREE.Group();
  g.name = '斷罪塔｜PNG序列和尚Sprite';
  const first = frames[0];
  const mat = first.material;
  const sprite = new THREE.Sprite(mat);
  sprite.name = '永遠面向鏡頭的PNG和尚';
  sprite.center.set(.5, 0); // 底部貼在階梯上，不用側面旋轉，不會看出紙片厚度。
  const h = Math.max(.2, safeFinite(SIN_TOWER_MONKS.spriteHeight, 1.18));
  const ratio = safeFinite(first.ratio, .62) * Math.max(.2, safeFinite(SIN_TOWER_MONKS.spriteWidthMul, 1));
  sprite.scale.set(h * ratio, h, 1);
  sprite.frustumCulled = true;
  g.add(sprite);
  // 透明陰影底座讓 Sprite 比較像站在/跪在階梯上，而不是浮貼片。
  const shadow = new THREE.Mesh(new THREE.CircleGeometry(.34, 24), new THREE.MeshBasicMaterial({color:0x000000, transparent:true, opacity:.20, depthWrite:false}));
  shadow.name = 'PNG和尚落地陰影';
  shadow.rotation.x = -Math.PI/2;
  shadow.position.y = .012;
  shadow.scale.set(1.0,.38,1);
  g.add(shadow);
  g.userData.isMonkSprite = true;
  g.userData.sprite = sprite;
  g.userData.spriteFrame = -1;
  g.userData.spriteOffset = index * .37;
  return g;
}

function updateSinTowerMonkSpriteFrame(rec, t){
  const frames = SIN_TOWER_MONKS.spriteFrames || [];
  const sprite = rec?.model?.userData?.sprite || rec?.group?.userData?.sprite;
  if(!sprite || !frames.length) return;
  const fps = Math.max(1, safeFinite(SIN_TOWER_MONKS.spriteFps, 12));
  const pause = Math.max(0, safeFinite(SIN_TOWER_MONKS.spriteLoopPause, .35));
  const pingpong = SIN_TOWER_MONKS.spritePingpong !== false;
  const localT = Math.max(0, t + safeFinite(rec.group?.userData?.seed,0) * .013);
  const n = frames.length;
  const oneWayDur = n / fps;
  const segmentDur = Math.max(.001, oneWayDur + pause);
  const segment = Math.floor(localT / segmentDur);
  const inSegment = localT - segment * segmentDur;
  const reverse = pingpong && (segment % 2 === 1);
  let frame;
  if(inSegment >= oneWayDur){
    frame = reverse ? 0 : n - 1;
  }else{
    const raw = clamp(Math.floor(inSegment * fps), 0, n - 1);
    frame = reverse ? (n - 1 - raw) : raw;
  }
  const last = rec.model.userData.spriteFrame;
  if(last !== frame){
    rec.model.userData.spriteFrame = frame;
    sprite.material = frames[frame].material;
  }
  const h = Math.max(.2, safeFinite(SIN_TOWER_MONKS.spriteHeight, 1.18));
  const widthMul = Math.max(.2, safeFinite(SIN_TOWER_MONKS.spriteWidthMul, 1));
  sprite.scale.set(h * safeFinite(frames[frame].ratio, .62) * widthMul, h, 1);
}

function sinTowerPngFrameNumber(file){
  const name = String(file?.name || file?.webkitRelativePath || '');
  const m = name.match(/(\d+)(?=\.[^.]+$)/);
  return m ? parseInt(m[1], 10) : null;
}

async function loadSinTowerBundledMonkSpriteSequence(){
  const loader = new THREE.TextureLoader();
  const frames = [];
  disposeSinTowerMonkSpriteAssets();
  for(let i=0;i<SIN_TOWER_BUNDLED_MONK_SPRITES.length;i++){
    const src = SIN_TOWER_BUNDLED_MONK_SPRITES[i];
    try{
      const tex = await new Promise((resolve,reject)=>loader.load(src, resolve, undefined, reject));
      tex.colorSpace = THREE.SRGBColorSpace;
      tex.minFilter = THREE.NearestFilter;
      tex.magFilter = THREE.NearestFilter;
      tex.generateMipmaps = false;
      tex.needsUpdate = true;
      const img = tex.image || {};
      const ratio = img.width && img.height ? img.width / img.height : .565;
      const mat = new THREE.SpriteMaterial({map:tex, transparent:true, alphaTest:.018, depthWrite:false, depthTest:true, sizeAttenuation:true});
      frames.push({texture:tex, material:mat, ratio, dataUrl:null, sourceUrl:src, no:i+1, name:`monkForword_${String(i+1).padStart(4,'0')}.png`});
    }catch(err){ console.warn('bundled monk sprite failed', src, err); }
  }
  if(!frames.length) return false;
  SIN_TOWER_MONKS.spriteFrames = frames;
  SIN_TOWER_MONKS.spriteUrls = [];
  SIN_TOWER_MONKS.useSpriteSequence = true;
  sinTowerBaseMonkModel = null;
  return true;
}

async function loadSinTowerMonkPngSequenceFiles(fileList){
  if($('sinMonkSpriteFps')) SIN_TOWER_MONKS.spriteFps = Number($('sinMonkSpriteFps').value || 12);
  if($('sinMonkSpriteStart')) SIN_TOWER_MONKS.spriteFrameStart = Number($('sinMonkSpriteStart').value || 1);
  if($('sinMonkSpriteEnd')) SIN_TOWER_MONKS.spriteFrameEnd = Number($('sinMonkSpriteEnd').value || 10);
  if($('sinMonkSpritePause')) SIN_TOWER_MONKS.spriteLoopPause = Number($('sinMonkSpritePause').value || .35);
  if($('sinMonkSpritePingpong')) SIN_TOWER_MONKS.spritePingpong = $('sinMonkSpritePingpong').checked !== false;
  if($('sinMonkSpriteHeight')) SIN_TOWER_MONKS.spriteHeight = Number($('sinMonkSpriteHeight').value || 1.18);
  if($('sinMonkSpriteWidthMul')) SIN_TOWER_MONKS.spriteWidthMul = Number($('sinMonkSpriteWidthMul').value || 1);
  const startNo = Math.min(safeFinite(SIN_TOWER_MONKS.spriteFrameStart,1), safeFinite(SIN_TOWER_MONKS.spriteFrameEnd,10));
  const endNo = Math.max(safeFinite(SIN_TOWER_MONKS.spriteFrameStart,1), safeFinite(SIN_TOWER_MONKS.spriteFrameEnd,10));
  const files = Array.from(fileList || [])
    .filter(f=>/\.png$/i.test(f.name || ''))
    .map(f=>({file:f, no:sinTowerPngFrameNumber(f)}))
    .filter(x=>x.no !== null && x.no >= startNo && x.no <= endNo)
    .sort((a,b)=>a.no-b.no || naturalSinTowerFileSort(a.file,b.file))
    .map(x=>x.file);
  if(!files.length){ setStatus(`PNG和尚資料夾沒有找到編號 ${startNo}-${endNo} 的 .png 檔。檔名需像 monkForword_0010.png。`); return; }
  setStatus(`正在載入 PNG 序列和尚：${files.length} 張，編號 ${startNo}-${endNo}。`);
  disposeSinTowerMonkSpriteAssets();
  const loader = new THREE.TextureLoader();
  const urls = [];
  const frames = [];
  for(const file of files){
    const dataUrl = await readAsDataURL(file, {maxSize:SIN_TOWER_EDITOR.perf.spriteMaxSize, preserveAlpha:true, mimeType:'image/png'});
    try{
      const tex = await new Promise((resolve,reject)=>loader.load(dataUrl, resolve, undefined, reject));
      tex.colorSpace = THREE.SRGBColorSpace;
      tex.minFilter = THREE.LinearFilter;
      tex.magFilter = THREE.LinearFilter;
      tex.generateMipmaps = false;
      tex.needsUpdate = true;
      const img = tex.image || {};
      const ratio = img.width && img.height ? img.width / img.height : .62;
      const mat = new THREE.SpriteMaterial({map:tex, transparent:true, alphaTest:.035, depthWrite:false, depthTest:true, sizeAttenuation:true});
      frames.push({texture:tex, material:mat, ratio, dataUrl, no:sinTowerPngFrameNumber(file), name:file.name || ''});
    }catch(err){ console.warn('PNG sequence frame failed', file.name, err); }
  }
  if(!frames.length){
    setStatus('PNG和尚序列載入失敗。');
    return;
  }
  SIN_TOWER_MONKS.spriteUrls = urls;
  SIN_TOWER_MONKS.spriteFrames = frames;
  SIN_TOWER_MONKS.useSpriteSequence = true;
  sinTowerBaseMonkModel = null;
  sinTowerMonkCloneQueue = [];
  populateSinTowerMonks(null);
  setStatus(`已載入 PNG 序列和尚：${frames.length} 張。正反播放：${SIN_TOWER_MONKS.spritePingpong !== false ? '開' : '關'}；停頓 ${SIN_TOWER_MONKS.spriteLoopPause}s；尺寸 ${SIN_TOWER_MONKS.spriteHeight} × ${SIN_TOWER_MONKS.spriteWidthMul}。`);
  scheduleSinTowerRuntimeSave();
}

function clearSinTowerMonkSpriteSequence(){
  disposeSinTowerMonkSpriteAssets();
  populateSinTowerMonks(sinTowerBaseMonkModel);
  setStatus('已清除 PNG 序列和尚。');
  scheduleSinTowerRuntimeSave();
}

function loadSinTowerMonkModelFromUrl(url, filename='custom'){
  if(!url) return;
  const lower = String(filename || url).toLowerCase();
  const finish = model=>{
    sinTowerBaseMonkModel = model;
    normaliseSinTowerMonkModel(sinTowerBaseMonkModel, SIN_TOWER_MONKS.modelHeight);
    repairSinTowerMonkMaterials(sinTowerBaseMonkModel);
    populateSinTowerMonks(sinTowerBaseMonkModel);
    setStatus(`已匯入路上和尚動畫模型：${filename}。模型會在背景依視線前方 ${SIN_TOWER_MONKS.visibleStepWindow} 階逐步替換，不再匯入瞬間複製整批骨架。`);
  };
  const fail = err=>{
    console.warn(err);
    setStatus('和尚動畫模型匯入失敗；請確認檔案是 FBX / GLB / GLTF 並且含有可讀動畫。');
  };
  if(lower.endsWith('.glb') || lower.endsWith('.gltf')){
    new GLTFLoader().load(url, gltf=>{
      const sceneObj = gltf.scene || gltf.scenes?.[0];
      if(!sceneObj) throw new Error('GLTF 沒有 scene');
      sceneObj.animations = gltf.animations || [];
      finish(sceneObj);
    }, undefined, fail);
  }else{
    new FBXLoader().load(url, fbx=>finish(fbx), undefined, fail);
  }
}

function loadSinTowerMonkModelFile(file){
  if(!file) return;
  disposeSinTowerMonkSpriteAssets();
  if(sinTowerMonkCustomObjectUrl) URL.revokeObjectURL(sinTowerMonkCustomObjectUrl);
  const url = URL.createObjectURL(file);
  sinTowerMonkCustomObjectUrl = url;
  loadSinTowerMonkModelFromUrl(url, file.name || 'custom monk');
}

function resetSinTowerMonkModelToDefault(){
  disposeSinTowerMonkSpriteAssets();
  if(sinTowerMonkCustomObjectUrl){ URL.revokeObjectURL(sinTowerMonkCustomObjectUrl); sinTowerMonkCustomObjectUrl = null; }
  sinTowerMonksLoaded = false;
  sinTowerBaseMonkModel = null;
  buildSinTowerMonks();
  setStatus('已恢復預設 Praying.fbx 僧侶模型。');
}

function buildSinTowerMonks(){
  if(!scene || !SIN_TOWER_MONKS.enabled) return;
  if(sinTowerMonkGroup){
    scene.remove(sinTowerMonkGroup);
    disposeObjectTree(sinTowerMonkGroup);
  }
  sinTowerMonkGroup = new THREE.Group();
  sinTowerMonkGroup.name = '斷罪塔｜隨機跪地祈禱僧侶';
  scene.add(sinTowerMonkGroup);
  populateSinTowerMonks(sinTowerBaseMonkModel);
  if(SIN_TOWER_MONKS.useSpriteSequence && SIN_TOWER_MONKS.spriteFrames?.length){
    sinTowerMonksLoaded = true;
    setStatus(`已載入指定 PNG 僧侶動畫：${SIN_TOWER_MONKS.spriteFrames.length} 格；僧侶會永久面向主角視角。`);
    return;
  }
  if(sinTowerMonksLoaded) return;
  sinTowerMonksLoaded = true;
  new FBXLoader().load(ASSET.monkPray, fbx=>{
    sinTowerBaseMonkModel = fbx;
    normaliseSinTowerMonkModel(sinTowerBaseMonkModel, SIN_TOWER_MONKS.modelHeight);
    repairSinTowerMonkMaterials(sinTowerBaseMonkModel);
    populateSinTowerMonks(sinTowerBaseMonkModel);
    setStatus('已載入斷罪塔：300 階樓梯、隨機跪地僧侶、碰撞腫瘤蔓延。');
  }, undefined, err=>{
    console.warn(err);
    populateSinTowerMonks(null);
    setStatus('僧侶 FBX 載入失敗，改用 JS 代理跪地僧侶；碰撞腫瘤蔓延仍啟用。');
  });
}

function resetSinTowerMonkHits(){
  for(const rec of sinTowerMonks){
    rec.hit = false;
    rec.group.visible = true;
    rec.group.scale.setScalar(1);
    rec.group.userData.hitAt = 0;
  }
}

function updateSinTowerMonks(dt){
  if(!SIN_TOWER_MONKS.enabled || !isSinTowerStairSceneActive()) return;
  refreshInfiniteSinTowerMonkWindow();
  processSinTowerMonkCloneQueue(1);
  const t = performance.now() * .001;
  const currentStep = getSinTowerCurrentStepIndex();
  const visibleWindow = Math.max(SIN_TOWER_MONKS.minStep + 2, safeFinite(SIN_TOWER_MONKS.visibleStepWindow, 50));
  for(const rec of sinTowerMonks){
    const g = rec.group;
    if(!g) continue;
    const totalSteps=getSinTowerTotalStepCount();
    const inWindow = rec.step >= currentStep - 8 && rec.step <= currentStep + visibleWindow && (totalSteps<=0 || rec.step<totalSteps);
    g.visible = !!inWindow && !(rec.hit && g.visible === false);
    if(rec.kind === 'sprite') updateSinTowerMonkSpriteFrame(rec, t);
    if(rec.mixer && g.visible && !rec.hit){
      const nearAnim = rec.step <= currentStep + Math.min(18, visibleWindow);
      const stagger = ((Math.floor(performance.now() / 120) + Math.floor(rec.step)) % 3) === 0;
      if(nearAnim || stagger) rec.mixer.update(nearAnim ? dt : dt * 3);
    }
    if(!g.visible) continue;
    const breathe = Math.sin(t * 1.7 + safeFinite(g.userData.seed,0)) * .015;
    g.position.y = safeFinite(g.userData.baseY,g.position.y) + breathe;
    if(rec.hit){
      const age = performance.now() - safeFinite(g.userData.hitAt,performance.now());
      const k = clamp(age / 420, 0, 1);
      g.scale.setScalar(1 - k * .82);
      if(k >= 1) g.visible = false;
      continue;
    }
    // FBX 僧侶整體轉向主角；PNG Sprite 本身永遠面向鏡頭，不需要轉 holder，避免看出紙片角度。
    if(rec.kind !== 'sprite'){
      const look = new THREE.Vector3(player.position.x - g.position.x, 0, player.position.z - g.position.z);
      if(look.lengthSq() > .0001){
        const desired = yawFromDirection(look);
        const d = Math.atan2(Math.sin(desired - g.rotation.y), Math.cos(desired - g.rotation.y));
        g.rotation.y += d * clamp(dt * 7.5, 0, 1);
      }
    }
    const dx = player.position.x - g.position.x;
    const dz = player.position.z - g.position.z;
    const dy = Math.abs(player.position.y - g.position.y);
    if(dx*dx + dz*dz <= rec.radius * rec.radius && dy < 1.6){
      rec.hit = true;
      playSinMonkHitSound();
      g.userData.hitAt = performance.now();
      if(!isSinTowerMeatballMode()) increaseSinTowerInfection();
      requestAnimationFrame(()=>triggerSinTowerFireFx());
      break;
    }
  }
}

function getSinTowerInfectionMaterials(){
  if(SIN_TOWER_INFECTION._materialInitLock) return SIN_TOWER_INFECTION;
  if(!SIN_TOWER_INFECTION.tumorMaterial){
    SIN_TOWER_INFECTION._materialInitLock = true;
    SIN_TOWER_INFECTION.tumorMaterial = new THREE.MeshStandardMaterial({color:0xd24b8c, roughness:.94, metalness:0, emissive:0x2d0015, emissiveIntensity:.14});
    SIN_TOWER_INFECTION.darkTumorMaterial = new THREE.MeshStandardMaterial({color:0x5a0b29, roughness:1, metalness:0, emissive:0x080003, emissiveIntensity:.05});
    SIN_TOWER_INFECTION.wrinkleMaterial = new THREE.MeshStandardMaterial({color:0x1b0508, roughness:1, metalness:0, emissive:0x030000, emissiveIntensity:.02});
    SIN_TOWER_INFECTION.tentacleMaterial = new THREE.MeshStandardMaterial({color:0xd33a8a, roughness:.86, metalness:0, emissive:0x3a001a, emissiveIntensity:.22});
    SIN_TOWER_INFECTION.eyeMaterial = new THREE.MeshStandardMaterial({color:0x62d4ff, roughness:.35, metalness:0, emissive:0x0a5d72, emissiveIntensity:.50});
    SIN_TOWER_INFECTION.pupilMaterial = new THREE.MeshBasicMaterial({color:0x000000, transparent:true, opacity:1, depthWrite:false, depthTest:true});
    SIN_TOWER_INFECTION.irisRingMaterial = new THREE.MeshBasicMaterial({color:0x050608, transparent:true, opacity:.96, depthWrite:false, depthTest:true});
    SIN_TOWER_INFECTION.pupilReliefMaterial = new THREE.MeshBasicMaterial({color:0x000000, transparent:true, opacity:.92, depthWrite:false, depthTest:true});
    SIN_TOWER_INFECTION.fungusPointMaterial = new THREE.PointsMaterial({size:.006, sizeAttenuation:true, vertexColors:true, transparent:true, opacity:.96, depthWrite:false});
    SIN_TOWER_INFECTION.fungusFineMaterial = new THREE.PointsMaterial({size:.0035, sizeAttenuation:true, vertexColors:true, transparent:true, opacity:.82, depthWrite:false});
    SIN_TOWER_INFECTION.vascularRibbonMaterial = new THREE.MeshBasicMaterial({vertexColors:true, transparent:true, opacity:.92, side:THREE.DoubleSide, depthWrite:false});
    SIN_TOWER_INFECTION.honeycombMaterial = new THREE.MeshStandardMaterial({color:0x220306, roughness:1, metalness:0, emissive:0x050001, emissiveIntensity:.03});
    SIN_TOWER_INFECTION.eyeRimMaterial = new THREE.MeshStandardMaterial({color:0xe58aa0, roughness:.92, metalness:0, emissive:0x26000b, emissiveIntensity:.10});
    SIN_TOWER_INFECTION.vascularGradient = [
      new THREE.MeshStandardMaterial({color:0x260207, roughness:1, metalness:0, emissive:0x090000, emissiveIntensity:.06}),
      new THREE.MeshStandardMaterial({color:0x5b0712, roughness:1, metalness:0, emissive:0x160002, emissiveIntensity:.08}),
      new THREE.MeshStandardMaterial({color:0xb6243c, roughness:.96, metalness:0, emissive:0x2a0008, emissiveIntensity:.12}),
      new THREE.MeshStandardMaterial({color:0xe06a83, roughness:.92, metalness:0, emissive:0x31000c, emissiveIntensity:.14})
    ];

    // 多種紅色腫瘤材質：不是單一粉紅球。共用材質池，避免每顆腫瘤 new material。
    SIN_TOWER_INFECTION.tumorPalette = [
      SIN_TOWER_INFECTION.tumorMaterial,
      new THREE.MeshStandardMaterial({color:0xbe244f, roughness:.96, metalness:0, emissive:0x240006, emissiveIntensity:.12}),
      new THREE.MeshStandardMaterial({color:0xe05066, roughness:.93, metalness:0, emissive:0x300009, emissiveIntensity:.13}),
      new THREE.MeshStandardMaterial({color:0x8f1232, roughness:.98, metalness:0, emissive:0x140002, emissiveIntensity:.08}),
      new THREE.MeshStandardMaterial({color:0xf06f73, roughness:.91, metalness:0, emissive:0x30000a, emissiveIntensity:.10}),
      new THREE.MeshStandardMaterial({color:0xa9185d, roughness:.97, metalness:0, emissive:0x1c000d, emissiveIntensity:.10}),
      new THREE.MeshStandardMaterial({color:0x6d0a20, roughness:1, metalness:0, emissive:0x090001, emissiveIntensity:.05})
    ];
    SIN_TOWER_INFECTION.tentaclePalette = [
      SIN_TOWER_INFECTION.tentacleMaterial,
      new THREE.MeshStandardMaterial({color:0x7e143e, roughness:.96, metalness:0, emissive:0x100004, emissiveIntensity:.08}),
      new THREE.MeshStandardMaterial({color:0xc63d6e, roughness:.92, metalness:0, emissive:0x200006, emissiveIntensity:.12}),
      new THREE.MeshStandardMaterial({color:0x5b0b25, roughness:1, metalness:0, emissive:0x060002, emissiveIntensity:.05})
    ];

    // 真菌改成點狀孢子，不再是大片綠色葉片。
    SIN_TOWER_INFECTION.fungusMaterial = new THREE.MeshStandardMaterial({color:0xd8c6a0, roughness:1, metalness:0, emissive:0x20170d, emissiveIntensity:.10});
    SIN_TOWER_INFECTION.algaeMaterial = new THREE.MeshStandardMaterial({color:0x8b7355, roughness:1, metalness:0, emissive:0x130b06, emissiveIntensity:.06});
    SIN_TOWER_INFECTION._materialInitLock = false;
  }
  applySinTowerEyeStyleMaterials?.();
  return SIN_TOWER_INFECTION;
}

function parseSinTowerTumorSizeRange(raw){
  const txt = String(raw ?? '').trim();
  const nums = (txt.match(/-?\d*\.?\d+/g) || []).map(Number).filter(v=>Number.isFinite(v));
  let minV = 3, maxV = 18;
  if(nums.length >= 2){
    minV = nums[0];
    maxV = nums[1];
  }else if(nums.length === 1){
    minV = nums[0];
    maxV = nums[0];
  }
  minV = clamp(Math.abs(minV || 3), 1, 999);
  maxV = clamp(Math.abs(maxV || minV), 1, 999);
  if(maxV < minV){
    const t = minV; minV = maxV; maxV = t;
  }
  return {text:`${minV}-${maxV}`, min:minV, max:maxV};
}

function getSinTowerTumorParams(){
  const p = SIN_TOWER_INFECTION.params || (SIN_TOWER_INFECTION.params = {});
  const meatballLevel = Math.round(clamp(safeFinite(p.meatballLevel, SIN_TOWER_INFECTION.meatballLevel || 20), 20, 60));
  SIN_TOWER_INFECTION.meatballLevel = meatballLevel;
  const sizeRange = parseSinTowerTumorSizeRange(p.tumorSizeRange ?? p.tumorSizeMul ?? '3-18');
  p.tumorSizeRange = sizeRange.text;

  const tentacleLengthMul = clamp(safeFinite(p.tentacleLengthMul,1.3), .25, 2.6);
  const tentacleThickMin = clamp(safeFinite(p.tentacleThickMin,.75), .25, 2.2);
  const tentacleThickMax = Math.max(tentacleThickMin, clamp(safeFinite(p.tentacleThickMax,1.65), .25, 2.2));
  // v75：舊版自動儲存可能還留著 10、12、999 這類失控值。讀取時直接寫回安全值，避免下次又被套用。
  p.tentacleLengthMul = tentacleLengthMul;
  p.tentacleThickMin = tentacleThickMin;
  p.tentacleThickMax = tentacleThickMax;
  p.eyeRimColor = /^#[0-9a-fA-F]{6}$/.test(String(p.eyeRimColor||'')) ? p.eyeRimColor : '#e58aa0';
  p.eyePupilColor = /^#[0-9a-fA-F]{6}$/.test(String(p.eyePupilColor||'')) ? p.eyePupilColor : '#000000';
  p.batchMul = clamp(safeFinite(p.batchMul,2.4), .5, 8);
  p.growthSpeed = clamp(safeFinite(p.growthSpeed,4.0), .25, 8);
  p.secondarySkeletonLevel = Math.round(clamp(safeFinite(p.secondarySkeletonLevel,5), 1, 30));
  p.thirdSkeletonLevel = Math.round(clamp(safeFinite(p.thirdSkeletonLevel,10), p.secondarySkeletonLevel + 1, 60));

  return {
    tumorSizeRange:sizeRange.text,
    tumorSizeMin:sizeRange.min,
    tumorSizeMax:sizeRange.max,
    colorVariation:clamp(safeFinite(p.colorVariation,1), 0, 1.5),
    tumorColorPalette:String(p.tumorColorPalette || '#d24b8c,#be244f,#e05066,#8f1232,#f06f73,#a9185d,#6d0a20'),
    eyeScale:clamp(safeFinite(p.eyeScale,1.35), .2, 4),
    eyeRimColor:p.eyeRimColor,
    eyePupilColor:p.eyePupilColor,
    tentacleLengthMul,
    tentacleThickMin,
    tentacleThickMax,
    batchMul:p.batchMul,
    growthSpeed:p.growthSpeed,
    secondarySkeletonLevel:p.secondarySkeletonLevel,
    thirdSkeletonLevel:p.thirdSkeletonLevel,
    meatballLevel,
    fungusColorVar:clamp(safeFinite(p.fungusColorVar,1.0), 0, 2),
    fungusShapeVar:clamp(safeFinite(p.fungusShapeVar,1.0), 0, 2),
    fungusClusterMul:clamp(safeFinite(p.fungusClusterMul,1.0), .25, 6)
  };
}

function sinTowerTumorSizeValueToWorldRadius(v, micro=false){
  // v77：X-Y 直接對應最後世界半徑。30-100 與 100-300 必須有明顯差距。
  // 主腫瘤：1 單位 = 0.006m；100-300 約 0.6m-1.8m。
  // micro 只給細碎小粒，不參與主體尺寸判斷。
  const x = clamp(Math.abs(safeFinite(v, 3)), 1, 999);
  const scale = micro ? 0.0022 : 0.0060;
  const hardMax = micro ? 0.42 : 2.20;
  const hardMin = micro ? 0.005 : 0.010;
  return clamp(x * scale, hardMin, hardMax);
}

function sinTowerTumorSizeValueToMultiplier(v){
  // 保留舊函式名稱，避免殘留呼叫；回傳值只供舊公式參考，不再作為主要尺寸依據。
  return sinTowerTumorSizeValueToWorldRadius(v, false) / 0.060;
}

function getSinTowerTumorRangeWorld(micro=false){
  const tp = getSinTowerTumorParams();
  const a = sinTowerTumorSizeValueToWorldRadius(tp.tumorSizeMin, micro);
  const b = sinTowerTumorSizeValueToWorldRadius(tp.tumorSizeMax, micro);
  return {min:Math.min(a,b), max:Math.max(a,b)};
}

function getSinTowerMaxTumorRadiusWorld(micro=false){
  return getSinTowerTumorRangeWorld(micro).max;
}

function clampSinTowerTumorRadiusForFinalScale(r, micro=false){
  const range = getSinTowerTumorRangeWorld(micro);
  return clamp(safeFinite(r, range.min), range.min, range.max);
}

function clampSinTowerLocalRadiusByWorldLimit(localRadius, unit=1, micro=false, worldMul=1){
  const u = Math.max(.001, safeFinite(unit,1));
  const range = getSinTowerTumorRangeWorld(micro);
  const maxLocal = range.max * Math.max(.1, safeFinite(worldMul,1)) * u;
  const minLocal = Math.max(.002 * u, range.min * .35 * u);
  return clamp(safeFinite(localRadius, minLocal), minLocal, Math.max(minLocal, maxLocal));
}

function clampSinTowerTentacleLengthWorld(v){
  // v79：觸手長度不能被腫瘤尺寸上限壓到幾乎看不見。
  // 腫瘤 X-Y 控制單顆肉瘤半徑；觸手則用獨立的長條上限，保留可見的伸出效果。
  const maxBySize = Math.max(.62, getSinTowerMaxTumorRadiusWorld(false) * 4.2);
  return clamp(safeFinite(v,.42), .08, Math.min(1.65, maxBySize));
}

function clampSinTowerTentacleTubeRadiusWorld(v){
  const max = Math.min(.090, Math.max(.010, getSinTowerMaxTumorRadiusWorld(false) * .18));
  return clamp(safeFinite(v,.014), .0035, max);
}

function getSinTowerSizeRangeWorldRadius(seed, progress=0, micro=false){
  const tp = getSinTowerTumorParams();
  const t = micro ? sinTowerRand(seed+901) * .42 : sinTowerRand(seed+901);
  const raw = THREE.MathUtils.lerp(tp.tumorSizeMin, tp.tumorSizeMax, t);
  const r = sinTowerTumorSizeValueToWorldRadius(raw, micro);
  // 成長進度只給非常小的呼吸差，不能把 X-Y 範圍再放大。
  const wobble = .96 + sinTowerRand(seed+902) * .08;
  return clampSinTowerTumorRadiusForFinalScale(r * wobble, micro);
}

function getSinTowerSizeRangeMultiplier(seed, progress=0, micro=false){
  // 舊名稱保留：改由世界半徑反推，不再造成多層倍率暴衝。
  const r = getSinTowerSizeRangeWorldRadius(seed, progress, micro);
  return clamp(r / (micro ? .018 : .060), .20, 20);
}

function parseSinTowerTumorColorPalette(raw){
  const fallback = ['#d24b8c','#be244f','#e05066','#8f1232','#f06f73','#a9185d','#6d0a20'];
  const txt = String(raw || '');
  const matches = txt.match(/#[0-9a-fA-F]{6}/g) || [];
  const out = [];
  for(const h of matches){
    const low = h.toLowerCase();
    if(!out.includes(low)) out.push(low);
  }
  return out.length ? out : fallback;
}

function sinTowerHexLerp(hex, mul=.72){
  const c = new THREE.Color(hex);
  c.r = clamp(c.r * mul, 0, 1);
  c.g = clamp(c.g * mul, 0, 1);
  c.b = clamp(c.b * mul, 0, 1);
  return '#' + c.getHexString();
}

function ensureSinTowerRuntimeColorPalettes(){
  const mats = getSinTowerInfectionMaterials();
  const tp = getSinTowerTumorParams();
  const colors = parseSinTowerTumorColorPalette(tp.tumorColorPalette);
  const key = colors.join(',');
  if(SIN_TOWER_INFECTION.runtimeTumorPaletteKey === key && mats.tumorPalette?.length) return;
  if(SIN_TOWER_INFECTION.runtimePaletteMaterials){
    for(const m of SIN_TOWER_INFECTION.runtimePaletteMaterials) m?.dispose?.();
  }
  SIN_TOWER_INFECTION.runtimePaletteMaterials = [];
  const tumorPalette = [];
  const tentaclePalette = [];
  for(const hex of colors){
    const col = new THREE.Color(hex);
    const emo = new THREE.Color(sinTowerHexLerp(hex, .22));
    const darker = new THREE.Color(sinTowerHexLerp(hex, .58));
    const tm = new THREE.MeshStandardMaterial({color:col, roughness:.94, metalness:0, emissive:emo, emissiveIntensity:.12});
    const ten = new THREE.MeshStandardMaterial({color:darker, roughness:.92, metalness:0, emissive:emo, emissiveIntensity:.10});
    tumorPalette.push(tm);
    tentaclePalette.push(ten);
    SIN_TOWER_INFECTION.runtimePaletteMaterials.push(tm, ten);
  }
  mats.tumorPalette = tumorPalette;
  mats.tentaclePalette = tentaclePalette;
  mats.tumorMaterial = tumorPalette[0] || mats.tumorMaterial;
  mats.tentacleMaterial = tentaclePalette[0] || mats.tentacleMaterial;
  SIN_TOWER_INFECTION.runtimeTumorPaletteKey = key;
}

function applySinTowerEyeStyleMaterials(){
  const mats = SIN_TOWER_INFECTION || {};
  const tp = getSinTowerTumorParams();
  const rim = new THREE.Color(tp.eyeRimColor || '#e58aa0');
  const pupil = new THREE.Color(tp.eyePupilColor || '#000000');
  mats.eyeRimMaterial?.color?.copy(rim);
  mats.eyeRimMaterial?.emissive?.copy(rim.clone().multiplyScalar(.18));
  if(mats.pupilOverlayMaterial?.color) mats.pupilOverlayMaterial.color.copy(pupil);
  if(mats.pupilMaterial?.color) mats.pupilMaterial.color.copy(pupil);
  if(mats.pupilReliefMaterial?.color) mats.pupilReliefMaterial.color.copy(pupil);
  if(mats.irisRingMaterial?.color) mats.irisRingMaterial.color.copy(pupil.clone().lerp(new THREE.Color(0x222222), .25));
}

function getSinTowerTumorMaterial(seed, micro=false){
  ensureSinTowerRuntimeColorPalettes();
  applySinTowerEyeStyleMaterials();
  const mats = getSinTowerInfectionMaterials();
  const arr = mats.tumorPalette || [mats.tumorMaterial, mats.darkTumorMaterial];
  const colorVar = getSinTowerTumorParams().colorVariation;
  if(colorVar <= .03) return mats.tumorMaterial;
  const span = Math.max(1, Math.floor(1 + (arr.length - 1) * colorVar));
  let idx = Math.floor(sinTowerRand(seed+444) * span) % arr.length;
  if(micro && sinTowerRand(seed+445) > .62) idx = Math.min(arr.length-1, idx+1);
  return arr[idx] || mats.tumorMaterial;
}

function getSinTowerTentacleMaterial(seed){
  ensureSinTowerRuntimeColorPalettes();
  const mats = getSinTowerInfectionMaterials();
  const arr = mats.tentaclePalette || [mats.tentacleMaterial];
  return arr[Math.floor(sinTowerRand(seed+544) * arr.length)] || mats.tentacleMaterial;
}

function getSinTowerTumorSizeTier(seed){
  return 1 + Math.floor(clamp(sinTowerRand(seed+805),0,.9999) * 10);
}

function getSinTowerTumorRadiusWorld(seed, progress, micro=false){
  return getSinTowerSizeRangeWorldRadius(seed, progress, micro);
}

function getSinTowerCoverTumorRadiusWorld(seed, coverP, micro=false){
  return getSinTowerSizeRangeWorldRadius(seed+77, coverP, micro);
}

function getSinTowerCachedFungusDotGeometry(){
  const cache = SIN_TOWER_INFECTION.fungusGeometryCache || (SIN_TOWER_INFECTION.fungusGeometryCache = new Map());
  const key = 'unit_fungus_dot';
  if(cache.has(key)) return cache.get(key);
  const geo = new THREE.SphereGeometry(1, 8, 6);
  cache.set(key, geo);
  return geo;
}


function getSinTowerCachedEyeGeometry(){
  const cache = SIN_TOWER_INFECTION.geometryCache;
  const key = 'eye_unit_geo';
  if(cache.has(key)) return cache.get(key);
  const geo = new THREE.SphereGeometry(1, 12, 8);
  cache.set(key, geo);
  return geo;
}

function getSinTowerPupilOverlayMaterial(){
  const mats = getSinTowerInfectionMaterials();
  if(mats.pupilOverlayMaterial) return mats.pupilOverlayMaterial;
  const size = 192;
  const canvas = document.createElement('canvas');
  canvas.width = canvas.height = size;
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0,0,size,size);
  const cx = size/2, cy = size/2;
  // 透明底，上面只畫黑色圓形瞳孔、凹陷環和不規則放射暗紋。
  ctx.save();
  const grad = ctx.createRadialGradient(cx,cy,4,cx,cy,70);
  grad.addColorStop(0,'rgba(0,0,0,1)');
  grad.addColorStop(.30,'rgba(0,0,0,1)');
  grad.addColorStop(.54,'rgba(5,5,8,.95)');
  grad.addColorStop(.74,'rgba(12,18,20,.72)');
  grad.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle = grad;
  ctx.beginPath(); ctx.arc(cx,cy,70,0,Math.PI*2); ctx.fill();
  ctx.strokeStyle = 'rgba(0,0,0,.95)';
  ctx.lineWidth = 8;
  for(const r of [24,39,55]){ ctx.beginPath(); ctx.arc(cx,cy,r,0,Math.PI*2); ctx.stroke(); }
  ctx.lineWidth = 3;
  ctx.strokeStyle = 'rgba(0,0,0,.88)';
  for(let i=0;i<34;i++){
    const a = i/34*Math.PI*2 + Math.sin(i*12.9898)*.10;
    const r0 = 14 + (i%5)*3;
    const r1 = 58 + Math.sin(i*7.13)*9;
    ctx.beginPath();
    ctx.moveTo(cx+Math.cos(a)*r0, cy+Math.sin(a)*r0);
    const mid = (r0+r1)*.5;
    ctx.quadraticCurveTo(cx+Math.cos(a+.12*Math.sin(i))*mid, cy+Math.sin(a-.10*Math.cos(i))*mid, cx+Math.cos(a)*r1, cy+Math.sin(a)*r1);
    ctx.stroke();
  }
  ctx.fillStyle = 'rgba(0,0,0,1)';
  ctx.beginPath(); ctx.arc(cx,cy,19,0,Math.PI*2); ctx.fill();
  ctx.restore();
  const tex = new THREE.CanvasTexture(canvas);
  tex.colorSpace = THREE.SRGBColorSpace;
  tex.needsUpdate = true;
  mats.pupilOverlayMaterial = new THREE.MeshBasicMaterial({map:tex, transparent:true, depthWrite:false, depthTest:true, side:THREE.FrontSide, toneMapped:false, polygonOffset:true, polygonOffsetFactor:-2, polygonOffsetUnits:-2});
  return mats.pupilOverlayMaterial;
}

function getSinTowerPupilOverlayGeometry(){
  if(SIN_TOWER_INFECTION.pupilOverlayGeometry) return SIN_TOWER_INFECTION.pupilOverlayGeometry;
  const geo = new THREE.PlaneGeometry(1,1,1,1);
  SIN_TOWER_INFECTION.pupilOverlayGeometry = geo;
  return geo;
}

function getSinTowerEyeDecalMaterial(){
  const mats = getSinTowerInfectionMaterials();
  if(mats.eyeDecalMaterial) return mats.eyeDecalMaterial;
  const size = 256;
  const canvas = document.createElement('canvas');
  canvas.width = canvas.height = size;
  const ctx = canvas.getContext('2d');
  const cx=size/2, cy=size/2;
  ctx.clearRect(0,0,size,size);
  ctx.save();
  ctx.translate(cx,cy);
  ctx.scale(1,1);
  const rim = ctx.createRadialGradient(0,0,4,0,0,92);
  rim.addColorStop(0,'rgba(0,0,0,1)');
  rim.addColorStop(.18,'rgba(0,0,0,1)');
  rim.addColorStop(.23,'rgba(10,12,16,.95)');
  rim.addColorStop(.40,'rgba(42,165,205,.92)');
  rim.addColorStop(.67,'rgba(92,220,255,.95)');
  rim.addColorStop(.82,'rgba(238,142,170,.98)');
  rim.addColorStop(.94,'rgba(65,0,18,.96)');
  rim.addColorStop(1,'rgba(0,0,0,0)');
  ctx.fillStyle=rim;
  ctx.beginPath(); ctx.arc(0,0,92,0,Math.PI*2); ctx.fill();
  ctx.globalCompositeOperation='source-over';
  ctx.lineCap='round';
  ctx.strokeStyle='rgba(0,0,0,.72)';
  for(let i=0;i<44;i++){
    const a=i/44*Math.PI*2 + Math.sin(i*15.7)*.05;
    const r0=20 + (i%4)*3;
    const r1=72 + Math.sin(i*4.9)*8;
    ctx.lineWidth = 1.2 + (i%3)*.8;
    ctx.beginPath();
    ctx.moveTo(Math.cos(a)*r0, Math.sin(a)*r0);
    ctx.quadraticCurveTo(Math.cos(a+.15)*((r0+r1)*.5), Math.sin(a-.12)*((r0+r1)*.5), Math.cos(a)*r1, Math.sin(a)*r1);
    ctx.stroke();
  }
  ctx.strokeStyle='rgba(0,0,0,.80)';
  for(const rr of [28,43,61]){ ctx.lineWidth= rr===28 ? 5 : 3; ctx.beginPath(); ctx.arc(0,0,rr,0,Math.PI*2); ctx.stroke(); }
  ctx.fillStyle='rgba(0,0,0,1)';
  ctx.beginPath(); ctx.arc(0,0,25,0,Math.PI*2); ctx.fill();
  const shine=ctx.createRadialGradient(-28,-24,1,-28,-24,16);
  shine.addColorStop(0,'rgba(255,255,255,.82)'); shine.addColorStop(1,'rgba(255,255,255,0)');
  ctx.fillStyle=shine; ctx.beginPath(); ctx.arc(-28,-24,16,0,Math.PI*2); ctx.fill();
  ctx.restore();
  const tex = new THREE.CanvasTexture(canvas);
  tex.colorSpace = THREE.SRGBColorSpace;
  tex.needsUpdate = true;
  mats.eyeDecalMaterial = new THREE.MeshBasicMaterial({map:tex, transparent:true, depthWrite:false, depthTest:true, side:THREE.FrontSide, toneMapped:false, polygonOffset:true, polygonOffsetFactor:-3, polygonOffsetUnits:-3});
  return mats.eyeDecalMaterial;
}

function addSinTowerComplexPupil(holder, radius, seed, eyeMul=1, frontZ=0){
  // 瞳孔獨立於眼球主 mesh，避免被眼球縮放吃掉。
  // 這版改成一片貼在眼球前方的黑色圓形瞳孔貼片：一個 mesh 就包含中央黑洞、凹陷環與放射紋，清楚且比十幾個小 mesh 更穩。
  const group = new THREE.Group();
  group.name = '黑色圓形瞳孔與凹陷放射紋';
  group.position.z = frontZ;
  const overlay = new THREE.Mesh(getSinTowerPupilOverlayGeometry(), getSinTowerPupilOverlayMaterial());
  const s = Math.max(radius * .47 * eyeMul, .006);
  overlay.scale.set(s, s, 1);
  overlay.renderOrder = 7;
  group.add(overlay);
  holder.add(group);
  return group;
}

function getSinTowerCachedHoneycombHoleGeometry(){
  const cache = SIN_TOWER_INFECTION.geometryCache;
  const key = 'honeycomb_hole_geo';
  if(cache.has(key)) return cache.get(key);
  const geo = new THREE.CylinderGeometry(1, 1.12, 1, 6, 1, false);
  cache.set(key, geo);
  return geo;
}


function getSinTowerCompoundLobeGeometry(){
  if(SIN_TOWER_INFECTION.compoundLobeGeometry) return SIN_TOWER_INFECTION.compoundLobeGeometry;
  const geo = new THREE.IcosahedronGeometry(1, 3);
  ensureProjectedUV?.(geo);
  SIN_TOWER_INFECTION.compoundLobeGeometry = geo;
  return geo;
}

function getSinTowerCompoundLobeMaterial(){
  if(SIN_TOWER_INFECTION.compoundLobeMaterial) return SIN_TOWER_INFECTION.compoundLobeMaterial;
  const mat = new THREE.MeshStandardMaterial({
    color:0xd13a4f,
    roughness:.88,
    metalness:0,
    vertexColors:false,
    emissive:0x260006,
    emissiveIntensity:.10
  });
  // v30：上一版最終肉球在部分環境會整顆變黑，主因是 InstancedMesh 的 instanceColor/vertexColors 在重建時狀態不穩。
  // 這裡改成固定肉紅材質；顏色變化由實際長出的多顆腫瘤維持，不再讓外殼吃到黑色 instance color。
  SIN_TOWER_INFECTION.compoundLobeMaterial = mat;
  return mat;
}

function updateSinTowerCompoundLobeShell(level, force=false){
  // v31：完全停用「合併肉球外殼 / InstancedMesh 小肉球殼」。
  // 後期只能由 addSinTowerMeatballWrapStage() 與 buildSinTowerTumorOnSpine() 生成的真實腫瘤一顆一顆堆出來，
  // 不再用假外殼、合併球、簡化球殼取代已長出的腫瘤。
  const mesh = SIN_TOWER_INFECTION.compoundLobeMesh;
  if(mesh){
    mesh.visible = false;
    if(mesh.parent) mesh.parent.remove(mesh);
    if(mesh.dispose) mesh.dispose();
    SIN_TOWER_INFECTION.compoundLobeMesh = null;
  }
}

function getSinTowerMeatballStartLevel(){
  const threshold = getSinTowerTumorParams().meatballLevel;
  // v30：肉球化不能在 threshold 那一瞬間跳出來；預設 20 次時，從第 10 次開始逐步把小腫瘤往球狀堆疊。
  return Math.max(10, Math.floor(threshold * .5));
}

function getSinTowerMeatballProgress(level){
  const threshold = getSinTowerTumorParams().meatballLevel;
  const start = getSinTowerMeatballStartLevel();
  return clamp(((level || 0) - start) / Math.max(1, threshold - start), 0, 1);
}

function getSinTowerMeatballRadius(level){
  const p = getSinTowerMeatballProgress(level || SIN_TOWER_INFECTION.level || 0);
  return THREE.MathUtils.lerp(.48, 1.48, p);
}

function getSinTowerMeatballCompression(level){
  const threshold = getSinTowerTumorParams().meatballLevel;
  return (level || 0) >= threshold ? .72 : THREE.MathUtils.lerp(.96, .80, getSinTowerMeatballProgress(level || 0));
}

function ensureSinTowerMeatballGroup(){
  // v32：停用任何「合併肉球 / 外部球團 group」。
  // 真實腫瘤只能掛在角色骨架或角色外觀根節點上，不能再另外生成一顆球去取代。
  if(SIN_TOWER_INFECTION.group){
    const dq = SIN_TOWER_INFECTION.disposeQueue || (SIN_TOWER_INFECTION.disposeQueue = []);
    SIN_TOWER_INFECTION.group.parent?.remove(SIN_TOWER_INFECTION.group);
    dq.push(SIN_TOWER_INFECTION.group);
    SIN_TOWER_INFECTION.group = null;
  }
  return null;
}

function computeSinTowerRollVisibleContactBox(root){
  const box = new THREE.Box3().makeEmpty();
  const tmp = new THREE.Box3();
  root?.updateMatrixWorld?.(true);
  root?.traverse?.(obj=>{
    if(!obj || obj.visible === false) return;
    if(obj.userData?.sinTowerActorBodyMesh) return;
    if(obj.name && String(obj.name).includes('固定隱形球體')) return;
    if(!(obj.isMesh || obj.isSkinnedMesh || obj.isSprite || obj.isPoints)) return;
    if(obj.geometry){
      if(!obj.geometry.boundingBox) obj.geometry.computeBoundingBox?.();
      if(obj.geometry.boundingBox){
        tmp.copy(obj.geometry.boundingBox).applyMatrix4(obj.matrixWorld);
        box.union(tmp);
        return;
      }
    }
    if(obj.isSprite){
      obj.getWorldPosition(tmp.min);
      const sx = Math.abs(obj.scale.x || 1), sy = Math.abs(obj.scale.y || 1);
      tmp.setFromCenterAndSize(tmp.min, new THREE.Vector3(sx, sy, .02));
      box.union(tmp);
    }
  });
  return box;
}

function resetSinTowerRollMeshBaseScales(root){
  root?.traverse?.(obj=>{
    if(obj?.userData?.sinTowerBaseRollScale){
      obj.scale.copy(obj.userData.sinTowerBaseRollScale);
      delete obj.userData.sinTowerBaseRollScale;
    }
    if(obj?.userData?.sinTowerBaseRollPosition){
      obj.position.copy(obj.userData.sinTowerBaseRollPosition);
      delete obj.userData.sinTowerBaseRollPosition;
    }
  });
}

function getSinTowerRollBridgeGeometry(){
  if(SIN_TOWER_INFECTION.rollBridgeGeometry) return SIN_TOWER_INFECTION.rollBridgeGeometry;
  const geo = new THREE.SphereGeometry(1,32,24);
  const pos = geo.attributes.position;
  const v = new THREE.Vector3();
  for(let i=0;i<pos.count;i++){
    v.fromBufferAttribute(pos,i);
    const n = v.clone().normalize();
    const wobble = 1 + Math.sin(n.x*9.1+n.y*5.7+n.z*7.3)*.075 + Math.cos(n.x*4.2-n.y*8.3+n.z*6.1)*.055;
    v.multiplyScalar(wobble);
    pos.setXYZ(i,v.x,v.y,v.z);
  }
  geo.computeVertexNormals();
  geo.computeBoundingSphere();
  SIN_TOWER_INFECTION.rollBridgeGeometry = geo;
  return geo;
}

// One immutable body plan per growth seed; no random work in the frame loop.
function getSinTowerGrowthMorphology(){
  const inf=SIN_TOWER_INFECTION,seed=inf.growthSeed||1;
  if(inf.morphology?.seed===seed)return inf.morphology;
  const count=sinTowerRand(seed+501)<.5?2:3;
  const q=new THREE.Quaternion().setFromEuler(new THREE.Euler(sinTowerRand(seed+502)*Math.PI*2,sinTowerRand(seed+503)*Math.PI*2,sinTowerRand(seed+504)*Math.PI*2));
  const lobes=[];
  for(let i=0;i<count;i++){
    const angle=i/count*Math.PI*2;
    const distance=.43+sinTowerRand(seed+510+i)*.12;
    const center=new THREE.Vector3(Math.cos(angle)*distance,Math.sin(angle)*distance,sinTowerSignedRand(seed+520+i)*.13).applyQuaternion(q);
    const radius=.59+sinTowerRand(seed+530+i)*.12;
    lobes.push({center,radius});
  }
  return inf.morphology={seed,lobes,extent:Math.max(...lobes.map(l=>l.center.length()+l.radius))};
}

function createSinTowerRollBridgeCore(radius){
  const group=new THREE.Group();
  group.name='斷罪塔｜隨機黏合多葉肉球';
  group.userData.isSinTowerTumor=true;
  group.userData.sinTowerRollBridge=true;
  const geo=getSinTowerRollBridgeGeometry(),plan=getSinTowerGrowthMorphology();
  // Keep the old eight-mesh budget; replace its dominant single sphere.
  for(let i=0;i<8;i++){
    const l=plan.lobes[i%plan.lobes.length],major=i<plan.lobes.length;
    const mesh=new THREE.Mesh(geo,getSinTowerTumorMaterial(plan.seed+i*31,false));
    mesh.name=major?'斷罪塔｜主要黏合肉球':'斷罪塔｜表面肉瘤葉';
    mesh.userData.isSinTowerTumor=true;mesh.userData.majorLobe=major;
    mesh.position.copy(l.center).multiplyScalar(radius);
    const size=radius*l.radius*(major?1:.33);
    if(!major){const a=i*2.399963;mesh.position.add(new THREE.Vector3(Math.cos(a),sinTowerSignedRand(plan.seed+i),Math.sin(a)).normalize().multiplyScalar(radius*l.radius*.85));}
    mesh.scale.setScalar(size);mesh.castShadow=false;mesh.receiveShadow=false;
    group.add(mesh);
  }
  return group;
}

function placeSinTowerMorphologyRoot(node){
  const root=SIN_TOWER_INFECTION.rollVisualRoot,content=root?.userData?.rollContent;
  if(!node?.parent||!content)return;
  let saved=node.userData.rollMorphology;
  if(!saved){
    const plan=getSinTowerGrowthMorphology(),index=(SIN_TOWER_INFECTION.ownedRoots||[]).indexOf(node);
    const n=Math.max(0,index),l=plan.lobes[n%plan.lobes.length];
    // Fibonacci distribution covers all axes, unlike indexing the first body zones.
    let dir=new THREE.Vector3(),point=new THREE.Vector3();
    for(let attempt=0;attempt<32;attempt++){
      const k=n+attempt*97;
      const y=1-2*((k*.61803398875+sinTowerRand(plan.seed+901))%1);
      const a=k*2.3999632297+sinTowerRand(plan.seed+902)*Math.PI*2;
      dir.set(Math.cos(a)*Math.sqrt(1-y*y),y,Math.sin(a)*Math.sqrt(1-y*y));
      point.copy(l.center).addScaledVector(dir,l.radius*.96);
      if(!plan.lobes.some(other=>other!==l&&point.distanceTo(other.center)<other.radius*.98))break;
    }
    const radius=(root.userData.rollColliderRadius||.6)*1.02/.86;
    saved=node.userData.rollMorphology={parent:node.parent,scaleFactor:averageWorldScale(node.parent)/Math.max(.00001,averageWorldScale(content)),position:node.position.clone(),quaternion:node.quaternion.clone(),base:node.userData.motion?.baseLocal.clone(),droop:node.userData.motion?.droopWorld||0,point:point.multiplyScalar(radius),dir};
    content.add(node);
    node.scale.multiplyScalar(saved.scaleFactor);
  }
  node.position.copy(saved.point);
  const normal=node.userData.surfaceNormal||new THREE.Vector3(0,1,0);
  node.quaternion.setFromUnitVectors(normal.clone().normalize(),saved.dir);
  const motion=node.userData.motion;
  if(motion){motion.targetScale.setScalar(saved.scaleFactor);motion.baseLocal.copy(saved.point);motion.baseRotation.copy(node.rotation);motion.droopWorld=0;motion.parent=content;}
}

function restoreSinTowerMorphologyRoot(node){
  const saved=node?.userData?.rollMorphology;if(!saved)return;
  saved.parent.add(node);node.scale.multiplyScalar(1/saved.scaleFactor);node.position.copy(saved.position);node.quaternion.copy(saved.quaternion);
  const motion=node.userData.motion;
  if(motion){motion.targetScale.setScalar(1);motion.baseLocal.copy(saved.base||saved.position);motion.baseRotation.copy(node.rotation);motion.droopWorld=saved.droop;motion.parent=saved.parent;}
  delete node.userData.rollMorphology;
}


function ensureSinTowerRollVisualRoot(active){
  if(!playerGroup) return null;
  let root = SIN_TOWER_INFECTION.rollVisualRoot || null;
  if(active){
    if(root && root.parent === playerGroup && root.userData.rollSpinRoot && root.userData.rollContent) return root;
    if(root?.parent) root.parent.remove(root);

    const threshold = Math.max(1, Math.floor(getSinTowerTumorParams().meatballLevel || 20));
    const fixedScale = SIN_TOWER_INFECTION.rollFixedScale || getSinTowerLockedRollScale(threshold);
    SIN_TOWER_INFECTION.rollFixedScale = fixedScale;

    root = new THREE.Group();
    root.name = '斷罪塔｜固定隱形球貼地根_v81';
    root.userData.sinTowerNoUnsafeCleanup = true;
    const spinRoot = new THREE.Group();
    spinRoot.name = '斷罪塔｜固定中心滾動表面層';
    spinRoot.userData.sinTowerNoUnsafeCleanup = true;
    const content = new THREE.Group();
    content.name = '斷罪塔｜肉球內容_固定高度';
    content.userData.sinTowerNoUnsafeCleanup = true;
    root.add(spinRoot);
    spinRoot.add(content);

    const children = [...playerGroup.children];
    for(const child of children){
      if(child === root) continue;
      playerGroup.remove(child);
      content.add(child);
    }
    playerGroup.add(root);
    playerGroup.scale.setScalar(fixedScale);
    playerGroup.updateMatrixWorld(true);
    content.updateMatrixWorld(true);

    const box = computeSinTowerRollVisibleContactBox(content);
    let centerLocal = new THREE.Vector3(0, .72 / fixedScale, 0);
    // The attachment bounds include long tentacle tips.  Using that box as the
    // ball radius made the connector several metres wide and pushed the camera
    // into it.  Grounding and rolling now use the authored meatball radius;
    // the bounds are used only to find the visual centre.
    const radius = clamp(getSinTowerMeatballRadius(threshold) / fixedScale, .42, .82);
    const groundRadius = radius;
    const rotationRadius = radius;
    if(!box.isEmpty()){
      const centerWorld = new THREE.Vector3();
      box.getCenter(centerWorld);
      centerLocal = playerGroup.worldToLocal(centerWorld.clone());
    }

    content.position.set(-centerLocal.x, -centerLocal.y, -centerLocal.z);
    root.position.set(0, radius, 0);
    root.rotation.set(0,0,0);
    root.scale.set(1,1,1);
    spinRoot.rotation.set(0,0,0);
    content.rotation.set(0,0,0);
    // Pull the existing tumors and tentacle roots inward once, when roll mode
    // begins.  This is a static transform, so it adds no per-frame attachment
    // work and keeps the infection collision path smooth.
    content.scale.setScalar(.64);

    root.userData.rollContent = content;
    root.userData.rollSpinRoot = spinRoot;
    root.userData.rollColliderRadius = radius;
    root.userData.rollGroundRadius = groundRadius;
    root.userData.rollRotationRadius = rotationRadius;
    root.userData.baseRootY = root.position.y;
    root.userData.baseContentPosition = content.position.clone();
    const bridgeRadius = radius * 1.02;
    const bridgeCore = createSinTowerRollBridgeCore(bridgeRadius);
    spinRoot.add(bridgeCore);
    root.userData.rollBridgeCore = bridgeCore;
    root.userData.rollGroundRadius = Math.max(root.userData.rollGroundRadius, bridgeRadius*.90);
    root.userData.rollRotationRadius = Math.max(root.userData.rollRotationRadius, bridgeRadius);

    root.position.y = (root.userData.rollGroundRadius || radius);
    root.userData.baseRootY = root.position.y;

    const collider = new THREE.Mesh(
      new THREE.SphereGeometry(radius, 16, 12),
      new THREE.MeshBasicMaterial({color:0x00ffff, transparent:true, opacity:0, depthWrite:false})
    );
    collider.name = '斷罪塔｜固定隱形球體依據';
    collider.visible = false;
    root.add(collider);
    root.userData.rollCollider = collider;

    SIN_TOWER_INFECTION.rollVisualRoot = root;
    content.position.set(0,0,0);
    content.scale.setScalar(.86);
    root.userData.baseContentPosition = content.position.clone();
    for(const node of SIN_TOWER_INFECTION.ownedRoots || []) placeSinTowerMorphologyRoot(node);
    const extent=getSinTowerGrowthMorphology().extent*bridgeRadius;
    root.userData.rollGroundRadius=Math.max(radius,extent);
    root.userData.rollRotationRadius=root.userData.rollGroundRadius;
    root.position.y=root.userData.rollGroundRadius;
    return root;
  }
  if(root){
    for(const node of SIN_TOWER_INFECTION.ownedRoots || []) restoreSinTowerMorphologyRoot(node);
    const content = root.userData.rollContent || root;
    const spinRoot = root.userData.rollSpinRoot || null;
    root.rotation.set(0,0,0);
    root.scale.set(1,1,1);
    spinRoot?.rotation?.set(0,0,0);
    content.rotation.set(0,0,0);
    content.scale.set(1,1,1);
    const basePos = root.userData.baseContentPosition;
    if(basePos) content.position.copy(basePos);
    const children = [...content.children];
    for(const child of children) playerGroup.attach(child);
    root.parent?.remove(root);
    SIN_TOWER_INFECTION.rollVisualRoot = null;
  }
  return null;
}

function markSinTowerActorBodyMeshes(root){
  root?.traverse?.(obj=>{
    if(obj?.isMesh || obj?.isSkinnedMesh){
      if(!obj.userData.isSinTowerTumor && !String(obj.name || '').includes('斷罪塔')){
        obj.userData.sinTowerActorBodyMesh = true;
        if(obj.userData.sinTowerActorBodyDefaultVisible === undefined) obj.userData.sinTowerActorBodyDefaultVisible = obj.visible !== false;
      }
    }
  });
}

function setSinTowerActorBodyVisible(visible){
  actorModel?.traverse(obj=>{
    if(obj?.userData?.sinTowerActorBodyMesh){
      obj.visible = visible ? obj.userData.sinTowerActorBodyDefaultVisible !== false : false;
    }
  });
  if(actorProxy) actorProxy.visible = visible && !actorModel;
}

function updateSinTowerMeatballTransform(moveSpeed=0, dt=.016, force=false){
  if(!playerGroup) return;
  const level = Math.max(0, Math.floor(SIN_TOWER_INFECTION.level || 0));
  const threshold = Math.max(1, Math.floor(getSinTowerTumorParams().meatballLevel || 20));
  const isBall = level >= threshold;
  if(isBall){
    setSinTowerActorBodyVisible(false);
    const fixedScale = SIN_TOWER_INFECTION.rollFixedScale || getSinTowerLockedRollScale(threshold);
    SIN_TOWER_INFECTION.rollFixedScale = fixedScale;
    playerGroup.scale.setScalar(fixedScale);
    playerGroup.rotation.set(0, playerYaw, 0);

    const rollRoot = ensureSinTowerRollVisualRoot(true);
    const groundRadius = Math.max(.22, safeFinite(rollRoot?.userData?.rollGroundRadius, rollRoot?.userData?.rollColliderRadius || getSinTowerMeatballRadius(threshold) / fixedScale));
    const rotationRadius = Math.max(.22, safeFinite(rollRoot?.userData?.rollRotationRadius, groundRadius));
    const delta = (moveSpeed / Math.max(.22, rotationRadius * fixedScale)) * dt;
    SIN_TOWER_INFECTION.rollAngle += delta * (SIN_TOWER_STAIRCASE?.directionZ || 1);

    if(rollRoot){
      const content = rollRoot.userData.rollContent || rollRoot;
      const spinRoot = rollRoot.userData.rollSpinRoot || content;
      rollRoot.position.set(0, groundRadius, 0);
      rollRoot.rotation.set(0,0,0);
      rollRoot.scale.set(1,1,1);
      const basePos = rollRoot.userData.baseContentPosition;
      if(basePos) content.position.copy(basePos);
      content.rotation.set(0,0,0);
      content.scale.setScalar(.86);
      spinRoot.rotation.x = SIN_TOWER_INFECTION.rollAngle;
      spinRoot.rotation.y = 0;
      spinRoot.rotation.z = 0;
      playerGroup.userData.sinTowerRollSquash = 1;
    }
  }else{
    ensureSinTowerRollVisualRoot(false);
    setSinTowerActorBodyVisible(true);
    SIN_TOWER_INFECTION.rollFixedScale = null;
    if(force){
      playerGroup.rotation.set(0, playerYaw, 0);
      playerGroup.userData.sinTowerRollSquash = 1;
    }
  }
}

function resetSinTowerInfectionCachesForRebuild(){
  // v51：卡頓主因之一是每次吸收都把腫瘤幾何快取整批清掉，導致下一次重建又重新計算大量幾何。
  // 這裡保留 geometryCache / wrinkle / eye / fungus 幾何快取，只清空本輪排程與表面錨點。
  SIN_TOWER_INFECTION.detailQueue = [];
  SIN_TOWER_INFECTION.surfaceAnchors = [];
}

function sinTowerGeometryCacheContains(mapLike, geo){
  if(!mapLike || !geo || !mapLike.values) return false;
  for(const v of mapLike.values()) if(v === geo) return true;
  return false;
}

function isSharedSinTowerGeometry(geo){
  if(!geo) return false;
  const inf = SIN_TOWER_INFECTION || {};
  if(sinTowerGeometryCacheContains(inf.geometryCache, geo)) return true;
  if(sinTowerGeometryCacheContains(inf.wrinkleGeometryCache, geo)) return true;
  if(sinTowerGeometryCacheContains(inf.fungusGeometryCache, geo)) return true;
  if(geo === inf.pupilOverlayGeometry) return true;
  if(geo === inf.compoundLobeGeometry) return true;
  return false;
}

function disposeSinTowerInfectionTreeLight(root){
  // v52：感染重建最卡的地方之一，是每次都深度 dispose 整棵樹，連共享快取幾何也反覆處理。
  // 這裡改成只釋放「每次生成的動態幾何」，共享快取幾何與共享材質保留。
  if(!root) return;
  root.traverse(obj=>{
    const geo = obj.geometry;
    if(geo && !isSharedSinTowerGeometry(geo)) geo.dispose?.();
  });
}

function disposeSinTowerTumorBatches(clearEntries=false){
  const inf = SIN_TOWER_INFECTION;
  for(const entry of inf.tumorBatchEntries || []){
    if(entry?.core) entry.core.visible = true;
    if(entry){ entry.batch = null; entry.slot = -1; }
  }
  for(const batch of inf.tumorBatches?.values?.() || []) batch.parent?.remove(batch);
  inf.tumorBatches?.clear?.();
  if(clearEntries) inf.tumorBatchEntries = [];
  inf.tumorBatchDirty = false;
}

function registerSinTowerTumorCore(core){
  if(!core?.geometry || !core.material) return;
  const inf = SIN_TOWER_INFECTION;
  core.castShadow = false;
  core.receiveShadow = false;
  core.userData.sinTowerTumorCore = true;
  const entry = {core, batch:null, slot:-1};
  inf.tumorBatchEntries.push(entry);
  if(!scene) { inf.tumorBatchDirty = true; return; }
  const key = `${core.geometry.uuid}|${core.material.uuid}`;
  let batch = inf.tumorBatches.get(key);
  if(!batch){
    const pending = inf.tumorBatchEntries.filter(item=>item?.core?.parent && !item.batch && item.core.geometry?.uuid === core.geometry.uuid && item.core.material?.uuid === core.material.uuid);
    // A one-off geometry is cheaper as its original Mesh; batch only pays off
    // once at least two cores share the exact same GPU resources.
    if(pending.length < 2) return;
    batch = new THREE.InstancedMesh(core.geometry, core.material, 128);
    batch.count = 0;
    batch.name = '斷罪塔｜批次腫瘤核心';
    batch.userData.isSinTowerTumor = true;
    batch.castShadow = false;
    batch.receiveShadow = false;
    batch.frustumCulled = false;
    batch.matrixAutoUpdate = false;
    batch.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    scene.add(batch);
    inf.tumorBatches.set(key, batch);
    for(const item of pending){
      item.batch = batch;
      item.slot = batch.count++;
      item.core.visible = false;
      batch.setMatrixAt(item.slot, item.core.matrixWorld);
    }
    batch.instanceMatrix.needsUpdate = true;
    return;
  }
  if(batch.count >= batch.instanceMatrix.count){
    inf.tumorBatchDirty = true;
    return;
  }
  entry.batch = batch;
  entry.slot = batch.count++;
  core.visible = false;
  batch.setMatrixAt(entry.slot, core.matrixWorld);
  batch.instanceMatrix.needsUpdate = true;
}

function rebuildSinTowerTumorBatches(){
  const inf = SIN_TOWER_INFECTION;
  if(!scene || !inf.tumorBatchEntries?.length) return;
  playerGroup?.updateMatrixWorld?.(true);
  const entries = inf.tumorBatchEntries.filter(entry=>entry?.core?.parent);
  disposeSinTowerTumorBatches(false);
  inf.tumorBatchEntries = entries;
  const groups = new Map();
  for(const entry of entries){
    const key = `${entry.core.geometry?.uuid || 'geo'}|${entry.core.material?.uuid || 'mat'}`;
    const list = groups.get(key) || [];
    list.push(entry);
    groups.set(key, list);
  }
  for(const list of groups.values()){
    const first = list[0]?.core;
    if(list.length < 2 || !first?.geometry || !first.material) continue;
    const batch = new THREE.InstancedMesh(first.geometry, first.material, Math.max(128, list.length));
    batch.count = list.length;
    batch.name = '斷罪塔｜批次腫瘤核心';
    batch.userData.isSinTowerTumor = true;
    batch.castShadow = false;
    batch.receiveShadow = false;
    batch.frustumCulled = false;
    batch.matrixAutoUpdate = false;
    batch.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    scene.add(batch);
    inf.tumorBatches.set(`${first.geometry.uuid}|${first.material.uuid}`, batch);
    for(let i=0;i<list.length;i++){
      const entry = list[i];
      entry.batch = batch;
      entry.slot = i;
      entry.core.visible = false;
      batch.setMatrixAt(i, entry.core.matrixWorld);
    }
    batch.instanceMatrix.needsUpdate = true;
  }
  inf.tumorBatchDirty = false;
}

function updateSinTowerTumorBatches(){
  const inf = SIN_TOWER_INFECTION;
  if(!inf.tumorBatches?.size) return;
  // scene.updateMatrixWorld 會在 render 前處理父骨架；這裡不再額外遞迴整棵角色樹。
  // 批次矩陣隔幀同步一次，肉眼無法察覺一幀的差異，但可避免感染量大時重複走訪所有細節節點。
  inf.tumorBatchFrame = (inf.tumorBatchFrame || 0) + 1;
  if((inf.tumorBatchFrame & 1) === 0) return;
  // Sync the player tree once for the whole batch update, instead of once per
  // animated attachment. The renderer will reuse these matrices for the draw.
  playerGroup?.updateMatrixWorld?.(true);
  const changedBatches=inf.changedTumorBatches||(inf.changedTumorBatches=new Set());changedBatches.clear();
  for(const entry of inf.tumorBatchEntries || []){
    if(!entry?.core?.parent||!entry.batch)continue;
    entry.batch.setMatrixAt(entry.slot,entry.core.matrixWorld);changedBatches.add(entry.batch);
  }
  for(const batch of changedBatches)batch.instanceMatrix.needsUpdate=true;
}

function requestSinTowerSceneShadowRefresh(){
  const shadowMap = renderer?.shadowMap;
  if(!shadowMap) return;
  if(bakedLightingRuntime?.active) disableBakedLightingRuntime();
  if(SIN_TOWER_INFECTION.shadowFreeze) setSinTowerInfectionShadowFreeze(false);
  sinTowerSceneShadowRefreshFrames = 2;
  shadowMap.enabled = true;
  shadowMap.autoUpdate = true;
  shadowMap.needsUpdate = true;
  scene?.traverse?.(obj=>{ if(obj?.isLight && obj.shadow) obj.shadow.needsUpdate = true; });
}

function finishSinTowerSceneShadowRefreshFrame(){
  if(sinTowerSceneShadowRefreshFrames <= 0) return;
  sinTowerSceneShadowRefreshFrames--;
  if(sinTowerSceneShadowRefreshFrames > 0) return;
  applyPlayModePerformanceLighting(isPlayMode());
  setSinTowerInfectionShadowFreeze((SIN_TOWER_INFECTION.level || 0) > 0 && isSinTowerStairSceneActive());
}

function setSinTowerInfectionShadowFreeze(active){
  const inf = SIN_TOWER_INFECTION;
  const shadowMap = renderer?.shadowMap;
  if(!shadowMap) return;
  if(active){
    if(sinTowerSceneShadowRefreshFrames > 0){
      shadowMap.autoUpdate = true;
      shadowMap.needsUpdate = true;
      return;
    }
    if(!inf.shadowFreeze){
      inf.shadowAutoUpdateBefore = shadowMap.autoUpdate !== false;
      inf.shadowNeedsUpdateBefore = !!shadowMap.needsUpdate;
      inf.shadowFreeze = true;
    }
    // 保留上一個完整陰影貼圖，只停止感染期間每幀的 shadow pass。
    shadowMap.autoUpdate = false;
    shadowMap.needsUpdate = false;
    return;
  }
  if(!inf.shadowFreeze) return;
  shadowMap.autoUpdate = inf.shadowAutoUpdateBefore;
  shadowMap.needsUpdate = inf.shadowNeedsUpdateBefore;
  inf.shadowFreeze = false;
}

function trackSinTowerInfectionRoot(node){
  if(!node) return node;
  const st=SIN_TOWER_INFECTION.rebuildState;
  let layer=SIN_TOWER_INFECTION.level;
  if(st){
    const second=Math.max(1,Math.round(st.params.secondarySkeletonLevel||5)),third=Math.max(second+1,Math.round(st.params.thirdSkeletonLevel||10));
    const phase=st.phase==='third'?'third':st.phase==='secondary'?'secondary':'primary';
    const low=phase==='third'?third:phase==='secondary'?second:1;
    const high=Math.max(low,Math.min(st.level,phase==='primary'&&st.secondaryTotal>0?second-1:phase==='secondary'&&st.thirdTotal>0?third-1:st.level));
    layer=Math.min(st.level,low+Math.floor(Math.max(0,st[phase+'Index']-1)/Math.max(1,st[phase+'Total'])*(high-low+1)));
  }
  node.userData.infectionLayer=layer;
  const roots = SIN_TOWER_INFECTION.ownedRoots || (SIN_TOWER_INFECTION.ownedRoots = []);
  if(!roots.includes(node)) roots.push(node);
  return node;
}

function clearSinTowerInfectionAttachments(){
  const dq = SIN_TOWER_INFECTION.disposeQueue || (SIN_TOWER_INFECTION.disposeQueue = []);
  disposeSinTowerTumorBatches(true);
  const ownedRoots = Array.from(new Set(SIN_TOWER_INFECTION.ownedRoots || [])).filter(Boolean);
  const ownedSet = new Set(ownedRoots);
  for(const rec of SIN_TOWER_INFECTION.attachments || []){
    const n = rec?.node;
    let cursor = n;
    let covered = false;
    while(cursor){ if(ownedSet.has(cursor)){ covered = true; break; } cursor = cursor.parent; }
    if(!covered && n){ n.parent?.remove(n); dq.push(n); }
  }
  for(const root of ownedRoots){ root.parent?.remove(root); dq.push(root); }
  SIN_TOWER_INFECTION.attachments = [];
  SIN_TOWER_INFECTION.dynamicAttachments = [];
  SIN_TOWER_INFECTION.ownedRoots = [];
  SIN_TOWER_INFECTION.colorLayerRevision=safeFinite(SIN_TOWER_INFECTION.colorLayerRevision,0)+1;
  SIN_TOWER_INFECTION.eyes = [];
  SIN_TOWER_INFECTION.surfaceAnchors = [];
  SIN_TOWER_INFECTION.detailQueue = [];
  SIN_TOWER_INFECTION.rebuildState = null;
  if(SIN_TOWER_INFECTION.compoundLobeMesh){
    SIN_TOWER_INFECTION.compoundLobeMesh.parent?.remove(SIN_TOWER_INFECTION.compoundLobeMesh);
    SIN_TOWER_INFECTION.compoundLobeMesh.dispose?.();
  }
  SIN_TOWER_INFECTION.compoundLobeMesh = null;
  // v67：肉球模式後續吸收時不能拆掉滾動根節點。
  // 以前每撞一次僧侶就拆掉再重算中心，會把目前已旋轉／已偏移的內容再次當成新中心，累積成「後期突然飛到半空、繞巨大圓心轉」。
  if(!isSinTowerMeatballMode()){
    SIN_TOWER_INFECTION.rollAngle = 0;
    SIN_TOWER_INFECTION.rollFixedScale = null;
    ensureSinTowerRollVisualRoot(false);
  }
  if(SIN_TOWER_INFECTION.group){
    SIN_TOWER_INFECTION.group.parent?.remove(SIN_TOWER_INFECTION.group);
    dq.push(SIN_TOWER_INFECTION.group);
    SIN_TOWER_INFECTION.group = null;
  }
}

function getSinTowerActorBones(){
  if(!actorModel) return [];
  if(SIN_TOWER_INFECTION.boneCache?.model === actorModel) return SIN_TOWER_INFECTION.boneCache.bones;
  const bones=[];
  actorModel.traverse(o=>{ if(o.isBone) bones.push(o); });
  SIN_TOWER_INFECTION.boneCache = {model:actorModel,bones};
  return bones;
}

function findSinTowerActorBone(tokenSets){
  const bones = getSinTowerActorBones();
  for(const tokens of tokenSets){
    const found = bones.find(b=>{
      const n = String(b.name || '').toLowerCase();
      return tokens.every(tok=>n.includes(tok));
    });
    if(found) return found;
  }
  return null;
}

function getSinTowerCentralSpineBone(){
  return findSinTowerActorBone([
    ['spine2'], ['spine1'], ['chest'], ['spine'], ['hips'], ['pelvis']
  ]);
}

function getSinTowerSkeletonCoverageBones(){
  return {
    hips: findSinTowerActorBone([['hips'],['pelvis'],['hip']]) || getSinTowerCentralSpineBone() || playerGroup,
    spineLower: findSinTowerActorBone([['spine'],['spine0'],['pelvis']]) || getSinTowerCentralSpineBone() || playerGroup,
    spineMid: findSinTowerActorBone([['spine1'],['spine','1'],['spine']]) || getSinTowerCentralSpineBone() || playerGroup,
    chest: findSinTowerActorBone([['spine2'],['spine','2'],['chest'],['upperchest']]) || getSinTowerCentralSpineBone() || playerGroup,
    neck: findSinTowerActorBone([['neck']]) || findSinTowerActorBone([['head']]) || getSinTowerCentralSpineBone() || playerGroup,
    head: findSinTowerActorBone([['head']]) || findSinTowerActorBone([['neck']]) || getSinTowerCentralSpineBone() || playerGroup,
    leftUpperArm: findSinTowerActorBone([['left','upperarm'],['leftarm'],['arm_l'],['l_','arm'],['left','arm']]) || playerGroup,
    rightUpperArm: findSinTowerActorBone([['right','upperarm'],['rightarm'],['arm_r'],['r_','arm'],['right','arm']]) || playerGroup,
    leftForeArm: findSinTowerActorBone([['left','forearm'],['left','lowerarm'],['leftforearm'],['left','elbow']]) || findSinTowerActorBone([['left','arm']]) || playerGroup,
    rightForeArm: findSinTowerActorBone([['right','forearm'],['right','lowerarm'],['rightforearm'],['right','elbow']]) || findSinTowerActorBone([['right','arm']]) || playerGroup,
    leftHand: findSinTowerActorBone([['left','hand'],['lefthand'],['hand_l'],['left','wrist']]) || findSinTowerActorBone([['left','forearm']]) || playerGroup,
    rightHand: findSinTowerActorBone([['right','hand'],['righthand'],['hand_r'],['right','wrist']]) || findSinTowerActorBone([['right','forearm']]) || playerGroup,
    leftThigh: findSinTowerActorBone([['left','upleg'],['left','thigh'],['leftupleg'],['left','leg']]) || playerGroup,
    rightThigh: findSinTowerActorBone([['right','upleg'],['right','thigh'],['rightupleg'],['right','leg']]) || playerGroup,
    leftCalf: findSinTowerActorBone([['left','leg'],['left','lowerleg'],['leftcalf'],['left','knee']]) || findSinTowerActorBone([['left','upleg']]) || playerGroup,
    rightCalf: findSinTowerActorBone([['right','leg'],['right','lowerleg'],['rightcalf'],['right','knee']]) || findSinTowerActorBone([['right','upleg']]) || playerGroup,
    leftFoot: findSinTowerActorBone([['left','foot'],['leftfoot'],['foot_l'],['left','ankle']]) || findSinTowerActorBone([['left','toe']]) || playerGroup,
    rightFoot: findSinTowerActorBone([['right','foot'],['rightfoot'],['foot_r'],['right','ankle']]) || findSinTowerActorBone([['right','toe']]) || playerGroup,
  };
}

function getSinTowerBoneSurfaceFrame(bone){
  const axis = new THREE.Vector3(0,1,0);
  let length = .20;
  if(bone?.isBone){
    const childBones = bone.children.filter(c=>c.isBone);
    if(childBones.length){
      const avg = new THREE.Vector3();
      for(const c of childBones) avg.add(c.position);
      avg.multiplyScalar(1/childBones.length);
      length = clamp(avg.length(), .10, .55);
      if(length > .0001) axis.copy(avg).normalize();
    }else if(bone.parent?.isBone){
      length = clamp(bone.position.length(), .10, .55);
      if(length > .0001) axis.copy(bone.position).normalize();
    }
  }
  const ref = Math.abs(axis.y) > .88 ? new THREE.Vector3(0,0,1) : new THREE.Vector3(0,1,0);
  const side = new THREE.Vector3().crossVectors(ref, axis).normalize();
  if(side.lengthSq() < .0001) side.set(1,0,0);
  const front = new THREE.Vector3().crossVectors(axis, side).normalize();
  return {axis, side, front, length};
}

function getSinTowerBoneFaceNormal(frame, face){
  switch(face){
    case 'front': return frame.front.clone();
    case 'back': return frame.front.clone().multiplyScalar(-1);
    case 'left': return frame.side.clone();
    case 'right': return frame.side.clone().multiplyScalar(-1);
    case 'top': return frame.axis.clone();
    case 'bottom': return frame.axis.clone().multiplyScalar(-1);
    default: return frame.front.clone();
  }
}

function averageWorldScale(obj){
  const s = new THREE.Vector3(1,1,1);
  obj?.getWorldScale?.(s);
  return Math.max(.0001, (Math.abs(s.x)+Math.abs(s.y)+Math.abs(s.z))/3);
}

function getSinTowerStableAttachmentUnit(source, fallbackHost=null){
  // v77：第二／第三層骨架必須沿用上一層建立時的 unit。
  // 不能用正在成長的 parentPivot.scale=.001 反推，也不能把骨架 unit 壓到 8，否則第二／第三層會變得幾乎看不見。
  let unit = safeFinite(source?.unit, NaN);
  if(!Number.isFinite(unit) || unit <= 0){
    const host = source?.host || fallbackHost || playerGroup || actorProxy;
    unit = 1 / averageWorldScale(host);
  }
  // 160 是為了容許 Mixamo/FBX 骨架常見的 0.01 世界縮放；仍阻止 1000 倍失控值。
  return clamp(unit, .04, 160.0);
}

function clampSinTowerShellLayer(v){
  // v75：shellLayer 只代表外層厚度，不能隨 serial 無限制增加。
  return Math.round(clamp(safeFinite(v,0), 0, 7));
}

function worldDownLocalOffset(parent, baseLocal, amount){
  if(!parent || amount === 0) return new THREE.Vector3();
  parent.updateMatrixWorld(true);
  const a = parent.localToWorld(baseLocal.clone());
  const b = a.clone().add(new THREE.Vector3(0, -amount, 0));
  const bLocal = parent.worldToLocal(b);
  return bLocal.sub(baseLocal);
}

function getSinTowerSpineZones(progress){
  // v27：增生順序改成 S 形。前段集中在角色左背，沿著左側向下堆疊，之後轉到中央，再往右背與右手側堆疊，最後才收成球狀包覆。
  return [
    {threshold:0.00, weight:1, name:'s_left_upper_back', local:new THREE.Vector3(-.20,.27,-.13), spread:new THREE.Vector3(.035,.035,.030), normal:new THREE.Vector3(-.58,.13,-.80)},
    {threshold:0.10, weight:1, name:'s_left_shoulder_mass', local:new THREE.Vector3(-.24,.15,-.17), spread:new THREE.Vector3(.040,.040,.032), normal:new THREE.Vector3(-.64,.04,-.77)},
    {threshold:0.20, weight:1, name:'s_left_middle_back', local:new THREE.Vector3(-.18,.02,-.20), spread:new THREE.Vector3(.048,.050,.035), normal:new THREE.Vector3(-.45,-.02,-.89)},
    {threshold:0.31, weight:1, name:'s_left_lower_curve', local:new THREE.Vector3(-.09,-.14,-.19), spread:new THREE.Vector3(.055,.050,.035), normal:new THREE.Vector3(-.22,-.12,-.96)},
    {threshold:0.43, weight:1, name:'s_center_turn', local:new THREE.Vector3(.02,-.22,-.18), spread:new THREE.Vector3(.060,.052,.035), normal:new THREE.Vector3(.04,-.15,-.98)},
    {threshold:0.55, weight:1, name:'s_right_lower_curve', local:new THREE.Vector3(.13,-.10,-.18), spread:new THREE.Vector3(.060,.052,.035), normal:new THREE.Vector3(.32,-.10,-.94)},
    {threshold:0.67, weight:1, name:'s_right_middle_back', local:new THREE.Vector3(.21,.04,-.18), spread:new THREE.Vector3(.055,.050,.035), normal:new THREE.Vector3(.55,-.02,-.83)},
    {threshold:0.79, weight:1, name:'s_right_shoulder_hand_side', local:new THREE.Vector3(.26,.17,-.14), spread:new THREE.Vector3(.050,.046,.032), normal:new THREE.Vector3(.70,.06,-.71)},
    {threshold:0.90, weight:1, name:'s_right_upper_closing_mass', local:new THREE.Vector3(.18,.30,-.11), spread:new THREE.Vector3(.050,.048,.032), normal:new THREE.Vector3(.42,.23,-.88)},
    {threshold:0.97, weight:1, name:'s_center_ball_closure', local:new THREE.Vector3(.04,.10,-.24), spread:new THREE.Vector3(.075,.075,.050), normal:new THREE.Vector3(.08,.02,-.99)}
  ];
}

function pickSinTowerSpineZone(seed, progress){
  const zones = getSinTowerSpineZones(progress);
  const p = clamp(progress,0,1);
  const raw = p * (zones.length - 1);
  let idx = Math.round(raw + sinTowerSignedRand(seed+71) * .72);
  idx = clamp(idx, 0, zones.length - 1);
  // 同一階段內仍有小幅游移，但不再從全身隨機挑點，避免破壞 S 形堆疊。
  if(sinTowerRand(seed+72) > .78) idx = clamp(idx + (sinTowerRand(seed+73) > .5 ? 1 : -1), 0, zones.length - 1);
  return zones[idx];
}

function makeSinTowerSpineAttachment(zone, seed){
  const host = getSinTowerCentralSpineBone() || actorProxy || playerGroup;
  const unit = clamp(1 / averageWorldScale(host), .04, 160.0);
  const local = zone.local.clone().multiplyScalar(unit).add(new THREE.Vector3(
    sinTowerSignedRand(seed+1) * zone.spread.x * unit,
    sinTowerSignedRand(seed+2) * zone.spread.y * unit,
    sinTowerSignedRand(seed+3) * zone.spread.z * unit
  ));
  const normal = zone.normal.clone().add(new THREE.Vector3(
    sinTowerSignedRand(seed+4)*.14,
    sinTowerSignedRand(seed+5)*.10,
    sinTowerSignedRand(seed+6)*.14
  )).normalize();
  const pivot = new THREE.Group();
  pivot.name = `斷罪塔｜中央脊椎綁定增生 ${zone.name}`;
  pivot.position.copy(local);
  host.add(pivot);
  trackSinTowerInfectionRoot(pivot);
  return {pivot, host, unit, baseLocal:local.clone(), normal, zone};
}

function makeSinTowerBodyCoverAttachment(level, index, count, coverP, seed){
  // v41：包覆期不用單一路線。每一層直接按身體部位分配：頭、胸前、腹前、雙手、雙腳、背與側面。
  // 這樣到指定層數時，不會只蓋背；主角頭、前半身、手腳都會被小腫瘤覆蓋。
  const host = playerGroup || getSinTowerCentralSpineBone() || actorProxy;
  const unit = clamp(1 / averageWorldScale(host), .04, 160.0);
  const yOff = clamp(safeFinite(STATE?.player?.modelYOffset, 0.68), -1.2, 20.0);
  const c = clamp(coverP || 0, 0, 1);

  const backZones = [
    {name:'左上背', p:new THREE.Vector3(-.24,yOff+1.14,-.16), n:new THREE.Vector3(-.60,.20,-.78)},
    {name:'中背', p:new THREE.Vector3( .00,yOff+.92,-.20), n:new THREE.Vector3(.00,.02,-1)},
    {name:'右上背', p:new THREE.Vector3( .24,yOff+1.12,-.16), n:new THREE.Vector3(.60,.20,-.78)},
    {name:'左下背', p:new THREE.Vector3(-.18,yOff+.54,-.14), n:new THREE.Vector3(-.42,-.08,-.90)},
    {name:'右下背', p:new THREE.Vector3( .18,yOff+.54,-.14), n:new THREE.Vector3(.42,-.08,-.90)}
  ];
  const headZones = [
    {name:'後腦', p:new THREE.Vector3(0,yOff+1.52,-.10), n:new THREE.Vector3(0,.58,-.82)},
    {name:'頭頂', p:new THREE.Vector3(0,yOff+1.64, .00), n:new THREE.Vector3(0,1,0)},
    {name:'臉前', p:new THREE.Vector3(0,yOff+1.42, .16), n:new THREE.Vector3(0,.25,.97)},
    {name:'左臉側', p:new THREE.Vector3(-.16,yOff+1.42,.06), n:new THREE.Vector3(-.72,.20,.66)},
    {name:'右臉側', p:new THREE.Vector3( .16,yOff+1.42,.06), n:new THREE.Vector3(.72,.20,.66)}
  ];
  const frontZones = [
    {name:'胸前', p:new THREE.Vector3(0,yOff+1.06,.22), n:new THREE.Vector3(0,.12,.99)},
    {name:'左胸', p:new THREE.Vector3(-.18,yOff+1.02,.18), n:new THREE.Vector3(-.46,.08,.89)},
    {name:'右胸', p:new THREE.Vector3( .18,yOff+1.02,.18), n:new THREE.Vector3(.46,.08,.89)},
    {name:'腹前', p:new THREE.Vector3(0,yOff+.58,.24), n:new THREE.Vector3(0,-.06,.99)},
    {name:'左腹', p:new THREE.Vector3(-.14,yOff+.55,.20), n:new THREE.Vector3(-.36,-.08,.93)},
    {name:'右腹', p:new THREE.Vector3( .14,yOff+.55,.20), n:new THREE.Vector3(.36,-.08,.93)}
  ];
  const armZones = [
    {name:'左肩臂', p:new THREE.Vector3(-.46,yOff+1.05,.02), n:new THREE.Vector3(-.98,.08,.16)},
    {name:'左前臂', p:new THREE.Vector3(-.56,yOff+.72,.06), n:new THREE.Vector3(-.96,-.10,.26)},
    {name:'右肩臂', p:new THREE.Vector3( .46,yOff+1.05,.02), n:new THREE.Vector3(.98,.08,.16)},
    {name:'右前臂', p:new THREE.Vector3( .56,yOff+.72,.06), n:new THREE.Vector3(.96,-.10,.26)}
  ];
  const legZones = [
    {name:'左大腿', p:new THREE.Vector3(-.18,yOff+.28,.08), n:new THREE.Vector3(-.38,-.18,.91)},
    {name:'右大腿', p:new THREE.Vector3( .18,yOff+.28,.08), n:new THREE.Vector3(.38,-.18,.91)},
    {name:'左小腿', p:new THREE.Vector3(-.16,yOff+.02,.04), n:new THREE.Vector3(-.34,-.28,.90)},
    {name:'右小腿', p:new THREE.Vector3( .16,yOff+.02,.04), n:new THREE.Vector3(.34,-.28,.90)}
  ];
  const sideZones = [
    {name:'左側腰', p:new THREE.Vector3(-.34,yOff+.72,.02), n:new THREE.Vector3(-.99,0,.10)},
    {name:'右側腰', p:new THREE.Vector3( .34,yOff+.72,.02), n:new THREE.Vector3(.99,0,.10)},
    {name:'左側胸', p:new THREE.Vector3(-.34,yOff+1.06,.02), n:new THREE.Vector3(-.98,.08,.18)},
    {name:'右側胸', p:new THREE.Vector3( .34,yOff+1.06,.02), n:new THREE.Vector3(.98,.08,.18)}
  ];

  let zones;
  if(c < .20){
    zones = backZones;
  }else if(c < .42){
    zones = backZones.concat(headZones.slice(0,2), sideZones.slice(0,2));
  }else if(c < .68){
    zones = backZones.concat(headZones, frontZones.slice(0,4), sideZones, armZones.slice(0,2));
  }else{
    zones = backZones.concat(headZones, frontZones, sideZones, armZones, legZones);
  }

  const z = zones[index % zones.length];
  let localWorld = z.p.clone();
  let normal = z.n.clone().normalize();

  // 每一層同一身體部位不要疊在完全同一點；但 jitter 不能大到聚成一顆糊球。
  localWorld.x += sinTowerSignedRand(seed+1) * .035;
  localWorld.y += sinTowerSignedRand(seed+2) * .040;
  localWorld.z += sinTowerSignedRand(seed+3) * .030;
  normal.add(new THREE.Vector3(sinTowerSignedRand(seed+4)*.08, sinTowerSignedRand(seed+5)*.05, sinTowerSignedRand(seed+6)*.08)).normalize();
  localWorld.addScaledVector(normal, .040 + c*.055 + sinTowerRand(seed+7)*.018);

  const pivot = new THREE.Group();
  pivot.name = `斷罪塔｜身體部位包覆小腫瘤-${z.name}-${level}-${index}`;
  pivot.position.copy(localWorld.multiplyScalar(unit));
  host.add(pivot);
  trackSinTowerInfectionRoot(pivot);
  return {pivot, host, unit, baseLocal:pivot.position.clone(), normal, zone:{name:'body_cover_true_tumor'}};
}

function getSinTowerActorBoundsInPlayerLocal(){
  const target = actorModel || actorProxy || playerGroup;
  const box = new THREE.Box3().setFromObject(target);
  if(!box || !isFinite(box.min.x) || !isFinite(box.max.x)){
    return {
      min:new THREE.Vector3(-.32,-.32,-.16),
      max:new THREE.Vector3(.32,1.48,.16),
      center:new THREE.Vector3(0,.58,0),
      size:new THREE.Vector3(.64,1.80,.32)
    };
  }
  playerGroup?.updateMatrixWorld?.(true);
  const corners = [
    new THREE.Vector3(box.min.x,box.min.y,box.min.z), new THREE.Vector3(box.min.x,box.min.y,box.max.z),
    new THREE.Vector3(box.min.x,box.max.y,box.min.z), new THREE.Vector3(box.min.x,box.max.y,box.max.z),
    new THREE.Vector3(box.max.x,box.min.y,box.min.z), new THREE.Vector3(box.max.x,box.min.y,box.max.z),
    new THREE.Vector3(box.max.x,box.max.y,box.min.z), new THREE.Vector3(box.max.x,box.max.y,box.max.z)
  ];
  const localBox = new THREE.Box3();
  for(const c of corners){
    const lc = playerGroup ? playerGroup.worldToLocal(c.clone()) : c;
    localBox.expandByPoint(lc);
  }
  const size = new THREE.Vector3();
  const center = new THREE.Vector3();
  localBox.getSize(size);
  localBox.getCenter(center);
  size.x = clamp(size.x, .35, 1.55);
  size.y = clamp(size.y, 1.05, 2.45);
  size.z = clamp(size.z, .18, 1.20);
  const min = center.clone().sub(size.clone().multiplyScalar(.5));
  const max = center.clone().add(size.clone().multiplyScalar(.5));
  return {min,max,center,size};
}

function makeSinTowerCoverageAttachmentGlobal(serial, total, coverP, seed, forcedRegion=null){
  // v51：骨架貼附維持不變，但加入指定區域，讓生長順序可以明確變成：左手 → 頭 → 背 → 前面 → 右手 → 左腳 → 右腳。
  const b = getSinTowerSkeletonCoverageBones();
  const p = clamp(coverP || 0, 0, 1);
  const mk = (name, region, host, along, radial, face, sx=.050, sy=.055, weight=1) => ({name, region, host:host||playerGroup, along, radial, face, sx, sy, weight});
  const patches = [
    mk('左上臂外側','leftHand', b.leftUpperArm, .38, .088, 'left', .050, .055, 2),
    mk('左上臂前','leftHand', b.leftUpperArm, .36, .090, 'front', .050, .055, 2),
    mk('左上臂後','leftHand', b.leftUpperArm, .44, .090, 'back', .050, .055, 2),
    mk('左前臂前','leftHand', b.leftForeArm, .56, .082, 'front', .045, .052, 2),
    mk('左前臂後','leftHand', b.leftForeArm, .62, .082, 'back', .045, .052, 2),
    mk('左手背','leftHand', b.leftHand, .18, .068, 'front', .038, .038, 2),

    mk('後腦','head', b.head, .00, .086, 'back', .045, .045, 3),
    mk('頭頂','head', b.head, .01, .102, 'top', .048, .048, 2),
    mk('左頭側','head', b.head, .00, .082, 'left', .042, .042, 2),
    mk('右頭側','head', b.head, .00, .082, 'right', .042, .042, 2),
    mk('前額','head', b.head, .00, .092, 'front', .044, .044, 2),
    mk('臉前','head', b.head, -.04, .100, 'front', .045, .045, 3),
    mk('下巴前','head', b.head, -.10, .088, 'front', .040, .040, 2),

    mk('後頸','back', b.neck, .10, .074, 'back', .042, .042, 2),
    mk('左肩背','back', b.chest, .18, .095, 'left', .055, .055, 2),
    mk('上胸背','back', b.chest, .10, .108, 'back', .070, .070, 3),
    mk('中背','back', b.spineMid, .14, .118, 'back', .075, .080, 3),
    mk('右肩背','back', b.chest, .18, .095, 'right', .055, .055, 2),
    mk('左下背','back', b.spineLower, .08, .108, 'left', .060, .072, 2),
    mk('下背','back', b.spineLower, .04, .118, 'back', .070, .072, 3),
    mk('右下背','back', b.spineLower, .08, .108, 'right', .060, .072, 2),

    mk('左側胸','front', b.chest, .12, .102, 'left', .060, .072, 2),
    mk('右側胸','front', b.chest, .12, .102, 'right', .060, .072, 2),
    mk('左側腰','front', b.spineMid, .06, .096, 'left', .056, .066, 2),
    mk('右側腰','front', b.spineMid, .06, .096, 'right', .056, .066, 2),
    mk('胸前','front', b.chest, .10, .118, 'front', .072, .078, 3),
    mk('左胸前','front', b.chest, .10, .110, 'left', .060, .068, 2),
    mk('右胸前','front', b.chest, .10, .110, 'right', .060, .068, 2),
    mk('腹前','front', b.spineMid, .04, .114, 'front', .070, .066, 3),
    mk('骨盆前','front', b.hips, .00, .110, 'front', .060, .060, 2),

    mk('右上臂外側','rightHand', b.rightUpperArm, .38, .088, 'right', .050, .055, 2),
    mk('右上臂前','rightHand', b.rightUpperArm, .36, .090, 'front', .050, .055, 2),
    mk('右上臂後','rightHand', b.rightUpperArm, .44, .090, 'back', .050, .055, 2),
    mk('右前臂前','rightHand', b.rightForeArm, .56, .082, 'front', .045, .052, 2),
    mk('右前臂後','rightHand', b.rightForeArm, .62, .082, 'back', .045, .052, 2),
    mk('右手背','rightHand', b.rightHand, .18, .068, 'front', .038, .038, 2),

    mk('左大腿外側','leftLeg', b.leftThigh, .34, .096, 'left', .052, .062, 2),
    mk('左大腿前','leftLeg', b.leftThigh, .36, .104, 'front', .055, .066, 2),
    mk('左大腿後','leftLeg', b.leftThigh, .44, .104, 'back', .055, .066, 2),
    mk('左小腿前','leftLeg', b.leftCalf, .50, .084, 'front', .048, .054, 2),
    mk('左小腿後','leftLeg', b.leftCalf, .56, .090, 'back', .048, .056, 2),
    mk('左腳背','leftLeg', b.leftFoot, .12, .076, 'front', .040, .036, 2),

    mk('右大腿外側','rightLeg', b.rightThigh, .34, .096, 'right', .052, .062, 2),
    mk('右大腿前','rightLeg', b.rightThigh, .36, .104, 'front', .055, .066, 2),
    mk('右大腿後','rightLeg', b.rightThigh, .44, .104, 'back', .055, .066, 2),
    mk('右小腿前','rightLeg', b.rightCalf, .50, .084, 'front', .048, .054, 2),
    mk('右小腿後','rightLeg', b.rightCalf, .56, .090, 'back', .048, .056, 2),
    mk('右腳背','rightLeg', b.rightFoot, .12, .076, 'front', .040, .036, 2)
  ];
  const filtered = forcedRegion ? patches.filter(v => v.region === forcedRegion) : patches;
  const eligible = [];
  for(const patch of filtered){
    const repeat = Math.max(1, Math.round(patch.weight || 1));
    for(let i=0;i<repeat;i++) eligible.push(patch);
  }
  const patch = eligible[serial % eligible.length];
  const host = patch.host || playerGroup || actorProxy;
  const unit = clamp(1 / averageWorldScale(host), .04, 160.0);
  const frame = getSinTowerBoneSurfaceFrame(host);
  const baseNormal = getSinTowerBoneFaceNormal(frame, patch.face);
  const tangent = frame.axis.clone().normalize();
  let bitangent = new THREE.Vector3().crossVectors(baseNormal, tangent).normalize();
  if(bitangent.lengthSq() < .0001) bitangent = new THREE.Vector3().crossVectors(baseNormal, new THREE.Vector3(0,1,0)).normalize();
  if(bitangent.lengthSq() < .0001) bitangent.set(1,0,0);

  const ring = Math.floor(serial / eligible.length);
  const around = (serial * 2.399963229728653 + sinTowerRand(seed+5) * .9) % (Math.PI * 2);
  const spreadR = Math.min(1.35, .22 + ring * .08);
  const shellLayer = clampSinTowerShellLayer(Math.floor(ring / 2));
  const shellOut = Math.min(.38, shellLayer * (0.020 + patch.radial * 0.22 + p * 0.012));
  const jitterX = Math.cos(around) * patch.sx * spreadR + sinTowerSignedRand(seed+11) * patch.sx * .10;
  const jitterY = Math.sin(around) * patch.sy * spreadR + sinTowerSignedRand(seed+12) * patch.sy * .10;
  const pos = frame.axis.clone().multiplyScalar(frame.length * patch.along)
    .addScaledVector(baseNormal, patch.radial + shellOut)
    .addScaledVector(bitangent, jitterX)
    .addScaledVector(tangent, jitterY * .40)
    .addScaledVector(baseNormal, .014 + p * .020 + sinTowerRand(seed+13) * .010);

  const normal = baseNormal.clone().addScaledVector(bitangent, sinTowerSignedRand(seed+21) * .08).addScaledVector(tangent, sinTowerSignedRand(seed+22) * .05).normalize();
  const pivot = new THREE.Group();
  pivot.name = `斷罪塔｜骨架包覆小腫瘤-${patch.name}-${serial}`;
  pivot.position.copy(pos.multiplyScalar(unit));
  host.add(pivot);
  trackSinTowerInfectionRoot(pivot);
  return {pivot, host, unit, baseLocal:pivot.position.clone(), normal, shellLayer, region:patch.region, zone:{name:'body_cover_true_tumor'}};
}

function estimateSinTowerOuterOffsetLocal(att, radiusWorld, progress){
  const radiusLocal = radiusWorld * att.unit;
  const shellBoost = clampSinTowerShellLayer(att?.shellLayer || 0) * radiusLocal * .13;
  const progressBoost = radiusLocal * (.54 + progress * .22);
  return Math.min(radiusLocal * 2.10, radiusLocal + shellBoost + progressBoost);
}

function sinTowerWorldDirToLocal(parent, dirWorld){
  const q = new THREE.Quaternion();
  parent?.updateMatrixWorld?.(true);
  parent?.getWorldQuaternion?.(q);
  q.invert();
  return dirWorld.clone().applyQuaternion(q).normalize();
}

function addSinTowerLayeredBranchStem(parentPivot, targetLocal, unit, seed, layerDepth=2){
  // v80：第二／第三層必須是「綁在原本骨架系統上的分岔樹枝」，不能改成世界座標獨立物件。
  // 這裡在上一層 pivot 內建立可見枝幹，所以會跟著角色骨架、上一層晃動一起動。
  if(!parentPivot || !targetLocal) return null;
  const len = Math.max(.0001, targetLocal.length());
  const dir = targetLocal.clone().normalize();
  const side = new THREE.Vector3(-dir.z, 0, dir.x);
  if(side.lengthSq() < .0001) side.set(1,0,0);
  side.normalize();
  const wobble = Math.min(len * .22, (.012 + sinTowerRand(seed+12) * .030) * unit);
  const p0 = dir.clone().multiplyScalar(Math.min(len*.10, .018 * unit));
  const p1 = dir.clone().multiplyScalar(len*.38).addScaledVector(side, sinTowerSignedRand(seed+13) * wobble);
  const p2 = dir.clone().multiplyScalar(len*.72).addScaledVector(side, sinTowerSignedRand(seed+14) * wobble * .72);
  const p3 = targetLocal.clone().multiplyScalar(.96);
  const curve = new THREE.CatmullRomCurve3([p0,p1,p2,p3]);
  const radWorld = layerDepth >= 3 ? (.0065 + sinTowerRand(seed+18)*.006) : (.009 + sinTowerRand(seed+17)*.008);
  const rad = clamp(radWorld * unit, .0022 * unit, .022 * unit);
  const mesh = new THREE.Mesh(new THREE.TubeGeometry(curve, 8, rad, 7, false), getSinTowerTentacleMaterial(seed + 8800));
  mesh.name = layerDepth >= 3 ? '斷罪塔｜第三層骨架分岔樹枝' : '斷罪塔｜第二層骨架分岔樹枝';
  mesh.userData.isSinTowerControlledGrowth = true;
  mesh.userData.sinTowerBranchStem = true;
  mesh.castShadow = false;
  mesh.receiveShadow = false;
  parentPivot.add(mesh);
  return mesh;
}

function makeSinTowerLayeredSkeletonAttachment(baseRecord, serial, seed, progress, layerName='第二層', layerDepth=2){
  // v80：復原成「上一層 pivot 內部長出分岔枝，下一層 pivot 掛在枝端」的結構。
  // 不能像 v79 那樣轉成 playerGroup 世界座標，否則第二／第三層不會跟著角色模型與上一層晃動。
  // 也不能再用 parentPivot 當下的 worldScale 反推 unit，因為上一層生長時 scale 可能是 .001，會導致 1000 倍爆大。
  const source = baseRecord?.att;
  if(!source?.pivot){
    return makeSinTowerCoverageAttachmentGlobal(serial, 1, progress, seed, baseRecord?.region || null);
  }

  const parentPivot = source.pivot;
  const unit = getSinTowerStableAttachmentUnit(source, source.host || parentPivot.parent || playerGroup);
  parentPivot.userData.sinTowerNoUnsafeCleanup = true;
  parentPivot.updateMatrixWorld?.(true);
  source.host?.updateMatrixWorld?.(true);

  // source.normal 是 source.host 的 local 方向；先轉 world，再轉回 parentPivot local，讓分岔方向跟著骨架姿態走。
  let outwardWorld = (source.normal || new THREE.Vector3(0,0,-1)).clone().normalize();
  const hostQ = new THREE.Quaternion();
  (source.host || parentPivot.parent || playerGroup)?.getWorldQuaternion?.(hostQ);
  outwardWorld.applyQuaternion(hostQ).normalize();
  if(outwardWorld.lengthSq() < .0001) outwardWorld.set(0,0,-1);
  let outwardLocal = sinTowerWorldDirToLocal(parentPivot, outwardWorld);
  if(outwardLocal.lengthSq() < .0001) outwardLocal.set(0,0,-1);
  outwardLocal.normalize();

  let tangentA = new THREE.Vector3(-outwardLocal.z, 0, outwardLocal.x);
  if(tangentA.lengthSq() < .0001) tangentA = new THREE.Vector3(1,0,0);
  tangentA.normalize();
  let tangentB = new THREE.Vector3().crossVectors(outwardLocal, tangentA);
  if(tangentB.lengthSq() < .0001) tangentB.set(0,1,0);
  tangentB.normalize();

  const range = getSinTowerTumorRangeWorld(false);
  const baseRadiusWorld = Math.max(.018, safeFinite(baseRecord?.radiusWorld, range.min));
  // 這裡的距離是世界尺寸，再乘 source unit 變成 parentPivot local；不讀 parentPivot.scale。
  const layerGapWorld = layerDepth >= 3
    ? clamp(baseRadiusWorld * .88 + range.max * .34, .040, Math.max(.12, range.max * 1.15))
    : clamp(baseRadiusWorld * .70 + range.max * .25, .032, Math.max(.10, range.max * .92));
  const angle = (serial * 2.399963229728653 + sinTowerRand(seed+23) * 1.15) % (Math.PI * 2);
  const branchSpreadWorld = clamp(baseRadiusWorld * (.20 + sinTowerRand(seed+24)*.30), .006, Math.max(.018, range.max * .28));
  const targetLocal = outwardLocal.clone().multiplyScalar(layerGapWorld * unit)
    .addScaledVector(tangentA, Math.cos(angle) * branchSpreadWorld * unit)
    .addScaledVector(tangentB, Math.sin(angle) * branchSpreadWorld * unit * .78);

  addSinTowerLayeredBranchStem(parentPivot, targetLocal, unit, seed, layerDepth);

  const pivot = new THREE.Group();
  pivot.name = `斷罪塔｜${layerName}骨架分岔端點-${baseRecord?.region || 'branch'}-${serial}`;
  pivot.position.copy(targetLocal);
  pivot.userData.sinTowerUnit = unit;
  pivot.userData.sinTowerLayerDepth = layerDepth;
  pivot.userData.sinTowerNoUnsafeCleanup = true;
  parentPivot.add(pivot);

  const normal = outwardLocal.clone().addScaledVector(tangentA, sinTowerSignedRand(seed+31) * .10).addScaledVector(tangentB, sinTowerSignedRand(seed+32) * .08).normalize();
  return {
    pivot,
    host: parentPivot,
    unit,
    baseLocal: targetLocal.clone(),
    normal,
    shellLayer:clampSinTowerShellLayer((source.shellLayer || 0) + 1),
    region:baseRecord?.region || source.region || 'branch',
    zone:{name: layerDepth >= 3 ? 'body_cover_third_skeleton_branch' : 'body_cover_secondary_skeleton_branch'}
  };
}

function makeSinTowerSecondarySkeletonAttachment(baseRecord, serial, seed, progress){
  return makeSinTowerLayeredSkeletonAttachment(baseRecord, serial, seed, progress, '第二層', 2);
}

function makeSinTowerThirdSkeletonAttachment(baseRecord, serial, seed, progress){
  return makeSinTowerLayeredSkeletonAttachment(baseRecord, serial, seed, progress, '第三層', 3);
}

function makeSinTowerInfectionRebuildState(level){
  const params = getSinTowerTumorParams();
  const threshold = Math.max(1, params.meatballLevel || 20);
  const p = clamp(level / threshold, 0, 1);
  // Visual complexity budget: preserve progression and silhouette without creating hundreds of tiny draw objects.
  const rawTumors = Math.max(12, Math.floor((18 + level * 3.8 + p * 20) * Math.sqrt(Math.max(.5, params.batchMul))));
  const totalTumors = Math.min(rawTumors, 128);
  const regionOrder = ['leftHand','head','back','front','rightHand','leftLeg','rightLeg'];
  const secondLevel = Math.round(clamp(params.secondarySkeletonLevel || 5, 1, 30));
  const thirdLevel = Math.max(secondLevel + 1, Math.round(clamp(params.thirdSkeletonLevel || 10, 2, 60)));
  const useSecondary = level >= secondLevel;
  const useThird = level >= thirdLevel;
  const activeLayer = useThird ? 3 : (useSecondary ? 2 : 1);
  let primaryTotal = totalTumors;
  let secondaryTotal = 0;
  let thirdTotal = 0;
  if(useThird){
    // v78：上一層只保留少量隱形外向骨架當支架，不再繼續在裡面長腫瘤。
    primaryTotal = Math.min(20, Math.max(12, Math.floor(secondLevel * 3.5)));
    secondaryTotal = Math.min(24, Math.max(14, Math.floor((thirdLevel - secondLevel) * 4)));
    thirdTotal = Math.max(16, totalTumors - primaryTotal - secondaryTotal);
  }else if(useSecondary){
    primaryTotal = Math.min(24, Math.max(12, Math.floor(secondLevel * 4)));
    secondaryTotal = Math.max(16, totalTumors - primaryTotal);
  }
  return {
    level, params, p, totalTumors, regionOrder, activeLayer,
    primaryTotal, secondaryTotal, thirdTotal,
    primaryIndex:0, secondaryIndex:0, thirdIndex:0,
    primaryCounts:Object.fromEntries(regionOrder.map(r=>[r,0])),
    secondaryCounts:Object.fromEntries(regionOrder.map(r=>[r,0])),
    thirdCounts:Object.fromEntries(regionOrder.map(r=>[r,0])),
    primaryRecords:[], secondaryRecords:[],
    regionPools:Object.fromEntries(regionOrder.map(r=>[r,[]])),
    secondaryPools:Object.fromEntries(regionOrder.map(r=>[r,[]])),
    tentacleJobs:0,
    phase:'primary',
    startedAt:performance.now()
  };
}

function scheduleSinTowerInfectionCoverRebuild(level){
  // v81：如果上一輪增生尚未分幀完成，不要立刻清掉重建；只記錄最高目標層。
  // 這會避免連續撞僧侶時反覆 clear -> rebuild -> dispose，造成第 20～30 次突然卡頓。
  const targetLevel = Math.max(0, Math.floor(safeFinite(level, SIN_TOWER_INFECTION.level || 0)));
  if(SIN_TOWER_INFECTION.rebuildState){
    SIN_TOWER_INFECTION.pendingRebuildLevel = Math.max(targetLevel, SIN_TOWER_INFECTION.pendingRebuildLevel || 0);
    return;
  }
  resetSinTowerInfectionCachesForRebuild();
  clearSinTowerInfectionAttachments();
  updateSinTowerActorInfectionVisibility();
  if(!playerGroup) return;
  SIN_TOWER_INFECTION.rebuildState = makeSinTowerInfectionRebuildState(targetLevel);
  applyActorSettings();
}

function processSinTowerPrimaryRebuildStep(st){
  const i = st.primaryIndex++;
  const seed = SIN_TOWER_INFECTION.growthSeed + 16000 + st.level * 337 + i * 31;
  const localP = i / Math.max(1, st.primaryTotal - 1);
  const regionIndex = Math.min(st.regionOrder.length - 1, Math.floor(localP * st.regionOrder.length));
  const region = st.regionOrder[regionIndex];
  const att = makeSinTowerCoverageAttachmentGlobal(st.primaryCounts[region]++, st.totalTumors, st.p, seed, region);
  const micro = (i % 9 === 0 && st.p < .92);
  const r = getSinTowerCoverTumorRadiusWorld(seed, st.p, micro);
  const record = {att, region, seed, radiusWorld:r, micro, outerOffsetLocal:estimateSinTowerOuterOffsetLocal(att, r, Math.max(.58,st.p))};
  st.primaryRecords.push(record);
  st.regionPools[region].push(record);
  if(st.activeLayer === 1){
    queueSinTowerBuildJob({type:'buildTumor', att, radius:r, seed, progress:Math.max(.58, st.p), micro});
    const wantTentacle = st.p > .12 && !micro && (i % Math.max(6, Math.floor(10 - st.p*3)) === 0 || (region === 'head' && i % 8 === 0));
    if(wantTentacle){
      const len = (.20 + sinTowerRand(seed+4)*.30) * (1 + st.p*.25);
      const th = (.012 + sinTowerRand(seed+5)*.014) * (1 + st.p*.14);
      st.tentacleJobs = (st.tentacleJobs || 0) + queueSinTowerTentacleTriplet(att,len,th,seed+6,Math.max(.58,st.p));
    }
  }
}

function processSinTowerSecondaryRebuildStep(st){
  const i = st.secondaryIndex++;
  const seed = SIN_TOWER_INFECTION.growthSeed + 26000 + st.level * 521 + i * 37;
  const localP = i / Math.max(1, st.secondaryTotal - 1);
  const regionIndex = Math.min(st.regionOrder.length - 1, Math.floor(localP * st.regionOrder.length));
  const region = st.regionOrder[regionIndex];
  const pool = st.regionPools[region].length ? st.regionPools[region] : st.primaryRecords;
  const baseRecord = pool[Math.floor((st.secondaryCounts[region] * 1.7 + i * .3) % Math.max(1, pool.length))];
  const att = makeSinTowerSecondarySkeletonAttachment(baseRecord, st.secondaryCounts[region]++, seed, st.p);
  const micro = false;
  const r = getSinTowerCoverTumorRadiusWorld(seed, Math.min(1, st.p * 1.04), micro);
  const record = {att, region, seed, radiusWorld:r, micro, outerOffsetLocal:estimateSinTowerOuterOffsetLocal(att, r, Math.max(.64,st.p))};
  st.secondaryRecords.push(record);
  st.secondaryPools[region].push(record);
  if(st.activeLayer === 2){
    queueSinTowerBuildJob({type:'buildTumor', att, radius:r, seed, progress:Math.max(.64, st.p), micro});
    const wantTentacle = st.p > .16 && (i % Math.max(5, Math.floor(8 - st.p*2)) === 0 || region === 'head' && i % 7 === 0);
    if(wantTentacle){
      const len = (.24 + sinTowerRand(seed+4)*.34) * (1 + st.p*.30);
      const th = (.013 + sinTowerRand(seed+5)*.016) * (1 + st.p*.18);
      st.tentacleJobs = (st.tentacleJobs || 0) + queueSinTowerTentacleTriplet(att,len,th,seed+6,Math.max(.64,st.p));
    }
  }
}

function processSinTowerThirdRebuildStep(st){
  const i = st.thirdIndex++;
  const seed = SIN_TOWER_INFECTION.growthSeed + 36000 + st.level * 613 + i * 43;
  const localP = i / Math.max(1, st.thirdTotal - 1);
  const regionIndex = Math.min(st.regionOrder.length - 1, Math.floor(localP * st.regionOrder.length));
  const region = st.regionOrder[regionIndex];
  const pool = st.secondaryPools[region].length ? st.secondaryPools[region] : (st.secondaryRecords.length ? st.secondaryRecords : st.primaryRecords);
  const baseRecord = pool[Math.floor((st.thirdCounts[region] * 1.9 + i * .37) % Math.max(1, pool.length))];
  const att = makeSinTowerThirdSkeletonAttachment(baseRecord, st.thirdCounts[region]++, seed, st.p);
  const micro = false;
  const r = getSinTowerCoverTumorRadiusWorld(seed, Math.min(1, st.p * 1.12), micro);
  queueSinTowerBuildJob({type:'buildTumor', att, radius:r, seed, progress:Math.max(.70, st.p), micro});
  const wantTentacle = st.p > .20 && (i % Math.max(5, Math.floor(7 - st.p*2)) === 0 || region === 'head' && i % 7 === 0);
  if(wantTentacle){
    const len = (.26 + sinTowerRand(seed+4)*.38) * (1 + st.p*.35);
    const th = (.014 + sinTowerRand(seed+5)*.018) * (1 + st.p*.20);
    st.tentacleJobs = (st.tentacleJobs || 0) + queueSinTowerTentacleTriplet(att,len,th,seed+6,Math.max(.70,st.p));
  }
}

function processSinTowerInfectionRebuildQueue(maxMs=4.2){
  const st = SIN_TOWER_INFECTION.rebuildState;
  if(!st) return;
  const start = performance.now();
  let jobs = 0;
  while(performance.now() - start < maxMs && jobs < 14){
    if(st.phase === 'primary'){
      if(st.primaryIndex < st.primaryTotal) processSinTowerPrimaryRebuildStep(st);
      else st.phase = st.secondaryTotal > 0 ? 'secondary' : (st.thirdTotal > 0 ? 'third' : 'done');
    }else if(st.phase === 'secondary'){
      if(st.secondaryIndex < st.secondaryTotal) processSinTowerSecondaryRebuildStep(st);
      else st.phase = st.thirdTotal > 0 ? 'third' : 'done';
    }else if(st.phase === 'third'){
      if(st.thirdIndex < st.thirdTotal) processSinTowerThirdRebuildStep(st);
      else st.phase = 'done';
    }else{
      if((st.tentacleJobs || 0) <= 0){
        const fallback = (st.activeLayer >= 3 ? st.secondaryRecords : st.primaryRecords)[0] || st.primaryRecords[0];
        if(fallback?.att?.pivot){
          st.tentacleJobs = queueSinTowerTentacleTriplet(fallback.att,.64,.026,99000 + st.level * 17,Math.max(.72,st.p));
        }
      }
      SIN_TOWER_INFECTION.rebuildState = null;
      SIN_TOWER_INFECTION.needsUnsafeCleanup = true;
      const pending = Math.max(0, Math.floor(SIN_TOWER_INFECTION.pendingRebuildLevel || 0));
      SIN_TOWER_INFECTION.pendingRebuildLevel = 0;
      if(pending > st.level && pending <= Math.max(1, Math.floor(getSinTowerTumorParams().meatballLevel || 20))){
        scheduleSinTowerInfectionCoverRebuild(pending);
      }
      applyActorSettings();
      break;
    }
    jobs++;
  }
}

function rebuildSinTowerInfectionCoverFromScratch(level){
  scheduleSinTowerInfectionCoverRebuild(level);
}

function makeSinTowerTumorGeometry(radius, seed, weight=.6){
  // Geometry is unit-sized and shared. Radius belongs in the mesh transform so differently-sized tumors can instance together.
  const shapeTier = Math.abs(Math.floor(seed || 0)) % 6;
  const weightTier = clamp(Math.round(safeFinite(weight,.6) * 3), 1, 4);
  const key = `tumor_unit|${shapeTier}|${weightTier}`;
  if(SIN_TOWER_INFECTION.geometryCache.has(key)) return SIN_TOWER_INFECTION.geometryCache.get(key);
  const geo = new THREE.SphereGeometry(1, 16, 12);
  const pos = geo.attributes.position;
  const v = new THREE.Vector3();
  const n = new THREE.Vector3();
  const shapeSeed = shapeTier * 97 + weightTier * 31;
  const deformation = weightTier / 3;
  const pores = [];
  const poreCount = 5 + weightTier * 2;
  for(let i=0;i<poreCount;i++){
    const a = sinTowerRand(shapeSeed+11+i*3.1) * Math.PI * 2;
    const u = THREE.MathUtils.lerp(-.88,.96,sinTowerRand(shapeSeed+12+i*4.7));
    const s = Math.sqrt(Math.max(0,1-u*u));
    pores.push({dir:new THREE.Vector3(Math.cos(a)*s,u,Math.sin(a)*s), size:.16+sinTowerRand(shapeSeed+13+i*5.1)*.17, depth:.08+sinTowerRand(shapeSeed+14+i*6.2)*.18});
  }
  for(let i=0;i<pos.count;i++){
    v.fromBufferAttribute(pos,i);
    n.copy(v).normalize();
    let radial = 1 + Math.sin((n.x*8.2+n.y*5.3+n.z*6.4+shapeSeed)*2.1)*.075 + Math.cos((n.x*12.1-n.y*8.7+n.z*4.9+shapeSeed)*1.6)*.05;
    for(const pore of pores){
      const d = n.distanceTo(pore.dir);
      if(d < pore.size) radial -= pore.depth * Math.pow(1 - d / pore.size, 2.4);
    }
    v.multiplyScalar(radial);
    v.y -= Math.max(0,-n.y) * (.16 + deformation*.08);
    pos.setXYZ(i,v.x,v.y,v.z);
  }
  geo.computeVertexNormals();
  geo.computeBoundingSphere();
  SIN_TOWER_INFECTION.geometryCache.set(key, geo);
  return geo;
}

function makeSinTowerGrowthScale(k){
  const eased = k < .75 ? THREE.MathUtils.lerp(0,1.12,k/.75) : THREE.MathUtils.lerp(1.12,1,(k-.75)/.25);
  return clamp(eased,.001,1.18);
}

function registerSinTowerAttachmentNode(node, parent, seed, baseLocal, targetScale, droopWorld=0, delay=0){
  const profile = node.userData?.motionProfile || 'tumor';
  if(node.userData?.motion){
    const m0 = node.userData.motion;
    m0.droopWorld = Math.max(m0.droopWorld || 0, droopWorld || 0);
    if(profile === 'tentacle'){
      m0.profile = 'tentacle';
      m0.weightSwing = Math.max(m0.weightSwing || 0, .024 + sinTowerRand(seed+92)*.018);
      m0.windSwing = Math.max(m0.windSwing || 0, .010 + sinTowerRand(seed+94)*.010);
    }
    return;
  }
  const isTentacle = profile === 'tentacle';
  const isFungus = profile === 'fungus';
  const unit = getSinTowerStableAttachmentUnit({unit:node.userData?.sinTowerUnit}, parent);
  const m = {
    seed,
    profile,
    parent,
    unit,
    baseLocal:baseLocal.clone(),
    localDown:new THREE.Vector3(0,-unit,0),
    targetScale:targetScale.clone ? targetScale.clone() : new THREE.Vector3(targetScale,targetScale,targetScale),
    droopWorld,
    growStart:performance.now()+delay+sinTowerRand(seed+90)*180,
    growDuration:(((isTentacle ? 720 : 560)+sinTowerRand(seed+91)*(isTentacle ? 420 : 300)) / Math.max(.25, getSinTowerTumorParams().growthSpeed || 4.0)),
    baseRotation:node.rotation.clone(),
    weightSwing:isTentacle ? (.024+sinTowerRand(seed+92)*.018) : (isFungus ? .008 : 0),
    windSwing:isTentacle ? (.010+sinTowerRand(seed+94)*.010) : 0,
    freqA:(isTentacle ? 1.15 : .8) + sinTowerRand(seed)*.55,
    freqB:(isTentacle ? .85 : .65) + sinTowerRand(seed+3)*.45,
    phaseA:seed,
    phaseB:seed*.7
  };
  node.userData.motion = m;
  node.scale.setScalar(.001);
  const record = {node,parent,motion:m};
  SIN_TOWER_INFECTION.attachments.push(record);
  (SIN_TOWER_INFECTION.dynamicAttachments || (SIN_TOWER_INFECTION.dynamicAttachments = [])).push(record);
}

function getSinTowerCachedWrinkleGeometry(){
  const cache = SIN_TOWER_INFECTION.wrinkleGeometryCache || (SIN_TOWER_INFECTION.wrinkleGeometryCache = new Map());
  const key = 'unit_torus_arc';
  if(cache.has(key)) return cache.get(key);
  const geo = new THREE.TorusGeometry(1, .025, 5, 18, Math.PI * 1.25);
  cache.set(key, geo);
  return geo;
}

function addSinTowerBurnWrinkles(tumor, radius, seed, countMul=1){
  const mats = getSinTowerInfectionMaterials();
  const count = Math.floor((3 + radius * 18) * countMul);
  const wrinkleGeo = getSinTowerCachedWrinkleGeometry();
  if(count <= 0) return;
  // 每顆腫瘤的皺褶形狀與材質相同，只差局部 Transform；用 InstancedMesh 保留原本細節，
  // 將多個 draw call 合成一個，避免腫瘤數量增加時渲染提交數線性爆炸。
  const batch = new THREE.InstancedMesh(wrinkleGeo, mats.wrinkleMaterial, count);
  batch.name = '斷罪塔｜批次皺褶細節';
  batch.castShadow = false;
  batch.receiveShadow = false;
  batch.instanceMatrix.setUsage(THREE.StaticDrawUsage);
  const matrix = new THREE.Matrix4();
  const position = new THREE.Vector3();
  const scale = new THREE.Vector3();
  const rotation = new THREE.Euler();
  const quaternion = new THREE.Quaternion();
  for(let i=0;i<count;i++){
    scale.setScalar(radius * (.62 + sinTowerRand(seed+i*4)*.18));
    rotation.set(sinTowerRand(seed+i*6)*Math.PI, sinTowerRand(seed+i*7)*Math.PI, sinTowerRand(seed+i*8)*Math.PI);
    quaternion.setFromEuler(rotation);
    position.set(sinTowerSignedRand(seed+i*9)*radius*.12, sinTowerSignedRand(seed+i*10)*radius*.18, sinTowerSignedRand(seed+i*11)*radius*.12);
    matrix.compose(position, quaternion, scale);
    batch.setMatrixAt(i, matrix);
  }
  batch.instanceMatrix.needsUpdate = true;
  tumor.add(batch);
}

function getSinTowerFungusPointMaterial(size, fine=false){
  const mats = getSinTowerInfectionMaterials();
  // 不讓每顆腫瘤的微小尺寸差異建立一個新 shader；五個尺寸級距足以保留遠近層次，
  // 同時把 PointsMaterial / WebGL program 數量固定在很小的上限。
  const sizeLevels = fine ? [.0018,.0025,.0034,.0046,.0062] : [.0028,.0040,.0056,.0078,.0108];
  const bucket = sizeLevels.reduce((best, value)=>Math.abs(value-size) < Math.abs(best-size) ? value : best, sizeLevels[0]);
  const key = `${fine ? 'fine' : 'main'}_${bucket.toFixed(4)}`;
  const poolName = fine ? 'fungusFineMaterials' : 'fungusPointMaterials';
  const pool = mats[poolName] || (mats[poolName] = new Map());
  if(pool.has(key)) return pool.get(key);
  const mat = new THREE.PointsMaterial({size:bucket, sizeAttenuation:true, vertexColors:true, transparent:true, opacity:fine ? .82 : .96, depthWrite:false});
  pool.set(key, mat);
  return mat;
}

// Keep the exact tube profiles and material groups, but submit one geometry per
// tentacle instead of one draw object for every short tube segment.
function mergeSinTowerTubeParts(parts){
  const valid = (parts || []).filter(part=>part?.geometry?.attributes?.position && part.material);
  if(!valid.length) return null;
  const attrNames = ['position','normal','uv'];
  const attrTotals = new Map();
  let totalVertices = 0;
  let totalIndices = 0;
  for(const part of valid){
    const geo = part.geometry;
    totalVertices += geo.attributes.position.count;
    totalIndices += geo.index ? geo.index.count : geo.attributes.position.count;
    for(const name of attrNames){
      const attr = geo.attributes[name];
      if(attr) attrTotals.set(name, (attrTotals.get(name) || 0) + attr.count * attr.itemSize);
    }
  }
  const merged = new THREE.BufferGeometry();
  for(const name of attrNames){
    const firstAttr = valid.find(part=>part.geometry.attributes[name])?.geometry.attributes[name];
    if(!firstAttr) continue;
    const values = new Float32Array(attrTotals.get(name) || 0);
    let offset = 0;
    for(const part of valid){
      const attr = part.geometry.attributes[name];
      if(!attr) continue;
      values.set(attr.array, offset);
      offset += attr.array.length;
    }
    merged.setAttribute(name, new THREE.BufferAttribute(values, firstAttr.itemSize, firstAttr.normalized));
  }
  const indexValues = totalVertices > 65535 ? new Uint32Array(totalIndices) : new Uint16Array(totalIndices);
  const materials = [];
  const materialIndices = new Map();
  let vertexOffset = 0;
  let indexOffset = 0;
  for(const part of valid){
    const geo = part.geometry;
    const index = geo.index;
    const count = index ? index.count : geo.attributes.position.count;
    for(let i=0;i<count;i++) indexValues[indexOffset+i] = (index ? index.getX(i) : i) + vertexOffset;
    let matIndex = materialIndices.get(part.material.uuid);
    if(matIndex === undefined){
      matIndex = materials.length;
      materialIndices.set(part.material.uuid, matIndex);
      materials.push(part.material);
    }
    merged.addGroup(indexOffset, count, matIndex);
    indexOffset += count;
    vertexOffset += geo.attributes.position.count;
    geo.dispose?.();
  }
  merged.setIndex(new THREE.BufferAttribute(indexValues, 1));
  merged.computeBoundingBox();
  merged.computeBoundingSphere();
  return {geometry:merged, materials};
}


let sinTowerDetailIdleHandle=0;
function scheduleSinTowerDetailIdlePump(){
  if(sinTowerDetailIdleHandle||(SIN_TOWER_INFECTION.detailQueue||[]).length===0)return;
  const run=deadline=>{sinTowerDetailIdleHandle=0;const queue=SIN_TOWER_INFECTION.detailQueue||[];if(!queue.length)return;const moving=isSinTowerAutoRunActive()||!!(keys.w||keys.a||keys.s||keys.d),recording=sinTowerCaptureMode!=='none';let budget=recording ? .35 : moving ? .7 : 2.4;if(deadline&&!deadline.didTimeout)budget=Math.min(budget,Math.max(.25,deadline.timeRemaining()));processSinTowerDetailQueue(budget,1);if(queue.length)scheduleSinTowerDetailIdlePump();};
  if(typeof requestIdleCallback==='function')sinTowerDetailIdleHandle=requestIdleCallback(run,{timeout:sinTowerCaptureMode!=='none'?220:120});else sinTowerDetailIdleHandle=setTimeout(()=>run(null),sinTowerCaptureMode!=='none'?80:34);
}
function queueSinTowerBuildJob(job){
  const q = SIN_TOWER_INFECTION.detailQueue || (SIN_TOWER_INFECTION.detailQueue = []);
  q.push(job);scheduleSinTowerDetailIdlePump();
}

function queueSinTowerFungusDots(tumor, radius, seed, progress, countMul=1){
  if(!tumor || !tumor.parent) return;
  queueSinTowerBuildJob({type:'fungusDots', tumor, radius, seed, progress, countMul});
}

function processSinTowerDetailQueue(maxMs=3.0,maxJobs=12){
  const q = SIN_TOWER_INFECTION.detailQueue || [];
  if(!q.length) return;
  const start = performance.now();
  let spent = 0;
  let jobs = 0;
  const costMap = {buildTumor:2.0, buildTentacle:3.6, fungusDots:0.8, vascular:1.3, tumorEyes:1.2};
  while(q.length && jobs < maxJobs && performance.now() - start < maxMs){
    const job = q[0];
    const predicted = costMap[job?.type] || 1.0;
    if(jobs > 0 && spent + predicted > maxMs) break;
    q.shift();
    if(job?.type === 'buildTumor'){
      if(job.att?.pivot?.parent) buildSinTowerTumorOnSpine(job.att, job.radius, job.seed, job.progress, !!job.micro);
    }else if(job?.type === 'buildTentacle'){
      if(job.att?.pivot?.parent) buildSinTowerTentacleOnSpine(job.att, job.length, job.thickness, job.seed, job.progress);
    }else if(job?.type === 'fungusDots'){
      if(job.tumor?.parent) addSinTowerFungusDots(job.tumor, job.radius, job.seed, job.progress, job.countMul);
    }else if(job?.type === 'vascular'){
      if(job.att?.pivot?.parent) addSinTowerVascularFilaments(job.att.pivot, job.targetPos, job.radius, job.seed, job.countMul);
    }else if(job?.type === 'tumorEyes'){
      if(job.tumor?.parent) addSinTowerSurfaceBlinkEyes(job.tumor, job.radius, job.seed, job.count);
    }
    SIN_TOWER_INFECTION.colorLayerRevision=safeFinite(SIN_TOWER_INFECTION.colorLayerRevision,0)+1;
    spent += predicted;
    jobs++;
  }
}

function processSinTowerDisposeQueue(maxMs=2.0){
  const q = SIN_TOWER_INFECTION.disposeQueue || [];
  if(!q.length) return;
  const start = performance.now();
  let count = 0;
  while(q.length && count < 18 && performance.now() - start < maxMs){
    const n = q.shift();
    disposeSinTowerInfectionTreeLight(n);
    count++;
  }
}

function addSinTowerFungusDots(tumor, radius, seed, progress, countMul=1){
  // 卡頓修正：保留高密度叢集視覺，但共用 PointsMaterial；每顆腫瘤只建兩個 Points，不再 new material。
  const mats = getSinTowerInfectionMaterials();
  const tp = getSinTowerTumorParams();
  const densityBoost = 5.5;
  const colorVar = tp.fungusColorVar;
  const shapeVar = tp.fungusShapeVar;
  const clusterMul = tp.fungusClusterMul;
  const clusterCount = Math.max(4, Math.floor((4 + progress * 7) * countMul * 1.55 * clusterMul));
  const pointsPerCluster = Math.floor((10 + progress * 18) * Math.sqrt(densityBoost) * (.72 + shapeVar*.32));
  const total = Math.min(180, Math.max(24, clusterCount * pointsPerCluster));
  if(total <= 0) return;

  const positions = new Float32Array(total * 3);
  const colors = new Float32Array(total * 3);
  const palette = [
    new THREE.Color(0xf4ead8), new THREE.Color(0xd9c7a7), new THREE.Color(0xb9d2e6),
    new THREE.Color(0xe8b2bf), new THREE.Color(0xc3d1a4), new THREE.Color(0xbeb2d6),
    new THREE.Color(0x6f5644), new THREE.Color(0x46555d), new THREE.Color(0xd1a063),
    new THREE.Color(0x6e845c), new THREE.Color(0x8f5668)
  ];
  const muted = [new THREE.Color(0xd8c6a0), new THREE.Color(0x8b7355), new THREE.Color(0x6f5644)];
  const center = new THREE.Vector3();
  const dir = new THREE.Vector3();
  const tangentA = new THREE.Vector3();
  const tangentB = new THREE.Vector3();
  let ptr = 0;

  for(let c=0;c<clusterCount && ptr<total;c++){
    const cs = seed + c * 151;
    const a = sinTowerRand(cs+1) * Math.PI * 2;
    const u = THREE.MathUtils.lerp(-.88,.99, sinTowerRand(cs+2));
    const s = Math.sqrt(Math.max(0, 1-u*u));
    center.set(Math.cos(a)*s, u, Math.sin(a)*s).normalize();
    tangentA.set(-center.z, 0, center.x);
    if(tangentA.lengthSq() < .0001) tangentA.set(1,0,0);
    tangentA.normalize();
    tangentB.copy(center).cross(tangentA).normalize();
    const spread = (.055 + sinTowerRand(cs+5) * .17) * (.55 + shapeVar*.85) * Math.sqrt(clusterMul);
    const localCount = Math.min(pointsPerCluster, total - ptr);
    const rich = palette[Math.floor(sinTowerRand(cs+3) * palette.length)];
    const plain = muted[Math.floor(sinTowerRand(cs+4) * muted.length)];
    const baseCol = plain.clone().lerp(rich, clamp(colorVar*.65,0,1));

    for(let i=0;i<localCount && ptr<total;i++,ptr++){
      const ring = Math.pow(sinTowerRand(cs + i*5.11), .45 + shapeVar*.25);
      const angle = sinTowerRand(cs + i*6.17) * Math.PI * 2;
      const shapeTwist = Math.sin(i*.53 + cs*.01) * .025 * shapeVar;
      dir.copy(center)
        .addScaledVector(tangentA, Math.cos(angle) * (spread + shapeTwist) * ring)
        .addScaledVector(tangentB, Math.sin(angle) * spread * ring * (.75 + shapeVar*.28))
        .normalize();
      const layer = radius * (1.006 + sinTowerRand(cs+i*10.41) * (.034 + shapeVar*.032));
      const j = ptr * 3;
      positions[j] = dir.x * layer;
      positions[j+1] = dir.y * layer;
      positions[j+2] = dir.z * layer;
      const colorNoise = .64 + sinTowerRand(cs+i*12.2) * (.32 + colorVar*.20);
      const darken = (i % 5 === 0) ? .48 : 1.0;
      colors[j] = baseCol.r * colorNoise * darken;
      colors[j+1] = baseCol.g * colorNoise * darken;
      colors[j+2] = baseCol.b * colorNoise * darken;
    }
  }

  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
  geo.computeBoundingSphere();
  const mainSize = Math.max(radius * (.020 + shapeVar*.008) * Math.sqrt(clusterMul), .0028);
  const mat = getSinTowerFungusPointMaterial(mainSize, false);
  const pts = new THREE.Points(geo, mat);
  pts.name = '斷罪塔｜GPU高密度可調叢集孢子';
  tumor.add(pts);

  const fineTotal = Math.min(110, Math.floor(total * (.42 + shapeVar*.10)));
  const finePos = new Float32Array(fineTotal * 3);
  const fineColor = new Float32Array(fineTotal * 3);
  for(let i=0;i<fineTotal;i++){
    const cs = seed + 900 + i * 3.7;
    const a = sinTowerRand(cs+1) * Math.PI * 2;
    const u = THREE.MathUtils.lerp(-.90,.99, sinTowerRand(cs+2));
    const s = Math.sqrt(Math.max(0, 1-u*u));
    dir.set(Math.cos(a)*s, u, Math.sin(a)*s).normalize();
    const layer = radius * (1.012 + sinTowerRand(cs+3) * (.045 + shapeVar*.035));
    const j = i*3;
    finePos[j]=dir.x*layer; finePos[j+1]=dir.y*layer; finePos[j+2]=dir.z*layer;
    const col = (colorVar>.05 ? palette : muted)[Math.floor(sinTowerRand(cs+4)*(colorVar>.05 ? palette.length : muted.length))];
    const k = .40 + sinTowerRand(cs+5)*(.24 + colorVar*.18);
    fineColor[j]=col.r*k; fineColor[j+1]=col.g*k; fineColor[j+2]=col.b*k;
  }
  const fGeo = new THREE.BufferGeometry();
  fGeo.setAttribute('position', new THREE.BufferAttribute(finePos,3));
  fGeo.setAttribute('color', new THREE.BufferAttribute(fineColor,3));
  fGeo.computeBoundingSphere();
  const fineSize = Math.max(radius * (.010 + shapeVar*.006) * Math.sqrt(clusterMul), .0018);
  const fMat = getSinTowerFungusPointMaterial(fineSize, true);
  const fine = new THREE.Points(fGeo, fMat);
  fine.name = '斷罪塔｜可調極細叢集孢子粉塵';
  tumor.add(fine);
}

// 舊函式名稱保留成 no-op，避免其他呼叫殘留時又長出大片葉子。
function makeSinTowerFungusGeometry(width, height, seed){
  return getSinTowerCachedFungusDotGeometry();
}

function addSinTowerFungus(pivot, att, radiusWorld, seed, progress, countMul=1){
  // v78：真菌只做「貼在腫瘤表面的細微點狀叢群」，不再長葉片狀／柱狀 mesh。
  if(!pivot) return;
  const unit = Math.max(.001, safeFinite(att?.unit, getSinTowerStableAttachmentUnit(att || {}, pivot)));
  const radiusLocal = Math.max(.004 * unit, safeFinite(radiusWorld, .05) * unit);
  // 直接建立一層較稀疏的表面孢子，讓剛長出時就能看到；另一層仍走 detail queue 分幀補足。
  addSinTowerFungusDots(pivot, radiusLocal, seed, progress, countMul * .72);
}

function addSinTowerVascularFilaments(pivot, targetPos, radius, seed, countMul=1){
  // 單一 BufferGeometry 做出更明顯的漸層血管：根部暗紅，接近腫瘤變亮粉紅。
  const root = new THREE.Vector3(0,0,0);
  const aim = targetPos.clone().multiplyScalar(.86);
  const dir = aim.clone().normalize();
  const side = new THREE.Vector3(-dir.z,0,dir.x).normalize();
  if(side.lengthSq() < .0001) side.set(1,0,0);
  const up = new THREE.Vector3(0,1,0);
  const positions = [];
  const colors = [];
  const c0 = new THREE.Color(0x250106);
  const c1 = new THREE.Color(0x6d0614);
  const c2 = new THREE.Color(0xc82942);
  const c3 = new THREE.Color(0xff8298);
  const filamentCount = Math.max(9, Math.floor((8 + sinTowerRand(seed+2)*7) * countMul));

  function pushRibbon(a,b,ca,cb,w0,w1){
    const tangent = b.clone().sub(a).normalize();
    let perp = tangent.clone().cross(up);
    if(perp.lengthSq() < .0001) perp = side.clone();
    perp.normalize();
    const a1 = a.clone().addScaledVector(perp, w0);
    const a2 = a.clone().addScaledVector(perp, -w0);
    const b1 = b.clone().addScaledVector(perp, w1);
    const b2 = b.clone().addScaledVector(perp, -w1);
    const verts = [a1,a2,b1, a2,b2,b1];
    const cols = [ca,ca,cb, ca,cb,cb];
    for(let i=0;i<6;i++){
      positions.push(verts[i].x, verts[i].y, verts[i].z);
      colors.push(cols[i].r, cols[i].g, cols[i].b);
    }
  }

  for(let i=0;i<filamentCount;i++){
    const lane = side.clone().multiplyScalar(radius * (.035 + i*.011) * sinTowerSignedRand(seed+10+i));
    const p0 = root.clone().add(lane).addScaledVector(dir, radius * (.010 + sinTowerRand(seed+20+i)*.028));
    const p1 = p0.clone().lerp(aim, .22).addScaledVector(side, radius * (.24 + sinTowerRand(seed+30+i)*.24) * sinTowerSignedRand(seed+31+i)).add(new THREE.Vector3(0, radius * (.10 + sinTowerRand(seed+32+i)*.15), 0));
    const p2 = p0.clone().lerp(aim, .48).addScaledVector(side, radius * (.18 + sinTowerRand(seed+40+i)*.14) * sinTowerSignedRand(seed+41+i)).add(new THREE.Vector3(0, radius * (.06 + sinTowerRand(seed+42+i)*.10), 0));
    const p3 = p0.clone().lerp(aim, .74).addScaledVector(side, radius * (.10 + sinTowerRand(seed+44+i)*.10) * sinTowerSignedRand(seed+45+i));
    const p4 = aim.clone().addScaledVector(side, radius * .035 * sinTowerSignedRand(seed+50+i));
    const w = radius * (.014 + sinTowerRand(seed+60+i)*.012);
    pushRibbon(p0,p1,c0,c1,w*1.30,w*1.05);
    pushRibbon(p1,p2,c1,c2,w*1.00,w*.72);
    pushRibbon(p2,p3,c2,c3,w*.72,w*.48);
    pushRibbon(p3,p4,c3,c3,w*.48,w*.28);
    const branchCount = 1 + Math.floor(sinTowerRand(seed+70+i) * 4);
    for(let b=0;b<branchCount;b++){
      const base = [p1,p2,p3][Math.min(2, Math.floor(sinTowerRand(seed+71+i*7+b)*3))].clone();
      const branchDir = side.clone().multiplyScalar(sinTowerSignedRand(seed+72+i*7+b)).add(new THREE.Vector3(0,.45 + sinTowerRand(seed+73+i*7+b)*.42,0)).addScaledVector(dir, .25 + sinTowerRand(seed+74+i*7+b)*.35).normalize();
      const b1 = base.clone().addScaledVector(branchDir, radius * (.11 + sinTowerRand(seed+75+i*7+b)*.12));
      const b2 = base.clone().addScaledVector(branchDir, radius * (.22 + sinTowerRand(seed+76+i*7+b)*.18));
      const bw = radius * (.006 + sinTowerRand(seed+77+i*7+b)*.005);
      pushRibbon(base,b1,c1,c2,bw,bw*.65);
      pushRibbon(b1,b2,c2,c3,bw*.65,bw*.30);
    }
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(positions), 3));
  geo.setAttribute('color', new THREE.BufferAttribute(new Float32Array(colors), 3));
  geo.computeVertexNormals();
  const mat = getSinTowerInfectionMaterials().vascularRibbonMaterial;
  const mesh = new THREE.Mesh(geo, mat);
  mesh.name = '斷罪塔｜明顯漸層血管薄膜';
  mesh.castShadow = false;
  mesh.receiveShadow = false;
  pivot.add(mesh);
}

function addSinTowerBlinkEye(parent, position, radius, seed){
  radius = clamp(safeFinite(radius,.035), .003, .16);
  const mats = getSinTowerInfectionMaterials();
  const eyeMul = getSinTowerTumorParams().eyeScale;
  const pivot = new THREE.Group();
  pivot.position.copy(position);
  pivot.userData.sinTowerEye = true;
  const eye = new THREE.Mesh(getSinTowerCachedEyeGeometry(), mats.eyeMaterial);
  eye.scale.set(radius*1.15*eyeMul, radius*.78*eyeMul, radius*.52*eyeMul);
  eye.castShadow = false;
  eye.receiveShadow = false;
  pivot.add(eye);
  const pupil = addSinTowerComplexPupil(pivot, radius, seed+200, eyeMul, radius*.58*eyeMul);
  const blinkMul = getSinTowerTumorParams().eyeBlinkFreq;
  pivot.userData.blink = {mesh:eye,pupil,baseScale:eye.scale.clone(),pupilBase:pupil.scale.clone(),speed:(1.3+sinTowerRand(seed+2)*1.6)*blinkMul,phase:sinTowerRand(seed+3)*Math.PI*2,interval:Math.max(.55,(1.8+sinTowerRand(seed+4)*2.4)/blinkMul)};
  parent.add(pivot);
  SIN_TOWER_INFECTION.eyes.push(pivot);
  return pivot;
}

function addSinTowerRaisedEyeOnTumor(tumor, radius, seed, eyeMul){
  radius = clamp(safeFinite(radius,.035), .003, .16);
  const mats = getSinTowerInfectionMaterials();
  const a = sinTowerRand(seed+17) * Math.PI * 2;
  const u = THREE.MathUtils.lerp(-.24,.58, sinTowerRand(seed+19));
  const ss = Math.sqrt(Math.max(0, 1-u*u));
  const n = new THREE.Vector3(Math.cos(a)*ss, u, Math.sin(a)*ss).normalize();
  const pivot = new THREE.Group();
  pivot.name = '半浮雕凸起腫瘤眼睛';
  pivot.userData.sinTowerEye = true;
  pivot.position.copy(n).multiplyScalar(radius * 1.04);
  pivot.quaternion.setFromUnitVectors(new THREE.Vector3(0,0,1), n);

  const rim = new THREE.Mesh(getSinTowerCachedEyeGeometry(), mats.eyeRimMaterial || mats.darkTumorMaterial);
  const sc = radius * (.36 + sinTowerRand(seed+21)*.10) * eyeMul;
  rim.scale.set(sc*1.32, sc*1.02, sc*.34);
  rim.position.z = radius * .035;
  rim.castShadow = false;
  rim.receiveShadow = false;
  pivot.add(rim);

  const eyeball = new THREE.Mesh(getSinTowerCachedEyeGeometry(), mats.eyeMaterial);
  eyeball.name = '凸起藍白眼球';
  eyeball.scale.set(sc*.92, sc*.86, sc*.48);
  eyeball.position.z = radius * .095;
  eyeball.castShadow = false;
  eyeball.receiveShadow = false;
  pivot.add(eyeball);

  const iris = new THREE.Mesh(getSinTowerPupilOverlayGeometry(), getSinTowerPupilOverlayMaterial());
  iris.name = '黑色圓形瞳孔虹膜凹陷貼片';
  const irisS = sc * .82;
  iris.scale.set(irisS, irisS, 1);
  iris.position.z = radius * .095 + sc*.49 + .002;
  iris.renderOrder = 7;
  pivot.add(iris);

  tumor.add(pivot);
  const blinkMul = getSinTowerTumorParams().eyeBlinkFreq;
  pivot.userData.blink = {mesh:eyeball,pupil:iris,baseScale:eyeball.scale.clone(),pupilBase:iris.scale.clone(),speed:(1.0+sinTowerRand(seed+2)*1.2)*blinkMul,phase:sinTowerRand(seed+3)*Math.PI*2,interval:Math.max(.65,(2.4+sinTowerRand(seed+4)*2.6)/blinkMul)};
  SIN_TOWER_INFECTION.eyes.push(pivot);
  return pivot;
}

function addSinTowerSurfaceBlinkEyes(tumor, radius, seed, count=1){
  radius = clamp(safeFinite(radius,.035), .003, .16);
  // v28：眼睛不再是貼在腫瘤上的扁平橢圓。改成肉紅眼眶＋凸起眼球＋正圓黑瞳孔貼片的半浮雕結構。
  const eyeMul = getSinTowerTumorParams().eyeScale;
  const visibleCount = Math.min(count, radius > .14 ? 2 : 1);
  for(let i=0;i<visibleCount;i++) addSinTowerRaisedEyeOnTumor(tumor, radius, seed+i*101, eyeMul);
}

function buildSinTowerTumorOnSpine(att, radiusWorld, seed, progress, micro=false){
  att.pivot.userData.surfaceNormal ||= att.normal.clone();
  const mats = getSinTowerInfectionMaterials();
  const radiusWorldSafe = clampSinTowerTumorRadiusForFinalScale(radiusWorld, micro);
  const radius = radiusWorldSafe * att.unit;
  if(att?.pivot?.userData) att.pivot.userData.sinTowerUnit = att.unit;
  const sizeTier = getSinTowerTumorSizeTier(seed);
  const isWrapTumor = att?.zone?.name === 'meatball_wrap' || att?.zone?.name === 'body_cover_true_tumor' || att?.zone?.name === 'surface_progress_tumor';
  const tumor = new THREE.Group();
  const tumorCore = new THREE.Mesh(
    makeSinTowerTumorGeometry(radius, seed, clamp(progress*.85 + radiusWorld*2.4, .35, 1.4)),
    getSinTowerTumorMaterial(seed, micro)
  );
  tumorCore.name = '斷罪塔｜腫瘤核心批次來源';
  tumorCore.castShadow = false;
  tumorCore.receiveShadow = false;
  tumorCore.userData.sinTowerTumorCore = true;
  tumorCore.scale.setScalar(radius);
  tumor.add(tumorCore);
  tumor.name = `斷罪塔｜${isWrapTumor ? '包覆真實' : sizeTier + '級'}多紅色腫瘤`;
  tumor.userData.sizeTier = sizeTier;
  tumor.userData.isSinTowerTumor = true;
  tumor.userData.sinTowerTumorCore = tumorCore;
  tumor.userData.seed = seed;
  tumor.userData.sinTowerWorldRadius = radiusWorldSafe;
  const n = att.normal.clone().normalize();
  // v29：恢復真正建立腫瘤的函式。v28 的 buildSinTowerTumorOnSpine 被誤刪，導致每次感染只呼叫到不存在的函式，腫瘤完全無法生成。
  // 非肉球階段：仍依附骨架／上一層 pivot 生長；肉球階段：pivot 放在外殼內側，腫瘤向外突出並互相壓疊，不會變成一顆光滑大球。
  const shellLayerSafe = clampSinTowerShellLayer(att?.shellLayer || 0);
  const protrude = isWrapTumor ? radius * (.18 + sinTowerRand(seed+2)*.08 + shellLayerSafe * .045) : radius * (.30 + sizeTier * .018 + sinTowerRand(seed+2)*.12);
  tumor.position.copy(n.clone().multiplyScalar(protrude));
  if(!isWrapTumor) tumor.position.y += radius * (.16 + progress*.24 + sizeTier*.020);
  tumor.rotation.set(sinTowerRand(seed+4)*Math.PI, sinTowerRand(seed+5)*Math.PI, sinTowerRand(seed+6)*Math.PI);
  if(isWrapTumor){
    tumor.scale.set(
      .82 + sinTowerRand(seed+7)*.16,
      .68 + sinTowerRand(seed+8)*.18,
      .82 + sinTowerRand(seed+9)*.16
    );
  }else{
    // v76：讓輸入的 X-Y 尺寸真正反映到可見大小；不再把幾何半徑再縮成一半。
    tumor.scale.set(
      .86 + sinTowerRand(seed+7)*.14,
      .62 + sinTowerRand(seed+8)*.24,
      .86 + sinTowerRand(seed+9)*.14
    );
  }
  // 感染細節保留完整幾何與材質，但不加入即時陰影 pass；陰影會讓每顆腫瘤再繪製一次。
  tumor.castShadow = false;
  tumor.receiveShadow = false;
  const detailBucket = Math.abs(Math.floor(seed || 0)) % 12;
  if(detailBucket % 3 === 0) addSinTowerBurnWrinkles(tumor, radius, seed+300, micro ? .38 : .82);
  att.pivot.add(tumor);
  if(SIN_TOWER_INFECTION.rollVisualRoot) SIN_TOWER_INFECTION.rollVisualRoot.userData.lastSpinCollect = 0;
  if(detailBucket % 4 === 0) addSinTowerFungus(tumor, att, radiusWorldSafe, seed+520, progress, micro ? .45 : .72);
  else if(detailBucket % 4 === 1) queueSinTowerFungusDots(tumor, radius, seed+700, progress, micro ? .52 : .78);
  if(!micro && detailBucket % 6 === 0) queueSinTowerBuildJob({type:'vascular', att, targetPos:tumor.position.clone(), radius, seed:seed+880, countMul:.72});
  if(!micro && detailBucket % 8 === 0) queueSinTowerBuildJob({type:'tumorEyes', tumor, radius, seed:seed+620, count:1});
  const droop = isWrapTumor ? radiusWorld * .02 : radiusWorld*(.18+progress*.30+sizeTier*.012);
  registerSinTowerTumorCore(tumorCore);
  registerSinTowerAttachmentNode(att.pivot, att.host, seed, att.baseLocal, new THREE.Vector3(1,1,1), droop);
  placeSinTowerMorphologyRoot(att.pivot);
}

function addSinTowerHoneycombEnd(parent, localPos, radiusLocal, seed){
  // v75：復原觸手端部，但做成受控的小蜂巢瘤，不再讓缺失函式中斷建立流程。
  if(!parent) return null;
  const unit = getSinTowerStableAttachmentUnit({unit:1}, parent);
  const maxLocal = clampSinTowerLocalRadiusByWorldLimit(.20 * unit, unit, false, .72);
  const r = clamp(safeFinite(radiusLocal,.025), .004 * unit, Math.max(.006 * unit, maxLocal));
  const group = new THREE.Group();
  group.name = '斷罪塔｜受控蜂巢觸手端';
  group.position.copy(localPos || new THREE.Vector3());
  group.userData.isSinTowerControlledGrowth = true;
  group.userData.isSinTowerTumor = true;
  const mats = getSinTowerInfectionMaterials();
  const coreRadius = r * .62;
  const core = new THREE.Mesh(makeSinTowerTumorGeometry(coreRadius, seed+3, .55), mats.honeycombMaterial || getSinTowerTentacleMaterial(seed));
  core.scale.set(coreRadius, coreRadius * .74, coreRadius);
  core.castShadow = false;
  core.receiveShadow = false;
  group.add(core);
  registerSinTowerTumorCore(core);
  const holes = 5 + Math.floor(sinTowerRand(seed+4) * 4);
  for(let i=0;i<holes;i++){
    const a = i / holes * Math.PI * 2 + sinTowerRand(seed+10) * .35;
    const y = sinTowerSignedRand(seed+20+i) * r * .20;
    const dot = new THREE.Mesh(getSinTowerCachedHoneycombHoleGeometry(), mats.wrinkleMaterial || mats.honeycombMaterial);
    dot.name = '受控蜂巢孔';
    dot.scale.setScalar(clamp(r * (.22 + sinTowerRand(seed+30+i) * .12), .002 * unit, r * .34));
    dot.position.set(Math.cos(a) * r * .45, y, Math.sin(a) * r * .45);
    dot.castShadow = false;
    dot.receiveShadow = false;
    group.add(dot);
  }
  parent.add(group);
  return group;
}

function queueSinTowerTentacleTriplet(att,length,thickness,seed,progress){
  for(let i=0;i<3;i++) queueSinTowerBuildJob({type:'buildTentacle',att,length:length*(.91+sinTowerRand(seed+i*43)*.18),thickness:thickness*(.92+sinTowerRand(seed+i*47)*.16),seed:seed+i*1009,progress});
  return 3;
}

function buildSinTowerTentacleTriplet(att,length,thickness,seed,progress){
  for(let i=0;i<3;i++) buildSinTowerTentacleOnSpine(att,length*(.91+sinTowerRand(seed+i*43)*.18),thickness*(.92+sinTowerRand(seed+i*47)*.16),seed+i*1009,progress);
}

function buildSinTowerTentacleOnSpine(att, lengthWorld, thicknessWorld, seed, progress){
  att.pivot.userData.surfaceNormal ||= att.normal.clone();
  const unit = Math.max(.001, safeFinite(att?.unit, 1));
  if(att?.pivot?.userData) att.pivot.userData.sinTowerUnit = unit;
  const tp = getSinTowerTumorParams();
  const variant = Math.abs(Math.floor(seed || 0)) % 5;
  const lenWorld = clampSinTowerTentacleLengthWorld(lengthWorld * [1.0,1.28,1.12,1.22,1.16][variant] * tp.tentacleLengthMul);
  const len = lenWorld * unit;
  const thickRand = THREE.MathUtils.lerp(tp.tentacleThickMin, tp.tentacleThickMax, sinTowerRand(seed+778));
  const thickWorld = clampSinTowerTentacleTubeRadiusWorld(Math.max(thicknessWorld * thickRand, .014));
  const thick = thickWorld * unit;
  const sphereY = sinTowerSignedRand(seed+40);
  const sphereA = sinTowerRand(seed+41) * Math.PI * 2;
  const sphereR = Math.sqrt(Math.max(0,1-sphereY*sphereY));
  const sphereDir = new THREE.Vector3(Math.cos(sphereA)*sphereR,sphereY,Math.sin(sphereA)*sphereR);
  const dir = att.normal.clone().multiplyScalar(.95).addScaledVector(sphereDir,.32).normalize();
  const reference = Math.abs(dir.y) < .88 ? new THREE.Vector3(0,1,0) : new THREE.Vector3(1,0,0);
  const side = new THREE.Vector3().crossVectors(dir,reference).normalize();
  const bend = new THREE.Vector3().crossVectors(side,dir).normalize();
  const curl = .12 + sinTowerRand(seed+10)*.26;
  const p0 = dir.clone().multiplyScalar(thick*.65);
  const p1 = p0.clone().addScaledVector(dir,len*.30).addScaledVector(side,len*.15*sinTowerSignedRand(seed+4)).addScaledVector(bend,len*.10*sinTowerSignedRand(seed+14));
  const p2 = p0.clone().addScaledVector(dir,len*.66).addScaledVector(side,len*(.16+curl)*sinTowerSignedRand(seed+5)).addScaledVector(bend,len*.18*sinTowerSignedRand(seed+15));
  const p3 = p0.clone().addScaledVector(dir,len*(variant===0?.84:1.0)).addScaledVector(side,len*.22*sinTowerSignedRand(seed+6)).addScaledVector(bend,len*.24*sinTowerSignedRand(seed+16));
  const curve = new THREE.CatmullRomCurve3([p0,p1,p2,p3]);
  att.pivot.userData.motionProfile = 'tentacle';

  const tube = new THREE.Mesh(new THREE.TubeGeometry(curve, 16, thick, 6, false), getSinTowerTentacleMaterial(seed+130));
  tube.name = '斷罪塔｜低成本單網格觸手';
  tube.userData.isSinTowerControlledGrowth = true;
  tube.userData.motionProfile = 'tentacle';
  const endDirection = p3.clone().normalize();
  tube.userData.sinTowerTentacleDirection = {x:endDirection.x,y:endDirection.y,z:endDirection.z};
  tube.castShadow = false;
  tube.receiveShadow = false;
  att.pivot.add(tube);

  const bulbRadius = clamp(thick * (1.45 + sinTowerRand(seed+8)*.45), .006 * unit, clampSinTowerLocalRadiusByWorldLimit(.16 * unit, unit, false, .82));
  const bulb = new THREE.Mesh(makeSinTowerTumorGeometry(bulbRadius, seed+8, .85), getSinTowerTumorMaterial(seed+8, false));
  bulb.name = '斷罪塔｜觸手端瘤';
  bulb.position.copy(p3);
  bulb.scale.set(bulbRadius, bulbRadius*.78, bulbRadius);
  bulb.userData.isSinTowerTumor = true;
  bulb.userData.isSinTowerControlledGrowth = true;
  bulb.userData.motionProfile = 'tentacle';
  bulb.castShadow = false;
  bulb.receiveShadow = false;
  att.pivot.add(bulb);
  registerSinTowerTumorCore(bulb);
  if((Math.abs(Math.floor(seed)) % 4) === 0) addSinTowerBlinkEye(att.pivot, p3.clone().add(new THREE.Vector3(0,bulbRadius*.18,0)), bulbRadius*.18, seed+622);
  registerSinTowerAttachmentNode(att.pivot, att.host, seed, att.baseLocal, new THREE.Vector3(1,1,1), lenWorld*.015);
  placeSinTowerMorphologyRoot(att.pivot);
}

function getSinTowerInfectionProgress(level){
  // v41：感染視覺進度改用「肉球滾動門檻」計算，不再用 maxLevel=12。
  // 這會避免第 5 / 6 次吸收就進入偏後期尺寸，突然長出粗糙大球。
  const threshold = Math.max(20, getSinTowerTumorParams().meatballLevel || 20);
  return clamp(level / threshold, 0, 1);
}

// v31：不要再覆寫前面的肉球進度函式。肉球進度必須從門檻的一半開始，
// 例如門檻 20 次時，第 10～20 次由真實小腫瘤逐步堆出球團。

function addSinTowerMeatballWrapStage(level){
  // v32：這個名字保留給既有呼叫，但內容改成「真實腫瘤包覆階段」。
  // 不建立合併球、不建立 InstancedMesh 外殼、不把腫瘤搬進單獨球體 group。
  const params = getSinTowerTumorParams();
  const coverP = getSinTowerMeatballProgress(level);
  if(coverP <= 0) return;
  const threshold = Math.max(1, params.meatballLevel);
  const catchUp = level >= threshold ? 1.85 : 1.0;
  // 用很多顆小腫瘤補覆，不再用少數大腫瘤撐成球。上限避免單次按鍵卡死。
  const coverCount = Math.min(72, Math.max(12, Math.floor((16 + coverP * 38) * params.batchMul * catchUp)));
  for(let i=0;i<coverCount;i++){
    const seed = 12000 + level*307 + i*41;
    const att = makeSinTowerBodyCoverAttachment(level, i, coverCount, coverP, seed);
    const micro = (i % 9 === 0 && coverP < .92);
    const r = getSinTowerCoverTumorRadiusWorld(seed, coverP, micro);
    buildSinTowerTumorOnSpine(att, r, seed, Math.max(.70, coverP), micro);
    if(i % 5 === 0){
      const len = (.34 + sinTowerRand(seed+4)*.72) * (1 + coverP*.70);
      const th = (.020 + sinTowerRand(seed+5)*.042) * (1 + coverP*.45);
      buildSinTowerTentacleTriplet(att,len,th,seed+6,Math.max(.70,coverP));
    }
    // 用真實血管薄膜把相鄰肉球黏起來，不用合併 geometry。
    const anchors = SIN_TOWER_INFECTION.surfaceAnchors || (SIN_TOWER_INFECTION.surfaceAnchors = []);
    const pLocal = att.baseLocal.clone();
    if(anchors.length){
      let best = anchors[anchors.length-1];
      let bestD = pLocal.distanceToSquared(best);
      for(let k=Math.max(0, anchors.length-28); k<anchors.length; k++){
        const d = pLocal.distanceToSquared(anchors[k]);
        if(d < bestD){ bestD = d; best = anchors[k]; }
      }
      // v35：取消包覆腫瘤之間的橋接薄膜，避免視覺上又融合成一整顆低面數大球。
    }
    anchors.push(pLocal.clone());
    if(anchors.length > 420) anchors.splice(0, anchors.length - 420);
  }
}

function addSinTowerInfectionStage(level){
  if(!playerGroup) return;
  const p = getSinTowerInfectionProgress(level);
  const params = getSinTowerTumorParams();
  const startLevel = getSinTowerMeatballStartLevel();
  const coverStage = level >= startLevel;
  updateSinTowerActorInfectionVisibility();

  if(!coverStage){
    const batch = params.batchMul;
    const tumorCount = Math.max(1,Math.floor((1.2 + p) * batch));
    const microCount = Math.max(2,Math.floor((2.4 + p * 2) * batch));
    const tentacleCount = Math.max(0,Math.floor((.4 + p) * Math.sqrt(batch))) * 3;
    for(let i=0;i<tumorCount;i++){
      const seed = SIN_TOWER_INFECTION.growthSeed + 1000 + level * 173 + i * 19;
      const att = makeSinTowerSpineAttachment(pickSinTowerSpineZone(seed,p),seed);
      queueSinTowerBuildJob({type:'buildTumor',att,radius:getSinTowerTumorRadiusWorld(seed,p,false),seed,progress:p,micro:false});
    }
    for(let i=0;i<microCount;i++){
      const seed = SIN_TOWER_INFECTION.growthSeed + 3000 + level * 211 + i * 23;
      const att = makeSinTowerSpineAttachment(pickSinTowerSpineZone(seed,p),seed);
      queueSinTowerBuildJob({type:'buildTumor',att,radius:getSinTowerTumorRadiusWorld(seed,p,true),seed,progress:p,micro:true});
    }
    for(let i=0;i<tentacleCount;i++){
      const seed = SIN_TOWER_INFECTION.growthSeed + 5000 + level * 257 + i * 29;
      const att = makeSinTowerSpineAttachment(pickSinTowerSpineZone(seed,p),seed);
      queueSinTowerBuildJob({type:'buildTentacle',att,length:(.22 + sinTowerRand(seed+2)*.42)*(1+p*.68),thickness:(.012 + sinTowerRand(seed+3)*.022)*(1+p*.30),seed,progress:p});
    }
  }else{
    // Each hit adds one bounded outer layer. Keeping the previous layer intact
    // avoids the visible reset and also caps per-hit work for smooth gameplay.
    const wrapP = getSinTowerMeatballProgress(level);
    const bodyBatch = Math.min(18,Math.max(8,Math.floor((5 + wrapP * 7) * Math.sqrt(Math.max(.5,params.batchMul)))));
    for(let i=0;i<bodyBatch;i++){
      const seed = SIN_TOWER_INFECTION.growthSeed + 8000 + level * 113 + i * 37;
      const att = makeSinTowerBodyCoverAttachment(level,i,bodyBatch,wrapP,seed);
      const micro = i % 5 === 0 && wrapP < .96;
      queueSinTowerBuildJob({type:'buildTumor',att,radius:getSinTowerCoverTumorRadiusWorld(seed,wrapP,micro),seed,progress:Math.max(.75,wrapP),micro});
      if(i % 5 === 0){
        queueSinTowerTentacleTriplet(att,(.32 + sinTowerRand(seed+4)*.62)*(1+wrapP*.70),(.018 + sinTowerRand(seed+5)*.030)*(1+wrapP*.30),seed+6,Math.max(.72,wrapP));
      }
    }
  }
  SIN_TOWER_INFECTION.needsUnsafeCleanup = true;
  applyActorSettings();
}

function rebuildSinTowerInfectionVisual(){
  const level = Math.max(0, Math.floor(SIN_TOWER_INFECTION.level || 0));
  if(level <= 0){
    resetSinTowerInfectionCachesForRebuild();
    clearSinTowerInfectionAttachments();
    updateSinTowerActorInfectionVisibility();
    applyActorSettings();
    return;
  }
  rebuildSinTowerInfectionCoverFromScratch(level);
}

function updateSinTowerActorInfectionVisibility(){
  // v32：不生成、不中途顯示任何合併肉球 group。
  // 角色必須靠真實腫瘤逐步蓋住；到達門檻後仍保留骨架腫瘤，只讓整組外觀滾動。
  ensureSinTowerMeatballGroup();
  if(actorModel) actorModel.visible = true;
  if(actorProxy) actorProxy.visible = !actorModel;
  updateSinTowerMeatballTransform(0, .016, true);
}

function resetSinTowerConsumedQuestionObjects(){
  cancelSinTowerRpsBlinks();
  for(const effect of sinTowerPlayObjectUi.dissolves||[]){
    effect.points?.parent?.remove(effect.points);effect.points?.geometry?.dispose?.();effect.points?.material?.dispose?.();
    for(const record of effect.materialRecords||[]){record.material.opacity=record.opacity;record.material.transparent=record.transparent;record.material.depthWrite=record.depthWrite;record.material.needsUpdate=true;}
  }
  sinTowerPlayObjectUi.dissolves=[];
  for(const object of [...SIN_TOWER_EDITOR.props,...SIN_TOWER_EDITOR.models]){
    const interaction=object?.interaction;
    if(!interaction||!['question','rps'].includes(interaction.type)||(!interaction.consumed&&!interaction.dissolving&&interaction.glowEnabledBeforeDissolve===undefined))continue;
    interaction.consumed=false;interaction.dissolving=false;interaction.answers=[];
    interaction.glowEnabled=interaction.glowEnabledBeforeDissolve===undefined?true:interaction.glowEnabledBeforeDissolve;
    delete interaction.glowEnabledBeforeDissolve;
    const modelRec=sinTowerEditorRuntime.models.get(object.id),propRec=sinTowerEditorRuntime.props.get(object.id);
    if(modelRec){modelRec.group.visible=true;modelRec.model=object;syncSinTowerModelInteractiveFx(modelRec);}
    if(propRec){propRec.root.visible=true;propRec.prop=object;for(const visual of propRec.visuals||[]){visual.group.visible=true;setSinTowerPropVisualGlowEnabled(visual,object,interaction.glowEnabled!==false);}}
  }
  sinTowerPlayObjectUi.dismissedPropId=null;sinTowerPlayObjectUi.dismissedWorldPosition=null;
  scheduleSinTowerRuntimeSave();
}

function newSinTowerGrowthSeed(){
  const bytes=new Uint32Array(1);crypto.getRandomValues(bytes);return 1+(bytes[0]%10000000);
}
function sanitizeSinTowerInfectionEffect(raw){
  return {enabled:raw?.enabled===true,direction:raw?.direction==='remove'?'remove':'add',layers:clamp(Math.floor(safeFinite(raw?.layers,1)),1,1000)};
}
function changeSinTowerInfectionLayers(delta){
  const inf=SIN_TOWER_INFECTION,current=Math.max(0,Math.floor(inf.level||0));
  const threshold=Math.max(1,Math.floor(getSinTowerTumorParams().meatballLevel||20));
  const target=clamp(current+Math.trunc(delta),0,threshold);
  if(target===current)return 0;
  if(target>current){for(let level=current+1;level<=target;level++){inf.level=level;addSinTowerInfectionStage(level);}}
  else{
    inf.level=target;
    if(!target){clearSinTowerInfectionAttachments();}
    else{
      const removed=new Set((inf.ownedRoots||[]).filter(root=>root.userData.infectionLayer>target));
      const belongs=node=>{for(let p=node;p;p=p.parent)if(removed.has(p))return true;return false;};
      inf.detailQueue=(inf.detailQueue||[]).filter(job=>!belongs(job.att?.pivot||job.tumor));
      inf.attachments=(inf.attachments||[]).filter(rec=>!belongs(rec.node));
      inf.dynamicAttachments=(inf.dynamicAttachments||[]).filter(rec=>!belongs(rec.node));
      inf.eyes=(inf.eyes||[]).filter(node=>!belongs(node));
      inf.tumorBatchEntries=(inf.tumorBatchEntries||[]).filter(entry=>!belongs(entry.core));
      for(const batch of inf.tumorBatches.values())batch.count=0;
      for(const entry of inf.tumorBatchEntries){if(entry.batch){entry.slot=entry.batch.count++;entry.batch.setMatrixAt(entry.slot,entry.core.matrixWorld);}}
      for(const batch of inf.tumorBatches.values())batch.instanceMatrix.needsUpdate=true;
      inf.ownedRoots=inf.ownedRoots.filter(root=>!removed.has(root));
      for(const root of removed){root.parent?.remove(root);inf.disposeQueue.push(root);}
      inf.rebuildState=null;inf.pendingRebuildLevel=0;
    }
    inf.rollFixedScale=null;ensureSinTowerRollVisualRoot(false);
  }
  inf.stageStart=performance.now();inf.colorLayerRevision=safeFinite(inf.colorLayerRevision,0)+1;
  updateSinTowerActorInfectionVisibility();applyActorSettings();
  return target-current;
}
function applySinTowerInteractionInfectionEffect(){
  const session=sinTowerPlayObjectUi.resultSession;
  if(!session||session.preview||session.applied)return;
  session.applied=true;
  const effect=sanitizeSinTowerInfectionEffect(session.object?.interaction?.infectionEffect);
  if(!effect.enabled)return;
  const delta=changeSinTowerInfectionLayers(effect.direction==='remove'?-effect.layers:effect.layers);
  setStatus('互動結果：'+(delta>=0?'增加 ':'減少 ')+Math.abs(delta)+' 層腫瘤；目前 '+SIN_TOWER_INFECTION.level+' 層。');
}

function resetSinTowerInfection(){
  SIN_TOWER_INFECTION.growthSeed=newSinTowerGrowthSeed();
  setSinTowerInfectionShadowFreeze(false);
  ensureSinTowerRollVisualRoot(false);
  SIN_TOWER_INFECTION.rollFixedScale = null;
  SIN_TOWER_INFECTION.level = 0;
  SIN_TOWER_INFECTION.lastHitAt = 0;
  SIN_TOWER_INFECTION.stageStart = performance.now();
  SIN_TOWER_INFECTION.hasLastPlayerPos = false;
  SIN_TOWER_INFECTION.walkSway = 0;
  clearSinTowerInfectionAttachments();
  resetSinTowerConsumedQuestionObjects();
  updateSinTowerActorInfectionVisibility();
  applyActorSettings();
}

function debugIncreaseSinTowerInfectionByShortcut(){
  // Shift+1 測試用：不經碰撞冷卻，每按一次一定新增一層感染。
  SIN_TOWER_INFECTION.lastHitAt = -Infinity;
  increaseSinTowerInfection();
}

function increaseSinTowerInfection(){
  const now = performance.now();
  if(now - SIN_TOWER_INFECTION.lastHitAt < 260) return;
  SIN_TOWER_INFECTION.lastHitAt = now;
  SIN_TOWER_INFECTION.stageStart = now;
  const threshold = Math.max(1, Math.floor(getSinTowerTumorParams().meatballLevel || 20));
  const current = Math.max(0, Math.floor(SIN_TOWER_INFECTION.level || 0));
  // v69：進入肉球滾動後，外形鎖定；後續撞擊不再新增腫瘤、不再重建滾動中心。
  if(current >= threshold){
    SIN_TOWER_INFECTION.level = threshold;
    setStatus(`肉球滾動中：外形已固定，不再新增腫瘤。按 R 重置。`);
    return;
  }
  SIN_TOWER_INFECTION.level = Math.min(threshold, current + 1);
  addSinTowerInfectionStage(SIN_TOWER_INFECTION.level);
  const level = SIN_TOWER_INFECTION.level;
  if(level >= threshold){
    setStatus(`撞到跪地僧侶：肉球外形已固定，開始穩定滾動。按 R 重置。`);
  }else if(level >= SIN_TOWER_INFECTION.maxLevel){
    setStatus(`撞到跪地僧侶：感染已超過完全期，第 ${level} 層。按 R 重置。`);
  }else{
    setStatus(`撞到跪地僧侶：感染分幀蔓延 ${level}/${SIN_TOWER_INFECTION.maxLevel}。`);
  }
}

function getSinTowerFireParams(){
  const p = SIN_TOWER_FIRE_FX.params || (SIN_TOWER_FIRE_FX.params = {});
  return {
    particleSize:clamp(safeFinite(p.particleSize,.075), .01, .28),
    particleCount:Math.round(clamp(safeFinite(p.particleCount,360), 30, 1800)),
    shape:['column','cone','sphere','burst'].includes(p.shape) ? p.shape : 'column',
    colorA:validColor(p.colorA) ? p.colorA : '#fff27a',
    colorB:validColor(p.colorB) ? p.colorB : '#ff5a00',
    colorC:validColor(p.colorC) ? p.colorC : '#7b001e',
    radius:clamp(safeFinite(p.radius,.72), .15, 2.8),
    height:clamp(safeFinite(p.height,2.3), .4, 5.5),
    swirl:clamp(safeFinite(p.swirl,1.05), 0, 4),
    duration:clamp(safeFinite(p.duration,1.5), .3, 4)
  };
}

function getSinTowerFireParticleTexture(){
  if(SIN_TOWER_FIRE_FX.texture) return SIN_TOWER_FIRE_FX.texture;
  const size = 96;
  const canvas = document.createElement('canvas');
  canvas.width = canvas.height = size;
  const ctx = canvas.getContext('2d');
  const g = ctx.createRadialGradient(size*.5,size*.5,0,size*.5,size*.5,size*.48);
  g.addColorStop(0,'rgba(255,255,255,1)');
  g.addColorStop(.22,'rgba(255,236,120,.90)');
  g.addColorStop(.52,'rgba(255,78,0,.42)');
  g.addColorStop(1,'rgba(255,0,0,0)');
  ctx.fillStyle = g;
  ctx.fillRect(0,0,size,size);
  const tex = new THREE.CanvasTexture(canvas);
  tex.colorSpace = THREE.SRGBColorSpace;
  SIN_TOWER_FIRE_FX.texture = tex;
  return tex;
}

function triggerSinTowerFireFx(){
  if(!scene || !playerGroup) return;
  const fp = getSinTowerFireParams();
  const count = fp.particleCount;
  const positions = new Float32Array(count * 3);
  const colors = new Float32Array(count * 3);
  const velocities = new Float32Array(count * 3);
  const sizes = new Float32Array(count);
  const cA = new THREE.Color(fp.colorA), cB = new THREE.Color(fp.colorB), cC = new THREE.Color(fp.colorC);
  const center = playerGroup.position.clone().add(new THREE.Vector3(0,.85,0));
  for(let i=0;i<count;i++){
    const seed = performance.now() * .01 + i * 91.7;
    const a = sinTowerRand(seed+1) * Math.PI * 2;
    const h = sinTowerRand(seed+2);
    const radialBase = fp.shape === 'cone' ? (1-h) : fp.shape === 'sphere' ? Math.sin(h*Math.PI) : fp.shape === 'burst' ? 1 : (.34 + h*.55);
    const r = fp.radius * radialBase * Math.sqrt(sinTowerRand(seed+3));
    let y = (h - .42) * fp.height;
    if(fp.shape === 'burst') y = sinTowerSignedRand(seed+4) * fp.height * .35;
    positions[i*3] = center.x + Math.cos(a) * r;
    positions[i*3+1] = center.y + y;
    positions[i*3+2] = center.z + Math.sin(a) * r;
    const up = .85 + sinTowerRand(seed+5) * 1.9;
    const out = .25 + sinTowerRand(seed+6) * (fp.shape === 'burst' ? 2.0 : .85);
    velocities[i*3] = Math.cos(a + Math.PI*.5) * fp.swirl * .22 + Math.cos(a) * out;
    velocities[i*3+1] = up + h * .8;
    velocities[i*3+2] = Math.sin(a + Math.PI*.5) * fp.swirl * .22 + Math.sin(a) * out;
    const col = h < .33 ? cA.clone().lerp(cB, h/.33) : h < .75 ? cB.clone().lerp(cC, (h-.33)/.42) : cC.clone();
    colors[i*3] = col.r; colors[i*3+1] = col.g; colors[i*3+2] = col.b;
    sizes[i] = fp.particleSize * (.62 + sinTowerRand(seed+7) * 1.35);
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
  const mat = new THREE.PointsMaterial({
    size:fp.particleSize,
    map:getSinTowerFireParticleTexture(),
    vertexColors:true,
    transparent:true,
    opacity:1,
    blending:THREE.AdditiveBlending,
    depthWrite:false,
    sizeAttenuation:true
  });
  const points = new THREE.Points(geo, mat);
  points.name = '斷罪塔｜撞擊火焰粒子';
  points.userData.fireFx = {age:0,duration:fp.duration,velocities,sizes,baseSize:fp.particleSize,shape:fp.shape,swirl:fp.swirl};
  scene.add(points);
  SIN_TOWER_FIRE_FX.active.push(points);
}

function updateSinTowerFireFx(dt){
  const list = SIN_TOWER_FIRE_FX.active || [];
  for(let k=list.length-1;k>=0;k--){
    const pts = list[k];
    const fx = pts?.userData?.fireFx;
    if(!pts || !fx){ list.splice(k,1); continue; }
    fx.age += dt;
    const t = clamp(fx.age / Math.max(.001, fx.duration), 0, 1);
    const pos = pts.geometry.attributes.position;
    for(let i=0;i<pos.count;i++){
      const j = i*3;
      pos.array[j] += fx.velocities[j] * dt * (1 + t*.55);
      pos.array[j+1] += fx.velocities[j+1] * dt * (1 - t*.35);
      pos.array[j+2] += fx.velocities[j+2] * dt * (1 + t*.55);
      fx.velocities[j+1] += (1.9 - t*3.2) * dt;
      fx.velocities[j] *= (1 - dt*.36);
      fx.velocities[j+2] *= (1 - dt*.36);
    }
    pos.needsUpdate = true;
    pts.material.opacity = Math.pow(1 - t, .72);
    pts.material.size = fx.baseSize * (1 + t*.85);
    if(t >= 1){
      scene.remove(pts);
      pts.geometry?.dispose?.();
      pts.material?.dispose?.();
      list.splice(k,1);
    }
  }
}


function cleanupSinTowerUnsafeGrowth(maxNodes=36){
  // v81：清理器不再每半秒掃整棵感染樹，也不再對每個 mesh 執行昂貴的 setFromObject。
  // 只在重建完成後或低頻補掃時，用 geometry.boundingSphere 快速判斷真正失控的大物件。
  const now = performance.now();
  const force = !!SIN_TOWER_INFECTION.needsUnsafeCleanup;
  if(!force && now - (SIN_TOWER_INFECTION.lastUnsafeCleanupAt || 0) < 2800) return;
  SIN_TOWER_INFECTION.lastUnsafeCleanupAt = now;
  SIN_TOWER_INFECTION.needsUnsafeCleanup = false;
  const roots = [];
  if(SIN_TOWER_INFECTION.group) roots.push(SIN_TOWER_INFECTION.group);
  if(SIN_TOWER_INFECTION.rollVisualRoot) roots.push(SIN_TOWER_INFECTION.rollVisualRoot);
  if(!roots.length) return;
  const range = getSinTowerTumorRangeWorld(false);
  const mainLimit = Math.max(2.8, range.max * 3.8);
  const tentacleLimit = Math.max(4.0, range.max * 7.0);
  const center = playerGroup ? playerGroup.getWorldPosition(new THREE.Vector3()) : (player ? player.position.clone() : new THREE.Vector3());
  const remove = [];
  const worldPos = cleanupSinTowerUnsafeGrowth._pos || (cleanupSinTowerUnsafeGrowth._pos = new THREE.Vector3());
  const worldScale = cleanupSinTowerUnsafeGrowth._scale || (cleanupSinTowerUnsafeGrowth._scale = new THREE.Vector3());
  let visited = 0;
  for(const root of roots){
    root.updateMatrixWorld?.(true);
    root.traverse(obj=>{
      if(visited++ > maxNodes * 10) return;
      if(remove.length >= maxNodes) return;
      if(obj === root || obj.userData?.sinTowerNoUnsafeCleanup) return;
      const name = String(obj.name || '');
      const ud = obj.userData || {};
      const isContainerGroup = obj.isGroup && !ud.isSinTowerTumor && !ud.isSinTowerControlledGrowth && !ud.motionProfile;
      if(isContainerGroup) return;
      const isGrowth = ud.isSinTowerTumor || ud.isSinTowerControlledGrowth || ud.motionProfile === 'tentacle' || /腫瘤|觸手|蜂巢|血管|眼睛|真菌|藻類|tumor|tentacle|honeycomb|fungus/i.test(name);
      if(!isGrowth || !obj.parent || !obj.geometry) return;
      try{
        if(!obj.geometry.boundingSphere) obj.geometry.computeBoundingSphere?.();
        const bs = obj.geometry.boundingSphere;
        if(!bs || !Number.isFinite(bs.radius)) return;
        obj.getWorldPosition(worldPos);
        obj.getWorldScale(worldScale);
        const maxAxis = Math.max(Math.abs(worldScale.x), Math.abs(worldScale.y), Math.abs(worldScale.z), .0001);
        const radius = bs.radius * maxAxis;
        const isTent = ud.motionProfile === 'tentacle' || /觸手|蜂巢|tentacle|honeycomb/i.test(name);
        const limit = isTent ? tentacleLimit : mainLimit;
        const farLimit = Math.max(8.0, limit * 2.8);
        const far = worldPos.distanceTo(center);
        if(radius > limit || far > farLimit){
          let target = obj;
          while(target.parent && target.parent !== root && target.parent.userData?.isSinTowerControlledGrowth){
            target = target.parent;
          }
          remove.push(target);
        }
      }catch(e){ return; }
    });
  }
  const dq = SIN_TOWER_INFECTION.disposeQueue || (SIN_TOWER_INFECTION.disposeQueue = []);
  for(const obj of Array.from(new Set(remove))){
    obj.parent?.remove(obj);
    dq.push(obj);
  }
}

function updateSinTowerInfection(dt){
  const perfStart = performance.now();
  const frameNow = perfStart;
  const t = frameNow * .001;
  setSinTowerInfectionShadowFreeze((SIN_TOWER_INFECTION.level || 0) > 0 && isSinTowerStairSceneActive());
  const safeDt = Math.max(1/240, Math.min(.08, dt || 1/60));
  if((SIN_TOWER_INFECTION.level||0)<=0&&!(SIN_TOWER_INFECTION.dynamicAttachments||[]).length&&!(SIN_TOWER_INFECTION.eyes||[]).length&&!(SIN_TOWER_INFECTION.detailQueue||[]).length&&!SIN_TOWER_INFECTION.rebuildState&&!(SIN_TOWER_INFECTION.disposeQueue||[]).length){SIN_TOWER_INFECTION.lastPlayerPos.copy(player.position);SIN_TOWER_INFECTION.hasLastPlayerPos=true;SIN_TOWER_INFECTION.lastUpdateMs=performance.now()-perfStart;return;}
  if(!SIN_TOWER_INFECTION.hasLastPlayerPos){
    SIN_TOWER_INFECTION.lastPlayerPos.copy(player.position);
    SIN_TOWER_INFECTION.hasLastPlayerPos = true;
  }
  const moveSpeed = player.position.distanceTo(SIN_TOWER_INFECTION.lastPlayerPos) / safeDt;
  SIN_TOWER_INFECTION.lastPlayerPos.copy(player.position);
  const targetWalkSway = clamp(moveSpeed * .052, 0, .48);
  SIN_TOWER_INFECTION.walkSway = THREE.MathUtils.lerp(SIN_TOWER_INFECTION.walkSway || 0, targetWalkSway, clamp(safeDt*5.5,0,1));

  const tmpDown=SIN_TOWER_INFECTION.motionScratchDown||(SIN_TOWER_INFECTION.motionScratchDown=new THREE.Vector3());
  const previousAttachments=SIN_TOWER_INFECTION.dynamicAttachments||[];
  const liveAttachments=SIN_TOWER_INFECTION.dynamicAttachmentScratch||(SIN_TOWER_INFECTION.dynamicAttachmentScratch=[]);liveAttachments.length=0;
  let motionMaxRadians = 0;
  let motionMaxOffset = 0;
  for(const rec of previousAttachments){
    const obj = rec.node;
    const motion = obj?.userData?.motion;
    if(!obj || !motion || !obj.parent) continue;
    const k = clamp((frameNow - motion.growStart) / motion.growDuration, 0, 1);
    const grow = makeSinTowerGrowthScale(k);
    const localDown = motion.localDown || (motion.localDown = new THREE.Vector3(0,-Math.max(.001,motion.unit || 1),0));
    tmpDown.copy(localDown).multiplyScalar((motion.droopWorld || 0) * grow);
    const tentacleMotion = motion.profile === 'tentacle';
    const wind = tentacleMotion ? Math.sin(t * .92 + motion.phaseA*.017) * (motion.windSwing || 0) : 0;
    const sway = tentacleMotion ? (Math.sin(t * motion.freqA + motion.phaseA) * (motion.weightSwing || 0) + wind) * grow : 0;
    const sway2 = tentacleMotion ? Math.cos(t * motion.freqB + motion.phaseB) * (motion.weightSwing || 0) * .55 * grow : 0;
    obj.position.copy(motion.baseLocal).add(tmpDown);
    obj.rotation.copy(motion.baseRotation);
    obj.rotation.z += sway;
    obj.rotation.x += sway2;
    obj.rotation.y += wind * .35 * grow;
    obj.scale.copy(motion.targetScale).multiplyScalar(grow);
    motionMaxRadians = Math.max(motionMaxRadians,Math.abs(sway),Math.abs(sway2),Math.abs(wind*.35*grow));
    motionMaxOffset = Math.max(motionMaxOffset,tmpDown.length());
    if(k < 1 || tentacleMotion) liveAttachments.push(rec);
    else obj.userData.motion = null;
  }
  if(liveAttachments.length > 420){
    const retired = liveAttachments.splice(0, liveAttachments.length - 420);
    for(const rec of retired) if(rec?.node?.userData) rec.node.userData.motion = null;
  }
  SIN_TOWER_INFECTION.lastMotionMaxRadians = motionMaxRadians;
  SIN_TOWER_INFECTION.lastMotionMaxOffset = motionMaxOffset;
  SIN_TOWER_INFECTION.dynamicAttachments = liveAttachments;
  SIN_TOWER_INFECTION.dynamicAttachmentScratch=previousAttachments;

  const eyes = SIN_TOWER_INFECTION.eyes || [];
  for(let i=eyes.length-1;i>=0;i--){
    const eyePivot = eyes[i];
    const blink = eyePivot?.userData?.blink;
    if(!eyePivot?.parent){ eyes.splice(i,1); continue; }
    if(!blink || !blink.mesh) continue;
    // 眨眼保留，但用低頻更新；視覺存在，不再每個 frame 更新所有眼睛。
    const cycle = (t * blink.speed + blink.phase) % blink.interval;
    const closeness = cycle > blink.interval - .22 ? Math.sin(((cycle - (blink.interval - .22))/.22) * Math.PI) : 0;
    blink.mesh.scale.x = blink.baseScale.x;
    blink.mesh.scale.z = blink.baseScale.z;
    blink.mesh.scale.y = Math.max(blink.baseScale.y * .06, blink.baseScale.y * (1 - closeness*.94));
    if(blink.pupil && blink.pupilBase){
      blink.pupil.scale.x = blink.pupilBase.x;
      blink.pupil.scale.z = blink.pupilBase.z;
      blink.pupil.scale.y = Math.max(blink.pupilBase.y * .06, blink.pupilBase.y * (1 - closeness*.94));
    }
  }

  if(playerGroup && (SIN_TOWER_INFECTION.level || 0) < getSinTowerTumorParams().meatballLevel){
    playerGroup.rotation.x = 0;
    playerGroup.rotation.z = 0;
  }
  updateSinTowerMeatballTransform(moveSpeed, safeDt, false);
  const movingNow = isSinTowerAutoRunActive() || !!(keys.w || keys.a || keys.s || keys.d);
  // Keep all geometry and detail jobs, but spread them more finely while the
  // player is moving so infection growth cannot monopolize a gameplay frame.
  const recordingNow=sinTowerCaptureMode!=='none';
  processSinTowerInfectionRebuildQueue(recordingNow ? .3 : (movingNow ? .55 : 1.8));
  scheduleSinTowerDetailIdlePump();
  processSinTowerDisposeQueue(recordingNow ? .16 : (movingNow ? .28 : .9));
  const hasPendingDetail = (SIN_TOWER_INFECTION.detailQueue || []).length > 0 || !!SIN_TOWER_INFECTION.rebuildState;
  const hasPendingCoreBuild = (SIN_TOWER_INFECTION.detailQueue || []).some(job=>job?.type === 'buildTumor');
  if(!SIN_TOWER_INFECTION.rebuildState && !hasPendingCoreBuild && SIN_TOWER_INFECTION.tumorBatchDirty) rebuildSinTowerTumorBatches();
  updateSinTowerTumorBatches();
  if(!hasPendingDetail && (SIN_TOWER_INFECTION.needsUnsafeCleanup || performance.now() - (SIN_TOWER_INFECTION.lastUnsafeCleanupAt || 0) > 2800)){
    cleanupSinTowerUnsafeGrowth(36);
  }
  SIN_TOWER_INFECTION.lastUpdateMs = performance.now() - perfStart;
}

function getSandHeightAtWorld(x,z){
  if(!isSinTowerStairSceneActive()) return null;
  let best=null;
  for(const mesh of sandTargetsForRaycast()){
    const local=mesh.worldToLocal(new THREE.Vector3(x,mesh.position.y,z));
    const w=safeFinite(mesh.userData.sandWidth,0), d=safeFinite(mesh.userData.sandDepth,0);
    if(Math.abs(local.x)<=w/2 && Math.abs(local.z)<=d/2){
      const info=sandInfoFromMesh(mesh,new THREE.Vector3(x,mesh.position.y,z));
      const sand=info?.cfg?.sand; if(!sand) continue;
      const y=mesh.position.y + sandHeightLocal(local.x,local.z,w,d,sand);
      if(!best || y>best.y) best={y,sand,mesh,localX:local.x,localZ:local.z,width:w,depth:d};
    }
  }
  return best;
}
function getPlayerGroundY(){
  const editorY = getSinTowerEditorGroundY?.();
  if(editorY !== null && editorY !== undefined){
    sandRuntime.currentInfo = null;
    sandRuntime.currentHeight = editorY;
    return editorY;
  }
  const info=getSandHeightAtWorld(player.position.x,player.position.z);
  sandRuntime.currentInfo=info;
  const sandY=info?info.y:0;
  const stairY=getSinTowerStairGroundYAtWorld(player.position.x,player.position.z);
  const y=stairY===null?sandY:Math.max(sandY,stairY);
  sandRuntime.currentHeight=y;
  return y;
}
function getSandFootprintTexture(){
  if(sandRuntime.footprintTexture) return sandRuntime.footprintTexture;
  const canvas=document.createElement('canvas'); canvas.width=canvas.height=96; const ctx=canvas.getContext('2d');
  const g=ctx.createRadialGradient(48,48,6,48,48,46); g.addColorStop(0,'rgba(95,70,38,.42)'); g.addColorStop(.42,'rgba(110,82,48,.28)'); g.addColorStop(.78,'rgba(255,235,190,.10)'); g.addColorStop(1,'rgba(255,255,255,0)');
  ctx.fillStyle=g; ctx.beginPath(); ctx.ellipse(48,48,22,38,0,0,Math.PI*2); ctx.fill();
  const tex=new THREE.CanvasTexture(canvas); tex.colorSpace=THREE.SRGBColorSpace; sandRuntime.footprintTexture=tex; return tex;
}
function getSandDustTexture(){
  if(sandRuntime.dustTexture) return sandRuntime.dustTexture;
  const canvas=document.createElement('canvas'); canvas.width=canvas.height=64; const ctx=canvas.getContext('2d');
  const g=ctx.createRadialGradient(32,32,1,32,32,31); g.addColorStop(0,'rgba(236,218,176,.52)'); g.addColorStop(.48,'rgba(220,195,145,.20)'); g.addColorStop(1,'rgba(220,195,145,0)'); ctx.fillStyle=g; ctx.fillRect(0,0,64,64);
  const tex=new THREE.CanvasTexture(canvas); tex.colorSpace=THREE.SRGBColorSpace; sandRuntime.dustTexture=tex; return tex;
}
function spawnSandFootprint(info,moving){
  if(!info || !moving || !scene) return; const now=performance.now(); const reaction=clamp(safeFinite(info.sand?.reaction,.7),0,1); if(now-sandRuntime.lastStepTime < 210-reaction*70) return;
  sandRuntime.lastStepTime=now; sandRuntime.lastFootSide*=-1; const side=sandRuntime.lastFootSide;
  const mat=new THREE.SpriteMaterial({map:getSandFootprintTexture(),transparent:true,opacity:.42+reaction*.18,depthWrite:false}); const spr=new THREE.Sprite(mat);
  const sideOffset=new THREE.Vector3(Math.cos(playerYaw+Math.PI/2)*side*.13,0,Math.sin(playerYaw+Math.PI/2)*side*.13); const backOffset=new THREE.Vector3(Math.sin(playerYaw)*-.08,0,Math.cos(playerYaw)*-.08);
  spr.position.copy(new THREE.Vector3(player.position.x,info.y+.032,player.position.z).add(sideOffset).add(backOffset)); spr.rotation.z=-playerYaw+side*.15; spr.scale.set(.34,.62,1); spr.userData.birth=now; spr.userData.life=5200; scene.add(spr); sandRuntime.footprints.push(spr);
}
function spawnSandDust(info,moving){
  if(!info || !moving || !scene) return; const reaction=clamp(safeFinite(info.sand?.reaction,.7),0,1); if(Math.random()>(.28+reaction*.42)) return;
  const grain=clamp(safeFinite(info.sand?.grain,.42),0,1); const mat=new THREE.SpriteMaterial({map:getSandDustTexture(),transparent:true,opacity:.16+reaction*.18,depthWrite:false,color:new THREE.Color(info.sand?.color||'#c9ad79')}); const spr=new THREE.Sprite(mat);
  const angle=playerYaw+Math.PI+(Math.random()-.5)*1.2, r=Math.random()*.18; spr.position.set(player.position.x+Math.cos(angle)*r,info.y+.05+Math.random()*.08,player.position.z+Math.sin(angle)*r); const size=.08+Math.random()*(.16+(1-grain)*.14); spr.scale.set(size,size,1);
  spr.userData.velocity=new THREE.Vector3(Math.cos(angle)*(.12+Math.random()*.28),.18+Math.random()*.36,Math.sin(angle)*(.12+Math.random()*.28)); spr.userData.wind=new THREE.Vector3(.10+Math.sin(performance.now()*.00037)*.08,0,.035+Math.cos(performance.now()*.00029)*.06); spr.userData.birth=performance.now(); spr.userData.life=900+Math.random()*900; scene.add(spr); sandRuntime.particles.push(spr);
}
function updateSandEffects(dt,moving=false){
  const now=performance.now(); const info=getSandHeightAtWorld(player.position.x,player.position.z); sandRuntime.currentInfo=info; if(info){ spawnSandFootprint(info,moving); spawnSandDust(info,moving); }
  for(let i=sandRuntime.particles.length-1;i>=0;i--){ const p=sandRuntime.particles[i]; const age=now-p.userData.birth, life=p.userData.life||1000; if(age>=life){ scene.remove(p); disposeObjectTree(p); sandRuntime.particles.splice(i,1); continue; } const v=p.userData.velocity||new THREE.Vector3(), wind=p.userData.wind||new THREE.Vector3(); v.y-=.32*dt; p.position.addScaledVector(v,dt); p.position.addScaledVector(wind,dt*(1+age/life)); p.material.opacity=.26*(1-age/life); p.scale.multiplyScalar(1+dt*.75); }
  for(let i=sandRuntime.footprints.length-1;i>=0;i--){ const f=sandRuntime.footprints[i]; const age=now-f.userData.birth, life=f.userData.life||5200; if(age>=life){ scene.remove(f); disposeObjectTree(f); sandRuntime.footprints.splice(i,1); continue; } f.material.opacity=.48*(1-age/life); }
}

function jump(){
  if(isSinTowerMeatballMode()) return;
  const waterState = getPlayerWaterState();
  if(waterState.inside && waterState.body){
    playerVelocityY = Math.max(playerVelocityY, (waterState.swimming ? 1.65 : 3.2) * getPlayerJumpPower());
    // 角色完全在水面下方時，按跳躍只應該產生游泳上浮，不應在遠方水面炸出水花。
    if(!waterState.headSubmerged) triggerWaterRipple(waterState.body, waterState.swimming ? 1.25 : 1.2);
    manualActionUntil = performance.now()+520;
    return;
  }
  const gy = getPlayerGroundY();
  if(player.position.y <= gy + .025){
    // 7.1 是目前基準跳躍初速；編輯面板的「跳躍力倍數」最高可推到 5 倍。
    playerVelocityY = 7.1 * getPlayerJumpPower();
    playAction('jump', true);
  }
}

function movementVector(){
  const auto = isSinTowerAutoRunActive();
  const touchBlocked=!!(sinAfterVideoSession||sinRpsSession||sinTowerPortalGate.active||$('sinQuestionOverlay')?.classList.contains('open'));
  const touch=sinMobileInput.active&&!touchBlocked;
  const forward = touch ? sinMobileInput.y : auto ? 1 : ((keys.w?1:0) - (keys.s?1:0));
  const strafe = touch ? sinMobileInput.x : (keys.d?1:0) - (keys.a?1:0);
  return {forward, strafe};
}

function getPlayerMovementSpeed(){
  // 感染等級不得修改主角的基礎移動速度；水體與沙地減速仍由各自環境規則處理。
  return clamp(safeFinite(STATE.player?.speed, 6.3), 1, 12);
}

function getCameraForward(){
  return new THREE.Vector3(-Math.sin(camYaw),0,-Math.cos(camYaw)).normalize();
}

function getCameraForward3D(){
  const horizontal = getCameraForward();
  const cp = Math.cos(camPitch);
  return new THREE.Vector3(horizontal.x * cp, Math.sin(camPitch), horizontal.z * cp).normalize();
}

function getCameraRight(forward=getCameraForward()){
  return new THREE.Vector3(-forward.z,0,forward.x).normalize();
}

function yawFromDirection(direction){
  return Math.atan2(-direction.x, -direction.z);
}

function enforceActorFacing(facingDirection=null){
  // 待機時模型跟隨滑鼠視角；移動時模型朝向實際移動方向。
  // 因此按 S 往後走會轉身 180 度，不會倒退滑行。
  playerYaw = facingDirection && facingDirection.lengthSq() > 0.0001 ? yawFromDirection(facingDirection) : camYaw;
  playerGroup.rotation.set(0, playerYaw, 0);
  const cfg = STATE.player || {modelYOffset:0.68, modelYawOffset:180, speed:6.3};
  const yawOff = clamp(safeFinite(cfg.modelYawOffset,180), -180, 180);
  const diveTilt = (waterRuntime?.swimming || swimDiveVisual > .001) ? -Math.PI * 0.5 * clamp(swimDiveVisual, 0, 1) : 0;
  if(actorModel) actorModel.rotation.set(diveTilt, deg(yawOff), 0);
  if(actorProxy) actorProxy.rotation.set(diveTilt, deg(yawOff), 0);
}

function updatePlayer(dt){
  const waterStateBefore = getPlayerWaterState();
  const move = movementVector();
  const direction = new THREE.Vector3();
  const autoRun = isSinTowerAutoRunActive();
  const forward = autoRun ? new THREE.Vector3(0,0,SIN_TOWER_STAIRCASE.directionZ).normalize() : getCameraForward();
  const right = getCameraRight(forward);
  direction.addScaledVector(forward, move.forward);
  direction.addScaledVector(right, move.strafe);
  const moving = direction.lengthSq() > 0.0001;
  const facingDirection = moving ? direction.clone().normalize() : null;
  const waterMoveScale = waterStateBefore.swimming ? .48 : (waterStateBefore.wading ? .72 : 1);
  const sandUnderFoot = getSandHeightAtWorld(player.position.x, player.position.z);
  const sandMoveScale = sandUnderFoot ? (1 - clamp(safeFinite(sandUnderFoot.sand?.reaction,.7),0,1) * .16) : 1;
  if(moving){
    direction.normalize().multiplyScalar(getPlayerMovementSpeed() * waterMoveScale * sandMoveScale * dt);
    const nextX = player.position.clone();
    nextX.x += direction.x;
    if(!collides(nextX)) player.position.x = nextX.x;
    const nextZ = player.position.clone();
    nextZ.z += direction.z;
    if(!collides(nextZ)) player.position.z = nextZ.z;
  }
  enforceSinTowerStairTravelBounds();
  updateSandEffects(dt, moving && !waterStateBefore.swimming);

  const waterState = getPlayerWaterState();
  waterRuntime.current = waterState;
  waterRuntime.inside = !!waterState.inside;
  waterRuntime.swimming = !!waterState.swimming;
  waterRuntime.wading = !!waterState.wading;

  if(isSinTowerMeatballMode()){
    // 肉球模式：完全停用重力、跳躍、游泳浮沉造成的 Y 軸變化。
    // 每幀只貼回當前樓梯/地面高度；滾動高度由固定隱形球維持，不再重新量外框。
    swimDiveVisual = 0;
    playerVelocityY = 0;
    player.position.y = getPlayerGroundY();
  }else if(waterState.swimming){
    // 深水中使用視角 pitch 決定浮沉：視角向下且向前游時，主角可向下潛水；視角向上則上浮。
    const forwardIntent = Math.max(0, move.forward);
    const pitchIntent = moving ? clamp(Math.sin(camPitch) * forwardIntent, -0.96, 0.82) : 0;
    const diveAmount = clamp(-pitchIntent, 0, 1);
    const ascendAmount = clamp(pitchIntent, 0, 1);
    swimDiveVisual = THREE.MathUtils.lerp(swimDiveVisual, diveAmount, 1 - Math.pow(.035, dt));
    const targetSubmerge = player.height * clamp(.70 + diveAmount * .95 - ascendAmount * .34, .42, 1.72);
    const targetFloatY = waterState.surfaceY - targetSubmerge;
    const floatError = targetFloatY - player.position.y;
    playerVelocityY += clamp(floatError * 3.0, -3.8, 4.8) * dt;
    playerVelocityY += pitchIntent * 5.4 * dt;
    playerVelocityY -= 0.82 * dt;
    playerVelocityY *= Math.pow(.24, dt);
    playerVelocityY = clamp(playerVelocityY, -2.85, 2.2);
    player.position.y += playerVelocityY * dt;
    const minY = waterState.baseY + .03;
    const maxY = waterState.surfaceY - .12;
    player.position.y = clamp(player.position.y, minY, Math.max(minY, maxY));
    // 下潛時若角色已完全在水面下，不應再把擾動投射成水面水花。
    if(diveAmount > .2 && moving && waterState.body && !waterState.headSubmerged){
      triggerWaterRipple(waterState.body, .36 + diveAmount * .42, {splash:false, foam:true});
    }
  }else{
    swimDiveVisual = THREE.MathUtils.lerp(swimDiveVisual, 0, 1 - Math.pow(.06, dt));
    const gravityScale = waterState.wading ? .82 : 1;
    playerVelocityY -= 9.8 * gravityScale * dt;
    if(waterState.wading) playerVelocityY *= Math.pow(.45, dt);
    player.position.y += playerVelocityY*dt;
    const groundY = getPlayerGroundY();
    if(player.position.y < groundY){ player.position.y = groundY; playerVelocityY = 0; }
  }

  const bounds = movementBounds();
  player.position.x = clamp(player.position.x, bounds.minX, bounds.maxX);
  player.position.z = clamp(player.position.z, bounds.minZ, bounds.maxZ);
  resolvePlayerWallOverlaps();
  enforceSinTowerStairTravelBounds();
  if(isSinTowerStairSceneActive()) updateSinTowerVisibleStairs(false);
  playerGroup.position.copy(player.position);
  if(isSinTowerMeatballMode()){
    playerVelocityY = 0;
    player.position.y = getPlayerGroundY();
    playerGroup.position.y = player.position.y;
  }
  enforceActorFacing(facingDirection);
  if(performance.now() > manualActionUntil){
    if(isSinTowerMeatballMode()) playAction('idle');
    else if(waterState.swimming) playAction(moving ? 'walk' : 'idle');
    else if(moving) playAction('walk');
    else playAction('idle');
  }
}

function movementBounds(){
  const editorBounds = getSinTowerActiveSceneBounds?.();
  if(editorBounds){
    const r0 = safeFinite(player?.radius, .32);
    return {
      minX:editorBounds.minX + r0,
      maxX:editorBounds.maxX - r0,
      minZ:editorBounds.minZ + r0,
      maxZ:editorBounds.maxZ - r0
    };
  }
  const extents = [];
  const floorTr = getSurfaceTransform('floor');
  extents.push({
    minX: floorTr.position.x - floorTr.size.x/2,
    maxX: floorTr.position.x + floorTr.size.x/2,
    minZ: floorTr.position.z - floorTr.size.z/2,
    maxZ: floorTr.position.z + floorTr.size.z/2
  });
  for(const tile of (STATE.floorTiles || [])){
    const w = clamp(safeFinite(tile.size?.w,4), .02, 500);
    const d = clamp(safeFinite(tile.size?.d,4), .02, 500);
    const x = safeFinite(tile.position?.x,0);
    const z = safeFinite(tile.position?.z,0);
    extents.push({minX:x-w/2, maxX:x+w/2, minZ:z-d/2, maxZ:z+d/2});
  }
  const stairBounds = getSinTowerStairBounds();
  if(stairBounds) extents.push(stairBounds);
  let minX = Math.min(...extents.map(e=>e.minX));
  let maxX = Math.max(...extents.map(e=>e.maxX));
  let minZ = Math.min(...extents.map(e=>e.minZ));
  let maxZ = Math.max(...extents.map(e=>e.maxZ));
  const r = safeFinite(player?.radius, .32);
  if(maxX - minX <= r*2){ const c=(minX+maxX)/2; minX=c-r; maxX=c+r; }
  if(maxZ - minZ <= r*2){ const c=(minZ+maxZ)/2; minZ=c-r; maxZ=c+r; }
  return {
    minX: minX + r,
    maxX: maxX - r,
    minZ: minZ + r,
    maxZ: maxZ - r
  };
}

function wallPlacementBounds(){
  const b = movementBounds();
  return {minX:b.minX, maxX:b.maxX, minZ:b.minZ, maxZ:b.maxZ};
}

function getCollisionWaterContainers(){
  if(!isSinTowerStairSceneActive()) return [];
  const list = [];
  for(const body of (STATE.waterBodies || [])){
    if(!body || body.visible === false || body.isDraft || body.id === pendingWaterBodyId) continue;
    list.push({id:body.id, type:'waterContainer', body});
  }
  return list;
}

function rectWaterWallCollisionHit(body, pLocal, radius, pad=0){
  const w = clamp(safeFinite(body.size?.w,4),.2,500);
  const d = clamp(safeFinite(body.size?.d,2),.2,500);
  const h = clamp(safeFinite(body.size?.h,.72),.05,500);
  const t = clamp(safeFinite(body.size?.t,.12),.02,Math.min(w,d)/2);
  const m = waterBodyMetrics(body);
  const feetY = pLocal.y + safeFinite(body.position?.y,0);
  if(feetY > m.baseY + h - .04) return null;

  const boxes = [
    {cx:-w/2+t/2, cz:0, hx:t/2, hz:d/2},
    {cx:w/2-t/2, cz:0, hx:t/2, hz:d/2},
    {cx:0, cz:d/2-t/2, hx:w/2, hz:t/2},
    {cx:0, cz:-d/2+t/2, hx:w/2, hz:t/2}
  ];
  let best = null;
  const expand = radius + pad;
  for(const b of boxes){
    const dx = pLocal.x - b.cx;
    const dz = pLocal.z - b.cz;
    const limX = b.hx + expand;
    const limZ = b.hz + expand;
    if(Math.abs(dx) > limX || Math.abs(dz) > limZ) continue;
    const penX = limX - Math.abs(dx);
    const penZ = limZ - Math.abs(dz);
    const resolved = pLocal.clone();
    if(penX < penZ) resolved.x = b.cx + (dx >= 0 ? limX : -limX);
    else resolved.z = b.cz + (dz >= 0 ? limZ : -limZ);
    const penetration = Math.min(penX, penZ);
    if(!best || penetration > best.penetration) best = {penetration, resolvedLocal:resolved};
  }
  return best;
}

function roundWaterWallCollisionHit(body, pLocal, radius, pad=0){
  const w = clamp(safeFinite(body.size?.w,3),.2,500);
  const d = clamp(safeFinite(body.size?.d,3),.2,500);
  const h = clamp(safeFinite(body.size?.h,.72),.05,500);
  const t = clamp(safeFinite(body.size?.t,.12),.02,Math.min(w,d)/2);
  const m = waterBodyMetrics(body);
  const feetY = pLocal.y + safeFinite(body.position?.y,0);
  if(feetY > m.baseY + h - .04) return null;

  const rx = Math.max(.001, w/2);
  const rz = Math.max(.001, d/2);
  const innerRx = Math.max(.001, rx - t);
  const innerRz = Math.max(.001, rz - t);
  const outer = Math.sqrt((pLocal.x/rx)**2 + (pLocal.z/rz)**2);
  const inner = Math.sqrt((pLocal.x/innerRx)**2 + (pLocal.z/innerRz)**2);
  const expand = (radius + pad) / Math.max(.001, Math.min(rx,rz));
  if(outer > 1 + expand || inner < 1 - expand) return null;
  let dir = new THREE.Vector2(pLocal.x / rx, pLocal.z / rz);
  if(dir.lengthSq() < .000001) dir.set(1,0);
  dir.normalize();
  const pushOutside = outer >= 1 - t / Math.max(.001, Math.min(rx,rz)) * .5;
  const targetRx = pushOutside ? rx + radius + pad : Math.max(.001, innerRx - radius - pad);
  const targetRz = pushOutside ? rz + radius + pad : Math.max(.001, innerRz - radius - pad);
  const resolved = pLocal.clone();
  resolved.x = dir.x * targetRx;
  resolved.z = dir.y * targetRz;
  return {penetration:Math.abs(1 - outer) * Math.min(rx,rz) + radius + pad, resolvedLocal:resolved};
}

function waterContainerCollisionHit(item, pos, pad=0){
  const body = item?.body;
  if(!body || body.visible === false || body.isDraft) return null;
  const radius = safeFinite(player?.radius,.34);
  const pLocal = waterLocalPoint(body, pos);
  const hit = (body.shape === 'cylinder' || body.shape === 'oval')
    ? roundWaterWallCollisionHit(body, pLocal, radius, pad)
    : rectWaterWallCollisionHit(body, pLocal, radius, pad);
  if(!hit) return null;
  const resolvedWorld = new THREE.Vector3(
    safeFinite(body.position?.x,0) + hit.resolvedLocal.x,
    pos.y,
    safeFinite(body.position?.z,0) + hit.resolvedLocal.z
  );
  return {item, axis:'waterContainer', penetration:hit.penetration, resolvedWorld};
}

function obstacleCollisionHit(item, pos, pad=0){
  if(item?.type === 'waterContainer') return waterContainerCollisionHit(item, pos, pad);
  if(item?.type === 'sinTowerStone') return sinTowerStoneCollisionHit(item, pos, pad);
  return wallCollisionHit(item, pos, pad);
}

function getCollisionWallMeshes(){
  if(!isSinTowerStairSceneActive()) return [];
  const list = [];
  for(const [id, mesh] of Object.entries(customWallMeshes)){
    if(id === pendingWallId) continue;
    const wall = STATE.customWalls.find(w=>w.id===id);
    if(mesh) list.push({id, mesh, wall, type:'custom'});
  }
  for(const key of WALL_KEYS){
    const mesh = surfaces[key];
    if(mesh) list.push({id:key, mesh, type:'room'});
  }
  if(referenceArchitectureGroup && STATE?.referenceArchitecture?.enabled !== false && STATE?.referenceArchitecture?.visible !== false){
    for(const item of referenceCollisionItems){
      if(item?.mesh?.visible !== false) list.push(item);
    }
  }
  return list;
}

function getWorldScaleSafe(mesh){
  const s = new THREE.Vector3(1,1,1);
  mesh.updateMatrixWorld(true);
  mesh.getWorldScale(s);
  s.x = Math.max(Math.abs(s.x), .0001);
  s.y = Math.max(Math.abs(s.y), .0001);
  s.z = Math.max(Math.abs(s.z), .0001);
  return s;
}

function referenceArchOpeningHalfWidth(hole, localY){
  const bottom = safeFinite(hole?.y, 0);
  const width = Math.max(.001, safeFinite(hole?.w, 2.5));
  const height = Math.max(.001, safeFinite(hole?.h, 4));
  const r = width / 2;
  const verticalTop = Math.max(bottom + r + .05, bottom + height - r);
  if(localY < bottom || localY > verticalTop + r) return -1;
  if(localY <= verticalTop) return r;
  const dy = localY - verticalTop;
  return Math.sqrt(Math.max(0, r * r - dy * dy));
}

function referenceRoundedRectOpeningContains(hole, localX, localY, margin=0){
  const cx = safeFinite(hole?.x, 0);
  const w = Math.max(.001, safeFinite(hole?.w, 2));
  const h = Math.max(.001, safeFinite(hole?.h, 2));
  const bottom = safeFinite(hole?.y, 0);
  const r = Math.min(Math.max(safeFinite(hole?.r, .5), .001), w / 2, h / 2);
  const x = localX - cx;
  const y = localY - bottom;
  const hw = Math.max(.001, w / 2 - margin);
  const hh = Math.max(.001, h / 2 - margin);
  if(y < margin || y > h - margin) return false;
  if(Math.abs(x) <= hw - r) return true;
  if(y >= r && y <= h - r && Math.abs(x) <= hw) return true;
  const sx = Math.abs(x) - (hw - r);
  const sy = Math.abs(y - h / 2) - (hh - r);
  return Math.max(sx, 0) ** 2 + Math.max(sy, 0) ** 2 <= Math.max(.001, r - margin) ** 2;
}

function referenceOpeningContains(hole, localX, localY, margin=0){
  if(!hole) return false;
  const cx = safeFinite(hole.x, 0);
  if(hole.type === 'roundRect') return referenceRoundedRectOpeningContains(hole, localX, localY, margin);
  if(hole.type === 'rect'){
    const w = Math.max(.001, safeFinite(hole.w,2));
    const h = Math.max(.001, safeFinite(hole.h,2));
    const y = safeFinite(hole.y,0);
    return localY >= y + margin && localY <= y + h - margin && Math.abs(localX - cx) <= Math.max(0, w/2 - margin);
  }
  if(hole.type === 'circle'){
    const w = Math.max(.001, safeFinite(hole.w,2));
    const h = Math.max(.001, safeFinite(hole.h,2));
    const y = safeFinite(hole.y,0);
    const nx = (localX - cx) / Math.max(.001, w/2 - margin);
    const ny = (localY - (y + h/2)) / Math.max(.001, h/2 - margin);
    return nx*nx + ny*ny <= 1;
  }
  if(isPolygonChiselType(hole.type)) return referencePolygonOpeningContains(hole, localX, localY, margin);
  const half = referenceArchOpeningHalfWidth(hole, localY);
  if(half < 0) return false;
  return Math.abs(localX - cx) <= Math.max(0, half - margin);
}

function referenceWallPanelCollisionHit(item, pos, pad=0){
  const mesh = item?.mesh;
  if(!mesh) return null;
  mesh.updateMatrixWorld(true);
  const inv = new THREE.Matrix4().copy(mesh.matrixWorld).invert();
  const pWorld = new THREE.Vector3(pos.x, safeFinite(pos.y, 0) + 1.0, pos.z);
  const pLocal = pWorld.clone().applyMatrix4(inv);
  const width = Math.max(.02, safeFinite(mesh.userData?.referenceCollisionWidth, 1));
  const height = Math.max(.02, safeFinite(mesh.userData?.referenceCollisionHeight, 1));
  const thickness = Math.max(.02, safeFinite(mesh.userData?.referenceCollisionThickness, .38));
  const holes = Array.isArray(mesh.userData?.referenceCollisionHoles) ? mesh.userData.referenceCollisionHoles : [];
  const radius = safeFinite(player?.radius, .32) + pad;

  if(pLocal.y < -1.25 || pLocal.y > height + 1.25) return null;
  if(Math.abs(pLocal.x) > width / 2 + radius || Math.abs(pLocal.z) > thickness / 2 + radius) return null;

  // The reference building uses real wall panels with visible holes.  Collision must follow
  // the same hole data, otherwise interior archways become invisible walls.
  const openingMargin = Math.min(radius * .72, .34);
  for(const h of holes){
    if(referenceOpeningContains(h, pLocal.x, pLocal.y, openingMargin)) return null;
  }

  const limitX = width / 2 + radius;
  const limitZ = thickness / 2 + radius;
  const penX = limitX - Math.abs(pLocal.x);
  const penZ = limitZ - Math.abs(pLocal.z);
  const resolvedLocal = pLocal.clone();
  const resolveAxis = penZ <= penX ? 'z' : 'x';
  if(resolveAxis === 'z') resolvedLocal.z = (pLocal.z >= 0 ? 1 : -1) * limitZ;
  else resolvedLocal.x = (pLocal.x >= 0 ? 1 : -1) * limitX;
  const resolvedWorld = resolvedLocal.applyMatrix4(mesh.matrixWorld);
  return {item, axis:resolveAxis, penetration:Math.min(penX, penZ), resolvedWorld};
}

function customStraightWallChiselCollisionHit(item, pos, pad=0){
  const mesh = item?.mesh;
  const wall = item?.wall;
  if(!mesh || !wall) return null;
  mesh.updateMatrixWorld(true);
  const inv = new THREE.Matrix4().copy(mesh.matrixWorld).invert();
  const pWorld = new THREE.Vector3(pos.x, safeFinite(pos.y,0) + 1.0, pos.z);
  const pLocal = pWorld.clone().applyMatrix4(inv);
  const width = clamp(safeFinite(wall.size?.w,3), .5, 500);
  const height = clamp(safeFinite(wall.size?.h,ROOM.height), .5, 500);
  const thickness = clamp(safeFinite(wall.size?.t,.18), .02, 500);
  const radius = safeFinite(player?.radius, .32) + pad;
  const localYFromBottom = pLocal.y + height / 2;
  if(localYFromBottom < -1.25 || localYFromBottom > height + 1.25) return null;
  if(Math.abs(pLocal.x) > width / 2 + radius || Math.abs(pLocal.z) > thickness / 2 + radius) return null;
  const openingMargin = Math.min(radius * .72, .34);
  for(const h of chiselHolesForCutting(sanitizeChiselHoles(wall.chiselHoles, false), clamp(safeFinite(wall.size?.t,.18), .02, 500))){
    if(referenceOpeningContains(h, pLocal.x, localYFromBottom, openingMargin)) return null;
  }
  const limitX = width / 2 + radius;
  const limitZ = thickness / 2 + radius;
  const penX = limitX - Math.abs(pLocal.x);
  const penZ = limitZ - Math.abs(pLocal.z);
  const resolvedLocal = pLocal.clone();
  const resolveAxis = penZ <= penX ? 'z' : 'x';
  if(resolveAxis === 'z') resolvedLocal.z = (pLocal.z >= 0 ? 1 : -1) * limitZ;
  else resolvedLocal.x = (pLocal.x >= 0 ? 1 : -1) * limitX;
  const resolvedWorld = resolvedLocal.applyMatrix4(mesh.matrixWorld);
  return {item, axis:resolveAxis, penetration:Math.min(penX, penZ), resolvedWorld};
}


function referenceBoxChiselCollisionHit(item, pos, pad=0){
  const mesh = item?.mesh;
  if(!mesh) return null;
  const holes = Array.isArray(mesh.userData?.referenceBoxChiselHoles) ? mesh.userData.referenceBoxChiselHoles : [];
  if(!holes.length) return null;
  mesh.updateMatrixWorld(true);
  const inv = new THREE.Matrix4().copy(mesh.matrixWorld).invert();
  const size = mesh.userData?.referenceCollisionSize || {x:1,y:1,z:1};
  const baked = !!mesh.userData?.referenceGeometryBaked;
  const pWorld = new THREE.Vector3(pos.x, safeFinite(pos.y,0) + 1.0, pos.z);
  const raw = pWorld.clone().applyMatrix4(inv);
  const pLocal = baked ? raw : new THREE.Vector3(raw.x * size.x, raw.y * size.y, raw.z * size.z);
  const radius = safeFinite(player?.radius, .32) + pad;
  const sx = Math.max(.02, safeFinite(size.x,1));
  const sy = Math.max(.02, safeFinite(size.y,1));
  const sz = Math.max(.02, safeFinite(size.z,1));
  if(Math.abs(pLocal.y) > sy/2 + 1.25) return null;
  if(Math.abs(pLocal.x) > sx/2 + radius || Math.abs(pLocal.z) > sz/2 + radius) return null;
  // If the player cylinder centre is inside a chiseled-away through-volume, this box should not block.
  const yBottom = pLocal.y + sy/2;
  const margin = Math.min(radius * .72, .34);
  for(const h of holes){
    if(!chiselHoleCutsThrough(h, h.axis === 'x' ? sx : sz)) continue;
    const axis = h.axis === 'x' ? 'x' : 'z';
    const side = chiselHoleSide(h);
    const u = axis === 'x' ? pLocal.z : pLocal.x;
    const thickness = axis === 'x' ? sx : sz;
    const coord = axis === 'x' ? pLocal.x : pLocal.z;
    const penetration = side >= 0 ? thickness / 2 - coord : coord + thickness / 2;
    const hForMargin = {...h, w:Math.max(.001, safeFinite(h.w,1) - margin * 2), h:Math.max(.001, safeFinite(h.h,1) - margin * 2), y:safeFinite(h.y,0) + margin};
    if(penetration >= -radius && penetration <= thickness + radius && referenceOpeningContains(hForMargin, u, yBottom, 0)) return null;
  }
  const limitX = sx/2 + radius;
  const limitZ = sz/2 + radius;
  const penX = limitX - Math.abs(pLocal.x);
  const penZ = limitZ - Math.abs(pLocal.z);
  const resolved = pLocal.clone();
  const resolveAxis = penZ <= penX ? 'z' : 'x';
  if(resolveAxis === 'z') resolved.z = (pLocal.z >= 0 ? 1 : -1) * limitZ;
  else resolved.x = (pLocal.x >= 0 ? 1 : -1) * limitX;
  const resolvedRaw = baked ? resolved : new THREE.Vector3(resolved.x / sx, resolved.y / sy, resolved.z / sz);
  const resolvedWorld = resolvedRaw.applyMatrix4(mesh.matrixWorld);
  return {item, axis:resolveAxis, penetration:Math.min(penX, penZ), resolvedWorld};
}

function wallCollisionHit(item, pos, pad=0){
  if(item?.type === 'referenceWallPanel') return referenceWallPanelCollisionHit(item, pos, pad);
  if(item?.type === 'referenceBox') { const cut = referenceBoxChiselCollisionHit(item, pos, pad); if(cut) return cut; }
  const mesh = item?.mesh;
  if(!mesh) return null;

  // 不使用 Box3.setFromObject()。
  // Box3 是世界座標 AABB；牆面旋轉或套用凹凸後，隱藏的基底牆會產生比實際牆體大很多的包圍盒，形成「看不到的空氣牆」。
  // 這裡改用牆面自身的 local oriented box，只用原始牆體厚度做碰撞，不把凹凸網格納入碰撞。
  mesh.updateMatrixWorld(true);
  const inv = new THREE.Matrix4().copy(mesh.matrixWorld).invert();
  const pWorld = new THREE.Vector3(pos.x, 1.0, pos.z);
  const pLocal = pWorld.clone().applyMatrix4(inv);
  const scale = getWorldScaleSafe(mesh);
  const radius = safeFinite(player?.radius, .32);

  if(item.type === 'custom' && customWallHasChiselHoles(item.wall)){
    return customStraightWallChiselCollisionHit(item, pos, pad);
  }
  if(item.type === 'custom' && isCurvedWall(item.wall)){
    return curvedWallCollisionHit(item, pLocal, mesh, radius, pad);
  }

  const limitX = .5 + (radius + pad) / scale.x;
  const limitZ = .5 + (radius + pad) / scale.z;
  const limitY = .5 + 1.25 / scale.y;

  if(Math.abs(pLocal.y) > limitY) return null;
  if(Math.abs(pLocal.x) > limitX || Math.abs(pLocal.z) > limitZ) return null;

  const penXWorld = (limitX - Math.abs(pLocal.x)) * scale.x;
  const penZWorld = (limitZ - Math.abs(pLocal.z)) * scale.z;
  const resolveAxis = penZWorld <= penXWorld ? 'z' : 'x';
  const resolvedLocal = pLocal.clone();

  if(resolveAxis === 'z'){
    const sign = pLocal.z >= 0 ? 1 : -1;
    resolvedLocal.z = sign * limitZ;
  }else{
    const sign = pLocal.x >= 0 ? 1 : -1;
    resolvedLocal.x = sign * limitX;
  }

  const resolvedWorld = resolvedLocal.applyMatrix4(mesh.matrixWorld);
  return {
    item,
    axis: resolveAxis,
    penetration: Math.min(penXWorld, penZWorld),
    resolvedWorld
  };
}

function closestPointOnSegment2D(p, a, b){
  const ab = b.clone().sub(a);
  const denom = Math.max(ab.lengthSq(), .000001);
  const t = clamp(p.clone().sub(a).dot(ab) / denom, 0, 1);
  return a.clone().addScaledVector(ab, t);
}

function curvedWallCollisionHit(item, pLocal3, mesh, radius, pad=0){
  const wall = item.wall;
  if(!wall) return null;
  const h = clamp(safeFinite(wall.size?.h, ROOM.height), .5, 500);
  const thick = clamp(safeFinite(wall.size?.t, .18), .02, 500);
  const limitY = h * .5 + 1.25;
  if(Math.abs(pLocal3.y) > limitY) return null;
  const p = new THREE.Vector2(pLocal3.x, pLocal3.z);
  const samples = Math.max(12, Math.min(64, Math.ceil(safeFinite(wall.size?.w,3) * 2.4)));
  let best = null;
  for(let i=0;i<samples;i++){
    const a = curvedWallCenterPoint(wall, i / samples);
    const b = curvedWallCenterPoint(wall, (i + 1) / samples);
    const c = closestPointOnSegment2D(p, a, b);
    const d = p.distanceTo(c);
    if(!best || d < best.d) best = {d, c};
  }
  if(!best) return null;
  const limit = thick * .5 + radius + pad;
  if(best.d > limit) return null;
  let normal = p.clone().sub(best.c);
  if(normal.lengthSq() < .000001) normal.set(0, normalizedWallCurve(wall).sign || 1);
  normal.normalize();
  const resolved2 = best.c.clone().addScaledVector(normal, limit);
  const resolvedLocal = new THREE.Vector3(resolved2.x, pLocal3.y, resolved2.y);
  const resolvedWorld = resolvedLocal.applyMatrix4(mesh.matrixWorld);
  return {item, axis:'curve', penetration:limit - best.d, resolvedWorld};
}

function collides(pos){
  const obstacles = [...getCollisionWallMeshes(), ...getCollisionWaterContainers(), ...getSinTowerStoneCollisionItems(pos)];
  for(const item of obstacles){
    if(obstacleCollisionHit(item, pos, 0)) return true;
  }
  return false;
}

function resolvePlayerWallOverlaps(){
  const meshes = [...getCollisionWallMeshes(), ...getCollisionWaterContainers(), ...getSinTowerStoneCollisionItems(player.position,.035)];
  if(!meshes.length) return false;
  let moved = false;
  const pad = 0.035;

  for(let iter=0; iter<10; iter++){
    let bestHit = null;
    for(const item of meshes){
      const hit = obstacleCollisionHit(item, player.position, pad);
      if(!hit) continue;
      if(!bestHit || hit.penetration > bestHit.penetration) bestHit = hit;
    }
    if(!bestHit) break;

    player.position.x = bestHit.resolvedWorld.x;
    player.position.z = bestHit.resolvedWorld.z;

    const b = movementBounds();
    player.position.x = clamp(player.position.x, b.minX, b.maxX);
    player.position.z = clamp(player.position.z, b.minZ, b.maxZ);
    moved = true;
  }

  if(moved) playerGroup.position.copy(player.position);
  return moved;
}

function setCameraViewPreset(mode){
  cameraViewMode = mode;
  if(mode === 'top') camPitch = deg(-88);
  else if(mode === 'angle45') camPitch = deg(-45);
  else if(mode === 'level') camPitch = deg(0);
  updateCamera();
  const label = mode === 'top' ? '正上方俯視' : mode === 'angle45' ? '45度俯視' : '平視';
  setStatus(`視角模式：${label}。滾輪可調整與主角距離。`);
}

function getActorVisualYOffset(){
  return clamp(safeFinite(STATE?.player?.modelYOffset, 0.68), -1.2, 20.0);
}

function getActorWorldVisualYOffset(){
  return getActorVisualYOffset() * getActorInfectionScale();
}

function getCameraFollowScale(){
  // 不因腫瘤增長而拉遠鏡頭，維持跑動速度的視覺尺度。
  return Math.max(1, getActorBaseUiScale());
}

function updateCamera(){
  const actorScale = getActorScale();
  const followScale = getCameraFollowScale();
  const bodyTarget = player.position.clone().add(new THREE.Vector3(0, getActorWorldVisualYOffset() + 1.34 * actorScale, 0));
  const forward = getCameraForward();
  const right = getCameraRight(forward).normalize();
  const backward = forward.clone().multiplyScalar(-1);

  if(cameraViewMode !== 'shoulder'){
    const pitch = clamp(camPitch, CAMERA_PITCH_MIN, CAMERA_PITCH_MAX);
    const downAngle = clamp(-pitch, deg(-20), deg(89.2));
    const scaledDistance = cameraDistance * followScale;
    const horizontal = Math.max(0.001, Math.cos(downAngle) * scaledDistance);
    const height = Math.sin(downAngle) * scaledDistance;
    const camPos = bodyTarget.clone()
      .addScaledVector(backward, horizontal)
      .add(new THREE.Vector3(0, height, 0));
    camera.position.lerp(camPos, .32);
    camera.lookAt(bodyTarget);
    return;
  }

  // 越肩位置只做固定肩位與 zoom 距離；滑鼠上下控制的是 lookAt 的仰角。
  const scaledDistance = cameraDistance * followScale;
  const shoulderX = .62 * followScale;
  const shoulderY = .62 * followScale;
  const camPos = bodyTarget.clone()
    .addScaledVector(backward, scaledDistance)
    .addScaledVector(right, shoulderX)
    .add(new THREE.Vector3(0, shoulderY, 0));
  camera.position.lerp(camPos,.32);

  const aimDistance = 8.5 * followScale;
  const lookTarget = bodyTarget.clone()
    .addScaledVector(forward, aimDistance)
    .add(new THREE.Vector3(0, Math.tan(camPitch) * aimDistance, 0));
  camera.lookAt(lookTarget);
}

function zoomCamera(deltaY){
  const factor = deltaY > 0 ? 1.12 : .88;
  cameraDistance = clamp(cameraDistance * factor, CAMERA_DISTANCE_MIN, CAMERA_DISTANCE_MAX);
  updateCamera();
}

function getPlayerForward(){
  return getCameraForward();
}

function getSelectedWallObject(){
  if(selectedWallId) return STATE.customWalls.find(w=>w.id===selectedWallId) || null;
  return null;
}

function updatePendingWallPlacement(){
  if(!pendingWallId || !wallFollowPlayer || wallScaleMode || transformControls?.dragging) return;
  const w = STATE.customWalls.find(item=>item.id===pendingWallId);
  const mesh = customWallMeshes[pendingWallId];
  if(!w || !mesh) return;
  const f = getPlayerForward();
  const p = player.position.clone().addScaledVector(f,2.35);
  const b = wallPlacementBounds();
  w.position.x = clamp(p.x,b.minX,b.maxX);
  w.position.z = clamp(p.z,b.minZ,b.maxZ);
  if(!w.manualRotation){
    const ry = radToDeg(Math.atan2(f.x,f.z)) + 90;
    w.rotationY = ry;
    w.rotation = {x:0,y:ry,z:0};
  }
  applyWallMeshTransform(mesh,w);
}

function createWallAheadOptions(shape='straight'){
  const f = getPlayerForward();
  const p = player.position.clone().addScaledVector(f,2.35);
  const ry = radToDeg(Math.atan2(f.x,f.z)) + 90;
  const curved = shape === 'curved';
  return {
    id:uid('wall'), title:curved ? '曲面牆' : '自建牆',
    position:{x:clamp(p.x,wallPlacementBounds().minX,wallPlacementBounds().maxX), y:ROOM.height/2, z:clamp(p.z,wallPlacementBounds().minZ,wallPlacementBounds().maxZ)},
    rotationY:ry,
    rotation:{x:0,y:ry,z:0},
    size:{w:3.2,h:ROOM.height,t:.18},
    material:{color:'#d6d1c6',roughness:.95,metalness:0,texture:null,repeat:[1,1]},
    shape: curved ? 'curved' : 'straight',
    curve:{enabled:curved, amount:curved ? .35 : 0, direction:'front'},
    isDraft:true,
    manualRotation:false,
    chiselHoles:[]
  };
}

function addWallAhead(){
  return addWallAheadByShape('straight');
}

function addCurvedWallAhead(){
  return addWallAheadByShape('curved');
}

function addWallAheadByShape(shape='straight'){
  if(pendingWallId) confirmPendingWall();
  if(pendingArtworkId) confirmPendingArtwork();
  if(pendingFloorTileId) confirmPendingFloorTile();
  const wall = createWallAheadOptions(shape);
  STATE.customWalls.push(wall);
  pendingWallId = wall.id;
  wallFollowPlayer = true;
  selectedWallId = wall.id;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedArtworkActive = false;
  wallScaleMode = false;
  detachWallRotationControls();
  rebuildCustomWalls();
  syncWallEditor();
  renderObjectPanel();
  setStatus(isCurvedWall(wall) ? '已建立半透明曲面牆。移動角色可帶著牆面走；可用曲率與彎曲方向調整；Enter 固定。' : '已建立半透明直牆。移動角色可帶著牆面走；Shift+A 調整大小；Shift+T 旋轉；Enter 固定。');
}

function updatePendingArtworkPlacement(){
  if(!pendingArtworkId || !artworkFollowPlayer || transformControls?.dragging) return;
  const art = STATE.artworks.find(item=>item.id===pendingArtworkId);
  const group = artworkMeshes[pendingArtworkId];
  if(!art || !group) return;
  const f = getPlayerForward();
  const p = player.position.clone().addScaledVector(f,2.65);
  const b = wallPlacementBounds();
  art.position = art.position || {x:0,y:2.2,z:0};
  art.rotation = art.rotation || {x:0,y:0,z:0};
  art.position.x = clamp(p.x,b.minX,b.maxX);
  art.position.z = clamp(p.z,b.minZ,b.maxZ);
  art.position.y = safeFinite(art.position.y, player.position.y + 2.2);
  if(!art.manualRotation){
    art.rotation.x = 0;
    art.rotation.y = radToDeg(camYaw);
    art.rotation.z = 0;
  }
  if(art.snapToWall) snapArtworkToNearestWall(art);
  placeArtwork(art);
}

function confirmPendingArtwork(){
  if(!pendingArtworkId) return false;
  const art = STATE.artworks.find(item=>item.id===pendingArtworkId);
  if(!art) return false;
  updatePendingArtworkPlacement();
  art.isDraft = false;
  pendingArtworkId = null;
  artworkFollowPlayer = false;
  selectedArtworkActive = false;
  detachWallRotationControls();
  refreshArtworkSelectionVisuals();
  scheduleSave();
  setStatus('作品已固定為實體。可點選作品後按 Shift+T 進行 XYZ 旋轉。');
  return true;
}


function updatePendingFloorTilePlacement(){
  if(!pendingFloorTileId || !floorTileFollowPlayer || transformControls?.dragging) return;
  const tile = (STATE.floorTiles || []).find(item=>item.id===pendingFloorTileId);
  const mesh = floorTileMeshes[pendingFloorTileId];
  if(!tile || !mesh) return;
  const f = getPlayerForward();
  const p = player.position.clone().addScaledVector(f,2.45);
  const b = wallPlacementBounds();
  tile.position = tile.position || {x:0,y:-STATE.room.thickness/2,z:0};
  tile.position.x = clamp(p.x,b.minX,b.maxX);
  tile.position.z = clamp(p.z,b.minZ,b.maxZ);
  tile.position.y = safeFinite(tile.position.y, -safeFinite(tile.size?.t, STATE.room.thickness)/2);
  applyFloorTileMeshTransform(mesh, tile);
  const relief = groundReliefMeshes[`floorTile:${tile.id}`];
  if(relief){
    delete groundReliefMeshes[`floorTile:${tile.id}`];
    if(relief.parent) relief.parent.remove(relief);
    relief.geometry?.dispose?.();
    if(Array.isArray(relief.material)) relief.material.forEach(m=>m.dispose?.());
    else relief.material?.dispose?.();
    addGroundReliefForFloorTile(tile);
  }
}

function confirmPendingFloorTile(){
  if(!pendingFloorTileId) return false;
  const tile = (STATE.floorTiles || []).find(item=>item.id===pendingFloorTileId);
  if(!tile) return false;
  updatePendingFloorTilePlacement();
  tile.isDraft = false;
  pendingFloorTileId = null;
  floorTileFollowPlayer = false;
  selectedFloorTileId = null;
  rebuildFloorTiles();
  refreshWallSelectionVisuals();
  syncObjectEditor();
  scheduleSave();
  setStatus('地板塊已固定為實體。');
  return true;
}

function findWallAhead(){
  const origin = player.position.clone().add(new THREE.Vector3(0,1.05,0));
  const direction = getPlayerForward();
  const raycaster = new THREE.Raycaster(origin,direction,0,3.2);
  const wallObjects = [
    ...Object.entries(customWallMeshes).filter(([id])=>id!==pendingWallId).map(([id,mesh])=>mesh),
    ...WALL_KEYS.map(k=>surfaces[k]).filter(Boolean)
  ];
  const hits = raycaster.intersectObjects(wallObjects,false);
  if(hits.length){
    const obj = hits[0].object;
    if(obj.userData?.wallId) return {type:'custom', id:obj.userData.wallId};
    if(obj.userData?.surfaceKey) return {type:'room', key:obj.userData.surfaceKey};
  }
  let best = null, bestDist = 2.25;
  for(const [id,mesh] of Object.entries(customWallMeshes)){
    if(id===pendingWallId) continue;
    const d = mesh.position.distanceTo(player.position);
    if(d < bestDist){ bestDist = d; best = {type:'custom', id}; }
  }
  return best;
}

function deleteWallAhead(){
  const target = findWallAhead();
  if(!target){ setStatus('角色前方沒有可刪除的牆壁。'); return; }
  if(target.type==='custom') deleteWall(target.id);
  if(target.type==='room') deleteRoomWall(target.key);
  setStatus('已刪除角色前方／最近的牆壁。');
}

function deleteWall(id){
  if(!id) return false;
  STATE.customWalls = STATE.customWalls.filter(w=>w.id!==id);
  if(pendingWallId===id){ pendingWallId = null; wallFollowPlayer = false; wallScaleMode = false; }
  if(transformControls?.object?.userData?.wallId===id) detachWallRotationControls();
  if(selectedWallId===id) selectedWallId = null;
  selectedFloorTileId = null;
  selectedRoomWallKey = null;
  rebuildCustomWalls();
  syncWallSelect();
  syncWallEditor();
  syncObjectEditor();
  renderObjectPanel();
  scheduleSave();
  return true;
}

function deleteRoomWall(key){
  if(!DELETABLE_SURFACE_KEYS.includes(key)) return false;
  STATE.deletedSurfaces = Array.from(new Set([...(STATE.deletedSurfaces||[]), key]));
  if(selectedRoomWallKey===key) selectedRoomWallKey = null;
  buildRoom();
  syncSurfaceEditor();
  syncObjectEditor();
  renderObjectPanel();
  scheduleSave();
  return true;
}

function restoreRoomWalls(){
  STATE.deletedSurfaces = [];
  selectedRoomWallKey = null;
  buildRoom();
  syncSurfaceEditor();
  syncObjectEditor();
  renderObjectPanel();
  scheduleSave();
  setStatus('已恢復原始四面牆與天花板。');
}

function deleteSelectedWall(){
  if(selectedWallId) return deleteWall(selectedWallId);
  if(selectedRoomWallKey && DELETABLE_SURFACE_KEYS.includes(selectedRoomWallKey)) return deleteRoomWall(selectedRoomWallKey);
  return false;
}

function confirmPendingWall(){
  if(!pendingWallId) return false;
  const w = STATE.customWalls.find(item=>item.id===pendingWallId);
  if(!w) return false;
  updatePendingWallPlacement();
  w.isDraft = false;
  pendingWallId = null;
  wallFollowPlayer = false;
  wallScaleMode = false;
  selectedWallId = null;
  selectedFloorTileId = null;
  detachWallRotationControls();
  rebuildCustomWalls();
  const unstuck = resolvePlayerWallOverlaps();
  syncWallEditor();
  scheduleSave();
  setStatus(unstuck ? '牆面已固定為實體。角色已自動推出牆體，避免卡牆。' : '牆面已固定為實體。');
  return true;
}

function cancelWallEditModes(){
  wallScaleMode = false;
  detachWallRotationControls();
  refreshWallSelectionVisuals();
}

function stopScaleModesByKey(code='Escape'){
  const hadWallScale = !!wallScaleMode;
  const hadArtworkScale = !!artworkScaleMode;
  const hadMultiScale = !!multiObjectScaleMode;
  if(!hadWallScale && !hadArtworkScale && !hadMultiScale) return false;
  wallScaleMode = false;
  artworkScaleMode = false;
  multiObjectScaleMode = false;
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  syncWallEditor();
  syncArtEditor();
  syncObjectEditor();
  scheduleSave();
  setStatus(code === 'Enter' ? '已套用縮放並離開 Shift+A 縮放功能。' : '已離開 Shift+A 縮放功能。');
  return true;
}

function toggleWallScaleMode(){
  const wall = getSelectedWallObject();
  if(!wall){ setStatus('請先用 Shift+左鍵選取自建牆，或先新增牆面。'); return; }
  wallScaleMode = !wallScaleMode;
  if(wallScaleMode){
    detachWallRotationControls();
    desiredPointerLocked = false;
    cursorFreeMode = true;
    fallbackMouseLook = false;
    document.exitPointerLock?.();
    updateCursorVisibility();
    setStatus('牆面尺寸調整中：水平移動滑鼠改寬度，垂直移動滑鼠改高度。Enter 或 Esc 結束。');
  }else{
    scheduleSave();
    setStatus('已結束牆面尺寸調整。');
  }
}

function resizeSelectedWallByMouse(e){
  const wall = getSelectedWallObject();
  const mesh = wall ? customWallMeshes[wall.id] : null;
  if(!wall || !mesh){ wallScaleMode = false; return; }
  wall.size.w = clamp(wall.size.w + e.movementX*.025, .5, 500);
  wall.size.h = clamp(wall.size.h - e.movementY*.025, .5, 500);
  if(isCurvedWall(wall)) rebuildCustomWalls();
  else applyWallMeshTransform(mesh, wall);
  syncWallEditor();
  syncObjectEditor();
}

function getActiveArtworkForScale(){
  if(pendingArtworkId) return STATE.artworks.find(a=>a.id===pendingArtworkId) || null;
  if(selectedArtworkId && selectedArtworkActive) return STATE.artworks.find(a=>a.id===selectedArtworkId) || null;
  return null;
}

function toggleScaleModeForSelection(){
  if(toggleMultiObjectScaleMode()) return;
  const art = getActiveArtworkForScale();
  if(art){ toggleArtworkScaleMode(); return; }
  toggleWallScaleMode();
}

function toggleArtworkScaleMode(){
  const art = getActiveArtworkForScale() || getSelectedArt();
  if(!art){ setStatus('請先點選作品，或先匯入作品。'); return; }
  selectedArtworkId = art.id;
  selectedArtworkActive = true;
  artworkScaleMode = !artworkScaleMode;
  wallScaleMode = false;
  if(artworkScaleMode){
    detachWallRotationControls();
    desiredPointerLocked = false;
    cursorFreeMode = true;
    fallbackMouseLook = false;
    document.exitPointerLock?.();
    updateCursorVisibility();
    refreshArtworkSelectionVisuals();
    setStatus('作品等比縮放中：水平或垂直移動滑鼠會同時縮放寬、高、深；Enter 或 Esc 結束。');
  }else{
    scheduleSave();
    setStatus('已結束作品等比縮放。');
  }
}

function resizeSelectedArtworkByMouse(e){
  const art = getActiveArtworkForScale() || getSelectedArt();
  if(!art){ artworkScaleMode = false; return; }
  art.size = art.size || {w:art.type === 'model' ? 1.5 : 3, h:art.type === 'model' ? 1.5 : 3, d:art.type === 'model' ? 1.5 : 1};
  const delta = (safeFinite(e.movementX,0) - safeFinite(e.movementY,0)) * .006;
  const factor = clamp(1 + delta, .82, 1.22);
  art.size.w = clamp(safeFinite(art.size.w,3) * factor, .01, 500);
  art.size.h = clamp(safeFinite(art.size.h,3) * factor, .01, 500);
  art.size.d = clamp(safeFinite(art.size.d, art.type === 'model' ? 1.5 : 1) * factor, .01, 500);
  placeArtwork(art);
  syncArtEditor();
  syncObjectEditor();
}


function detachWallRotationControls(){
  if(transformControls){
    transformControls.detach();
    transformControls.visible = false;
    transformControls.enabled = false;
  }
  clearMultiTransformAnchor();
  selectedLightTransformMode = 'translate';
}

function attachRotationControls(id){
  const mesh = customWallMeshes[id];
  if(!mesh || !transformControls) return false;
  transformControls.attach(mesh);
  transformControls.setMode('rotate');
  transformControls.setSpace('local');
  transformControls.visible = true;
  transformControls.enabled = true;
  return true;
}

function attachArtworkRotationControls(id){
  const group = artworkMeshes[id];
  if(!group || !transformControls) return false;
  transformControls.attach(group);
  transformControls.setMode('rotate');
  transformControls.setSpace('local');
  transformControls.visible = true;
  transformControls.enabled = true;
  return true;
}

function attachLightTranslateControls(id){
  const group = lightControlObjects[id];
  if(!group || !transformControls) return false;
  selectedLightTransformMode = 'translate';
  transformControls.attach(group);
  transformControls.setMode('translate');
  transformControls.setSpace('world');
  transformControls.visible = true;
  transformControls.enabled = true;
  return true;
}

function attachLightRotationControls(id){
  const light = (STATE.lightSystem?.lights || []).find(l=>l.id===id);
  const group = lightControlObjects[id];
  if(!light || !group || !transformControls) return false;
  if(light.type !== 'directional' && light.type !== 'spot'){
    setStatus('點光源沒有照射方向；請選取聚光燈或平行光後再按 Shift+T。');
    return false;
  }
  selectedLightTransformMode = 'rotate';
  alignLightControlToTarget(group, light);
  transformControls.attach(group);
  transformControls.setMode('rotate');
  transformControls.setSpace('local');
  transformControls.visible = true;
  transformControls.enabled = true;
  return true;
}

function selectLightObject(id){
  const light = (STATE.lightSystem?.lights || []).find(l=>l.id===id);
  if(!light) return false;
  selectedLightId = id;
  selectedLightObjectActive = true;
  selectedArtworkActive = false;
  selectedWallId = null;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedWaterBodyId = null;
  selectedReferenceArchitectureActive = false;
  selectedGroupId = null;
  clearObjectMultiSelection();
  wallScaleMode = false;
  desiredPointerLocked = false;
  cursorFreeMode = true;
  fallbackMouseLook = false;
  document.exitPointerLock?.();
  updateCursorVisibility();
  attachLightTranslateControls(id);
  syncLightEditor();
  syncObjectEditor();
  renderObjectPanel();
  setStatus(`已選取光源：${light.title || light.id}。可直接拖拉 XYZ 軸移動光源位置；聚光燈／平行光可按 Shift+T 旋轉照射角度，也可在「光照系統」視窗輸入精確目標座標。`);
  return true;
}

function activateWallRotationControls(){
  if(activateMultiRotationControls()) return;
  if(selectedLightObjectActive && selectedLightId){
    const light = (STATE.lightSystem?.lights || []).find(l=>l.id===selectedLightId);
    desiredPointerLocked = false;
    cursorFreeMode = true;
    fallbackMouseLook = false;
    document.exitPointerLock?.();
    updateCursorVisibility();
    if(light?.type === 'directional' || light?.type === 'spot'){
      if(attachLightRotationControls(selectedLightId)) setStatus(`已開啟光源照射角度旋轉軸：${light.title || light.id}。拖拉 XYZ 旋轉軸會改變目標座標與實際照射方向；Esc 關閉旋轉軸。`);
      return;
    }
    setStatus('點光源沒有照射方向；請選取聚光燈或平行光後再按 Shift+T。');
    return;
  }
  if(selectedArtworkActive && selectedArtworkId && artworkMeshes[selectedArtworkId]){
    wallScaleMode = false;
    selectedWallId = null;
    selectedRoomWallKey = null;
    selectedFloorTileId = null;
    desiredPointerLocked = false;
    cursorFreeMode = true;
    fallbackMouseLook = false;
    document.exitPointerLock?.();
    updateCursorVisibility();
    if(attachArtworkRotationControls(selectedArtworkId)) setStatus('已開啟作品 XYZ 旋轉軸。拖拉軸線旋轉；若作品仍為半透明草稿，按 Enter 固定。');
    return;
  }
  const wall = getSelectedWallObject();
  if(!wall){ setStatus('請先選取自建牆或作品。選取後按 Shift+T 開啟 XYZ 旋轉軸。'); return; }
  wallScaleMode = false;
  selectedRoomWallKey = null;
  selectedArtworkActive = false;
  desiredPointerLocked = false;
  cursorFreeMode = true;
  fallbackMouseLook = false;
  document.exitPointerLock?.();
  updateCursorVisibility();
  if(attachRotationControls(wall.id)) setStatus('已開啟牆面 XYZ 旋轉軸。拖拉軸線旋轉；Enter 固定新增牆；Esc 關閉旋轉軸。');
}

function syncWallFromTransformControls(){
  const obj = transformControls?.object;
  if(obj?.userData?.multiTransformAnchor){ syncMultiTransformFromControls(); return; }
  const lightId = findUserDataValueInHierarchy(obj, 'lightId', scene);
  if(lightId){
    const light = (STATE.lightSystem?.lights || []).find(l=>l.id===lightId);
    if(!light || !obj) return;
    const mode = transformControls?.getMode?.() || transformControls?.mode || selectedLightTransformMode;
    if(mode === 'rotate' || selectedLightTransformMode === 'rotate'){
      updateLightTargetFromControlRotation(light, obj);
    }else{
      light.position = {x:obj.position.x, y:obj.position.y, z:obj.position.z};
    }
    syncLightEditor();
    renderObjectPanel();
    scheduleSave();
    return;
  }
  const artId = obj?.userData?.artId;
  if(artId){
    const art = STATE.artworks.find(a=>a.id===artId);
    if(!art || !obj) return;
    art.position = {x:obj.position.x, y:obj.position.y, z:obj.position.z};
    art.rotation = {x:radToDeg(obj.rotation.x), y:radToDeg(obj.rotation.y), z:radToDeg(obj.rotation.z)};
    art.manualRotation = true;
    syncArtEditor();
    refreshArtworkSelectionVisuals();
    if(!art.isDraft) scheduleSave();
    return;
  }
  const id = obj?.userData?.wallId;
  const wall = id ? STATE.customWalls.find(w=>w.id===id) : null;
  if(!wall || !obj) return;
  wall.rotation = {x:radToDeg(obj.rotation.x), y:radToDeg(obj.rotation.y), z:radToDeg(obj.rotation.z)};
  wall.rotationY = wall.rotation.y;
  wall.position.x = obj.position.x;
  wall.position.z = obj.position.z;
  wall.manualRotation = true;
  syncWallEditor();
  syncObjectEditor();
  if(!wall.isDraft) scheduleSave();
}



function resetRuntimeSelectionForReferenceScene(){
  selectedArtworkId = STATE.artworks?.[0]?.id || null;
  selectedArtworkActive = false;
  selectedWallId = null;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedWaterBodyId = STATE.waterBodies?.[0]?.id || null;
  pendingWallId = null;
  pendingFloorTileId = null;
  pendingWaterBodyId = null;
  pendingArtworkId = null;
  wallFollowPlayer = false;
  floorTileFollowPlayer = false;
  waterBodyFollowPlayer = false;
  artworkFollowPlayer = false;
  wallScaleMode = false;
  detachWallRotationControls();
}

function rebuildSceneAfterReferencePreset(){
  applyEnvironmentColors();
  buildSkyBackground();
  buildAtmosphereEffect();
  applyScreenFx();
  rebuildLightSystem();
  buildRoom();
  buildReferenceArchitecture();
  buildWaterBodies();
  buildArtworks();
  applyObjectVisibilityLocks();
  renderObjectPanel();
  syncAllEditor();
}

function buildReferenceArchitecturePreset(){
  pushUndoState('cross space preset');
  STATE = applyReferenceArchitecturePresetToState(STATE || createDefaultState(), {resetIds:true});
  player.position.set(0,0,5.8);
  playerVelocityY = 0;
  playerGroup?.position.copy(player.position);
  camYaw = 0;
  camPitch = deg(-8);
  cameraDistance = 4.35 * Math.pow(1.12, 3);
  resetRuntimeSelectionForReferenceScene();
  rebuildSceneAfterReferencePreset();
  scheduleSave();
  setStatus('已建立空白十字空間：原參考圖建築、作品、水體與獨立光源均未載入。');
}

function toggleReferenceArchitecture(){
  const nextVisible = !((STATE.customWalls || []).some(w=>w.visible !== false) || (STATE.floorTiles || []).some(t=>t.visible !== false));
  for(const w of STATE.customWalls || []) if(String(w.id || '').startsWith('cross_wall_')) w.visible = nextVisible;
  for(const t of STATE.floorTiles || []) if(String(t.id || '').startsWith('cross_floor_')) t.visible = nextVisible;
  rebuildCustomWalls();
  rebuildFloorTiles();
  applyObjectVisibilityLocks();
  renderObjectPanel();
  scheduleSave();
  setStatus(nextVisible ? '已顯示十字空間牆面與地面。' : '已隱藏十字空間牆面與地面。');
}

function sinProValue(id, fallback=''){
  const el = $(id);
  return el ? el.value : fallback;
}

function sinProNumber(id, fallback=0){
  return safeFinite(sinProValue(id, fallback), fallback);
}

function sinProSetValue(id, value){
  const el = $(id);
  if(el) el.value = value;
}

function ensureSinProEditorStructure(){
  const controlNode = id=>{
    const el = $(id);
    if(!el) return null;
    return el.closest('.sin-pro-grid2,.sin-pro-grid3,.sin-pro-actions') || el.closest('.sin-pro-field') || el;
  };
  const addGroup = (sectionId, title, ids, extras=[], open=true) => {
    const section = $(sectionId);
    if(!section) return;
    const details = document.createElement('details');
    details.className = 'sin-pro-control-group';
    details.open = open;
    const summary = document.createElement('summary');
    summary.textContent = title;
    const body = document.createElement('div');
    body.className = 'sin-pro-control-group-body';
    const nodes = [...ids.map(controlNode), ...extras].filter(Boolean);
    const moved = new Set();
    for(const node of nodes){
      if(moved.has(node) || node.closest?.('.sin-pro-control-group')) continue;
      moved.add(node);
      body.appendChild(node);
    }
    if(!body.childNodes.length) return;
    details.append(summary, body);
    section.appendChild(details);
  };

  const sceneSection = $('sinProSectionScenes');
  if(sceneSection && sceneSection.dataset.organized !== '1'){
    addGroup('sinProSectionScenes', '場景基本資料', ['sinSceneTitle','sinSceneType','sinSceneSkyColor'], [...sceneSection.querySelectorAll('.sin-pro-help')]);
    addGroup('sinProSectionScenes', '出生點與場景範圍', ['sinSceneSpawnX','sinSceneWidth','sinSceneApply'], [], false);
    sceneSection.dataset.organized = '1';
  }

  const propSection = $('sinProSectionProps');
  if(propSection && propSection.dataset.organized !== '1'){
    addGroup('sinProSectionProps', 'PNG／GIF、位置與動作', ['sinPropMediaType','sinPropPngSequence','sinPropGif','sinPropName','sinPropStep','sinPropOffsetZ','sinPropFps','sinPropFloatAmp','sinPropAdd','sinPropDelete']);
    propSection.dataset.organized = '1';
  }

  const modelSection = $('sinProSectionModels');
  if(modelSection && modelSection.dataset.organized !== '1'){
    addGroup('sinProSectionModels', '模型檔案與名稱', ['sinModelFile','sinModelTexture','sinModelName','sinModelState']);
    addGroup('sinProSectionModels', '位置、尺寸與旋轉', ['sinModelX','sinModelScaleX','sinModelRotX','sinModelAdd','sinModelApply','sinModelCarry','sinModelDelete']);
    modelSection.dataset.organized = '1';
  }

  const portalSection = $('sinProSectionPortals');
  if(portalSection && portalSection.dataset.organized !== '1'){
    addGroup('sinProSectionPortals', '傳送門目標與位置', ['sinPortalName','sinPortalSource','sinPortalTarget','sinPortalStep','sinPortalOffsetZ','sinPortalColor','sinPortalAdd','sinPortalDelete']);
    portalSection.dataset.organized = '1';
  }

  const stoneSection = $('sinProSectionStones');
  if(stoneSection && stoneSection.dataset.organized !== '1'){
    const sharedHelp = stoneSection.querySelector('.sin-pro-help');
    addGroup('sinProSectionStones', '目前場景共用材質', ['sinStoneSharedTexture','sinStoneSharedTextureState','sinStoneSharedTexturePreview','sinStoneSharedMapping','sinStoneApplySharedAll'], sharedHelp ? [sharedHelp] : [], false);
    addGroup('sinProSectionStones', '選取石塊', ['sinStoneShape','sinStoneSurface','sinStoneTexture','sinStoneTextureState','sinStoneTexturePreview','sinStoneMapping','sinStoneColor','sinStoneUseShared','sinStoneX','sinStoneScaleX','sinStoneRotX','sinStoneAdd','sinStoneCarry','sinStoneCarryState','sinStoneDelete']);
    addGroup('sinProSectionStones', '破敗教堂生成器', ['sinChurchWidth','sinChurchSeed','sinChurchGenerate'], [...stoneSection.querySelectorAll('.sin-pro-cave-callout')], false);
    stoneSection.dataset.organized = '1';
  }

  const infectionSection = $('sinProSectionInfection');
  if(infectionSection && infectionSection.dataset.organized !== '1'){
    addGroup('sinProSectionInfection', '腫瘤與觸手參數', ['sinProInfectionMount','sinProRebuildInfection'], [...infectionSection.querySelectorAll('.sin-pro-muted')]);
    infectionSection.dataset.organized = '1';
  }
}

function applySinPerfPreset(preset){
  const values = {
    smooth:{sprite:512, texture:1024, quality:.68},
    standard:{sprite:768, texture:1536, quality:.78},
    quality:{sprite:1024, texture:2048, quality:.88}
  }[preset];
  if(!values) return;
  sinProSetValue('sinPerfSpriteMaxSize', values.sprite);
  sinProSetValue('sinPerfTextureMaxSize', values.texture);
  sinProSetValue('sinPerfTextureQuality', values.quality);
}

function ensureSinPerfPanel(){
  const section = $('sinProSectionPerf');
  if(!section || section.dataset.organized === '1') return;
  const heading = section.querySelector(':scope > .sin-pro-heading');
  if(!heading) return;
  const intro = document.createElement('div');
  intro.className = 'sin-pro-perf-intro';
  intro.innerHTML = '<strong>這裡只管理上傳圖片</strong>預設會先縮小過大的 PNG／材質圖片，降低記憶體與載入時間。數值越高越清晰，也越吃記憶體；腫瘤與觸手的顯示優化由系統自動處理。';
  const presetLabel = document.createElement('label');
  presetLabel.className = 'sin-pro-field';
  presetLabel.textContent = '快速預設';
  const preset = document.createElement('select');
  preset.id = 'sinPerfPreset';
  preset.innerHTML = '<option value="smooth">流暢：低記憶體，適合大量素材</option><option value="standard">標準：畫質與效能平衡</option><option value="quality">高畫質：圖片較清晰</option><option value="custom">自訂：自行調整進階數值</option>';
  presetLabel.appendChild(preset);
  const summary = document.createElement('div');
  summary.id = 'sinPerfSummary';
  summary.className = 'sin-pro-perf-summary';
  const advanced = document.createElement('details');
  advanced.className = 'sin-pro-advanced';
  advanced.innerHTML = '<summary>進階設定（通常不需要修改）</summary>';
  for(const id of ['sinPerfSpriteMaxSize','sinPerfTextureMaxSize','sinPerfTextureQuality','sinPerfStats']){
    const field = $(id)?.closest('.sin-pro-field');
    if(field) advanced.appendChild(field);
  }
  heading.after(intro, presetLabel, summary, advanced);
  preset.onchange = ()=>{
    if(preset.value !== 'custom') applySinPerfPreset(preset.value);
    syncSinPerfPanel();
  };
  section.dataset.organized = '1';
}

function syncSinPerfPanel(){
  const select = $('sinPerfPreset');
  const summary = $('sinPerfSummary');
  if(!select || !summary) return;
  const sprite = clamp(sinProNumber('sinPerfSpriteMaxSize', 768),128,2048);
  const texture = clamp(sinProNumber('sinPerfTextureMaxSize',1536),256,4096);
  const quality = clamp(sinProNumber('sinPerfTextureQuality',.78),.3,.95);
  const presets = {smooth:[512,1024,.68],standard:[768,1536,.78],quality:[1024,2048,.88]};
  const matched = Object.entries(presets).find(([,v])=>v[0]===sprite && v[1]===texture && Math.abs(v[2]-quality)<.005)?.[0] || 'custom';
  select.value = matched;
  const frameCount = SIN_TOWER_EDITOR.props.reduce((sum,p)=>sum + (p.frames?.length || 0), 0) + (SIN_TOWER_MONKS.spriteFrames?.length || 0);
  const stoneCount = SIN_TOWER_EDITOR.stones.length;
  summary.innerHTML = `<div class="sin-pro-perf-card"><strong>PNG 影格</strong><span>上限 ${sprite}px<br>${frameCount} 張已載入</span></div><div class="sin-pro-perf-card"><strong>石塊材質</strong><span>上限 ${texture}px<br>${stoneCount} 塊石頭</span></div><div class="sin-pro-perf-card"><strong>圖片品質</strong><span>${Math.round(quality * 100)}%<br>越高越清晰、越吃記憶體</span></div>`;
}

function syncSinProPropMediaUi(){
  const gif=$('sinPropMediaType')?.value==='gif';
  document.querySelectorAll('.sin-pro-prop-png').forEach(el=>el.hidden=gif);
  document.querySelectorAll('.sin-pro-prop-gif').forEach(el=>el.hidden=!gif);
  if($('sinPropAdd')) $('sinPropAdd').textContent=gif?'加入 GIF 動畫':'加入 PNG 序列';
}

function setSinProTab(tab){
  SIN_TOWER_EDITOR.ui.activeTab = ['scenes','props','models','portals','stones','infection','perf'].includes(tab) ? tab : 'scenes';
  for(const btn of document.querySelectorAll('#sinProEditor [data-sin-pro-tab]')){
    btn.classList.toggle('active', btn.dataset.sinProTab === SIN_TOWER_EDITOR.ui.activeTab);
  }
  for(const [name,id] of [['scenes','sinProSectionScenes'],['props','sinProSectionProps'],['models','sinProSectionModels'],['portals','sinProSectionPortals'],['stones','sinProSectionStones'],['infection','sinProSectionInfection'],['perf','sinProSectionPerf']]){
    const el = $(id);
    if(el) el.classList.toggle('active', name === SIN_TOWER_EDITOR.ui.activeTab);
  }
}

function enterSinTowerEditorMode(){
  if(SIN_TOWER_PUBLISHED)return;
  document.body.classList.remove('sin-cursor-closing');
  finishSinTowerObjectCursorMode();
  closeSinTowerShortcutHelp(false,false);
  closeSinTowerPlayAddPanel(false);
  closeSinTowerInteraction(false,false,true);
  sinTowerStonePickMode.active = false;
  sinTowerStonePickMode.selectedId = null;
  document.body.classList.remove('sin-stone-pick-mode');
  pendingEscRelock = false;
  desiredPointerLocked = false;
  fallbackMouseLook = false;
  resetFallbackLookAnchor();
  cursorFreeMode = true;
  pointerLocked = false;
  try{ if(document.pointerLockElement) document.exitPointerLock?.(); }catch(e){}
  document.body.classList.remove('play-mode');
  document.body.classList.add('sin-pro-editor-active');
  updateCursorVisibility();
  applyPlayModePerformanceLighting(false);
}

function toggleSinTowerEditorMode(){
  if(isPlayMode()) enterSinTowerEditorMode();
  else enterDefaultSinTowerPlayMode();
}

function selectSinTowerEditorObject(type, id, tab=null){
  SIN_TOWER_EDITOR.selectedObjectType = type;
  SIN_TOWER_EDITOR.selectedObjectId = id;
  if(tab) SIN_TOWER_EDITOR.ui.activeTab = tab;
  syncSinProEditor();
}

function createSinTowerEditorScene(type='empty', options={}){
  const active = getSinTowerActiveScene();
  const id = uid('scene');
  const title = options.title || (type === 'church' ? `破敗教堂 ${SIN_TOWER_EDITOR.scenes.length}` : `場景 ${SIN_TOWER_EDITOR.scenes.length}`);
  const dimensions = sinTowerEditorDimensions(options.dimensions, type === 'church' ? {w:20,h:11,d:32} : {w:18,h:10,d:24});
  const sceneState = sanitizeSinTowerEditorScene({id,title,type,dimensions,spawn:options.spawn || {x:0,y:type === 'church' ? .24 : 0,z:type === 'church' ? dimensions.d/2 - 3 : 0}, skybox:type === 'church' ? {color:'#d8bc62'} : undefined});
  SIN_TOWER_EDITOR.scenes.push(sceneState);
  if(type === 'church') ensureSinTowerBundledBookModel(sceneState);
  if(options.withPortal && active){
    const currentStep = getSinTowerCurrentStepIndex();
    SIN_TOWER_EDITOR.portals.push(sanitizeSinTowerEditorPortal({
      sceneId:active.id,
      targetSceneId:id,
      title:`前往 ${sceneState.title}`,
      step:currentStep + 8,
      offset:{x:0,y:1.15,z:0},
      color:'#65d7ff',
      passwordEnabled:active.type!=='church',
      password:'B2F7'
    }));
    SIN_TOWER_EDITOR.portals.push(sanitizeSinTowerEditorPortal({
      sceneId:id,
      targetSceneId:active.id,
      title:`返回 ${active.title}`,
      offset:{x:0,y:1.2,z:dimensions.d/2 - 2},
      width:1.8,
      height:2.6,
      color:'#ffd36a',
      passwordEnabled:false,
      password:'B2F7'
    }));
  }
  setSinTowerActiveScene(id, {silent:true});
  SIN_TOWER_EDITOR.ui.activeTab = 'scenes';
  syncSinProEditor();
  setStatus(`已建立場景：${sceneState.title}`);
  return sceneState;
}

function applySinTowerSceneFromUi(){
  const sceneState = getSinTowerActiveScene();
  if(!sceneState) return;
  sceneState.title = String(sinProValue('sinSceneTitle', sceneState.title)).trim().slice(0,80) || sceneState.title;
  sceneState.type = ['stairs','church','empty'].includes(sinProValue('sinSceneType', sceneState.type)) ? sinProValue('sinSceneType', sceneState.type) : sceneState.type;
  sceneState.spawn = {
    x:sinProNumber('sinSceneSpawnX', sceneState.spawn.x),
    y:sinProNumber('sinSceneSpawnY', sceneState.spawn.y),
    z:sinProNumber('sinSceneSpawnZ', sceneState.spawn.z)
  };
  sceneState.dimensions = sinTowerEditorDimensions({
    w:sinProNumber('sinSceneWidth', sceneState.dimensions.w),
    h:sinProNumber('sinSceneHeight', sceneState.dimensions.h),
    d:sinProNumber('sinSceneDepth', sceneState.dimensions.d)
  }, sceneState.dimensions);
  sceneState.skybox = sanitizeSinTowerEditorSkybox({color:sinProValue('sinSceneSkyColor', sceneState.skybox?.color)}, sceneState.type);
  ensureSinTowerEditorState();
  rebuildSinTowerEditorRuntime();
  scheduleSinTowerRuntimeSave();
  setStatus(`已更新場景：${sceneState.title}`);
}

function deleteSinTowerSceneById(sceneId){
  const target = SIN_TOWER_EDITOR.scenes.find(sceneState=>sceneState.id === sceneId);
  if(!target) return false;
  if(SIN_TOWER_EDITOR.scenes.length <= 1){
    setStatus('至少要保留一個場景；請先新增另一個場景再刪除。');
    return false;
  }
  const next = SIN_TOWER_EDITOR.scenes.find(sceneState=>sceneState.id !== target.id);
  SIN_TOWER_EDITOR.scenes = SIN_TOWER_EDITOR.scenes.filter(sceneState=>sceneState.id !== target.id);
  SIN_TOWER_EDITOR.props = SIN_TOWER_EDITOR.props.filter(prop=>prop.sceneId !== target.id);
  SIN_TOWER_EDITOR.models = SIN_TOWER_EDITOR.models.filter(model=>model.sceneId !== target.id);
  SIN_TOWER_EDITOR.portals = SIN_TOWER_EDITOR.portals.filter(portal=>portal.sceneId !== target.id && portal.targetSceneId !== target.id);
  SIN_TOWER_EDITOR.stones = SIN_TOWER_EDITOR.stones.filter(stone=>stone.sceneId !== target.id);
  SIN_TOWER_EDITOR.selectedObjectId = null;
  SIN_TOWER_EDITOR.selectedObjectType = null;
  setSinTowerActiveScene(next.id,{silent:true});
  syncSinProEditor();
  scheduleSinTowerRuntimeSave();
  setStatus('已刪除場景：' + target.title);
  return true;
}

function deleteSinTowerActiveScene(){
  return deleteSinTowerSceneById(SIN_TOWER_EDITOR.activeSceneId);
}

async function readSinTowerEditorPngFrames(fileList){
  const files = Array.from(fileList || [])
    .filter(f=>/\.png$/i.test(f.name || ''))
    .sort(naturalSinTowerFileSort)
    .slice(0,120);
  const frames = [];
  for(let fileIndex=0;fileIndex<files.length;fileIndex++){
    const file = files[fileIndex];
    setSinPlayObjectStatus?.('PNG '+(fileIndex+1)+'/'+files.length+'：讀取與最佳化……');
    const dataUrl = await readAsDataURL(file, {maxSize:SIN_TOWER_EDITOR.perf.spriteMaxSize, preserveAlpha:true, mimeType:'image/png'});
    setSinPlayObjectStatus?.('PNG '+(fileIndex+1)+'/'+files.length+'：確認尺寸……');
    const size = await readImageDimensions(dataUrl);
    frames.push(sanitizeSinTowerEditorFrame({
      dataUrl,
      ratio:size?.width && size?.height ? size.width / size.height : .65,
      no:sinTowerPngFrameNumber(file) || frames.length + 1,
      name:file.name || ''
    }, frames.length));
  }
  return frames.filter(Boolean).sort((a,b)=>a.no-b.no || String(a.name).localeCompare(String(b.name), undefined, {numeric:true}));
}

function sinTowerPropFromUi(base=null){
  const uiMedia = sinProValue('sinPropMediaType',base?.mediaType||'pngSequence');
  return sanitizeSinTowerEditorProp({
    ...(base || {}),
    sceneId:SIN_TOWER_EDITOR.activeSceneId,
    mediaType:uiMedia === 'gif' ? 'gif' : 'pngSequence',
    title:sinProValue('sinPropName', base?.title || '動畫物件'),
    step:sinProNumber('sinPropStep', base?.step || 12),
    offset:{
      x:sinProNumber('sinPropOffsetX', base?.offset?.x ?? -4.5),
      y:sinProNumber('sinPropOffsetY', base?.offset?.y ?? 0),
      z:sinProNumber('sinPropOffsetZ', base?.offset?.z ?? 0)
    },
    height:sinProNumber('sinPropHeight', base?.height || 2),
    widthMul:sinProNumber('sinPropWidthMul', base?.widthMul || 1),
    fps:sinProNumber('sinPropFps', base?.fps || 12),
    motion:sinProValue('sinPropMotion', base?.motion || 'float'),
    floatAmp:sinProNumber('sinPropFloatAmp', base?.floatAmp ?? .18),
    patrolAxis:sinProValue('sinPropPatrolAxis', base?.patrolAxis || 'x'),
    patrolDistance:sinProNumber('sinPropPatrolDistance', base?.patrolDistance || 2),
    patrolSpeed:sinProNumber('sinPropPatrolSpeed', base?.patrolSpeed || .65),
    frames:base?.frames || []
  });
}

function selectedSinTowerEditorModel(){
  return SIN_TOWER_EDITOR.selectedObjectType === 'model' ? getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId,'model') : null;
}

function setSinTowerModelUniformScale(value){
  const scale = clamp(safeFinite(value,1),.01,20);
  for(const id of ['sinModelScaleX','sinModelScaleY','sinModelScaleZ']) sinProSetValue(id,scale);
  if($('sinModelUniformScaleValue')) $('sinModelUniformScaleValue').textContent = scale.toFixed(2);
  return updateSinTowerModelFromUi();
}

function updateSinTowerModelFromUi(){
  const model = selectedSinTowerEditorModel();
  if(!model){ setStatus('請先從物件管理清單或畫面點選 3D 模型。'); return false; }
  model.title = String(sinProValue('sinModelName',model.title)).trim().slice(0,80) || model.title;
  model.position = {x:sinProNumber('sinModelX',model.position.x),y:sinProNumber('sinModelY',model.position.y),z:sinProNumber('sinModelZ',model.position.z)};
  model.scale = {x:Math.max(.01,sinProNumber('sinModelScaleX',model.scale.x)),y:Math.max(.01,sinProNumber('sinModelScaleY',model.scale.y)),z:Math.max(.01,sinProNumber('sinModelScaleZ',model.scale.z))};
  model.rotation = {x:sinProNumber('sinModelRotX',model.rotation.x),y:sinProNumber('sinModelRotY',model.rotation.y),z:sinProNumber('sinModelRotZ',model.rotation.z)};
  const rec = sinTowerEditorRuntime.models.get(model.id);
  if(rec) rec.model = model;
  applySinTowerEditorModelTransform(rec);
  rec?.group?.updateMatrixWorld?.(true);
  const uniform = (model.scale.x + model.scale.y + model.scale.z) / 3;
  if($('sinModelUniformScale') && document.activeElement !== $('sinModelUniformScale')) $('sinModelUniformScale').value = clamp(uniform,.01,20);
  if($('sinModelUniformScaleValue')) $('sinModelUniformScaleValue').textContent = uniform.toFixed(2);
  scheduleSinTowerRuntimeSave();
  syncSinProSceneList();
  syncSinProObjectList();
  return true;
}

function validateSinTowerGlbBuffer(buffer){
  if(!(buffer instanceof ArrayBuffer) || buffer.byteLength < 20) throw new Error('檔案太小，不是有效的 GLB。');
  const view = new DataView(buffer,0,Math.min(buffer.byteLength,20));
  if(view.getUint32(0,true) !== 0x46546c67) throw new Error('檔案標頭不是 glTF Binary（GLB）。');
  if(view.getUint32(4,true) !== 2) throw new Error('目前只支援 GLB 2.0。');
  const declared = view.getUint32(8,true);
  if(declared > buffer.byteLength || declared < 20) throw new Error('GLB 檔案長度標記損壞。');
  return true;
}

async function addSinTowerEditorModelFromUi(){
  const button = $('sinModelAdd');
  const file = $('sinModelFile')?.files?.[0];
  if(!file || !/\.glb$/i.test(file.name || '')){ setStatus('請選擇一個 GLB 模型。'); return; }
  if(file.size > 90 * 1024 * 1024){ setStatus('GLB 超過 90 MB，請先減面或壓縮後再匯入。'); return; }
  if(button) button.disabled = true;
  try{
    setStatus('正在驗證 GLB 二進位資料……');
    const runtimeBuffer = await file.arrayBuffer();
    validateSinTowerGlbBuffer(runtimeBuffer);
    const textureFile = $('sinModelTexture')?.files?.[0];
    let textureDataUrl = null;
    if(textureFile){
      if(!/^image\/(?:png|jpeg|webp)$/i.test(textureFile.type || '') && !/\.(?:png|jpe?g|webp)$/i.test(textureFile.name || '')) throw new Error('外部貼圖只支援 PNG、JPG 或 WebP。');
      setStatus('正在最佳化外部貼圖……');
      textureDataUrl = await optimizeImageFileForDataUrl(textureFile,{maxSize:SIN_TOWER_EDITOR.perf.textureMaxSize,quality:SIN_TOWER_EDITOR.perf.textureQuality,preserveAlpha:/png|webp/i.test(textureFile.type || textureFile.name || '')});
    }
    setStatus('正在準備模型儲存資料……');
    const modelDataUrl = await readFileAsDataURL(file);
    const forward = getPlayerForward();
    const position = player.position.clone().addScaledVector(forward,2.5);
    position.y = Math.max(position.y + .45,safeFinite(getPlayerGroundY(),0)+.45);
    const model = sanitizeSinTowerEditorModel({
      id:uid('model'),sceneId:SIN_TOWER_EDITOR.activeSceneId,title:String($('sinModelName')?.value || file.name.replace(/\.[^.]+$/,'')),modelDataUrl,modelName:file.name,textureDataUrl,textureName:textureFile?.name || '',
      position:{x:position.x,y:position.y,z:position.z},rotation:{x:0,y:0,z:0},scale:{x:1,y:1,z:1}
    });
    if(!model.modelDataUrl) throw new Error('瀏覽器未能保存 GLB 資料；請重新選擇檔案。');
    Object.defineProperty(model,'_runtimeArrayBuffer',{value:runtimeBuffer,writable:true,configurable:true,enumerable:false});
    Object.defineProperty(model,'_importPending',{value:true,writable:true,configurable:true,enumerable:false});
    SIN_TOWER_EDITOR.models.push(model);
    SIN_TOWER_EDITOR.selectedObjectType = 'model';
    SIN_TOWER_EDITOR.selectedObjectId = model.id;
    $('sinModelFile').value = '';
    $('sinModelTexture').value = '';
    setStatus('GLB 已驗證，正在解析 3D 模型：' + model.title + '……大型模型可能需要數秒。');
    // Build only the imported model. Rebuilding the complete church would
    // recreate every stone and strip the temporary binary buffer before GLTF
    // parsing, which made large imports slower and left the UI stuck at
    // "正在解析" even after a successful load.
    await buildSinTowerEditorModel(model);
    if(!sinTowerEditorRuntime.models.has(model.id)){
      SIN_TOWER_EDITOR.models = SIN_TOWER_EDITOR.models.filter(item=>item.id !== model.id);
      SIN_TOWER_EDITOR.selectedObjectType = null;
      SIN_TOWER_EDITOR.selectedObjectId = null;
      syncSinProEditor();
      return;
    }
    applySinTowerEditorSceneVisibility();
    scheduleSinTowerRuntimeSave();
    syncSinProEditor();
  }catch(error){
    console.warn('Sin Tower 3D import rejected',error);
    setStatus('3D 模型匯入失敗：' + String(error?.message || error || '未知錯誤').slice(0,180));
  }finally{
    if(button) button.disabled = false;
  }
}

function deleteSinTowerSelectedModel(){
  const model = selectedSinTowerEditorModel();
  if(!model) return false;
  SIN_TOWER_EDITOR.models = SIN_TOWER_EDITOR.models.filter(item=>item.id !== model.id);
  if(sinTowerModelCarry.id === model.id){ sinTowerModelCarry.active = false; sinTowerModelCarry.id = null; }
  SIN_TOWER_EDITOR.selectedObjectType = null;
  SIN_TOWER_EDITOR.selectedObjectId = null;
  rebuildSinTowerEditorRuntime();
  scheduleSinTowerRuntimeSave();
  syncSinProEditor();
  setStatus('已刪除 3D 模型：' + model.title);
  return true;
}

function updateSinTowerModelCarry(){
  if(!sinTowerModelCarry.active) return;
  const model = getSinTowerEditorObjectById(sinTowerModelCarry.id,'model');
  if(!model || model.sceneId !== SIN_TOWER_EDITOR.activeSceneId){
    sinTowerModelCarry.active = false;
    sinTowerModelCarry.id = null;
    return;
  }
  const forward = getPlayerForward();
  const position = player.position.clone().addScaledVector(forward,2.5);
  position.y = Math.max(player.position.y + .45,safeFinite(getPlayerGroundY(),0)+.45);
  model.position = {x:position.x,y:position.y,z:position.z};
  applySinTowerEditorModelTransform(sinTowerEditorRuntime.models.get(model.id));
}

function toggleSinTowerModelCarry(){
  if(sinTowerModelCarry.active){
    updateSinTowerModelCarry();
    const placed = getSinTowerEditorObjectById(sinTowerModelCarry.id,'model');
    sinTowerModelCarry.active = false;
    sinTowerModelCarry.id = null;
    scheduleSinTowerRuntimeSave();
    syncSinProEditor();
    setStatus(placed ? ('已固定 3D 模型：' + placed.title) : '已停止攜帶 3D 模型。');
    return true;
  }
  const model = selectedSinTowerEditorModel();
  if(!model){ setStatus('請先從物件清單或畫面選取 3D 模型。'); return false; }
  if(model.sceneId !== SIN_TOWER_EDITOR.activeSceneId){ setStatus('只能移動目前場景的 3D 模型。'); return false; }
  sinTowerModelCarry.active = true;
  sinTowerModelCarry.id = model.id;
  suspendSinTowerInteractionsForPlacement();
  updateSinTowerModelCarry();
  syncSinProEditor();
  setStatus('3D 模型「' + model.title + '」正在跟隨角色；按 Enter 或按鈕即可固定。');
  return true;
}

function selectSinTowerEditorModelFromPointer(event){
  sinTowerLastModelPick={at:+performance.now().toFixed(1),x:safeFinite(event?.clientX,0),y:safeFinite(event?.clientY,0),pointerLocked:!!pointerLocked,fallbackMouseLook:!!fallbackMouseLook,cursorFreeMode:!!cursorFreeMode,cursorEditMode:!!sinTowerPlayObjectUi.cursorEditMode,candidates:0,hit:null};
  if(pointerLocked||fallbackMouseLook) return false;
  const meshes=[];
  for(const rec of sinTowerEditorRuntime.models.values()){
    if(rec?.model?.sceneId!==SIN_TOWER_EDITOR.activeSceneId) continue;
    rec.group?.traverse?.(node=>{if(node.isMesh&&node.visible!==false)meshes.push(node);});
  }
  sinTowerLastModelPick.candidates=meshes.length;
  if(!meshes.length) return false;
  const ray=new THREE.Raycaster(),ndc=pointerNDC(event);ray.setFromCamera(ndc,camera);
  const hit=ray.intersectObjects(meshes,false)[0],id=hit?.object?.userData?.sinTowerEditorId;
  sinTowerLastModelPick.ndc={x:+ndc.x.toFixed(3),y:+ndc.y.toFixed(3)};sinTowerLastModelPick.hit=id||null;
  if(!id) return false;
  if(sinTowerPlayObjectUi.cursorEditMode||isPlayMode()) return selectSinTowerPlayModel(id);
  selectSinTowerEditorObject('model',id,'models');
  setStatus('已從畫面選取 3D 模型；可直接修改位置、旋轉與 XYZ 尺寸。');return true;
}

async function addSinTowerEditorPropFromUi(){
  const mediaType = $('sinPropMediaType')?.value === 'gif' ? 'gif' : 'pngSequence';
  const input = $('sinPropPngSequence');
  let frames=[];
  let gif={dataUrl:null,ratio:1,name:''};
  if(mediaType === 'gif'){
    gif=await readSinTowerGifFile($('sinPropGif')?.files?.[0]);
    if(!gif.dataUrl){setStatus('請選擇 GIF 動畫。');return;}
  }else{
    frames=await readSinTowerEditorPngFrames(input?.files);
    if(!frames.length){ setStatus('請選擇透明 PNG 序列資料夾。'); return; }
  }
  const prop = sinTowerPropFromUi({id:uid('prop'),mediaType,frames,gifDataUrl:gif.dataUrl,gifName:gif.name,gifRatio:gif.ratio});
  SIN_TOWER_EDITOR.props.push(prop);
  SIN_TOWER_EDITOR.selectedObjectType = 'prop';
  SIN_TOWER_EDITOR.selectedObjectId = prop.id;
  if(input) input.value = '';
  if($('sinPropGif')) $('sinPropGif').value='';
  await buildSinTowerEditorProp(prop);
  if(!sinTowerEditorRuntime.props.has(prop.id)){SIN_TOWER_EDITOR.props=SIN_TOWER_EDITOR.props.filter(item=>item.id!==prop.id);setStatus('素材已讀取，但建立場景物件失敗。');return;}
  scheduleSinTowerRuntimeSave();
  setStatus(mediaType==='gif' ? `已加入 GIF 動畫物件：${prop.title}。` : `已加入 PNG 物件：${prop.title}，${frames.length} 張影格。`);
}

async function applySinTowerEditorPropFromUi(){
  const prop = getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId, 'prop');
  if(!prop){ setStatus('尚未選取動畫物件。'); return; }
  const mediaType=$('sinPropMediaType')?.value==='gif'?'gif':'pngSequence';
  const input=$('sinPropPngSequence');
  let frames=mediaType==='pngSequence'&&prop.mediaType==='pngSequence'?prop.frames:[];
  let gif={dataUrl:mediaType==='gif'&&prop.mediaType==='gif'?prop.gifDataUrl:null,ratio:prop.gifRatio||1,name:prop.gifName||''};
  if(mediaType==='gif'&&$('sinPropGif')?.files?.[0]) gif=await readSinTowerGifFile($('sinPropGif').files[0]);
  if(mediaType==='pngSequence'&&input?.files?.length) frames=await readSinTowerEditorPngFrames(input.files);
  if(mediaType==='gif'&&!gif.dataUrl){setStatus('請選擇 GIF 動畫。');return;}
  if(mediaType==='pngSequence'&&!frames.length){setStatus('請選擇透明 PNG 序列資料夾。');return;}
  Object.assign(prop,sinTowerPropFromUi({...prop,mediaType,frames,gifDataUrl:gif.dataUrl,gifName:gif.name,gifRatio:gif.ratio}));
  if(input) input.value = '';
  if($('sinPropGif')) $('sinPropGif').value='';
  rebuildSinTowerEditorRuntime();
  scheduleSinTowerRuntimeSave();
  setStatus(`已更新動畫物件：${prop.title}`);
}

function deleteSinTowerSelectedProp(){
  const id = SIN_TOWER_EDITOR.selectedObjectType === 'prop' ? SIN_TOWER_EDITOR.selectedObjectId : null;
  if(!id){ setStatus('尚未選取動畫物件。'); return; }
  SIN_TOWER_EDITOR.props = SIN_TOWER_EDITOR.props.filter(p=>p.id !== id);
  SIN_TOWER_EDITOR.selectedObjectId = null;
  SIN_TOWER_EDITOR.selectedObjectType = null;
  rebuildSinTowerEditorRuntime();
  scheduleSinTowerRuntimeSave();
  setStatus('已刪除動畫物件。');
}

function sinTowerPortalFromUi(base=null){
  return sanitizeSinTowerEditorPortal({
    ...(base || {}),
    sceneId:sinProValue('sinPortalSource',base?.sceneId||SIN_TOWER_EDITOR.activeSceneId),
    title:sinProValue('sinPortalName', base?.title || '傳送門'),
    targetSceneId:sinProValue('sinPortalTarget', base?.targetSceneId || 'stairs_main'),
    step:sinProNumber('sinPortalStep', base?.step || 24),
    offset:{
      x:sinProNumber('sinPortalOffsetX', base?.offset?.x ?? 0),
      y:sinProNumber('sinPortalOffsetY', base?.offset?.y ?? .9),
      z:sinProNumber('sinPortalOffsetZ', base?.offset?.z ?? 0)
    },
    width:sinProNumber('sinPortalWidth', base?.width || 1.8),
    height:sinProNumber('sinPortalHeight', base?.height || 2.6),
    uniformScale:sinProNumber('sinPortalScale',base?.uniformScale||1),
    portalStyle:sinProNumber('sinPortalStyle',base?.portalStyle||1),
    rotationY:safeFinite(base?.rotationY,0),
    color:validColor(sinProValue('sinPortalColor', base?.color || '#65d7ff')) ? sinProValue('sinPortalColor', base?.color || '#65d7ff') : '#65d7ff'
  });
}

function addSinTowerEditorPortalFromUi(){
