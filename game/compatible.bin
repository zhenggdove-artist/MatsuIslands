      if(windowSlot)windowAnchors.push({x,z,rotY,edge,index:wallIndex});
      for(let course=0;course<courses;course++){
        const opening=(door&&course<4)||(windowSlot&&course>=2&&course<=4);
        if(opening)continue;
        const essential=course===0;
        if(!essential&&damaged(420+wallIndex*11+course,.1+course*.115))continue;
        add('wall',essential,'輪廓方石 '+(++wallIndex)+'-'+(course+1),'ashlar',{x:x+jitter(500+wallIndex+course,.05),y:(course+.5)*blockH,z:z+jitter(530+wallIndex+course,.05)},{x:segmentLength*1.035,y:blockH*.95,z:wallThickness},{x:jitter(560+wallIndex,1),y:THREE.MathUtils.radToDeg(rotY)+jitter(590+wallIndex,1),z:jitter(620+wallIndex,1)});
      }
