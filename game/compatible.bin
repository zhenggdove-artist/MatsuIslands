function applyReferenceArchitecturePresetToState(state, options={}){
  const s = state || {};
  const T = .14;
  const H = 3.65;
  const corridor = 5.6;
  const half = corridor / 2;
  const xEnd = 13.0;
  const zEnd = 14.2;
  const wallMat = {color:'#e8e8e4', roughness:.94, metalness:0, texture:null, repeat:[1,1], relief:{preset:'flat', amount:0, variation:.5, seed:104729}};
  const floorMat = {color:'#f2f2ee', roughness:.88, metalness:0, texture:null, repeat:[1,1], relief:{preset:'flat', amount:0, variation:.5, seed:104729}, sand:{...DEFAULT_SAND_CONFIG}};
  const coreMat = {color:'#fafaf6', roughness:.86, metalness:0, texture:null, repeat:[1,1], relief:{preset:'flat', amount:0, variation:.5, seed:104729}, sand:{...DEFAULT_SAND_CONFIG}};
  const wall = (id,title,x,z,w,ry)=>({
    id, title,
    position:{x, y:H/2, z},
    rotationY:ry,
    rotation:{x:0,y:ry,z:0},
    size:{w, h:H, t:.18},
    material:{...wallMat},
    shape:'straight',
    curve:{enabled:false, amount:0, direction:'front'},
    visible:true,
    locked:false,
    isDraft:false,
    manualRotation:true,
    chiselHoles:[]
  });
  const tile = (id,title,x,z,w,d,mat=floorMat)=>({
    id, title,
    position:{x, y:-T/2, z},
    size:{w, d, t:T},
    material:{...mat},
    visible:true,
    locked:false,
    isDraft:false
  });
  s.room = {width:34, depth:36, height:H, thickness:T};
  s.backgroundColor = '#f6f6f3';
  s.skyTexture = null;
  s.skyTintColor = '#ffffff';
  s.skyTintStrength = 0;
  s.hideFloorGrid = true;
  s.atmosphere = {enabled:false, color:'#ffffff', intensity:0, opacity:0, layers:.5};
  s.screenFx = {enabled:false,preset:'none',intensity:.65,noise:.25,recordingFriendly:true,monoDetail:50,monoPixelSize:2,scanlines:.25,chromatic:.22,warp:.08,glow:.18,vignette:.12,saturation:1,contrast:1,brightness:1,blur:0,hue:0,monoPaper:'#f4d66f',monoInk:'#14263d',colorPlayer:false,colorTumor:false,colorTentacle:false,colorEye:false};
  s.groundRelief = {preset:'flat', amount:0, variation:.5, seed:104729};
  s.surfaceTransforms = {};
  s.deletedSurfaces = ['front','back','left','right','ceiling'];
  s.surfaces = {
    front:{color:'#f6f6f3',roughness:.95,metalness:0,texture:null,repeat:[1,1], visible:true, locked:false},
    back:{color:'#f6f6f3',roughness:.95,metalness:0,texture:null,repeat:[1,1], visible:true, locked:false},
    left:{color:'#f6f6f3',roughness:.95,metalness:0,texture:null,repeat:[1,1], visible:true, locked:false},
    right:{color:'#f6f6f3',roughness:.95,metalness:0,texture:null,repeat:[1,1], visible:true, locked:false},
    floor:{color:'#f6f6f3',roughness:.9,metalness:0,texture:null,repeat:[1,1], visible:true, locked:false},
    ceiling:{color:'#f6f6f3',roughness:.98,metalness:0,texture:null,repeat:[1,1], visible:true, locked:false}
  };
  s.referenceArchitecture = {enabled:false, visible:false, locked:true, material:createReferenceArchitectureMaterial(), chiselHoles:[]};
  s.customWalls = [
    wall('cross_wall_z_top','十字空間｜上端牆',0,zEnd,corridor,0),
    wall('cross_wall_z_bottom','十字空間｜下端牆',0,-zEnd,corridor,0),
    wall('cross_wall_x_left','十字空間｜左端牆',-xEnd,0,corridor,90),
    wall('cross_wall_x_right','十字空間｜右端牆',xEnd,0,corridor,90),
    wall('cross_wall_top_left','十字空間｜左翼上牆',-(xEnd+half)/2,half,xEnd-half,0),
    wall('cross_wall_top_right','十字空間｜右翼上牆',(xEnd+half)/2,half,xEnd-half,0),
    wall('cross_wall_bottom_left','十字空間｜左翼下牆',-(xEnd+half)/2,-half,xEnd-half,0),
    wall('cross_wall_bottom_right','十字空間｜右翼下牆',(xEnd+half)/2,-half,xEnd-half,0),
    wall('cross_wall_upper_left_side','十字空間｜上臂左牆',-half,(zEnd+half)/2,zEnd-half,90),
    wall('cross_wall_upper_right_side','十字空間｜上臂右牆',half,(zEnd+half)/2,zEnd-half,90),
    wall('cross_wall_lower_left_side','十字空間｜下臂左牆',-half,-(zEnd+half)/2,zEnd-half,90),
    wall('cross_wall_lower_right_side','十字空間｜下臂右牆',half,-(zEnd+half)/2,zEnd-half,90)
  ];
  s.floorTiles = [
    tile('cross_floor_longitudinal','十字空間｜縱向地面',0,0,corridor,zEnd*2,floorMat),
    tile('cross_floor_transverse','十字空間｜橫向地面',0,0,xEnd*2,corridor,floorMat),
    tile('cross_floor_core','十字空間｜中央交會地面',0,0,corridor+.08,corridor+.08,coreMat)
  ];
  s.waterBodies = [];
  s.objectGroups = Array.isArray(s.objectGroups) ? s.objectGroups : [];
  s.artworks = [];
  s.player = {...(s.player||{}), modelYOffset:0.68, modelYawOffset:180, speed:6.3, jumpPower:1, scale:clamp(safeFinite(s.player?.scale,1),.1,5)};
  s.lightSystem = {
    enabled:true,
    ambient:{color:'#ffffff', intensity:1.15},
    hemisphere:{skyColor:'#ffffff', groundColor:'#f0f0ee', intensity:1.1},
    lights:[]
  };
  s.lightBake = createDefaultLightBake();
  return s;
}


function normalizeObjectKeyType(type){
  if(type === 'wall') return 'customWall';
  if(type === 'surface') return 'roomSurface';
  if(type === 'water') return 'waterBody';
  if(type === 'group') return 'objectGroup';
  return type;
}

function makeObjectKey(type, id){
  return `${normalizeObjectKeyType(type)}:${id}`;
}

function parseObjectKey(key){
  const [type, ...rest] = String(key || '').split(':');
  const id = rest.join(':');
  return {type:normalizeObjectKeyType(type), id};
}

function objectExistsByKey(key){
  const {type,id} = parseObjectKey(key);
  if(type === 'objectGroup') return !!(STATE?.objectGroups || []).some(g=>g.id===id);
  return !!getObjectState(type, id);
}

function sanitizeObjectGroups(input){
  const out = [];
  const seenGroups = new Set();
  if(!Array.isArray(input)) return out;
  for(const raw of input){
    if(!raw || typeof raw !== 'object') continue;
    const id = String(raw.id || uid('group'));
    if(seenGroups.has(id)) continue;
    seenGroups.add(id);
    const members = [];
    const seenMembers = new Set();
    for(const m of raw.members || []){
      const type = normalizeObjectKeyType(m?.type || parseObjectKey(m?.key).type);
      const mid = String(m?.id || parseObjectKey(m?.key).id || '');
      if(!mid || type === 'objectGroup') continue;
      const key = makeObjectKey(type, mid);
      if(seenMembers.has(key)) continue;
      seenMembers.add(key);
      members.push({type, id:mid});
    }
    if(!members.length) continue;
    out.push({id, title:String(raw.title || raw.name || `群組 ${out.length+1}`), members, visible:raw.visible !== false, locked:!!raw.locked, expanded:raw.expanded === true});
  }
  return out;
}

function sanitizeState(raw){
  const def = createDefaultState();
  if(!raw || typeof raw !== 'object') return def;
  const s = {...def, ...raw};
  s.room = {...ROOM, ...(raw.room||{})};
  s.backgroundColor = validColor(raw.backgroundColor) ? raw.backgroundColor : '#080808';
  s.displayOrientation = raw.displayOrientation === 'portrait' ? 'portrait' : 'landscape';
  const portalPasswordArtVersion=Math.floor(safeFinite(raw.portalPasswordArtVersion,0));
  s.portalPasswordLayout = portalPasswordArtVersion>=2?sanitizePortalPasswordLayout(raw.portalPasswordLayout):createDefaultPortalPasswordLayout();
  s.portalPasswordArtVersion=2;
  s.customCursor=sanitizeSinCustomCursor(raw.customCursor);
  s.portalPasswordGifDataUrl=typeof raw.portalPasswordGifDataUrl==='string'&&(/^data:image\/gif(?:;base64)?,/i.test(raw.portalPasswordGifDataUrl)||sinPublishedAssetMatches(raw.portalPasswordGifDataUrl,/^data:image\/gif(?:;base64)?,/i))?raw.portalPasswordGifDataUrl:null;
  s.portalPasswordGifName=typeof raw.portalPasswordGifName==='string'?raw.portalPasswordGifName.slice(0,240):'';
  s.portalPasswordSlotArtDataUrl=typeof raw.portalPasswordSlotArtDataUrl==='string'&&(/^data:image\/(?:png|gif|webp|jpeg)(?:;[^,]*)?,/i.test(raw.portalPasswordSlotArtDataUrl)||sinPublishedAssetMatches(raw.portalPasswordSlotArtDataUrl,/^data:image\/(?:png|gif|webp|jpeg)(?:;[^,]*)?,/i))?raw.portalPasswordSlotArtDataUrl:null;
  s.portalPasswordSlotArtName=typeof raw.portalPasswordSlotArtName==='string'?raw.portalPasswordSlotArtName.slice(0,240):'';
  s.portalPasswordFx=sanitizePortalPasswordFx(raw.portalPasswordFx);
  s.mobileControlsLayout = sanitizeMobileControlsLayout(raw.mobileControlsLayout);
  s.skyTexture = raw.skyTexture === null ? null : (typeof raw.skyTexture === 'string' && (raw.skyTexture.startsWith('data:image')||sinPublishedAssetMatches(raw.skyTexture,"data:image")) ? raw.skyTexture : DEFAULT_SKY_TEXTURE);
  s.skyTintColor = validColor(raw.skyTintColor) ? raw.skyTintColor : '#ffffff';
  s.skyTintStrength = clamp(safeFinite(raw.skyTintStrength,0),0,1);
  const atm = raw.atmosphere || {};
  s.atmosphere = {
    enabled: !!atm.enabled,
    color: validColor(atm.color) ? atm.color : '#d8d0bf',
    intensity: clamp(safeFinite(atm.intensity,.32),0,1),
    opacity: clamp(safeFinite(atm.opacity,.72),0,1),
    layers: clamp(safeFinite(atm.layers,.55),0,1)
  };
  const fx = raw.screenFx || {};
  const allowedFxPresets = ['none','monopixel','vhs','dreamcore','weirdcore'];
  s.screenFx = {
    enabled: !!fx.enabled,
    preset: allowedFxPresets.includes(fx.preset) ? fx.preset : 'none',
    intensity: clamp(safeFinite(fx.intensity,.65),0,1),
    noise: clamp(safeFinite(fx.noise,.25),0,1),
    recordingFriendly: fx.recordingFriendly !== false,
    monoDetail: clamp(Math.round(safeFinite(fx.monoDetail,50)),1,50),
    monoPixelSize: clamp(Math.round(safeFinite(fx.monoPixelSize,2)),1,8),
    scanlines: clamp(safeFinite(fx.scanlines,.25),0,1),
    chromatic: clamp(safeFinite(fx.chromatic,.22),0,1),
    warp: clamp(safeFinite(fx.warp,.08),0,1),
    glow: clamp(safeFinite(fx.glow,.18),0,1),
    vignette: clamp(safeFinite(fx.vignette,.28),0,1),
    saturation: clamp(safeFinite(fx.saturation,1.12),0,3),
    contrast: clamp(safeFinite(fx.contrast,1.08),.2,2.6),
    brightness: clamp(safeFinite(fx.brightness,1),.2,2),
    blur: clamp(safeFinite(fx.blur,0),0,4),
    hue: clamp(safeFinite(fx.hue,0),-180,180),
    monoPaper: validColor(fx.monoPaper) ? fx.monoPaper : '#f4d66f',
    monoInk: validColor(fx.monoInk) ? fx.monoInk : '#14263d',
    colorPlayer: !!fx.colorPlayer,
    colorTumor: !!fx.colorTumor,
    colorTentacle: !!fx.colorTentacle,
    colorEye: !!fx.colorEye
  };
  const gr = raw.groundRelief || {};
  const allowedGroundRelief = ['flat','cementSoft','cementRough','sand','grass'];
  s.groundRelief = {
    preset: allowedGroundRelief.includes(gr.preset) ? gr.preset : 'flat',
    amount: clamp(safeFinite(gr.amount,0),0,1),
    variation: clamp(safeFinite(gr.variation,.5),0,1),
    seed: safeFinite(gr.seed,104729)
  };
  s.surfaceTransforms = {};
  for(const key of SURFACE_KEYS){
    if(raw.surfaceTransforms?.[key]) s.surfaceTransforms[key] = sanitizeSurfaceTransform(key, raw.surfaceTransforms[key], s.room);
  }
  s.surfaces = {...def.surfaces, ...(raw.surfaces||{})};
  for(const key of SURFACE_KEYS){
    s.surfaces[key] = {...def.surfaces[key], ...(s.surfaces[key]||{})};
    s.surfaces[key].relief = normalizeReliefConfig(s.surfaces[key].relief || def.surfaces[key]?.relief || {});
    s.surfaces[key].sand = normalizeSandConfig(s.surfaces[key].sand || def.surfaces[key]?.sand || {});
    s.surfaces[key].visible = s.surfaces[key].visible !== false;
    s.surfaces[key].locked = !!s.surfaces[key].locked;
  }
  s.player = {...def.player, ...(raw.player||{})};
  s.deletedSurfaces = Array.isArray(raw.deletedSurfaces) ? raw.deletedSurfaces.filter(k=>DELETABLE_SURFACE_KEYS.includes(k)) : [];
  s.player.modelYOffset = clamp(safeFinite(s.player.modelYOffset,0.68), -1.2, 20.0);
  s.player.modelYawOffset = clamp(safeFinite(s.player.modelYawOffset,180), -180, 180);
  s.player.speed = clamp(safeFinite(s.player.speed,6.3), 1, 12);
  s.player.jumpPower = clamp(safeFinite(s.player.jumpPower,1), .1, 5);
  s.player.scale = clamp(safeFinite(s.player.scale,1), .1, 5);
  s.objectGroups = sanitizeObjectGroups(raw.objectGroups);
  s.referenceArchitecture = {enabled: raw.referenceArchitecture?.enabled !== false, visible: raw.referenceArchitecture?.visible !== false, locked: !!raw.referenceArchitecture?.locked, material:sanitizeReferenceArchitectureMaterial(raw.referenceArchitecture?.material), chiselHoles:sanitizeChiselHoles(raw.referenceArchitecture?.chiselHoles, true)};
  s.lightSystem = sanitizeLightSystem(raw.lightSystem);
  s.lightBake = sanitizeLightBake(raw.lightBake);
  s.artworks = Array.isArray(raw.artworks) ? raw.artworks.map(a=>{
    const hasFreePosition = a.position && typeof a.position === 'object';
    const rot = a.rotation || {};
    const type = a.type === 'model' ? 'model' : 'image';
    const format = String(a.format || '').toLowerCase();
    const fallbackY = type === 'model' ? 0 : 2.2;
    const backColorManual = a.backColorManual === true;
    const backLightManual = a.backLightManual === true;
    return {
      id:a.id||uid('art'), title:a.title||'Artwork', src:a.src||ASSET.project01, transparent:a.transparent!==false,
      type, format,
      wall:WALL_KEYS.includes(a.wall)?a.wall:'front', offset:safeFinite(a.offset,0), y:safeFinite(a.y,3), gap:clamp(safeFinite(a.gap,.014),.001,500), depth:clamp(safeFinite(a.depth,.10),.01,500),
      position: hasFreePosition ? {x:clamp(safeFinite(a.position.x,0),-500,500), y:clamp(safeFinite(a.position.y,fallbackY),-500,500), z:clamp(safeFinite(a.position.z,0),-500,500)} : null,
      rotation: {x:safeFinite(rot.x,0), y:safeFinite(rot.y,0), z:safeFinite(rot.z,0)},
      manualRotation: !!a.manualRotation,
      snapToWall: !!a.snapToWall,
      doubleSided: type === 'image' ? a.doubleSided === true : false,
      backColor: backColorManual && validColor(a.backColor) ? a.backColor : ARTWORK_BACK_DEFAULT_COLOR,
      backColorManual,
      backLight: backLightManual ? clamp(safeFinite(a.backLight, ARTWORK_BACK_DEFAULT_LIGHT),0,1) : ARTWORK_BACK_DEFAULT_LIGHT,
      backLightManual,
      backRelief: sanitizeArtworkBackRelief(a.backRelief),
      isDraft: !!a.isDraft,
      preserveAspect: type === 'image' ? a.preserveAspect !== false : !!a.preserveAspect,
      naturalAspect: clamp(safeFinite(a.naturalAspect, 0), 0, 1000) || null,
      edgeTintColor: /^#[0-9a-fA-F]{6}$/.test(a.edgeTintColor||'') ? a.edgeTintColor : '#ffffff',
      edgeTintStrength: clamp(safeFinite(a.edgeTintStrength,0),0,1),
      surfaceMaterial: sanitizeArtworkSurfaceMaterial(a.surfaceMaterial),
      visible:a.visible !== false,
      locked:!!a.locked,
      size:{w:clamp(safeFinite(a.size?.w, type === 'model' ? 1.5 : 3),.01,500), h:clamp(safeFinite(a.size?.h, type === 'model' ? 1.5 : 3),.01,500), d:clamp(safeFinite(a.size?.d, type === 'model' ? 1.5 : 1),.01,500)}
    };
  }) : def.artworks;
  s.customWalls = Array.isArray(raw.customWalls) ? raw.customWalls.map(w=>{
    const ry = safeFinite(w.rotation?.y ?? w.rotationY, 0);
    return {
      id:w.id||uid('wall'), title:w.title||'自建牆',
      position:{x:safeFinite(w.position?.x,0), y:safeFinite(w.position?.y,ROOM.height/2), z:safeFinite(w.position?.z,0)},
      rotationY:ry,
      rotation:{x:safeFinite(w.rotation?.x,0), y:ry, z:safeFinite(w.rotation?.z,0)},
      size:{w:clamp(safeFinite(w.size?.w,3),.5,500), h:clamp(safeFinite(w.size?.h,ROOM.height),.5,500), t:clamp(safeFinite(w.size?.t,.18),.02,500)},
      material:{color:validColor(w.material?.color)?w.material.color:'#d6d1c6', roughness:Number(w.material?.roughness??.95), metalness:Number(w.material?.metalness??0), texture:w.material?.texture||null, repeat:w.material?.repeat||[1,1], relief:normalizeReliefConfig(w.material?.relief || {}), sand:normalizeSandConfig(w.material?.sand || {})},
      shape: (w.shape === 'curved' || w.curve?.enabled === true) ? 'curved' : 'straight',
      curve:{
        enabled: (w.shape === 'curved' || w.curve?.enabled === true),
        amount: clamp(safeFinite(w.curve?.amount, w.shape === 'curved' ? .35 : 0),0,1),
        direction: w.curve?.direction === 'back' ? 'back' : 'front'
      },
      visible:w.visible !== false,
      locked:!!w.locked,
      isDraft:false,
      manualRotation:!!w.manualRotation,
      chiselHoles:sanitizeChiselHoles(w.chiselHoles, false)
    };
  }) : [];
  s.floorTiles = Array.isArray(raw.floorTiles) ? raw.floorTiles.map(t=>({
    id:t.id||uid('floor'), title:t.title||'地板塊',
    position:{x:safeFinite(t.position?.x,0), y:safeFinite(t.position?.y,-ROOM.thickness/2), z:safeFinite(t.position?.z,0)},
    size:{w:clamp(safeFinite(t.size?.w,4),.2,500), d:clamp(safeFinite(t.size?.d,4),.2,500), t:clamp(safeFinite(t.size?.t,.18),.02,500)},
    material:{color:validColor(t.material?.color)?t.material.color:(s.surfaces.floor?.color||'#8d897f'), roughness:Number(t.material?.roughness??s.surfaces.floor?.roughness??.9), metalness:Number(t.material?.metalness??s.surfaces.floor?.metalness??0), texture:t.material?.texture||null, repeat:t.material?.repeat||s.surfaces.floor?.repeat||[4,4], relief:normalizeReliefConfig(t.material?.relief || s.surfaces.floor?.relief || {}), sand:normalizeSandConfig(t.material?.sand || s.surfaces.floor?.sand || {})},
    visible:t.visible !== false,
    locked:!!t.locked,
    isDraft:false
  })) : [];
  s.waterBodies = Array.isArray(raw.waterBodies) ? raw.waterBodies.map(w=>{
    const shape = ['rect','cylinder','oval'].includes(w.shape) ? w.shape : 'rect';
    const size = w.size || {};
    const pos = w.position || {};
    const water = w.water || {};
    const containerMaterial = w.containerMaterial || w.material || {};
    return {
      id:w.id || uid('water'),
      title:w.title || '水體',
      shape,
      position:{x:clamp(safeFinite(pos.x,0),-500,500), y:clamp(safeFinite(pos.y,0),-500,500), z:clamp(safeFinite(pos.z,0),-500,500)},
      size:{w:clamp(safeFinite(size.w,4),.2,500), d:clamp(safeFinite(size.d,2),.2,500), h:clamp(safeFinite(size.h,.7),.05,500), t:clamp(safeFinite(size.t,.12),.02,2)},
      water:{
        color:validColor(water.color) ? water.color : '#4bbcff',
        opacity:clamp(safeFinite(water.opacity,.55),.05,.95),
        level:clamp(safeFinite(water.level,.72),.05,.98),
        wave:clamp(safeFinite(water.wave,.45),0,1),
        causticStrength:clamp(safeFinite(water.causticStrength,1),0,3),
        interferenceStrength:clamp(safeFinite(water.interferenceStrength,1),0,3),
        motionDistortion:clamp(safeFinite(water.motionDistortion,1),0,3),
        splash:clamp(safeFinite(water.splash,.65),0,1)
      },
      containerMaterial:{
        color:validColor(containerMaterial.color) ? containerMaterial.color : '#50545a',
        roughness:clamp(safeFinite(containerMaterial.roughness,.82),0,1),
        metalness:clamp(safeFinite(containerMaterial.metalness,.05),0,1),
        texture:containerMaterial.texture || null,
        repeat:Array.isArray(containerMaterial.repeat) ? [safeFinite(containerMaterial.repeat[0],1), safeFinite(containerMaterial.repeat[1],1)] : [1,1]
      },
      visible:w.visible !== false,
      locked:!!w.locked,
      isDraft:!!w.isDraft
    };
  }) : [];
  return s;
}

function getDefaultSurfaceTransform(key, room=STATE?.room||ROOM){
  const W=safeFinite(room.width,ROOM.width), D=safeFinite(room.depth,ROOM.depth), H=safeFinite(room.height,ROOM.height), T=safeFinite(room.thickness,ROOM.thickness);
  const defs = {
    floor:{position:{x:0,y:-T/2,z:0}, size:{x:W,y:T,z:D}},
    ceiling:{position:{x:0,y:H+T/2,z:0}, size:{x:W,y:T,z:D}},
    front:{position:{x:0,y:H/2,z:-D/2}, size:{x:W,y:H,z:T}},
    back:{position:{x:0,y:H/2,z:D/2}, size:{x:W,y:H,z:T}},
    left:{position:{x:-W/2,y:H/2,z:0}, size:{x:T,y:H,z:D}},
    right:{position:{x:W/2,y:H/2,z:0}, size:{x:T,y:H,z:D}}
  };
  return defs[key] || defs.floor;
}

function sanitizeSurfaceTransform(key, raw={}, room=STATE?.room||ROOM){
  const def = getDefaultSurfaceTransform(key, room);
  const p = raw.position || {};
  const z = raw.size || {};
  return {
    position:{
      x:safeFinite(p.x, def.position.x),
      y:safeFinite(p.y, def.position.y),
      z:safeFinite(p.z, def.position.z)
    },
    size:{
      x:clamp(safeFinite(z.x ?? z.w, def.size.x), .02, 500),
      y:clamp(safeFinite(z.y ?? z.h, def.size.y), .02, 500),
      z:clamp(safeFinite(z.z ?? z.d, def.size.z), .02, 500)
    }
  };
}

function getSurfaceTransform(key){
  return sanitizeSurfaceTransform(key, STATE.surfaceTransforms?.[key] || {}, STATE.room);
}

function effectiveRenderPixelBudget(maxPixels=MAX_RENDER_PIXELS){
  if(EXPORTED_GALLERY_VIEWER && IS_TOUCH_DEVICE) return Math.min(maxPixels, VIEWER_MOBILE_RENDER_PIXELS);
  return maxPixels;
}

function effectiveScreenFxPixelBudget(){
  if(EXPORTED_GALLERY_VIEWER && IS_TOUCH_DEVICE) return VIEWER_MOBILE_SCREENFX_PIXELS;
  return MAX_SCREENFX_PIXELS;
}

function computeSafePixelRatio(maxPixels=MAX_RENDER_PIXELS){
  const viewport=getSinTowerGameViewport();
  const cssPixels = Math.max(1, Math.floor(viewport.width * viewport.height));
  const captureLinear=STATE?.displayOrientation==='portrait'&&sinTowerCaptureSupersamplePixels>1?Math.sqrt(sinTowerCaptureSupersamplePixels):0;
  const rawLimit = captureLinear>0?captureLinear:((EXPORTED_GALLERY_VIEWER && IS_TOUCH_DEVICE) ? 1.75 : 2);
  const raw = captureLinear>0?captureLinear:Math.min(Number(window.devicePixelRatio || 1), rawLimit);
  const capped = Math.sqrt(effectiveRenderPixelBudget(maxPixels) / cssPixels);
  return Math.max(1, Math.min(raw, capped));
}

function bindWebGLContextSafety(canvas){
  if(!canvas || canvas.dataset.webglSafetyBound === '1') return;
  canvas.dataset.webglSafetyBound = '1';
  canvas.addEventListener('webglcontextlost', ev=>{
    ev.preventDefault();
    webglContextLost=true;webglContextLossCount+=1;webglContextLastLostAt=performance.now();
    disposeScreenFxTarget();
    setStatus('WebGL 暫時被系統回收，正在原地恢復；遊戲狀態與錄影畫面不會重新載入。');
  }, false);
  canvas.addEventListener('webglcontextrestored', ()=>{
    webglContextLost=false;webglContextRestoreCount+=1;
    requestAnimationFrame(()=>{
      try{renderer?.resetState?.();onResize();resizeScreenFxTarget();requestSinTowerSceneShadowRefresh();}
      catch(error){console.warn('WebGL in-place recovery failed',error);}
      setStatus('WebGL 已原地恢復，未重新載入頁面。');
    });
  }, false);
}

function initThree(){
  clock = new THREE.Clock();
  scene = new THREE.Scene();
  applyEnvironmentColors();
  const viewport=getSinTowerGameViewport();
  camera = new THREE.PerspectiveCamera(58, viewport.width/viewport.height, .08, 2500);
  renderer = new THREE.WebGLRenderer({canvas:$('canvas'),antialias:true, powerPreference:'high-performance'});
  applySinTowerDisplayOrientation(viewport);
  renderer.setPixelRatio(computeSafePixelRatio(MAX_RENDER_PIXELS));
  renderer.setSize(viewport.width,viewport.height,false);
  bindWebGLContextSafety(renderer.domElement);
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  initScreenFxPostProcess();
  roomGroup = new THREE.Group(); roomGroup.name = 'room'; scene.add(roomGroup);
  customWallGroup = new THREE.Group(); customWallGroup.name = 'custom-walls'; scene.add(customWallGroup);
  floorTileGroup = new THREE.Group(); floorTileGroup.name = 'floor-tiles'; scene.add(floorTileGroup);
  waterGroup = new THREE.Group(); waterGroup.name = 'water-bodies'; scene.add(waterGroup);
  referenceArchitectureGroup = new THREE.Group(); referenceArchitectureGroup.name = 'reference-architecture'; scene.add(referenceArchitectureGroup);
  artworkGroup = new THREE.Group(); artworkGroup.name = 'artworks'; scene.add(artworkGroup);
  lightRigGroup = new THREE.Group(); lightRigGroup.name = 'light-rig'; scene.add(lightRigGroup);
  playerGroup = new THREE.Group(); playerGroup.name = 'player'; scene.add(playerGroup);
  playerGroup.position.copy(player.position);
  if(!EXPORTED_GALLERY_VIEWER){
    transformControls = new TransformControls(camera, renderer.domElement);
    transformControls.setMode('rotate');
    transformControls.setSpace('local');
    transformControls.visible = false;
    transformControls.enabled = false;
    transformControls.addEventListener('dragging-changed', e=>{
      if(e.value){
        desiredPointerLocked = false;
        cursorFreeMode = true;
        fallbackMouseLook = false;
        document.exitPointerLock?.();
        updateCursorVisibility();
      }
    });
    transformControls.addEventListener('objectChange', syncWallFromTransformControls);
    scene.add(transformControls);
  }else{
    transformControls = null;
  }
  window.addEventListener('resize', onResize);
}

function buildStaticScene(){
  rebuildLightSystem();
}


function getLightDirectionFromState(light){
  const pos = new THREE.Vector3(
    safeFinite(light?.position?.x,0),
    safeFinite(light?.position?.y,4),
    safeFinite(light?.position?.z,0)
  );
  const target = new THREE.Vector3(
    safeFinite(light?.target?.x,0),
    safeFinite(light?.target?.y,0),
    safeFinite(light?.target?.z,0)
  );
  const dir = target.sub(pos);
  if(dir.lengthSq() < 0.0001) dir.set(0,-1,0);
  return dir.normalize();
}

function getLightTargetDistance(light){
  const pos = new THREE.Vector3(
    safeFinite(light?.position?.x,0),
    safeFinite(light?.position?.y,4),
    safeFinite(light?.position?.z,0)
  );
  const target = new THREE.Vector3(
    safeFinite(light?.target?.x,pos.x),
    safeFinite(light?.target?.y,pos.y - 4),
    safeFinite(light?.target?.z,pos.z)
  );
  const d = pos.distanceTo(target);
  if(Number.isFinite(d) && d > 0.25) return d;
  return light?.type === 'directional' ? 12 : 6;
}

function quaternionForLightDirection(direction){
  const dir = direction?.clone?.() || new THREE.Vector3(0,-1,0);
  if(dir.lengthSq() < 0.0001) dir.set(0,-1,0);
  dir.normalize();
  return new THREE.Quaternion().setFromUnitVectors(new THREE.Vector3(0,0,-1), dir);
}

function alignLightControlToTarget(holder, light){
  if(!holder || !light || (light.type !== 'directional' && light.type !== 'spot')) return;
  holder.quaternion.copy(quaternionForLightDirection(getLightDirectionFromState(light)));
}

function updateLightTargetFromControlRotation(light, holder){
  if(!light || !holder || (light.type !== 'directional' && light.type !== 'spot')) return false;
  const pos = new THREE.Vector3();
  holder.getWorldPosition(pos);
  const q = new THREE.Quaternion();
  holder.getWorldQuaternion(q);
  const dir = new THREE.Vector3(0,0,-1).applyQuaternion(q).normalize();
  const dist = getLightTargetDistance(light);
  const target = pos.clone().addScaledVector(dir, dist);
  light.position = {x:pos.x, y:pos.y, z:pos.z};
  light.target = {x:target.x, y:target.y, z:target.z};
  const targetObj = lightTargetObjects?.[light.id];
  if(targetObj) targetObj.position.copy(target);
  return true;
}

function rebuildLightSystem(){
  if(!lightRigGroup) return;
  if(transformControls?.object && findUserDataValueInHierarchy(transformControls.object, 'lightId', scene)){
    transformControls.detach();
    transformControls.visible = false;
    transformControls.enabled = false;
  }
  while(lightRigGroup.children.length){
    lightRigGroup.remove(lightRigGroup.children[0]);
  }
  lightControlObjects = {};
  lightTargetObjects = {};
  const cfg = sanitizeLightSystem(STATE?.lightSystem);
  STATE.lightSystem = cfg;
  if(cfg.enabled === false) return;
  const ambient = new THREE.AmbientLight(cfg.ambient.color, cfg.ambient.intensity);
  ambient.name = 'ambient-light';
  lightRigGroup.add(ambient);
  const hemi = new THREE.HemisphereLight(cfg.hemisphere.skyColor, cfg.hemisphere.groundColor, cfg.hemisphere.intensity);
  hemi.name = 'hemisphere-light';
  lightRigGroup.add(hemi);
  for(const item of cfg.lights || []){
    const holder = new THREE.Group();
    holder.name = item.title || item.id || 'light-control';
    holder.position.set(safeFinite(item.position?.x,0), safeFinite(item.position?.y,4), safeFinite(item.position?.z,0));
    holder.userData.lightId = item.id;
    holder.userData.isLightControl = true;
    holder.visible = item.visible !== false;
    alignLightControlToTarget(holder, item);

    let light = null;
    if(item.type === 'directional'){
      light = new THREE.DirectionalLight(item.color, item.intensity);
      light.shadow.camera.near = .1;
      light.shadow.camera.far = 120;
      light.shadow.camera.left = -36;
      light.shadow.camera.right = 36;
      light.shadow.camera.top = 36;
      light.shadow.camera.bottom = -36;
      light.shadow.mapSize.width = 2048;
      light.shadow.mapSize.height = 2048;
    }else if(item.type === 'spot'){
      light = new THREE.SpotLight(item.color, item.intensity, item.distance, item.angle, item.penumbra, item.decay);
      light.shadow.mapSize.width = 2048;
      light.shadow.mapSize.height = 2048;
    }else{
      light = new THREE.PointLight(item.color, item.intensity, item.distance, item.decay);
      light.shadow.mapSize.width = 1024;
      light.shadow.mapSize.height = 1024;
    }
    light.name = item.title || item.id || 'light';
    light.position.set(0,0,0);
    light.castShadow = !!item.castShadow;
    light.visible = item.visible !== false;
    light.userData.lightId = item.id;
    holder.add(light);

    const markerGeo = new THREE.SphereGeometry(item.type === 'point' ? .20 : .24, 18, 12);
    const markerMat = new THREE.MeshBasicMaterial({color:new THREE.Color(item.color || '#ffffff'), depthTest:true, depthWrite:false, transparent:true, opacity:item.visible === false ? .22 : .78, toneMapped:false});
    const marker = new THREE.Mesh(markerGeo, markerMat);
    marker.name = `${item.title || item.id || 'light'}-position-marker`;
    marker.userData.lightId = item.id;
    marker.userData.isLightMarker = true;
    marker.renderOrder = 30;
    holder.add(marker);

    if(item.type === 'directional' || item.type === 'spot'){
      const target = new THREE.Object3D();
      target.position.set(safeFinite(item.target?.x,0), safeFinite(item.target?.y,0), safeFinite(item.target?.z,0));
      target.name = `${item.title || item.id || 'light'}-target`;
      target.userData.lightTargetId = item.id;
      lightRigGroup.add(target);
      light.target = target;
      lightTargetObjects[item.id] = target;
    }
    lightRigGroup.add(holder);
    lightControlObjects[item.id] = holder;
  }
  updateLightMarkerVisibility();
  if(selectedLightObjectActive && selectedLightId) attachLightTranslateControls(selectedLightId);
}

function updateLightMarkerVisibility(){
  if(!lightRigGroup) return;
  const showMarkers = !isPlayMode();
  lightRigGroup.traverse(obj=>{
    if(obj?.userData?.isLightMarker) obj.visible = showMarkers;
  });
}

function applyEnvironmentColors(){
  if(!scene) return;
  const bg = validColor(STATE?.backgroundColor) ? STATE.backgroundColor : '#080808';
  const baseColor = new THREE.Color(bg);
  scene.background = baseColor;
  const atm = getAtmosphereConfig();
  if(atm.enabled && atm.intensity > 0.001 && atm.opacity > 0.001){
    const fogColor = baseColor.clone().lerp(new THREE.Color(atm.color), clamp(atm.intensity * atm.opacity * .96, 0, 1));
    // 低成本遊戲式迷霧基底：透明度控制整體霧吞噬程度，層次感略提高遠距霧厚度。
    const density = THREE.MathUtils.lerp(.006, .285, Math.pow(atm.intensity, 1.18)) * THREE.MathUtils.lerp(.12, 1.0, atm.opacity) * THREE.MathUtils.lerp(.88, 1.18, atm.layers);
    scene.fog = new THREE.FogExp2(fogColor, density);
  }else{
    scene.fog = new THREE.Fog(baseColor, 80, 320);
  }
  document.body.style.background = bg;
}

function disposeSkyBackground(){
  if(!skyMesh) return;
  scene.remove(skyMesh);
  if(skyMesh.material?.map) skyMesh.material.map.dispose();
  skyMesh.material?.dispose?.();
  skyMesh.geometry?.dispose?.();
  skyMesh = null;
}

function buildSkyBackground(){
  if(!scene) return;
  const token = ++skyLoadToken;
  disposeSkyBackground();
  const src = STATE?.skyTexture || SIN_TOWER_BUNDLED_STAIR_BACKGROUND;
  if(!src) return;
  new THREE.TextureLoader().load(src, tex=>{
    if(token !== skyLoadToken){ tex.dispose(); return; }
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.ClampToEdgeWrapping;
    tex.anisotropy = renderer?.capabilities?.getMaxAnisotropy?.() || 1;
    const geo = new THREE.SphereGeometry(1200, 64, 32);
    const tintStrength = clamp(safeFinite(STATE?.skyTintStrength,0),0,1);
    const tintColor = validColor(STATE?.skyTintColor) ? STATE.skyTintColor : '#ffffff';
    const multipliedColor = new THREE.Color('#ffffff').lerp(new THREE.Color(tintColor), tintStrength);
    const mat = new THREE.MeshBasicMaterial({
      map:tex,
      color:multipliedColor,
      side:THREE.BackSide,
      depthWrite:false,
      depthTest:false,
      fog:false
    });
    skyMesh = new THREE.Mesh(geo, mat);
    skyMesh.name = 'sky-panorama';
    skyMesh.renderOrder = -10000;
    skyMesh.frustumCulled = false;
    skyMesh.userData.sinTowerSceneId = 'stairs_main';
    skyMesh.userData.sinTowerSceneSkybox = true;
    scene.add(skyMesh);
    applySinTowerEditorSceneVisibility?.();
  }, undefined, ()=>{
    if(token === skyLoadToken) setStatus('天空全景圖載入失敗。');
  });
}


function applySkyTint(){
  const color = validColor(STATE?.skyTintColor) ? STATE.skyTintColor : '#ffffff';
  const strength = clamp(safeFinite(STATE?.skyTintStrength,0),0,1);
  if(skyMesh?.material){
    skyMesh.material.color.copy(new THREE.Color('#ffffff').lerp(new THREE.Color(color), strength));
    skyMesh.material.needsUpdate = true;
  }
}

function updateSkyTintFromEditor(){
  if($('skyTintColor')) STATE.skyTintColor = $('skyTintColor').value;
  if($('skyTintStrength')) STATE.skyTintStrength = Number($('skyTintStrength').value);
  applySkyTint();
  scheduleSave();
}

function getAtmosphereConfig(){
  const atm = STATE?.atmosphere || {};
  return {
    enabled: !!atm.enabled,
    color: validColor(atm.color) ? atm.color : '#d8d0bf',
    intensity: clamp(safeFinite(atm.intensity,.32),0,1),
    opacity: clamp(safeFinite(atm.opacity,.72),0,1),
    layers: clamp(safeFinite(atm.layers,.55),0,1)
  };
}

function createAtmosphereSpriteTexture(){
  if(atmosphereTexture) return atmosphereTexture;
  const canvas = document.createElement('canvas');
  canvas.width = 32;
  canvas.height = 32;
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0,0,32,32);
  const g = ctx.createRadialGradient(16,16,0,16,16,16);
  // 微塵不是發光球：中心可見、邊緣快速消失，避免柔光暈。
  g.addColorStop(0,'rgba(255,255,255,0.92)');
  g.addColorStop(.18,'rgba(255,255,255,0.82)');
  g.addColorStop(.38,'rgba(255,255,255,0.28)');
  g.addColorStop(.64,'rgba(255,255,255,0.035)');
  g.addColorStop(1,'rgba(255,255,255,0)');
  ctx.fillStyle = g;
  ctx.fillRect(0,0,32,32);
  atmosphereTexture = new THREE.CanvasTexture(canvas);
  atmosphereTexture.colorSpace = THREE.NoColorSpace;
  atmosphereTexture.generateMipmaps = false;
  atmosphereTexture.minFilter = THREE.LinearFilter;
  atmosphereTexture.magFilter = THREE.LinearFilter;
  return atmosphereTexture;
}

function createAtmosphereCloudTexture(){
  if(atmosphereCloudTexture) return atmosphereCloudTexture;
  const size = 192;
  const canvas = document.createElement('canvas');
  canvas.width = size;
  canvas.height = size;
  const ctx = canvas.getContext('2d');
  ctx.fillStyle = 'rgb(0,0,0)';
  ctx.fillRect(0,0,size,size);
  const rand = seededRandom(937651);
  ctx.globalCompositeOperation = 'lighter';
  for(let i=0;i<780;i++){
    const x = rand() * size;
    const y = rand() * size;
    const r = THREE.MathUtils.lerp(5, 34, Math.pow(rand(), 1.6));
    const a = THREE.MathUtils.lerp(.012, .075, rand());
    const g = ctx.createRadialGradient(x,y,0,x,y,r);
    g.addColorStop(0, `rgba(255,255,255,${a})`);
    g.addColorStop(.42, `rgba(255,255,255,${a*.45})`);
    g.addColorStop(1, 'rgba(255,255,255,0)');
    ctx.fillStyle = g;
    ctx.fillRect(x-r,y-r,r*2,r*2);
  }
  ctx.globalCompositeOperation = 'source-over';
  const img = ctx.getImageData(0,0,size,size);
  const data = img.data;
  for(let i=0;i<data.length;i+=4){
    const n = (rand() - .5) * 34;
    const v = clamp(data[i] + n, 0, 255);
    data[i] = data[i+1] = data[i+2] = v;
    data[i+3] = 255;
  }
  ctx.putImageData(img,0,0);
  atmosphereCloudTexture = new THREE.CanvasTexture(canvas);
  atmosphereCloudTexture.colorSpace = THREE.NoColorSpace;
  atmosphereCloudTexture.wrapS = THREE.RepeatWrapping;
  atmosphereCloudTexture.wrapT = THREE.RepeatWrapping;
  atmosphereCloudTexture.minFilter = THREE.LinearMipmapLinearFilter;
  atmosphereCloudTexture.magFilter = THREE.LinearFilter;
  atmosphereCloudTexture.generateMipmaps = true;
  return atmosphereCloudTexture;
}

function seededRandom(seed){
  let t = Math.floor(seed) + 0x6D2B79F5;
  return function(){
    t += 0x6D2B79F5;
    let r = Math.imul(t ^ t >>> 15, 1 | t);
    r ^= r + Math.imul(r ^ r >>> 7, 61 | r);
    return ((r ^ r >>> 14) >>> 0) / 4294967296;
  };
}

function disposeAtmosphereEffect(){
  if(atmosphereRebuildTimer){
    clearTimeout(atmosphereRebuildTimer);
    atmosphereRebuildTimer = null;
  }
  if(atmospherePoints){
    scene?.remove(atmospherePoints);
    atmospherePoints = null;
  }
  if(atmosphereVolumeMesh){
    scene?.remove(atmosphereVolumeMesh);
    atmosphereVolumeMesh = null;
  }
  atmosphereGeometry?.dispose?.();
  atmosphereMaterial?.dispose?.();
  atmosphereVolumeGeometry?.dispose?.();
  atmosphereVolumeMaterial?.dispose?.();
  atmosphereGeometry = null;
  atmosphereMaterial = null;
  atmosphereUniforms = null;
  atmosphereVolumeGeometry = null;
  atmosphereVolumeMaterial = null;
  atmosphereVolumeUniforms = null;
  renderer?.renderLists?.dispose?.();
}

function buildAtmosphereVolume(intensity, atm, memoryScale=1){
  // 重新製作：不用 fog cards、不用大量 3D 霧團。
  // 改用單一相機包覆式 procedural fog dome：一個 shader 霧體覆蓋視野，成本固定，不會一片一片，也不會 OOM。
  const opacity = clamp(safeFinite(atm.opacity,.72),0,1);
  const layers = clamp(safeFinite(atm.layers,.55),0,1);
  const radius = THREE.MathUtils.lerp(26, 62, intensity);
  atmosphereVolumeGeometry = new THREE.SphereGeometry(radius, 48, 24);
  atmosphereVolumeUniforms = {
    uTime:{value:0},
    uIntensity:{value:intensity},
    uOpacity:{value:opacity},
    uLayers:{value:layers},
    uColor:{value:new THREE.Color(atm.color)},
    uCameraWorld:{value:new THREE.Vector3()}
  };
  atmosphereVolumeMaterial = new THREE.ShaderMaterial({
    uniforms:atmosphereVolumeUniforms,
    transparent:true,
    depthWrite:false,
    depthTest:false,
    side:THREE.BackSide,
    blending:THREE.NormalBlending,
    fog:false,
    vertexShader:`
      varying vec3 vWorld;
      varying vec3 vLocal;
      void main(){
        vLocal = position;
        vec4 wp = modelMatrix * vec4(position, 1.0);
        vWorld = wp.xyz;
        gl_Position = projectionMatrix * viewMatrix * wp;
      }
    `,
    fragmentShader:`
      precision highp float;
      uniform float uTime;
      uniform float uIntensity;
      uniform float uOpacity;
      uniform float uLayers;
      uniform vec3 uColor;
      uniform vec3 uCameraWorld;
      varying vec3 vWorld;
      varying vec3 vLocal;

      float hash31(vec3 p){
        p = fract(p * 0.1031);
        p += dot(p, p.yzx + 33.33);
        return fract((p.x + p.y) * p.z);
      }

      float noise3(vec3 p){
        vec3 i = floor(p);
        vec3 f = fract(p);
        f = f*f*(3.0-2.0*f);
        float n000 = hash31(i + vec3(0.0,0.0,0.0));
        float n100 = hash31(i + vec3(1.0,0.0,0.0));
        float n010 = hash31(i + vec3(0.0,1.0,0.0));
        float n110 = hash31(i + vec3(1.0,1.0,0.0));
        float n001 = hash31(i + vec3(0.0,0.0,1.0));
        float n101 = hash31(i + vec3(1.0,0.0,1.0));
        float n011 = hash31(i + vec3(0.0,1.0,1.0));
        float n111 = hash31(i + vec3(1.0,1.0,1.0));
        float nx00 = mix(n000,n100,f.x);
        float nx10 = mix(n010,n110,f.x);
        float nx01 = mix(n001,n101,f.x);
        float nx11 = mix(n011,n111,f.x);
        float nxy0 = mix(nx00,nx10,f.y);
        float nxy1 = mix(nx01,nx11,f.y);
        return mix(nxy0,nxy1,f.z);
      }

      float fbm(vec3 p){
        float v = 0.0;
        float a = 0.5;
        for(int i=0;i<5;i++){
          v += noise3(p) * a;
          p = p * 2.04 + vec3(11.7, 31.2, 7.3);
          a *= 0.5;
        }
        return v;
      }

      void main(){
        vec3 dir = normalize(vLocal);
        float t = uTime * (0.018 + uIntensity * 0.045);
        vec3 anchored = vWorld * (0.018 + uIntensity * 0.014) + vec3(t * 1.35, t * 0.42, -t * 0.88);
        vec3 warp = vec3(
          fbm(anchored * 1.7 + vec3(7.1, 0.0, 2.3)),
          fbm(anchored * 1.45 + vec3(0.0, 8.2, 4.1)),
          fbm(anchored * 1.6 + vec3(3.4, 2.2, 9.7))
        ) - 0.5;
        float low = fbm(anchored * 0.52 + warp * (2.2 + uIntensity * 4.5));
        float mid = fbm(anchored * 1.22 + warp * (3.5 + uIntensity * 7.2));
        float fine = fbm(anchored * 2.65 + warp * (5.5 + uLayers * 7.0));
        float micro = fbm(anchored * 5.4 + warp * (3.0 + uLayers * 6.0));
        float wisp = fbm(anchored * 9.2 + vec3(warp.z, warp.x, warp.y) * 3.5);

        float baseThreshold = mix(0.78, 0.41, uIntensity);
        float broadBody = smoothstep(baseThreshold - 0.20, baseThreshold + 0.15, low * 0.72 + mid * 0.28);
        float middleBody = smoothstep(baseThreshold - 0.12, baseThreshold + 0.13, low * 0.32 + mid * 0.53 + fine * 0.15);
        float fineBody = smoothstep(baseThreshold - 0.07, baseThreshold + 0.10, mid * 0.25 + fine * 0.58 + micro * 0.17);
        float wispBody = smoothstep(baseThreshold - 0.02, baseThreshold + 0.08, fine * 0.22 + micro * 0.42 + wisp * 0.36);
        float veil = smoothstep(mix(0.55, 0.26, uIntensity), 0.98, low);

        float vertical = smoothstep(-0.48, 0.36, dir.y) * (1.0 - smoothstep(0.84, 1.0, dir.y));
        vertical += (1.0 - abs(dir.y)) * 0.58;
        vertical = clamp(vertical, 0.0, 1.0);

        // 層次感越高，加入越多細節尺度；低層次時以大面積柔霧為主。
        float density = broadBody * 0.62;
        density += middleBody * mix(0.16, 0.46, uLayers);
        density += fineBody * mix(0.02, 0.30, uLayers);
        density += wispBody * mix(0.0, 0.18, uLayers);
        density += veil * mix(0.18, 0.36, uLayers);
        density *= vertical;

        float nearFade = smoothstep(1.4, 8.2, length(vWorld - uCameraWorld));
        float alpha = density * nearFade * mix(0.08, 0.72, pow(uIntensity, 1.10)) * uOpacity;
        // 透明度獨立控制最終上限，避免強度與不透明度綁死。
        alpha = clamp(alpha, 0.0, mix(0.02, mix(0.22, 0.62, uIntensity), uOpacity));
        if(alpha < 0.004) discard;
        gl_FragColor = vec4(uColor, alpha);
      }
    `
  });
  atmosphereVolumeMesh = new THREE.Mesh(atmosphereVolumeGeometry, atmosphereVolumeMaterial);
  atmosphereVolumeMesh.name = 'atmosphere-procedural-camera-fog-volume';
  atmosphereVolumeMesh.userData.isAtmosphereEffect = true;
  atmosphereVolumeMesh.raycast = () => {};
  atmosphereVolumeMesh.frustumCulled = false;
  atmosphereVolumeMesh.renderOrder = 18;
  if(camera) atmosphereVolumeMesh.position.copy(camera.position);
  scene.add(atmosphereVolumeMesh);
}

function buildAtmosphereEffect(){
  if(!scene) return;
  disposeAtmosphereEffect();
  applyEnvironmentColors();
  const atm = getAtmosphereConfig();
  if(!atm.enabled || atm.intensity <= 0.001) return;

  const intensity = clamp(atm.intensity, 0, 1);
  const deviceMemory = Number(navigator.deviceMemory || 8);
  // 主迷霧由單一 shader 霧體負責；粒子只作近景粉塵，不再硬堆百萬粒子。
  const memoryScale = deviceMemory <= 4 ? .38 : (deviceMemory <= 6 ? .58 : (deviceMemory <= 8 ? .78 : 1));
  buildAtmosphereVolume(intensity, atm, memoryScale);

  const count = Math.round(THREE.MathUtils.lerp(26000, 125000, Math.pow(intensity, .82)) * memoryScale);
  const radius = THREE.MathUtils.lerp(8, 24, intensity);
  const height = THREE.MathUtils.lerp(4, 13, intensity);
  const positions = new Float32Array(count * 3);
  const sizes = new Float32Array(count);
  const alphas = new Float32Array(count);
  const speeds = new Float32Array(count);
  const phases = new Float32Array(count);
  const drifts = new Float32Array(count);
  const rand = seededRandom((STATE?.groundRelief?.seed || 104729) + 8191);

  for(let i=0;i<count;i++){
    const a = rand() * Math.PI * 2;
    const rr = Math.pow(rand(), .52) * radius;
    positions[i*3] = Math.cos(a) * rr + (rand() - .5) * 1.2;
    positions[i*3+1] = (rand() - .5) * height + rand() * 1.4;
    positions[i*3+2] = Math.sin(a) * rr + (rand() - .5) * 1.2;

    const dust = rand() < .965;
    sizes[i] = dust
      ? THREE.MathUtils.lerp(.22, .66, Math.pow(rand(), 1.7))
      : THREE.MathUtils.lerp(.44, 1.16, Math.pow(rand(), 2.1));
    alphas[i] = dust
      ? THREE.MathUtils.lerp(.018, .09, rand()) * THREE.MathUtils.lerp(.65, 1.05, intensity)
      : THREE.MathUtils.lerp(.008, .032, rand()) * THREE.MathUtils.lerp(.45, .75, intensity);
    speeds[i] = THREE.MathUtils.lerp(.04, .5, rand()) * THREE.MathUtils.lerp(.48, 1.18, intensity);
    phases[i] = rand() * Math.PI * 200;
    drifts[i] = THREE.MathUtils.lerp(.018, .32, Math.pow(rand(), .7)) * THREE.MathUtils.lerp(.5, 1.35, intensity);
  }

  atmosphereGeometry = new THREE.BufferGeometry();
  atmosphereGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  atmosphereGeometry.setAttribute('aSize', new THREE.BufferAttribute(sizes, 1));
  atmosphereGeometry.setAttribute('aAlpha', new THREE.BufferAttribute(alphas, 1));
  atmosphereGeometry.setAttribute('aSpeed', new THREE.BufferAttribute(speeds, 1));
  atmosphereGeometry.setAttribute('aPhase', new THREE.BufferAttribute(phases, 1));
  atmosphereGeometry.setAttribute('aDrift', new THREE.BufferAttribute(drifts, 1));

  atmosphereUniforms = {
    uTime:{value:0},
    uIntensity:{value:intensity},
    uOpacity:{value:clamp(safeFinite(atm.opacity,.72),0,1)},
    uColor:{value:new THREE.Color(atm.color)},
    uTexture:{value:createAtmosphereSpriteTexture()},
    uPixelRatio:{value:Math.min(window.devicePixelRatio || 1, 2)}
  };

  atmosphereMaterial = new THREE.ShaderMaterial({
    uniforms:atmosphereUniforms,
    transparent:true,
    depthWrite:false,
    depthTest:true,
    blending:THREE.NormalBlending,
    fog:false,
    vertexShader:`
      uniform float uTime;
      uniform float uIntensity;
      uniform float uOpacity;
      uniform float uPixelRatio;
      attribute float aSize;
      attribute float aAlpha;
      attribute float aSpeed;
      attribute float aPhase;
      attribute float aDrift;
      varying float vAlpha;
      varying float vSoftness;
      void main(){
        float t = uTime * aSpeed + aPhase;
        vec3 p = position;
        float swirl = aDrift * (0.55 + uIntensity * 1.35);
        p.x += sin(t * 0.71 + position.z * 0.031) * swirl;
        p.z += cos(t * 0.63 + position.x * 0.029) * swirl;
        p.y += sin(t * 0.47 + position.x * 0.021) * swirl * 0.38;
        vec4 mvPosition = modelViewMatrix * vec4(p, 1.0);
        float dist = max(1.0, -mvPosition.z);
        float perspectiveScale = clamp(185.0 / dist, 0.34, 1.72);
        gl_PointSize = clamp(aSize * uPixelRatio * perspectiveScale * (0.76 + uIntensity * 0.18), 0.5, 1.95);
        vAlpha = aAlpha * (0.95 + uIntensity * 0.38);
        vSoftness = clamp(aSize / 2.0, 0.0, 1.0);
        gl_Position = projectionMatrix * mvPosition;
      }
    `,
    fragmentShader:`
      uniform sampler2D uTexture;
      uniform vec3 uColor;
      uniform float uIntensity;
      varying float vAlpha;
      varying float vSoftness;
      void main(){
        vec4 tex = texture2D(uTexture, gl_PointCoord);
        float alpha = tex.a * vAlpha;
        alpha *= mix(1.0, 0.7, vSoftness);
        if(alpha < 0.004) discard;
        gl_FragColor = vec4(uColor, alpha);
      }
    `
  });

  atmospherePoints = new THREE.Points(atmosphereGeometry, atmosphereMaterial);
  atmospherePoints.name = 'atmosphere-micro-smoke-dust-field';
  atmospherePoints.userData.isAtmosphereEffect = true;
  atmospherePoints.raycast = () => {};
  atmospherePoints.frustumCulled = false;
  atmospherePoints.renderOrder = 26;
  if(camera) atmospherePoints.position.copy(camera.position);
  scene.add(atmospherePoints);
}

function updateAtmosphereEffect(dt){
  if(atmosphereUniforms) atmosphereUniforms.uTime.value += dt;
  if(atmosphereVolumeUniforms){
    atmosphereVolumeUniforms.uTime.value += dt;
    if(camera) atmosphereVolumeUniforms.uCameraWorld.value.copy(camera.position);
  }
  if(camera){
    if(atmospherePoints){
      atmospherePoints.position.lerp(camera.position, .1);
      atmospherePoints.rotation.y += dt * .006;
      atmospherePoints.rotation.x += dt * .0025;
    }
    if(atmosphereVolumeMesh){
      atmosphereVolumeMesh.position.copy(camera.position);
      atmosphereVolumeMesh.rotation.y += dt * .0015;
      atmosphereVolumeMesh.rotation.x += dt * .0006;
    }
  }
}

function syncAtmosphereEditor(){
  const atm = getAtmosphereConfig();
  if($('atmosphereEnabled')) $('atmosphereEnabled').checked = atm.enabled;
  if($('atmosphereColor')) $('atmosphereColor').value = atm.color;
  if($('atmosphereIntensity')) $('atmosphereIntensity').value = atm.intensity;
  if($('atmosphereOpacity')) $('atmosphereOpacity').value = atm.opacity;
  if($('atmosphereLayers')) $('atmosphereLayers').value = atm.layers;
}

function updateAtmosphereFromEditor(){
  STATE.atmosphere = {
    enabled: !!$('atmosphereEnabled')?.checked,
    color: validColor($('atmosphereColor')?.value) ? $('atmosphereColor').value : '#d8d0bf',
    intensity: clamp(safeFinite($('atmosphereIntensity')?.value,.32),0,1),
    opacity: clamp(safeFinite($('atmosphereOpacity')?.value,.72),0,1),
    layers: clamp(safeFinite($('atmosphereLayers')?.value,.55),0,1)
  };
  applyEnvironmentColors();
  const atm = getAtmosphereConfig();
  if(!atm.enabled || atm.intensity <= 0.001){
    disposeAtmosphereEffect();
  }else{
    if(atmosphereRebuildTimer) clearTimeout(atmosphereRebuildTimer);
    atmosphereRebuildTimer = setTimeout(()=>{
      atmosphereRebuildTimer = null;
      buildAtmosphereEffect();
    }, 90);
  }
  scheduleSave();
}

function makeScreenFxNoiseTexture(){
  if(screenFxNoiseTexture) return screenFxNoiseTexture;
  const canvas = document.createElement('canvas');
  canvas.width = 160; canvas.height = 160;
  const ctx = canvas.getContext('2d');
  const img = ctx.createImageData(canvas.width, canvas.height);
  for(let i=0;i<img.data.length;i+=4){
    const v = Math.floor(Math.random() * 255);
    img.data[i] = v;
    img.data[i+1] = v;
    img.data[i+2] = v;
    img.data[i+3] = Math.floor(70 + Math.random() * 185);
  }
  ctx.putImageData(img,0,0);
  screenFxNoiseTexture = `url(${canvas.toDataURL('image/png')})`;
  return screenFxNoiseTexture;
}

function getScreenFxConfig(){
  const def = createDefaultState().screenFx;
  return {...def, ...(STATE?.screenFx || {})};
}

function clamp01(v){ return clamp(safeFinite(v,0),0,1); }

function screenFxPresetValues(preset){
  if(preset === 'monopixel') return {enabled:true,preset:'monopixel',intensity:1,noise:0,recordingFriendly:true,monoDetail:50,monoPixelSize:2,scanlines:0,chromatic:0,warp:0,glow:0,vignette:.08,saturation:0,contrast:1.18,brightness:1.04,blur:0,hue:0};
  if(preset === 'vhs') return {enabled:true,preset:'vhs',intensity:.82,noise:.64,scanlines:.78,chromatic:.72,warp:.34,glow:.08,vignette:.34,saturation:.82,contrast:1.22,brightness:.94,blur:.28,hue:-4};
  if(preset === 'dreamcore') return {enabled:true,preset:'dreamcore',intensity:.74,noise:.18,scanlines:.06,chromatic:.22,warp:.10,glow:.70,vignette:.25,saturation:1.62,contrast:.78,brightness:1.18,blur:1.15,hue:18};
  if(preset === 'weirdcore') return {enabled:true,preset:'weirdcore',intensity:.86,noise:.38,scanlines:.20,chromatic:.64,warp:.48,glow:.26,vignette:.62,saturation:2.05,contrast:1.72,brightness:1.02,blur:.18,hue:92};
  return {enabled:false,preset:'none',intensity:0,noise:0,scanlines:0,chromatic:0,warp:0,glow:0,vignette:0,saturation:1,contrast:1,brightness:1,blur:0,hue:0};
}

function setSinTowerCaptureStatus(text){if($('screenFxCaptureStatus'))$('screenFxCaptureStatus').textContent=String(text||'');}

function setSinTowerCaptureButtons(recording){
  if($('screenFxCaptureStart'))$('screenFxCaptureStart').disabled=!!recording;
  if($('screenFxCaptureStop'))$('screenFxCaptureStop').disabled=!recording;
}

function getSinTowerCaptureQualitySpec(){
  const viewport=getSinTowerGameViewport(),portrait=viewport.orientation==='portrait';
  const requestedPixelMultiplier=portrait?clamp(safeFinite($('screenFxPortraitCapturePixels')?.value,5),1,5):1;
  const desiredLinearScale=requestedPixelMultiplier>=5?3:requestedPixelMultiplier>=3?2:1;
  const cssPixels=Math.max(1,viewport.width*viewport.height),budgetPixels=Math.min(effectiveRenderPixelBudget(MAX_RENDER_PIXELS),effectiveScreenFxPixelBudget());
  const maxBudgetLinearScale=Math.max(1,Math.floor(Math.sqrt(budgetPixels/cssPixels)));
  const linearScale=portrait?Math.max(1,Math.min(desiredLinearScale,maxBudgetLinearScale)):1,pixelMultiplier=linearScale*linearScale;
  return{portrait,requestedPixelMultiplier,pixelMultiplier,linearScale,targetWidth:Math.max(2,Math.round(viewport.width*linearScale)),targetHeight:Math.max(2,Math.round(viewport.height*linearScale)),gridSafe:Number.isInteger(linearScale),viewport:{left:viewport.left,top:viewport.top,width:viewport.width,height:viewport.height}};
}

function applySinTowerCaptureSupersampling(pixelMultiplier=1){
  const next=STATE?.displayOrientation==='portrait'?clamp(safeFinite(pixelMultiplier,1),1,9):1;
  if(Math.abs(next-sinTowerCaptureSupersamplePixels)<.001)return;
  sinTowerCaptureSupersamplePixels=next;if(renderer)onResize();
}

function restoreSinTowerCaptureSupersampling(){
  if(sinTowerCaptureSupersamplePixels===1)return;
  sinTowerCaptureSupersamplePixels=1;if(renderer)onResize();
}

async function prepareSinTowerCaptureStream(stream,spec=getSinTowerCaptureQualitySpec()){
  const track=stream?.getVideoTracks?.()[0]||null;let regionCropped=false,cropError='',constraintError='';
  if(track&&spec.portrait&&renderer?.domElement&&typeof window.CropTarget?.fromElement==='function'&&typeof track.cropTo==='function'){
    try{const target=await window.CropTarget.fromElement(renderer.domElement);await Promise.race([track.cropTo(target),new Promise((_,reject)=>setTimeout(()=>reject(new Error('crop timeout')),2500))]);regionCropped=true;}catch(error){cropError=String(error?.message||error);}
  }
  if(track){try{track.contentHint='detail';}catch{}const constraints={frameRate:{ideal:60,max:60}};if(spec.portrait){constraints.width={ideal:spec.targetWidth};constraints.height={ideal:spec.targetHeight};constraints.resizeMode='none';}try{await track.applyConstraints?.(constraints);}catch(error){constraintError=String(error?.message||error);}}
  const settings=track?.getSettings?.()||{};
  sinTowerCaptureDiagnostics={...spec,regionCropped,cropSupported:!!(track&&typeof window.CropTarget?.fromElement==='function'&&typeof track.cropTo==='function'),cropError,constraintError,actualWidth:Math.round(safeFinite(settings.width,0)),actualHeight:Math.round(safeFinite(settings.height,0)),actualFrameRate:+safeFinite(settings.frameRate,0).toFixed(2)};
  return sinTowerCaptureDiagnostics;
}

window.__sinTowerCaptureQualitySpec=()=>getSinTowerCaptureQualitySpec();

function downloadSinTowerCapture(blob,extension,label){
  if(!blob?.size)return false;
  const url=URL.createObjectURL(blob),link=document.createElement('a'),stamp=new Date().toISOString().replace(/[:.]/g,'-');
  link.href=url;link.download='SinTower_WYSIWYG_'+stamp+'.'+extension;document.body.append(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),30000);
  setSinTowerCaptureStatus(label+'完成，已下載 '+(blob.size/1048576).toFixed(1)+' MB；遊戲畫面與濾鏡全程未被改動。');return true;
}

function sinTowerAscii(value){return new TextEncoder().encode(String(value||''));}

function sinTowerLe32(value){const bytes=new Uint8Array(4);new DataView(bytes.buffer).setUint32(0,Math.max(0,Math.min(0xffffffff,Math.floor(value)))>>>0,true);return bytes;}

function sinTowerConcatBytes(parts){
  const arrays=parts.map(part=>part instanceof Uint8Array?part:new Uint8Array(part||0)),length=arrays.reduce((sum,part)=>sum+part.byteLength,0),result=new Uint8Array(length);let offset=0;
  for(const part of arrays){result.set(part,offset);offset+=part.byteLength;}return result;
}

function sinTowerAviChunk(id,payload){
  const data=payload instanceof Uint8Array?payload:new Uint8Array(payload||0),padding=data.byteLength&1?new Uint8Array(1):new Uint8Array(0);
  return sinTowerConcatBytes([sinTowerAscii(id),sinTowerLe32(data.byteLength),data,padding]);
}

function sinTowerAviList(type,children){return sinTowerAviChunk('LIST',sinTowerConcatBytes([sinTowerAscii(type),...children]));}

function sinTowerWriteAscii(target,offset,value){target.set(sinTowerAscii(value),offset);}

function buildSinTowerMpngAvi(frameBuffers,width,height,fps){
  if(!frameBuffers.length)throw new Error('沒有可輸出的無損影格。');
  width=Math.max(1,Math.floor(width));height=Math.max(1,Math.floor(height));fps=clamp(Math.round(safeFinite(fps,60)),6,60);
  const frames=frameBuffers.map(frame=>frame instanceof Uint8Array?frame:new Uint8Array(frame)),frameCount=frames.length,maxFrame=Math.max(...frames.map(frame=>frame.byteLength));
  const avih=new Uint8Array(56),avihView=new DataView(avih.buffer);
  avihView.setUint32(0,Math.round(1000000/fps),true);avihView.setUint32(4,Math.min(0xffffffff,maxFrame*fps),true);avihView.setUint32(12,0x10,true);avihView.setUint32(16,frameCount,true);avihView.setUint32(24,1,true);avihView.setUint32(28,maxFrame,true);avihView.setUint32(32,width,true);avihView.setUint32(36,height,true);
  const strh=new Uint8Array(56),strhView=new DataView(strh.buffer);sinTowerWriteAscii(strh,0,'vids');sinTowerWriteAscii(strh,4,'MPNG');strhView.setUint32(20,1,true);strhView.setUint32(24,fps,true);strhView.setUint32(32,frameCount,true);strhView.setUint32(36,maxFrame,true);strhView.setUint32(40,0xffffffff,true);strhView.setInt16(52,Math.min(32767,width),true);strhView.setInt16(54,Math.min(32767,height),true);
  const strf=new Uint8Array(40),strfView=new DataView(strf.buffer);strfView.setUint32(0,40,true);strfView.setInt32(4,width,true);strfView.setInt32(8,height,true);strfView.setUint16(12,1,true);strfView.setUint16(14,32,true);sinTowerWriteAscii(strf,16,'MPNG');strfView.setUint32(20,maxFrame,true);
  const hdrl=sinTowerAviList('hdrl',[sinTowerAviChunk('avih',avih),sinTowerAviList('strl',[sinTowerAviChunk('strh',strh),sinTowerAviChunk('strf',strf)])]);
  const frameBlockSizes=frames.map(frame=>8+frame.byteLength+(frame.byteLength&1)),moviPayloadSize=4+frameBlockSizes.reduce((sum,size)=>sum+size,0),moviHeader=sinTowerConcatBytes([sinTowerAscii('LIST'),sinTowerLe32(moviPayloadSize),sinTowerAscii('movi')]);
  const index=new Uint8Array(frameCount*16),indexView=new DataView(index.buffer);let moviOffset=4;
  frames.forEach((frame,i)=>{sinTowerWriteAscii(index,i*16,'00dc');indexView.setUint32(i*16+4,0x10,true);indexView.setUint32(i*16+8,moviOffset,true);indexView.setUint32(i*16+12,frame.byteLength,true);moviOffset+=frameBlockSizes[i];});
  const indexChunk=sinTowerAviChunk('idx1',index),bodySize=4+hdrl.byteLength+moviHeader.byteLength+frameBlockSizes.reduce((sum,size)=>sum+size,0)+indexChunk.byteLength;
  if(bodySize>0x7ffff000)throw new Error('無損錄影超過 AVI 2 GB 相容上限，請分段錄製。');
  const parts=[sinTowerAscii('RIFF'),sinTowerLe32(bodySize),sinTowerAscii('AVI '),hdrl,moviHeader];
  for(const frame of frames)parts.push(sinTowerAscii('00dc'),sinTowerLe32(frame.byteLength),frame,frame.byteLength&1?new Uint8Array(1):new Uint8Array(0));
  parts.push(indexChunk);return new Blob(parts,{type:'video/x-msvideo'});
}

function sinTowerCanvasToPng(canvas){return new Promise((resolve,reject)=>canvas.toBlob(blob=>blob?resolve(blob):reject(new Error('無法編碼無損 PNG 影格。')),'image/png'));}

function createSinTowerPngWorkerPool(width,height,count){
  if(typeof Worker!=='function'||typeof OffscreenCanvas!=='function'||typeof createImageBitmap!=='function')return null;
  const source=[
    "let canvas=null,context=null,chain=Promise.resolve();",
    "async function encode(job){",
    "  try{",
    "    if(!canvas||canvas.width!==job.width||canvas.height!==job.height){canvas=new OffscreenCanvas(job.width,job.height);context=canvas.getContext('2d',{alpha:false,desynchronized:true});}",
    "    if(!context)throw new Error('OffscreenCanvas 2D unavailable');",
    "    context.drawImage(job.bitmap,0,0,job.width,job.height);job.bitmap.close();",
    "    const blob=await canvas.convertToBlob({type:'image/png'}),buffer=await blob.arrayBuffer();",
    "    self.postMessage({id:job.id,buffer},[buffer]);",
    "  }catch(error){try{job.bitmap.close();}catch{}self.postMessage({id:job.id,error:String(error&&error.message||error)});}",
    "}",
    "self.onmessage=event=>{chain=chain.then(()=>encode(event.data));};"
  ].join('\n');
  const workerUrl=URL.createObjectURL(new Blob([source],{type:'text/javascript'}));
  const slots=[];
  for(let i=0;i<count;i++){
    const worker=new Worker(workerUrl),slot={worker,jobs:new Map(),depth:0};
    worker.onmessage=event=>{const job=slot.jobs.get(event.data.id);if(!job)return;slot.jobs.delete(event.data.id);slot.depth=Math.max(0,slot.depth-1);if(event.data.error)job.reject(new Error(event.data.error));else job.resolve(event.data.buffer);};
    worker.onerror=event=>{const error=new Error(event?.message||'PNG Worker 發生錯誤。');for(const job of slot.jobs.values())job.reject(error);slot.jobs.clear();slot.depth=0;};
    slots.push(slot);
  }
  let nextId=1,closed=false;
  return {
    count:slots.length,
    encode(bitmap){
      if(closed){bitmap.close?.();return Promise.reject(new Error('PNG Worker 已關閉。'));}
      const slot=slots.reduce((best,item)=>item.depth<best.depth?item:best,slots[0]),id=nextId++;
      return new Promise((resolve,reject)=>{slot.jobs.set(id,{resolve,reject});slot.depth++;try{slot.worker.postMessage({id,width,height,bitmap},[bitmap]);}catch(error){slot.jobs.delete(id);slot.depth--;bitmap.close?.();reject(error);}});
    },
    dispose(){if(closed)return;closed=true;for(const slot of slots){for(const job of slot.jobs.values())job.reject(new Error('錄影已結束。'));slot.jobs.clear();slot.worker.terminate();}URL.revokeObjectURL(workerUrl);}
  };
}

function normalizeSinTowerCaptureTimeline(sourceFrames,fps,durationMs){
  const samples=(sourceFrames||[]).filter(sample=>sample?.buffer&&Number.isFinite(sample.time)).sort((a,b)=>a.time-b.time||a.seq-b.seq);
  if(!samples.length)throw new Error('錄影沒有取得任何影格。');
  fps=clamp(Math.round(safeFinite(fps,60)),6,60);
  const interval=1000/fps;
  const duration=Math.max(interval,safeFinite(durationMs,0),samples[samples.length-1].time+interval);
  const frameCount=Math.max(1,Math.round(duration/interval));
  const frames=new Array(frameCount);let sourceIndex=0;
  for(let i=0;i<frameCount;i++){
    const targetTime=i*interval;
    while(sourceIndex+1<samples.length&&Math.abs(samples[sourceIndex+1].time-targetTime)<=Math.abs(samples[sourceIndex].time-targetTime))sourceIndex++;
    frames[i]=samples[sourceIndex].buffer;
  }
  const measuredSpan=Math.max(interval,samples[samples.length-1].time-samples[0].time);
  const actualFps=samples.length>1?(samples.length-1)*1000/measuredSpan:samples.length*1000/duration;
  return {frames,frameCount,duration,actualFps,sourceCount:samples.length};
}

function stopSinTowerLosslessScheduler(capture){
  if(capture?.captureHandle&&capture.video?.cancelVideoFrameCallback){try{capture.video.cancelVideoFrameCallback(capture.captureHandle);}catch{}}
  capture.captureHandle=0;
  if(capture?.captureTimer){clearInterval(capture.captureTimer);capture.captureTimer=0;}
}

function queueSinTowerLosslessFrame(capture,timestamp){
  if(!capture?.active||capture.pending.size>=capture.maxPending){if(capture?.active)capture.droppedFrames++;return;}
  const sampledAt=Math.max(0,safeFinite(timestamp,performance.now())-capture.startedAt),seq=capture.sequence++;
  const job=(async()=>{
    let buffer;
    if(typeof createImageBitmap==='function'){
      const bitmap=await createImageBitmap(capture.directCanvasSource||capture.video);
      if(capture.workerPool)buffer=await capture.workerPool.encode(bitmap);
      else{capture.context.drawImage(bitmap,0,0,capture.canvas.width,capture.canvas.height);bitmap.close?.();buffer=await (await sinTowerCanvasToPng(capture.canvas)).arrayBuffer();}
    }else{
      capture.context.drawImage(capture.directCanvasSource||capture.video,0,0,capture.canvas.width,capture.canvas.height);
      buffer=await (await sinTowerCanvasToPng(capture.canvas)).arrayBuffer();
    }
    capture.sourceFrames.push({seq,time:sampledAt,buffer});capture.times.push(sampledAt);capture.encodedBytes+=buffer.byteLength;
    if(capture.sourceFrames.length%30===0)setSinTowerCaptureStatus('無損 AVI 錄影中：已取得 '+capture.sourceFrames.length+' 個真實影格，背景壓縮 '+capture.pending.size+' 格，暫存約 '+(capture.encodedBytes/1048576).toFixed(1)+' MB。');
  })();
  capture.pending.add(job);
  job.catch(error=>{capture.lastError=error;console.warn('Sin Tower PNG capture frame failed',error);}).finally(()=>capture.pending.delete(job));
}

function startSinTowerLosslessScheduler(capture){
  const interval=1000/capture.fps;
  const sample=()=>{
    if(!capture.active)return;
    try{capture.directTrack?.requestFrame?.();}catch{}
    queueSinTowerLosslessFrame(capture,performance.now());
  };
  capture.captureTimer=setInterval(sample,interval);
  sample();
}
async function finalizeSinTowerLosslessCapture(error=null){
  const capture=sinTowerLosslessCapture;if(capture.finalizing||(!capture.active&&!capture.stopRequested&&sinTowerCaptureMode!=='avi'))return;
  capture.finalizing=true;capture.active=false;capture.endedAt=capture.endedAt||performance.now();stopSinTowerLosslessScheduler(capture);
  for(const track of sinTowerCaptureStream?.getTracks?.()||[])track.stop();sinTowerCaptureStream=null;
  try{await Promise.allSettled([...capture.pending]);}catch{}
  try{capture.video?.pause?.();}catch{}if(capture.video)capture.video.srcObject=null;
  try{
    if(error)throw error;
    if(!capture.sourceFrames.length)throw capture.lastError||new Error('錄影沒有取得任何影格。');
    const duration=Math.max(0,capture.endedAt-capture.startedAt),timeline=normalizeSinTowerCaptureTimeline(capture.sourceFrames,capture.fps,duration);
    capture.frames=timeline.frames;capture.actualCaptureFps=timeline.actualFps;
    setSinTowerCaptureStatus('正在依實際 '+(duration/1000).toFixed(2)+' 秒時間軸封裝 '+timeline.frameCount+' 格／'+capture.fps+' FPS AVI（'+timeline.sourceCount+' 個真實影格）……');
    const blob=buildSinTowerMpngAvi(timeline.frames,capture.canvas.width,capture.canvas.height,capture.fps);
    const rateNote=timeline.actualFps<capture.fps*.9?'；實際擷取 '+timeline.actualFps.toFixed(1)+' FPS，缺格已用相鄰影格補齊且影片時長保持正確':'；實際擷取 '+timeline.actualFps.toFixed(1)+' FPS';
    downloadSinTowerCapture(blob,'avi','無損 AVI 影片'+rateNote);
  }catch(captureError){setSinTowerCaptureStatus('無損 AVI 影片失敗：'+String(captureError?.message||captureError));}
  capture.workerPool?.dispose?.();
  sinTowerLosslessCapture={active:false,stopRequested:false,finalizing:false,frames:[],sourceFrames:[],times:[],video:null,canvas:null,context:null,loopPromise:null,workerPool:null,pending:new Set(),fps:60,startedAt:0,endedAt:0,droppedFrames:0,encodedBytes:0,sequence:0,captureHandle:0,captureTimer:0,lastRequestedAt:-Infinity,actualCaptureFps:capture.actualCaptureFps||0};
  sinTowerCaptureMode='none';sinTowerCaptureStartedAt=0;restoreSinTowerCaptureSupersampling();setSinTowerCaptureButtons(false);
}

async function startSinTowerLosslessCapture(stream,source){
  const fps=clamp(Math.round(safeFinite($('screenFxCaptureLosslessFps')?.value,60)),6,60),video=document.createElement('video');video.muted=true;video.playsInline=true;video.autoplay=true;video.style.display='none';video.srcObject=stream;
  await video.play();if(!video.videoWidth||!video.videoHeight)await new Promise((resolve,reject)=>{const timer=setTimeout(()=>reject(new Error('無法讀取錄影來源尺寸。')),5000);video.onloadedmetadata=()=>{clearTimeout(timer);resolve();};});
  const canvas=document.createElement('canvas');canvas.width=video.videoWidth;canvas.height=video.videoHeight;const context=canvas.getContext('2d',{alpha:false,willReadFrequently:false});if(!context)throw new Error('無法建立無損錄影畫布。');
  const workerCount=clamp(Math.floor((navigator.hardwareConcurrency||6)-2),2,8),workerPool=createSinTowerPngWorkerPool(canvas.width,canvas.height,workerCount),startedAt=performance.now();
  const directCanvasSource=source.startsWith('遊戲 Canvas')?renderer?.domElement:null,directTrack=directCanvasSource?(stream.getVideoTracks?.()[0]||null):null;
  sinTowerLosslessCapture={active:true,stopRequested:false,finalizing:false,frames:[],sourceFrames:[],times:[],video,canvas,context,directCanvasSource,directTrack,loopPromise:null,workerPool,pending:new Set(),fps,startedAt,endedAt:0,droppedFrames:0,encodedBytes:0,sequence:0,captureHandle:0,captureTimer:0,lastRequestedAt:-Infinity,maxPending:workerPool?workerPool.count*3:1,actualCaptureFps:0};
  sinTowerCaptureMode='avi';sinTowerCaptureStartedAt=startedAt;setSinTowerCaptureButtons(true);
  setSinTowerCaptureStatus('PNG-AVI 短測試：'+canvas.width+'×'+canvas.height+'、'+fps+' FPS；正在依真實時間取樣。長時間錄影請改用 WebM，避免 2 GB 上限。');
  startSinTowerLosslessScheduler(sinTowerLosslessCapture);
}
function stopSinTowerExactCapture(){
  if(sinTowerLosslessCapture.active){sinTowerLosslessCapture.stopRequested=true;sinTowerLosslessCapture.active=false;sinTowerLosslessCapture.endedAt=performance.now();stopSinTowerLosslessScheduler(sinTowerLosslessCapture);setSinTowerCaptureStatus('正在完成背景 PNG 壓縮並依真實時間封裝 60 FPS AVI……');void finalizeSinTowerLosslessCapture();return;}
  if(sinTowerCaptureRecorder&&sinTowerCaptureRecorder.state!=='inactive')sinTowerCaptureRecorder.stop();
}

async function startSinTowerExactCapture(){
  if(sinTowerLosslessCapture.active||(sinTowerCaptureRecorder&&sinTowerCaptureRecorder.state!=='inactive'))return;
  const startButton=$('screenFxCaptureStart'),stopButton=$('screenFxCaptureStop'),captureSpec=getSinTowerCaptureQualitySpec();
  if(captureSpec.portrait&&captureSpec.pixelMultiplier>1)applySinTowerCaptureSupersampling(captureSpec.pixelMultiplier);
  try{
    let stream=null,source='目前分頁／視窗';
    const videoRequest={frameRate:{ideal:60,max:60},displaySurface:'browser'};if(captureSpec.portrait){videoRequest.width={ideal:captureSpec.targetWidth};videoRequest.height={ideal:captureSpec.targetHeight};}
    if(navigator.mediaDevices?.getDisplayMedia){setSinTowerCaptureStatus('請選取目前遊戲分頁；直式錄影會裁切中央 9:16 畫面並以 '+captureSpec.pixelMultiplier+' 倍畫素量擷取。');stream=await navigator.mediaDevices.getDisplayMedia({video:videoRequest,audio:false,preferCurrentTab:true,selfBrowserSurface:'include',surfaceSwitching:'exclude',systemAudio:'exclude'});}
    else if(renderer?.domElement?.captureStream){stream=renderer.domElement.captureStream(60);source='遊戲 Canvas（不含 HTML 面板）';}
    else throw new Error('目前瀏覽器不支援分頁或 Canvas 錄影。');
    sinTowerCaptureStream=stream;
    const captureInfo=await prepareSinTowerCaptureStream(stream,captureSpec);
    for(const track of stream.getVideoTracks())track.addEventListener('ended',()=>stopSinTowerExactCapture(),{once:true});
    const format=$('screenFxCaptureFormat')?.value||'webm';
    if(format==='avi'){await startSinTowerLosslessCapture(stream,source);return;}
    const preferred=['video/webm;codecs=vp8','video/webm;codecs=vp9','video/mp4;codecs=avc1.42E01E','video/webm'].find(type=>window.MediaRecorder?.isTypeSupported?.(type))||'',baseBitrate=clamp(Math.round(safeFinite($('screenFxCaptureBitrate')?.value,40000000)),8000000,80000000),bitrate=clamp(Math.round(baseBitrate*(captureInfo.portrait?Math.min(2,captureInfo.pixelMultiplier):1)),8000000,160000000),allIntra=$('screenFxCaptureAllIntra')?.checked===true;
    sinTowerCaptureChunks=[];sinTowerCaptureStartedAt=performance.now();sinTowerCaptureMode='webm';const recorderOptions={mimeType:preferred||undefined,videoBitsPerSecond:bitrate,videoKeyFrameIntervalCount:allIntra?1:60};
    try{sinTowerCaptureRecorder=new MediaRecorder(stream,recorderOptions);}catch(error){delete recorderOptions.videoKeyFrameIntervalCount;sinTowerCaptureRecorder=new MediaRecorder(stream,recorderOptions);}
    sinTowerCaptureRecorder.ondataavailable=event=>{if(event.data?.size)sinTowerCaptureChunks.push(event.data);};sinTowerCaptureRecorder.onerror=event=>setSinTowerCaptureStatus('錄影錯誤：'+String(event.error?.message||event.error||'未知錯誤'));
    sinTowerCaptureRecorder.onstop=()=>{const type=sinTowerCaptureRecorder?.mimeType||preferred||'video/webm',blob=new Blob(sinTowerCaptureChunks,{type}),isMp4=/video\/mp4/i.test(type),extension=isMp4?'mp4':'webm',label=isMp4?'H.264 MP4 錄影':'WebM 錄影';for(const track of sinTowerCaptureStream?.getTracks?.()||[])track.stop();sinTowerCaptureStream=null;sinTowerCaptureChunks=[];sinTowerCaptureMode='none';sinTowerCaptureStartedAt=0;restoreSinTowerCaptureSupersampling();if(!downloadSinTowerCapture(blob,extension,label))setSinTowerCaptureStatus('錄影沒有取得影格。');setSinTowerCaptureButtons(false);};
    sinTowerCaptureRecorder.start(1000);setSinTowerCaptureButtons(true);const actualBitrate=Math.round(safeFinite(sinTowerCaptureRecorder.videoBitsPerSecond,bitrate)/1000000),estimatedMbPerMinute=Math.round(actualBitrate*60/8),codecLabel=/video\/mp4/i.test(preferred)?'H.264 MP4':/vp8/i.test(preferred)?'VP8 WebM':/vp9/i.test(preferred)?'VP9 WebM':'WebM';setSinTowerCaptureStatus('正在以 '+codecLabel+'、'+actualBitrate+' Mbps、60 FPS 錄製'+(captureInfo.portrait?'；直式 '+captureInfo.pixelMultiplier+' 倍畫素目標 '+captureInfo.targetWidth+'×'+captureInfo.targetHeight+(captureInfo.regionCropped?'，已裁切 9:16 遊戲區':'，瀏覽器不支援區域裁切'):'')+'（估計約 '+estimatedMbPerMinute+' MB／分鐘）。遊玩構圖與點陣濾鏡不變。');
  }catch(error){for(const track of sinTowerCaptureStream?.getTracks?.()||[])track.stop();sinTowerCaptureStream=null;sinTowerCaptureMode='none';restoreSinTowerCaptureSupersampling();setSinTowerCaptureButtons(false);const cancelled=error?.name==='NotAllowedError';setSinTowerCaptureStatus(cancelled?'已取消選擇錄影來源。':'無法開始錄影：'+String(error?.message||error));}
}

function bindScreenFxEditor(){
  if($('screenGameOrientation'))$('screenGameOrientation').onchange=event=>setSinTowerDisplayOrientation(event.target.value);
  if($('screenFxCaptureStart'))$('screenFxCaptureStart').onclick=startSinTowerExactCapture;
  if($('screenFxCaptureStop'))$('screenFxCaptureStop').onclick=stopSinTowerExactCapture;
  const ids = ['screenFxEnabled','screenFxIntensity','screenFxNoise','screenFxRecordingFriendly','screenFxMonoPixelSize','screenFxScanlines','screenFxChromatic','screenFxWarp','screenFxGlow','screenFxVignette','screenFxSaturation','screenFxContrast','screenFxBrightness','screenFxBlur','screenFxHue','screenFxPaperColor','screenFxInkColor','screenFxPlayerColor','screenFxTumorColor','screenFxTentacleColor','screenFxEyeColor'];
  if($('screenFxPreset')) $('screenFxPreset').onchange = ()=>{
    const preset = $('screenFxPreset').value || 'none';
    STATE.screenFx = {...getScreenFxConfig(), ...screenFxPresetValues(preset)};
    syncScreenFxEditor();
    applyScreenFx();
    scheduleSave();
  };
  for(const id of ids){
    const el = $(id);
    if(!el) continue;
    const eventName = el.type === 'checkbox' ? 'change' : 'input';
    el.addEventListener(eventName, updateScreenFxFromEditor);
  }
}

function syncScreenFxEditor(){
  const fx = getScreenFxConfig();
  if($('screenGameOrientation'))$('screenGameOrientation').value=STATE?.displayOrientation==='portrait'?'portrait':'landscape';
  if($('screenFxEnabled')) $('screenFxEnabled').checked = !!fx.enabled;
  if($('screenFxPreset')) $('screenFxPreset').value = fx.preset || 'none';
  if($('screenFxIntensity')) $('screenFxIntensity').value = fx.intensity;
  if($('screenFxNoise')) $('screenFxNoise').value = fx.noise;
  if($('screenFxRecordingFriendly')) $('screenFxRecordingFriendly').checked = fx.recordingFriendly !== false;
  if($('screenFxMonoPixelSize')) $('screenFxMonoPixelSize').value = clamp(Math.round(safeFinite(fx.monoDetail,50)),1,50);
  if($('screenFxScanlines')) $('screenFxScanlines').value = fx.scanlines;
  if($('screenFxChromatic')) $('screenFxChromatic').value = fx.chromatic;
  if($('screenFxWarp')) $('screenFxWarp').value = fx.warp;
  if($('screenFxGlow')) $('screenFxGlow').value = fx.glow;
  if($('screenFxVignette')) $('screenFxVignette').value = fx.vignette;
  if($('screenFxSaturation')) $('screenFxSaturation').value = fx.saturation;
  if($('screenFxContrast')) $('screenFxContrast').value = fx.contrast;
  if($('screenFxBrightness')) $('screenFxBrightness').value = fx.brightness;
  if($('screenFxBlur')) $('screenFxBlur').value = fx.blur;
  if($('screenFxHue')) $('screenFxHue').value = fx.hue;
  if($('screenFxPaperColor')) $('screenFxPaperColor').value = fx.monoPaper;
  if($('screenFxInkColor')) $('screenFxInkColor').value = fx.monoInk;
  if($('screenFxPlayerColor')) $('screenFxPlayerColor').checked = !!fx.colorPlayer;
  if($('screenFxTumorColor')) $('screenFxTumorColor').checked = !!fx.colorTumor;
  if($('screenFxTentacleColor')) $('screenFxTentacleColor').checked = !!fx.colorTentacle;
  if($('screenFxEyeColor')) $('screenFxEyeColor').checked = !!fx.colorEye;
}

function updateScreenFxFromEditor(){
  const preset = $('screenFxPreset')?.value || 'none';
  STATE.screenFx = {
    enabled: !!$('screenFxEnabled')?.checked && preset !== 'none',
    preset,
    intensity: clamp01($('screenFxIntensity')?.value),
    noise: clamp01($('screenFxNoise')?.value),
    recordingFriendly: !!$('screenFxRecordingFriendly')?.checked,
    monoDetail: clamp(Math.round(safeFinite($('screenFxMonoPixelSize')?.value,50)),1,50),
    monoPixelSize:2,
    scanlines: clamp01($('screenFxScanlines')?.value),
    chromatic: clamp01($('screenFxChromatic')?.value),
    warp: clamp01($('screenFxWarp')?.value),
    glow: clamp01($('screenFxGlow')?.value),
    vignette: clamp01($('screenFxVignette')?.value),
    saturation: clamp(safeFinite($('screenFxSaturation')?.value,1),0,3),
    contrast: clamp(safeFinite($('screenFxContrast')?.value,1),.2,2.6),
    brightness: clamp(safeFinite($('screenFxBrightness')?.value,1),.2,2),
    blur: clamp(safeFinite($('screenFxBlur')?.value,0),0,4),
    hue: clamp(safeFinite($('screenFxHue')?.value,0),-180,180),
    monoPaper: validColor($('screenFxPaperColor')?.value) ? $('screenFxPaperColor').value : '#f4d66f',
    monoInk: validColor($('screenFxInkColor')?.value) ? $('screenFxInkColor').value : '#14263d',
    colorPlayer: !!$('screenFxPlayerColor')?.checked,
    colorTumor: !!$('screenFxTumorColor')?.checked,
    colorTentacle: !!$('screenFxTentacleColor')?.checked,
    colorEye: !!$('screenFxEyeColor')?.checked
  };
  applyScreenFx();
  scheduleSave();
}


function initScreenFxPostProcess(){
  screenFxScene = new THREE.Scene();
  screenFxCamera = new THREE.OrthographicCamera(-1,1,1,-1,0,1);
  screenFxMaterial = new THREE.ShaderMaterial({
    depthTest:false,
    depthWrite:false,
    uniforms:{
      tDiffuse:{value:null},
      tColorBypass:{value:null},
      tSceneDepth:{value:null},tBypassDepth:{value:null},
      uHasColorBypass:{value:0},
      uMonoPaper:{value:new THREE.Color('#f4d66f')},
      uMonoInk:{value:new THREE.Color('#14263d')},
      uResolution:{value:new THREE.Vector2(1,1)},
      uTime:{value:0},
      uEnabled:{value:0},
      uIntensity:{value:0},
      uNoise:{value:0},
      uRecordingFriendly:{value:1},
      uMonoPixelSize:{value:2},
      uDitherGridScale:{value:1},
      uScanlines:{value:0},
      uChromatic:{value:0},
      uWarp:{value:0},
      uGlow:{value:0},
      uVignette:{value:0},
      uSaturation:{value:1},
      uContrast:{value:1},
      uBrightness:{value:1},
      uBlur:{value:0},
      uHue:{value:0},
      uPreset:{value:0}
    },
    vertexShader:`
      varying vec2 vUv;
      void main(){
        vUv = uv;
        gl_Position = vec4(position.xy, 0.0, 1.0);
      }
    `,
    fragmentShader:`
      precision highp float;
      uniform sampler2D tDiffuse;
      uniform sampler2D tColorBypass;
      uniform sampler2D tSceneDepth;
      uniform sampler2D tBypassDepth;
      uniform float uHasColorBypass;
      uniform vec3 uMonoPaper;
      uniform vec3 uMonoInk;
      uniform vec2 uResolution;
      uniform float uTime;
      uniform float uEnabled;
      uniform float uIntensity;
      uniform float uNoise;
      uniform float uRecordingFriendly;
      uniform float uMonoPixelSize;
      uniform float uDitherGridScale;
      uniform float uScanlines;
      uniform float uChromatic;
      uniform float uWarp;
      uniform float uGlow;
      uniform float uVignette;
      uniform float uSaturation;
      uniform float uContrast;
      uniform float uBrightness;
      uniform float uBlur;
      uniform float uHue;
      uniform float uPreset;
      varying vec2 vUv;

      float hash12(vec2 p){
        vec3 p3 = fract(vec3(p.xyx) * 0.1031);
        p3 += dot(p3, p3.yzx + 33.33);
        return fract((p3.x + p3.y) * p3.z);
      }
      float noise2(vec2 p){
        vec2 i = floor(p);
        vec2 f = fract(p);
        vec2 u = f*f*(3.0-2.0*f);
        return mix(mix(hash12(i+vec2(0.0,0.0)), hash12(i+vec2(1.0,0.0)), u.x), mix(hash12(i+vec2(0.0,1.0)), hash12(i+vec2(1.0,1.0)), u.x), u.y);
      }
      float bayer4(vec2 p){
        vec2 f = mod(floor(p), 4.0);
        float x = f.x;
        if(f.y < 1.0){
          if(x < 1.0) return 0.0/16.0;
          if(x < 2.0) return 8.0/16.0;
          if(x < 3.0) return 2.0/16.0;
          return 10.0/16.0;
        }
        if(f.y < 2.0){
          if(x < 1.0) return 12.0/16.0;
          if(x < 2.0) return 4.0/16.0;
          if(x < 3.0) return 14.0/16.0;
          return 6.0/16.0;
        }
        if(f.y < 3.0){
          if(x < 1.0) return 3.0/16.0;
          if(x < 2.0) return 11.0/16.0;
          if(x < 3.0) return 1.0/16.0;
          return 9.0/16.0;
        }
        if(x < 1.0) return 15.0/16.0;
        if(x < 2.0) return 7.0/16.0;
        if(x < 3.0) return 13.0/16.0;
        return 5.0/16.0;
      }
      mat3 hueRotation(float angle){
        float s = sin(angle), c = cos(angle);
        return mat3(
          0.213 + c*0.787 - s*0.213, 0.715 - c*0.715 - s*0.715, 0.072 - c*0.072 + s*0.928,
          0.213 - c*0.213 + s*0.143, 0.715 + c*0.285 + s*0.140, 0.072 - c*0.072 - s*0.283,
          0.213 - c*0.213 - s*0.787, 0.715 - c*0.715 + s*0.715, 0.072 + c*0.928 + s*0.072
        );
      }
      vec3 adjustColor(vec3 c){
        c *= uBrightness;
        c = (c - 0.5) * uContrast + 0.5;
        float l = dot(c, vec3(0.299,0.587,0.114));
        c = mix(vec3(l), c, uSaturation);
        c = clamp(hueRotation(radians(uHue)) * c, 0.0, 1.0);
        return c;
      }
      vec2 sWarp(vec2 uv){
        float w = uWarp * uIntensity;
        if(w <= 0.0001) return uv;
        float t = uTime;
        // 連續 S 狀位移：低頻大蛇形 + 中頻 VHS 橫向波 + 緩慢 noise，全部連續不跳格。
        float y = uv.y;
        float s1 = sin(y * 10.5 + t * 0.82);
        float s2 = sin(y * 23.0 - t * 1.37 + sin(t*.31)*1.4) * 0.42;
        float s3 = sin(y * 55.0 + t * 2.1) * 0.16;
        float drift = (noise2(vec2(y * 9.0, t * 0.22)) - 0.5) * 0.62;
        float line = (noise2(vec2(floor(y * 180.0) * 0.013, floor(t*18.0)*0.07)) - 0.5) * 0.16;
        float offset = (s1 + s2 + s3 + drift + line) * w * 0.035;
        uv.x += offset;
        uv.y += sin(uv.x * 4.0 + t * .24) * w * 0.0025;
        return uv;
      }
      vec4 sampleScene(vec2 uv){
        return texture2D(tDiffuse, clamp(uv, vec2(0.001), vec2(0.999)));
      }
      void main(){
        if(uEnabled < 0.5){
          gl_FragColor = texture2D(tDiffuse, vUv);
          return;
        }
        vec2 uv = sWarp(vUv);
        float monoDetail = clamp(uMonoPixelSize, 1.0, 50.0);
        float monoPixelSize = mix(50.0, 1.0, (monoDetail - 1.0) / 49.0);
        // Capture supersampling must preserve the logical on-screen dot grid.
        // Rendering one Bayer cell per supersampled backing pixel creates a
        // sub-pixel pattern after compositing and turns into cross-shaped moire
        // under YUV 4:2:0 video encoding.  Scale both scene quantisation and the
        // Bayer cells by the same integer so the visible game remains WYSIWYG.
        float ditherGridScale = max(1.0, floor(uDitherGridScale + 0.5));
        vec2 monoCellSize = vec2(monoPixelSize * ditherGridScale);
        if(uPreset > 3.5){
          vec2 pixelGrid = max(floor(uResolution / monoCellSize), vec2(1.0));
          uv = (floor(vUv * pixelGrid) + 0.5) / pixelGrid;
        }
        vec2 px = 1.0 / max(uResolution, vec2(1.0));
        float k = uIntensity;
        float chroma = uChromatic * k;
        float ca = chroma * 6.5;
        vec2 caVec = vec2(ca * px.x, 0.0);
        vec3 col;
        if(chroma > 0.001){
          float r = sampleScene(uv + caVec).r;
          float g = sampleScene(uv).g;
          float b = sampleScene(uv - caVec).b;
          col = vec3(r,g,b);
        }else{
          col = sampleScene(uv).rgb;
        }

        float blurAmt = uBlur * k;
        if(blurAmt > 0.001){
          vec2 bpx = px * (1.0 + blurAmt * 2.5);
          vec3 blurCol = vec3(0.0);
          blurCol += sampleScene(uv + vec2( bpx.x, 0.0)).rgb;
          blurCol += sampleScene(uv + vec2(-bpx.x, 0.0)).rgb;
          blurCol += sampleScene(uv + vec2(0.0,  bpx.y)).rgb;
          blurCol += sampleScene(uv + vec2(0.0, -bpx.y)).rgb;
          blurCol += sampleScene(uv + vec2( bpx.x,  bpx.y)).rgb;
          blurCol += sampleScene(uv + vec2(-bpx.x,  bpx.y)).rgb;
          blurCol += sampleScene(uv + vec2( bpx.x, -bpx.y)).rgb;
          blurCol += sampleScene(uv + vec2(-bpx.x, -bpx.y)).rgb;
          blurCol *= 0.125;
          col = mix(col, blurCol, clamp(blurAmt * 0.42, 0.0, 0.82));
        }

        float glowAmt = uGlow * k;
        if(glowAmt > 0.001){
          vec2 gpx = px * (8.0 + glowAmt * 22.0);
          vec3 glow = sampleScene(uv).rgb * 0.18;
          glow += sampleScene(uv + vec2( gpx.x, 0.0)).rgb * 0.12;
          glow += sampleScene(uv + vec2(-gpx.x, 0.0)).rgb * 0.12;
          glow += sampleScene(uv + vec2(0.0,  gpx.y)).rgb * 0.12;
          glow += sampleScene(uv + vec2(0.0, -gpx.y)).rgb * 0.12;
          glow += sampleScene(uv + vec2( gpx.x,  gpx.y)).rgb * 0.085;
          glow += sampleScene(uv + vec2(-gpx.x,  gpx.y)).rgb * 0.085;
          glow += sampleScene(uv + vec2( gpx.x, -gpx.y)).rgb * 0.085;
          glow += sampleScene(uv + vec2(-gpx.x, -gpx.y)).rgb * 0.085;
          vec3 warm = mix(glow, glow * vec3(1.12,1.03,0.92), 0.5);
          col = col + warm * glowAmt * 0.82;
        }

        col = adjustColor(col);

        if(uPreset > 3.5){
          float luminance = clamp(dot(col, vec3(0.299,0.587,0.114)), 0.0, 1.0);
          luminance = pow(luminance, 0.82);
          vec2 ditherCell = floor(gl_FragCoord.xy / monoCellSize);
          float threshold = bayer4(ditherCell);
          float paperAmount = step(threshold, luminance);
          vec3 mono = mix(uMonoInk, uMonoPaper, paperAmount);
          if(uHasColorBypass > 0.5){
            vec4 bypass = texture2D(tColorBypass, vUv);
            float bypassDepth=texture2D(tBypassDepth,vUv).r;
            float visibleDepth = max(step(0.999999,bypassDepth),step(bypassDepth,texture2D(tSceneDepth,vUv).r+0.000001));
            mono = mix(mono, bypass.rgb, clamp(bypass.a,0.0,1.0)*visibleDepth);
          }
          gl_FragColor = vec4(mono, 1.0);
          return;
        }

        float scan = uScanlines * k;
        if(scan > 0.001){
          float line = sin(vUv.y * uResolution.y * 3.14159);
          float mask = smoothstep(-0.45, 0.95, line);
          float fine = sin(vUv.y * uResolution.y * 6.28318 * 0.333 + uTime * 3.0) * 0.5 + 0.5;
          col *= 1.0 - scan * (0.18 + 0.28 * (1.0 - mask) + 0.08 * fine);
          col += scan * 0.025 * mask;
        }

        float grain = uNoise * k;
        if(grain > 0.001){
          float n = hash12(vUv * uResolution.xy + vec2(uTime * 143.7, -uTime * 91.2));
          float n2 = noise2(vUv * uResolution.xy * 0.18 + vec2(uTime*11.0, uTime*7.0));
          float g = (n - 0.5) * 2.0;
          col += g * grain * 0.16;
          col = mix(col, col * (0.86 + n2 * 0.28), grain * 0.22);
        }

        float vig = uVignette * k;
        if(vig > 0.001){
          vec2 q = vUv - 0.5;
          q.x *= uResolution.x / max(uResolution.y, 1.0);
          float d = dot(q,q);
          float v = smoothstep(0.18, 0.88, d);
          col *= 1.0 - v * vig * 0.92;
        }

        if(uPreset > 1.5 && uPreset < 2.5){
          // dreamcore: light pastel haze
          col = mix(col, col * vec3(1.08,0.98,1.12) + vec3(0.03,0.025,0.04), k * 0.10);
        }else if(uPreset > 2.5){
          // weirdcore: slight sickly colour separation
          col = mix(col, vec3(col.r*0.88 + col.g*.18, col.g*1.02, col.b*1.12 + col.r*.10), k * 0.12);
        }

        gl_FragColor = vec4(clamp(col,0.0,1.0), 1.0);
      }
    `
  });
  screenFxQuad = new THREE.Mesh(new THREE.PlaneGeometry(2,2), screenFxMaterial);
  screenFxQuad.frustumCulled = false;
  screenFxScene.add(screenFxQuad);
}

function disposeScreenFxTarget(){
  if(screenFxTarget){
    screenFxTarget.dispose();
    screenFxTarget = null;
    screenFxTargetSize.set(0,0);
    if(screenFxMaterial) screenFxMaterial.uniforms.tDiffuse.value = null;
  }
  if(screenFxColorTarget){
    screenFxColorTarget.dispose();
    screenFxColorTarget = null;
    if(screenFxMaterial){
      screenFxMaterial.uniforms.tColorBypass.value = null;
      screenFxMaterial.uniforms.uHasColorBypass.value = 0;
    }
  }
}

function resizeScreenFxTarget(){
  if(!renderer || !screenFxMaterial) return;
  const fx = getScreenFxConfig();
  const enabled = !!fx.enabled && fx.preset !== 'none' && fx.intensity > .001;
  if(!enabled){
    disposeScreenFxTarget();
    return;
  }
  renderer.getDrawingBufferSize(screenFxDrawSize);
  let w = Math.max(1, Math.floor(screenFxDrawSize.x));
  let h = Math.max(1, Math.floor(screenFxDrawSize.y));
  const pixels = w * h;
  const screenFxBudget = effectiveScreenFxPixelBudget();
  if(pixels > screenFxBudget){
    const k = Math.sqrt(screenFxBudget / pixels);
    w = Math.max(1, Math.floor(w * k));
    h = Math.max(1, Math.floor(h * k));
  }
  const nearestPixelFx = fx.preset === 'monopixel';
  if(screenFxTarget && screenFxTargetSize.x === w && screenFxTargetSize.y === h){
    const filter=nearestPixelFx ? THREE.NearestFilter : THREE.LinearFilter;
    if(screenFxTarget.texture.minFilter!==filter||screenFxTarget.texture.magFilter!==filter){screenFxTarget.texture.minFilter=filter;screenFxTarget.texture.magFilter=filter;screenFxTarget.texture.needsUpdate=true;}
    return;
  }
  disposeScreenFxTarget();
  screenFxTarget = new THREE.WebGLRenderTarget(w, h, {
    depthBuffer:true,
    stencilBuffer:false,
    colorSpace:THREE.SRGBColorSpace,
    samples:0
  });
  screenFxTarget.texture.minFilter = nearestPixelFx ? THREE.NearestFilter : THREE.LinearFilter;
  screenFxTarget.texture.magFilter = nearestPixelFx ? THREE.NearestFilter : THREE.LinearFilter;
  screenFxTarget.texture.generateMipmaps = false;
  screenFxTarget.texture.name = 'screen-fx-target';
  screenFxTarget.depthTexture=new THREE.DepthTexture(w,h,THREE.UnsignedIntType);
  screenFxTargetSize.set(w,h);
  screenFxMaterial.uniforms.uResolution.value.set(w,h);
  screenFxMaterial.uniforms.tDiffuse.value = screenFxTarget.texture;
}

function getScreenFxPresetIndex(preset){
  if(preset === 'monopixel') return 4;
  if(preset === 'vhs') return 1;
  if(preset === 'dreamcore') return 2;
  if(preset === 'weirdcore') return 3;
  return 0;
}

function updateScreenFxUniforms(){
  syncSinGifCursorFilter();
  if(!screenFxMaterial) return false;
  const fx = getScreenFxConfig();
  const enabled = !!fx.enabled && fx.preset !== 'none' && fx.intensity > .001;
  const k = clamp01(fx.intensity);
  const u = screenFxMaterial.uniforms;
  u.uEnabled.value = enabled ? 1 : 0;
  u.uIntensity.value = enabled ? k : 0;
  u.uNoise.value = clamp01(fx.noise);
  u.uRecordingFriendly.value = fx.recordingFriendly !== false ? 1 : 0;
  u.uMonoPixelSize.value = clamp(Math.round(safeFinite(fx.monoDetail,50)),1,50);
  u.uDitherGridScale.value = STATE?.displayOrientation==='portrait'&&sinTowerCaptureSupersamplePixels>1?Math.max(1,Math.round(Math.sqrt(sinTowerCaptureSupersamplePixels))):1;
  u.uScanlines.value = clamp01(fx.scanlines);
  u.uChromatic.value = clamp01(fx.chromatic);
  u.uWarp.value = clamp01(fx.warp);
  u.uGlow.value = clamp01(fx.glow);
  u.uVignette.value = clamp01(fx.vignette);
  // 總強度必須是比例控制：所有色彩項都從中性值按 k 混合，而不是直接套用終值。
  u.uSaturation.value = THREE.MathUtils.lerp(1, clamp(safeFinite(fx.saturation,1),0,3), k);
  u.uContrast.value = THREE.MathUtils.lerp(1, clamp(safeFinite(fx.contrast,1),.2,2.6), k);
  u.uBrightness.value = THREE.MathUtils.lerp(1, clamp(safeFinite(fx.brightness,1),.2,2), k);
  u.uBlur.value = clamp(safeFinite(fx.blur,0),0,4);
  u.uHue.value = clamp(safeFinite(fx.hue,0),-180,180) * k;
  u.uMonoPaper.value.set(validColor(fx.monoPaper) ? fx.monoPaper : '#f4d66f');
  u.uMonoInk.value.set(validColor(fx.monoInk) ? fx.monoInk : '#14263d');
  u.uPreset.value = getScreenFxPresetIndex(fx.preset);
  return enabled;
}

function applyScreenFx(){
  const overlay = $('screenFxOverlay');
  const canvas = $('canvas');
  if(overlay) overlay.style.opacity = '0';
  if(canvas){
    canvas.style.filter = '';
    canvas.style.transform = '';
  }
  document.body.classList.remove('fx-vhs','fx-dreamcore','fx-weirdcore','fx-monopixel','fx-enabled');
  const fx = getScreenFxConfig();
  const enabled = updateScreenFxUniforms();
  if(enabled){
    resizeScreenFxTarget();
    document.body.classList.add('fx-enabled', `fx-${fx.preset}`);
  }else{
    disposeScreenFxTarget();
  }
  document.documentElement.style.setProperty('--fx-canvas-filter','none');
  document.documentElement.style.setProperty('--fx-overlay-opacity','0');
  document.documentElement.style.setProperty('--pixel-paper', validColor(fx.monoPaper) ? fx.monoPaper : '#f4d66f');
  document.documentElement.style.setProperty('--pixel-ink', validColor(fx.monoInk) ? fx.monoInk : '#14263d');
}

function updateScreenFxEffect(dt){
  screenFxTime += dt;
  if(screenFxMaterial)screenFxMaterial.uniforms.uTime.value=screenFxTime;
}

function captureSinTowerSceneRenderStats(){
  const r = renderer?.info?.render;
  if(!r) return;
  SIN_TOWER_INFECTION.lastSceneRender = {calls:r.calls || 0, triangles:r.triangles || 0, points:r.points || 0, lines:r.lines || 0};
}

function sinTowerWantsColorBypass(fx){
  return !!(fx?.enabled && fx.preset === 'monopixel' && (fx.colorPlayer || fx.colorTumor || fx.colorTentacle || fx.colorEye || [...sinTowerEditorRuntime.props.values()].some(r=>r.prop.mediaType==='video'&&r.prop.monoFilter===false)));
}

function isSinTowerEyeNode(obj){
  for(let n=obj;n && n!==playerGroup.parent;n=n.parent){
    if(n.userData?.sinTowerEye || n.userData?.blink) return true;
    if(/眼球|眼睛|瞳孔|虹膜|eye|pupil|iris/i.test(String(n.name || ''))) return true;
    if(n === playerGroup) break;
  }
  return false;
}

function isSinTowerTentacleNode(obj){
  for(let n=obj;n && n!==playerGroup.parent;n=n.parent){
    if(n.userData?.motionProfile === 'tentacle') return true;
    if(/觸手|蜂巢|tentacle|honeycomb/i.test(String(n.name || ''))) return true;
    if(n === playerGroup) break;
  }
  return false;
}

function isSinTowerTumorNode(obj){
  for(let n=obj;n && n!==playerGroup.parent;n=n.parent){
    if(n.userData?.isSinTowerTumor || n.userData?.sinTowerTumorCore || n.userData?.isSinTowerControlledGrowth) return true;
    if(/腫瘤|肉瘤|肉球|tumor/i.test(String(n.name || ''))) return true;
    if(n === playerGroup) break;
  }
  return false;
}

function refreshSinTowerSelectiveColorLayers(fx){
  if(!playerGroup)return 0;
  const revision=safeFinite(SIN_TOWER_INFECTION.colorLayerRevision,0),key=[!!fx.colorPlayer,!!fx.colorTumor,!!fx.colorTentacle,!!fx.colorEye,revision].join('|');
  if(sinTowerColorLayerCache.root===playerGroup&&sinTowerColorLayerCache.key===key)return sinTowerColorLayerCache.count;
  let count=0;
  playerGroup.traverse(obj=>{
    if(!(obj?.isMesh||obj?.isSkinnedMesh||obj?.isPoints||obj?.isSprite))return;
    obj.layers.disable(SIN_TOWER_COLOR_BYPASS_LAYER);
    const keep=isSinTowerEyeNode(obj)?fx.colorEye:isSinTowerTentacleNode(obj)?fx.colorTentacle:isSinTowerTumorNode(obj)?fx.colorTumor:obj.userData?.sinTowerActorBodyMesh?fx.colorPlayer:false;
    if(keep){obj.layers.enable(SIN_TOWER_COLOR_BYPASS_LAYER);count++;}
  });
  if(count&&sinTowerColorLayerCache.root!==playerGroup)scene.traverse(obj=>{if(obj?.isLight)obj.layers.enable(SIN_TOWER_COLOR_BYPASS_LAYER);});
  sinTowerColorLayerCache.root=playerGroup;sinTowerColorLayerCache.key=key;sinTowerColorLayerCache.count=count;
  return count;
}

function ensureScreenFxColorTarget(){
  if(!screenFxTarget) return null;
  const w = Math.max(1,screenFxTarget.width || screenFxTargetSize.x);
  const h = Math.max(1,screenFxTarget.height || screenFxTargetSize.y);
  if(screenFxColorTarget && screenFxColorTarget.width === w && screenFxColorTarget.height === h) return screenFxColorTarget;
  screenFxColorTarget?.dispose?.();
  screenFxColorTarget = new THREE.WebGLRenderTarget(w,h,{depthBuffer:true,stencilBuffer:false,colorSpace:THREE.SRGBColorSpace,samples:0});
  screenFxColorTarget.texture.minFilter = THREE.LinearFilter;
  screenFxColorTarget.texture.magFilter = THREE.LinearFilter;
  screenFxColorTarget.texture.generateMipmaps = false;
  screenFxColorTarget.texture.name = 'screen-fx-selective-color';
  screenFxColorTarget.depthTexture=new THREE.DepthTexture(w,h,THREE.UnsignedIntType);
  return screenFxColorTarget;
}

function renderSinTowerSelectiveColor(fx){
  const target = ensureScreenFxColorTarget();
  const selected = refreshSinTowerSelectiveColorLayers(fx)+[...sinTowerEditorRuntime.props.values()].filter(r=>r.prop.mediaType==='video'&&r.prop.monoFilter===false&&r.root.visible).length;
  if(!target || !selected) return false;
  const oldMask = camera.layers.mask;
  const oldBackground = scene.background;
  const oldClearAlpha = renderer.getClearAlpha();
  const oldClearColor = renderer.getClearColor(new THREE.Color()).clone();
  scene.background = null;
  camera.layers.set(SIN_TOWER_COLOR_BYPASS_LAYER);
  renderer.setRenderTarget(target);
  renderer.setClearColor(0x000000,0);
  renderer.clear(true,true,true);
  const changed=[];for(const rec of sinTowerEditorRuntime.props.values())if(rec.prop.mediaType==='video'&&rec.prop.monoFilter===false)for(const frame of rec.frames){changed.push([frame.material,frame.material.depthWrite]);frame.material.depthWrite=true;}
  try{renderer.render(scene,camera);}finally{for(const [material,depthWrite] of changed)material.depthWrite=depthWrite;}
  camera.layers.mask = oldMask;
  scene.background = oldBackground;
  renderer.setClearColor(oldClearColor,oldClearAlpha);
  return true;
}

function renderSceneWithScreenFx(){
  if(sinTowerPortalGate.active&&sinTowerPortalGate.phase==='input'&&sinPortalPasswordVisible())return;
  const enabled = updateScreenFxUniforms();
  if(!enabled || !screenFxScene || !screenFxCamera){
    renderer.setRenderTarget(null);
    renderer.render(scene,camera);
    captureSinTowerSceneRenderStats();
    return;
  }
  resizeScreenFxTarget();
  if(!screenFxTarget){
    renderer.setRenderTarget(null);
    renderer.render(scene,camera);
    captureSinTowerSceneRenderStats();
    return;
  }
  renderer.setRenderTarget(screenFxTarget);
  renderer.clear(true,true,true);
  renderer.render(scene,camera);
  captureSinTowerSceneRenderStats();
  const fx = getScreenFxConfig();
  const hasColorBypass = sinTowerWantsColorBypass(fx) && renderSinTowerSelectiveColor(fx);
  renderer.setRenderTarget(null);
  screenFxMaterial.uniforms.tDiffuse.value = screenFxTarget.texture;
  screenFxMaterial.uniforms.tSceneDepth.value=screenFxTarget.depthTexture;
  screenFxMaterial.uniforms.tBypassDepth.value=hasColorBypass?screenFxColorTarget.depthTexture:screenFxTarget.depthTexture;
  screenFxMaterial.uniforms.tColorBypass.value = hasColorBypass ? screenFxColorTarget.texture : null;
  screenFxMaterial.uniforms.uHasColorBypass.value = hasColorBypass ? 1 : 0;
  renderer.render(screenFxScene, screenFxCamera);
}


function textureCacheKey(src, repeat=[1,1], colorSpace='srgb'){
  return `${colorSpace}|${Number(repeat?.[0] || 1).toFixed(3)}|${Number(repeat?.[1] || 1).toFixed(3)}|${src}`;
}

function getSharedTexture(src, repeat=[1,1], colorSpace=THREE.SRGBColorSpace){
  if(!src) return null;
  const key = textureCacheKey(src, repeat, colorSpace === THREE.SRGBColorSpace ? 'srgb' : 'linear');
  let tex = sharedTextureCache.get(key);
  if(tex) return tex;
  tex = textureLoader.load(src);
  tex.colorSpace = colorSpace;
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(Number(repeat?.[0] || 1), Number(repeat?.[1] || 1));
  tex.userData.sharedTexture = true;
  sharedTextureCache.set(key, tex);
  return tex;
}

function disposeMaterialTextureIfOwned(tex){
  if(!tex || tex.userData?.sharedTexture) return;
  tex.dispose?.();
}


function sanitizeSandDeforms(raw){
  if(!Array.isArray(raw)) return [];
  const out = [];
  for(const d of raw){
    if(!d || typeof d !== 'object') continue;
    const radius = clamp(safeFinite(d.radius,1), .05, 40);
    const height = clamp(safeFinite(d.height,0), -8, 8);
    if(Math.abs(height) < .0005) continue;
    out.push({x:safeFinite(d.x,0), z:safeFinite(d.z,0), radius, height, falloff:d.falloff==='rim'?'rim':'smooth', seed:safeFinite(d.seed,0)});
    if(out.length >= 240) break;
  }
  return out;
}
function isNearBlackHex(hex){
  if(!validColor(hex)) return false;
  const c = new THREE.Color(hex);
  return Math.max(c.r,c.g,c.b) < .035;
}
function normalizeSandConfig(raw={}){
  const r = raw || {};
  // 舊版曾把沙地材質寫成純黑，導致之後即使切換沙地也會繼續讀取黑色快取。
  // 這裡只把近乎純黑的舊值遷回沙色；一般深色仍保留，避免真正想做黑沙時被覆蓋。
  let color = validColor(r.color) ? r.color : DEFAULT_SAND_CONFIG.color;
  if(isNearBlackHex(color)) color = DEFAULT_SAND_CONFIG.color;
  return {enabled:!!r.enabled, color, grain:clamp(safeFinite(r.grain,DEFAULT_SAND_CONFIG.grain),0,1), reaction:clamp(safeFinite(r.reaction,DEFAULT_SAND_CONFIG.reaction),0,1), seed:safeFinite(r.seed,DEFAULT_SAND_CONFIG.seed), deforms:sanitizeSandDeforms(r.deforms)};
}
function ensureSandConfigOnMaterial(cfg){ if(!cfg) return normalizeSandConfig(); cfg.sand = normalizeSandConfig(cfg.sand || {}); return cfg.sand; }
function sandEnabledForMaterial(cfg){ return !!normalizeSandConfig(cfg?.sand || {}).enabled; }
function sandTextureKey(type,cfg){ const c=normalizeSandConfig(cfg); return `${type}|${c.color}|${Math.round(c.grain*100)}|${Math.round(c.seed)}`; }
function createSandCanvasTexture(type,cfg){
  const sand = normalizeSandConfig(cfg);
  const key = sandTextureKey(type,sand) + '|grainVisibleV17';
  if(sandTextureCache.has(key)) return sandTextureCache.get(key);
  const size = type === 'bump' ? 512 : 768;
  const canvas = document.createElement('canvas'); canvas.width = canvas.height = size;
  const ctx = canvas.getContext('2d', {willReadFrequently:true});
  const base = new THREE.Color(sand.color);
  ctx.fillStyle = sand.color;
  ctx.fillRect(0,0,size,size);
  const img = ctx.getImageData(0,0,size,size), data = img.data;
  const g = clamp(sand.grain,0,1);
  const fineCell = 1.05 + g * 2.6;
  const midCell = 3.2 + g * 7.5;
  for(let y=0;y<size;y++) for(let x=0;x<size;x++){
    const i=(y*size+x)*4;
    const nFine=seededRandom(Math.floor(x/fineCell), Math.floor(y/fineCell), sand.seed+31);
    const nMid=seededRandom(Math.floor(x/midCell), Math.floor(y/midCell), sand.seed+97);
    const nDot=seededRandom(x, y, sand.seed+173);
    const wind=Math.sin(x*.045 + y*(.12+g*.04) + Math.sin(y*.024+sand.seed)*2.15);
    const ridge=Math.sin((x+y*.34)*(.18+g*.05)+Math.sin(y*.033+sand.seed)*1.9);
    let v=(nFine-.5)*(74-g*16)+(nMid-.5)*(32+g*18)+wind*16+ridge*6;
    if(nDot > .985 - g*.004) v += 70;
    if(nDot < .018 + g*.004) v -= 58;
    if(type==='bump'){
      const q=clamp(128+v*1.9,0,255);
      data[i]=data[i+1]=data[i+2]=q;
    }else{
      const warm = (nMid-.5)*10;
      data[i]=clamp(base.r*255+v+warm+9,0,255);
      data[i+1]=clamp(base.g*255+v*.86+warm*.45+6,0,255);
      data[i+2]=clamp(base.b*255+v*.58-warm*.35,0,255);
    }
    data[i+3]=255;
  }
  ctx.putImageData(img,0,0);
  if(type !== 'bump'){
    const dotCount = Math.round(6500 + (1-g) * 12500);
    for(let i=0;i<dotCount;i++){
      const x = seededRandom(i, sand.seed, 401) * size;
      const y = seededRandom(i, sand.seed, 809) * size;
      const r = .42 + seededRandom(i, sand.seed, 1231) * (1.1 + g * 2.2);
      const bright = seededRandom(i, sand.seed, 1777);
      const alpha = bright > .5 ? (.16 + bright*.22) : (.10 + (1-bright)*.18);
      ctx.fillStyle = bright > .5 ? `rgba(255,247,215,${alpha})` : `rgba(62,48,31,${alpha})`;
      ctx.beginPath();
      ctx.arc(x,y,r,0,Math.PI*2);
      ctx.fill();
    }
    ctx.globalAlpha=.26;
    ctx.strokeStyle='rgba(255,246,204,.48)';
    ctx.lineWidth=.55;
    for(let j=0;j<116;j++){
      const y=(j*size/116+seededRandom(j,sand.seed,9)*16)%size;
      ctx.beginPath();
      for(let x=0;x<size;x+=6){
        const yy=y+Math.sin(x*.035+j*.51)*(1.1+g*2.1)+Math.sin(x*.009+j)*3.2;
        if(x===0) ctx.moveTo(x,yy); else ctx.lineTo(x,yy);
      }
      ctx.stroke();
    }
    ctx.globalAlpha=1;
  }
  const tex = new THREE.CanvasTexture(canvas);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(7+(1-g)*9,7+(1-g)*9);
  tex.colorSpace = type==='bump' ? THREE.NoColorSpace : THREE.SRGBColorSpace;
  tex.anisotropy = Math.min(8, renderer?.capabilities?.getMaxAnisotropy?.() || 4);
  sandTextureCache.set(key,tex);
  return tex;
}

function makeMaterial(cfg, fallbackColor='#cccccc'){
  const matCfg = cfg || {};
  const sand = normalizeSandConfig(matCfg.sand || {});
  const opt = {color:new THREE.Color(sand.enabled ? '#ffffff' : (matCfg.color||fallbackColor)), roughness:Number(matCfg.roughness??.95), metalness:Number(matCfg.metalness??0)};
  if(sand.enabled){
    // 沙地貼圖本身已經帶有沙色；material.color 必須維持白色。
    // 若再乘上 sand.color，陰影區與低光區會被二次相乘壓成黑白灰。
    const sandBaseColor = new THREE.Color(sand.color);
    opt.map=createSandCanvasTexture('color',sand);
    opt.bumpMap=createSandCanvasTexture('bump',sand);
    opt.bumpScale=.085+sand.grain*.155;
    opt.roughness=.98;
    opt.metalness=0;
    opt.emissive=sandBaseColor.clone();
    opt.emissiveIntensity=.22;
  }
  else if(matCfg.texture){ const rep=matCfg.repeat||[1,1]; opt.map=getSharedTexture(matCfg.texture,rep,THREE.SRGBColorSpace); }
  const mat = new THREE.MeshStandardMaterial(opt);
  if(sand.enabled){
    mat.name = 'sand-colored-standard-material';
    mat.toneMapped = true;
    mat.userData.isSandMaterial = true;
  }
  return mat;
}

const GROUND_RELIEF_PRESETS = {
  flat:{amp:0,freq:0,octaves:0},
  cementSoft:{amp:.035,freq:1.15,octaves:2},
  cementRough:{amp:.075,freq:2.15,octaves:3},
  sand:{amp:.13,freq:3.2,octaves:4},
  grass:{amp:.11,freq:4.8,octaves:5}
};

function normalizeReliefConfig(raw={}){
  const r = raw || {};
  const preset = GROUND_RELIEF_PRESETS[r.preset] ? r.preset : 'flat';
  return {
    preset,
    amount: clamp(safeFinite(r.amount,0),0,1),
    variation: clamp(safeFinite(r.variation,.5),0,1),
    seed: safeFinite(r.seed,104729)
  };
}

function defaultArtworkSurfaceMaterial(){
  return {
    color:'#ffffff',
    roughness:.72,
    metalness:0,
    texture:null,
    repeat:[1,1],
    relief:{preset:'flat', amount:0, variation:.5, seed:104729}
  };
}

function defaultArtworkBackRelief(){
  return {...ARTWORK_BACK_DEFAULT_RELIEF};
}

function sanitizeArtworkBackRelief(raw={}){
  return normalizeReliefConfig({...ARTWORK_BACK_DEFAULT_RELIEF, ...(raw || {})});
}

function ensureArtworkBackRelief(art){
  if(!art) return defaultArtworkBackRelief();
  art.backRelief = sanitizeArtworkBackRelief(art.backRelief);
  return art.backRelief;
}

function getArtworkBackColor(art){
  return validColor(art?.backColor) ? art.backColor : ARTWORK_BACK_DEFAULT_COLOR;
}

function getArtworkBackLight(art){
  return clamp(safeFinite(art?.backLight, ARTWORK_BACK_DEFAULT_LIGHT), 0, 1);
}

function artworkBackReliefMaterialConfig(art){
  return {repeat:[4,4], relief:ensureArtworkBackRelief(art)};
}

function sanitizeArtworkSurfaceMaterial(raw={}){
  const def = defaultArtworkSurfaceMaterial();
  const src = raw && typeof raw === 'object' ? raw : {};
  const rep = Array.isArray(src.repeat) ? src.repeat : def.repeat;
  return {
    color: validColor(src.color) ? src.color : def.color,
    roughness: clamp(safeFinite(src.roughness, def.roughness), 0, 1),
    metalness: clamp(safeFinite(src.metalness, def.metalness), 0, 1),
    texture: null,
    repeat:[clamp(safeFinite(rep[0],1), .2, 24), clamp(safeFinite(rep[1],1), .2, 24)],
    relief: normalizeReliefConfig({...def.relief, ...(src.relief || {})})
  };
}

function ensureArtworkSurfaceMaterial(art){
  if(!art) return defaultArtworkSurfaceMaterial();
  art.surfaceMaterial = sanitizeArtworkSurfaceMaterial(art.surfaceMaterial);
  return art.surfaceMaterial;
}

function getGroundReliefConfig(){
  return normalizeReliefConfig(STATE?.groundRelief || {});
}

function getReliefConfigForMaterial(matCfg){
  return normalizeReliefConfig(matCfg?.relief || {});
}

function ensureReliefConfigOnMaterial(matCfg){
  if(!matCfg) return normalizeReliefConfig();
  matCfg.relief = normalizeReliefConfig({
    seed: uid('relief').split('').reduce((acc,ch)=>acc + ch.charCodeAt(0), 104729),
    ...(matCfg.relief || {})
  });
  return matCfg.relief;
}

function reliefEnabledForMaterial(matCfg){
  const cfg = getReliefConfigForMaterial(matCfg);
  return cfg.preset !== 'flat' && cfg.amount > .001;
}

const referenceReliefTextureCache = new Map();

function referenceReliefTextureKey(matCfg){
  const cfg = getReliefConfigForMaterial(matCfg);
  const rep = Array.isArray(matCfg?.repeat) ? matCfg.repeat : [1,1];
  return [cfg.preset, cfg.amount.toFixed(3), cfg.variation.toFixed(3), Math.round(cfg.seed), Number(rep[0]||1).toFixed(2), Number(rep[1]||1).toFixed(2)].join('|');
}

function createReferenceReliefBumpTexture(matCfg){
  const cfg = getReliefConfigForMaterial(matCfg);
  const preset = GROUND_RELIEF_PRESETS[cfg.preset] || GROUND_RELIEF_PRESETS.flat;
  if(cfg.preset === 'flat' || cfg.amount <= .001 || !preset.octaves) return null;
  const key = referenceReliefTextureKey(matCfg);
  if(referenceReliefTextureCache.has(key)) return referenceReliefTextureCache.get(key);
  const size = Math.round(clamp(128 + cfg.variation * 160, 128, 288));
  const data = new Uint8Array(size * size);
  const span = 8.0 / Math.max(.35, preset.freq);
  let minV = Infinity, maxV = -Infinity;
  const values = new Float32Array(size * size);
  for(let y=0; y<size; y++){
    for(let x=0; x<size; x++){
      const ux = (x / size - .5) * span;
      const vy = (y / size - .5) * span;
      const n = reliefNoise2D(ux, vy, cfg, preset);
      const i = y * size + x;
      values[i] = n;
      if(n < minV) minV = n;
      if(n > maxV) maxV = n;
    }
  }
  const range = Math.max(1e-6, maxV - minV);
  const contrast = 1.05 + cfg.variation * .85;
  for(let i=0; i<values.length; i++){
    let v = ((values[i] - minV) / range - .5) * contrast + .5;
    v = clamp(v, 0, 1);
    data[i] = Math.round(v * 255);
  }
  const tex = new THREE.DataTexture(data, size, size, THREE.RedFormat);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  const rep = Array.isArray(matCfg?.repeat) ? matCfg.repeat : [1,1];
  tex.repeat.set(clamp(safeFinite(rep[0],1), .2, 24), clamp(safeFinite(rep[1],1), .2, 24));
  tex.needsUpdate = true;
  tex.colorSpace = THREE.NoColorSpace;
  referenceReliefTextureCache.set(key, tex);
  return tex;
}

function applyReferenceReliefToMaterial(mat, matCfg){
  const cfg = getReliefConfigForMaterial(matCfg);
  const preset = GROUND_RELIEF_PRESETS[cfg.preset] || GROUND_RELIEF_PRESETS.flat;
  if(cfg.preset === 'flat' || cfg.amount <= .001 || !preset.octaves) return mat;
  const bump = createReferenceReliefBumpTexture(matCfg);
  if(!bump) return mat;
  mat.bumpMap = bump;
  // Reference architecture uses material-space bump instead of vertex displacement.
  // This prevents triangulated arches from being pulled into a few fan points while still affecting every face.
  mat.bumpScale = (.055 + preset.amp * 1.65) * cfg.amount;
  mat.normalScale = new THREE.Vector2(1,1);
  mat.needsUpdate = true;
  return mat;
}

function applyChiseledReliefSkinToMaterial(mat, matCfg, strength=1){
  const cfg = getReliefConfigForMaterial(matCfg);
  const preset = GROUND_RELIEF_PRESETS[cfg.preset] || GROUND_RELIEF_PRESETS.flat;
  if(!mat || cfg.preset === 'flat' || cfg.amount <= .001 || !preset.octaves) return mat;
  const bump = createReferenceReliefBumpTexture(matCfg);
  if(!bump) return mat;

  // Chisel rebuilds the wall/box into a new real mesh.  The old relief overlay is intentionally
  // skipped there because a full overlay would cover the opening.  This material-space relief
  // keeps the same relief preset on every newly exposed face: front/back surfaces, cut-side walls,
  // recessed floors, top/bottom edges, and side edges, without creating a second shell or any gap.
  mat.bumpMap = bump;
  mat.bumpScale = (.075 + preset.amp * 2.15) * cfg.amount * clamp(safeFinite(strength, 1), .25, 3);
  mat.needsUpdate = true;
  return mat;
}

function makeReferenceChiseledMaterial(materialKind='wall'){
  return applyChiseledReliefSkinToMaterial(referenceArchitectureMaterial(materialKind), STATE?.referenceArchitecture?.material, 1.18);
}

function reliefFract(v){
  return v - Math.floor(v);
}

function reliefFade(t){
  return t * t * t * (t * (t * 6 - 15) + 10);
}

function reliefHash2D(ix, iy, seed){
  // Deterministic integer hash. Avoids sine-wave repetition and gives stable saved surfaces.
  let h = Math.imul(ix | 0, 374761393) ^ Math.imul(iy | 0, 668265263) ^ Math.imul(Math.floor(seed) | 0, 1442695041);
  h = Math.imul(h ^ (h >>> 13), 1274126177);
  h = (h ^ (h >>> 16)) >>> 0;
  return h / 4294967295;
}

function reliefValueNoise2D(x, z, seed){
  const ix = Math.floor(x), iz = Math.floor(z);
  const fx = x - ix, fz = z - iz;
  const u = reliefFade(fx), v = reliefFade(fz);
  const a = reliefHash2D(ix, iz, seed);
  const b = reliefHash2D(ix + 1, iz, seed);
  const c = reliefHash2D(ix, iz + 1, seed);
  const d = reliefHash2D(ix + 1, iz + 1, seed);
  const x1 = THREE.MathUtils.lerp(a, b, u);
  const x2 = THREE.MathUtils.lerp(c, d, u);
  return THREE.MathUtils.lerp(x1, x2, v);
}

function reliefFbm2D(x, z, seed, octaves=4, lacunarity=2.03, gain=.52){
  let sum = 0, amp = .5, norm = 0;
  let fx = x, fz = z;
  for(let i=0; i<octaves; i++){
    sum += (reliefValueNoise2D(fx, fz, seed + i * 1013) * 2 - 1) * amp;
    norm += amp;
    fx *= lacunarity;
    fz *= lacunarity;
    amp *= gain;
  }
  return norm ? clamp(sum / norm, -1, 1) : 0;
}

function reliefRidged2D(x, z, seed, octaves=3){
  const n = reliefFbm2D(x, z, seed, octaves, 2.11, .54);
  return (1 - Math.abs(n)) * 2 - 1;
}

function reliefNoise2D(x,z,cfg,preset){
  if(!preset.octaves) return 0;

  const variation = clamp(safeFinite(cfg.variation,.5),0,1);
  const seed = safeFinite(cfg.seed,104729);
  const baseFreq = Math.max(.001, preset.freq * .72);

  // variation now means spatial randomness / uneven density, not repeated wave frequency.
  // Low values: smoother and more even. High values: domain-warped, patchy dense/sparse relief.
  const warpScale = variation * (1.15 + preset.freq * .34);
  const lowFreq = baseFreq * (.115 + variation * .105);
  const warpX = reliefFbm2D(x * lowFreq + 17.73, z * lowFreq - 9.41, seed + 701, 3, 2.0, .56) * warpScale;
  const warpZ = reliefFbm2D(x * lowFreq - 31.19, z * lowFreq + 22.07, seed + 1601, 3, 2.0, .56) * warpScale;

  const nx = (x + warpX) * baseFreq;
  const nz = (z + warpZ) * baseFreq;
  const oct = Math.round(clamp(preset.octaves + variation * 3, 1, 8));
  const broad = reliefFbm2D(nx, nz, seed + 11, oct, 1.96 + variation * .36, .50 + variation * .10);
  const fine = reliefFbm2D(nx * (2.35 + variation * 3.75) + 71.9, nz * (2.35 + variation * 3.75) - 43.2, seed + 313, Math.max(2, Math.round(oct * .7)), 2.17, .48);
  const ridged = reliefRidged2D(nx * (1.4 + variation * 2.15) - 8.5, nz * (1.4 + variation * 2.15) + 12.7, seed + 911, Math.max(2, Math.round(oct * .55)));

  const densityRaw = reliefFbm2D(x * lowFreq * .72 + 5.1, z * lowFreq * .72 - 3.8, seed + 2203, 4, 2.0, .58);
  const density01 = clamp(densityRaw * .5 + .5, 0, 1);
  const patchMask = THREE.MathUtils.lerp(1, .18 + Math.pow(density01, 1.85) * 1.62, variation);

  let n = broad * (1 - variation * .42) + fine * (variation * .34) + ridged * (variation * .24);
  n *= patchMask;

  // Small seeded cell jitter breaks any remaining grid continuity without creating periodic stripes.
  const jitterScale = baseFreq * (3.2 + variation * 7.5);
  const jitter = (reliefValueNoise2D(x * jitterScale + 109.4, z * jitterScale - 52.6, seed + 4001) * 2 - 1) * variation * .16;
  return clamp(n + jitter, -1, 1);
}

function createReliefVolumeGeometry({width, height, segX, segY, sampleNoise, maxAmp}){
  // Build a real relief shell instead of a floating displaced PlaneGeometry.
  // Top vertices are displaced only outward from the original surface; perimeter skirt faces
  // connect the relief cap back to z=0, so the relief and the base box read as one fused volume.
  const cols = segX + 1;
  const rows = segY + 1;
  const raw = new Array(cols * rows);
  let minN = Infinity, maxN = -Infinity;
  for(let iy=0; iy<rows; iy++){
    const y = -height/2 + (iy / segY) * height;
    for(let ix=0; ix<cols; ix++){
      const x = -width/2 + (ix / segX) * width;
      const n = safeFinite(sampleNoise(x,y), 0);
      raw[iy * cols + ix] = n;
      if(n < minN) minN = n;
      if(n > maxN) maxN = n;
    }
  }
  const span = Math.max(1e-6, maxN - minN);
  const surfaceEps = .003;
  const positions = [];
  const uvs = [];
  const indices = [];
  const topIndex = (ix,iy)=>iy * cols + ix;
  for(let iy=0; iy<rows; iy++){
    const y = -height/2 + (iy / segY) * height;
    const v = iy / segY;
    for(let ix=0; ix<cols; ix++){
      const x = -width/2 + (ix / segX) * width;
      const u = ix / segX;
      const normalised = (raw[iy * cols + ix] - minN) / span;
      const z = surfaceEps + normalised * maxAmp;
      positions.push(x,y,z);
      uvs.push(u,v);
    }
  }
  for(let iy=0; iy<segY; iy++){
    for(let ix=0; ix<segX; ix++){
      const a = topIndex(ix,iy);
      const b = topIndex(ix+1,iy);
      const c = topIndex(ix,iy+1);
      const d = topIndex(ix+1,iy+1);
      indices.push(a,b,d, a,d,c);
    }
  }
  const addBaseVertex = (x,y,u,v)=>{
    const idx = positions.length / 3;
    positions.push(x,y,0);
    uvs.push(u,v);
    return idx;
  };
  const addSkirtQuad = (topA, topB, bottomA, bottomB)=>{
    indices.push(topA,bottomA,topB, topB,bottomA,bottomB);
  };
  // bottom edge
  for(let ix=0; ix<segX; ix++){
    const x0 = -width/2 + (ix / segX) * width;
    const x1 = -width/2 + ((ix+1) / segX) * width;
    const y = -height/2;
    const topA = topIndex(ix,0), topB = topIndex(ix+1,0);
    const bottomA = addBaseVertex(x0,y,ix/segX,0);
    const bottomB = addBaseVertex(x1,y,(ix+1)/segX,0);
    addSkirtQuad(topA, topB, bottomA, bottomB);
  }
  // top edge
  for(let ix=0; ix<segX; ix++){
    const x0 = -width/2 + (ix / segX) * width;
    const x1 = -width/2 + ((ix+1) / segX) * width;
    const y = height/2;
    const topA = topIndex(ix,segY), topB = topIndex(ix+1,segY);
    const bottomA = addBaseVertex(x0,y,ix/segX,1);
    const bottomB = addBaseVertex(x1,y,(ix+1)/segX,1);
    addSkirtQuad(topB, topA, bottomB, bottomA);
  }
  // left edge
  for(let iy=0; iy<segY; iy++){
    const y0 = -height/2 + (iy / segY) * height;
    const y1 = -height/2 + ((iy+1) / segY) * height;
    const x = -width/2;
    const topA = topIndex(0,iy), topB = topIndex(0,iy+1);
    const bottomA = addBaseVertex(x,y0,0,iy/segY);
    const bottomB = addBaseVertex(x,y1,0,(iy+1)/segY);
    addSkirtQuad(topB, topA, bottomB, bottomA);
  }
  // right edge
  for(let iy=0; iy<segY; iy++){
    const y0 = -height/2 + (iy / segY) * height;
    const y1 = -height/2 + ((iy+1) / segY) * height;
    const x = width/2;
    const topA = topIndex(segX,iy), topB = topIndex(segX,iy+1);
    const bottomA = addBaseVertex(x,y0,1,iy/segY);
    const bottomB = addBaseVertex(x,y1,1,(iy+1)/segY);
    addSkirtQuad(topA, topB, bottomA, bottomB);
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
  geo.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
  geo.setIndex(indices);
  geo.computeVertexNormals();
  return geo;
}


function sandBaseMicroHeightLocal(x,z,w,d,sand){
  const grain = clamp(safeFinite(sand?.grain,.42),0,1);
  const seed = safeFinite(sand?.seed,6151);
  const nx = (x/Math.max(.001,w))*2, nz = (z/Math.max(.001,d))*2;
  const fine = reliefFbm2D(nx*(5.5+grain*18), nz*(5.5+grain*18), seed+23, 4);
  const ripple = Math.sin(nx*(23+grain*21) + Math.sin(nz*7+seed)*.85 + nz*(12+grain*7));
  const longWave = Math.sin(nx*2.2 + nz*5.8 + seed*.01);
  return fine*(.012+grain*.026) + ripple*(.006+grain*.01) + longWave*.011;
}
function sandDeformHeightLocal(x,z,sand){
  let h=0;
  for(const d of (Array.isArray(sand?.deforms)?sand.deforms:[])){
    const dx=x-safeFinite(d.x,0), dz=z-safeFinite(d.z,0), r=Math.max(.001,safeFinite(d.radius,1));
    const q=Math.sqrt(dx*dx+dz*dz)/r;
    if(q>=1) continue;
    const smooth=(1-q*q)*(1-q*q);
    let local=safeFinite(d.height,0)*smooth;
    if(d.falloff==='rim' && d.height<0) local += Math.exp(-Math.pow((q-.74)/.14,2))*Math.abs(d.height)*.28;
    h += local;
  }
  return h;
}
function sandHeightLocal(x,z,w,d,sand){ return sandBaseMicroHeightLocal(x,z,w,d,sand) + sandDeformHeightLocal(x,z,sand); }
function createSandTerrainGeometry(width,depth,sand){
  const grain=clamp(safeFinite(sand?.grain,.42),0,1);
  const segX=Math.min(112,Math.max(36,Math.ceil(width*(5.5+grain*7))));
  const segZ=Math.min(112,Math.max(36,Math.ceil(depth*(5.5+grain*7))));
  const vertices=[],uvs=[],indices=[];
  for(let iz=0;iz<=segZ;iz++){ const vz=-depth/2+depth*iz/segZ; for(let ix=0;ix<=segX;ix++){ const vx=-width/2+width*ix/segX; vertices.push(vx,sandHeightLocal(vx,vz,width,depth,sand),vz); uvs.push(ix/segX,iz/segZ); }}
  for(let iz=0;iz<segZ;iz++) for(let ix=0;ix<segX;ix++){ const a=iz*(segX+1)+ix,b=a+1,c=a+(segX+1),d=c+1; indices.push(a,c,b,b,c,d); }
  const geo=new THREE.BufferGeometry(); geo.setAttribute('position',new THREE.Float32BufferAttribute(vertices,3)); geo.setAttribute('uv',new THREE.Float32BufferAttribute(uvs,2)); geo.setIndex(indices); geo.computeVertexNormals(); geo.userData.sandSegments=[segX,segZ]; return geo;
}
function createSandSurfaceGrainPoints(width,depth,sand){
  const s = normalizeSandConfig(sand || {});
  const grain = clamp(safeFinite(s.grain,.42),0,1);
  const area = Math.max(.01,width*depth);
  const count = Math.round(clamp(area * (26 + (1-grain) * 52), 900, 7600));
  const positions = new Float32Array(count*3);
  const colors = new Float32Array(count*3);
  const base = new THREE.Color(s.color);
  for(let i=0;i<count;i++){
    const rx = seededRandom(i, s.seed, 2309);
    const rz = seededRandom(i, s.seed, 3617);
    const vx = (rx-.5)*width;
    const vz = (rz-.5)*depth;
    const vy = sandHeightLocal(vx,vz,width,depth,s) + .028 + seededRandom(i, s.seed, 4789)*.022;
    positions[i*3] = vx;
    positions[i*3+1] = vy;
    positions[i*3+2] = vz;
    const tone = (seededRandom(i, s.seed, 6421)-.5)*.34;
    const fleck = seededRandom(i, s.seed, 7753);
    const lift = fleck > .9 ? .26 : (fleck < .12 ? -.22 : 0);
    colors[i*3] = clamp(base.r + tone + lift,0,1);
    colors[i*3+1] = clamp(base.g + tone*.82 + lift*.78,0,1);
    colors[i*3+2] = clamp(base.b + tone*.55 + lift*.5,0,1);
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(positions,3));
  geo.setAttribute('color', new THREE.BufferAttribute(colors,3));
  const mat = new THREE.PointsMaterial({
    size:.014 + grain*.034,
    sizeAttenuation:true,
    vertexColors:true,
    transparent:true,
    opacity:.72,
    depthWrite:false,
    depthTest:true
  });
  const points = new THREE.Points(geo, mat);
  points.name = 'sand-visible-grain-points';
  points.renderOrder = 7;
  points.frustumCulled = false;
  points.userData.isSandGrainPoints = true;
  return points;
}

function createSandTerrainMesh({width,depth,topY=0,centerX=0,centerZ=0,matCfg,fallbackColor='#c9ad79',userData={},name=''}){
  const sand=ensureSandConfigOnMaterial(matCfg||{}); if(!sand.enabled) return null;
  const mesh=new THREE.Mesh(createSandTerrainGeometry(Math.max(.05,width),Math.max(.05,depth),sand), makeMaterial(matCfg,fallbackColor));
  mesh.material.side=THREE.DoubleSide;
  mesh.material.transparent = false;
  mesh.material.opacity = 1;
  mesh.material.depthWrite = true;
  mesh.material.depthTest = true;
  mesh.material.polygonOffset = true;
  mesh.material.polygonOffsetFactor = -1;
  mesh.material.polygonOffsetUnits = -2;
  mesh.position.set(centerX,topY+.045,centerZ);
  mesh.renderOrder = 3;
  mesh.name=name||'sand-terrain';
  // 沙面不接收即時陰影。截圖中的全黑區塊不是沙色失效，而是天花／牆面陰影把沙地壓黑。
  // 沙地材質已用細砂貼圖、bump 與低強度 emissive 保留立體感，避免整片黑白化。
  mesh.receiveShadow=false;
  mesh.castShadow=false;
  mesh.userData={...userData,isSandTerrain:true,sandWidth:width,sandDepth:depth,sandTopY:topY};
  const grainPoints = createSandSurfaceGrainPoints(width, depth, sand);
  if(grainPoints) mesh.add(grainPoints);
  return mesh;
}

function createGroundReliefMesh({width, depth, centerX, topY, centerZ, matCfg, userData}){
  const cfg = getReliefConfigForMaterial(matCfg);
  const preset = GROUND_RELIEF_PRESETS[cfg.preset] || GROUND_RELIEF_PRESETS.flat;
  if(cfg.preset === 'flat' || cfg.amount <= .001 || width <= 0 || depth <= 0) return null;
  const baseSeg = Math.round(24 + cfg.variation * 96);
  const aspect = clamp(width / Math.max(depth,.001), .25, 4);
  const segX = Math.round(clamp(baseSeg * Math.sqrt(aspect), 16, 160));
  const segZ = Math.round(clamp(baseSeg / Math.sqrt(aspect), 16, 160));
  const maxAmp = preset.amp * cfg.amount;
  const geo = createReliefVolumeGeometry({
    width,
    height:depth,
    segX,
    segY:segZ,
    maxAmp,
    sampleNoise:(x,z)=>reliefNoise2D(x,z,cfg,preset)
  });
  const mat = makeMaterial(matCfg, matCfg?.color || STATE?.surfaces?.floor?.color || '#8d897f');
  mat.side = THREE.DoubleSide;
  mat.polygonOffset = true;
  mat.polygonOffsetFactor = -1;
  mat.polygonOffsetUnits = -1;
  const mesh = new THREE.Mesh(geo, mat);
  mesh.name = 'ground-relief';
  mesh.rotation.x = -Math.PI / 2;
  // z=0 of the relief shell is exactly on the top face of the floor slab.
  // The generated skirt fills the entire perimeter, so the relief surface does not look like
  // a floating thin sheet above a separate box.
  mesh.position.set(centerX, topY, centerZ);
  mesh.receiveShadow = true;
  mesh.castShadow = false;
  mesh.renderOrder = 4;
  mesh.userData = {...(userData||{}), isGroundRelief:true, reliefMaxAmp:maxAmp, isReliefVolume:true};
  return mesh;
}

function createReliefPlaneMesh({width, height, position, rotation, matCfg, fallbackColor='#cccccc', userData, name='surface-relief', side=THREE.DoubleSide, detailScale=1}){
  const cfg = getReliefConfigForMaterial(matCfg);
  const preset = GROUND_RELIEF_PRESETS[cfg.preset] || GROUND_RELIEF_PRESETS.flat;
  if(cfg.preset === 'flat' || cfg.amount <= .001 || width <= 0 || height <= 0) return null;
  const detail = clamp(safeFinite(detailScale,1), .25, 1.25);
  const baseSeg = Math.round((24 + cfg.variation * 96) * detail);
  const aspect = clamp(width / Math.max(height,.001), .25, 4);
  const segX = Math.round(clamp(baseSeg * Math.sqrt(aspect), 10, 160));
  const segY = Math.round(clamp(baseSeg / Math.sqrt(aspect), 10, 160));
  const maxAmp = preset.amp * cfg.amount;
  const geo = createReliefVolumeGeometry({
    width,
    height,
    segX,
    segY,
    maxAmp,
    sampleNoise:(x,y)=>reliefNoise2D(x,y,cfg,preset)
  });
  const mat = makeMaterial(matCfg, fallbackColor);
  mat.side = THREE.DoubleSide;
  mat.polygonOffset = true;
  mat.polygonOffsetFactor = -1;
  mat.polygonOffsetUnits = -1;
  const mesh = new THREE.Mesh(geo, mat);
  mesh.name = name;
  mesh.position.copy(position);
  mesh.rotation.copy(rotation);
  // The shell begins at local z=0, exactly on the visible face of the base slab/wall.
  // Relief displacement grows only outward along local +Z; perimeter skirt faces close the gap.
  mesh.receiveShadow = true;
  mesh.castShadow = false;
  mesh.renderOrder = 4;
  mesh.userData = {...(userData||{}), isGroundRelief:true, isSurfaceRelief:true, reliefMaxAmp:maxAmp, isReliefVolume:true};
  return mesh;
}


function createReliefBoxFacesGroup({width, height, depth, position, rotation, matCfg, fallbackColor='#cccccc', userData, name='box-relief', detailScale=1}){
  const cfg = getReliefConfigForMaterial(matCfg);
  const preset = GROUND_RELIEF_PRESETS[cfg.preset] || GROUND_RELIEF_PRESETS.flat;
  if(cfg.preset === 'flat' || cfg.amount <= .001 || width <= 0 || height <= 0 || depth <= 0) return null;
  const group = new THREE.Group();
  group.name = name;
  group.position.copy(position);
  group.rotation.copy(rotation || new THREE.Euler());
  group.userData = {...(userData||{}), isGroundRelief:true, isSurfaceRelief:true, isReliefVolume:true, isReliefBoxFaces:true};

  const w = Math.max(.02, width);
  const h = Math.max(.02, height);
  const d = Math.max(.02, depth);
  const faceSpecs = [
    {suffix:'front',  width:w, height:h, pos:new THREE.Vector3(0,0,d/2),  rot:new THREE.Euler(0,0,0)},
    {suffix:'back',   width:w, height:h, pos:new THREE.Vector3(0,0,-d/2), rot:new THREE.Euler(0,Math.PI,0)},
    {suffix:'right',  width:d, height:h, pos:new THREE.Vector3(w/2,0,0),  rot:new THREE.Euler(0,Math.PI/2,0)},
    {suffix:'left',   width:d, height:h, pos:new THREE.Vector3(-w/2,0,0), rot:new THREE.Euler(0,-Math.PI/2,0)},
    {suffix:'top',    width:w, height:d, pos:new THREE.Vector3(0,h/2,0),  rot:new THREE.Euler(-Math.PI/2,0,0)},
    {suffix:'bottom', width:w, height:d, pos:new THREE.Vector3(0,-h/2,0), rot:new THREE.Euler(Math.PI/2,0,0)}
  ];

  for(const spec of faceSpecs){
    const mesh = createReliefPlaneMesh({
      width:spec.width,
      height:spec.height,
      position:new THREE.Vector3(0,0,0),
      rotation:new THREE.Euler(0,0,0),
      matCfg,
      fallbackColor,
      userData:{...(userData||{}), reliefFace:spec.suffix, isReliefBoxFace:true},
      name:`${name}-${spec.suffix}`,
      side:THREE.DoubleSide,
      detailScale
    });
    if(!mesh) continue;
    mesh.position.copy(spec.pos);
    mesh.rotation.copy(spec.rot);
    mesh.renderOrder = 4;
    group.add(mesh);
  }
  return group.children.length ? group : null;
}

function subdivideGeometryTriangles(geometry, iterations=1){
  let geo = geometry.index ? geometry.toNonIndexed() : geometry.clone();
  const iters = Math.round(clamp(safeFinite(iterations,1),0,3));
  for(let iter=0; iter<iters; iter++){
    const pos = geo.getAttribute('position');
    const uv = geo.getAttribute('uv');
    if(!pos || pos.count < 3) return geo;
    const outPos = [];
    const outUv = [];
    const p0 = new THREE.Vector3(), p1 = new THREE.Vector3(), p2 = new THREE.Vector3();
    const m01 = new THREE.Vector3(), m12 = new THREE.Vector3(), m20 = new THREE.Vector3();
    const u0 = new THREE.Vector2(), u1 = new THREE.Vector2(), u2 = new THREE.Vector2();
    const u01 = new THREE.Vector2(), u12 = new THREE.Vector2(), u20 = new THREE.Vector2();
    const readP = (i,target)=>target.set(pos.getX(i), pos.getY(i), pos.getZ(i));
    const readUv = (i,target)=> uv ? target.set(uv.getX(i), uv.getY(i)) : target.set(0,0);
    const pushV = (v,uvv)=>{ outPos.push(v.x,v.y,v.z); outUv.push(uvv.x,uvv.y); };
    const pushTri = (a,ua,b,ub,c,uc)=>{ pushV(a,ua); pushV(b,ub); pushV(c,uc); };
    for(let i=0; i<pos.count; i+=3){
      readP(i,p0); readP(i+1,p1); readP(i+2,p2);
      readUv(i,u0); readUv(i+1,u1); readUv(i+2,u2);
      m01.copy(p0).add(p1).multiplyScalar(.5);
      m12.copy(p1).add(p2).multiplyScalar(.5);
      m20.copy(p2).add(p0).multiplyScalar(.5);
      u01.copy(u0).add(u1).multiplyScalar(.5);
      u12.copy(u1).add(u2).multiplyScalar(.5);
      u20.copy(u2).add(u0).multiplyScalar(.5);
      pushTri(p0,u0,m01,u01,m20,u20);
      pushTri(m01,u01,p1,u1,m12,u12);
      pushTri(m20,u20,m12,u12,p2,u2);
      pushTri(m01,u01,m12,u12,m20,u20);
    }
    geo.dispose?.();
    const next = new THREE.BufferGeometry();
    next.setAttribute('position', new THREE.Float32BufferAttribute(outPos,3));
    next.setAttribute('uv', new THREE.Float32BufferAttribute(outUv,2));
    next.computeVertexNormals();
    geo = next;
  }
  return geo;
}


function densifyGeometryByEdgeLength(geometry, {targetEdge=.16, maxPasses=6, maxVertices=65000}={}){
  // Boolean/chisel meshes often leave the newly exposed wall as a few huge triangles.
  // A displaced shell on those triangles can only look flat.  This adaptive bisection
  // adds enough vertices for the existing procedural rock noise to become visible again,
  // while a vertex cap prevents the whole reference building from becoming too heavy.
  let geo = geometry.index ? geometry.toNonIndexed() : geometry.clone();
  const target = Math.max(.01, safeFinite(targetEdge, .16));
  const passCount = Math.round(clamp(safeFinite(maxPasses,6),0,8));
  const vertexLimit = Math.round(clamp(safeFinite(maxVertices,65000),3000,120000));
  const p0 = new THREE.Vector3(), p1 = new THREE.Vector3(), p2 = new THREE.Vector3();
  const u0 = new THREE.Vector2(), u1 = new THREE.Vector2(), u2 = new THREE.Vector2();
  const midP = new THREE.Vector3(), midU = new THREE.Vector2();

  const readUv = (uv,i,target)=> uv ? target.set(uv.getX(i), uv.getY(i)) : target.set(0,0);
  const pushV = (arrPos, arrUv, p, u)=>{ arrPos.push(p.x,p.y,p.z); arrUv.push(u.x,u.y); };
  const pushTri = (arrPos, arrUv, a,ua,b,ub,c,uc)=>{
    pushV(arrPos,arrUv,a,ua); pushV(arrPos,arrUv,b,ub); pushV(arrPos,arrUv,c,uc);
  };

  for(let pass=0; pass<passCount; pass++){
    const pos = geo.getAttribute('position');
    const uv = geo.getAttribute('uv');
    if(!pos || pos.count < 3) return geo;
    const outPos = [];
    const outUv = [];
    let changed = false;
    let budgetHit = false;

    for(let i=0; i<pos.count; i+=3){
      p0.set(pos.getX(i), pos.getY(i), pos.getZ(i));
      p1.set(pos.getX(i+1), pos.getY(i+1), pos.getZ(i+1));
      p2.set(pos.getX(i+2), pos.getY(i+2), pos.getZ(i+2));
      readUv(uv,i,u0); readUv(uv,i+1,u1); readUv(uv,i+2,u2);
      const l01 = p0.distanceTo(p1);
      const l12 = p1.distanceTo(p2);
      const l20 = p2.distanceTo(p0);
      const longest = Math.max(l01,l12,l20);
      const canSplit = longest > target && (outPos.length / 3 + 6) < vertexLimit;
      if(!canSplit){
        if(longest > target) budgetHit = true;
        pushTri(outPos,outUv,p0,u0,p1,u1,p2,u2);
        continue;
      }
      changed = true;
      if(l01 >= l12 && l01 >= l20){
        midP.copy(p0).add(p1).multiplyScalar(.5);
        midU.copy(u0).add(u1).multiplyScalar(.5);
        pushTri(outPos,outUv,p0,u0,midP,midU,p2,u2);
        pushTri(outPos,outUv,midP,midU,p1,u1,p2,u2);
      }else if(l12 >= l01 && l12 >= l20){
        midP.copy(p1).add(p2).multiplyScalar(.5);
        midU.copy(u1).add(u2).multiplyScalar(.5);
        pushTri(outPos,outUv,p0,u0,p1,u1,midP,midU);
        pushTri(outPos,outUv,p0,u0,midP,midU,p2,u2);
      }else{
        midP.copy(p2).add(p0).multiplyScalar(.5);
        midU.copy(u2).add(u0).multiplyScalar(.5);
        pushTri(outPos,outUv,p0,u0,p1,u1,midP,midU);
        pushTri(outPos,outUv,midP,midU,p1,u1,p2,u2);
      }
    }

    if(!changed) break;
    geo.dispose?.();
    const next = new THREE.BufferGeometry();
    next.setAttribute('position', new THREE.Float32BufferAttribute(outPos,3));
    next.setAttribute('uv', new THREE.Float32BufferAttribute(outUv,2));
    next.computeVertexNormals();
    geo = next;
    if(budgetHit) break;
  }
  return geo;
}

function createClosedGeometryReliefOverlay({geometry, matCfg, fallbackColor='#cccccc', userData, name='closed-relief-overlay', subdivideIterations=0}){
  const cfg = getReliefConfigForMaterial(matCfg);
  const preset = GROUND_RELIEF_PRESETS[cfg.preset] || GROUND_RELIEF_PRESETS.flat;
  if(cfg.preset === 'flat' || cfg.amount <= .001 || !geometry) return null;
  let geo = geometry.clone();
  if(subdivideIterations > 0){
    const base = geo;
    geo = subdivideGeometryTriangles(base, subdivideIterations);
    base.dispose?.();
  }
  geo.computeVertexNormals();
  const pos = geo.getAttribute('position');
  const norm = geo.getAttribute('normal');
  if(!pos || !norm) return null;
  const raw = new Float32Array(pos.count);
  let minN = Infinity, maxN = -Infinity;
  for(let i=0;i<pos.count;i++){
    const x = pos.getX(i), y = pos.getY(i), z = pos.getZ(i);
    const ax = Math.abs(norm.getX(i)), ay = Math.abs(norm.getY(i)), az = Math.abs(norm.getZ(i));
    let u = x, v = y;
    if(ay >= ax && ay >= az){ u = x; v = z; }
    else if(ax >= az){ u = z; v = y; }
    else { u = x; v = y; }
    const n = safeFinite(reliefNoise2D(u, v, cfg, preset), 0);
    raw[i] = n;
    if(n < minN) minN = n;
    if(n > maxN) maxN = n;
  }
  const span = Math.max(1e-6, maxN - minN);
  const maxAmp = preset.amp * cfg.amount;
  const surfaceEps = .004;
  for(let i=0;i<pos.count;i++){
    const normalised = (raw[i] - minN) / span;
    const d = surfaceEps + normalised * maxAmp;
    pos.setXYZ(
      i,
      pos.getX(i) + norm.getX(i) * d,
      pos.getY(i) + norm.getY(i) * d,
      pos.getZ(i) + norm.getZ(i) * d
    );
  }
  pos.needsUpdate = true;
  geo.computeVertexNormals();
  geo.computeBoundingBox();
  geo.computeBoundingSphere();
  const mat = makeMaterial(matCfg, fallbackColor);
  mat.side = THREE.DoubleSide;
  mat.polygonOffset = true;
  mat.polygonOffsetFactor = -1;
  mat.polygonOffsetUnits = -1;
  const mesh = new THREE.Mesh(geo, mat);
  mesh.name = name;
  mesh.receiveShadow = true;
  mesh.castShadow = false;
  mesh.renderOrder = 4;
  mesh.userData = {...(userData||{}), isGroundRelief:true, isSurfaceRelief:true, isReliefVolume:true, isClosedReliefOverlay:true};
  return mesh;
}

function createClosedGeometryReliefShellOverlay({geometry, matCfg, fallbackColor='#cccccc', userData, name='closed-relief-shell-overlay', subdivideIterations=1, sharpEdgeDot=.985}={}){
  const cfg = getReliefConfigForMaterial(matCfg);
  const preset = GROUND_RELIEF_PRESETS[cfg.preset] || GROUND_RELIEF_PRESETS.flat;
  if(cfg.preset === 'flat' || cfg.amount <= .001 || !geometry) return null;

  // The previous chiseled relief shell displaced every triangle along its own face normal and then
  // filled all sharp triangle edges with skirt faces. Around Boolean / chisel cuts that produced
  // triangular fins. The last repair removed those fins but left the rebuilt chisel surface too
  // under-tessellated, so the rock relief had almost no vertices to express its noise. This version
  // keeps the welded anti-spike topology, then adaptively subdivides long triangles before sampling
  // multi-scale procedural rock height.
  let work = geometry.clone();
  const iter = Math.max(0, Math.round(safeFinite(subdivideIterations, 1)));
  if(iter > 0){
    const base = work;
    work = subdivideGeometryTriangles(base, iter);
    base.dispose?.();
  }
  work.computeBoundingBox?.();
  const bboxSize = new THREE.Vector3();
  work.boundingBox?.getSize(bboxSize);
  const maxDim = Math.max(bboxSize.x || 0, bboxSize.y || 0, bboxSize.z || 0, .001);
  const baseTarget = .34 / Math.max(1, preset.freq * (.72 + cfg.variation * .95));
  const targetEdge = clamp(Math.max(baseTarget, maxDim / 115), .055, .24);
  const denseMaxVertices = userData?.referenceArchitecture ? 52000 : 76000;
  const dense = densifyGeometryByEdgeLength(work, {
    targetEdge,
    maxPasses:7,
    maxVertices:denseMaxVertices
  });
  work.dispose?.();
  const geo = dense.index ? dense.toNonIndexed() : dense.clone();
  if(dense !== geo) dense.dispose?.();
  const srcPos = geo.getAttribute('position');
  const srcUv = geo.getAttribute('uv');
  if(!srcPos || srcPos.count < 3){
    geo.dispose?.();
    return null;
  }

  const faceNormals = new Float32Array(srcPos.count * 3);
  const groups = new Map();
  const neighbors = new Map();
  const edgeMap = new Map();
  const q = v=>Math.round(v * 100000) / 100000;
  const pKey = idx=>`${q(srcPos.getX(idx))},${q(srcPos.getY(idx))},${q(srcPos.getZ(idx))}`;
  const readUv = idx=> srcUv ? [srcUv.getX(idx), srcUv.getY(idx)] : [0,0];
  const ensureGroup = idx=>{
    const key = pKey(idx);
    let rec = groups.get(key);
    if(!rec){
      rec = {
        key,
        x:srcPos.getX(idx),
        y:srcPos.getY(idx),
        z:srcPos.getZ(idx),
        uv:readUv(idx),
        nx:0, ny:0, nz:0,
        count:0,
        raw:0,
        baseIndex:-1,
        topIndex:-1
      };
      groups.set(key, rec);
      neighbors.set(key, new Set());
    }
    return rec;
  };
  const connect = (ka,kb)=>{
    if(ka === kb) return;
    if(!neighbors.has(ka)) neighbors.set(ka, new Set());
    if(!neighbors.has(kb)) neighbors.set(kb, new Set());
    neighbors.get(ka).add(kb);
    neighbors.get(kb).add(ka);
  };
  const addEdgeRecord = (ia,ib)=>{
    const ka = pKey(ia), kb = pKey(ib);
    const edgeKey = ka < kb ? `${ka}|${kb}` : `${kb}|${ka}`;
    if(!edgeMap.has(edgeKey)) edgeMap.set(edgeKey, []);
    edgeMap.get(edgeKey).push({aKey:ka, bKey:kb});
  };
  const projectFor = (x,y,z,n)=>{
    const ax = Math.abs(n.x), ay = Math.abs(n.y), az = Math.abs(n.z);
    if(ay >= ax && ay >= az) return [x, z];
    if(ax >= az) return [z, y];
    return [x, y];
  };
  const sampleProjected = (x,y,z,n,scale=1,seedOffset=0,variationOffset=0)=>{
    const uvp = projectFor(x,y,z,n);
    const localCfg = {
      ...cfg,
      seed: safeFinite(cfg.seed,104729) + seedOffset,
      variation: clamp(safeFinite(cfg.variation,.5) + variationOffset, 0, 1)
    };
    return reliefNoise2D(uvp[0] * scale, uvp[1] * scale, localCfg, preset);
  };
  const sampleFor = (x,y,z,n)=>sampleProjected(x,y,z,n,1,0,0);

  const a = new THREE.Vector3(), b = new THREE.Vector3(), c = new THREE.Vector3();
  const ab = new THREE.Vector3(), ac = new THREE.Vector3(), nrm = new THREE.Vector3();
  for(let i=0; i<srcPos.count; i+=3){
    a.set(srcPos.getX(i), srcPos.getY(i), srcPos.getZ(i));
    b.set(srcPos.getX(i+1), srcPos.getY(i+1), srcPos.getZ(i+1));
    c.set(srcPos.getX(i+2), srcPos.getY(i+2), srcPos.getZ(i+2));
    ab.subVectors(b,a);
    ac.subVectors(c,a);
    nrm.crossVectors(ab,ac);
    if(nrm.lengthSq() < 1e-12) nrm.set(0,0,1);
    else nrm.normalize();
    for(let j=0; j<3; j++){
      const k = i + j;
      faceNormals[k*3] = nrm.x;
      faceNormals[k*3+1] = nrm.y;
      faceNormals[k*3+2] = nrm.z;
      const rec = ensureGroup(k);
      rec.nx += nrm.x;
      rec.ny += nrm.y;
      rec.nz += nrm.z;
      rec.count++;
    }
    const k0 = pKey(i), k1 = pKey(i+1), k2 = pKey(i+2);
    connect(k0,k1); connect(k1,k2); connect(k2,k0);
    addEdgeRecord(i, i+1);
    addEdgeRecord(i+1, i+2);
    addEdgeRecord(i+2, i);
  }

  const normal = new THREE.Vector3();
  for(const rec of groups.values()){
    normal.set(rec.nx, rec.ny, rec.nz);
    if(normal.lengthSq() < 1e-12) normal.set(0,0,1);
    else normal.normalize();
    rec.sx = normal.x;
    rec.sy = normal.y;
    rec.sz = normal.z;
    rec.raw = safeFinite(sampleFor(rec.x, rec.y, rec.z, normal), 0);
    rec.micro = safeFinite(sampleProjected(rec.x, rec.y, rec.z, normal, 2.15 + cfg.variation * 3.25, 9701, .16), 0);
    rec.chip = safeFinite(sampleProjected(rec.x, rec.y, rec.z, normal, .62 + cfg.variation * 1.05, 14741, .08), 0);
  }

  // Only a light relaxation is applied to the broad height field.  Strong smoothing was the reason
  // the chiseled rim became round but visually dead.  Fine and chipped layers stay unsmoothed so
  // the surface still reads as irregular stone instead of a flat inflated membrane.
  const smoothIterations = 1;
  for(let pass=0; pass<smoothIterations; pass++){
    const next = new Map();
    for(const rec of groups.values()){
      const nb = neighbors.get(rec.key);
      if(!nb || nb.size === 0){ next.set(rec.key, rec.raw); continue; }
      let sum = 0, count = 0;
      for(const key of nb){
        const other = groups.get(key);
        if(other){ sum += other.raw; count++; }
      }
      const avg = count ? sum / count : rec.raw;
      next.set(rec.key, rec.raw * .82 + avg * .18);
    }
    for(const [key,val] of next) groups.get(key).raw = val;
  }

  let minRaw = Infinity, maxRaw = -Infinity, minMicro = Infinity, maxMicro = -Infinity, minChip = Infinity, maxChip = -Infinity;
  for(const rec of groups.values()){
    if(rec.raw < minRaw) minRaw = rec.raw;
    if(rec.raw > maxRaw) maxRaw = rec.raw;
    if(rec.micro < minMicro) minMicro = rec.micro;
    if(rec.micro > maxMicro) maxMicro = rec.micro;
    if(rec.chip < minChip) minChip = rec.chip;
    if(rec.chip > maxChip) maxChip = rec.chip;
  }
  const normaliseLayer = (v,minV,maxV,contrast=1)=>{
    const span = Math.max(1e-6, maxV - minV);
    return clamp(((v - minV) / span - .5) * contrast + .5, 0, 1);
  };

  const macroAmp = clamp(preset.amp * (1.20 + cfg.variation * .95) * cfg.amount, .006, .22);
  const surfaceEps = .0012;
  const positions = [];
  const uvs = [];
  const indices = [];
  const pushVertex = (x,y,z,uv)=>{
    const out = positions.length / 3;
    positions.push(x,y,z);
    uvs.push(uv[0], uv[1]);
    return out;
  };

  for(const rec of groups.values()){
    const broad01 = normaliseLayer(rec.raw, minRaw, maxRaw, 1.08 + cfg.variation * .42);
    const micro01 = normaliseLayer(rec.micro, minMicro, maxMicro, 1.16 + cfg.variation * .55);
    const chip01 = normaliseLayer(rec.chip, minChip, maxChip, 1.05 + cfg.variation * .35);
    const chipped = Math.abs(chip01 * 2 - 1);
    let height01 = broad01 * .58 + micro01 * .28 + chipped * .14;
    height01 = clamp((height01 - .08) / .92, 0, 1);
    const shaped = height01 * height01 * (3 - 2 * height01);
    const d = surfaceEps + shaped * macroAmp;
    rec.baseIndex = pushVertex(rec.x, rec.y, rec.z, rec.uv);
    rec.topIndex = pushVertex(rec.x + rec.sx * d, rec.y + rec.sy * d, rec.z + rec.sz * d, rec.uv);
  }

  const topIndexFor = idx=>groups.get(pKey(idx))?.topIndex ?? -1;
  const baseIndexFor = idx=>groups.get(pKey(idx))?.baseIndex ?? -1;
  const addTriangle = (ia,ib,ic)=>{
    if(ia < 0 || ib < 0 || ic < 0) return;
    if(ia === ib || ib === ic || ic === ia) return;
    indices.push(ia, ib, ic);
  };
  for(let i=0; i<srcPos.count; i+=3){
    addTriangle(topIndexFor(i), topIndexFor(i+1), topIndexFor(i+2));
  }

  const addBoundarySkirt = rec=>{
    const ga = groups.get(rec.aKey), gb = groups.get(rec.bKey);
    if(!ga || !gb) return;
    addTriangle(ga.topIndex, gb.topIndex, gb.baseIndex);
    addTriangle(ga.topIndex, gb.baseIndex, ga.baseIndex);
  };
  for(const records of edgeMap.values()){
    if(records.length === 1) addBoundarySkirt(records[0]);
  }

  const out = new THREE.BufferGeometry();
  out.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
  out.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
  out.setIndex(indices);
  out.computeVertexNormals();
  out.computeBoundingBox();
  out.computeBoundingSphere();
  geo.dispose?.();

  const mat = makeMaterial(matCfg, fallbackColor);
  applyChiseledReliefSkinToMaterial(mat, matCfg, .62);
  mat.side = THREE.DoubleSide;
  mat.polygonOffset = true;
  mat.polygonOffsetFactor = -2;
  mat.polygonOffsetUnits = -2;
  const mesh = new THREE.Mesh(out, mat);
  mesh.name = name;
  mesh.receiveShadow = true;
  mesh.castShadow = false;
  mesh.renderOrder = 5;
  mesh.userData = {...(userData||{}), isGroundRelief:true, isSurfaceRelief:true, isReliefVolume:true, isClosedReliefOverlay:true, isChiseledReliefShell:true, reliefMaxAmp:macroAmp};
  return mesh;
}

function attachChiseledReliefOverlayToMesh(mesh, {matCfg, fallbackColor='#cccccc', userData=null, name='chiseled-relief-overlay', referenceMaterialKind=null}={}){
  if(!mesh?.geometry || !reliefEnabledForMaterial(matCfg)) return null;

  // Chiselling rebuilds the wall / box into a new real mesh.  The relief must therefore follow
  // that exact rebuilt geometry.  This creates the same kind of relief skin used by straight
  // custom walls, but closes every sharp chisel edge with skirt faces from the displaced cap
  // back to the original mesh.  The visible air gap from a detached thin sheet is filled.
  const overlay = createClosedGeometryReliefShellOverlay({
    geometry:mesh.geometry,
    matCfg,
    fallbackColor,
    userData:{...(userData||{}), chiseledReliefHostUuid:mesh.uuid, referenceMaterialKind},
    name,
    subdivideIterations:1,
    sharpEdgeDot:.985
  });
  if(!overlay) return null;

  const strength = referenceMaterialKind ? 1.22 : 1.18;
  const apply = mat=>applyChiseledReliefSkinToMaterial(mat, matCfg, strength);
  if(Array.isArray(mesh.material)) mesh.material.forEach(apply);
  else apply(mesh.material);

  mesh.add(overlay);
  mesh.userData.hasReliefSurface = true;
  mesh.userData.chiseledReliefAppliedToBaseMaterial = true;
  mesh.userData.chiseledReliefOverlayUuid = overlay.uuid;
  return overlay;
}

function createCurvedWallReliefOverlay(w){
  if(!w || !isCurvedWall(w)) return null;
  const base = createCurvedWallGeometry(w);
  const mesh = createClosedGeometryReliefOverlay({
    geometry:base,
    matCfg:w.material,
    fallbackColor:w.material?.color || '#d6d1c6',
    userData:{wallId:w.id, isCustomWall:true, isCurvedWallRelief:true},
    name:`${w.title || '曲面牆'}_curved-relief-all-faces`
  });
  base.dispose?.();
  if(mesh) applyWallMeshTransform(mesh, w);
  return mesh;
}

function disposeReliefEntry(entry){
  if(!entry) return;
  if(entry.parent) entry.parent.remove(entry);
  if(entry.isGroup){
    disposeObjectTree(entry);
    return;
  }
  entry.geometry?.dispose?.();
  if(Array.isArray(entry.material)) entry.material.forEach(m=>m.dispose?.());
  else entry.material?.dispose?.();
}

function roomSurfaceReliefSpec(key){
  const tr = getSurfaceTransform(key);
  const p = tr.position;
  const s = tr.size;
  const eps = 0;
  if(key === 'floor'){
    return {
      width:Math.max(.02,s.x), height:Math.max(.02,s.z),
      position:new THREE.Vector3(p.x, p.y + s.y/2 + eps, p.z),
      rotation:new THREE.Euler(-Math.PI/2,0,0),
      fallbackColor:STATE?.surfaces?.floor?.color || '#8d897f'
    };
  }
  if(key === 'ceiling'){
    return {
      width:Math.max(.02,s.x), height:Math.max(.02,s.z),
      position:new THREE.Vector3(p.x, p.y - s.y/2 - eps, p.z),
      rotation:new THREE.Euler(Math.PI/2,0,0),
      fallbackColor:STATE?.surfaces?.ceiling?.color || '#bbb4a6'
    };
  }
  if(key === 'front'){
    return {
      width:Math.max(.02,s.x), height:Math.max(.02,s.y),
      position:new THREE.Vector3(p.x, p.y, p.z + s.z/2 + eps),
      rotation:new THREE.Euler(0,0,0),
      fallbackColor:STATE?.surfaces?.front?.color || '#d8d1c4'
    };
  }
  if(key === 'back'){
    return {
      width:Math.max(.02,s.x), height:Math.max(.02,s.y),
      position:new THREE.Vector3(p.x, p.y, p.z - s.z/2 - eps),
      rotation:new THREE.Euler(0,Math.PI,0),
      fallbackColor:STATE?.surfaces?.back?.color || '#cfc7ba'
    };
  }
  if(key === 'left'){
    return {
      width:Math.max(.02,s.z), height:Math.max(.02,s.y),
      position:new THREE.Vector3(p.x + s.x/2 + eps, p.y, p.z),
      rotation:new THREE.Euler(0,Math.PI/2,0),
      fallbackColor:STATE?.surfaces?.left?.color || '#d2ccbf'
    };
  }
  if(key === 'right'){
    return {
      width:Math.max(.02,s.z), height:Math.max(.02,s.y),
      position:new THREE.Vector3(p.x - s.x/2 - eps, p.y, p.z),
      rotation:new THREE.Euler(0,-Math.PI/2,0),
      fallbackColor:STATE?.surfaces?.right?.color || '#d2ccbf'
    };
  }
  return null;
}

function addSurfaceReliefForRoomSurface(key){
  if(!surfaces[key]) return;
  const tr = getSurfaceTransform(key);
  const matCfg = STATE.surfaces[key];
  if(key === 'floor' && sandEnabledForMaterial(matCfg)){
    const mesh = createSandTerrainMesh({width:Math.max(.02,tr.size.x), depth:Math.max(.02,tr.size.z), topY:tr.position.y+tr.size.y/2, centerX:tr.position.x, centerZ:tr.position.z, matCfg, fallbackColor:matCfg?.color || '#c9ad79', userData:{surfaceKey:key, isSelectableSurface:true}, name:`${key}-sand-terrain`});
    if(mesh){ roomGroup.add(mesh); groundReliefMeshes[`surface:${key}`]=mesh; groundReliefMeshes.floor=mesh; sandTerrainMeshes[`surface:${key}`]=mesh; }
    return;
  }
  const mesh = createReliefBoxFacesGroup({
    width:Math.max(.02,tr.size.x),
    height:Math.max(.02,tr.size.y),
    depth:Math.max(.02,tr.size.z),
    position:new THREE.Vector3(tr.position.x, tr.position.y, tr.position.z),
    rotation:new THREE.Euler(0,0,0),
    matCfg,
    fallbackColor:matCfg?.color || '#cccccc',
    userData:{surfaceKey:key, isSelectableSurface:true},
    name:`${key}-surface-relief-all-faces`
  });
  if(mesh){ roomGroup.add(mesh); groundReliefMeshes[`surface:${key}`] = mesh; if(key === 'floor') groundReliefMeshes.floor = mesh; }
}

function addSurfaceReliefForCustomWall(w){
  if(!w) return;
  if(customWallHasChiselHoles(w)){
    // A chiseled straight wall already uses true cut-through geometry.  Do not add a full-box
    // relief overlay here, otherwise the relief shell would visually cover the hole.
    return;
  }
  if(isCurvedWall(w)){
    const curvedRelief = createCurvedWallReliefOverlay(w);
    if(curvedRelief){
      customWallGroup.add(curvedRelief);
      groundReliefMeshes[`wall:${w.id}`] = curvedRelief;
    }
    return;
  }
  const r = wallRotation(w);
  const width = clamp(safeFinite(w.size?.w,3),.02,500);
  const height = clamp(safeFinite(w.size?.h,ROOM.height),.02,500);
  const thickness = clamp(safeFinite(w.size?.t,.18),.02,500);
  const sy = safeFinite(w.size?.h,ROOM.height);
  const center = new THREE.Vector3(
    safeFinite(w.position?.x,0),
    safeFinite(w.position?.y,sy/2),
    safeFinite(w.position?.z,0)
  );
  const rotation = new THREE.Euler(deg(r.x),deg(r.y),deg(r.z));
  const mesh = createReliefBoxFacesGroup({
    width,
    height,
    depth:thickness,
    position:center,
    rotation,
    matCfg:w.material,
    fallbackColor:w.material?.color || '#d6d1c6',
    userData:{wallId:w.id, isCustomWall:true},
    name:`${w.title || '自建牆'}_surface-relief-all-faces`
  });
  if(mesh){
    customWallGroup.add(mesh);
    groundReliefMeshes[`wall:${w.id}`] = mesh;
  }
}

function addGroundReliefForMainFloor(){
  addSurfaceReliefForRoomSurface('floor');
}

function addGroundReliefForFloorTile(tile){
  const t = clamp(safeFinite(tile.size?.t,.18),.02,500);
  const matCfg = tile.material || STATE.surfaces.floor;
  if(sandEnabledForMaterial(matCfg)){
    const mesh = createSandTerrainMesh({width:clamp(safeFinite(tile.size?.w,4),.2,500), depth:clamp(safeFinite(tile.size?.d,4),.2,500), topY:safeFinite(tile.position?.y,-t/2)+t/2, centerX:safeFinite(tile.position?.x,0), centerZ:safeFinite(tile.position?.z,0), matCfg, fallbackColor:matCfg?.color || '#c9ad79', userData:{floorTileId:tile.id, isFloorTile:true}, name:`${tile.title || '地板塊'}_sand-terrain`});
    if(mesh){ floorTileGroup.add(mesh); groundReliefMeshes[`floorTile:${tile.id}`]=mesh; sandTerrainMeshes[`floorTile:${tile.id}`]=mesh; }
    return;
  }
  const mesh = createReliefBoxFacesGroup({
    width:clamp(safeFinite(tile.size?.w,4),.2,500),
    height:t,
    depth:clamp(safeFinite(tile.size?.d,4),.2,500),
    position:new THREE.Vector3(safeFinite(tile.position?.x,0), safeFinite(tile.position?.y,-t/2), safeFinite(tile.position?.z,0)),
    rotation:new THREE.Euler(0,0,0),
    matCfg,
    fallbackColor:matCfg?.color || '#8d897f',
    userData:{floorTileId:tile.id, isFloorTile:true},
    name:`${tile.title || '地板塊'}_surface-relief-all-faces`
  });
  if(mesh){ floorTileGroup.add(mesh); groundReliefMeshes[`floorTile:${tile.id}`] = mesh; }
}

function refreshGroundReliefSelectionVisuals(){
  for(const key of SURFACE_KEYS){
    const mesh = groundReliefMeshes[`surface:${key}`] || (key === 'floor' ? groundReliefMeshes.floor : null);
    if(mesh) applyWallVisualState(mesh, selectedRoomWallKey === key, false);
  }
  for(const tile of (STATE.floorTiles || [])){
    const mesh = groundReliefMeshes[`floorTile:${tile.id}`];
    if(mesh) applyWallVisualState(mesh, selectedFloorTileId === tile.id, !!tile.isDraft);
  }
  for(const w of (STATE.customWalls || [])){
    const mesh = groundReliefMeshes[`wall:${w.id}`];
    if(mesh) applyWallVisualState(mesh, selectedWallId === w.id, !!w.isDraft);
  }
}

function applyWallVisualState(mesh, selected=false, draft=false){
  if(!mesh) return;
  const translucent = selected || draft;
  const sandBase = !!mesh.userData?.sandPhysicalBase;
  const sandTerrain = !!mesh.userData?.isSandTerrain;
  const applyMat = mat=>{
    if(!mat) return;
    // 沙地底下的原始地板只保留碰撞與選取資料，不參與視覺顯示。
    // 先前選取地板時，底板會變成 45% 透明並與沙地 terrain 疊在一起，
    // 導致沙色被灰階底板、陰影與 z-fighting 洗成黑白。
    if(sandBase){
      mat.transparent = true;
      mat.opacity = 0;
      mat.colorWrite = false;
      mat.depthWrite = false;
      mat.depthTest = true;
      mat.needsUpdate = true;
      return;
    }
    // 真正的沙地 terrain 必須維持不透明，否則沙子顏色會被背景與陰影混成灰階。
    if(sandTerrain){
      mat.transparent = false;
      mat.opacity = 1;
      mat.colorWrite = true;
      mat.depthWrite = true;
      mat.depthTest = true;
      mat.needsUpdate = true;
      return;
    }
    mat.transparent = translucent;
    mat.opacity = translucent ? (draft ? .36 : .45) : 1;
    mat.depthWrite = !translucent;
    mat.needsUpdate = true;
  };
  if(Array.isArray(mesh.material)) mesh.material.forEach(applyMat);
  else applyMat(mesh.material);
  if(mesh.children?.length){
    mesh.traverse(child=>{
      if(child === mesh) return;
      if(Array.isArray(child.material)) child.material.forEach(applyMat);
      else applyMat(child.material);
    });
  }
}


function wallRotation(w){
  const r = w.rotation || {};
  const y = safeFinite(r.y, safeFinite(w.rotationY,0));
  return {x:safeFinite(r.x,0), y, z:safeFinite(r.z,0)};
}

function isCurvedWall(w){
  return w?.shape === 'curved' || w?.curve?.enabled === true;
}

function normalizedWallCurve(w){
  const raw = w?.curve || {};
  const amount = clamp(safeFinite(raw.amount, isCurvedWall(w) ? .35 : 0), 0, 1);
  const direction = raw.direction === 'back' ? 'back' : 'front';
  const sign = direction === 'back' ? -1 : 1;
  return {amount, direction, sign};
}

function curvedWallCenterPoint(w, u){
  const size = w?.size || {};
  const width = clamp(safeFinite(size.w,3), .5, 500);
  const c = normalizedWallCurve(w);
  const q = clamp(u, 0, 1) * 2 - 1;
  const x = q * width * .5;
  const z = c.sign * c.amount * width * .46 * (1 - q * q);
  return new THREE.Vector2(x, z);
}

function createCurvedWallGeometry(w){
  const size = w?.size || {};
  const width = clamp(safeFinite(size.w,3), .5, 500);
  const height = clamp(safeFinite(size.h,ROOM.height), .5, 500);
  const thick = clamp(safeFinite(size.t,.18), .02, 500);
  const curve = normalizedWallCurve(w);
  if(curve.amount <= .001){
    const g = new THREE.BoxGeometry(width, height, thick);
    g.computeVertexNormals();
    return g;
  }
  const seg = Math.max(12, Math.min(96, Math.ceil(width * 3.2)));
  const verts = [];
  const uvs = [];
  const idx = [];
  const push = (x,y,z,u,v)=>{ verts.push(x,y,z); uvs.push(u,v); return verts.length / 3 - 1; };
  const rings = [];
  for(let i=0;i<=seg;i++){
    const u = i / seg;
    const p = curvedWallCenterPoint(w, u);
    const frontZ = p.y + thick * .5;
    const backZ = p.y - thick * .5;
    rings.push({
      fb: push(p.x, -height/2, frontZ, u, 0),
      ft: push(p.x,  height/2, frontZ, u, 1),
      bb: push(p.x, -height/2, backZ, u, 0),
      bt: push(p.x,  height/2, backZ, u, 1)
    });
  }
  for(let i=0;i<seg;i++){
    const a = rings[i], b = rings[i+1];
    idx.push(a.fb,b.fb,b.ft, a.fb,b.ft,a.ft);
    idx.push(a.bb,a.bt,b.bt, a.bb,b.bt,b.bb);
    idx.push(a.ft,b.ft,b.bt, a.ft,b.bt,a.bt);
    idx.push(a.fb,a.bb,b.bb, a.fb,b.bb,b.fb);
  }
  let cap = rings[0];
  idx.push(cap.fb,cap.ft,cap.bt, cap.fb,cap.bt,cap.bb);
  cap = rings[seg];
  idx.push(cap.fb,cap.bb,cap.bt, cap.fb,cap.bt,cap.ft);
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(verts,3));
  g.setAttribute('uv', new THREE.Float32BufferAttribute(uvs,2));
  g.setIndex(idx);
  g.computeVertexNormals();
  g.computeBoundingBox();
  g.computeBoundingSphere();
  return g;
}

function customWallHasChiselHoles(w){
  return !isCurvedWall(w) && Array.isArray(w?.chiselHoles) && w.chiselHoles.length > 0;
}

function createCustomWallGeometry(w){
  if(isCurvedWall(w)) return createCurvedWallGeometry(w);
  if(customWallHasChiselHoles(w)){
    const width = clamp(safeFinite(w.size?.w,3), .5, 500);
    const height = clamp(safeFinite(w.size?.h,ROOM.height), .5, 500);
    const thick = clamp(safeFinite(w.size?.t,.18), .02, 500);
    const g = makeWallPanelGeometryWithChiselSupport(width, height, thick, sanitizeChiselHoles(w.chiselHoles, false));
    g.translate(0, -height/2, 0);
    g.computeBoundingBox();
    g.computeBoundingSphere();
    return g;
  }
  const g = new THREE.BoxGeometry(1,1,1);
  g.computeVertexNormals();
  return g;
}

function applyWallMeshTransform(mesh, w){
  if(!mesh || !w) return;
  const r = wallRotation(w);
  const sy = safeFinite(w.size?.h,ROOM.height);
  mesh.position.set(safeFinite(w.position?.x,0), safeFinite(w.position?.y,sy/2), safeFinite(w.position?.z,0));
  mesh.rotation.set(deg(r.x),deg(r.y),deg(r.z));
  if(isCurvedWall(w) || customWallHasChiselHoles(w)) mesh.scale.set(1,1,1);
  else mesh.scale.set(safeFinite(w.size?.w,3), sy, safeFinite(w.size?.t,.18));
}

function refreshWallSelectionVisuals(){
  for(const [key,mesh] of Object.entries(surfaces)) applyWallVisualState(mesh, selectedRoomWallKey===key, false);
  for(const [id,mesh] of Object.entries(customWallMeshes)){
    const w = STATE.customWalls.find(item=>item.id===id);
    applyWallVisualState(mesh, selectedWallId===id, !!w?.isDraft);
  }
  for(const [id,mesh] of Object.entries(floorTileMeshes)){
    const t = (STATE.floorTiles || []).find(item=>item.id===id);
    applyWallVisualState(mesh, selectedFloorTileId===id, !!t?.isDraft);
  }
  refreshGroundReliefSelectionVisuals();
  syncObjectEditor();
  syncSurfaceEditor();
  syncGroundReliefEditor();
  applyObjectVisibilityLocks();
  renderObjectPanel();
}


function referenceArchitectureMaterial(kind='wall'){
  if(kind === 'glassGlow'){
    return new THREE.MeshBasicMaterial({color:0xeafff6, transparent:true, opacity:.44, depthWrite:false, side:THREE.DoubleSide, toneMapped:false});
  }
  const cfg = sanitizeReferenceArchitectureMaterial(STATE?.referenceArchitecture?.material);
  const tintBase = kind === 'shadow' ? new THREE.Color(0xb9cdc5) : (kind === 'soffit' ? new THREE.Color(0xdce9e1) : new THREE.Color(0xe2eee6));
  const tint = new THREE.Color(cfg.color).lerp(tintBase, cfg.texture ? 0 : 0.35);
  const mat = new THREE.MeshStandardMaterial({color:tint, roughness:cfg.roughness, metalness:cfg.metalness, side:THREE.DoubleSide});
  if(cfg.texture){
    mat.map = getSharedTexture(cfg.texture, cfg.repeat || [1,1], THREE.SRGBColorSpace);
  }
  // Reference architecture relief is generated as a stable tessellated geometry overlay.
  // Do not use bumpMap here: material-space bump was too subtle on huge walls and could shimmer while lights/water moved.
  return mat;
}

function makeRectangleShape(width, height){
  const s = new THREE.Shape();
  s.moveTo(-width/2, 0);
  s.lineTo(width/2, 0);
  s.lineTo(width/2, height);
  s.lineTo(-width/2, height);
  s.lineTo(-width/2, 0);
  return s;
}

function makeRoundedRectHolePath(cx, bottom, width, height, radius){
  const r = Math.min(Math.max(radius || .1, .05), width/2 - .001, height/2 - .001);
  const x0 = cx - width/2, x1 = cx + width/2, y0 = bottom, y1 = bottom + height;
  const p = new THREE.Path();
  p.moveTo(x0 + r, y0);
  p.lineTo(x1 - r, y0);
  p.quadraticCurveTo(x1, y0, x1, y0 + r);
  p.lineTo(x1, y1 - r);
  p.quadraticCurveTo(x1, y1, x1 - r, y1);
  p.lineTo(x0 + r, y1);
  p.quadraticCurveTo(x0, y1, x0, y1 - r);
  p.lineTo(x0, y0 + r);
  p.quadraticCurveTo(x0, y0, x0 + r, y0);
  return p;
}

function makeArchHolePath(cx, bottom, width, height){
  const r = Math.max(.05, width/2);
  const verticalTop = Math.max(bottom + r + .05, bottom + height - r);
  const p = new THREE.Path();
  p.moveTo(cx - width/2, bottom);
  p.lineTo(cx + width/2, bottom);
  p.lineTo(cx + width/2, verticalTop);
  p.absarc(cx, verticalTop, r, 0, Math.PI, false);
  p.lineTo(cx - width/2, bottom);
  return p;
}

function makeRectHolePath(cx, bottom, width, height){
  const p = new THREE.Path();
  const x0 = cx - width/2, x1 = cx + width/2, y0 = bottom, y1 = bottom + height;
  p.moveTo(x0,y0);
  p.lineTo(x1,y0);
  p.lineTo(x1,y1);
  p.lineTo(x0,y1);
  p.lineTo(x0,y0);
  return p;
}

function makeEllipseHolePath(cx, bottom, width, height){
  const p = new THREE.Path();
  p.absellipse(cx, bottom + height/2, Math.max(.025,width/2), Math.max(.025,height/2), 0, Math.PI * 2, false, 0);
  return p;
}

function regularPolygonHoleVertices(cx, bottom, width, height, sides, margin=0){
  const n = Math.max(3, Math.round(safeFinite(sides, 3)));
  const rx = Math.max(.001, Math.max(.001, safeFinite(width, 1)) / 2 - Math.max(0, margin));
  const ry = Math.max(.001, Math.max(.001, safeFinite(height, 1)) / 2 - Math.max(0, margin));
  const cy = bottom + Math.max(.001, safeFinite(height, 1)) / 2;
  const rot = -Math.PI / 2;
  const vertices = [];
  for(let i=0; i<n; i++){
    const a = rot + i * Math.PI * 2 / n;
    vertices.push([cx + Math.cos(a) * rx, cy + Math.sin(a) * ry]);
  }
  return vertices;
}

function makePolygonHolePath(cx, bottom, width, height, sides){
  const vertices = regularPolygonHoleVertices(cx, bottom, width, height, sides, 0);
  const p = new THREE.Path();
  if(!vertices.length) return p;
  p.moveTo(vertices[0][0], vertices[0][1]);
  for(let i=1; i<vertices.length; i++) p.lineTo(vertices[i][0], vertices[i][1]);
  p.lineTo(vertices[0][0], vertices[0][1]);
  return p;
}

function pointInPolygon2D(x, y, vertices){
  if(!Array.isArray(vertices) || vertices.length < 3) return false;
  let inside = false;
  for(let i=0, j=vertices.length - 1; i<vertices.length; j=i++){
    const xi = vertices[i][0], yi = vertices[i][1];
    const xj = vertices[j][0], yj = vertices[j][1];
    const dx = xj - xi, dy = yj - yi;
    const cross = (x - xi) * dy - (y - yi) * dx;
    const dot = (x - xi) * (x - xj) + (y - yi) * (y - yj);
    if(Math.abs(cross) < 1e-6 && dot <= 1e-6) return true;
    const intersect = ((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / ((yj - yi) || 1e-9) + xi);
    if(intersect) inside = !inside;
  }
  return inside;
}

function referencePolygonOpeningContains(hole, localX, localY, margin=0){
  if(!hole || !isPolygonChiselType(hole.type)) return false;
  const cx = safeFinite(hole.x, 0);
  const bottom = safeFinite(hole.y, 0);
  const w = Math.max(.001, safeFinite(hole.w, 2));
  const h = Math.max(.001, safeFinite(hole.h, 2));
  if(localX < cx - w/2 || localX > cx + w/2 || localY < bottom || localY > bottom + h) return false;
  return pointInPolygon2D(localX, localY, regularPolygonHoleVertices(cx, bottom, w, h, polygonSidesForChiselType(hole.type), margin));
}

function makeExtrudedWallWithHoles(width, height, thickness, holes=[]){
  const shape = makeRectangleShape(width, height);
  for(const h of chiselHolesForWallSubtraction(holes)){
    const type = h?.type || 'arch';
    const hx = safeFinite(h.x,0), hy = safeFinite(h.y,0), hw = Math.max(.02,safeFinite(h.w,2)), hh = Math.max(.02,safeFinite(h.h,2));
    if(type === 'circle') shape.holes.push(makeEllipseHolePath(hx, hy, hw, hh));
    else if(isPolygonChiselType(type)) shape.holes.push(makePolygonHolePath(hx, hy, hw, hh, polygonSidesForChiselType(type)));
    else if(type === 'rect') shape.holes.push(makeRectHolePath(hx, hy, hw, hh));
    else if(type === 'roundRect') shape.holes.push(makeRoundedRectHolePath(hx, hy, hw, hh, h.r || .5));
    else shape.holes.push(makeArchHolePath(hx, hy, hw, hh));
  }
  const geo = new THREE.ExtrudeGeometry(shape, {depth:thickness, bevelEnabled:false, curveSegments:28, steps:1});
  geo.translate(0,0,-thickness/2);
  geo.computeVertexNormals();
  return geo;
}


function wallPanelNeedsRobustChiselGeometry(holes=[], thickness=.18){
  // Any user chisel hole carries a finite depth.  Use the robust subtractive mesh for those holes
  // even when they cut fully through the wall.  THREE.Shape.holes is valid only for holes fully
  // contained inside the outer contour; when the chisel overlaps a wall edge it creates the exact
  // artifact the user reported: extra triangles grow from the side.  The robust grid removes solid
  // cells instead, so edge-overlapping cuts simply delete the edge area.
  return Array.isArray(holes) && holes.some(h=>h && Number.isFinite(Number(h.depth)));
}

function makeRobustChiseledWallGeometry(width, height, thickness, holes=[]){
  const W = Math.max(.02, safeFinite(width, 1));
  const H = Math.max(.02, safeFinite(height, 1));
  const T = Math.max(.01, safeFinite(thickness, .18));
  const list = Array.isArray(holes) ? holes.filter(Boolean) : [];
  const zBack = -T / 2;
  const zFront = T / 2;
  const hasUserCut = wallPanelNeedsRobustChiselGeometry(list);
  const segX = Math.round(clamp(W * (hasUserCut ? 9 : 6), 42, 220));
  const segY = Math.round(clamp(H * (hasUserCut ? 9 : 6), 24, 120));
  const eps = 1e-4;
  const positions = [];
  const uvs = [];
  const indices = [];
  const pushV = (x,y,z,u,v)=>{
    const i = positions.length / 3;
    positions.push(x,y,z);
    uvs.push(u,v);
    return i;
  };
  const pushQuad = (a,b,c,d)=>{
    const ia = pushV(a[0],a[1],a[2],a[3],a[4]);
    const ib = pushV(b[0],b[1],b[2],b[3],b[4]);
    const ic = pushV(c[0],c[1],c[2],c[3],c[4]);
    const id = pushV(d[0],d[1],d[2],d[3],d[4]);
    indices.push(ia,ib,ic, ia,ic,id);
  };
  const uvXY = (x,y)=>[(x / W + .5), y / H];
  const uvZY = (z,y)=>[(z / T + .5), y / H];
  const uvXZ = (x,z)=>[(x / W + .5), (z / T + .5)];
  const segmentsForPoint = (x,y)=>{
    let frontRemove = 0;
    let backRemove = 0;
    let through = false;
    for(const h of list){
      if(!pointInsideReferenceHole(x, y, h)) continue;
      if(chiselHoleCutsThrough(h, T)){
        through = true;
        break;
      }
      const d = clamp(safeFinite(h.depth, 0), 0, T);
      if(chiselHoleSide(h) >= 0) frontRemove = Math.max(frontRemove, d);
      else backRemove = Math.max(backRemove, d);
    }
    if(through) return null;
    const a = zBack + backRemove;
    const b = zFront - frontRemove;
    if(b - a <= .002) return null;
    return [a,b];
  };
  const segments = new Array(segX * segY).fill(null);
  const segAt = (ix,iy)=> (ix >= 0 && ix < segX && iy >= 0 && iy < segY) ? segments[iy * segX + ix] : null;
  const sameSeg = (a,b)=> !!a && !!b && Math.abs(a[0]-b[0]) < eps && Math.abs(a[1]-b[1]) < eps;

  for(let iy=0; iy<segY; iy++){
    const cy = ((iy + .5) / segY) * H;
    for(let ix=0; ix<segX; ix++){
      const cx = -W/2 + ((ix + .5) / segX) * W;
      segments[iy * segX + ix] = segmentsForPoint(cx, cy);
    }
  }

  for(let iy=0; iy<segY; iy++){
    const y0 = (iy / segY) * H;
    const y1 = ((iy + 1) / segY) * H;
    for(let ix=0; ix<segX; ix++){
      const seg = segAt(ix,iy);
      if(!seg) continue;
      const x0 = -W/2 + (ix / segX) * W;
      const x1 = -W/2 + ((ix + 1) / segX) * W;
      const z0 = seg[0];
      const z1 = seg[1];
      const [u00,v00] = uvXY(x0,y0), [u10,v10] = uvXY(x1,y0), [u11,v11] = uvXY(x1,y1), [u01,v01] = uvXY(x0,y1);
      // Front/end face of the remaining volume. For through-holes this is only the real front surface;
      // for finite-depth chiselling this becomes the recessed back plane at the specified depth.
      pushQuad([x0,y0,z1,u00,v00], [x1,y0,z1,u10,v10], [x1,y1,z1,u11,v11], [x0,y1,z1,u01,v01]);
      // Back face.
      pushQuad([x0,y1,z0,u01,v01], [x1,y1,z0,u11,v11], [x1,y0,z0,u10,v10], [x0,y0,z0,u00,v00]);
      const left = segAt(ix-1,iy), right = segAt(ix+1,iy), down = segAt(ix,iy-1), up = segAt(ix,iy+1);
      if(!sameSeg(seg,left)){
        const [uA,vA]=uvZY(z1,y0), [uB,vB]=uvZY(z1,y1), [uC,vC]=uvZY(z0,y1), [uD,vD]=uvZY(z0,y0);
        pushQuad([x0,y0,z1,uA,vA], [x0,y1,z1,uB,vB], [x0,y1,z0,uC,vC], [x0,y0,z0,uD,vD]);
      }
      if(!sameSeg(seg,right)){
        const [uA,vA]=uvZY(z1,y1), [uB,vB]=uvZY(z1,y0), [uC,vC]=uvZY(z0,y0), [uD,vD]=uvZY(z0,y1);
        pushQuad([x1,y1,z1,uA,vA], [x1,y0,z1,uB,vB], [x1,y0,z0,uC,vC], [x1,y1,z0,uD,vD]);
      }
      if(!sameSeg(seg,down)){
        const [uA,vA]=uvXZ(x1,z1), [uB,vB]=uvXZ(x0,z1), [uC,vC]=uvXZ(x0,z0), [uD,vD]=uvXZ(x1,z0);
        pushQuad([x1,y0,z1,uA,vA], [x0,y0,z1,uB,vB], [x0,y0,z0,uC,vC], [x1,y0,z0,uD,vD]);
      }
      if(!sameSeg(seg,up)){
        const [uA,vA]=uvXZ(x0,z1), [uB,vB]=uvXZ(x1,z1), [uC,vC]=uvXZ(x1,z0), [uD,vD]=uvXZ(x0,z0);
        pushQuad([x0,y1,z1,uA,vA], [x1,y1,z1,uB,vB], [x1,y1,z0,uC,vC], [x0,y1,z0,uD,vD]);
      }
    }
  }
  if(indices.length < 6) return makeExtrudedWallWithHoles(W, H, T, []);
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
  geo.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
  geo.setIndex(indices);
  geo.computeVertexNormals();
  geo.computeBoundingBox();
  geo.computeBoundingSphere();
  return geo;
}

function makeWallPanelGeometryWithChiselSupport(width, height, thickness, holes=[]){
  return wallPanelNeedsRobustChiselGeometry(holes, thickness)
    ? makeRobustChiseledWallGeometry(width, height, thickness, holes)
    : makeExtrudedWallWithHoles(width, height, thickness, holes);
}

function makeArchFillGeometry(cx, bottom, width, height, thickness){
  const eps = .006;
  const shape = new THREE.Shape();
  const r = Math.max(.05, width / 2 + eps);
  const verticalTop = Math.max(bottom + r + .05, bottom + height - width / 2) + eps;
  shape.moveTo(cx - width/2 - eps, bottom);
  shape.lineTo(cx + width/2 + eps, bottom);
  shape.lineTo(cx + width/2 + eps, verticalTop);
  shape.absarc(cx, verticalTop, r, 0, Math.PI, false);
  shape.lineTo(cx - width/2 - eps, bottom);
  const geo = new THREE.ExtrudeGeometry(shape, {depth:thickness * 1.04, bevelEnabled:false, curveSegments:32, steps:1});
  geo.translate(0,0,-thickness * 1.04 / 2);
  geo.computeVertexNormals();
  geo.computeBoundingBox();
  geo.computeBoundingSphere();
  return geo;
}

function addReferenceArchFillPanels({name,width,height,thickness,holes=[],position,rotationY=0,materialKind='wall'}){
  const archHoles = (holes || []).filter(h=>h?.type === 'arch');
  for(const h of archHoles){
    const mesh = new THREE.Mesh(
      makeArchFillGeometry(safeFinite(h.x,0), safeFinite(h.y,0), Math.max(.05,safeFinite(h.w,2.5)), Math.max(.05,safeFinite(h.h,4)), thickness),
      referenceArchitectureMaterial(materialKind)
    );
    mesh.position.set(position.x, position.y || 0, position.z);
    mesh.rotation.y = rotationY;
    mesh.renderOrder = 6;
    addReferenceMesh(mesh, `${name || '參考圖'}｜同尺寸圓拱補牆`, materialKind);
  }
}

function makeIrregularHolePath(points){
  const p = new THREE.Path();
  if(!points?.length) return p;
  p.moveTo(points[0][0], points[0][1]);
  for(let i=1;i<points.length;i++) p.lineTo(points[i][0], points[i][1]);
  p.lineTo(points[0][0], points[0][1]);
  return p;
}

function addReferenceCeilingRuinPanel(W, D, H){
  const shape = new THREE.Shape();
  const x0 = -W/2 + 1.35, x1 = W/2 - 1.35, y0 = -D/2 + 1.25, y1 = D/2 - 1.25;
  shape.moveTo(x0,y0); shape.lineTo(x1,y0); shape.lineTo(x1,y1); shape.lineTo(x0,y1); shape.lineTo(x0,y0);
  const holes = [
    [[-13.8,-10.2],[-11.2,-10.9],[-8.9,-9.7],[-9.6,-7.4],[-12.8,-6.8],[-14.6,-8.4]],
    [[-5.8,-12.0],[-2.2,-11.1],[-1.3,-8.8],[-4.2,-7.1],[-7.1,-8.5]],
    [[3.0,-10.4],[6.8,-11.6],[9.2,-9.5],[8.1,-6.4],[4.4,-6.9],[2.4,-8.6]],
    [[11.1,-3.4],[14.5,-4.3],[15.8,-1.0],[13.2,1.2],[10.4,.2]],
    [[-15.0,-2.6],[-12.7,-4.0],[-9.9,-2.3],[-10.8,.8],[-13.6,1.4],[-15.8,-.4]],
    [[-6.6,.8],[-3.2,-.6],[-.8,1.8],[-2.3,4.6],[-5.9,4.1],[-7.6,2.5]],
    [[3.5,1.1],[7.8,.3],[9.6,2.8],[7.5,5.4],[4.1,4.7]],
    [[-13.2,6.3],[-10.4,5.0],[-7.8,7.1],[-9.5,10.0],[-12.6,9.5],[-14.4,7.8]],
    [[-.8,7.0],[2.8,5.9],[5.6,8.3],[3.7,11.1],[.3,10.2],[-2.0,8.9]],
    [[10.2,7.0],[13.2,6.0],[15.1,8.5],[13.4,11.5],[10.0,10.2]]
  ];
  for(const pts of holes) shape.holes.push(makeIrregularHolePath(pts));
  const geo = new THREE.ShapeGeometry(shape, 2);
  geo.rotateX(-Math.PI/2);
  geo.computeVertexNormals();
  const mat = referenceArchitectureMaterial('soffit');
  mat.side = THREE.DoubleSide;
  const mesh = new THREE.Mesh(geo, mat);
  mesh.position.set(0, H - .08, 0);
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  mesh.renderOrder = 4;
  addReferenceMesh(mesh, '參考圖｜破洞天花板薄面', 'soffit');
}


function referenceReliefMaxAmp(matCfg){
  const cfg = getReliefConfigForMaterial(matCfg);
  const preset = GROUND_RELIEF_PRESETS[cfg.preset] || GROUND_RELIEF_PRESETS.flat;
  if(cfg.preset === 'flat' || cfg.amount <= .001 || !preset.octaves) return 0;
  // Reference architecture uses a real fused shell. Keep the relief readable, but cap amplitude
  // so the shell does not read as a separated second wall when viewed from the side.
  return clamp(preset.amp * (1.45 + cfg.variation * 1.05) * cfg.amount, 0, .20);
}

function pointInsideReferenceHole(x, y, h){
  if(!h) return false;
  const cx = safeFinite(h.x,0);
  const bottom = safeFinite(h.y,0);
  const w = Math.max(.001, safeFinite(h.w,2));
  const height = Math.max(.001, safeFinite(h.h,2));
  const x0 = cx - w/2, x1 = cx + w/2;
  if(x < x0 || x > x1 || y < bottom || y > bottom + height + .001) return false;
  if(h.type === 'rect') return true;
  if(h.type === 'circle'){
    const nx = (x - cx) / Math.max(.001, w/2);
    const ny = (y - (bottom + height/2)) / Math.max(.001, height/2);
    return nx*nx + ny*ny <= 1;
  }
  if(isPolygonChiselType(h.type)) return referencePolygonOpeningContains(h, x, y, 0);
  if(h.type === 'roundRect'){
    const r = Math.min(Math.max(safeFinite(h.r,.5), .001), w/2, height/2);
    const y0 = bottom, y1 = bottom + height;
    const ix0 = x0 + r, ix1 = x1 - r, iy0 = y0 + r, iy1 = y1 - r;
    if(x >= ix0 && x <= ix1) return true;
    if(y >= iy0 && y <= iy1) return true;
    const cx2 = x < ix0 ? ix0 : ix1;
    const cy2 = y < iy0 ? iy0 : iy1;
    const dx = x - cx2, dy = y - cy2;
    return dx*dx + dy*dy <= r*r;
  }
  const r = Math.max(.001, w/2);
  const verticalTop = Math.max(bottom + r + .05, bottom + height - r);
  if(y <= verticalTop) return true;
  const dx = x - cx, dy = y - verticalTop;
  return dx*dx + dy*dy <= r*r && y <= verticalTop + r;
}

function referenceCellIntersectsSolid(x0, x1, y0, y1, holes){
  const cx = (x0 + x1) * .5;
  const cy = (y0 + y1) * .5;
  if(holes?.some(h=>pointInsideReferenceHole(cx, cy, h))) return false;
  // Reject cells whose four corners are all inside a hole. This keeps arc openings clean
  // without using ExtrudeGeometry cap triangles for displacement.
  for(const h of holes || []){
    const c0 = pointInsideReferenceHole(x0, y0, h);
    const c1 = pointInsideReferenceHole(x1, y0, h);
    const c2 = pointInsideReferenceHole(x1, y1, h);
    const c3 = pointInsideReferenceHole(x0, y1, h);
    if(c0 && c1 && c2 && c3) return false;
  }
  return true;
}

function createReferenceClippedReliefGridGeometry({width, height, holes=[], matCfg}){
  const cfg = getReliefConfigForMaterial(matCfg);
  const preset = GROUND_RELIEF_PRESETS[cfg.preset] || GROUND_RELIEF_PRESETS.flat;
  const maxAmp = referenceReliefMaxAmp(matCfg);
  if(maxAmp <= 0 || width <= 0 || height <= 0) return null;

  // Keep the reference-building relief lighter than regular editable walls.
  // The building contains many arch panels and beams; high tessellation here causes global stutter.
  const density = 14 + cfg.variation * 30;
  const aspect = clamp(width / Math.max(height,.001), .25, 5.5);
  const segX = Math.round(clamp(density * Math.sqrt(aspect), 18, 92));
  const segY = Math.round(clamp(density / Math.sqrt(aspect), 14, 68));
  const rep = Array.isArray(matCfg?.repeat) ? matCfg.repeat : [1,1];

  const solid = new Array(segX * segY).fill(false);
  for(let iy=0; iy<segY; iy++){
    const y0 = (iy / segY) * height;
    const y1 = ((iy + 1) / segY) * height;
    for(let ix=0; ix<segX; ix++){
      const x0 = -width/2 + (ix / segX) * width;
      const x1 = -width/2 + ((ix + 1) / segX) * width;
      solid[iy * segX + ix] = referenceCellIntersectsSolid(x0,x1,y0,y1,holes);
    }
  }

  const positions = [];
  const uvs = [];
  const indices = [];
  const topIndex = new Array((segX + 1) * (segY + 1)).fill(-1);

  const addTopVertex = (gx,gy)=>{
    const key = gy * (segX + 1) + gx;
    if(topIndex[key] >= 0) return topIndex[key];
    const x = -width/2 + (gx / segX) * width;
    const y = (gy / segY) * height;
    const idx = positions.length / 3;
    const n = reliefNoise2D(x * .82, y * .82, cfg, preset);
    const height01 = Math.pow(clamp(n * .5 + .5, 0, 1), 1.08);
    // z=0 is exactly the original building surface. This removes the visual air gap.
    const z = height01 * maxAmp;
    positions.push(x, y, z);
    uvs.push((x / width + .5) * rep[0], (y / Math.max(height,.001)) * rep[1]);
    topIndex[key] = idx;
    return idx;
  };

  const addBaseVertex = (gx,gy)=>{
    const x = -width/2 + (gx / segX) * width;
    const y = (gy / segY) * height;
    const idx = positions.length / 3;
    positions.push(x, y, 0);
    uvs.push((x / width + .5) * rep[0], (y / Math.max(height,.001)) * rep[1]);
    return idx;
  };

  const cellSolid = (ix,iy)=> ix >= 0 && ix < segX && iy >= 0 && iy < segY && solid[iy * segX + ix];

  const addBoundarySkirt = (a,b,ba,bb, orientation)=>{
    // Orientation keeps normals stable but visual correctness is more important than collision here.
    if(orientation === 'bottom' || orientation === 'right') indices.push(a,ba,b, b,ba,bb);
    else indices.push(b,bb,a, a,bb,ba);
  };

  for(let iy=0; iy<segY; iy++){
    for(let ix=0; ix<segX; ix++){
      if(!cellSolid(ix,iy)) continue;
      const a = addTopVertex(ix,iy);
      const b = addTopVertex(ix+1,iy);
      const c = addTopVertex(ix+1,iy+1);
      const d = addTopVertex(ix,iy+1);
      indices.push(a,b,c, a,c,d);

      // Close every exposed cell edge down to z=0. This is the same fused-volume principle
      // used by the normal wall relief, but with clipping around arch and rounded openings.
      if(!cellSolid(ix,iy-1)){
        const ba = addBaseVertex(ix,iy);
        const bb = addBaseVertex(ix+1,iy);
        addBoundarySkirt(a,b,ba,bb,'bottom');
      }
      if(!cellSolid(ix,iy+1)){
        const ba = addBaseVertex(ix,iy+1);
        const bb = addBaseVertex(ix+1,iy+1);
        addBoundarySkirt(d,c,ba,bb,'top');
      }
      if(!cellSolid(ix-1,iy)){
        const ba = addBaseVertex(ix,iy);
        const bb = addBaseVertex(ix,iy+1);
        addBoundarySkirt(d,a,bb,ba,'left');
      }
      if(!cellSolid(ix+1,iy)){
        const ba = addBaseVertex(ix+1,iy);
        const bb = addBaseVertex(ix+1,iy+1);
        addBoundarySkirt(b,c,ba,bb,'right');
      }
    }
  }

  if(indices.length < 6) return null;
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.Float32BufferAttribute(positions,3));
  geo.setAttribute('uv', new THREE.Float32BufferAttribute(uvs,2));
  geo.setIndex(indices);
  geo.computeVertexNormals();
  geo.computeBoundingBox();
  geo.computeBoundingSphere();
  return geo;
}

function makeReferenceReliefMaterial(materialKind='wall'){
  const mat = referenceArchitectureMaterial(materialKind);
  mat.side = THREE.DoubleSide;
  mat.polygonOffset = true;
  mat.polygonOffsetFactor = -2;
  mat.polygonOffsetUnits = -2;
  return mat;
}

function addReferenceReliefPlaneToGroup(group, {width, height, position, rotation, matCfg, materialKind='wall', name}){
  const mesh = createReliefPlaneMesh({
    width,
    height,
    position:position || new THREE.Vector3(),
    rotation:rotation || new THREE.Euler(),
    matCfg,
    fallbackColor:matCfg?.color || '#e2eee6',
    userData:{referenceArchitecture:true, referenceArchitectureId:'referenceArchitecture', isReferenceRelief:true},
    name:name || 'reference-relief-plane',
    detailScale:.42
  });
  if(!mesh) return null;
  mesh.material?.dispose?.();
  mesh.material = makeReferenceReliefMaterial(materialKind);
  mesh.renderOrder = 5;
  group.add(mesh);
  return mesh;
}

function createReferenceWallPanelReliefGroup({name,width,height,thickness,holes=[],position,rotationY=0,materialKind='wall'}){
  const matCfg = STATE?.referenceArchitecture?.material;
  const maxAmp = referenceReliefMaxAmp(matCfg);
  if(maxAmp <= 0) return null;
  const group = new THREE.Group();
  group.name = `${name || '參考圖建築'}｜穩定網格凹凸`;
  group.position.set(position.x, position.y || 0, position.z);
  group.rotation.y = rotationY;
  group.userData = {referenceArchitecture:true, referenceArchitectureId:'referenceArchitecture', isReferenceRelief:true};
  const makeFace = (suffix, z, ry, side)=>{
    const faceHoles = chiselHolesForFace(holes, thickness, side);
    const geo = createReferenceClippedReliefGridGeometry({width,height,holes:faceHoles,matCfg});
    if(!geo) return;
    const mesh = new THREE.Mesh(geo, makeReferenceReliefMaterial(materialKind));
    mesh.name = `${name}-${suffix}-stable-relief`;
    mesh.position.set(0,0,z);
    mesh.rotation.y = ry;
    mesh.receiveShadow = true;
    mesh.castShadow = false;
    mesh.renderOrder = 5;
    mesh.userData = {referenceArchitecture:true, referenceArchitectureId:'referenceArchitecture', isReferenceRelief:true};
    group.add(mesh);
  };
  makeFace('front', thickness/2, 0, 1);
  makeFace('back', -thickness/2, Math.PI, -1);

  addReferenceReliefPlaneToGroup(group, {width, height:thickness, position:new THREE.Vector3(0,height,0), rotation:new THREE.Euler(-Math.PI/2,0,0), matCfg, materialKind, name:`${name}-top-relief`});
  addReferenceReliefPlaneToGroup(group, {width, height:thickness, position:new THREE.Vector3(0,0,0), rotation:new THREE.Euler(Math.PI/2,0,0), matCfg, materialKind, name:`${name}-bottom-relief`});
  addReferenceReliefPlaneToGroup(group, {width:thickness, height, position:new THREE.Vector3(width/2,height/2,0), rotation:new THREE.Euler(0,Math.PI/2,0), matCfg, materialKind, name:`${name}-right-edge-relief`});
  addReferenceReliefPlaneToGroup(group, {width:thickness, height, position:new THREE.Vector3(-width/2,height/2,0), rotation:new THREE.Euler(0,-Math.PI/2,0), matCfg, materialKind, name:`${name}-left-edge-relief`});

  for(const h of chiselHolesForCutting(holes || [], thickness)){
    const cx = safeFinite(h.x,0);
    const hw = Math.max(.001, safeFinite(h.w,2));
    const bottom = safeFinite(h.y,0);
    const r = h.type === 'roundRect' ? Math.min(Math.max(safeFinite(h.r,.5),.001), hw/2, Math.max(.001,safeFinite(h.h,2))/2) : hw/2;
    const verticalTop = h.type === 'roundRect' ? bottom + Math.max(.001,safeFinite(h.h,2)) - r : Math.max(bottom + r + .05, bottom + Math.max(.001,safeFinite(h.h,2)) - r);
    const verticalH = Math.max(.05, verticalTop - bottom);
    addReferenceReliefPlaneToGroup(group, {width:thickness, height:verticalH, position:new THREE.Vector3(cx - hw/2, bottom + verticalH/2, 0), rotation:new THREE.Euler(0,Math.PI/2,0), matCfg, materialKind, name:`${name}-hole-left-relief`});
    addReferenceReliefPlaneToGroup(group, {width:thickness, height:verticalH, position:new THREE.Vector3(cx + hw/2, bottom + verticalH/2, 0), rotation:new THREE.Euler(0,-Math.PI/2,0), matCfg, materialKind, name:`${name}-hole-right-relief`});
    if(h.type === 'roundRect'){
      addReferenceReliefPlaneToGroup(group, {width:hw - r*2, height:thickness, position:new THREE.Vector3(cx, bottom + safeFinite(h.h,2), 0), rotation:new THREE.Euler(Math.PI/2,0,0), matCfg, materialKind, name:`${name}-hole-top-relief`});
    }
  }
  return group.children.length ? group : null;
}

function createReferenceBoxReliefGroup({name, position, scale, materialKind='wall'}){
  const matCfg = STATE?.referenceArchitecture?.material;
  if(referenceReliefMaxAmp(matCfg) <= 0) return null;
  const group = createReliefBoxFacesGroup({
    width:Math.max(.02, scale.x),
    height:Math.max(.02, scale.y),
    depth:Math.max(.02, scale.z),
    position:new THREE.Vector3(position.x, position.y, position.z),
    rotation:new THREE.Euler(),
    matCfg,
    fallbackColor:matCfg?.color || '#e2eee6',
    userData:{referenceArchitecture:true, referenceArchitectureId:'referenceArchitecture', isReferenceRelief:true},
    name:`${name || '參考圖建築方體'}｜六面凹凸`,
    detailScale:.35
  });
  if(!group) return null;
  group.traverse(obj=>{
    if(obj.isMesh){
      obj.material?.dispose?.();
      obj.material = makeReferenceReliefMaterial(materialKind);
      obj.renderOrder = 5;
      obj.userData = {...(obj.userData||{}), referenceArchitecture:true, referenceArchitectureId:'referenceArchitecture', isReferenceRelief:true};
    }
  });
  return group;
}

function createReferenceArchitectureReliefOverlayForMesh(mesh, materialKind='wall'){
  return null;
}

function addReferenceMesh(mesh, name, materialKind='wall'){
  mesh.name = name;
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  mesh.userData.referenceArchitecture = true;
  mesh.userData.referenceArchitectureId = 'referenceArchitecture';
  mesh.userData.referenceMaterialKind = materialKind;
  mesh.userData.hasReliefSurface = materialKind !== 'glassGlow' && reliefEnabledForMaterial(STATE?.referenceArchitecture?.material);
  referenceArchitectureGroup.add(mesh);
  const collisionType = mesh.userData?.referenceCollisionType;
  if(collisionType === 'wallPanel') referenceCollisionItems.push({id:mesh.uuid, mesh, type:'referenceWallPanel'});
  else if(collisionType === 'box') referenceCollisionItems.push({id:mesh.uuid, mesh, type:'referenceBox'});
  return mesh;
}

function referenceWallPanelGeometryHoles(holes=[], solidifyArchHoles=false){
  const list = Array.isArray(holes) ? holes : [];
  // Only the outer perimeter walls should have their large ground-level arches sealed.
  // Making those arches part of the same wall geometry removes visible seams and avoids
  // accidentally closing the interior arch frames between pillars.
  return solidifyArchHoles ? list.filter(h=>h?.type !== 'arch') : list;
}

function referenceChiselHolesForPanel(name){
  const holes = STATE?.referenceArchitecture?.chiselHoles;
  if(!Array.isArray(holes) || !name) return [];
  return holes.filter(h=>h?.panelName === name).map(h=>({...h}));
}

function makeCenteredChiselShape(type, width, height, radius=.12){
  const w = Math.max(.02, safeFinite(width, 1));
  const h = Math.max(.02, safeFinite(height, 1));
  const shape = new THREE.Shape();
  if(type === 'circle'){
    shape.absellipse(0, 0, w/2, h/2, 0, Math.PI * 2, false, 0);
    return shape;
  }
  if(isPolygonChiselType(type)){
    const verts = regularPolygonHoleVertices(0, -h/2, w, h, polygonSidesForChiselType(type), 0);
    if(verts.length){
      shape.moveTo(verts[0][0], verts[0][1]);
      for(let i=1;i<verts.length;i++) shape.lineTo(verts[i][0], verts[i][1]);
      shape.lineTo(verts[0][0], verts[0][1]);
    }
    return shape;
  }
  if(type === 'arch'){
    const bottom = -h/2;
    const r = Math.max(.02, w/2);
    const verticalTop = Math.max(bottom + r + .025, bottom + h - r);
    shape.moveTo(-w/2, bottom);
    shape.lineTo(w/2, bottom);
    shape.lineTo(w/2, verticalTop);
    shape.absarc(0, verticalTop, r, 0, Math.PI, false);
    shape.lineTo(-w/2, bottom);
    return shape;
  }
  const round = type === 'roundRect' || (type === 'rect' && radius > .015);
  if(round){
    const rr = Math.min(Math.max(radius || .1, .005), w/2 - .001, h/2 - .001);
    const x0 = -w/2, x1 = w/2, y0 = -h/2, y1 = h/2;
    shape.moveTo(x0 + rr, y0);
    shape.lineTo(x1 - rr, y0);
    shape.quadraticCurveTo(x1, y0, x1, y0 + rr);
    shape.lineTo(x1, y1 - rr);
    shape.quadraticCurveTo(x1, y1, x1 - rr, y1);
    shape.lineTo(x0 + rr, y1);
    shape.quadraticCurveTo(x0, y1, x0, y1 - rr);
    shape.lineTo(x0, y0 + rr);
    shape.quadraticCurveTo(x0, y0, x0 + rr, y0);
    return shape;
  }
  shape.moveTo(-w/2, -h/2);
  shape.lineTo(w/2, -h/2);
  shape.lineTo(w/2, h/2);
  shape.lineTo(-w/2, h/2);
  shape.lineTo(-w/2, -h/2);
  return shape;
}

function makeChiselPreviewGeometry(hole){
  const shape = makeCenteredChiselShape(hole?.type || 'rect', hole?.w || 1, hole?.h || 1, hole?.r || .12);
  const geo = new THREE.ShapeGeometry(shape, 32);
  geo.computeBoundingBox();
  geo.computeBoundingSphere();
  return geo;
}

function makeChiselCapMaterial(mesh, darken=false){
  const source = Array.isArray(mesh?.material) ? mesh.material[0] : mesh?.material;
  let mat = source?.clone?.() || new THREE.MeshStandardMaterial({color:0x777777, roughness:.82, metalness:0});
  mat.side = THREE.DoubleSide;
  mat.transparent = false;
  mat.opacity = 1;
  mat.depthWrite = true;
  mat.depthTest = true;
  mat.polygonOffset = true;
  mat.polygonOffsetFactor = -1;
  mat.polygonOffsetUnits = -1;
  if(darken && mat.color) mat.color.multiplyScalar(.68);
  return mat;
}

function addChiselRecessDecalsToWallMesh(mesh, holes=[], thickness=.18, centeredY=false){
  if(!mesh || !Array.isArray(holes)) return;
  const partial = holes.filter(h=>h && !chiselHoleCutsThrough(h, thickness));
  if(!partial.length) return;
  const t = Math.max(.001, safeFinite(thickness, .18));
  const hOffset = centeredY ? -safeFinite(mesh.userData?.referenceCollisionHeight || 0, 0) / 2 : 0;
  for(const h of partial){
    const side = chiselHoleSide(h);
    const depth = clamp(safeFinite(h.depth, .02), .001, Math.max(.001, t - .002));
    const y = safeFinite(h.y, 0) + safeFinite(h.h, 1) / 2 + hOffset;
    const x = safeFinite(h.x, 0);

    // The wall body is cut through for the footprint, then these caps close the void at the exact depth.
    // This prevents the old failure mode where a transparent patch looked like the mesh had been pushed out
    // behind or beside the wall.
    const floorZ = side * (t / 2 - depth);
    const rearZ = -side * (t / 2 - .003);

    const floor = new THREE.Mesh(makeChiselPreviewGeometry(h), makeChiselCapMaterial(mesh, true));
    floor.name = 'chisel-depth-recess-floor';
    floor.position.set(x, y, floorZ);
    floor.renderOrder = 9;
    floor.userData.skipChiselTarget = true;
    mesh.add(floor);

    const rear = new THREE.Mesh(makeChiselPreviewGeometry(h), makeChiselCapMaterial(mesh, false));
    rear.name = 'chisel-depth-rear-fill';
    rear.position.set(x, y, rearZ);
    rear.renderOrder = 4;
    rear.userData.skipChiselTarget = true;
    mesh.add(rear);
  }
}


function boxChiselHoleContainsPoint(h, x, yBottom, z, size){
  if(!h || h.targetType !== 'box') return false;
  const sx = Math.max(.02, safeFinite(size?.x, 1));
  const sy = Math.max(.02, safeFinite(size?.y, 1));
  const sz = Math.max(.02, safeFinite(size?.z, 1));
  const axis = h.axis === 'x' ? 'x' : 'z';
  const side = chiselHoleSide(h);
  const u = axis === 'x' ? z : x;
  if(!pointInsideReferenceHole(u, yBottom, h)) return false;
  const thickness = axis === 'x' ? sx : sz;
  const coord = axis === 'x' ? x : z;
  const penetration = side >= 0 ? thickness / 2 - coord : coord + thickness / 2;
  return penetration >= -.0005 && penetration <= Math.min(Math.max(.001, safeFinite(h.depth, 0)), thickness + .0005);
}

function makeChiseledBoxGeometry(width, height, depth, holes=[]){
  const W = Math.max(.02, safeFinite(width, 1));
  const H = Math.max(.02, safeFinite(height, 1));
  const D = Math.max(.02, safeFinite(depth, 1));
  const boxHoles = (Array.isArray(holes) ? holes : []).filter(h=>h && h.targetType === 'box');
  if(!boxHoles.length) return new THREE.BoxGeometry(W, H, D);
  const segX = Math.round(clamp(W * 10, 4, 96));
  const segY = Math.round(clamp(H * 10, 8, 128));
  const segZ = Math.round(clamp(D * 10, 4, 96));
  const size = {x:W, y:H, z:D};
  const positions = [];
  const uvs = [];
  const indices = [];
  const pushV = (x,y,z,u,v)=>{
    const i = positions.length / 3;
    positions.push(x,y,z);
    uvs.push(u,v);
    return i;
  };
  const pushQuad = (a,b,c,d)=>{
    const ia=pushV(...a), ib=pushV(...b), ic=pushV(...c), id=pushV(...d);
    indices.push(ia,ib,ic, ia,ic,id);
  };
  const exists = new Uint8Array(segX * segY * segZ);
  const at = (ix,iy,iz)=> (ix>=0 && ix<segX && iy>=0 && iy<segY && iz>=0 && iz<segZ) ? exists[(iy*segZ + iz)*segX + ix] : 0;
  for(let iy=0; iy<segY; iy++){
    const y = -H/2 + ((iy + .5) / segY) * H;
    const yBottom = y + H/2;
    for(let iz=0; iz<segZ; iz++){
      const z = -D/2 + ((iz + .5) / segZ) * D;
      for(let ix=0; ix<segX; ix++){
        const x = -W/2 + ((ix + .5) / segX) * W;
        const removed = boxHoles.some(h=>boxChiselHoleContainsPoint(h, x, yBottom, z, size));
        exists[(iy*segZ + iz)*segX + ix] = removed ? 0 : 1;
      }
    }
  }
  const x0 = ix=> -W/2 + (ix / segX) * W;
  const x1 = ix=> -W/2 + ((ix + 1) / segX) * W;
  const y0 = iy=> -H/2 + (iy / segY) * H;
  const y1 = iy=> -H/2 + ((iy + 1) / segY) * H;
  const z0 = iz=> -D/2 + (iz / segZ) * D;
  const z1 = iz=> -D/2 + ((iz + 1) / segZ) * D;
  for(let iy=0; iy<segY; iy++){
    for(let iz=0; iz<segZ; iz++){
      for(let ix=0; ix<segX; ix++){
        if(!at(ix,iy,iz)) continue;
        const xa=x0(ix), xb=x1(ix), ya=y0(iy), yb=y1(iy), za=z0(iz), zb=z1(iz);
        const uxa=(xa/W+.5), uxb=(xb/W+.5), uya=(ya/H+.5), uyb=(yb/H+.5), uza=(za/D+.5), uzb=(zb/D+.5);
        if(!at(ix+1,iy,iz)) pushQuad([xb,ya,za,uzb,uya],[xb,yb,za,uzb,uyb],[xb,yb,zb,uza,uyb],[xb,ya,zb,uza,uya]);
        if(!at(ix-1,iy,iz)) pushQuad([xa,ya,zb,uzb,uya],[xa,yb,zb,uzb,uyb],[xa,yb,za,uza,uyb],[xa,ya,za,uza,uya]);
        if(!at(ix,iy+1,iz)) pushQuad([xa,yb,zb,uxa,uzb],[xb,yb,zb,uxb,uzb],[xb,yb,za,uxb,uza],[xa,yb,za,uxa,uza]);
        if(!at(ix,iy-1,iz)) pushQuad([xa,ya,za,uxa,uza],[xb,ya,za,uxb,uza],[xb,ya,zb,uxb,uzb],[xa,ya,zb,uxa,uzb]);
        if(!at(ix,iy,iz+1)) pushQuad([xa,ya,zb,uxa,uya],[xb,ya,zb,uxb,uya],[xb,yb,zb,uxb,uyb],[xa,yb,zb,uxa,uyb]);
        if(!at(ix,iy,iz-1)) pushQuad([xb,ya,za,uxb,uya],[xa,ya,za,uxa,uya],[xa,yb,za,uxa,uyb],[xb,yb,za,uxb,uyb]);
      }
    }
  }
  if(indices.length < 6) return new THREE.BufferGeometry();
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
  geo.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
  geo.setIndex(indices);
  geo.computeVertexNormals();
  geo.computeBoundingBox();
  geo.computeBoundingSphere();
  return geo;
}

function addReferenceWallPanel({name,width,height,thickness,holes,position,rotationY=0,materialKind='wall',solidifyArchHoles=false}){
  const baseGeometryHoles = referenceWallPanelGeometryHoles(holes || [], solidifyArchHoles);
  const userChiselHoles = referenceChiselHolesForPanel(name).filter(h=>h.targetType !== 'box');
  const geometryHoles = [...baseGeometryHoles, ...userChiselHoles];
  const hasUserChisel = userChiselHoles.length > 0;
  const geometry = hasUserChisel
    ? makeWallPanelGeometryWithChiselSupport(width,height,thickness,geometryHoles)
    : makeExtrudedWallWithHoles(width,height,thickness,geometryHoles);
  const mesh = new THREE.Mesh(geometry, hasUserChisel ? makeReferenceChiseledMaterial(materialKind) : referenceArchitectureMaterial(materialKind));
  mesh.position.set(position.x, position.y || 0, position.z);
  mesh.rotation.y = rotationY;
  mesh.userData.referencePanelName = name;
  mesh.userData.referenceSolidifiedArches = !!solidifyArchHoles;
  mesh.userData.referenceCollisionType = 'wallPanel';
  mesh.userData.referenceCollisionWidth = width;
  mesh.userData.referenceCollisionHeight = height;
  mesh.userData.referenceCollisionThickness = thickness;
  mesh.userData.referenceCollisionHoles = chiselHolesForCutting(geometryHoles, thickness).map(h=>({...h}));
  const base = addReferenceMesh(mesh, name, materialKind);
  // Robust chisel geometry already contains the recessed floor / through-hole volume.
  // Do not add the old cap decals, because they were the cause of visible pushed-out slabs.
  if(hasUserChisel){
    attachChiseledReliefOverlayToMesh(base, {
      matCfg:STATE?.referenceArchitecture?.material,
      fallbackColor:STATE?.referenceArchitecture?.material?.color || '#e2eee6',
      userData:{referenceArchitecture:true, referenceArchitectureId:'referenceArchitecture', isReferenceRelief:true},
      name:`${name || '參考圖建築'}-chiseled-exact-relief`,
      referenceMaterialKind:materialKind
    });
  }else{
    addChiselRecessDecalsToWallMesh(base, geometryHoles, thickness, false);
  }
  // Chiseled panels use an exact clone of the rebuilt cut mesh for relief, not the old full-box overlay.
  const relief = hasUserChisel ? null : createReferenceWallPanelReliefGroup({name,width,height,thickness,holes:geometryHoles,position,rotationY,materialKind});
  if(relief) referenceArchitectureGroup.add(relief);
  return base;
}

function addReferenceBox(name, position, scale, materialKind='wall'){
  const boxHoles = referenceChiselHolesForPanel(name).filter(h=>h.targetType === 'box');
  const geometry = boxHoles.length
    ? makeChiseledBoxGeometry(scale.x, scale.y, scale.z, boxHoles)
    : new THREE.BoxGeometry(1,1,1);
  const mesh = new THREE.Mesh(geometry, boxHoles.length ? makeReferenceChiseledMaterial(materialKind) : referenceArchitectureMaterial(materialKind));
  mesh.position.set(position.x, position.y, position.z);
  if(!boxHoles.length) mesh.scale.set(scale.x, scale.y, scale.z);
  mesh.userData.referencePanelName = name;
  mesh.userData.referenceCollisionType = 'box';
  mesh.userData.referenceCollisionSize = {x:scale.x, y:scale.y, z:scale.z};
  mesh.userData.referenceGeometryBaked = !!boxHoles.length;
  mesh.userData.referenceBoxChiselHoles = boxHoles.map(h=>({...h}));
  const base = addReferenceMesh(mesh, name, materialKind);
  if(boxHoles.length){
    attachChiseledReliefOverlayToMesh(base, {
      matCfg:STATE?.referenceArchitecture?.material,
      fallbackColor:STATE?.referenceArchitecture?.material?.color || '#e2eee6',
      userData:{referenceArchitecture:true, referenceArchitectureId:'referenceArchitecture', isReferenceRelief:true},
      name:`${name || '參考圖建築方體'}-chiseled-exact-relief`,
      referenceMaterialKind:materialKind
    });
  }
  const relief = boxHoles.length ? null : createReferenceBoxReliefGroup({name, position, scale, materialKind});
  if(relief) referenceArchitectureGroup.add(relief);
  return base;
}

function addReferenceArchFrame(name, position, rotationY, width, height, thickness, openingW, openingH){
  return addReferenceWallPanel({
    name,
    width,height,thickness,
    holes:[{type:'arch',x:0,y:0,w:openingW,h:openingH}],
    position,
    rotationY,
    materialKind:'wall'
  });
}

function addReferenceGlowPlane(name, position, rotationX, scale){
  const mesh = new THREE.Mesh(new THREE.PlaneGeometry(1,1,1,1), referenceArchitectureMaterial('glassGlow'));
  mesh.position.set(position.x, position.y, position.z);
  mesh.rotation.x = rotationX;
  mesh.scale.set(scale.x, scale.y, 1);
  mesh.renderOrder = 12;
  return addReferenceMesh(mesh, name, 'glassGlow');
}

function rebuildReferenceArchitectureMaterials(){
  buildReferenceArchitecture();
}

function buildReferenceArchitecture(){
  if(!referenceArchitectureGroup) return;
  for(const obj of referenceArchitectureGroup.children) disposeObject3D(obj);
  referenceArchitectureGroup.clear();
  referenceCollisionItems = [];
  return;
  if(STATE?.referenceArchitecture?.enabled === false || STATE?.referenceArchitecture?.visible === false) return;

  const room = STATE.room || ROOM;
  const W = safeFinite(room.width,36);
  const D = safeFinite(room.depth,30);
  const H = safeFinite(room.height,8.8);
  const T = .38;
  const zBack = -D/2 + .08;
  const zFront = D/2 - .08;
  const xLeft = -W/2 + .08;
  const xRight = W/2 - .08;

  addReferenceWallPanel({
    name:'參考圖｜遠端主牆三連圓拱', width:W, height:H, thickness:T,
    position:{x:0,y:0,z:zBack}, rotationY:0,
    solidifyArchHoles:true,
    holes:[
      {type:'arch',x:-11.4,y:0,w:5.7,h:5.55},
      {type:'arch',x:-2.6,y:0,w:5.35,h:5.25},
      {type:'arch',x:6.8,y:0,w:6.15,h:5.75},
      {type:'roundRect',x:-6.6,y:6.15,w:4.2,h:1.62,r:.62},
      {type:'roundRect',x:3.4,y:6.18,w:4.4,h:1.58,r:.62},
      {type:'roundRect',x:12.9,y:6.05,w:3.25,h:1.5,r:.55}
    ]
  });

  addReferenceWallPanel({
    name:'參考圖｜右側長牆圓角開口', width:D, height:H, thickness:T,
    position:{x:xRight,y:0,z:0}, rotationY:Math.PI/2,
    solidifyArchHoles:true,
    holes:[
      {type:'arch',x:-10.2,y:0,w:6.2,h:5.2},
      {type:'arch',x:-1.2,y:0,w:5.8,h:4.85},
      {type:'arch',x:8.9,y:0,w:6.1,h:5.15},
      {type:'roundRect',x:-5.7,y:6.22,w:4.5,h:1.48,r:.62},
      {type:'roundRect',x:5.5,y:6.15,w:4.7,h:1.55,r:.62}
    ]
  });

  addReferenceWallPanel({
    name:'參考圖｜左側長牆拱廊', width:D, height:H, thickness:T,
    position:{x:xLeft,y:0,z:0}, rotationY:-Math.PI/2,
    solidifyArchHoles:true,
    holes:[
      {type:'arch',x:-10.7,y:0,w:5.9,h:5.0},
      {type:'arch',x:-1.0,y:0,w:6.2,h:5.15},
      {type:'arch',x:9.2,y:0,w:5.8,h:4.95},
      {type:'roundRect',x:-5.2,y:6.25,w:4.2,h:1.45,r:.62},
      {type:'roundRect',x:6.8,y:6.18,w:4.3,h:1.50,r:.62}
    ]
  });

  addReferenceWallPanel({
    name:'參考圖｜近端低對比拱牆', width:W, height:H, thickness:T,
    position:{x:0,y:0,z:zFront}, rotationY:Math.PI,
    solidifyArchHoles:true,
    holes:[
      {type:'arch',x:-10.8,y:0,w:6.4,h:5.1},
      {type:'arch',x:0,y:0,w:6.2,h:5.0},
      {type:'arch',x:10.8,y:0,w:6.4,h:5.1},
      {type:'roundRect',x:-5.6,y:6.2,w:4.3,h:1.45,r:.62},
      {type:'roundRect',x:5.6,y:6.2,w:4.3,h:1.45,r:.62}
    ]
  });

  const pillarPositions = [
    [-12.4,-9.5],[-3.7,-9.5],[5.4,-9.5],[13.1,-9.5],
    [-12.4,-1.8],[-3.7,-1.8],[5.4,-1.8],[13.1,-1.8],
    [-12.4,6.6],[-3.7,6.6],[5.4,6.6],[13.1,6.6]
  ];
  pillarPositions.forEach(([x,z], i)=>{
    addReferenceBox(`參考圖｜厚重方柱 ${i + 1}`, {x,y:H/2,z}, {x:1.05,y:H,z:1.05}, 'wall');
  });

  addReferenceArchFrame('參考圖｜中段橫向拱框 A', {x:-8.05,y:0,z:-5.75}, 0, 10.2, H, .44, 6.8, 5.45);
  addReferenceArchFrame('參考圖｜中段橫向拱框 B', {x:4.95,y:0,z:-5.75}, 0, 10.2, H, .44, 6.8, 5.45);
  addReferenceArchFrame('參考圖｜中段橫向拱框 C', {x:-8.05,y:0,z:2.45}, 0, 10.2, H, .44, 6.8, 5.25);
  addReferenceArchFrame('參考圖｜中段橫向拱框 D', {x:4.95,y:0,z:2.45}, 0, 10.2, H, .44, 6.8, 5.25);
  addReferenceArchFrame('參考圖｜縱向左拱框 A', {x:-8.1,y:0,z:-1.55}, Math.PI/2, 10.2, H, .44, 6.7, 5.35);
  addReferenceArchFrame('參考圖｜縱向右拱框 A', {x:5.0,y:0,z:-1.55}, Math.PI/2, 10.2, H, .44, 6.7, 5.35);
  addReferenceArchFrame('參考圖｜縱向右拱框 B', {x:5.0,y:0,z:7.0}, Math.PI/2, 10.2, H, .44, 6.7, 5.15);

  addReferenceBox('參考圖｜左側水平厚樑', {x:-8.05,y:6.95,z:.35}, {x:10.4,y:.62,z:17.8}, 'soffit');
  addReferenceBox('參考圖｜右側水平厚樑', {x:4.95,y:6.95,z:.35}, {x:10.4,y:.62,z:17.8}, 'soffit');
  addReferenceBox('參考圖｜後段橫樑', {x:0,y:6.92,z:-5.75}, {x:28.5,y:.58,z:.88}, 'soffit');
  addReferenceBox('參考圖｜前段橫樑', {x:0,y:6.92,z:2.45}, {x:28.5,y:.58,z:.88}, 'soffit');
  addReferenceBox('參考圖｜近景橫樑', {x:0,y:6.92,z:10.2}, {x:28.5,y:.58,z:.88}, 'soffit');
  addReferenceCeilingRuinPanel(W, D, H);

  addReferenceGlowPlane('參考圖｜右側水底亮斑', {x:7.2,y:.032,z:4.75}, -Math.PI/2, {x:11.0,y:7.1});
  addReferenceGlowPlane('參考圖｜遠端拱門透光', {x:6.8,y:2.4,z:zBack+.23}, 0, {x:4.4,y:4.7});

  referenceArchitectureGroup.traverse(obj=>{
    if(obj.isMesh){
      obj.frustumCulled = false;
    }
  });
}

function buildRoom(){
  disableBakedLightingRuntime();
  roomGroup.clear();
  surfaces = {};
  groundReliefMeshes = {};
  sandTerrainMeshes = {};
  const defs = {};
  for(const key of SURFACE_KEYS) defs[key] = getDefaultSurfaceTransform(key, STATE.room);
  const deleted = new Set(STATE.deletedSurfaces || []);
  for(const key of Object.keys(defs)){
    if(DELETABLE_SURFACE_KEYS.includes(key) && deleted.has(key)) continue;
    const tr = getSurfaceTransform(key);
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(1,1,1), makeMaterial(STATE.surfaces[key]));
    mesh.position.set(tr.position.x, tr.position.y, tr.position.z);
    mesh.scale.set(tr.size.x, tr.size.y, tr.size.z);
    mesh.name = SURFACE_LABELS[key] || key;
    mesh.receiveShadow = true;
    mesh.castShadow = key !== 'floor' && key !== 'ceiling';
    mesh.userData.surfaceKey = key;
    mesh.userData.isRoomWall = WALL_KEYS.includes(key);
    mesh.userData.isSelectableSurface = true;
    mesh.userData.hasReliefSurface = reliefEnabledForMaterial(STATE.surfaces[key]) || sandEnabledForMaterial(STATE.surfaces[key]);
    if(key === 'floor' && sandEnabledForMaterial(STATE.surfaces[key])) mesh.userData.sandPhysicalBase = true;
    applyWallVisualState(mesh, selectedRoomWallKey === key, false);
    roomGroup.add(mesh);
    surfaces[key] = mesh;
  }
  if(!STATE?.hideFloorGrid && !STATE.surfaces.floor?.texture && surfaces.floor && !reliefEnabledForMaterial(STATE.surfaces.floor) && !sandEnabledForMaterial(STATE.surfaces.floor)){
    const tr = getSurfaceTransform('floor');
    const grid = new THREE.GridHelper(1,22,0x565656,0x252525);
    grid.position.set(tr.position.x, tr.position.y + tr.size.y/2 + .007, tr.position.z);
    grid.scale.set(tr.size.x,1,tr.size.z);
    grid.name = 'floor-grid';
    roomGroup.add(grid);
  }
  addGroundReliefForMainFloor();
  for(const key of ['front','back','left','right','ceiling']) addSurfaceReliefForRoomSurface(key);
  rebuildCustomWalls();
  rebuildFloorTiles();
  refreshWallSelectionVisuals();
}

function applyFloorTileMeshTransform(mesh, tile){
  if(!mesh || !tile) return;
  const t = clamp(safeFinite(tile.size?.t, .18), .02, 500);
  mesh.position.set(safeFinite(tile.position?.x,0), safeFinite(tile.position?.y,-t/2), safeFinite(tile.position?.z,0));
  mesh.rotation.set(0,0,0);
  mesh.scale.set(clamp(safeFinite(tile.size?.w,4),.2,500), t, clamp(safeFinite(tile.size?.d,4),.2,500));
}

function rebuildFloorTiles(){
  disableBakedLightingRuntime();
  if(!floorTileGroup) return;
  floorTileGroup.clear();
  floorTileMeshes = {};
  for(const k of Object.keys(groundReliefMeshes)){
    if(k.startsWith('floorTile:')) delete groundReliefMeshes[k];
  }
  for(const k of Object.keys(sandTerrainMeshes)){
    if(k.startsWith('floorTile:')) delete sandTerrainMeshes[k];
  }
  for(const tile of STATE.floorTiles || []){
    const matCfg = tile.material || STATE.surfaces.floor;
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(1,1,1), makeMaterial(matCfg, STATE.surfaces.floor?.color || '#8d897f'));
    applyFloorTileMeshTransform(mesh, tile);
    mesh.name = tile.title || '地板塊';
    mesh.receiveShadow = true;
    mesh.castShadow = false;
    mesh.userData.floorTileId = tile.id;
    mesh.userData.isFloorTile = true;
    mesh.userData.hasReliefSurface = reliefEnabledForMaterial(matCfg) || sandEnabledForMaterial(matCfg);
    if(sandEnabledForMaterial(matCfg)) mesh.userData.sandPhysicalBase = true;
    applyWallVisualState(mesh, selectedFloorTileId===tile.id, !!tile.isDraft);
    floorTileGroup.add(mesh);
    floorTileMeshes[tile.id] = mesh;
    addGroundReliefForFloorTile(tile);
  }
  refreshGroundReliefSelectionVisuals();
}

function addFloorTile(){
  const base = selectedFloorTileId ? STATE.floorTiles.find(t=>t.id===selectedFloorTileId) : null;
  const floorTr = getSurfaceTransform('floor');
  const n = (STATE.floorTiles?.length || 0) + 1;
  const tile = base ? JSON.parse(JSON.stringify(base)) : {
    title:`地板塊 ${n}`,
    position:{x:player.position.x + 2.2, y:-STATE.room.thickness/2, z:player.position.z},
    size:{w:4, d:4, t:STATE.room.thickness},
    material:JSON.parse(JSON.stringify(STATE.surfaces.floor || {})),
    visible:true, locked:false,
    isDraft:false
  };
  tile.id = uid('floor');
  tile.title = `地板塊 ${n}`;
  if(base) tile.position.x += clamp(safeFinite(base.size?.w,4),.2,500);
  if(!base){
    tile.position.x = clamp(tile.position.x, floorTr.position.x - floorTr.size.x/2 - 20, floorTr.position.x + floorTr.size.x/2 + 20);
    tile.position.z = clamp(tile.position.z, floorTr.position.z - floorTr.size.z/2 - 20, floorTr.position.z + floorTr.size.z/2 + 20);
  }
  STATE.floorTiles.push(tile);
  selectFloorTile(tile.id);
  rebuildFloorTiles();
  syncObjectEditor();
  scheduleSave();
  setStatus('已新增地板塊。可用右側數值欄調整尺寸與位置；點選該地板塊後，可把凹凸起伏只套用到它。');
}

function deleteSelectedFloorTile(){
  if(!selectedFloorTileId) return false;
  const deletedId = selectedFloorTileId;
  STATE.floorTiles = (STATE.floorTiles || []).filter(t=>t.id!==deletedId);
  if(pendingFloorTileId === deletedId){ pendingFloorTileId = null; floorTileFollowPlayer = false; }
  selectedFloorTileId = null;
  rebuildFloorTiles();
  refreshWallSelectionVisuals();
  syncObjectEditor();
  renderObjectPanel();
  scheduleSave();
  setStatus('已刪除選取地板塊。');
  return true;
}

function disposeObjectTree(root){
  if(!root) return;
  root.traverse(obj=>{
    obj.geometry?.dispose?.();
    if(obj.material){
      const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
      for(const m of mats){
        m?.map?.userData?.sinTowerStoneMaterials?.delete?.(m);
        const stoneTextureKey = m?.userData?.sinTowerStoneTextureKey;
        if(stoneTextureKey) sinTowerStoneTextureCache.get(stoneTextureKey)?.materials?.delete?.(m);
        for(const key of ['map','alphaMap','normalMap','roughnessMap','metalnessMap','emissiveMap','aoMap']){
          disposeMaterialTextureIfOwned(m?.[key]);
        }
        m?.dispose?.();
      }
    }
  });
}

function deleteArtworkById(deletedId, label='已刪除作品。'){
  if(!deletedId) return false;
  const exists = (STATE.artworks || []).some(a=>a.id === deletedId);
  if(!exists) return false;
  pushUndoState('delete artwork');
  if(pendingArtworkId === deletedId){
    pendingArtworkId = null;
    artworkFollowPlayer = false;
  }
  if(transformControls?.object){
    const attachedArtId = findUserDataValueInHierarchy(transformControls.object, 'artId', scene);
    if(attachedArtId === deletedId) detachWallRotationControls();
  }
  const mesh = artworkMeshes?.[deletedId];
  if(mesh){
    artworkGroup?.remove(mesh);
    disposeObjectTree(mesh);
  }
  STATE.artworks = (STATE.artworks || []).filter(a=>a.id !== deletedId);
  selectedArtworkId = STATE.artworks[0]?.id || null;
  selectedArtworkActive = false;
  artEditorDirty = false;
  buildArtworks();
  syncArtEditor();
  syncObjectEditor();
  renderObjectPanel();
  scheduleSave();
  setStatus(STATE.artworks.length ? label : '已刪除作品。目前沒有作品，可重新匯入。');
  return true;
}

function deleteSelectedArtwork(){
  if(!selectedArtworkActive || !selectedArtworkId) return false;
  return deleteArtworkById(selectedArtworkId, '已刪除選取作品。');
}

function rebuildCustomWalls(){
  disableBakedLightingRuntime();
  const attachedId = transformControls?.object?.userData?.wallId || null;
  if(transformControls) transformControls.detach();
  customWallGroup.clear();
  customWallMeshes = {};
  for(const k of Object.keys(groundReliefMeshes)){
    if(k.startsWith('wall:')) delete groundReliefMeshes[k];
  }
  for(const w of STATE.customWalls){
    const geometry = createCustomWallGeometry(w);
    const wallMaterial = makeMaterial(w.material);
    if(customWallHasChiselHoles(w)) applyChiseledReliefSkinToMaterial(wallMaterial, w.material, 1.28);
    const mesh = new THREE.Mesh(geometry, wallMaterial);
    applyWallMeshTransform(mesh, w);
    mesh.name = `${w.title}${isCurvedWall(w) ? '｜曲面' : ''}`;
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    mesh.userData.wallId = w.id;
    mesh.userData.isCustomWall = true;
    mesh.userData.hasReliefSurface = reliefEnabledForMaterial(w.material);
    mesh.userData.referenceCollisionHeight = clamp(safeFinite(w.size?.h,ROOM.height), .5, 500);
    if(customWallHasChiselHoles(w)){
      attachChiseledReliefOverlayToMesh(mesh, {
        matCfg:w.material,
        fallbackColor:w.material?.color || '#d6d1c6',
        userData:{wallId:w.id, isCustomWall:true},
        name:`${w.title || '自建牆'}-chiseled-exact-relief`
      });
    }else{
      addChiselRecessDecalsToWallMesh(mesh, sanitizeChiselHoles(w.chiselHoles || [], false), clamp(safeFinite(w.size?.t,.18), .02, 500), true);
    }
    applyWallVisualState(mesh, selectedWallId===w.id, !!w.isDraft);
    customWallGroup.add(mesh);
    customWallMeshes[w.id] = mesh;
    addSurfaceReliefForCustomWall(w);
  }
  if(attachedId && customWallMeshes[attachedId]) attachRotationControls(attachedId);
  syncWallSelect();
}


function disposeSingleMaterial(mat){
  if(!mat) return;
  for(const key of ['map','alphaMap','normalMap','roughnessMap','metalnessMap','emissiveMap','aoMap']){
    disposeMaterialTextureIfOwned(mat?.[key]);
  }
  mat.dispose?.();
}

function disposeObject3D(root){
  if(!root) return;
  root.traverse?.(obj=>{
    if(obj.geometry) obj.geometry.dispose?.();
    const mat = obj.material;
    if(Array.isArray(mat)) mat.forEach(disposeSingleMaterial);
    else disposeSingleMaterial(mat);
  });
}

function waterShapeLabel(shape){
  if(shape === 'cylinder') return '圓形容器';
  if(shape === 'oval') return '橢圓容器';
  return '矩形池／河道';
}

function waterBodyDefaults(n=1){
  const f = getPlayerForward().normalize();
  const spawnDistance = 4.2;
  const p = player.position.clone().addScaledVector(f, spawnDistance);
  const bounds = wallPlacementBounds();
  return {
    id:uid('water'),
    title:`水體 ${n}`,
    shape:'rect',
    position:{x:clamp(p.x,bounds.minX,bounds.maxX), y:Math.max(0, safeFinite(player.position.y,0) - .02), z:clamp(p.z,bounds.minZ,bounds.maxZ)},
    size:{w:4.0, d:2.2, h:.72, t:.12},
    water:{color:'#4bbcff', opacity:.55, level:.72, wave:.55, causticStrength:1.15, interferenceStrength:1.0, motionDistortion:1.0, splash:.85},
    containerMaterial:{color:'#50545a',roughness:.82,metalness:.05,texture:null,repeat:[1,1]},
    visible:true,
    locked:false,
    isDraft:true
  };
}


function createWaterDiskGeometry(radius=1, radialSegments=80, angularSegments=192){
  const rSeg = Math.max(8, Math.floor(radialSegments));
  const aSeg = Math.max(24, Math.floor(angularSegments));
  const verts = [];
  const uvs = [];
  const indices = [];
  for(let r=0;r<=rSeg;r++){
    const fr = r / rSeg;
    const rad = radius * fr;
    for(let a=0;a<=aSeg;a++){
      const fa = a / aSeg;
      const ang = fa * Math.PI * 2;
      const x = Math.cos(ang) * rad;
      const y = Math.sin(ang) * rad;
      verts.push(x, y, 0);
      uvs.push(.5 + (x / Math.max(.0001, radius)) * .5, .5 + (y / Math.max(.0001, radius)) * .5);
    }
  }
  const row = aSeg + 1;
  for(let r=0;r<rSeg;r++){
    for(let a=0;a<aSeg;a++){
      const i0 = r * row + a;
      const i1 = i0 + 1;
      const i2 = (r + 1) * row + a;
      const i3 = i2 + 1;
      if(r === 0){
        indices.push(i0, i3, i2);
      }else{
        indices.push(i0, i1, i3, i0, i3, i2);
      }
    }
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.Float32BufferAttribute(verts, 3));
  geo.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
  geo.setIndex(indices);
  geo.computeVertexNormals();
  geo.computeBoundingSphere();
  return geo;
}

function createWaterMaterial(body){
  const water = body.water || {};
  const uniforms = {
    uTime:{value:0},
    uColor:{value:new THREE.Color(validColor(water.color)?water.color:'#4bbcff')},
    uOpacity:{value:clamp(safeFinite(water.opacity,.55),.05,.95)},
    uWave:{value:clamp(safeFinite(water.wave,.45),0,1)},
    uCausticStrength:{value:clamp(safeFinite(water.causticStrength,1),0,3)},
    uInterferenceStrength:{value:clamp(safeFinite(water.interferenceStrength,1),0,3)},
    uMotionCenter:{value:new THREE.Vector2(999,999)},
    uMotionStrength:{value:0},
    uRippleAge:{value:99},
    uRippleCenter:{value:new THREE.Vector2(999,999)},
    uRippleStrength:{value:0},
    uHalfSize:{value:new THREE.Vector2(1,1)},
    uShape:{value:0}
  };
  const w = clamp(safeFinite(body.size?.w,4),.2,500);
  const d = clamp(safeFinite(body.size?.d,2),.2,500);
  const t = clamp(safeFinite(body.size?.t,.12),.02,Math.min(w,d)/2);
  if(body.shape === 'cylinder' || body.shape === 'oval'){
    const r = Math.max(.1, Math.min(w,d)/2);
    uniforms.uHalfSize.value.set(Math.max(.05,r-t), Math.max(.05,r-t));
    uniforms.uShape.value = 1;
  }else{
    uniforms.uHalfSize.value.set(Math.max(.025,(w-t*2)/2), Math.max(.025,(d-t*2)/2));
    uniforms.uShape.value = 0;
  }

  const mat = new THREE.ShaderMaterial({
    uniforms,
    transparent:false,
    depthWrite:true,
    side:THREE.DoubleSide,
    vertexShader:`
      uniform float uTime;
      uniform float uWave;
      uniform float uRippleAge;
      uniform vec2 uRippleCenter;
      uniform float uRippleStrength;
      uniform vec2 uHalfSize;
      uniform float uShape;
      varying vec2 vUv;
      varying vec2 vLocal;
      varying float vFoam;
      varying float vWaveHeight;
      varying float vEdgeMask;
      varying float vFinePattern;
      float rippleAt(vec2 pos, vec2 center, float gain, float delay){
        float age = max(0.0, uRippleAge - delay);
        float active = smoothstep(0.0, 0.22, uRippleAge - delay);
        float d = distance(pos, center);
        float packet = sin(d*22.0 - age*12.5) * exp(-d*1.55) * exp(-age*1.38);
        float secondary = sin(d*36.0 - age*18.0) * exp(-d*2.55) * exp(-age*1.75) * .34;
        return (packet + secondary) * uRippleStrength * gain * active;
      }
      float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453123); }
      float noise(vec2 p){
        vec2 i=floor(p), f=fract(p);
        f=f*f*(3.0-2.0*f);
        float a=hash(i), b=hash(i+vec2(1.0,0.0)), c=hash(i+vec2(0.0,1.0)), d=hash(i+vec2(1.0,1.0));
        return mix(mix(a,b,f.x), mix(c,d,f.x), f.y);
      }
      void main(){
        vUv = uv;
        vec3 p = position;
        vec2 pos = p.xy;
        vLocal = pos;
        float waveGain = mix(1.0, 20.0, smoothstep(0.0, 1.0, uWave));
        float slow = sin(p.x*1.05 + uTime*1.05) * 0.020 + cos(p.y*1.26 - uTime*.92) * 0.017;
        float cross = sin((p.x*.72+p.y*1.13)*3.55 + uTime*1.85) * 0.011;
        float fine = sin(p.x*8.0 + p.y*5.7 + uTime*3.1) * 0.0045 + cos(p.x*12.5 - p.y*7.6 - uTime*2.4) * 0.0035;
        float microA = sin(p.x*18.0 + p.y*11.0 + uTime*4.7) * 0.0028;
        float microB = cos(p.x*27.0 - p.y*19.0 - uTime*5.4) * 0.0022;
        float chop = sin((p.x*2.6 - p.y*1.9) + sin(p.y*1.7 + uTime*.8) + uTime*2.4) * 0.008;
        float n1 = noise(pos*1.8 + vec2(uTime*.18, -uTime*.13)) - .5;
        float n2 = noise(pos*5.6 + vec2(-uTime*.42, uTime*.31)) - .5;
        float n3 = noise(pos*13.0 + vec2(uTime*.72, uTime*.54)) - .5;
        float n = n1*.010 + n2*.006 + n3*.003;
        float ripple = rippleAt(pos, uRippleCenter, 1.0, 0.0);
        float edgeDelay = 0.18;
        if(uShape < 0.5){
          float edgeDist = min(uHalfSize.x - abs(uRippleCenter.x), uHalfSize.y - abs(uRippleCenter.y));
          edgeDelay = clamp(edgeDist * 1.55, 0.08, 1.85);
          ripple += rippleAt(pos, vec2( 2.0*uHalfSize.x - uRippleCenter.x, uRippleCenter.y), .52, edgeDelay);
          ripple += rippleAt(pos, vec2(-2.0*uHalfSize.x - uRippleCenter.x, uRippleCenter.y), .52, edgeDelay);
          ripple += rippleAt(pos, vec2(uRippleCenter.x,  2.0*uHalfSize.y - uRippleCenter.y), .52, edgeDelay);
          ripple += rippleAt(pos, vec2(uRippleCenter.x, -2.0*uHalfSize.y - uRippleCenter.y), .52, edgeDelay);
          ripple += rippleAt(pos, vec2( 2.0*uHalfSize.x - uRippleCenter.x,  2.0*uHalfSize.y - uRippleCenter.y), .20, edgeDelay + .18);
          ripple += rippleAt(pos, vec2(-2.0*uHalfSize.x - uRippleCenter.x, -2.0*uHalfSize.y - uRippleCenter.y), .20, edgeDelay + .18);
          float ex = smoothstep(0.0, .20, uHalfSize.x - abs(pos.x));
          float ey = smoothstep(0.0, .20, uHalfSize.y - abs(pos.y));
          vEdgeMask = 1.0 - min(ex, ey);
        }else{
          float r = max(.05, uHalfSize.x);
          float cLen = length(uRippleCenter);
          vec2 dir = cLen > .001 ? uRippleCenter / cLen : vec2(1.0,0.0);
          float edgeDist = max(0.0, r - cLen);
          edgeDelay = clamp(edgeDist * 1.55, 0.08, 1.85);
          vec2 edge = dir * r;
          vec2 mirror = edge * 2.0 - uRippleCenter;
          ripple += rippleAt(pos, mirror, .60, edgeDelay);
          vEdgeMask = 1.0 - smoothstep(0.0,.28, r - length(pos));
        }
        float baseWave = (slow + cross + fine + chop + microA + microB + n) * (0.18 + uWave*2.6);
        float waveHeight = baseWave * waveGain + ripple * (0.105 + uWave*.18);
        p.z += waveHeight;
        vWaveHeight = waveHeight;
        vFinePattern = abs(fine + microA*1.8 + microB*1.5) * (34.0 + uWave*42.0) + noise(pos*8.5 + uTime*.25)*.45 + noise(pos*21.0 - uTime*.38)*.28;
        vFoam = clamp(abs(ripple) * 2.2 + vEdgeMask*.10 + smoothstep(.70,.98,uWave)*0.085 + smoothstep(.16,.85,abs(waveHeight))*0.07, 0.0, 1.0);
        gl_Position = projectionMatrix * modelViewMatrix * vec4(p,1.0);
      }
    `,
    fragmentShader:`
      uniform vec3 uColor;
      uniform float uOpacity;
      uniform float uTime;
      uniform float uWave;
      uniform float uCausticStrength;
      uniform float uInterferenceStrength;
      uniform vec2 uMotionCenter;
      uniform float uMotionStrength;
      varying vec2 vUv;
      varying vec2 vLocal;
      varying float vFoam;
      varying float vWaveHeight;
      varying float vEdgeMask;
      varying float vFinePattern;
      float hash(vec2 p){ return fract(sin(dot(p, vec2(269.5,183.3))) * 43758.5453); }
      vec2 hash22(vec2 p){
        p = vec2(dot(p, vec2(127.1,311.7)), dot(p, vec2(269.5,183.3)));
        return fract(sin(p) * 43758.5453123);
      }
      float noise(vec2 p){
        vec2 i=floor(p), f=fract(p); f=f*f*(3.0-2.0*f);
        float a=hash(i), b=hash(i+vec2(1.0,0.0)), c=hash(i+vec2(0.0,1.0)), d=hash(i+vec2(1.0,1.0));
        return mix(mix(a,b,f.x), mix(c,d,f.x), f.y);
      }
      float causticCellEdge(vec2 p, float time){
        vec2 i = floor(p);
        vec2 f = fract(p);
        float nearest = 10.0;
        float second = 10.0;
        for(int yy=-1; yy<=1; yy++){
          for(int xx=-1; xx<=1; xx++){
            vec2 g = vec2(float(xx), float(yy));
            vec2 rnd = hash22(i + g);
            vec2 anchor = 0.5 + 0.5 * sin(time * 0.42 + rnd * 6.2831853 + vec2(rnd.y * 4.1, rnd.x * 3.7));
            vec2 r = g + anchor - f;
            float d = dot(r, r);
            if(d < nearest){ second = nearest; nearest = d; }
            else if(d < second){ second = d; }
          }
        }
        float border = max(0.0, sqrt(second) - sqrt(nearest));
        float core = 1.0 - smoothstep(0.012, 0.052, border);
        float glow = 1.0 - smoothstep(0.040, 0.150, border);
        return clamp(core * 0.86 + glow * 0.34, 0.0, 1.0);
      }
      float causticNetwork(vec2 p){
        float t = uTime;
        vec2 q = p;
        q += vec2(sin(q.y * 1.43 + t * 0.55), cos(q.x * 1.21 - t * 0.49)) * 0.18;
        q += vec2(sin((q.x + q.y) * 0.83 - t * 0.30), cos((q.x - q.y) * 0.91 + t * 0.35)) * 0.11;
        vec2 motionVec = p - uMotionCenter;
        float motionDist = length(motionVec);
        vec2 motionDir = motionVec / max(motionDist, 0.001);
        float motionWake = exp(-motionDist * 1.65) * uMotionStrength;
        q += motionDir * sin(motionDist * 11.0 - t * 5.2) * motionWake * 0.42;
        q += vec2(motionDir.y, -motionDir.x) * cos(motionDist * 8.0 + t * 4.0) * motionWake * 0.14;
        float c1 = causticCellEdge(q * 2.55 + vec2(t * 0.055, -t * 0.035), t);
        float c2 = causticCellEdge(q * 4.15 + vec2(-t * 0.075, t * 0.044), t + 17.0);
        float c3 = causticCellEdge(q * 7.20 + vec2(t * 0.025, t * 0.085), t + 41.0);
        float interference = pow(max(0.0, 1.0 - abs(sin((p.x * 2.10 + p.y * 0.70) + t * 0.45) - sin((p.x * 0.80 - p.y * 1.90) - t * 0.63)) * 1.15), 2.0);
        return clamp(c1 * 0.78 + c2 * 0.42 + c3 * 0.20 + interference * 0.16 * uInterferenceStrength, 0.0, 1.0);
      }
      void main(){
        vec2 centered = vUv - .5;
        float edge = smoothstep(0.0,.045,vUv.x)*smoothstep(0.0,.045,vUv.y)*smoothstep(0.0,.045,1.0-vUv.x)*smoothstep(0.0,.045,1.0-vUv.y);
        float largeFlow = sin((vLocal.x*.85 + vLocal.y*.43) * 3.1 + uTime*1.15) * .5 + .5;
        float crossFlow = sin((vLocal.x*1.35 - vLocal.y*.9) * 5.4 - uTime*1.75) * .5 + .5;
        float fine = noise(vLocal*7.5 + vec2(uTime*.35, -uTime*.18));
        float fine2 = noise(vLocal*18.0 + vec2(-uTime*.62, uTime*.44));
        float fine3 = noise(vLocal*36.0 + vec2(uTime*.95, -uTime*.71));
        float softCaustic = pow(max(0.0, 1.0 - abs(largeFlow - crossFlow)*2.2), 2.4) * .24;
        softCaustic += pow(fine, 3.0) * .12 + pow(fine2, 4.0) * .10 + pow(fine3, 5.0) * .055;
        // 依參考圖加入水面受光後的網狀焦散：多層 Voronoi 邊界 + 正弦干涉，形成會漂移、會聚散的白綠色水光網。
        float causticNetRaw = causticNetwork(vLocal + vec2(sin(uTime*.13), cos(uTime*.11))*.08);
        float causticGate = smoothstep(.16, .92, largeFlow*.46 + crossFlow*.40 + fine*.14);
        float motionDist = distance(vLocal, uMotionCenter);
        float motionWake = exp(-motionDist * 1.55) * uMotionStrength;
        float motionRing = pow(sin(motionDist * 18.0 - uTime * 6.6) * .5 + .5, 2.0) * exp(-motionDist * 1.35) * uMotionStrength;
        float causticNet = pow(causticNetRaw, 0.92) * edge * (1.15 + uWave * 1.85) * uCausticStrength;
        causticNet = clamp(causticNet + motionRing * 0.34 * edge * uCausticStrength, 0.0, 3.0);
        float caustic = clamp(softCaustic + causticNet * 2.65 + motionWake * 0.28 * uCausticStrength, 0.0, 3.2);
        float crest = smoothstep(.030, .55, abs(vWaveHeight));
        float microSpec = smoothstep(.38, .92, fract((fine2*1.73 + fine3*.91 + largeFlow*.37) * 3.7));
        float waveSpec = crest * (.18 + uWave*.42) + vFinePattern*(.045 + uWave*.040) + microSpec*.06;
        float slopeShade = clamp(.5 + vWaveHeight * (1.2 + uWave*.45), 0.0, 1.0);
        vec3 deep = max(uColor * vec3(.48,.78,1.05), uColor * 0.48);
        vec3 mid = max(uColor * vec3(1.02,1.26,1.38), uColor * 0.88);
        vec3 c = mix(deep, mid, clamp(.34 + largeFlow*.18 + crossFlow*.16 + caustic*.9 + waveSpec*.7 + slopeShade*.18,0.0,1.0));
        c = mix(c, c * vec3(.72,.84,.92), clamp((1.0-slopeShade)*.42 + crest*.12,0.0,.55));
        c = mix(c, vec3(.82,.96,1.0), clamp(vFoam*.48 + caustic*.34 + waveSpec*.28,0.0,.68));
        vec3 causticWhite = vec3(.82, 1.0, .94);
        c = mix(c, causticWhite, clamp(causticNet*.72 + caustic*.08, 0.0, .78));
        c += causticWhite * causticNet * (.20 + uWave*.24);
        c += causticWhite * motionRing * (0.18 + uCausticStrength * 0.10);
        c += uColor * (vEdgeMask*.16 + caustic*.26 + .10);
        // 水面本體必須永遠可見。過去依賴透明 alpha 混合，會被排序、深度與後處理吃掉，造成水面完全消失。
        // 這裡改成不透明水色表面：透明度滑桿只調整色彩深淺與清澈感，不再讓水面 alpha 歸零。
        float clarity = clamp(uOpacity,0.0,1.0);
        vec3 clearTint = mix(c, uColor * vec3(1.18,1.36,1.45), .26);
        vec3 denseTint = mix(uColor * vec3(.38,.74,1.0), c, .52);
        c = mix(denseTint, clearTint, clarity);
        c += vec3(.035,.075,.095) * (1.0 - clarity);
        c = mix(c, vec3(.86,.97,1.0), clamp((vFoam*.42 + caustic*.22 + waveSpec*.16),0.0,.46));
        c = mix(c, causticWhite, clamp(causticNet*.82, 0.0, .86));
        c += causticWhite * causticNet * .42;
        c = max(c, uColor * .62 + vec3(.015,.04,.055));
        gl_FragColor = vec4(c, 1.0);
      }
    `
  });
  mat.blending = THREE.NormalBlending;
  mat.toneMapped = false;
  mat.premultipliedAlpha = false;
  mat.userData.waterUniforms = uniforms;
  return mat;
}

function createWaterCausticOverlayMaterial(body){
  const water = body.water || {};
  const uniforms = {
    uTime:{value:0},
    uColor:{value:new THREE.Color(validColor(water.color)?water.color:'#4bbcff')},
    uWave:{value:clamp(safeFinite(water.wave,.45),0,1)},
    uCausticStrength:{value:clamp(safeFinite(water.causticStrength,1),0,3)},
    uInterferenceStrength:{value:clamp(safeFinite(water.interferenceStrength,1),0,3)},
    uMotionCenter:{value:new THREE.Vector2(999,999)},
    uMotionStrength:{value:0},
    uRippleAge:{value:99},
    uRippleCenter:{value:new THREE.Vector2(999,999)},
    uRippleStrength:{value:0},
    uHalfSize:{value:new THREE.Vector2(1,1)},
    uShape:{value:0}
  };
  const w = clamp(safeFinite(body.size?.w,4),.2,500);
  const d = clamp(safeFinite(body.size?.d,2),.2,500);
  const t = clamp(safeFinite(body.size?.t,.12),.02,Math.min(w,d)/2);
  if(body.shape === 'cylinder' || body.shape === 'oval'){
    const r = Math.max(.1, Math.min(w,d)/2);
    uniforms.uHalfSize.value.set(Math.max(.05,r-t), Math.max(.05,r-t));
    uniforms.uShape.value = 1;
  }else{
    uniforms.uHalfSize.value.set(Math.max(.025,(w-t*2)/2), Math.max(.025,(d-t*2)/2));
    uniforms.uShape.value = 0;
  }
  const mat = new THREE.ShaderMaterial({
    uniforms,
    transparent:true,
    depthWrite:false,
    depthTest:true,
    side:THREE.DoubleSide,
    toneMapped:false,
    vertexShader:`
      varying vec2 vUv;
      varying vec2 vLocal;
      void main(){
        vUv = uv;
        vLocal = position.xy;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position,1.0);
      }
    `,
    fragmentShader:`
      uniform float uTime;
      uniform float uWave;
      uniform float uCausticStrength;
      uniform float uInterferenceStrength;
      uniform float uRippleAge;
      uniform vec2 uRippleCenter;
      uniform float uRippleStrength;
      uniform vec2 uMotionCenter;
      uniform float uMotionStrength;
      uniform vec3 uColor;
      varying vec2 vUv;
      varying vec2 vLocal;
      float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1,311.7))) * 43758.5453123); }
      vec2 hash22(vec2 p){
        p = vec2(dot(p, vec2(127.1,311.7)), dot(p, vec2(269.5,183.3)));
        return fract(sin(p) * 43758.5453123);
      }
      float voronoiLine(vec2 p, float time){
        vec2 i = floor(p);
        vec2 f = fract(p);
        float nearest = 8.0;
        float second = 8.0;
        for(int y=-1; y<=1; y++){
          for(int x=-1; x<=1; x++){
            vec2 g = vec2(float(x), float(y));
            vec2 rnd = hash22(i + g);
            vec2 anchor = 0.5 + 0.5 * sin(rnd * 6.2831853 + time * vec2(0.62 + rnd.x*.28, 0.48 + rnd.y*.31));
            vec2 r = g + anchor - f;
            float d = dot(r,r);
            if(d < nearest){ second = nearest; nearest = d; }
            else if(d < second){ second = d; }
          }
        }
        float border = max(0.0, sqrt(second) - sqrt(nearest));
        float wire = 1.0 - smoothstep(0.018, 0.072, border);
        float halo = 1.0 - smoothstep(0.065, 0.215, border);
        return clamp(wire * 1.05 + halo * 0.46, 0.0, 1.0);
      }
      float ripplePulse(vec2 p){
        float age = max(0.0, uRippleAge);
        float d = distance(p, uRippleCenter);
        float width = 0.18 + age * 0.018;
        float ring = (1.0 - smoothstep(0.0, width, abs(d - age * 1.15))) * exp(-age * 1.18) * uRippleStrength;
        return clamp(ring, 0.0, 1.0);
      }
      float causticNet(vec2 p){
        float t = uTime;
        vec2 q = p;
        q += vec2(sin(q.y*1.37 + t*.62), cos(q.x*1.11 - t*.54)) * .20;
        q += vec2(sin((q.x+q.y)*.83 - t*.33), cos((q.x-q.y)*.91 + t*.39)) * .13;
        vec2 motionVec = p - uMotionCenter;
        float motionDist = length(motionVec);
        vec2 motionDir = motionVec / max(motionDist, 0.001);
        float wake = exp(-motionDist * 1.55) * uMotionStrength;
        q += motionDir * sin(motionDist * 11.5 - t * 6.0) * wake * .58;
        q += vec2(motionDir.y, -motionDir.x) * cos(motionDist * 9.2 + t * 4.4) * wake * .18;
        float ring = ripplePulse(p);
        vec2 ringVec = p - uRippleCenter;
        float ringDist = length(ringVec);
        vec2 ringDir = ringVec / max(ringDist, 0.001);
        q += ringDir * sin(ringDist * 8.0 - t * 4.0) * ring * .42;
        float n1 = voronoiLine(q*2.05 + vec2(t*.045, -t*.035), t);
        float n2 = voronoiLine(q*3.65 + vec2(-t*.060, t*.052), t + 19.0);
        float n3 = voronoiLine(q*6.35 + vec2(t*.028, t*.071), t + 43.0);
        float interference = pow(max(0.0, 1.0 - abs(sin(p.x*3.2 + p.y*1.4 + t*.82) - sin(p.x*.9 - p.y*3.8 - t*.67))*1.05), 2.6);
        return clamp(n1*.86 + n2*.58 + n3*.34 + interference*.22 * uInterferenceStrength, 0.0, 1.0);
      }
      void main(){
        float edge = smoothstep(0.0,.022,vUv.x)*smoothstep(0.0,.022,vUv.y)*smoothstep(0.0,.022,1.0-vUv.x)*smoothstep(0.0,.022,1.0-vUv.y);
        float flow = sin((vLocal.x*1.16 + vLocal.y*.72) * 2.4 + uTime*.96) * .5 + .5;
        float net = causticNet(vLocal + vec2(sin(uTime*.12), cos(uTime*.10))*.075);
        float wake = exp(-distance(vLocal, uMotionCenter) * 1.48) * uMotionStrength;
        float ring = ripplePulse(vLocal);
        net = clamp(net * max(0.0, uCausticStrength) + wake * .30 + ring * .34, 0.0, 3.0);
        float hot = smoothstep(.46, .86, net);
        float pulse = .76 + .24 * sin(uTime*1.65 + flow*6.2831853);
        float alpha = clamp((net*.54 + hot*.46) * pulse * (0.72 + uWave*1.08) * edge, 0.0, .94);
        vec3 paleGreen = vec3(.58, 1.00, .88);
        vec3 white = vec3(1.0, 1.0, .96);
        vec3 col = mix(paleGreen, white, hot);
        col = mix(col, max(uColor, paleGreen), .10);
        gl_FragColor = vec4(col * (1.22 + hot*1.35 + wake*.38 + ring*.28), alpha);
      }
    `
  });
  mat.blending = THREE.AdditiveBlending;
  mat.premultipliedAlpha = false;
  mat.userData.waterUniforms = uniforms;
  mat.userData.isWaterCausticOverlay = true;
  mat.userData.preserveWaterVisibility = true;
  return mat;
}


function createWaterTintVolumeMaterial(body){
  const water = body.water || {};
  const transparency = clamp(safeFinite(water.opacity,.55),.05,.95);
  const mat = new THREE.MeshBasicMaterial({
    color:validColor(water.color) ? water.color : '#4bbcff',
    transparent:true,
    opacity:clamp(0.62 - transparency * 0.24, .34, .62),
    depthWrite:false,
    depthTest:true,
    side:THREE.DoubleSide,
    toneMapped:false
  });
  mat.userData.isWaterTintVolume = true;
  mat.userData.preserveWaterVisibility = true;
  return mat;
}

function makeContainerMaterial(body){
  const cfg = body.containerMaterial || body.material || {};
  const mat = makeMaterial({
    color:validColor(cfg.color) ? cfg.color : '#50545a',
    roughness:clamp(safeFinite(cfg.roughness,.82),0,1),
    metalness:clamp(safeFinite(cfg.metalness,.05),0,1),
    texture:cfg.texture || null,
    repeat:Array.isArray(cfg.repeat) ? cfg.repeat : [1,1]
  }, '#50545a');
  mat.side = THREE.DoubleSide;
  mat.transparent = !!body.isDraft;
  mat.opacity = body.isDraft ? .42 : 1;
  mat.depthWrite = !body.isDraft;
  mat.needsUpdate = true;
  return mat;
}

function tagWaterObject(obj, body){
  obj.userData.waterId = body.id;
  obj.userData.isWaterBody = true;
  obj.traverse?.(child=>{
    child.userData.waterId = body.id;
    child.userData.isWaterBody = true;
  });
}

function createRectWaterBody(body){
  const group = new THREE.Group();
  const w = clamp(safeFinite(body.size?.w,4),.2,500);
  const d = clamp(safeFinite(body.size?.d,2),.2,500);
  const h = clamp(safeFinite(body.size?.h,.7),.05,500);
  const t = clamp(safeFinite(body.size?.t,.12),.02,Math.min(w,d)/2);
  const mat = makeContainerMaterial(body);
  const bottom = new THREE.Mesh(new THREE.BoxGeometry(w,t,d), mat); bottom.position.y = t/2;
  const left = new THREE.Mesh(new THREE.BoxGeometry(t,h,d), mat); left.position.set(-w/2+t/2,h/2,0);
  const right = new THREE.Mesh(new THREE.BoxGeometry(t,h,d), mat); right.position.set(w/2-t/2,h/2,0);
  const front = new THREE.Mesh(new THREE.BoxGeometry(w,h,t), mat); front.position.set(0,h/2,d/2-t/2);
  const back = new THREE.Mesh(new THREE.BoxGeometry(w,h,t), mat); back.position.set(0,h/2,-d/2+t/2);
  for(const m of [bottom,left,right,front,back]){ m.castShadow=true; m.receiveShadow=true; group.add(m); }
  const waterGeo = new THREE.PlaneGeometry(Math.max(.05,w-t*2), Math.max(.05,d-t*2), 168, 168);
  const waterMat = createWaterMaterial(body);
  const waterMesh = new THREE.Mesh(waterGeo, waterMat);
  waterMesh.rotation.x = -Math.PI/2;
  waterMesh.position.y = clamp(safeFinite(body.water?.level,.72),.05,.98) * h;
  waterMesh.renderOrder = 19;
  waterMesh.userData.isWaterSurface = true;
  group.add(waterMesh);
  const causticMat = createWaterCausticOverlayMaterial(body);
  const causticMesh = new THREE.Mesh(new THREE.PlaneGeometry(Math.max(.05,w-t*2), Math.max(.05,d-t*2), 2, 2), causticMat);
  causticMesh.rotation.x = -Math.PI/2;
  causticMesh.position.y = waterMesh.position.y + .014;
  causticMesh.renderOrder = 26;
  causticMesh.userData.isWaterCausticOverlay = true;
  group.add(causticMesh);
  const basePlateMat = new THREE.MeshBasicMaterial({
    color:validColor(body.water?.color) ? body.water.color : '#4bbcff',
    transparent:true,
    opacity:clamp(.58 - clamp(safeFinite(body.water?.opacity,.55),.05,.95)*.18, .40, .58),
    depthWrite:false,
    depthTest:true,
    side:THREE.DoubleSide,
    toneMapped:false
  });
  basePlateMat.userData.preserveWaterVisibility = true;
  const basePlate = new THREE.Mesh(new THREE.PlaneGeometry(Math.max(.05,w-t*2), Math.max(.05,d-t*2), 8, 8), basePlateMat);
  basePlate.rotation.x = -Math.PI/2;
  basePlate.position.y = waterMesh.position.y - .006;
  basePlate.renderOrder = 18;
  basePlate.userData.isWaterColorBase = true;
  group.add(basePlate);
  const fillH = Math.max(.018, waterMesh.position.y - t*.60);
  if(fillH > .018){
    const fill = new THREE.Mesh(new THREE.BoxGeometry(Math.max(.05,w-t*2), fillH, Math.max(.05,d-t*2)), createWaterTintVolumeMaterial(body));
    fill.position.y = t*.52 + fillH/2;
    fill.renderOrder = 17;
    fill.userData.isWaterVolumeFill = true;
    group.add(fill);
  }
  waterRuntime.materials.set(body.id, waterMat);
  waterRuntime.materials.set(`${body.id}:caustic`, causticMat);
  return group;
}

function createRoundWaterBody(body){
  const group = new THREE.Group();
  const w = clamp(safeFinite(body.size?.w,3),.2,500);
  const d = clamp(safeFinite(body.size?.d,3),.2,500);
  const h = clamp(safeFinite(body.size?.h,.7),.05,500);
  const t = clamp(safeFinite(body.size?.t,.12),.02,Math.min(w,d)/2);
  const mat = makeContainerMaterial(body);
  const r = Math.max(.1, Math.min(w,d)/2);
  const side = new THREE.Mesh(new THREE.CylinderGeometry(r,r,h,64,1,true), mat);
  side.position.y = h/2;
  side.scale.x = w/(2*r);
  side.scale.z = d/(2*r);
  const bottom = new THREE.Mesh(new THREE.CylinderGeometry(r,r,t,64), mat);
  bottom.position.y = t/2;
  bottom.scale.x = w/(2*r);
  bottom.scale.z = d/(2*r);
  for(const m of [side,bottom]){ m.castShadow=true; m.receiveShadow=true; group.add(m); }
  const waterGeo = createWaterDiskGeometry(Math.max(.05,r-t), 88, 192);
  const waterMat = createWaterMaterial(body);
  const waterMesh = new THREE.Mesh(waterGeo, waterMat);
  waterMesh.rotation.x = -Math.PI/2;
  waterMesh.scale.x = (w-t*2)/(2*Math.max(.05,r-t));
  waterMesh.scale.y = (d-t*2)/(2*Math.max(.05,r-t));
  waterMesh.position.y = clamp(safeFinite(body.water?.level,.72),.05,.98) * h;
  waterMesh.renderOrder = 19;
  waterMesh.userData.isWaterSurface = true;
  group.add(waterMesh);
  const causticMat = createWaterCausticOverlayMaterial(body);
  const causticMesh = new THREE.Mesh(new THREE.CircleGeometry(Math.max(.05,r-t), 96), causticMat);
  causticMesh.rotation.x = -Math.PI/2;
  causticMesh.scale.x = (w-t*2)/(2*Math.max(.05,r-t));
  causticMesh.scale.y = (d-t*2)/(2*Math.max(.05,r-t));
  causticMesh.position.y = waterMesh.position.y + .014;
  causticMesh.renderOrder = 26;
  causticMesh.userData.isWaterCausticOverlay = true;
  group.add(causticMesh);
  const basePlateMat = new THREE.MeshBasicMaterial({
    color:validColor(body.water?.color) ? body.water.color : '#4bbcff',
    transparent:true,
    opacity:clamp(.58 - clamp(safeFinite(body.water?.opacity,.55),.05,.95)*.18, .40, .58),
    depthWrite:false,
    depthTest:true,
    side:THREE.DoubleSide,
    toneMapped:false
  });
  basePlateMat.userData.preserveWaterVisibility = true;
  const basePlate = new THREE.Mesh(new THREE.CircleGeometry(Math.max(.05,r-t),96), basePlateMat);
  basePlate.rotation.x = -Math.PI/2;
  basePlate.scale.x = (w-t*2)/(2*Math.max(.05,r-t));
  basePlate.scale.y = (d-t*2)/(2*Math.max(.05,r-t));
  basePlate.position.y = waterMesh.position.y - .006;
  basePlate.renderOrder = 18;
  basePlate.userData.isWaterColorBase = true;
  group.add(basePlate);
  const fillH = Math.max(.018, waterMesh.position.y - t*.60);
  if(fillH > .018){
    const fill = new THREE.Mesh(new THREE.CylinderGeometry(Math.max(.05,r-t), Math.max(.05,r-t), fillH, 64, 1, false), createWaterTintVolumeMaterial(body));
    fill.position.y = t*.52 + fillH/2;
    fill.scale.x = (w-t*2)/(2*Math.max(.05,r-t));
    fill.scale.z = (d-t*2)/(2*Math.max(.05,r-t));
    fill.renderOrder = 17;
    fill.userData.isWaterVolumeFill = true;
    group.add(fill);
  }
  waterRuntime.materials.set(body.id, waterMat);
  waterRuntime.materials.set(`${body.id}:caustic`, causticMat);
  return group;
}

function createWaterBodyGroup(body){
  const group = (body.shape === 'cylinder' || body.shape === 'oval') ? createRoundWaterBody(body) : createRectWaterBody(body);
  group.name = body.title || '水體';
  group.position.set(safeFinite(body.position?.x,0), safeFinite(body.position?.y,0), safeFinite(body.position?.z,0));
  tagWaterObject(group, body);
  applyWaterVisualState(group, selectedWaterBodyId === body.id, !!body.isDraft);
  return group;
}

function buildWaterBodies(){
  if(!waterGroup) return;
  for(const obj of waterGroup.children) disposeObject3D(obj);
  waterGroup.clear();
  waterBodyMeshes = {};
  waterRuntime.materials.clear();
  for(const body of (STATE.waterBodies || [])){
    const group = createWaterBodyGroup(body);
    waterGroup.add(group);
    waterBodyMeshes[body.id] = group;
  }
  syncWaterSelect();
  refreshWaterSelectionVisuals();
  applyObjectVisibilityLocks();
  renderObjectPanel();
}

function applyWaterVisualState(group, selected=false, draft=false){
  if(!group) return;
  const translucent = selected || draft;
  group.traverse(obj=>{
    const mat = obj.material;
    const apply = m=>{
      if(!m || m.userData?.waterUniforms) return;
      if(m.userData?.preserveWaterVisibility){
        m.side = THREE.DoubleSide;
        m.transparent = true;
        m.depthWrite = false;
        m.needsUpdate = true;
        return;
      }
      m.side = THREE.DoubleSide;
      m.transparent = translucent;
      m.opacity = translucent ? (draft ? .38 : .48) : 1;
      m.depthWrite = !translucent;
      m.needsUpdate = true;
    };
    if(Array.isArray(mat)) mat.forEach(apply); else apply(mat);
  });
}

function refreshWaterSelectionVisuals(){
  for(const body of (STATE.waterBodies || [])) applyWaterVisualState(waterBodyMeshes[body.id], selectedWaterBodyId === body.id, !!body.isDraft);
}

function addWaterBodyAhead(){
  if(pendingWallId) confirmPendingWall();
  if(pendingArtworkId) confirmPendingArtwork();
  if(pendingFloorTileId) confirmPendingFloorTile();
  if(pendingWaterBodyId) confirmPendingWaterBody();
  const body = waterBodyDefaults((STATE.waterBodies?.length || 0) + 1);
  STATE.waterBodies = STATE.waterBodies || [];
  STATE.waterBodies.push(body);
  pendingWaterBodyId = body.id;
  waterBodyFollowPlayer = true;
  selectedWaterBodyId = body.id;
  selectedWallId = null;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedArtworkActive = false;
  detachWallRotationControls();
  buildWaterBodies();
  selectWaterBody(body.id);
  syncWaterEditor();
  syncObjectEditor();
  setStatus('已建立半透明水體。移動角色可帶著水體走，現在可直接選擇容器形狀與尺寸；按 Enter 固定。');
}

function updatePendingWaterBodyPlacement(){
  if(!pendingWaterBodyId || !waterBodyFollowPlayer || transformControls?.dragging) return;
  const body = (STATE.waterBodies || []).find(w=>w.id===pendingWaterBodyId);
  const group = waterBodyMeshes[pendingWaterBodyId];
  if(!body || !group) return;
  const f = getPlayerForward().normalize();
  const distance = Math.max(3.8, Math.min(12.0, safeFinite(body.size?.d,2.2) * .85 + player.radius + 3.4));
  const p = player.position.clone().addScaledVector(f,distance);
  const b = wallPlacementBounds();
  body.position.x = clamp(p.x,b.minX,b.maxX);
  body.position.y = Math.max(0, safeFinite(body.position?.y,0));
  body.position.z = clamp(p.z,b.minZ,b.maxZ);
  group.position.set(body.position.x, body.position.y, body.position.z);
}

function confirmPendingWaterBody(){
  if(!pendingWaterBodyId) return false;
  const body = (STATE.waterBodies || []).find(w=>w.id===pendingWaterBodyId);
  if(!body) return false;
  updatePendingWaterBodyPlacement();
  body.isDraft = false;
  pendingWaterBodyId = null;
  waterBodyFollowPlayer = false;
  selectedWaterBodyId = null;
  buildWaterBodies();
  syncWaterEditor();
  syncObjectEditor();
  scheduleSave();
  setStatus('水體已固定。角色走入水面時會產生波紋與濺水。');
  return true;
}

function deleteSelectedWaterBody(){
  if(!selectedWaterBodyId) return false;
  const id = selectedWaterBodyId;
  STATE.waterBodies = (STATE.waterBodies || []).filter(w=>w.id!==id);
  if(pendingWaterBodyId === id){ pendingWaterBodyId = null; waterBodyFollowPlayer = false; }
  selectedWaterBodyId = null;
  buildWaterBodies();
  syncWaterEditor();
  scheduleSave();
  setStatus('已刪除水體。');
  return true;
}

function selectWaterBody(id){
  if(!id || !(STATE.waterBodies || []).some(w=>w.id===id)) return false;
  selectedWaterBodyId = id;
  selectedWallId = null;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedArtworkActive = false;
  selectedGroupId = null;
  clearObjectMultiSelection();
  detachWallRotationControls();
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  refreshWaterSelectionVisuals();
  syncWaterSelect();
  syncWaterEditor();
  syncObjectEditor();
  renderObjectPanel();
  return true;
}

function getSelectedWaterBody(){
  return (STATE.waterBodies || []).find(w=>w.id===selectedWaterBodyId) || null;
}

function syncWaterSelect(){
  const sel = $('waterSelect');
  if(!sel) return;
  const list = STATE.waterBodies || [];
  sel.innerHTML = list.map(w=>`<option value="${escapeHtml(w.id)}">${escapeHtml(w.title || w.id)}</option>`).join('');
  sel.disabled = list.length === 0;
  if(selectedWaterBodyId && list.some(w=>w.id===selectedWaterBodyId)) sel.value = selectedWaterBodyId;
  else selectedWaterBodyId = null;
}

function syncWaterEditor(){
  waterEditorDirty = false;
  const body = getSelectedWaterBody();
  const ids = ['waterSelect','waterShape','waterX','waterY','waterZ','waterW','waterD','waterH','waterLevel','waterColor','waterOpacity','waterWave','waterCausticStrength','waterInterferenceStrength','waterMotionDistortion','waterSplash','waterContainerColor','waterContainerRepeatX','waterContainerRepeatY','importWaterContainerTexture','clearWaterContainerTexture','applyWaterValues','deleteSelectedWaterBody'];
  for(const id of ids) if($(id)) $(id).disabled = !body && !['waterSelect'].includes(id);
  if(!body){
    for(const id of ['waterX','waterY','waterZ','waterW','waterD','waterH','waterCausticStrength','waterInterferenceStrength','waterMotionDistortion']) if($(id)) $(id).value='';
    return;
  }
  if($('waterSelect')) $('waterSelect').value = body.id;
  $('waterShape').value = body.shape || 'rect';
  $('waterX').value = Number(safeFinite(body.position?.x,0)).toFixed(2);
  $('waterY').value = Number(safeFinite(body.position?.y,0)).toFixed(2);
  $('waterZ').value = Number(safeFinite(body.position?.z,0)).toFixed(2);
  $('waterW').value = Number(safeFinite(body.size?.w,4)).toFixed(2);
  $('waterD').value = Number(safeFinite(body.size?.d,2)).toFixed(2);
  $('waterH').value = Number(safeFinite(body.size?.h,.72)).toFixed(2);
  $('waterLevel').value = clamp(safeFinite(body.water?.level,.72),.05,.98);
  $('waterColor').value = validColor(body.water?.color) ? body.water.color : '#4bbcff';
  $('waterOpacity').value = clamp(safeFinite(body.water?.opacity,.55),.05,.95);
  $('waterWave').value = clamp(safeFinite(body.water?.wave,.45),0,1);
  if($('waterCausticStrength')) $('waterCausticStrength').value = clamp(safeFinite(body.water?.causticStrength,1),0,3);
  if($('waterInterferenceStrength')) $('waterInterferenceStrength').value = clamp(safeFinite(body.water?.interferenceStrength,1),0,3);
  if($('waterMotionDistortion')) $('waterMotionDistortion').value = clamp(safeFinite(body.water?.motionDistortion,1),0,3);
  $('waterSplash').value = clamp(safeFinite(body.water?.splash,.65),0,1);
  const cm = body.containerMaterial || {};
  if($('waterContainerColor')) $('waterContainerColor').value = validColor(cm.color) ? cm.color : '#50545a';
  const rep = Array.isArray(cm.repeat) ? cm.repeat : [1,1];
  if($('waterContainerRepeatX')) $('waterContainerRepeatX').value = clamp(safeFinite(rep[0],1),.2,24);
  if($('waterContainerRepeatY')) $('waterContainerRepeatY').value = clamp(safeFinite(rep[1],1),.2,24);
}

function readWaterNumber(id, fallback, min, max){
  return clamp(safeFinite($(id)?.value, fallback), min, max);
}

function updateWaterFromEditor(){
  if(updateMultiWaterBodiesFromEditor()) return;
  const body = getSelectedWaterBody();
  if(!body) return;
  body.shape = ['rect','cylinder','oval'].includes($('waterShape')?.value) ? $('waterShape').value : 'rect';
  body.position.x = readWaterNumber('waterX', body.position?.x || 0, -500, 500);
  body.position.y = readWaterNumber('waterY', body.position?.y || 0, -500, 500);
  body.position.z = readWaterNumber('waterZ', body.position?.z || 0, -500, 500);
  body.size.w = readWaterNumber('waterW', body.size?.w || 4, .2, 500);
  body.size.d = readWaterNumber('waterD', body.size?.d || 2, .2, 500);
  body.size.h = readWaterNumber('waterH', body.size?.h || .72, .05, 500);
  body.water = body.water || {};
  body.water.level = readWaterNumber('waterLevel', body.water.level ?? .72, .05, .98);
  body.water.color = validColor($('waterColor')?.value) ? $('waterColor').value : '#4bbcff';
  body.water.opacity = readWaterNumber('waterOpacity', body.water.opacity ?? .55, .05, .95);
  body.water.wave = readWaterNumber('waterWave', body.water.wave ?? .45, 0, 1);
  body.water.causticStrength = readWaterNumber('waterCausticStrength', body.water.causticStrength ?? 1, 0, 3);
  body.water.interferenceStrength = readWaterNumber('waterInterferenceStrength', body.water.interferenceStrength ?? 1, 0, 3);
  body.water.motionDistortion = readWaterNumber('waterMotionDistortion', body.water.motionDistortion ?? 1, 0, 3);
  body.water.splash = readWaterNumber('waterSplash', body.water.splash ?? .65, 0, 1);
  body.containerMaterial = body.containerMaterial || {color:'#50545a',roughness:.82,metalness:.05,texture:null,repeat:[1,1]};
  body.containerMaterial.color = validColor($('waterContainerColor')?.value) ? $('waterContainerColor').value : (validColor(body.containerMaterial.color) ? body.containerMaterial.color : '#50545a');
  body.containerMaterial.repeat = [
    readWaterNumber('waterContainerRepeatX', body.containerMaterial.repeat?.[0] ?? 1, .2, 24),
    readWaterNumber('waterContainerRepeatY', body.containerMaterial.repeat?.[1] ?? 1, .2, 24)
  ];
  buildWaterBodies();
  syncWaterEditor();
  scheduleSave();
}

function bindWaterControls(){
  if($('addWaterBodyAhead') && !$('addWaterBodyAhead').dataset.bound){
    $('addWaterBodyAhead').dataset.bound='1';
    $('addWaterBodyAhead').addEventListener('click', addWaterBodyAhead);
  }
  if($('deleteSelectedWaterBody') && !$('deleteSelectedWaterBody').dataset.bound){
    $('deleteSelectedWaterBody').dataset.bound='1';
    $('deleteSelectedWaterBody').addEventListener('click', deleteSelectedWaterBody);
  }
  if($('applyWaterValues') && !$('applyWaterValues').dataset.bound){
    $('applyWaterValues').dataset.bound='1';
    $('applyWaterValues').addEventListener('click', updateWaterFromEditor);
  }
  if($('waterSelect') && !$('waterSelect').dataset.bound){
    $('waterSelect').dataset.bound='1';
    $('waterSelect').addEventListener('change', e=>selectWaterBody(e.target.value));
  }
  for(const id of ['waterShape','waterLevel','waterColor','waterOpacity','waterWave','waterCausticStrength','waterInterferenceStrength','waterMotionDistortion','waterSplash','waterContainerColor','waterContainerRepeatX','waterContainerRepeatY']){
    const el = $(id); if(!el || el.dataset.bound) continue;
    el.dataset.bound='1';
    el.addEventListener('input', ()=>{ if(getSelectedWaterBody()) updateWaterFromEditor(); });
  }
  if($('importWaterContainerTexture') && !$('importWaterContainerTexture').dataset.bound){
    $('importWaterContainerTexture').dataset.bound='1';
    $('importWaterContainerTexture').addEventListener('click', ()=>{
      if(!getSelectedWaterBody()){ setStatus('請先選取一個水體。'); return; }
      $('waterContainerTextureInput')?.click();
    });
  }
  if($('waterContainerTextureInput') && !$('waterContainerTextureInput').dataset.bound){
    $('waterContainerTextureInput').dataset.bound='1';
    $('waterContainerTextureInput').addEventListener('change', async e=>{
      const file = e.target.files?.[0];
      const body = getSelectedWaterBody();
      if(!file || !body){ e.target.value=''; return; }
      body.containerMaterial = body.containerMaterial || {color:'#50545a',roughness:.82,metalness:.05,texture:null,repeat:[1,1]};
      body.containerMaterial.texture = await readAsDataURL(file);
      buildWaterBodies();
      syncWaterEditor();
      scheduleSave();
      setStatus(`已將材質置入水體容器：${body.title || '水體'}｜${file.name}`);
      e.target.value='';
    });
  }
  if($('clearWaterContainerTexture') && !$('clearWaterContainerTexture').dataset.bound){
    $('clearWaterContainerTexture').dataset.bound='1';
    $('clearWaterContainerTexture').addEventListener('click', ()=>{
      const body = getSelectedWaterBody();
      if(!body){ setStatus('請先選取一個水體。'); return; }
      body.containerMaterial = body.containerMaterial || {color:'#50545a',roughness:.82,metalness:.05,texture:null,repeat:[1,1]};
      body.containerMaterial.texture = null;
      buildWaterBodies();
      syncWaterEditor();
      scheduleSave();
      setStatus(`已清除水體容器貼圖：${body.title || '水體'}`);
    });
  }
  for(const id of ['waterX','waterY','waterZ','waterW','waterD','waterH']){
    const el = $(id); if(!el || el.dataset.bound) continue;
    el.dataset.bound='1';
    el.addEventListener('input', ()=>{ waterEditorDirty = true; });
    el.addEventListener('keydown', e=>{ if(e.code==='Enter'){ e.preventDefault(); updateWaterFromEditor(); } });
    el.addEventListener('wheel', e=>e.preventDefault(), {passive:false});
  }
}


function isWaterBodyBeingCarried(body){
  return !!(body && (body.isDraft || (pendingWaterBodyId && waterBodyFollowPlayer && body.id === pendingWaterBodyId)));
}

function waterLocalPoint(body, world){
  return new THREE.Vector3(world.x - safeFinite(body.position?.x,0), world.y - safeFinite(body.position?.y,0), world.z - safeFinite(body.position?.z,0));
}

function waterBodyMetrics(body){
  const h = clamp(safeFinite(body?.size?.h,.72),.05,500);
  const baseY = safeFinite(body?.position?.y,0);
  const surfaceY = baseY + clamp(safeFinite(body?.water?.level,.72),.05,.98) * h;
  return {h, baseY, surfaceY, depth:Math.max(0, surfaceY - baseY)};
}

function isPointInsideWaterFootprint(body, world){
  if(!body || body.visible === false) return false;
  const p = waterLocalPoint(body, world);
  const w = clamp(safeFinite(body.size?.w,4),.2,500);
  const d = clamp(safeFinite(body.size?.d,2),.2,500);
  if(body.shape === 'cylinder' || body.shape === 'oval'){
    const nx = p.x / Math.max(.001, w/2);
    const nz = p.z / Math.max(.001, d/2);
    return nx*nx + nz*nz <= 1;
  }
  return Math.abs(p.x) <= w/2 && Math.abs(p.z) <= d/2;
}

function getPlayerWaterState(){
  if(!isSinTowerStairSceneActive()) return {inside:false, body:null, baseY:0, surfaceY:-Infinity, depth:0, footDepth:0, headDepth:-Infinity, headSubmerged:false, swimming:false, wading:false};
  const feet = player.position.clone();
  const headY = feet.y + player.height;
  let best = null;
  for(const body of (STATE.waterBodies || [])){
    // 正在新增／攜帶的水體屬於編輯物件，不應讓主角進入游泳或浮力狀態；否則拖著水體走會被自己攜帶的水包住。
    if(isWaterBodyBeingCarried(body)) continue;
    if(!isPointInsideWaterFootprint(body, feet)) continue;
    const m = waterBodyMetrics(body);
    if(feet.y > m.surfaceY + .55 || headY < m.baseY - .2) continue;
    const footDepth = m.surfaceY - feet.y;
    const headDepth = m.surfaceY - headY;
    const deepEnoughToSwim = m.depth > player.height * .92;
    const swimming = deepEnoughToSwim && feet.y < m.surfaceY - .18 && footDepth > player.height * .18;
    const state = {
      inside:true,
      body,
      baseY:m.baseY,
      surfaceY:m.surfaceY,
      depth:m.depth,
      footDepth,
      headDepth,
      headSubmerged:headDepth > .02,
      swimming,
      wading:footDepth > .04 && !swimming
    };
    if(!best || footDepth > best.footDepth) best = state;
  }
  return best || {inside:false, body:null, baseY:0, surfaceY:-Infinity, depth:0, footDepth:0, headDepth:-Infinity, headSubmerged:false, swimming:false, wading:false};
}

function isPlayerInsideWater(body){
  if(!body || body.visible === false || isWaterBodyBeingCarried(body)) return false;
  if(!isPointInsideWaterFootprint(body, player.position)) return false;
  const m = waterBodyMetrics(body);
  return player.position.y <= m.surfaceY + .35 && player.position.y + player.height >= m.baseY - .2;
}

function triggerWaterRipple(body, strengthScale=1, options={}){
  if(!body) return;
  const mats = [waterRuntime.materials.get(body.id), waterRuntime.materials.get(`${body.id}:caustic`)].filter(Boolean);
  if(!mats.length) return;
  const opts = options && typeof options === 'object' ? options : {};
  const local = waterRippleLocalPoint(body, player.position);
  const splash = clamp(safeFinite(body.water?.splash,.85),0,1);
  for(const mat of mats){
    const u = mat.userData?.waterUniforms;
    if(!u) continue;
    if(u.uRippleCenter) u.uRippleCenter.value.copy(local);
    if(u.uRippleAge) u.uRippleAge.value = 0;
    if(u.uRippleStrength) u.uRippleStrength.value = clamp(splash * strengthScale,0,1.85);
  }
  const m = waterBodyMetrics(body);
  const y = m.surfaceY + .045;
  const pos = new THREE.Vector3(player.position.x, y, player.position.z);
  if(opts.splash === false){
    if(opts.foam !== false) spawnWaterFoamRing(pos, body, strengthScale * .62);
  }else{
    spawnWaterSplash(pos, body, strengthScale);
  }
}

function waterBoundaryDistance(body, world){
  if(!body) return 0;
  const p = waterLocalPoint(body, world);
  const w = clamp(safeFinite(body.size?.w,4),.2,500);
  const d = clamp(safeFinite(body.size?.d,2),.2,500);
  const t = clamp(safeFinite(body.size?.t,.12),.02,Math.min(w,d)/2);
  if(body.shape === 'cylinder' || body.shape === 'oval'){
    const a = Math.max(.025, w/2 - t);
    const b = Math.max(.025, d/2 - t);
    const angle = Math.atan2(p.z, p.x);
    const ca = Math.cos(angle), sa = Math.sin(angle);
    const radiusToEdge = 1 / Math.sqrt((ca*ca)/(a*a) + (sa*sa)/(b*b));
    const r = Math.sqrt(p.x*p.x + p.z*p.z);
    return Math.max(0, radiusToEdge - r);
  }
  return Math.max(0, Math.min(w/2 - t - Math.abs(p.x), d/2 - t - Math.abs(p.z)));
}

function waterRippleLocalPoint(body, world){
  const p = waterLocalPoint(body, world);
  const w = clamp(safeFinite(body.size?.w,4),.2,500);
  const d = clamp(safeFinite(body.size?.d,2),.2,500);
  const t = clamp(safeFinite(body.size?.t,.12),.02,Math.min(w,d)/2);
  if(body.shape === 'cylinder' || body.shape === 'oval'){
    const r = Math.max(.1, Math.min(w,d)/2);
    const innerR = Math.max(.05, r-t);
    const sx = (w-t*2)/(2*innerR);
    const sy = (d-t*2)/(2*innerR);
    return new THREE.Vector2(p.x/Math.max(.001,sx), -p.z/Math.max(.001,sy));
  }
  return new THREE.Vector2(p.x, -p.z);
}

function spawnWaterFoamRing(pos, body, strength=1){
  const splash = clamp(safeFinite(body.water?.splash,.85),0,1) * strength;
  if(splash <= .02) return;
  if(!sharedSplashRingGeometry) sharedSplashRingGeometry = new THREE.RingGeometry(.16,.22,40);
  const color = validColor(body.water?.color) ? body.water.color : '#4bbcff';
  const mat = new THREE.MeshBasicMaterial({color, transparent:true, opacity:clamp(.28 + splash*.18,.18,.55), depthWrite:false, side:THREE.DoubleSide, toneMapped:false});
  const ring = new THREE.Mesh(sharedSplashRingGeometry, mat);
  ring.position.copy(pos);
  ring.rotation.x = -Math.PI/2;
  const desiredScale = THREE.MathUtils.lerp(.9,2.8,clamp(splash,0,1));
  const edgeLimit = Math.max(.08, waterBoundaryDistance(body, pos) * .92);
  const maxScale = Math.max(.22, edgeLimit / .22);
  ring.scale.setScalar(Math.min(desiredScale, maxScale));
  ring.renderOrder = 25;
  waterGroup.add(ring);
  waterRuntime.particles.push({mesh:ring, vel:new THREE.Vector3(0,0,0), life:0, maxLife:THREE.MathUtils.lerp(.42,.9,clamp(splash,0,1)), ring:true, startScale:ring.scale.x, maxScale});
}

function spawnWaterSplash(pos, body, strengthScale=1){
  const splash = clamp(safeFinite(body.water?.splash,.85),0,1) * strengthScale;
  if(splash <= .02) return;
  if(!sharedSplashGeometry) sharedSplashGeometry = new THREE.SphereGeometry(.026,7,5);
  const color = validColor(body.water?.color) ? body.water.color : '#4bbcff';
  spawnWaterFoamRing(pos, body, strengthScale);
  const count = Math.round(THREE.MathUtils.lerp(18,86,clamp(splash,0,1)));
  for(let i=0;i<count;i++){
    if(waterRuntime.particles.length > 560){
      const old = waterRuntime.particles.shift();
      old?.mesh?.parent?.remove(old.mesh);
      old?.mesh?.material?.dispose?.();
    }
    const mat = new THREE.MeshBasicMaterial({color, transparent:true, opacity:THREE.MathUtils.lerp(.58,.92,Math.random()), depthWrite:false, toneMapped:false});
    const mesh = new THREE.Mesh(sharedSplashGeometry, mat);
    mesh.position.copy(pos);
    const a = Math.random()*Math.PI*2;
    const outward = THREE.MathUtils.lerp(.42,2.6,Math.random()) * (0.65 + splash*.95);
    const upward = THREE.MathUtils.lerp(.85,3.8,Math.pow(Math.random(),.55)) * (0.5 + splash*.85);
    const vel = new THREE.Vector3(Math.cos(a)*outward, upward, Math.sin(a)*outward);
    mesh.scale.setScalar(THREE.MathUtils.lerp(.55,1.55,Math.random()) * (0.85 + splash*.5));
    waterGroup.add(mesh);
    waterRuntime.particles.push({mesh, vel, life:0, maxLife:THREE.MathUtils.lerp(.42,1.15,Math.random()), bodyId:body.id});
  }
}

function applyWaterMotionCausticDistortion(body, strength){
  if(!body || strength <= 0) return;
  const local = waterRippleLocalPoint(body, player.position);
  const mats = [waterRuntime.materials.get(body.id), waterRuntime.materials.get(`${body.id}:caustic`)].filter(Boolean);
  for(const mat of mats){
    const u = mat.userData?.waterUniforms;
    if(!u) continue;
    if(u.uMotionCenter) u.uMotionCenter.value.copy(local);
    if(u.uMotionStrength) u.uMotionStrength.value = Math.max(u.uMotionStrength.value || 0, strength);
  }
}

function updateWaterEffects(dt){
  for(const [id, mat] of waterRuntime.materials.entries()){
    const u = mat.userData?.waterUniforms;
    if(!u) continue;
    u.uTime.value += dt;
    if(u.uRippleAge) u.uRippleAge.value += dt;
    if(u.uRippleStrength) u.uRippleStrength.value *= Math.pow(.22, dt);
    if(u.uMotionStrength) u.uMotionStrength.value *= Math.pow(.10, dt);
  }
  const moving = movementVector().forward !== 0 || movementVector().strafe !== 0;
  const movedDistance = waterRuntime.hasLastPlayer ? waterRuntime.lastPlayerPos.distanceTo(player.position) : 0;
  const playerSurfaceSpeed = dt > 0 ? movedDistance / Math.max(dt, 0.001) : 0;
  const now = performance.now();
  const state = getPlayerWaterState();
  waterRuntime.current = state;
  waterRuntime.inside = !!state.inside;
  waterRuntime.swimming = !!state.swimming;
  waterRuntime.wading = !!state.wading;
  if(state.inside && state.body){
    const splash = clamp(safeFinite(state.body.water?.splash,.85),0,1);
    const motionDistortion = clamp(safeFinite(state.body.water?.motionDistortion,1),0,3);
    const movingEnergy = moving ? clamp(playerSurfaceSpeed / 5.2, 0, 1.45) : 0;
    const surfaceFactor = state.headSubmerged ? .22 : 1.0;
    const swimFactor = state.swimming ? .78 : 1.0;
    const gridDisturbance = clamp((movingEnergy * 1.18 + (state.wading ? .10 : 0.0)) * motionDistortion * surfaceFactor * swimFactor, 0, 3);
    if(gridDisturbance > .001) applyWaterMotionCausticDistortion(state.body, gridDisturbance);
    const gap = state.swimming
      ? THREE.MathUtils.lerp(260,70,splash)
      : THREE.MathUtils.lerp(360,95,splash);
    const last = waterRuntime.lastSplashAt.get(state.body.id) || 0;
    if(moving && now - last > gap){
      waterRuntime.lastSplashAt.set(state.body.id, now);
      // 角色頭部已在水面下時，不應在水面上憑空產生水花或泡沫；只保留水中移動阻尼與游泳動作。
      if(!state.headSubmerged) triggerWaterRipple(state.body, state.swimming ? 1.18 : 1.05);
    }
    // 踏水狀態：即使沒有位移，水面仍應持續向外擴散小波紋，但不噴出垂直水花。
    const treading = state.swimming && !state.headSubmerged && !moving;
    if(treading){
      const treadKey = `${state.body.id}:tread`;
      const treadLast = waterRuntime.lastSplashAt.get(treadKey) || 0;
      const treadGap = THREE.MathUtils.lerp(680,260,splash);
      if(now - treadLast > treadGap){
        waterRuntime.lastSplashAt.set(treadKey, now);
        triggerWaterRipple(state.body, .46, {splash:false, foam:true});
      }
    }
  }
  waterRuntime.lastPlayerPos.copy(player.position);
  waterRuntime.hasLastPlayer = true;
  for(let i=waterRuntime.particles.length-1;i>=0;i--){
    const p = waterRuntime.particles[i];
    p.life += dt;
    if(p.ring){
      const k = 1 - p.life / p.maxLife;
      const grow = p.startScale * (1 + (1-k)*2.8);
      p.mesh.scale.setScalar(Math.min(grow, p.maxScale || grow));
      if(p.mesh.material) p.mesh.material.opacity = Math.max(0,k*.42);
    }else{
      p.vel.y -= 4.9*dt;
      p.vel.multiplyScalar(Math.pow(.76,dt));
      p.mesh.position.addScaledVector(p.vel, dt);
      if(p.bodyId){
        const body = (STATE.waterBodies || []).find(w=>w.id===p.bodyId);
        if(body && !isPointInsideWaterFootprint(body, p.mesh.position)){
          const c = new THREE.Vector3(safeFinite(body.position?.x,0), p.mesh.position.y, safeFinite(body.position?.z,0));
          const inward = c.sub(p.mesh.position); inward.y = 0;
          if(inward.lengthSq() > .0001) inward.normalize();
          p.mesh.position.addScaledVector(inward, Math.min(.18, Math.max(.04, p.vel.length()*dt)));
          p.vel.x *= -.22; p.vel.z *= -.22;
        }
      }
      const k = 1 - p.life / p.maxLife;
      if(p.mesh.material) p.mesh.material.opacity = Math.max(0,k*.82);
    }
    if(p.life >= p.maxLife){
      p.mesh.parent?.remove(p.mesh);
      p.mesh.material?.dispose?.();
      waterRuntime.particles.splice(i,1);
    }
  }
}

function findActorSwimBones(){
  if(!actorModel) return null;
  if(swimBoneCache?.model === actorModel) return swimBoneCache;
  const bones = [];
  actorModel.traverse(o=>{ if(o.isBone) bones.push(o); });
  const find = patterns => bones.find(b=>patterns.some(p=>String(b.name||'').toLowerCase().includes(p))) || null;
  swimBoneCache = {
    model:actorModel,
    leftUpper:find(['leftarm','left_arm','l_arm','leftshoulder','left_shoulder']),
    rightUpper:find(['rightarm','right_arm','r_arm','rightshoulder','right_shoulder']),
    leftFore:find(['leftforearm','left_forearm','l_forearm','leftlowerarm']),
    rightFore:find(['rightforearm','right_forearm','r_forearm','rightlowerarm']),
    leftHand:find(['lefthand','left_hand','l_hand']),
    rightHand:find(['righthand','right_hand','r_hand'])
  };
  return swimBoneCache;
}

function applySwimArmMotion(dt){
  const state = waterRuntime.current || getPlayerWaterState();
  if(!state.swimming) return;
  const moving = movementVector().forward !== 0 || movementVector().strafe !== 0 || Math.abs(playerVelocityY) > .05;
  swimStrokePhase += dt * (moving ? 7.5 : 3.8);
  if(performance.now() > manualActionUntil) playAction(moving ? 'walk' : 'idle');
  const cache = findActorSwimBones();
  if(cache?.leftUpper && cache?.rightUpper){
    const s = Math.sin(swimStrokePhase);
    const c = Math.cos(swimStrokePhase);
    cache.leftUpper.rotation.x += -0.55 + c*.42;
    cache.rightUpper.rotation.x += -0.55 - c*.42;
    cache.leftUpper.rotation.z += .58*s;
    cache.rightUpper.rotation.z += -.58*s;
    if(cache.leftFore) cache.leftFore.rotation.x += -.38 + Math.sin(swimStrokePhase + 1.4)*.32;
    if(cache.rightFore) cache.rightFore.rotation.x += -.38 + Math.sin(swimStrokePhase + Math.PI + 1.4)*.32;
    if(cache.leftHand) cache.leftHand.rotation.z += .22*s;
    if(cache.rightHand) cache.rightHand.rotation.z += -.22*s;
  }else if(actorProxy){
    actorProxy.rotation.z = Math.sin(swimStrokePhase)*.035;
    actorProxy.rotation.x = Math.cos(swimStrokePhase*.8)*.035;
  }
}

function buildArtworks(){
  disableBakedLightingRuntime();
  artworkGroup.clear();
  artworkMeshes = {};
  const loader = new THREE.TextureLoader();
  for(const art of STATE.artworks){
    const group = createArtworkGroup(art, loader);
    artworkGroup.add(group);
    artworkMeshes[art.id] = group;
    placeArtwork(art);
    applyArtworkVisualState(group, selectedArtworkActive && selectedArtworkId===art.id, !!art.isDraft);
  }
  syncArtSelect();
  refreshArtworkSelectionVisuals();
  applyObjectVisibilityLocks();
  renderObjectPanel();
}


function fitImageArtworkToNaturalAspect(art, image, {force=false}={}){
  if(!art || art.type === 'model' || !image?.width || !image?.height) return false;
  const aspect = clamp(image.width / Math.max(1, image.height), .01, 1000);
  art.naturalAspect = aspect;
  if(art.preserveAspect === false) return false;
  art.size = art.size || {w:3,h:3,d:1};
  const currentW = Math.max(.01, safeFinite(art.size.w, 3));
  const currentH = Math.max(.01, safeFinite(art.size.h, 3));
  const currentAspect = currentW / currentH;
  if(!force && Math.abs(currentAspect - aspect) < .01) return false;
  const baseH = clamp(currentH, .01, 500);
  art.size.h = baseH;
  art.size.w = clamp(baseH * aspect, .01, 500);
  art.size.d = clamp(safeFinite(art.size.d, 1), .01, 500);
  return true;
}

function getArtworkReliefConfig(art){
  return getReliefConfigForMaterial(ensureArtworkSurfaceMaterial(art));
}

function artworkReliefEnabled(art){
  return art?.type !== 'model' && reliefEnabledForMaterial(ensureArtworkSurfaceMaterial(art));
}

function createArtworkFrontGeometry(art){
  // 圖片作品的正面維持單一乾淨平面。
  // 原本把作品本體也做成 relief volume，斜向光照時會讀到規律三角網格，形成條狀／波紋狀陰影。
  // 凹凸若需要只交給材質 bump，以避免作品圖像本身被光照切出假條紋。
  return new THREE.PlaneGeometry(1,1,1,1);
}
function createArtworkBackGeometry(){
  return new THREE.PlaneGeometry(1,1,1,1);
}

function applyArtworkImageMaterialSettings(mat, art, side=THREE.DoubleSide){
  if(!mat) return null;
  const surface = ensureArtworkSurfaceMaterial(art);
  mat.color = new THREE.Color(surface.color || '#ffffff');
  mat.roughness = clamp(safeFinite(surface.roughness,.72),0,1);
  mat.metalness = clamp(safeFinite(surface.metalness,0),0,1);
  mat.side = side;
  mat.shadowSide = side;
  mat.polygonOffset = false;
  mat.polygonOffsetFactor = 0;
  mat.polygonOffsetUnits = 0;
  mat.alphaTest = art.transparent!==false ? .035 : 0;
  mat.transparent = false;
  mat.depthWrite = true;
  mat.depthTest = true;
  if(artworkReliefEnabled(art)){
    const bump = createReferenceReliefBumpTexture(surface);
    const cfg = getReliefConfigForMaterial(surface);
    const preset = GROUND_RELIEF_PRESETS[cfg.preset] || GROUND_RELIEF_PRESETS.flat;
    mat.bumpMap = bump;
    mat.bumpScale = bump ? (.006 + preset.amp * .16) * cfg.amount : 0;
  }else{
    mat.bumpMap = null;
    mat.bumpScale = 0;
  }
  mat.needsUpdate = true;
  return mat;
}

function makeArtworkImageMaterial(tex, art, side=THREE.DoubleSide){
  const surface = ensureArtworkSurfaceMaterial(art);
  const mat = new THREE.MeshStandardMaterial({
    color: new THREE.Color(surface.color || '#ffffff'),
    map: tex,
    roughness: clamp(safeFinite(surface.roughness,.72),0,1),
    metalness: clamp(safeFinite(surface.metalness,0),0,1),
    transparent:false,
    alphaTest: art.transparent!==false ? .035 : 0,
    side,
    depthWrite:true,
    depthTest:true,
    polygonOffset:false,
    polygonOffsetFactor:0,
    polygonOffsetUnits:0
  });
  mat.userData.baseTransparent = false;
  mat.userData.baseOpacity = 1;
  if(tex){
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.needsUpdate = true;
  }
  applyArtworkImageMaterialSettings(mat, art, side);
  return mat;
}

function refreshImageArtworkSurface(art){
  if(!art || art.type === 'model') return;
  const group = artworkMeshes?.[art.id];
  if(!group) return;
  const front = group.children.find(o=>o.userData?.isArtworkFront) || group.getObjectByName(`${art.title}_front`);
  const back = group.children.find(o=>o.userData?.isArtworkBack) || group.getObjectByName(`${art.title}_back`);
  const sourceTex = front?.material?.map || back?.material?.userData?.sourceTexture || null;
  if(front){
    front.geometry?.dispose?.();
    front.geometry = createArtworkFrontGeometry(art);
    applyArtworkImageMaterialSettings(front.material, art, THREE.FrontSide);
    // 圖片作品不接收／投射陰影，避免透明邊界與深度偏移在聚光或平行光下形成條狀 shadow acne。
    front.castShadow = false;
    front.receiveShadow = false;
  }
  if(back){
    back.geometry?.dispose?.();
    back.geometry = createArtworkBackGeometry();
    const oldMat = back.material;
    const oldMap = oldMat?.map;
    back.material = makeArtworkBackMaterial(sourceTex, art);
    if(oldMap && oldMat?.userData?.solidBackTexture) oldMap.dispose?.();
    oldMat?.dispose?.();
    back.castShadow = false;
    back.receiveShadow = false;
  }
  rebuildArtworkDepth(group, art, sourceTex?.image || front?.material?.map?.image || back?.material?.map?.image || null);
  applyArtworkVisualState(group, selectedArtworkActive && selectedArtworkId===art.id, !!art.isDraft);
}
function createArtworkGroup(art, loader){
  const group = new THREE.Group();
  group.name = art.title;
  group.userData.artId = art.id;
  group.userData.isArtwork = true;
  if(art.type === 'model'){
    const placeholder = new THREE.Mesh(
      new THREE.BoxGeometry(1,1,1),
      new THREE.MeshBasicMaterial({color:'#bdbdbd', toneMapped:false})
    );
    placeholder.name = `${art.title}_loading_placeholder`;
    placeholder.position.y = .5;
    placeholder.castShadow = true;
    placeholder.receiveShadow = true;
    placeholder.userData.artId = art.id;
    group.add(placeholder);
    loadArtworkModel(art, group);
    return group;
  }
  const tex = loader.load(art.src, texture=>{
    texture.colorSpace = THREE.SRGBColorSpace;
    texture.anisotropy = Math.min(renderer.capabilities.getMaxAnisotropy?.() || 1, 8);
    const fitted = fitImageArtworkToNaturalAspect(art, texture.image, {force:!art.naturalAspect});
    if(fitted){
      placeArtwork(art);
      syncArtEditor();
    }
    if(fitted) scheduleSave();
    refreshImageArtworkSurface(art);
  }, undefined, err=>console.warn('art texture failed', art.title, err));
  tex.colorSpace = THREE.SRGBColorSpace;
  const frontMat = makeArtworkImageMaterial(tex, art, THREE.FrontSide);
  const front = new THREE.Mesh(createArtworkFrontGeometry(art), frontMat);
  front.name = `${art.title}_front`;
  front.renderOrder = 30;
  front.castShadow = false;
  front.receiveShadow = false;
  front.userData.artId = art.id;
  front.userData.isArtworkFront = true;
  group.add(front);
  const backMat = makeArtworkBackMaterial(tex, art);
  const back = new THREE.Mesh(createArtworkBackGeometry(), backMat);
  back.name = `${art.title}_back`;
  back.position.z = -Math.max(.01, safeFinite(art.depth,.10));
  back.renderOrder = 28;
  back.castShadow = false;
  back.receiveShadow = false;
  back.userData.artId = art.id;
  back.userData.isArtworkBack = true;
  group.add(back);
  return group;
}

function normalizeArtworkModel(root){
  root.updateMatrixWorld(true);
  const box = new THREE.Box3().setFromObject(root);
  const size = new THREE.Vector3();
  const center = new THREE.Vector3();
  box.getSize(size);
  box.getCenter(center);
  const maxSide = Math.max(size.x, size.y, size.z) || 1;
  const scale = 1 / maxSide;
  root.scale.setScalar(scale);
  root.position.set(-center.x * scale, -box.min.y * scale, -center.z * scale);
}

function makeUnlitArtworkMaterial(source){
  if(source?.userData?.isArtworkLitMaterial){
    return source;
  }
  const mat = new THREE.MeshStandardMaterial({
    color: source?.color ? source.color.clone() : new THREE.Color(0xffffff),
    map: source?.map || null,
    alphaMap: source?.alphaMap || null,
    normalMap: source?.normalMap || null,
    roughnessMap: source?.roughnessMap || null,
    metalnessMap: source?.metalnessMap || null,
    aoMap: source?.aoMap || null,
    emissiveMap: source?.emissiveMap || null,
    emissive: source?.emissive ? source.emissive.clone() : new THREE.Color(0x000000),
    roughness: clamp(safeFinite(source?.roughness, .72), 0, 1),
    metalness: clamp(safeFinite(source?.metalness, 0), 0, 1),
    transparent: !!source?.transparent || safeFinite(source?.opacity,1) < 1,
    opacity: safeFinite(source?.opacity,1),
    side: source?.side ?? THREE.DoubleSide,
    alphaTest: safeFinite(source?.alphaTest,0),
    depthWrite: source?.depthWrite ?? true,
    depthTest: source?.depthTest ?? true
  });
  mat.name = source?.name ? `${source.name}_gallery_lit` : 'artwork_gallery_lit';
  mat.userData.isArtworkLitMaterial = true;
  mat.userData.baseTransparent = !!mat.transparent;
  mat.userData.baseOpacity = safeFinite(mat.opacity,1);
  mat.shadowSide = THREE.DoubleSide;
  for(const tex of [mat.map, mat.alphaMap, mat.normalMap, mat.roughnessMap, mat.metalnessMap, mat.aoMap, mat.emissiveMap]){
    if(tex) tex.needsUpdate = true;
  }
  if(mat.map){
    mat.map.colorSpace = THREE.SRGBColorSpace;
    mat.map.needsUpdate = true;
  }
  mat.needsUpdate = true;
  return mat;
}

function isArtworkEmbeddedLight(obj){
  if(!obj) return false;
  if(obj.isLight) return true;
  return /Light$/.test(String(obj.type || '')) ||
    obj.isPointLight || obj.isDirectionalLight || obj.isSpotLight ||
    obj.isHemisphereLight || obj.isRectAreaLight || obj.isLightProbe;
}

function removeEmbeddedLightsFromArtworkModel(root){
  if(!root) return 0;
  const embeddedLights = [];
  root.traverse(obj=>{
    if(!isArtworkEmbeddedLight(obj)) return;
    obj.visible = false;
    if('intensity' in obj) obj.intensity = 0;
    if('power' in obj) obj.power = 0;
    obj.castShadow = false;
    embeddedLights.push(obj);
  });
  for(const light of embeddedLights){
    if(light.parent){
      light.parent.remove(light);
    }
  }
  return embeddedLights.length;
}

function applyUnlitMaterialsToArtworkModel(root){
  if(!root) return;
  removeEmbeddedLightsFromArtworkModel(root);
  root.traverse(obj=>{
    if(!obj.isMesh) return;
    const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
    obj.material = Array.isArray(obj.material) ? mats.map(makeUnlitArtworkMaterial) : makeUnlitArtworkMaterial(mats[0]);
    obj.castShadow = true;
    obj.receiveShadow = true;
    obj.frustumCulled = false;
    obj.userData.galleryLitArtwork = true;
  });
}

function isolateModelArtworkLighting(group){
  if(!group) return;
  removeEmbeddedLightsFromArtworkModel(group);
  applyUnlitMaterialsToArtworkModel(group);
}

function loadArtworkModel(art, group){
  const format = String(art.format || '').toLowerCase();
  const onLoaded = root=>{
    for(const child of [...group.children]){
      child.geometry?.dispose?.();
      if(child.material){
        const mats = Array.isArray(child.material) ? child.material : [child.material];
        mats.forEach(m=>m?.dispose?.());
      }
      group.remove(child);
    }
    root.name = `${art.title}_model`;
    root.traverse(obj=>{
      obj.userData.artId = art.id;
    });
    removeEmbeddedLightsFromArtworkModel(root);
    applyUnlitMaterialsToArtworkModel(root);
    normalizeArtworkModel(root);
    group.add(root);
    isolateModelArtworkLighting(group);
    applyArtworkVisualState(group, selectedArtworkActive && selectedArtworkId===art.id, !!art.isDraft);
  };
  const onError = err=>{
    console.warn('model artwork failed', art.title, err);
    setStatus(`3D 作品載入失敗：${art.title}`);
  };
  if(format === 'fbx'){
    new FBXLoader().load(art.src, fbx=>onLoaded(fbx), undefined, onError);
  }else{
    new GLTFLoader().load(art.src, gltf=>onLoaded(gltf.scene || gltf.scenes?.[0]), undefined, onError);
  }
}

function applyArtworkVisualState(group, selected=false, draft=false){
  if(!group) return;
  const translucent = !!selected || !!draft;
  removeEmbeddedLightsFromArtworkModel(group);
  group.traverse(obj=>{
    if(isArtworkEmbeddedLight(obj)) return;
    const mats = obj.material ? (Array.isArray(obj.material) ? obj.material : [obj.material]) : [];
    for(const mat of mats){
      if(!mat) continue;
      if(mat.userData.baseTransparent === undefined) mat.userData.baseTransparent = !!mat.transparent;
      mat.transparent = translucent ? true : !!mat.userData.baseTransparent;
      mat.opacity = translucent ? .46 : 1;
      mat.depthWrite = !translucent;
      mat.needsUpdate = true;
    }
  });
}

function refreshArtworkSelectionVisuals(){
  for(const art of STATE.artworks || []){
    const group = artworkMeshes[art.id];
    applyArtworkVisualState(group, selectedArtworkActive && selectedArtworkId===art.id, !!art.isDraft);
  }
}


function hexToRgb01(hex){
  const value = /^#?[0-9a-fA-F]{6}$/.test(hex||'') ? String(hex).replace('#','') : 'ffffff';
  return [parseInt(value.slice(0,2),16)/255, parseInt(value.slice(2,4),16)/255, parseInt(value.slice(4,6),16)/255];
}

function tintedColorArray(baseColors, art){
  const strength = clamp(safeFinite(art.edgeTintStrength,0),0,1);
  const tint = hexToRgb01(art.edgeTintColor || '#ffffff');
  const mul = [1 + (tint[0]-1)*strength, 1 + (tint[1]-1)*strength, 1 + (tint[2]-1)*strength];
  const out = new Float32Array(baseColors.length);
  for(let i=0;i<baseColors.length;i+=3){
    out[i] = clamp(baseColors[i] * mul[0], 0, 1);
    out[i+1] = clamp(baseColors[i+1] * mul[1], 0, 1);
    out[i+2] = clamp(baseColors[i+2] * mul[2], 0, 1);
  }
  return out;
}

function applyArtworkEdgeTint(group, art){
  if(!group || !art) return;
  for(const name of ['edge-extrusion','edge-particles']){
    const obj = group.getObjectByName(name);
    const geo = obj?.geometry;
    const base = geo?.attributes?.baseColor;
    const color = geo?.attributes?.color;
    if(!base || !color) continue;
    const next = tintedColorArray(base.array, art);
    color.array.set(next);
    color.needsUpdate = true;
  }
}

function rgb01ToHex(c){
  const r = Math.round(clamp(c?.[0] ?? 1, 0, 1) * 255).toString(16).padStart(2,'0');
  const g = Math.round(clamp(c?.[1] ?? 1, 0, 1) * 255).toString(16).padStart(2,'0');
  const b = Math.round(clamp(c?.[2] ?? 1, 0, 1) * 255).toString(16).padStart(2,'0');
  return `#${r}${g}${b}`;
}

function dominantArtworkColorFromImage(image){
  if(!image || !image.width || !image.height) return '#ffffff';
  const maxSide = 144;
  const scale = Math.min(1, maxSide / Math.max(image.width, image.height));
  const w = Math.max(1, Math.round(image.width * scale));
  const h = Math.max(1, Math.round(image.height * scale));
  const canvas = document.createElement('canvas');
  canvas.width = w; canvas.height = h;
  const ctx = canvas.getContext('2d', {willReadFrequently:true});
  ctx.clearRect(0,0,w,h);
  ctx.drawImage(image,0,0,w,h);
  const data = ctx.getImageData(0,0,w,h).data;
  const buckets = new Map();
  for(let i=0;i<data.length;i+=4){
    const a = data[i+3];
    if(a <= 28) continue;
    const r=data[i], g=data[i+1], b=data[i+2];
    const key = `${r>>4},${g>>4},${b>>4}`;
    let rec = buckets.get(key);
    if(!rec){ rec = {count:0, r:0, g:0, b:0}; buckets.set(key, rec); }
    const aw = a / 255;
    rec.count += aw;
    rec.r += r * aw; rec.g += g * aw; rec.b += b * aw;
  }
  let best = null;
  for(const rec of buckets.values()){
    if(!best || rec.count > best.count) best = rec;
  }
  if(!best || best.count <= 0) return '#ffffff';
  return rgb01ToHex([best.r / best.count / 255, best.g / best.count / 255, best.b / best.count / 255]);
}

function createSolidAlphaArtworkTexture(image, color){
  if(!image || !image.width || !image.height) return null;
  const maxSide = 1024;
  const scale = Math.min(1, maxSide / Math.max(image.width, image.height));
  const w = Math.max(2, Math.round(image.width * scale));
  const h = Math.max(2, Math.round(image.height * scale));
  const canvas = document.createElement('canvas');
  canvas.width = w; canvas.height = h;
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0,0,w,h);
  ctx.drawImage(image,0,0,w,h);
  ctx.globalCompositeOperation = 'source-in';
  ctx.fillStyle = validColor(color) ? color : ARTWORK_BACK_DEFAULT_COLOR;
  ctx.fillRect(0,0,w,h);
  ctx.globalCompositeOperation = 'source-over';
  const tex = new THREE.CanvasTexture(canvas);
  tex.colorSpace = THREE.SRGBColorSpace;
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  tex.magFilter = THREE.LinearFilter;
  tex.wrapS = THREE.ClampToEdgeWrapping;
  tex.wrapT = THREE.ClampToEdgeWrapping;
  tex.generateMipmaps = true;
  tex.needsUpdate = true;
  return tex;
}

function applyArtworkBackLightLimit(mat, art){
  if(!mat) return mat;
  const factor = getArtworkBackLight(art);
  mat.userData.artworkBackLightFactor = factor;
  mat.onBeforeCompile = shader=>{
    shader.uniforms.artworkBackLightFactor = {value:mat.userData.artworkBackLightFactor};
    mat.userData.artworkBackLightUniform = shader.uniforms.artworkBackLightFactor;
    shader.fragmentShader = shader.fragmentShader.replace(
      'void main() {',
      'uniform float artworkBackLightFactor;\nvoid main() {'
    );
    shader.fragmentShader = shader.fragmentShader.replace(
      '#include <lights_fragment_end>',
      '#include <lights_fragment_end>\nreflectedLight.directDiffuse *= artworkBackLightFactor;\nreflectedLight.indirectDiffuse *= artworkBackLightFactor;\nreflectedLight.directSpecular *= artworkBackLightFactor;\nreflectedLight.indirectSpecular *= artworkBackLightFactor;'
    );
  };
  mat.customProgramCacheKey = ()=>`artworkBackLightLimit_v1`;
  mat.needsUpdate = true;
  return mat;
}

function makeArtworkBackMaterial(sourceTex, art){
  const side = THREE.BackSide;
  if(art?.doubleSided){
    const mat = makeArtworkImageMaterial(sourceTex, art, side);
    mat.userData.sourceTexture = sourceTex || null;
    mat.userData.solidBackTexture = false;
    applyArtworkBackLightLimit(mat, art);
    return mat;
  }
  const backColor = getArtworkBackColor(art);
  const solidTex = sourceTex?.image?.width ? createSolidAlphaArtworkTexture(sourceTex.image, backColor) : null;
  const mat = new THREE.MeshStandardMaterial({
    color: solidTex ? new THREE.Color('#ffffff') : new THREE.Color(backColor),
    map: solidTex,
    roughness:.96,
    metalness:0,
    transparent:false,
    alphaTest: art?.transparent!==false ? .035 : 0,
    side,
    depthWrite:true,
    depthTest:true,
    polygonOffset:false,
    polygonOffsetFactor:0,
    polygonOffsetUnits:0
  });
  const backReliefMaterial = artworkBackReliefMaterialConfig(art);
  const cfg = getReliefConfigForMaterial(backReliefMaterial);
  const preset = GROUND_RELIEF_PRESETS[cfg.preset] || GROUND_RELIEF_PRESETS.flat;
  const bump = createReferenceReliefBumpTexture(backReliefMaterial);
  mat.bumpMap = bump;
  mat.bumpScale = bump ? (.018 + preset.amp * .32) * cfg.amount : 0;
  mat.userData.baseTransparent = false;
  mat.userData.baseOpacity = 1;
  mat.userData.sourceTexture = sourceTex || null;
  mat.userData.solidBackTexture = !!solidTex;
  mat.shadowSide = side;
  applyArtworkBackLightLimit(mat, art);
  return mat;
}

function artworkAlphaPointKey(p){
  return `${Math.round(p[0]*1000)},${Math.round(p[1]*1000)}`;
}

function collectArtworkAlphaContours(data, sw, sh, threshold=24){
  const solid = (x,y)=>{
    if(x<0 || y<0 || x>=sw || y>=sh) return false;
    return data[(y*sw+x)*4+3] > threshold;
  };
  const segs = [];
  const add = (x,y,a,b)=>segs.push([[x+a[0], y+a[1]], [x+b[0], y+b[1]]]);
  const T=[.5,0], R=[1,.5], B=[.5,1], L=[0,.5];
  for(let y=0;y<sh-1;y++){
    for(let x=0;x<sw-1;x++){
      const state = (solid(x,y)?1:0) | (solid(x+1,y)?2:0) | (solid(x+1,y+1)?4:0) | (solid(x,y+1)?8:0);
      switch(state){
        case 0: case 15: break;
        case 1: add(x,y,L,T); break;
        case 2: add(x,y,T,R); break;
        case 3: add(x,y,L,R); break;
        case 4: add(x,y,R,B); break;
        case 5: add(x,y,L,T); add(x,y,R,B); break;
        case 6: add(x,y,T,B); break;
        case 7: add(x,y,L,B); break;
        case 8: add(x,y,B,L); break;
        case 9: add(x,y,T,B); break;
        case 10: add(x,y,T,R); add(x,y,B,L); break;
        case 11: add(x,y,R,B); break;
        case 12: add(x,y,R,L); break;
        case 13: add(x,y,T,R); break;
        case 14: add(x,y,L,T); break;
      }
    }
  }
  const chains = [];
  while(segs.length){
    const first = segs.pop();
    const chain = [first[0], first[1]];
    let changed = true;
    while(changed){
      changed = false;
      const headKey = artworkAlphaPointKey(chain[0]);
      const tailKey = artworkAlphaPointKey(chain[chain.length-1]);
      for(let i=segs.length-1;i>=0;i--){
        const a = segs[i][0], b = segs[i][1];
        const ak = artworkAlphaPointKey(a), bk = artworkAlphaPointKey(b);
        if(ak === tailKey){ chain.push(b); segs.splice(i,1); changed = true; break; }
        if(bk === tailKey){ chain.push(a); segs.splice(i,1); changed = true; break; }
        if(bk === headKey){ chain.unshift(a); segs.splice(i,1); changed = true; break; }
        if(ak === headKey){ chain.unshift(b); segs.splice(i,1); changed = true; break; }
      }
    }
    if(chain.length >= 4){
      const a = chain[0], b = chain[chain.length-1];
      if(Math.hypot(a[0]-b[0], a[1]-b[1]) < 1.25) chain.pop();
      if(chain.length >= 3) chains.push(chain);
    }
  }
  return chains;
}

function chaikinSmoothClosedPolyline(points, iterations=2){
  let pts = points.slice();
  for(let it=0; it<iterations; it++){
    const out = [];
    for(let i=0;i<pts.length;i++){
      const a = pts[i];
      const b = pts[(i+1)%pts.length];
      out.push([a[0]*.75 + b[0]*.25, a[1]*.75 + b[1]*.25]);
      out.push([a[0]*.25 + b[0]*.75, a[1]*.25 + b[1]*.75]);
    }
    pts = out;
  }
  const filtered = [];
  for(const p of pts){
    const last = filtered[filtered.length-1];
    if(!last || Math.hypot(p[0]-last[0], p[1]-last[1]) > .22) filtered.push(p);
  }
  return filtered.length >= 3 ? filtered : pts;
}

function rebuildArtworkDepth(group, art, image){
  for(const name of ['edge-extrusion','edge-particles']){
    const old = group.getObjectByName(name);
    if(old){
      old.geometry?.dispose?.();
      if(old.material?.map && old.material?.userData?.generatedArtworkMap) old.material.map.dispose?.();
      old.material?.dispose?.();
      group.remove(old);
    }
  }
  const back = group.getObjectByName(`${art.title}_back`);
  if(back) back.position.z = -Math.max(.01, safeFinite(art.depth,.10));
  if(!image || !image.width || !image.height) return;
  const fallbackBackColor = getArtworkBackColor(art);

  const depth = Math.max(.01, safeFinite(art.depth,.10));
  const maxSamples = 420;
  const aspect = image.width / image.height;
  let sw, sh;
  if(aspect >= 1){ sw = maxSamples; sh = Math.max(32, Math.round(maxSamples / aspect)); }
  else { sh = maxSamples; sw = Math.max(32, Math.round(maxSamples * aspect)); }
  const canvas = document.createElement('canvas');
  canvas.width = sw; canvas.height = sh;
  const ctx = canvas.getContext('2d', {willReadFrequently:true});
  ctx.clearRect(0,0,sw,sh);
  ctx.imageSmoothingEnabled = true;
  ctx.imageSmoothingQuality = 'high';
  ctx.drawImage(image,0,0,sw,sh);
  // 在 alpha 邊界做一次非常輕的平滑取樣；幾何輪廓走 0.5 等值線，不再用逐像素方格堆疊厚度。
  const img = ctx.getImageData(0,0,sw,sh);
  const data = img.data;
  const colorAt = (x,y)=>{
    x = clamp(Math.round(x),0,sw-1);
    y = clamp(Math.round(y),0,sh-1);
    const i=(y*sw+x)*4;
    return [data[i]/255, data[i+1]/255, data[i+2]/255];
  };
  const isSolid = (x,y)=>{
    x = Math.round(x); y = Math.round(y);
    if(x<0 || y<0 || x>=sw || y>=sh) return false;
    return data[(y*sw+x)*4+3] > 24;
  };
  const colorNear = (x,y)=>{
    if(isSolid(x,y)) return colorAt(x,y);
    for(let r=1;r<=10;r++){
      for(let yy=-r; yy<=r; yy++){
        for(let xx=-r; xx<=r; xx++){
          if(Math.abs(xx)!==r && Math.abs(yy)!==r) continue;
          if(isSolid(x+xx,y+yy)) return colorAt(x+xx,y+yy);
        }
      }
    }
    return hexToRgb01(fallbackBackColor);
  };
  const pxToX = x => x / Math.max(1, sw-1) - .5;
  const pxToY = y => .5 - y / Math.max(1, sh-1);
  const positions=[], colors=[];
  const pushVertex=(x,y,z,c)=>{ positions.push(x,y,z); colors.push(c[0],c[1],c[2]); };
  const addSmoothSideQuad=(p0,p1,c)=>{
    const x0 = pxToX(p0[0]), y0 = pxToY(p0[1]);
    const x1 = pxToX(p1[0]), y1 = pxToY(p1[1]);
    pushVertex(x0,y0,0,c);
    pushVertex(x1,y1,0,c);
    pushVertex(x0,y0,-depth,c);
    pushVertex(x0,y0,-depth,c);
    pushVertex(x1,y1,0,c);
    pushVertex(x1,y1,-depth,c);
  };
  let contours = collectArtworkAlphaContours(data, sw, sh, 24);
  // 過小碎片多半是去背殘留或半透明髒點，直接略過，避免厚度邊緣長出毛刺。
  contours = contours.filter(c=>c.length >= 8);
  for(const rawContour of contours){
    const contour = chaikinSmoothClosedPolyline(rawContour, rawContour.length > 28 ? 2 : 1);
    if(contour.length < 3) continue;
    for(let i=0;i<contour.length;i++){
      const a = contour[i];
      const b = contour[(i+1)%contour.length];
      if(Math.hypot(a[0]-b[0], a[1]-b[1]) < .08) continue;
      const mid = [(a[0]+b[0])*.5, (a[1]+b[1])*.5];
      const c = colorNear(mid[0], mid[1]);
      addSmoothSideQuad(a,b,c);
    }
  }
  if(positions.length){
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.Float32BufferAttribute(positions,3));
    geo.setAttribute('baseColor', new THREE.Float32BufferAttribute(colors,3));
    geo.setAttribute('color', new THREE.Float32BufferAttribute(tintedColorArray(colors, art),3));
    geo.computeVertexNormals();
    const mat = new THREE.MeshStandardMaterial({
      vertexColors:true,
      side:THREE.DoubleSide,
      roughness:.86,
      metalness:0,
      depthWrite:true,
      depthTest:true,
      polygonOffset:false,
      flatShading:false
    });
    mat.userData.baseTransparent = false;
    mat.userData.baseOpacity = 1;
    const edge = new THREE.Mesh(geo, mat);
    edge.name = 'edge-extrusion';
    edge.castShadow = false;
    edge.receiveShadow = false;
    edge.renderOrder = 27;
    group.add(edge);
  }
}
function placeArtwork(art){
  const group = artworkMeshes[art.id];
  if(!group) return;
  const depth = Math.max(.01, safeFinite(art.depth,.10));

  if(art.position){
    const r = art.rotation || {x:0,y:0,z:0};
    group.position.set(safeFinite(art.position.x,0), safeFinite(art.position.y,2.2), safeFinite(art.position.z,0));
    group.rotation.set(deg(safeFinite(r.x,0)), deg(safeFinite(r.y,0)), deg(safeFinite(r.z,0)));
  }else{
    const W=STATE.room.width, D=STATE.room.depth, T=STATE.room.thickness;
    const gap = clamp(safeFinite(art.gap,.014),.002,.18);
    let p=[0,3,0], ry=0;
    // 作品有厚度：背面離牆一點點，正面往室內凸出，厚度層與正面畫面共邊，沒有空隙。
    // group local +Z = 作品正面法線；back plane 在 local -depth。
    const offsetFromWallCenter = T/2 + gap + depth;
    if(art.wall==='front'){ p=[art.offset,art.y,-D/2+offsetFromWallCenter]; ry=0; }
    if(art.wall==='back'){ p=[art.offset,art.y,D/2-offsetFromWallCenter]; ry=180; }
    if(art.wall==='left'){ p=[-W/2+offsetFromWallCenter,art.y,art.offset]; ry=90; }
    if(art.wall==='right'){ p=[W/2-offsetFromWallCenter,art.y,art.offset]; ry=-90; }
    group.position.set(p[0],p[1],p[2]);
    group.rotation.set(0,deg(ry),0);
  }
  if(art.type === 'model'){
    removeEmbeddedLightsFromArtworkModel(group);
    group.scale.set(safeFinite(art.size?.w,1.5), safeFinite(art.size?.h,1.5), safeFinite(art.size?.d,1.5));
    isolateModelArtworkLighting(group);
  }else{
    group.scale.set(safeFinite(art.size?.w,3), safeFinite(art.size?.h,3), 1);
  }
  const back = group.getObjectByName(`${art.title}_back`);
  if(back) back.position.z = -depth;
  applyArtworkVisualState(group, selectedArtworkActive && selectedArtworkId===art.id, !!art.isDraft);
}

function ensureFreeArtworkPosition(art){
  if(!art) return;
  if(art.position) return;
  const group = artworkMeshes[art.id];
  if(group){
    art.position = {x:group.position.x, y:group.position.y, z:group.position.z};
    art.rotation = {x:radToDeg(group.rotation.x), y:radToDeg(group.rotation.y), z:radToDeg(group.rotation.z)};
  }else{
    art.position = {x:clamp(safeFinite(art.offset,0),-500,500), y:clamp(safeFinite(art.y, art.type === 'model' ? 0 : 2.2),-500,500), z:0};
    art.rotation = art.rotation || {x:0,y:0,z:0};
  }
}


function addReferenceArchitectureSnapCandidates(candidates){
  if(!referenceArchitectureGroup || STATE?.referenceArchitecture?.enabled === false || STATE?.referenceArchitecture?.visible === false) return;
  referenceArchitectureGroup.updateMatrixWorld(true);
  const tmpQ = new THREE.Quaternion();
  const rotY = angle => new THREE.Quaternion().setFromEuler(new THREE.Euler(0, angle, 0));
  const faceDefs = [
    {name:'front', axis:'z', side:1, normal:new THREE.Vector3(0,0,1), ry:0},
    {name:'back', axis:'z', side:-1, normal:new THREE.Vector3(0,0,-1), ry:Math.PI},
    {name:'right', axis:'x', side:1, normal:new THREE.Vector3(1,0,0), ry:Math.PI/2},
    {name:'left', axis:'x', side:-1, normal:new THREE.Vector3(-1,0,0), ry:-Math.PI/2}
  ];

  referenceArchitectureGroup.traverse(obj=>{
    if(!obj?.isMesh || obj.visible === false) return;
    if(!obj.userData?.referenceArchitecture) return;
    if(obj.userData?.isReferenceRelief) return;
    if(obj.userData?.referenceMaterialKind !== 'wall') return;
    const geo = obj.geometry;
    if(!geo) return;
    if(!geo.boundingBox) geo.computeBoundingBox?.();
    const bb = geo.boundingBox;
    if(!bb) return;
    obj.updateMatrixWorld(true);
    const scale = getWorldScaleSafe(obj);
    const spanX = Math.max(.0001, bb.max.x - bb.min.x) * scale.x;
    const spanY = Math.max(.0001, bb.max.y - bb.min.y) * scale.y;
    const spanZ = Math.max(.0001, bb.max.z - bb.min.z) * scale.z;
    if(spanY < .75) return;
    obj.getWorldQuaternion(tmpQ);

    for(const f of faceDefs){
      const faceWidth = f.axis === 'z' ? spanX : spanZ;
      if(faceWidth < .75) continue;
      const localCenter = new THREE.Vector3(
        f.axis === 'x' ? (f.side > 0 ? bb.max.x : bb.min.x) : (bb.min.x + bb.max.x) * .5,
        (bb.min.y + bb.max.y) * .5,
        f.axis === 'z' ? (f.side > 0 ? bb.max.z : bb.min.z) : (bb.min.z + bb.max.z) * .5
      );
      const point = obj.localToWorld(localCenter.clone());
      const normal = f.normal.clone().transformDirection(obj.matrixWorld).normalize();
      if(Math.abs(normal.y) > .35) continue;
      const quaternion = tmpQ.clone().multiply(rotY(f.ry));
      candidates.push({
        point:point.addScaledVector(normal, .004),
        normal,
        quaternion,
        label:`${obj.name || '參考圖建築'}｜${f.name}`,
        source:'referenceArchitecture'
      });
    }
  });
}

function wallSnapCandidates(){
  const candidates = [];
  const addRoomCandidate = (key, normal, yaw, halfAxis)=>{
    const mesh = surfaces[key];
    if(!mesh) return;
    const n = normal.clone().normalize();
    const center = mesh.getWorldPosition(new THREE.Vector3());
    const halfT = Math.max(.001, halfAxis(mesh) / 2);
    const point = center.clone().addScaledVector(n, halfT);
    const q = new THREE.Quaternion().setFromEuler(new THREE.Euler(0, deg(yaw), 0));
    candidates.push({point, normal:n, quaternion:q, label:SURFACE_LABELS[key] || key});
  };
  addRoomCandidate('front', new THREE.Vector3(0,0,1), 0, mesh=>Math.abs(mesh.scale.z));
  addRoomCandidate('back', new THREE.Vector3(0,0,-1), 180, mesh=>Math.abs(mesh.scale.z));
  addRoomCandidate('left', new THREE.Vector3(1,0,0), 90, mesh=>Math.abs(mesh.scale.x));
  addRoomCandidate('right', new THREE.Vector3(-1,0,0), -90, mesh=>Math.abs(mesh.scale.x));
  for(const [id,mesh] of Object.entries(customWallMeshes)){
    const w = STATE.customWalls.find(item=>item.id===id);
    if(!mesh || !w) continue;
    mesh.updateMatrixWorld(true);
    const center = mesh.getWorldPosition(new THREE.Vector3());
    const qBase = mesh.getWorldQuaternion(new THREE.Quaternion());
    const baseNormal = new THREE.Vector3(0,0,1).applyQuaternion(qBase).normalize();
    const halfT = Math.max(.001, safeFinite(w.size?.t,.18) / 2);
    const qFront = qBase.clone();
    const qBack = qBase.clone().multiply(new THREE.Quaternion().setFromEuler(new THREE.Euler(0,Math.PI,0)));
    candidates.push({point:center.clone().addScaledVector(baseNormal, halfT), normal:baseNormal.clone(), quaternion:qFront, label:w.title || id});
    candidates.push({point:center.clone().addScaledVector(baseNormal, -halfT), normal:baseNormal.clone().negate(), quaternion:qBack, label:w.title || id});
  }
  addReferenceArchitectureSnapCandidates(candidates);
  return candidates;
}

function snapArtworkToNearestWall(art){
  if(!art) return false;
  ensureFreeArtworkPosition(art);
  const candidates = wallSnapCandidates();
  if(!candidates.length) return false;
  const pos = new THREE.Vector3(safeFinite(art.position.x,0), safeFinite(art.position.y, art.type === 'model' ? 0 : 2.2), safeFinite(art.position.z,0));
  let best = null;
  for(const c of candidates){
    const d = pos.clone().sub(c.point).dot(c.normal);
    const score = Math.abs(d);
    if(!best || score < best.score) best = {...c, d, score};
  }
  if(!best) return false;
  const snapOffset = art.type === 'model'
    ? Math.max(.01, safeFinite(art.size?.d,1.5) / 2 + safeFinite(art.gap,.014))
    : Math.max(.01, safeFinite(art.depth,.10) + safeFinite(art.gap,.014));
  const snapped = pos.clone().addScaledVector(best.normal, snapOffset - best.d);
  art.position.x = clamp(snapped.x, -500, 500);
  art.position.y = clamp(snapped.y, -500, 500);
  art.position.z = clamp(snapped.z, -500, 500);
  const e = new THREE.Euler().setFromQuaternion(best.quaternion, 'XYZ');
  art.rotation = {x:radToDeg(e.x), y:radToDeg(e.y), z:radToDeg(e.z)};
  art.manualRotation = true;
  return true;
}

function loadStatue(){
  // 空白十字空間版本不載入原始參考雕塑或作品物件。
  return;
}

function createProxyActor(){
  const g = new THREE.Group();
  const body = new THREE.Mesh(new THREE.CapsuleGeometry(.32,1.05,6,12), new THREE.MeshStandardMaterial({color:'#8aa3ff',roughness:.75}));
  body.position.y = .92;
  body.castShadow = true;
  const head = new THREE.Mesh(new THREE.SphereGeometry(.25,16,12), new THREE.MeshStandardMaterial({color:'#ead5bd',roughness:.8}));
  head.position.y = 1.65;
  head.castShadow = true;
  const nose = new THREE.Mesh(new THREE.BoxGeometry(.08,.08,.2), new THREE.MeshStandardMaterial({color:'#333'}));
  nose.position.set(0,1.65,-.31);
  g.add(body,head,nose);
  return g;
}

function loadActor(){
  actorProxy = createProxyActor();
  playerGroup.add(actorProxy);
  applyActorSettings();
  const loader = new FBXLoader();
  loader.load(ASSET.actorIdle, model=>{
    actorModel = model;
    normaliseActorModel(actorModel, 1.72);
    actorModel.traverse(c=>{ if(c.isMesh){ c.castShadow=true; c.receiveShadow=true; }});
    markSinTowerActorBodyMeshes(actorModel);
    repairActorMaterials(actorModel);
    playerGroup.add(actorModel);
    actorProxy.visible = false; // FBX 成功載入後隱藏代理膠囊，避免多餘物件黏在角色上。
    updateSinTowerActorInfectionVisibility();
    if(SIN_TOWER_INFECTION.level > 0) rebuildSinTowerInfectionVisual();
    mixer = new THREE.AnimationMixer(actorModel);
    if(model.animations[0]) actions.idle = mixer.clipAction(stripRootMotionClip(model.animations[0]));
    loadClip('walk', ASSET.actorWalk); // 使用使用者上傳的 跑步.fbx 作為移動動畫
    loadClip('jump', ASSET.actorJump);
    playAction('idle');
    setStatus('角色模型已載入；已套用 BaseColor 皮膚；移動動畫使用跑步.fbx；移動方向修正。');
  }, undefined, err=>{
    console.warn(err);
    setStatus('FBX 角色載入失敗，使用可見代理角色。');
  });
}

function normaliseActorModel(model, targetHeight){
  model.updateMatrixWorld(true);
  const box = new THREE.Box3().setFromObject(model);
  const size = new THREE.Vector3();
  const center = new THREE.Vector3();
  box.getSize(size); box.getCenter(center);
  const scale = targetHeight / Math.max(size.y, .001);
  model.userData.baseScale = scale;
  model.userData.anchorX = -center.x * scale;
  model.userData.anchorY = -box.min.y * scale;
  model.userData.anchorZ = -center.z * scale;
  applyActorSettings();
}

function getActorBaseUiScale(){
  return clamp(safeFinite(STATE?.player?.scale, 1), .1, 20);
}

function getSinTowerLockedRollScale(threshold){
  // v72：肉球化後不能再用 1.05^threshold 無限制放大。
  // 門檻拉高時舊算法會把所有腫瘤一起放大成數公尺，最後擋住鏡頭，並讓滾動中心看起來失控。
  const th = Math.max(1, Math.floor(safeFinite(threshold, 20)));
  return clamp(Math.pow(1.035, th), 1, 3.4);
}

function getSinTowerTumorVisibleScaleGuard(){
  const level = Math.max(0, Math.floor(SIN_TOWER_INFECTION?.level || 0));
  const threshold = Math.max(1, Math.floor(getSinTowerTumorParams?.().meatballLevel || SIN_TOWER_INFECTION?.meatballLevel || 20));
  const infectionScale = level >= threshold ? getSinTowerLockedRollScale(threshold) : clamp(Math.pow(1.05, level), 1, getSinTowerLockedRollScale(threshold));
  return clamp(getActorBaseUiScale() * infectionScale, .1, 6);
}

function getActorInfectionScale(){
  const level = Math.max(0, Math.floor(SIN_TOWER_INFECTION?.level || 0));
  const threshold = Math.max(1, Math.floor(getSinTowerTumorParams?.().meatballLevel || SIN_TOWER_INFECTION?.meatballLevel || 20));
  // v72：肉球外形固定後，整體倍率也固定在安全範圍。
  // 這裡是阻止後期突然長出超巨大腫瘤、擋住鏡頭、滾動中心失控的第一道保護。
  if(level >= threshold){
    if(!SIN_TOWER_INFECTION.rollFixedScale) SIN_TOWER_INFECTION.rollFixedScale = getSinTowerLockedRollScale(threshold);
    return SIN_TOWER_INFECTION.rollFixedScale;
  }
  return clamp(Math.pow(1.05, level), 1, getSinTowerLockedRollScale(threshold));
}

function getActorScale(){
  return clamp(getActorBaseUiScale() * getActorInfectionScale(), .1, 80);
}

function isSinTowerMeatballMode(){
  const level = Math.max(0, Math.floor(SIN_TOWER_INFECTION?.level || 0));
  const threshold = Math.max(1, Math.floor(getSinTowerTumorParams?.().meatballLevel || SIN_TOWER_INFECTION?.meatballLevel || 20));
  return level >= threshold;
}

function applyActorSettings(){
  const cfg = STATE.player || {modelYOffset:0.68, modelYawOffset:180, speed:6.3, scale:1};
  const yOff = clamp(safeFinite(cfg.modelYOffset,0.68), -1.2, 20.0);
  const yawOff = clamp(safeFinite(cfg.modelYawOffset,180), -180, 180);
  const baseUiScale = getActorBaseUiScale();
  const infectionScale = getActorInfectionScale();
  const actorScale = clamp(baseUiScale * infectionScale, .1, 80);

  // playerGroup 只做感染整體倍率；肉球滾動由固定球根節點處理。
  if(playerGroup){
    if(isSinTowerMeatballMode?.()) playerGroup.scale.setScalar(SIN_TOWER_INFECTION.rollFixedScale || infectionScale);
    else playerGroup.scale.setScalar(infectionScale);
  }

  // 感染只改變外觀；碰撞尺寸固定，避免吸收僧侶後角色像被拖慢或卡住。
  player.radius = .34 * baseUiScale;
  player.height = 1.72 * baseUiScale;
  if(actorModel){
    const baseScale = safeFinite(actorModel.userData.baseScale, actorModel.scale.x || 1);
    actorModel.scale.setScalar(baseScale * baseUiScale);
    actorModel.position.set(
      safeFinite(actorModel.userData.anchorX,0) * baseUiScale,
      safeFinite(actorModel.userData.anchorY,0) * baseUiScale + yOff,
      safeFinite(actorModel.userData.anchorZ,0) * baseUiScale
    );
    actorModel.rotation.y = deg(yawOff);
  }
  if(actorProxy){
    actorProxy.scale.setScalar(baseUiScale);
    actorProxy.position.y = yOff;
  }
}

function ensureProjectedUV(geometry){
  if(!geometry || !geometry.attributes || !geometry.attributes.position) return;
  const pos = geometry.attributes.position;
  const uv = [];
  geometry.computeBoundingBox?.();
  const box = geometry.boundingBox;
  if(!box) return;
  const size = new THREE.Vector3();
  box.getSize(size);
  const min = box.min;
  const sx = Math.max(size.x,.0001), sy = Math.max(size.y,.0001), sz = Math.max(size.z,.0001);
  for(let i=0;i<pos.count;i++){
    const x = pos.getX(i), y = pos.getY(i), z = pos.getZ(i);
    let u, v;
    if(sy >= sx && sy >= sz){ u = (x-min.x)/sx; v = 1-(y-min.y)/sy; }
    else if(sx >= sz){ u = (z-min.z)/sz; v = 1-(y-min.y)/sy; }
    else { u = (x-min.x)/sx; v = 1-(y-min.y)/sy; }
    uv.push(u,v);
  }
  geometry.setAttribute('uv', new THREE.Float32BufferAttribute(uv,2));
  geometry.attributes.uv.needsUpdate = true;
}

function stripRootMotionClip(clip){
  if(!clip) return clip;
  const cleaned = clip.clone();
  cleaned.tracks = cleaned.tracks.filter(track=>{
    const name = String(track.name||'').toLowerCase();
    if(name.endsWith('.position')) return false;
    if((name.includes('root') || name.includes('hips')) && name.endsWith('.scale')) return false;
    return true;
  });
  cleaned.resetDuration();
  return cleaned;
}

function repairActorMaterials(model){
  const actorTexture = new THREE.TextureLoader().load(ASSET.actorTexture, tex=>{ tex.needsUpdate = true; });
  actorTexture.colorSpace = THREE.SRGBColorSpace;
  actorTexture.wrapS = THREE.ClampToEdgeWrapping;
  actorTexture.wrapT = THREE.ClampToEdgeWrapping;
  actorTexture.generateMipmaps = true;
  actorTexture.minFilter = THREE.LinearMipmapLinearFilter;
  actorTexture.magFilter = THREE.LinearFilter;
  model.traverse(child=>{
    if(!child.isMesh) return;
    child.castShadow = true;
    child.receiveShadow = false;
    child.frustumCulled = false;
    const mat = new THREE.MeshBasicMaterial({
      map:actorTexture,
      color:0xffffff,
      side:THREE.DoubleSide,
      toneMapped:false,
      alphaTest:.001
    });
    mat.needsUpdate = true;
    child.material = mat;
  });
}

function loadClip(name,url){
  new FBXLoader().load(url, fbx=>{
    if(!mixer || !fbx.animations[0]) return;
    const action = mixer.clipAction(stripRootMotionClip(fbx.animations[0]));
    if(name==='jump') action.setLoop(THREE.LoopOnce,1).clampWhenFinished = true;
    actions[name] = action;
  });
}

function playAction(name, manual=false){
  const next = actions[name];
  if(manual) manualActionUntil = performance.now()+900;
  if(!next || activeAction===next) return;
  if(activeAction) activeAction.fadeOut(.12);
  next.reset().fadeIn(.12).play();
  activeAction = next;
}

function isMiddleButtonEvent(e){
  return e?.button === 1 || ((e?.buttons || 0) & 4) === 4;
}

function isInsideEditUi(target){
  return !!target?.closest?.('.edit-ui,#sinProEditor,#sinPlayAddPanel,#sinInteractionOverlay,#sinQuestionOverlay,#sinRpsOverlay,#sinAfterVideoOverlay,#sinPortalPasswordOverlay,#sinStairJumpOverlay,#sinPlayAddButton,#sinPlayObjectActions,#sinShortcutOverlay');
}

function startMiddleViewDrag(e){
  if(pointerLocked || fallbackMouseLook) return false;
  if(!isMiddleButtonEvent(e)) return false;
  if(isInsideEditUi(e.target)) return false;
  if(transformControls?.dragging) return false;

  // 編輯模式下，只要滑鼠游標可見，就允許滾輪拖曳視角。
  // 不再依賴 cursorFreeMode 單一旗標，避免 ESC / pointerlock 狀態不同步時擋掉功能。
  desiredPointerLocked = false;
  cursorFreeMode = true;
  fallbackMouseLook = false;

  ctrlViewDrag = true;
  ctrlViewDragLastX = Number.isFinite(e.clientX) ? e.clientX : 0;
  ctrlViewDragLastY = Number.isFinite(e.clientY) ? e.clientY : 0;
  ctrlViewDragPointerId = Number.isFinite(e.pointerId) ? e.pointerId : null;
  if(ctrlViewDragPointerId !== null && e.currentTarget?.setPointerCapture){
    try{ e.currentTarget.setPointerCapture(ctrlViewDragPointerId); }catch(err){}
  }
  if(ctrlViewDragPointerId !== null && renderer?.domElement?.setPointerCapture){
    try{ renderer.domElement.setPointerCapture(ctrlViewDragPointerId); }catch(err){}
  }
  e.preventDefault?.();
  e.stopPropagation?.();
  updateCursorVisibility();
  setStatus('編輯模式視角調整：按住滑鼠滾輪拖曳。左右拖＝水平旋轉；上下拖＝俯視／仰視。');
  return true;
}

function applyMiddleViewDragMove(e){
  if(!ctrlViewDrag) return false;
  e.preventDefault?.();
  e.stopPropagation?.();
  const clientX = Number.isFinite(e.clientX) ? e.clientX : ctrlViewDragLastX;
  const clientY = Number.isFinite(e.clientY) ? e.clientY : ctrlViewDragLastY;
  const mx = Number.isFinite(e.movementX) ? e.movementX : 0;
  const my = Number.isFinite(e.movementY) ? e.movementY : 0;
  const dx = Math.abs(mx) > 0 ? mx : clientX - ctrlViewDragLastX;
  const dy = Math.abs(my) > 0 ? my : clientY - ctrlViewDragLastY;
  ctrlViewDragLastX = clientX;
  ctrlViewDragLastY = clientY;
  if(dx || dy){
    camYaw -= dx * .0072;
    camPitch = clamp(camPitch - dy * .0072, CAMERA_PITCH_MIN, CAMERA_PITCH_MAX);
    updateCamera();
  }
  return true;
}

function stopMiddleViewDrag(e){
  if(!ctrlViewDrag) return false;
  ctrlViewDrag = false;
  ctrlViewDragLastX = 0;
  ctrlViewDragLastY = 0;
  const pid = Number.isFinite(e?.pointerId) ? e.pointerId : ctrlViewDragPointerId;
  ctrlViewDragPointerId = null;
  if(pid !== null && renderer?.domElement?.releasePointerCapture){
    try{ renderer.domElement.releasePointerCapture(pid); }catch(err){}
  }
  e?.preventDefault?.();
  e?.stopPropagation?.();
  return true;
}


function isInsideMobileControls(target){
  return !!target?.closest?.('#mobileControls');
}

const sinMobileInput={x:0,y:0,active:false};
function resetMobileMoveKeys(){
  clearSinPortalPadInput();
  sinMobileInput.x=0;sinMobileInput.y=0;sinMobileInput.active=false;
  keys.w = false; keys.a = false; keys.s = false; keys.d = false;
}

// BEGIN PORTAL MOBILE PAD
// Temporary password-only layout; never writes the saved mobile layout.
const sinPortalPad={active:false,direction:null,timer:null};
function clearSinPortalPadInput(){clearTimeout(sinPortalPad.timer);sinPortalPad.timer=null;sinPortalPad.direction=null;}
function isSinPortalPadMode(){return sinPortalPasswordVisible()&&sinTowerPortalGate.active&&sinTowerPortalGate.phase==='input'&&!sinTowerPortalLayoutEditor.active&&(matchMedia('(pointer:coarse)').matches||navigator.maxTouchPoints>0||STATE?.displayOrientation==='portrait');}
function routeSinPortalPadInput(dx,dy){
  if(!isSinPortalPadMode()){if(sinPortalPad.active){clearSinPortalPadInput();return true;}return false;}
  const direction=Math.max(Math.abs(dx),Math.abs(dy))<=10?null:Math.abs(dx)>Math.abs(dy)?(dx<0?'ArrowLeft':'ArrowRight'):(dy<0?'ArrowUp':'ArrowDown');
  if(direction===sinPortalPad.direction)return true;clearSinPortalPadInput();sinPortalPad.direction=direction;
  if(direction){const send=repeat=>{if(!isSinPortalPadMode()||sinPortalPad.direction!==direction)return clearSinPortalPadInput();handleSinTowerPortalPasswordKey({code:direction,repeat,preventDefault(){},stopPropagation(){}});if(isSinPortalPadMode())sinPortalPad.timer=setTimeout(()=>send(true),repeat?130:380);};send(false);}
  return true;
}
function restoreSinPortalPad(){
  if(!sinPortalPad.active)return;sinPortalPad.active=false;clearSinPortalPadInput();document.body.classList.remove('sin-password-pad');
  const pad=$('mobileMovePad');pad?.__sinStopMove?.();resetMobileMoveKeys();if($('mobileMoveKnob'))$('mobileMoveKnob').style.transform='translate3d(0,0,0)';applySinTowerMobileControlsLayout();
}
function layoutSinPortalPad(){
  if(!isSinPortalPadMode()){restoreSinPortalPad();return;}
  const overlay=$('sinPortalPasswordOverlay'),shell=overlay?.querySelector('.sin-portal-password-shell'),group=$('sinPortalPasswordGroup'),pad=$('mobileMovePad');if(!overlay||!shell||!group||!pad)return;
  if(!sinPortalPad.active){resetMobileMoveKeys();sinPortalPad.active=true;}document.body.classList.add('sin-password-pad');
  const bounds=overlay.getBoundingClientRect(),size=Math.max(64,Math.min(104,bounds.width*.25,bounds.height*.22)),gap=16,bottomGap=24;
  const nodes=[shell,group],rects=nodes.map(n=>n.getBoundingClientRect()),extent=Math.max(...rects.map(r=>r.bottom-bounds.top));
  const scale=Math.min(1,Math.max(1,bounds.height-size-gap-bottomGap)/Math.max(1,extent));
  nodes.forEach((node,i)=>{const r=rects[i];Object.assign(node.style,{left:(bounds.width/2+(r.left+r.width/2-bounds.left-bounds.width/2)*scale)+'px',top:((r.top+r.height/2-bounds.top)*scale)+'px',width:r.width*scale+'px',height:r.height*scale+'px'});});
  const slots=group.getBoundingClientRect();group.style.setProperty('--portal-slot-font-size',Math.max(3,Math.min(slots.height*.62,slots.width*.17))+'px');group.style.setProperty('--portal-slot-gap',Math.max(.35,Math.min(18,slots.width*.035))+'px');
  const top=Math.max(...nodes.map(n=>n.getBoundingClientRect().bottom))+gap;
  Object.assign(pad.style,{left:(bounds.left+(bounds.width-size)/2)+'px',top:top+'px',width:size+'px',height:size+'px'});
}

// END PORTAL MOBILE PAD
function applyMobileMoveVector(dx, dy){
  if(routeSinPortalPadInput(dx,dy))return;
  const dead = 10;
  sinMobileInput.active=true;sinMobileInput.x=dx>dead?1:dx<-dead?-1:0;sinMobileInput.y=dy<-dead?1:dy>dead?-1:0;
  keys.w = dy < -dead;
  keys.s = dy > dead;
  keys.a = dx < -dead;
  keys.d = dx > dead;
}

// BEGIN SITE GESTURES
// Browser gestures only: never stop propagation of camera wheel / two-touch input.
function sinEditableGestureTarget(target){return !!target?.closest?.('input,textarea,[contenteditable="true"],[contenteditable=""]');}
for(const name of ['selectstart','dragstart','dblclick'])document.addEventListener(name,event=>{
  if(!sinEditableGestureTarget(event.target)&&event.cancelable)event.preventDefault();
},{capture:true,passive:false});
for(const name of ['gesturestart','gesturechange','gestureend'])document.addEventListener(name,event=>{
  if(event.cancelable)event.preventDefault();
},{passive:false});
document.addEventListener('wheel',event=>{if(event.ctrlKey&&event.cancelable)event.preventDefault();},{passive:false});

// END SITE GESTURES
function setupMobileControls(){
  const pad = $('mobileMovePad');
  const knob = $('mobileMoveKnob');
  const jumpBtn = $('mobileJumpButton');
  const canvas = $('canvas');
  if(!pad || !knob || !jumpBtn || pad.__sinControlsBound === true) return;
  pad.__sinControlsBound=true;
  pad.dataset.bound = '1';
  let movePointerId = null;
  const centerPad = ev=>{
    const rect = pad.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const max = rect.width * .34;
    let dx = ev.clientX - cx;
    let dy = ev.clientY - cy;
    const len = Math.hypot(dx,dy);
    if(len > max){ dx = dx / len * max; dy = dy / len * max; }
    knob.style.transform = `translate3d(${dx}px,${dy}px,0)`;
    applyMobileMoveVector(dx, dy);
  };
  const stopMove = ev=>{
    if(movePointerId !== null && ev.pointerId !== movePointerId) return;
    movePointerId = null;
    knob.style.transform = 'translate3d(0,0,0)';
    resetMobileMoveKeys();
    try{ pad.releasePointerCapture?.(ev.pointerId); }catch{}
  };
  pad.__sinStopMove=()=>stopMove({pointerId:movePointerId});
  pad.addEventListener('pointerdown', ev=>{
    if(sinTowerMobileLayoutEditor.active) return;
    ev.preventDefault(); ev.stopPropagation();
    movePointerId = ev.pointerId;
    try{pad.setPointerCapture?.(ev.pointerId);}catch{}
    centerPad(ev);
  }, {passive:false});
  pad.addEventListener('pointermove', ev=>{
    if(sinTowerMobileLayoutEditor.active || ev.pointerId !== movePointerId) return;
    ev.preventDefault(); ev.stopPropagation();
    centerPad(ev);
  }, {passive:false});
  pad.addEventListener('pointerup', stopMove, {passive:false});
  pad.addEventListener('pointercancel', stopMove, {passive:false});
  pad.addEventListener('lostpointercapture',stopMove);
  window.addEventListener('blur',()=>{movePointerId=null;knob.style.transform='translate3d(0,0,0)';resetMobileMoveKeys();});
  jumpBtn.addEventListener('pointerdown', ev=>{
    if(sinTowerMobileLayoutEditor.active) return;
    ev.preventDefault(); ev.stopPropagation();
    jump();
  }, {passive:false});

  let lastTouchEndAt = 0;
  document.addEventListener('touchend', ev=>{
    const now = Date.now();
    if(ev.touches.length === 0 && now - lastTouchEndAt < 320) ev.preventDefault();
    lastTouchEndAt = now;
  }, {passive:false});

  let pinchDistance = 0;
  canvas.addEventListener('touchstart', ev=>{
    if(ev.touches.length === 2){
      const a = ev.touches[0], b = ev.touches[1];
      pinchDistance = Math.hypot(a.clientX-b.clientX, a.clientY-b.clientY);
      ev.preventDefault();
    }
  }, {passive:false});
  canvas.addEventListener('touchmove', ev=>{
    if(ev.touches.length === 2){
      const a = ev.touches[0], b = ev.touches[1];
      const d = Math.hypot(a.clientX-b.clientX, a.clientY-b.clientY);
      if(pinchDistance > 0){
        zoomCamera((pinchDistance - d) * 1.35);
      }
      pinchDistance = d;
      ev.preventDefault();
    }
  }, {passive:false});
  canvas.addEventListener('touchend', ev=>{ if(ev.touches.length < 2) pinchDistance = 0; }, {passive:false});
  canvas.addEventListener('touchcancel', ()=>{ pinchDistance = 0; }, {passive:false});

  let lookPointerId = null;
  let lookLastX = 0;
  let lookLastY = 0;
  const allowTouchLook = ()=> EXPORTED_GALLERY_VIEWER || IS_TOUCH_DEVICE;
  canvas.addEventListener('pointerdown', ev=>{
    if(!allowTouchLook() || ev.pointerType === 'mouse' || isInsideMobileControls(ev.target)) return;
    if(lookPointerId !== null) return;
    ev.preventDefault();
    ev.stopPropagation();
    lookPointerId = ev.pointerId;
    lookLastX = ev.clientX;
    lookLastY = ev.clientY;
    try{ canvas.setPointerCapture?.(ev.pointerId); }catch{}
  }, {passive:false});
  canvas.addEventListener('pointermove', ev=>{
    if(ev.pointerId !== lookPointerId) return;
    ev.preventDefault();
    ev.stopPropagation();
    const dx = ev.clientX - lookLastX;
    const dy = ev.clientY - lookLastY;
    lookLastX = ev.clientX;
    lookLastY = ev.clientY;
    camYaw -= dx * .006;
    camPitch = clamp(camPitch - dy * .0048, CAMERA_PITCH_MIN, CAMERA_PITCH_MAX);
  }, {passive:false});
  const stopLook = ev=>{
    if(ev.pointerId !== lookPointerId) return;
    lookPointerId = null;
    try{ canvas.releasePointerCapture?.(ev.pointerId); }catch{}
  };
  canvas.addEventListener('pointerup', stopLook, {passive:false});
  canvas.addEventListener('pointercancel', stopLook, {passive:false});
}


function pointerLockTargetElement(){
  return renderer?.domElement || $('canvas') || document.body;
}

function hasActivePointerLock(){
  const target = pointerLockTargetElement();
  return document.pointerLockElement === target || document.pointerLockElement === document.body || document.pointerLockElement === $('canvas');
}

// Pointer Lock may be declined by file/local browser contexts; keep the
// request path resilient and let the relative-look fallback take over.
function requestStablePointerLock(){
  const target = pointerLockTargetElement();
  const handleRejectedLock = ()=>{
    pointerLocked = false;
    if(desiredPointerLocked && !cursorFreeMode){
      fallbackMouseLook = !IS_TOUCH_DEVICE;
      resetFallbackLookAnchor();
      updateCursorVisibility();
    }
  };
  const request = element=>{
    if(!element?.requestPointerLock) return false;
    try{
      const pending = element.requestPointerLock();
      pending?.catch?.(handleRejectedLock);
      return true;
    }catch(err){
      return false;
    }
  };
  if(!request(target) && target !== document.body && !request(document.body)) handleRejectedLock();
}

function resetFallbackLookAnchor(){
  fallbackLookAnchorX = fallbackPointerX;
  fallbackLookAnchorY = fallbackPointerY;
  fallbackLookAxisX = 0;
  fallbackLookAxisY = 0;
}

function applyCameraLookDelta(dx=0, dy=0){
  if(dx){
    const nextYaw = camYaw - dx * .006;
    camYaw = Math.atan2(Math.sin(nextYaw), Math.cos(nextYaw));
  }
  if(dy) camPitch = clamp(camPitch - dy * .0048, CAMERA_PITCH_MIN, CAMERA_PITCH_MAX);
}

function updateFallbackLookAxis(e){
  // Pointer Lock can be unavailable under file:// and embedded browsers.
  // Apply only deltas produced by real mouse events. Edge-driven per-frame
  // rotation made the camera keep spinning after the pointer reached a side.
  const x = clamp(safeFinite(e?.clientX, fallbackPointerX), 0, innerWidth);
  const y = clamp(safeFinite(e?.clientY, fallbackPointerY), 0, innerHeight);
  let dx = safeFinite(e?.movementX,0);
  let dy = safeFinite(e?.movementY,0);
  if(!dx && Number.isFinite(e?.clientX)) dx = x - fallbackLookAnchorX;
  if(!dy && Number.isFinite(e?.clientY)) dy = y - fallbackLookAnchorY;
  fallbackLookAnchorX = x;
  fallbackLookAnchorY = y;
  fallbackLookAxisX = 0;
  fallbackLookAxisY = 0;
  applyCameraLookDelta(dx, dy);
}

function updateFallbackCameraLook(){
  // Camera movement is event-driven in fallback mode; never retain an axis.
  fallbackLookAxisX = 0;
  fallbackLookAxisY = 0;
}


function prepareExportedViewerDom(){
  document.body.classList.add('exported-viewer','play-mode');
    for(const id of ['hud','status','sinProEditor','editor','objectPanel','lightPanel','chiselPanel','surfaceTextureInput','referenceArchitectureTextureInput','waterContainerTextureInput','skyTextureInput','artworkFileInput']){
    const el = $(id);
    if(el) el.remove();
  }
  if(!$('viewerEscHint')){
    const hint = document.createElement('div');
    hint.id = 'viewerEscHint';
    hint.textContent = 'ESC 返回上一頁';
    document.body.appendChild(hint);
  }
}

function goBackFromExportedViewer(){
  try{
    if(document.referrer && history.length <= 1){ location.href = document.referrer; return; }
    history.back();
  }catch{
    if(document.referrer) location.href = document.referrer;
  }
}

function handleExportedViewerKeyDown(e){
  if(e.repeat && e.code === 'Escape') return;
  if(e.code === 'Escape'){
    e.preventDefault();
    e.stopPropagation();
    goBackFromExportedViewer();
    return;
  }
  if(e.code==='KeyW' || e.code==='ArrowUp'){ keys.w = true; e.preventDefault(); }
  if(e.code==='KeyA' || e.code==='ArrowLeft'){ keys.a = true; e.preventDefault(); }
  if(e.code==='KeyS' || e.code==='ArrowDown'){ keys.s = true; e.preventDefault(); }
  if(e.code==='KeyD' || e.code==='ArrowRight'){ keys.d = true; e.preventDefault(); }
  if(e.code==='Space'){ e.preventDefault(); jump(); }
}

function handleExportedViewerKeyUp(e){
  if(e.code==='KeyW' || e.code==='ArrowUp') keys.w = false;
  if(e.code==='KeyA' || e.code==='ArrowLeft') keys.a = false;
  if(e.code==='KeyS' || e.code==='ArrowDown') keys.s = false;
  if(e.code==='KeyD' || e.code==='ArrowRight') keys.d = false;
}

function enterExportedViewerMode(){
  cursorFreeMode = false;
  desiredPointerLocked = false;
  pointerLocked = false;
  fallbackMouseLook = !IS_TOUCH_DEVICE;
  selectedWallId = null;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedWaterBodyId = null;
  selectedArtworkActive = false;
  selectedReferenceArchitectureActive = false;
  selectedLightObjectActive = false;
  STATE.lightBake = sanitizeLightBake(STATE?.lightBake);
  STATE.lightBake.enabled = true;
  STATE.lightBake.useInPlayMode = true;
  STATE.lightBake.stale = false;
  STATE.lightBake.mode = 'shadowCache';
  STATE.lightBake.brightness = 1;
  forceUpdateShadowMapsForLightingBake();
  document.body.classList.add('exported-viewer','play-mode');
  updateCursorVisibility();
  applyPlayModePerformanceLighting(true);
}


function enterDefaultSinTowerPlayMode(){
  if(EXPORTED_GALLERY_VIEWER) return;
  pendingEscRelock = false;
  sinTowerStonePickMode.active = false;
  sinTowerStonePickMode.selectedId = null;
  document.body.classList.remove('sin-stone-pick-mode');
  if(sinTowerStoneCarry.active) placeSinTowerCarriedStone();
  cameraViewMode = 'shoulder';
  cursorFreeMode = false;
  desiredPointerLocked = true;
  pointerLocked = hasActivePointerLock();
  fallbackMouseLook = !pointerLocked && !IS_TOUCH_DEVICE;
  resetFallbackLookAnchor();
  ctrlViewDrag = false;
  ctrlViewDragLastX = 0;
  ctrlViewDragLastY = 0;
  ctrlViewDragPointerId = null;
  clearSelectableSelection();
  forceSelectableOpaque();
  hideChiselPreview();
  document.activeElement?.blur?.();
  sinTowerPlayObjectUi.cursorEditMode = false;
  closeSinTowerPlayPropActions(true);
  document.body.classList.remove('sin-pro-editor-active');
  document.body.classList.add('play-mode');
  updateCursorVisibility();
  applyPlayModePerformanceLighting(true);
}


function setSinPlayObjectStatus(message){
  const el = $('sinPlayObjectStatus');
  if(el) el.textContent = message;
}

function setSinTowerModalCursorFree(){
  document.body.classList.remove('sin-cursor-closing');
  pendingEscRelock = false;
  desiredPointerLocked = false;
  fallbackMouseLook = false;
  pointerLocked = false;
  cursorFreeMode = true;
  resetFallbackLookAnchor();
  try{ if(document.pointerLockElement) document.exitPointerLock?.(); }catch(e){}
  updateCursorVisibility();
}

function restoreSinTowerPlayLook(requestLock=false){
  if(EXPORTED_GALLERY_VIEWER){
    enterExportedViewerMode();
    return;
  }
  enterDefaultSinTowerPlayMode();
  if(requestLock && !IS_TOUCH_DEVICE) requestStablePointerLock();
}

function setSinPlayCoordinate(axis, value, updateRange=true){
  const key = axis.toUpperCase();
  const number = $('sinPlayObject' + key);
  const range = $('sinPlayObject' + key + 'Range');
  const v = safeFinite(value,0);
  if(number) number.value = String(+v.toFixed(3));
  if(range && updateRange) range.value = String(v);
}

function prepareSinPlayCoordinate(axis, value, radius){
  const key = axis.toUpperCase();
  const range = $('sinPlayObject' + key + 'Range');
  if(range){
    range.min = String(value - radius);
    range.max = String(value + radius);
    range.value = String(value);
  }
  setSinPlayCoordinate(axis, value);
}

function fillSinTowerPortalSceneSelect(select,selectedId,labelCurrent=false){
  if(!select) return;
  select.innerHTML='';
  for(const sceneState of SIN_TOWER_EDITOR.scenes){
    const suffix=labelCurrent&&sceneState.id===SIN_TOWER_EDITOR.activeSceneId?'（目前場景）':'';
    select.add(new Option(sceneState.title+suffix,sceneState.id));
  }
  if(SIN_TOWER_EDITOR.scenes.some(sceneState=>sceneState.id===selectedId)) select.value=selectedId;
}

function syncSinTowerPlayPortalTargets(){
  const source=$('sinPlayPortalSource'),target=$('sinPlayPortalTarget');
  if(!source||!target) return;
  const previousSource=source.value||SIN_TOWER_EDITOR.activeSceneId;
  const previousTarget=target.value;
  fillSinTowerPortalSceneSelect(source,previousSource,true);
  if(!source.value) source.value=SIN_TOWER_EDITOR.activeSceneId;
  fillSinTowerPortalSceneSelect(target,previousTarget,true);
  if((!target.value||target.value===source.value)&&SIN_TOWER_EDITOR.scenes.length>1){
    target.value=SIN_TOWER_EDITOR.scenes.find(sceneState=>sceneState.id!==source.value)?.id||source.value;
  }
}

function prepareSinTowerPortalSourcePlacement(){
  const sourceScene=getSinTowerSceneById($('sinPlayPortalSource')?.value)||getSinTowerActiveScene();
  if(!sourceScene) return;
  const sameScene=sourceScene.id===SIN_TOWER_EDITOR.activeSceneId;
  const base=sameScene?player.position:sourceScene.spawn;
  const x=safeFinite(base?.x,0),y=safeFinite(base?.y,0)+1.3,z=safeFinite(base?.z,0);
  prepareSinPlayCoordinate('x',x,sourceScene.type==='stairs'?Math.max(8,SIN_TOWER_STAIRCASE.width*.65):Math.max(10,sourceScene.dimensions?.w||20));
  prepareSinPlayCoordinate('y',y,Math.max(8,sourceScene.dimensions?.h||12));
  prepareSinPlayCoordinate('z',z,sourceScene.type==='stairs'?50:Math.max(16,sourceScene.dimensions?.d||32));
  syncSinTowerPlayPortalTargets();
}

function syncSinPlayObjectPanelVisibility(){
  const panel = $('sinPlayAddPanel');
  if(!panel) return;
  const requested = $('sinPlayObjectMediaType')?.value;
  const media = requested === 'video' ? 'video' : requested === 'gif' ? 'gif' : requested === 'model' ? 'model' : requested === 'portal' ? 'portal' : 'png';
  panel.dataset.media = media;
  const interactionEnabled = !!$('sinPlayInteractionEnabled')?.checked;
  const interactionFields = $('sinPlayInteractionFields');
  if(interactionFields) interactionFields.hidden = !interactionEnabled;
  const requestedInteractionType = $('sinPlayInteractionType')?.value || 'text';
  const interactionType = ['text','media','question','rps'].includes(requestedInteractionType) ? requestedInteractionType : 'text';
  if($('sinPlayTextFields')) $('sinPlayTextFields').hidden = !interactionEnabled || interactionType !== 'text';
  if($('sinPlayQuestionFields')) $('sinPlayQuestionFields').hidden = !interactionEnabled || interactionType !== 'question';
  if($('sinPlayMediaFields')) $('sinPlayMediaFields').hidden = !interactionEnabled || interactionType !== 'media';
  if($('sinPlayPortalPassword')) $('sinPlayPortalPassword').disabled = !$('sinPlayPortalPasswordEnabled')?.checked;
  const repeatEnabled = !!$('sinPlayRepeatEnabled')?.checked;
  if($('sinPlayRepeatFields')) $('sinPlayRepeatFields').hidden = !repeatEnabled;
}

function openSinTowerPlayAddPanel(){
  if(SIN_TOWER_PUBLISHED)return;
  if(EXPORTED_GALLERY_VIEWER || sinTowerPlayObjectUi.activePropId) return;
  sinTowerPlayObjectUi.panelOpen = true;
  sinTowerPlayObjectUi.panelPreviousAutoRun = !!SIN_TOWER_STAIRCASE.autoRun;
  SIN_TOWER_STAIRCASE.autoRun = false;
  playAction('idle');
  const active = getSinTowerActiveScene();
  syncSinTowerPlayPortalTargets();
  const isStairs = active?.type === 'stairs';
  const px = safeFinite(player?.position?.x,0);
  const py = safeFinite(player?.position?.y,0) + .02;
  const pz = safeFinite(player?.position?.z,0);
  prepareSinPlayCoordinate('x', px, isStairs ? Math.max(8,SIN_TOWER_STAIRCASE.width*.65) : Math.max(10,active?.dimensions?.w || 20));
  prepareSinPlayCoordinate('y', py, Math.max(8,active?.dimensions?.h || 12));
  prepareSinPlayCoordinate('z', pz, isStairs ? 50 : Math.max(16,active?.dimensions?.d || 32));
  if($('sinPlayFollowStairs')){
    $('sinPlayFollowStairs').checked = isStairs;
    $('sinPlayFollowStairs').disabled = !isStairs;
  }
  if($('sinPlayRepeatEnabled')){
    $('sinPlayRepeatEnabled').checked = false;
    $('sinPlayRepeatEnabled').disabled = !isStairs;
  }
  if($('sinPlayObjectName')) $('sinPlayObjectName').value = isStairs ? '樓梯異象' : '教堂遺物';
  setSinPlayObjectStatus('物件會建立在目前角色位置；可先用滑桿或數值微調。');
  syncSinPlayObjectPanelVisibility();
  document.body.classList.add('play-mode','sin-play-add-open');
  $('sinPlayAddPanel')?.setAttribute('aria-hidden','false');
  setSinTowerModalCursorFree();
}

function closeSinTowerPlayAddPanel(restore=true, requestLock=false){
  if(!sinTowerPlayObjectUi.panelOpen && !document.body.classList.contains('sin-play-add-open')) return;
  sinTowerPlayObjectUi.panelOpen = false;
  document.body.classList.remove('sin-play-add-open');
  $('sinPlayAddPanel')?.setAttribute('aria-hidden','true');
  clearMovementKeys();
  document.activeElement?.blur?.();
  SIN_TOWER_STAIRCASE.autoRun = !!sinTowerPlayObjectUi.panelPreviousAutoRun;
  if(restore) restoreSinTowerPlayLook(requestLock);
}

function readSinTowerVideoMetadata(src){
  return new Promise(resolve=>{
    const video = document.createElement('video');
    let done = false;
    const finish = ()=>{
      if(done) return;
      done = true;
      const ratio = video.videoWidth && video.videoHeight ? video.videoWidth / video.videoHeight : 16/9;
      video.removeAttribute('src');
      video.load?.();
      resolve({ratio});
    };
    video.preload = 'metadata';
    video.onloadedmetadata = finish;
    video.onerror = finish;
    video.src = src;
    setTimeout(finish, 1800);
  });
}

function readSinTowerGifMetadata(src){
  return new Promise(resolve=>{
    const image = new Image();
    let done = false;
    const finish=()=>{if(done)return;done=true;resolve({ratio:image.naturalWidth&&image.naturalHeight?image.naturalWidth/image.naturalHeight:1});};
    image.onload=finish;
    image.onerror=finish;
    image.src=src;
    setTimeout(finish,1800);
  });
}

async function readSinTowerGifFile(file){
  if(!file) return {dataUrl:null,ratio:1,name:''};
  if(file.size > 24*1024*1024) throw new Error('GIF 超過 24 MB，請先縮小尺寸或減少影格。');
  const signature = await file.slice(0,6).text();
  if(signature !== 'GIF87a' && signature !== 'GIF89a') throw new Error('檔案內容不是有效的 GIF 動畫。');
  const dataUrl = await readFileAsDataURL(file);
  if(typeof dataUrl !== 'string' || !(/^data:image\/gif(?:;|,)/i.test(dataUrl)||sinPublishedAssetMatches(dataUrl,/^data:image\/gif(?:;|,)/i))) throw new Error('無法辨識 GIF 格式。');
  const meta = await readSinTowerGifMetadata(dataUrl);
  return {dataUrl,ratio:meta.ratio,name:file.name||''};
}

async function readSinTowerPlayModelFiles(){
  const file = $('sinPlayObjectGlb')?.files?.[0];
  if(!file || !/\.glb$/i.test(file.name || '')) throw new Error('請先選擇 GLB 2.0 模型檔。');
  if(file.size > 90 * 1024 * 1024) throw new Error('GLB 超過 90 MB，請先減面或壓縮後再匯入。');
  const runtimeBuffer = await file.arrayBuffer();
  validateSinTowerGlbBuffer(runtimeBuffer);
  const textureFile = $('sinPlayObjectModelTexture')?.files?.[0];
  let textureDataUrl = null;
  if(textureFile){
    if(!/^image\//i.test(textureFile.type || '') && !/\.(png|jpe?g|webp)$/i.test(textureFile.name || '')) throw new Error('模型貼圖請使用 PNG、JPG 或 WebP。');
    textureDataUrl = await optimizeImageFileForDataUrl(textureFile,{maxSize:SIN_TOWER_EDITOR.perf.textureMaxSize,quality:SIN_TOWER_EDITOR.perf.textureQuality,preserveAlpha:/png|webp/i.test(textureFile.type || textureFile.name || '')});
  }
  const modelDataUrl = await readFileAsDataURL(file);
  return {file,runtimeBuffer,modelDataUrl,textureFile,textureDataUrl};
}

async function readSinTowerVideoFile(file){
  if(!file) return {dataUrl:null,ratio:16/9,name:''};
  if(file.size > 120 * 1024 * 1024) throw new Error('影片超過 120 MB，請先壓縮後再匯入。');
  const dataUrl = await readFileAsDataURL(file);
  if(typeof dataUrl !== 'string' || !(dataUrl.startsWith('data:video/')||sinPublishedAssetMatches(dataUrl,"data:video/"))) throw new Error('無法辨識影片格式，請使用 MP4、WebM 或 OGV。');
  const meta = await readSinTowerVideoMetadata(dataUrl);
  return {dataUrl,ratio:meta.ratio,name:file.name || ''};
}

async function readSinTowerAudioFile(file){
  if(!file)throw new Error('請先選擇音效檔案。');
  if(file.size>64*1024*1024)throw new Error('音效超過 64 MB，請先壓縮為 MP3、OGG、AAC 或較短的 WAV。');
  const ext=String(file.name||'').split('.').pop().toLowerCase(),mimeByExt={mp3:'audio/mpeg',wav:'audio/wav',ogg:'audio/ogg',oga:'audio/ogg',m4a:'audio/mp4',aac:'audio/aac',flac:'audio/flac',webm:'audio/webm'};
  if(!String(file.type||'').toLowerCase().startsWith('audio/')&&!mimeByExt[ext])throw new Error('不支援的音效格式；請使用 MP3、WAV、OGG、M4A、AAC、FLAC 或 WebM 音訊。');
  let dataUrl=await readFileAsDataURL(file);const mime=(file.type&&String(file.type).toLowerCase().startsWith('audio/')?file.type:mimeByExt[ext])||'audio/mpeg';
  if(typeof dataUrl==='string'&&!(dataUrl.startsWith('data:audio/')||sinPublishedAssetMatches(dataUrl,"data:audio/")))dataUrl=dataUrl.replace(/^data:[^;,]*/, 'data:'+mime);
  if(typeof dataUrl!=='string'||!(dataUrl.startsWith('data:audio/')||sinPublishedAssetMatches(dataUrl,"data:audio/")))throw new Error('無法讀取這個音效檔案。');
  return {dataUrl,name:String(file.name||'音效').slice(0,180)};
}

function sinTowerPropPlacementFromWorld(world, followStairs, sceneOverride=null){
  const active = sceneOverride || getSinTowerActiveScene();
  const position = sinTowerEditorVec3(world,{x:0,y:0,z:0});
  if(active?.type !== 'stairs' || !followStairs){
    return {position,step:getSinTowerCurrentStepIndex(),offset:{...position},followStairs:false};
  }
  const step = Math.max(0, Math.floor(sinTowerStepIndexAtWorld(position.x, position.z)));
  const base = sinTowerWorldPositionFromStep(step,{x:0,y:0,z:0});
  return {
    position,
    step,
    offset:{x:position.x-base.x,y:position.y-base.y,z:position.z-base.z},
    followStairs:true
  };
}

function armSinTowerCreatedInteraction(id,type,resumeAutoRun){
  const isModel=type==='model';
  SIN_TOWER_STAIRCASE.autoRun=false;
  let attempts=0;
  const inspect=()=>{
    if(sinTowerPlayObjectUi.panelOpen){requestAnimationFrame(inspect);return;}
    const rec=isModel?sinTowerEditorRuntime.models.get(id):sinTowerEditorRuntime.props.get(id);
    const ready=isModel?!!rec?.group:!!rec?.visuals?.length;
    if(!ready){
      if(++attempts<240){requestAnimationFrame(inspect);return;}
      SIN_TOWER_STAIRCASE.autoRun=!!resumeAutoRun;
      return;
    }
    const object=rec.model||rec.prop;
    let nearest=null;
    if(isModel){
      const position=rec.group.getWorldPosition(new THREE.Vector3());
      nearest={position,distance:Math.hypot(player.position.x-position.x,player.position.z-position.z,(player.position.y-position.y)*.35)};
    }else nearest=nearestSinTowerPropVisual(rec);
    const radius=safeFinite(object?.interaction?.radius,3.2);
    if(nearest&&nearest.distance<=radius){
      openSinTowerInteraction(rec,nearest);
      if(sinTowerPlayObjectUi.activePropId===id) sinTowerPlayObjectUi.previousAutoRun=!!resumeAutoRun;
      else SIN_TOWER_STAIRCASE.autoRun=!!resumeAutoRun;
    }else SIN_TOWER_STAIRCASE.autoRun=!!resumeAutoRun;
  };
  requestAnimationFrame(inspect);
}

async function createSinTowerPlayObject(){
  const button = $('sinPlayCreateObject');
  if(button?.disabled) return;
  if(button) button.disabled = true;
  try{
    const mediaChoice = $('sinPlayObjectMediaType')?.value;
    const mediaType = mediaChoice === 'video' ? 'video' : mediaChoice === 'gif' ? 'gif' : mediaChoice === 'model' ? 'model' : mediaChoice === 'portal' ? 'portal' : 'pngSequence';
    if(mediaType === 'portal'){
      const sourceScene=getSinTowerSceneById($('sinPlayPortalSource')?.value)||getSinTowerActiveScene();
      if(!sourceScene) throw new Error('請先選擇傳送門起點場景。');
      const world={x:safeFinite($('sinPlayObjectX')?.value,player.position.x),y:safeFinite($('sinPlayObjectY')?.value,player.position.y+1.3),z:safeFinite($('sinPlayObjectZ')?.value,player.position.z)};
      const placement=sinTowerPropPlacementFromWorld(world,sourceScene.type==='stairs',sourceScene);
      const scale=clamp(safeFinite($('sinPlayPortalScale')?.value,1),.2,240);
      const style=clamp(Math.floor(safeFinite($('sinPlayPortalStyle')?.value,1)),1,10);
      const portal=sanitizeSinTowerEditorPortal({id:uid('portal'),sceneId:sourceScene.id,targetSceneId:String($('sinPlayPortalTarget')?.value||sourceScene.id),title:String($('sinPlayObjectName')?.value||getSinTowerPortalStylePreset(style).name+'傳送門'),step:placement.step,offset:placement.offset,width:1.8*scale,height:2.6*scale,uniformScale:scale,portalStyle:style,color:$('sinPlayPortalColor')?.value||getSinTowerPortalStylePreset(style).color,passwordEnabled:!!$('sinPlayPortalPasswordEnabled')?.checked,password:$('sinPlayPortalPassword')?.value});
      SIN_TOWER_EDITOR.portals.push(portal);
      SIN_TOWER_EDITOR.selectedObjectType='portal';
      SIN_TOWER_EDITOR.selectedObjectId=portal.id;
      buildSinTowerEditorPortal(portal);
      scheduleSinTowerRuntimeSave();
      setStatus('已建立魔法傳送門：'+portal.title+'；樣式 '+String(style).padStart(2,'0')+'；等比例尺寸 '+scale.toFixed(2)+'。');
      closeSinTowerPlayAddPanel(true,true);
      return;
    }
    setSinPlayObjectStatus('正在處理素材……');
    let frames = [];
    let gif = {dataUrl:null,ratio:1,name:''};
    let video = {dataUrl:null,ratio:16/9,name:''};
    let modelSource = null;
    if(mediaType === 'model'){
      setSinPlayObjectStatus('正在驗證並準備 GLB 模型……');
      modelSource = await readSinTowerPlayModelFiles();
    }else if(mediaType === 'video'){
      video = await readSinTowerVideoFile($('sinPlayObjectVideo')?.files?.[0]);
      if(!video.dataUrl) throw new Error('請先選擇物件影片。');
    }else if(mediaType === 'gif'){
      gif = await readSinTowerGifFile($('sinPlayObjectGif')?.files?.[0]);
      if(!gif.dataUrl) throw new Error('請先選擇 GIF 動畫。');
    }else{
      frames = await readSinTowerEditorPngFrames($('sinPlayObjectPng')?.files);
      if(!frames.length) throw new Error('請先選擇含 PNG 影格的資料夾。');
    }
    let interactionVideo = {dataUrl:null,name:''};
    const interactionEnabled = !!$('sinPlayInteractionEnabled')?.checked;
    const requestedInteractionType = $('sinPlayInteractionType')?.value || 'text';
  const interactionType = ['text','media','question','rps'].includes(requestedInteractionType) ? requestedInteractionType : 'text';
    const questionText = String($('sinPlayQuestionText')?.value || '').trim();
    if(interactionEnabled && interactionType === 'question' && !questionText) throw new Error('請先輸入第一個問題。');
    const interactionFile = $('sinPlayInteractionVideo')?.files?.[0];
    if(interactionEnabled && interactionType === 'media' && interactionFile){
      interactionVideo = await readSinTowerVideoFile(interactionFile);
    }
    const world = {
      x:safeFinite($('sinPlayObjectX')?.value,player.position.x),
      y:safeFinite($('sinPlayObjectY')?.value,player.position.y),
      z:safeFinite($('sinPlayObjectZ')?.value,player.position.z)
    };
    const interaction = {
      enabled:interactionEnabled,
      glowEnabled:$('sinPlayInteractionGlow')?.checked !== false,
      particleCount:840,
      dissolveParticleCount:4200,
      dissolveDensity:1.6,
      consumed:false,
      type:interactionType,
      radius:safeFinite($('sinPlayInteractionRadius')?.value,3.2),
      title:String($('sinPlayInteractionTitle')?.value || $('sinPlayObjectName')?.value || '被遺忘的手稿'),
      text:String($('sinPlayInteractionText')?.value || ''),
      fontFamily:String($('sinPlayInteractionFont')?.value || 'serif'),
      titleSize:clamp(safeFinite($('sinPlayInteractionTitleSize')?.value,38),1,72),
      bodySize:clamp(safeFinite($('sinPlayInteractionBodySize')?.value,18),1,42),
      backgroundOpacity:.85,
      cornerRadius:6,
      vhsIntensity:1,
      vhsScanDensity:6,
      vhsOffset:10,
      vhsSpeed:5,
      vhsNoise:.24,
      questions:interactionType === 'question' ? [{id:uid('question'),text:questionText}] : [],
      questionTypewriterCps:22,
      questionTextSize:23,
      questionTextOpacity:1,
      answers:[],
      videoDataUrl:interactionVideo.dataUrl,
      videoName:interactionVideo.name
    };
    if(mediaType === 'model'){
      const scale = clamp(safeFinite($('sinPlayModelScale')?.value,1),.01,2000);
      const model = sanitizeSinTowerEditorModel({
        id:uid('model'),sceneId:SIN_TOWER_EDITOR.activeSceneId,
        title:String($('sinPlayObjectName')?.value || modelSource.file.name.replace(/\.[^.]+$/,'')),
        modelDataUrl:modelSource.modelDataUrl,modelName:modelSource.file.name,
        textureDataUrl:modelSource.textureDataUrl,textureName:modelSource.textureFile?.name || '',
        position:world,
        rotation:{x:safeFinite($('sinPlayModelRotX')?.value,0),y:safeFinite($('sinPlayModelRotY')?.value,0),z:safeFinite($('sinPlayModelRotZ')?.value,0)},
        scale:{x:scale,y:scale,z:scale},interaction
      });
      if(!model.modelDataUrl) throw new Error('瀏覽器未能保存 GLB 資料；請重新選擇檔案。');
      Object.defineProperty(model,'_runtimeArrayBuffer',{value:modelSource.runtimeBuffer,writable:true,configurable:true,enumerable:false});
      Object.defineProperty(model,'_importPending',{value:true,writable:true,configurable:true,enumerable:false});
      SIN_TOWER_EDITOR.models.push(model);
      SIN_TOWER_EDITOR.selectedObjectType = 'model';
      SIN_TOWER_EDITOR.selectedObjectId = model.id;
      sinTowerPlayObjectUi.interactionCooldownUntil = performance.now() + 80; 
      await buildSinTowerEditorModel(model);
      if(!sinTowerEditorRuntime.models.has(model.id)){
        SIN_TOWER_EDITOR.models = SIN_TOWER_EDITOR.models.filter(item=>item.id !== model.id);
        throw new Error('GLB 已讀取，但建立 3D 場景物件失敗。');
      }
      scheduleSinTowerRuntimeSave();
      syncSinProEditor?.();
      for(const id of ['sinPlayObjectGlb','sinPlayObjectModelTexture','sinPlayInteractionVideo']) if($(id)) $(id).value='';
      setStatus('已建立 3D 模型：' + model.title + (model.textureDataUrl ? '；外部貼圖已依 UV 套用。' : '；使用 GLB 內建材質。'));
      const resumeInteractionAutoRun=!!sinTowerPlayObjectUi.panelPreviousAutoRun;
      if(interactionEnabled) sinTowerPlayObjectUi.panelPreviousAutoRun=false;
      closeSinTowerPlayAddPanel(true,true);
      if(interactionEnabled) armSinTowerCreatedInteraction(model.id,'model',resumeInteractionAutoRun);
      return;
    }
    const followStairs = getSinTowerActiveScene()?.type === 'stairs' && !!$('sinPlayFollowStairs')?.checked;
    const placement = sinTowerPropPlacementFromWorld(world, followStairs);
    const prop = sanitizeSinTowerEditorProp({
      id:uid('prop'),
      sceneId:SIN_TOWER_EDITOR.activeSceneId,
      title:String($('sinPlayObjectName')?.value || (mediaType === 'video' ? '影片物件' : mediaType === 'gif' ? 'GIF 動畫物件' : 'PNG 物件')).trim(),
      mediaType,
      gifDataUrl:gif.dataUrl,
      gifName:gif.name,
      gifRatio:gif.ratio,
      videoDataUrl:video.dataUrl,
      videoName:video.name,
      videoRatio:video.ratio,
      frames,
      ...placement,
      repeatOnStairs:followStairs && !!$('sinPlayRepeatEnabled')?.checked,
      repeatEvery:safeFinite($('sinPlayRepeatEvery')?.value,20),
      repeatVariance:safeFinite($('sinPlayRepeatVariance')?.value,20),
      repeatSeed:Date.now() % 1000000,
      height:safeFinite($('sinPlayObjectHeight')?.value,3),
      widthMul:1,
      fps:safeFinite($('sinPlayObjectFps')?.value,8),
      motion:'static',
      interaction
    });
    SIN_TOWER_EDITOR.props.push(prop);
    SIN_TOWER_EDITOR.selectedObjectType = 'prop';
    SIN_TOWER_EDITOR.selectedObjectId = prop.id;
    sinTowerPlayObjectUi.interactionCooldownUntil = performance.now() + 80; 
    await buildSinTowerEditorProp(prop);
    if(!sinTowerEditorRuntime.props.has(prop.id)){SIN_TOWER_EDITOR.props=SIN_TOWER_EDITOR.props.filter(item=>item.id!==prop.id);throw new Error('素材已讀取，但建立場景物件失敗。');}
    scheduleSinTowerRuntimeSave();
    for(const id of ['sinPlayObjectPng','sinPlayObjectGif','sinPlayObjectVideo','sinPlayObjectGlb','sinPlayObjectModelTexture','sinPlayInteractionVideo']) if($(id)) $(id).value = '';
    const mediaLabel = mediaType === 'video' ? '影片' : mediaType === 'gif' ? ' GIF 動畫' : ' PNG 序列';
    setStatus('已在角色位置建立' + mediaLabel + '物件：' + prop.title + (prop.repeatOnStairs ? ('；每隔 ' + prop.repeatEvery + '～' + (prop.repeatEvery + prop.repeatVariance) + ' 階出現') : '') + '。');
    const resumeInteractionAutoRun=!!sinTowerPlayObjectUi.panelPreviousAutoRun;
    if(interactionEnabled) sinTowerPlayObjectUi.panelPreviousAutoRun=false;
    closeSinTowerPlayAddPanel(true, true);
    if(interactionEnabled) armSinTowerCreatedInteraction(prop.id,'prop',resumeInteractionAutoRun);
  }catch(err){
    console.warn('create play object failed', err);
    setSinPlayObjectStatus(err?.message || '物件建立失敗。');
  }finally{
    if(button) button.disabled = false;
  }
}

function bindSinTowerPlayObjectUi(){
  const panel = $('sinPlayAddPanel');
  if(!panel || panel.__sinPlayUiBound === true) return;
  panel.__sinPlayUiBound=true;
  panel.dataset.bound = '1';
  $('sinPlayAddButton').onclick = openSinTowerPlayAddPanel;
  $('sinPlayAddClose').onclick = ()=>closeSinTowerPlayAddPanel(true,true);
  $('sinPlayCreateObject').onclick = createSinTowerPlayObject;
  $('sinPlayObjectMediaType').onchange = ()=>{syncSinPlayObjectPanelVisibility();syncSinTowerPlayPortalTargets();if($('sinPlayObjectMediaType').value==='portal'){if($('sinPlayObjectName'))$('sinPlayObjectName').value='魔法傳送門';prepareSinTowerPortalSourcePlacement();}};
  if($('sinPlayPortalSource')) $('sinPlayPortalSource').onchange=prepareSinTowerPortalSourcePlacement;
  const portalScaleRange=$('sinPlayPortalScaleRange'),portalScaleNumber=$('sinPlayPortalScale');
  if(portalScaleRange) portalScaleRange.oninput=()=>{if(portalScaleNumber)portalScaleNumber.value=portalScaleRange.value;};
  if(portalScaleNumber) portalScaleNumber.oninput=()=>{if(portalScaleRange)portalScaleRange.value=portalScaleNumber.value;};
  if($('sinPlayPortalStyle')) $('sinPlayPortalStyle').onchange=()=>{const preset=getSinTowerPortalStylePreset($('sinPlayPortalStyle').value);if($('sinPlayPortalColor'))$('sinPlayPortalColor').value=preset.color;};
  if($('sinPlayPortalPasswordEnabled')) $('sinPlayPortalPasswordEnabled').onchange=syncSinPlayObjectPanelVisibility;
  if($('sinPlayPortalPassword')) $('sinPlayPortalPassword').oninput=event=>{event.target.value=String(event.target.value||'').toUpperCase().replace(/[^0-9A-F]/g,'').slice(0,4);};
  $('sinPlayInteractionEnabled').onchange = syncSinPlayObjectPanelVisibility;
  $('sinPlayInteractionType').onchange = syncSinPlayObjectPanelVisibility;
  $('sinPlayRepeatEnabled').onchange = syncSinPlayObjectPanelVisibility;
  for(const axis of ['X','Y','Z']){
    const range = $('sinPlayObject' + axis + 'Range');
    const number = $('sinPlayObject' + axis);
    if(range) range.oninput = ()=>{ if(number) number.value = range.value; };
    if(number) number.oninput = ()=>{ if(range) range.value = number.value; };
  }
  for(const axis of ['X','Y','Z']){ const range=$('sinPlayModelRot'+axis+'Range'),number=$('sinPlayModelRot'+axis); if(range) range.oninput=()=>{if(number) number.value=range.value;}; if(number) number.oninput=()=>{if(range) range.value=number.value;}; }
  $('sinPlayObjectPng').onchange = e=>setSinPlayObjectStatus('已選擇 ' + Array.from(e.target.files || []).filter(f=>/\.png$/i.test(f.name || '')).length + ' 張 PNG。');
  $('sinPlayObjectGif').onchange = e=>setSinPlayObjectStatus(e.target.files?.[0] ? ('已選擇 GIF：' + e.target.files[0].name) : '尚未選擇 GIF。');
  $('sinPlayObjectVideo').onchange = e=>setSinPlayObjectStatus(e.target.files?.[0] ? ('已選擇影片：' + e.target.files[0].name) : '尚未選擇影片。');
  $('sinPlayObjectGlb').onchange = e=>setSinPlayObjectStatus(e.target.files?.[0] ? ('已選擇 GLB：' + e.target.files[0].name) : '尚未選擇 GLB。');
  $('sinPlayObjectModelTexture').onchange = e=>setSinPlayObjectStatus(e.target.files?.[0] ? ('已選擇模型貼圖：' + e.target.files[0].name) : '未另選貼圖，將使用 GLB 內建材質。');
  $('sinInteractionClose').onclick = ()=>closeSinTowerInteraction(true,true);
  if($('sinQuestionClose'))$('sinQuestionClose').onclick=()=>closeSinTowerInteraction(true,true);
  for(const [id,answer] of [['sinQuestionNo','no'],['sinQuestionYes','yes']]){
    const button=$(id);if(!button)continue;
    button.onpointerdown=event=>event.stopPropagation();
    button.onclick=event=>{event.preventDefault();event.stopPropagation();answerSinTowerQuestion(answer);};
  }
  if($('sinQuestionBar')){
    $('sinQuestionBar').onpointerdown=beginSinTowerQuestionSwipe;
    $('sinQuestionBar').onpointermove=moveSinTowerQuestionSwipe;
    $('sinQuestionBar').onpointerup=endSinTowerQuestionSwipe;
    $('sinQuestionBar').onpointercancel=endSinTowerQuestionSwipe;
  }
  $('sinSelectedPropClose').onclick = ()=>closeSinTowerPlayPropActions(true);
  $('sinSelectedPropFollow').onclick = toggleSinTowerSelectedPropFollow;
  $('sinSelectedPropRotate').onclick = rotateSinTowerSelectedProp;
  $('sinSelectedPropDelete').onclick = deleteSinTowerSelectedPlayProp;
  $('sinSelectedPropScale').oninput = event=>resizeSinTowerSelectedProp(event.target.value);
  $('sinSelectedPropScale').onchange = event=>resizeSinTowerSelectedProp(event.target.value);
  if($('sinSelectedObjectAudioFile'))$('sinSelectedObjectAudioFile').onchange=async event=>{const file=event.target.files?.[0];try{if(file)await importSinTowerSelectedObjectAudio(file);}catch(error){setStatus('物件音效匯入失敗：'+String(error?.message||error));}event.target.value='';};
  if($('sinSelectedObjectAudioVolume'))$('sinSelectedObjectAudioVolume').oninput=updateSinTowerSelectedObjectAudioFromUi;
  if($('sinSelectedObjectAudioDistance'))$('sinSelectedObjectAudioDistance').oninput=updateSinTowerSelectedObjectAudioFromUi;
  if($('sinSelectedObjectAudioLoop'))$('sinSelectedObjectAudioLoop').onchange=updateSinTowerSelectedObjectAudioFromUi;
  if($('sinSelectedObjectAudioClear'))$('sinSelectedObjectAudioClear').onclick=()=>{const object=getSinTowerSelectedAudioObject();if(!object)return;object.audio=sanitizeSinTowerAudio(null,true);scheduleSinTowerRuntimeSave();syncSinTowerSelectedObjectAudioControls(object);updateSinTowerAudioRuntime(true);setStatus('已移除物件音效。');};
  for(const id of ['sinSelectedInteractionRadius','sinSelectedInteractionTitle','sinSelectedInteractionText','sinSelectedInteractionFont','sinSelectedInteractionTitleSize','sinSelectedInteractionBodySize','sinSelectedDocRadius','sinSelectedDocOpacity','sinSelectedVhsIntensity','sinSelectedVhsScan','sinSelectedVhsOffset','sinSelectedVhsSpeed','sinSelectedVhsNoise','sinSelectedQuestionSpeed','sinSelectedQuestionTextSize','sinSelectedQuestionTextOpacity','sinSelectedDissolveParticles','sinSelectedDissolveDensity']) if($(id)) $(id).oninput=updateSinTowerSelectedInteractionStyle;
  for(const id of ['sinSelectedInfectionEnabled','sinSelectedInfectionDirection','sinSelectedInfectionLayers'])if($(id))$(id).onchange=updateSinTowerSelectedInteractionStyle;
  if($('sinSelectedInteractionType'))$('sinSelectedInteractionType').onchange=updateSinTowerSelectedInteractionStyle;
  if($('sinSelectedInteractionPreview'))$('sinSelectedInteractionPreview').onclick=previewSinTowerSelectedInteraction;
  if($('sinSelectedQuestionAdd'))$('sinSelectedQuestionAdd').onclick=addSinTowerSelectedQuestion;
  if($('sinSelectedInteractionGlow')) $('sinSelectedInteractionGlow').onchange=updateSinTowerSelectedInteractionStyle;
  if($('sinSelectedInteractionParticles')) $('sinSelectedInteractionParticles').oninput=updateSinTowerSelectedInteractionStyle;
  for(const id of ['sinSelectedParticleAxisX','sinSelectedParticleAxisY','sinSelectedParticleAxisZ']) if($(id)) $(id).onchange=updateSinTowerSelectedInteractionStyle;
  for(const id of ['sinSelectedDriftEnabled','sinSelectedDriftX','sinSelectedDriftY','sinSelectedDriftZ']) if($(id)) $(id).onchange=updateSinTowerSelectedDrift;
  for(const id of ['sinSelectedDriftDistance','sinSelectedDriftSpeed','sinSelectedDriftIrregularity']) if($(id)) $(id).oninput=updateSinTowerSelectedDrift;
  if($('sinSelectedPortalSource')) $('sinSelectedPortalSource').onchange=updateSinTowerSelectedPortalRoute;
  if($('sinSelectedPortalTarget')) $('sinSelectedPortalTarget').onchange=updateSinTowerSelectedPortalRoute;
  if($('sinSelectedPortalPasswordEnabled')) $('sinSelectedPortalPasswordEnabled').onchange=updateSinTowerSelectedPortalSecurity;
  if($('sinSelectedPortalPassword')){
    $('sinSelectedPortalPassword').oninput=event=>{event.target.value=String(event.target.value||'').toUpperCase().replace(/[^0-9A-F]/g,'').slice(0,4);updateSinTowerSelectedPortalSecurity(false);};
    $('sinSelectedPortalPassword').onchange=()=>updateSinTowerSelectedPortalSecurity(true);
  }
  $('sinShortcutClose').onclick = ()=>closeSinTowerShortcutHelp(true,true);
  syncSinPlayObjectPanelVisibility();
}

function nearestSinTowerPropVisual(rec){
  let nearest=null,bestSquared=Infinity;
  for(const visual of rec?.visuals||[]){const p=visual?.group?.position;if(!p||visual.group.visible===false)continue;const dx=player.position.x-p.x,dz=player.position.z-p.z,dy=(player.position.y+player.height*.42-p.y)*.35,distanceSquared=dx*dx+dz*dz+dy*dy;if(distanceSquared<bestSquared){bestSquared=distanceSquared;nearest={visual,distanceSquared,position:p};}}
  if(nearest)nearest.distance=Math.sqrt(bestSquared);return nearest;
}

function getSinTowerInteractionFontStack(key){
  if(key === 'mono') return "'Courier New','Noto Sans TC',monospace";
  if(key === 'sans') return "Arial,'Noto Sans TC',sans-serif";
  if(key === 'gothic') return "'Noto Serif TC','Microsoft JhengHei',Georgia,serif";
  return "Georgia,'Noto Serif TC',serif";
}

function applySinTowerInteractionStyle(config){
  const paper = document.querySelector('.sin-interaction-paper');
  if(!paper) return;
  const opacity=clamp(safeFinite(config?.backgroundOpacity,.85),.05,1);
  const intensity=clamp(safeFinite(config?.vhsIntensity,1),0,2);
  const density=clamp(safeFinite(config?.vhsScanDensity,6),1,12);
  const offset=clamp(safeFinite(config?.vhsOffset,10),0,24);
  const speed=clamp(safeFinite(config?.vhsSpeed,5),0,20);
  const noise=clamp(safeFinite(config?.vhsNoise,.24),0,1);
  const cornerRadius=clamp(safeFinite(config?.cornerRadius,6),0,32);
  const questionTextSize=clamp(safeFinite(config?.questionTextSize,23),1,48);
  const questionTextOpacity=clamp(safeFinite(config?.questionTextOpacity,1),.1,1);
  const lineSize=clamp(8.2-density*.48,1.6,7.8);
  const paperColor=validColor(getScreenFxConfig()?.monoPaper)?getScreenFxConfig().monoPaper:'#f4d66f';
  paper.style.setProperty('--sin-interaction-font',getSinTowerInteractionFontStack(config?.fontFamily));
  paper.style.setProperty('--sin-interaction-title-size',clamp(safeFinite(config?.titleSize,38),1,72)+'px');
  paper.style.setProperty('--sin-interaction-body-size',clamp(safeFinite(config?.bodySize,18),1,42)+'px');
  paper.style.setProperty('--sin-doc-opacity',opacity.toFixed(3));
  paper.style.setProperty('--sin-doc-radius',cornerRadius.toFixed(1)+'px');
  paper.style.setProperty('--sin-doc-vhs-line-size',lineSize.toFixed(2)+'px');
  paper.style.setProperty('--sin-doc-vhs-noise',clamp(noise*intensity,0,1).toFixed(3));
  paper.style.setProperty('--sin-doc-vhs-speed',speed>0?Math.max(.08,2.8/(speed+.35)).toFixed(3)+'s':'999s');
  paper.style.setProperty('--hud-light',paperColor);
  const questionBar=$('sinQuestionBar');
  if(questionBar){
    questionBar.style.setProperty('--sin-doc-opacity',opacity.toFixed(3));
    questionBar.style.setProperty('--sin-doc-radius',cornerRadius.toFixed(1)+'px');
    questionBar.style.setProperty('--sin-question-font-size',questionTextSize.toFixed(1)+'px');
    questionBar.style.setProperty('--sin-question-text-opacity',questionTextOpacity.toFixed(3));
    questionBar.style.setProperty('--sin-doc-vhs-line-size',lineSize.toFixed(2)+'px');
    questionBar.style.setProperty('--sin-doc-vhs-noise',clamp(noise*intensity,0,1).toFixed(3));
    questionBar.style.setProperty('--sin-doc-vhs-speed',speed>0?Math.max(.08,2.8/(speed+.35)).toFixed(3)+'s':'999s');
  }
  $('sinInteractionVhsDisplacement')?.setAttribute('scale',(offset*intensity*.26).toFixed(2));
  $('sinInteractionVhsBorderDisplacement')?.setAttribute('scale',(offset*intensity).toFixed(2));
  $('sinInteractionVhsNoise')?.setAttribute('baseFrequency','0.006 '+(0.07+density*.019).toFixed(3));
  $('sinInteractionVhsBorderNoise')?.setAttribute('baseFrequency','0.004 '+(0.15+density*.045).toFixed(3));
}

function getSinTowerActiveInteractionRecord(){
  const id=sinTowerPlayObjectUi.activePropId;
  return id?(sinTowerEditorRuntime.props.get(id)||sinTowerEditorRuntime.models.get(id)||null):null;
}

function startSinTowerQuestionTypewriter(text,cps=22){
  const node=$('sinQuestionText'),characters=Array.from(String(text||'')),token=++sinTowerPlayObjectUi.questionTypewriterToken;
  if(!node)return;node.textContent='';node.scrollTop=0;node.classList.add('typing');
  const rate=clamp(safeFinite(cps,22),5,80),interval=Math.max(12,1000/rate);
  let visible=0;
  const tick=()=>{
    if(token!==sinTowerPlayObjectUi.questionTypewriterToken||!sinTowerPlayObjectUi.activePropId)return;
    visible=Math.min(characters.length,visible+1);
    node.textContent=characters.slice(0,visible).join('');node.scrollTop=node.scrollHeight;
    if(visible<characters.length)setTimeout(tick,interval);else node.classList.remove('typing');
  };
  tick();
}

function setSinTowerQuestionDrag(value=0){
  const bar=$('sinQuestionBar');
  const drag=clamp(safeFinite(value,0),-260,260);
  sinTowerPlayObjectUi.questionDragX=drag;
  bar?.style.setProperty('--sin-question-drag-x',drag.toFixed(1)+'px');
  if(bar) bar.dataset.direction=drag>36?'yes':drag<-36?'no':'';
}

function renderSinTowerActiveQuestion(){
  const rec=getSinTowerActiveInteractionRecord();
  const config=(rec?.prop||rec?.model)?.interaction;
  const questions=Array.isArray(config?.questions)?config.questions:[];
  if(!questions.length){closeSinTowerInteraction(true,false,true);return false;}
  sinTowerPlayObjectUi.questionIndex=clamp(Math.floor(safeFinite(sinTowerPlayObjectUi.questionIndex,0)),0,questions.length-1);
  const question=questions[sinTowerPlayObjectUi.questionIndex];
  startSinTowerQuestionTypewriter(question.text,config?.questionTypewriterCps);
  $('sinQuestionBar')?.classList.remove('dragging','answered');
  setSinTowerQuestionDrag(0);
  return true;
}

function openSinTowerQuestionInteraction(rec,nearest){
  if(isSinTowerInteractionPlacementActive())return;
  const object=rec?.prop||rec?.model,config=object?.interaction,overlay=$('sinQuestionOverlay');
  if(!object||!config?.enabled||config.consumed||config.dissolving||!Array.isArray(config.questions)||!config.questions.length||!overlay||sinTowerPlayObjectUi.panelOpen||sinTowerPlayObjectUi.activePropId)return;
  sinTowerPlayObjectUi.resultSession={object,type:config.type,preview:false,applied:false};
  sinTowerPlayObjectUi.activePropId=object.id;
  sinTowerPlayObjectUi.dismissedPropId=null;
  sinTowerPlayObjectUi.dismissedWorldPosition=null;
  sinTowerPlayObjectUi.activeWorldPosition=nearest.position.clone();
  sinTowerPlayObjectUi.lastPlayerPosition.copy(player.position);
  sinTowerPlayObjectUi.previousAutoRun=!!SIN_TOWER_STAIRCASE.autoRun;
  sinTowerPlayObjectUi.questionIndex=0;
  SIN_TOWER_STAIRCASE.autoRun=false;
  applySinTowerInteractionStyle(config);
  overlay.classList.remove('closing');$('sinQuestionBar')?.classList.remove('answered');
  overlay.classList.add('open');overlay.setAttribute('aria-hidden','false');
  document.body.classList.add('play-mode','sin-question-open');
  renderSinTowerActiveQuestion();setSinTowerModalCursorFree();
}

function collectSinTowerDissolveMaterials(rec){
  const records=[],seen=new Set(),remember=material=>{if(!material||seen.has(material))return;seen.add(material);records.push({material,opacity:safeFinite(material.opacity,1),transparent:material.transparent,depthWrite:material.depthWrite});material.transparent=true;material.depthWrite=false;};
  const roots=rec?.model?[rec.object]:(rec?.visuals||[]).map(visual=>visual.sprite);
  for(const root of roots)root?.traverse?.(node=>{for(const material of (Array.isArray(node.material)?node.material:[node.material]))remember(material);});
  if(rec?.prop)for(const frame of rec.frames||[])remember(frame?.material);
  return records;
}

function startSinTowerQuestionDissolve(rec,object){
  if(!rec||!object?.interaction)return false;
  const config=object.interaction,count=clamp(Math.round(safeFinite(config.dissolveParticleCount,4200)),400,12000),density=clamp(safeFinite(config.dissolveDensity,1.6),.25,4),positions=new Float32Array(count*3),velocities=new Float32Array(count*3),seed=safeFinite(object.id?.length,1)*977+performance.now()*.001;
  let sourceKind='fallback',modelSources=[];
  if(rec.model&&rec.object){rec.group.updateMatrixWorld(true);rec.object.updateMatrixWorld(true);rec.object.traverse(node=>{const attr=node.isMesh?node.geometry?.getAttribute?.('position'):null;if(attr?.count)modelSources.push({node,attr});});if(modelSources.length)sourceKind='model-surface';}
  const visuals=(rec.visuals||[]).filter(visual=>visual.group?.visible!==false),right=new THREE.Vector3(1,0,0).applyQuaternion(camera.quaternion).normalize(),point=new THREE.Vector3(),center=new THREE.Vector3();
  if(rec.model)new THREE.Box3().setFromObject(rec.object).getCenter(center);else if(visuals.length)center.copy(visuals[0].group.getWorldPosition(new THREE.Vector3()));else center.copy(player.position);
  for(let i=0;i<count;i++){
    if(modelSources.length){const source=modelSources[i%modelSources.length],index=Math.floor(sinTowerRand(seed+i*31.7)*source.attr.count);point.fromBufferAttribute(source.attr,index);source.node.localToWorld(point);}
    else if(visuals.length){const visual=visuals[i%visuals.length],prop=rec.prop,h=clamp(safeFinite(prop?.height,2),.1,600),ratio=clamp(safeFinite(visual.frame?.ratio,1),.02,20),w=h*ratio*clamp(safeFinite(prop?.widthMul,1),.1,12),contour=getSinTowerBillboardAlphaContour(visual.frames||visual.frame),p=contour?.length?contour[Math.floor(sinTowerRand(seed+i*41.3)*contour.length)%contour.length]:{x:sinTowerSignedRand(seed+i*43.1),y:sinTowerSignedRand(seed+i*47.7)};point.copy(visual.group.getWorldPosition(new THREE.Vector3())).addScaledVector(right,p.x*w*.5);point.y+=(p.y+1)*h*.5;sourceKind=contour?.length?'alpha-contour':'billboard-surface';}
    else point.copy(center).add(new THREE.Vector3(sinTowerSignedRand(seed+i*7),sinTowerRand(seed+i*11),sinTowerSignedRand(seed+i*13)));
    const radial=point.clone().sub(center),radialLength=Math.max(.001,radial.length()),speed=(.34+sinTowerRand(seed+i*53.7)*.92)*(.72+density*.2),swirl=sinTowerSignedRand(seed+i*59.1)*.34*density;
    radial.multiplyScalar(1/radialLength);positions[i*3]=point.x;positions[i*3+1]=point.y;positions[i*3+2]=point.z;velocities[i*3]=radial.x*speed-radial.z*swirl;velocities[i*3+1]=.22+Math.abs(radial.y)*.42+sinTowerRand(seed+i*61.9)*.5;velocities[i*3+2]=radial.z*speed+radial.x*swirl;
  }
  const geometry=new THREE.BufferGeometry();geometry.setAttribute('position',new THREE.BufferAttribute(positions,3));
  const paper=validColor(getScreenFxConfig()?.monoPaper)?getScreenFxConfig().monoPaper:'#f4d66f',material=new THREE.PointsMaterial({color:new THREE.Color(paper),size:.018+density*.006,sizeAttenuation:true,transparent:true,opacity:.95,depthWrite:false,depthTest:false,blending:THREE.AdditiveBlending,toneMapped:false});
  const points=new THREE.Points(geometry,material);points.name='問答完成物件解體微粒';points.frustumCulled=false;points.renderOrder=20;scene.add(points);
  const materialRecords=collectSinTowerDissolveMaterials(rec);config.glowEnabledBeforeDissolve=config.glowEnabled!==false;config.glowEnabled=false;config.dissolving=true;
  if(rec.model)syncSinTowerModelInteractiveFx(rec);else for(const visual of rec.visuals||[])setSinTowerPropVisualGlowEnabled(visual,object,false);
  sinTowerPlayObjectUi.dissolves.push({rec,object,points,positions,velocities,materialRecords,started:performance.now(),duration:1700,density,sourceKind,lastTick:-1});return true;
}

function finishSinTowerQuestionDissolve(effect){
  effect.points?.parent?.remove(effect.points);effect.points?.geometry?.dispose?.();effect.points?.material?.dispose?.();
  if(effect.rec?.model&&effect.rec.group)effect.rec.group.visible=false;
  if(effect.rec?.prop&&effect.rec.root)effect.rec.root.visible=false;
  const objectType=effect.rec?.model?'model':'prop',canonical=getSinTowerEditorObjectById(effect.object?.id,objectType),targets=new Set([effect.object,canonical,effect.rec?.model,effect.rec?.prop].filter(Boolean));
  for(const target of targets)if(target.interaction){target.interaction.dissolving=false;target.interaction.consumed=true;target.interaction.glowEnabled=false;}
  if(objectType==='model'&&canonical)effect.rec.model=canonical;
  if(objectType==='prop'&&canonical)effect.rec.prop=canonical;
  for(const record of effect.materialRecords||[]){record.material.opacity=record.opacity;record.material.transparent=record.transparent;record.material.depthWrite=record.depthWrite;record.material.needsUpdate=true;}
  scheduleSinTowerRuntimeSave();
}

function updateSinTowerQuestionDissolves(){
  const now=performance.now(),effects=sinTowerPlayObjectUi.dissolves||[];
  for(let e=effects.length-1;e>=0;e--){const effect=effects[e],progress=clamp((now-effect.started)/effect.duration,0,1),ease=1-Math.pow(1-progress,3),tick=Math.floor(now/33);if(effect.lastTick!==tick){effect.lastTick=tick;const attr=effect.points?.geometry?.getAttribute?.('position'),array=attr?.array;if(array){for(let i=0;i<effect.velocities.length/3;i++){const k=i*3,wave=Math.sin(progress*10+i*.73)*.004*effect.density;array[k]+=effect.velocities[k]*.033+wave;array[k+1]+=effect.velocities[k+1]*.033+.008*progress;array[k+2]+=effect.velocities[k+2]*.033-wave;}attr.needsUpdate=true;}}
    if(effect.points?.material){effect.points.material.opacity=Math.pow(1-progress,1.35);effect.points.material.size=(.018+effect.density*.006)*(1+ease*.85);}
    for(const record of effect.materialRecords||[])record.material.opacity=record.opacity*Math.max(0,1-ease*1.08);
    if(progress>=1){finishSinTowerQuestionDissolve(effect);effects.splice(e,1);}
  }
}

function answerSinTowerQuestion(answer){
  const rec=getSinTowerActiveInteractionRecord(),object=rec?.prop||rec?.model,config=object?.interaction;
  const questions=Array.isArray(config?.questions)?config.questions:[],question=questions[sinTowerPlayObjectUi.questionIndex];
  if(!question||sinTowerPlayObjectUi.questionTimer)return false;
  config.answers=Array.isArray(config.answers)?config.answers:[];config.answers.push({questionId:question.id,answer:answer==='yes'?'yes':'no',at:Date.now()});config.answers=config.answers.slice(-120);applySinAnswerEffect(answer);scheduleSinTowerRuntimeSave();
  sinTowerPlayObjectUi.questionTypewriterToken+=1;const bar=$('sinQuestionBar'),text=$('sinQuestionText');if(bar){bar.dataset.direction=answer==='yes'?'yes':'no';bar.classList.remove('dragging');bar.classList.add('answered');}setSinTowerQuestionDrag(0);if(text){text.classList.remove('typing');text.textContent='我明白了';text.scrollTop=0;}
  sinTowerPlayObjectUi.questionTimer=setTimeout(()=>{sinTowerPlayObjectUi.questionTimer=null;if(sinTowerPlayObjectUi.questionIndex+1<questions.length){sinTowerPlayObjectUi.questionIndex+=1;renderSinTowerActiveQuestion();return;}const canonicalType=rec?.model?'model':'prop',canonicalObject=getSinTowerEditorObjectById(object?.id,canonicalType)||object;if(sinTowerPlayObjectUi.resultSession)sinTowerPlayObjectUi.resultSession.postReady=true;startSinTowerQuestionDissolve(rec,canonicalObject);syncSinTowerPlayPropActions();scheduleSinTowerRuntimeSave();setStatus('問答完成：物件正化為 '+canonicalObject.interaction.dissolveParticleCount+' 顆發光微粒並消散。');closeSinTowerInteraction(true,false);},1200);return true;
}

function beginSinTowerQuestionSwipe(event){
  if(event.target.closest?.('button,input,textarea,select,a'))return;
  if(!sinTowerPlayObjectUi.activePropId||event.button>0)return;
  sinTowerPlayObjectUi.questionPointerId=event.pointerId;
  sinTowerPlayObjectUi.questionPointerStartX=event.clientX;
  $('sinQuestionBar')?.classList.add('dragging');
  try{$('sinQuestionBar')?.setPointerCapture?.(event.pointerId);}catch{}
  event.preventDefault();
}

function moveSinTowerQuestionSwipe(event){
  if(event.pointerId!==sinTowerPlayObjectUi.questionPointerId)return;
  setSinTowerQuestionDrag(event.clientX-sinTowerPlayObjectUi.questionPointerStartX);event.preventDefault();
}

function endSinTowerQuestionSwipe(event){
  if(event.pointerId!==sinTowerPlayObjectUi.questionPointerId)return;
  const drag=sinTowerPlayObjectUi.questionDragX;
  sinTowerPlayObjectUi.questionPointerId=null;$('sinQuestionBar')?.classList.remove('dragging');
  try{$('sinQuestionBar')?.releasePointerCapture?.(event.pointerId);}catch{}
  if(Math.abs(drag)>=70)answerSinTowerQuestion(drag>0?'yes':'no');else setSinTowerQuestionDrag(0);
  event.preventDefault();
}

function updateSinTowerInteractionVhsEffect(){
  const rec=getSinTowerActiveInteractionRecord(),config=(rec?.prop||rec?.model)?.interaction;
  if(config?.type!=='text')return;
  const speed=clamp(safeFinite(config.vhsSpeed,5),0,20);if(speed<=0)return;
  const now=performance.now(),period=Math.max(45,620/(speed+.25));
  if(now-sinTowerPlayObjectUi.vhsSeedAt<period)return;
  sinTowerPlayObjectUi.vhsSeedAt=now;
  const seed=17+(Math.floor(now/period)%911);
  $('sinInteractionVhsNoise')?.setAttribute('seed',String(seed));
  $('sinInteractionVhsBorderNoise')?.setAttribute('seed',String(seed+37));
}

const SIN_RPS_IMAGES={"scissors":"./media/bbf1af79874075abb4c79ac17a15b9d64d0e4bfabcd0e98113878eb2527a5fb2.png","rock":"./media/3666093875870baafa7826911244178bc11d0ad086d4311d81cd2a40a864ebc3.png","paper":"./media/41f9a6ba9706e7ffae01d3106f1f3eae9010fc2bc0e0ba55c619786ab3f9a723.png"};
const SIN_RPS_KINDS=['scissors','rock','paper'];
const SIN_RPS_NAMES={scissors:'剪刀',rock:'石頭',paper:'布'};
let sinRpsSession=null;
let sinRpsImagesReady=null;
function prepareSinTowerRpsImages(){return sinRpsImagesReady ||= Promise.all(SIN_RPS_KINDS.map(kind=>{const img=new Image();img.src=SIN_RPS_IMAGES[kind];return img.decode();}));}
function sanitizeSinTowerRpsLayout(raw){
  const defaults=[[-.15,.08,.115,.18],[0,.08,.115,.18],[.15,.08,.115,.18],[0,-.14,.13,.20]];
  return defaults.map((d,i)=>({x:clamp(safeFinite(raw?.[i]?.x,d[0]),-1,1),y:clamp(safeFinite(raw?.[i]?.y,d[1]),-1,1),w:clamp(safeFinite(raw?.[i]?.w,d[2]),.025,.8),h:clamp(safeFinite(raw?.[i]?.h,d[3]),.035,.8)}));
}
function sinTowerRpsOutcome(playerKind,opponentKind){
  if(playerKind===opponentKind)return 'draw';
  return ({scissors:'paper',paper:'rock',rock:'scissors'})[playerKind]===opponentKind?'win':'lose';
}
function ensureSinTowerRpsUi(){
  if($('sinRpsOverlay'))return;
  const style=document.createElement('style');style.id='sinRpsStyle';style.textContent=`
  #sinRpsOverlay{position:fixed;inset:0;z-index:9000;pointer-events:none;color:#ffe16b;font-family:inherit}
  #sinRpsOverlay[hidden]{display:none!important}
  body.sin-rps-active #sinPlayObjectActions{visibility:hidden}
  .sin-rps-card{position:absolute;box-sizing:border-box;border:1px solid transparent;border-radius:9px;background:transparent!important;padding:4px;pointer-events:auto;touch-action:none;cursor:pointer;min-width:0;min-height:0;box-shadow:none}
  .sin-rps-card img{width:100%;height:100%;object-fit:contain;pointer-events:none;mix-blend-mode:screen;filter:grayscale(1) sepia(1) saturate(2);display:block}
  .sin-rps-card.selected{border-color:#ffe16b;box-shadow:0 0 12px #ffe16b66}
  .sin-rps-card .rps-name{position:absolute;bottom:-23px;left:0;width:100%;text-align:center;font-size:16px;text-shadow:0 0 4px #000;color:#ffe16b}
  #sinRpsStatus{position:absolute;text-align:center;white-space:pre-line;font-size:22px;text-shadow:0 2px 6px #000;pointer-events:none}
  #sinRpsToolbar{position:absolute;top:12px;left:50%;transform:translateX(-50%);pointer-events:auto;display:flex;gap:8px}
  #sinRpsToolbar button{background:#15283a;color:#ffe16b;border:1px solid #ffe16b;border-radius:6px;padding:8px 14px}
  #sinRpsOverlay.editing .sin-rps-card{border:1px dashed #ffe16b}
  .rps-handle{display:none;position:absolute;width:12px;height:12px;background:#ffe16b;border:1px solid #15283a;z-index:2}
  #sinRpsOverlay.editing .rps-handle{display:block}
  .rps-handle[data-corner=nw]{left:-6px;top:-6px;cursor:nwse-resize}.rps-handle[data-corner=ne]{right:-6px;top:-6px;cursor:nesw-resize}
  .rps-handle[data-corner=sw]{left:-6px;bottom:-6px;cursor:nesw-resize}.rps-handle[data-corner=se]{right:-6px;bottom:-6px;cursor:nwse-resize}
  #sinRpsParticles{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
  `;document.head.append(style);
  const overlay=document.createElement('div');overlay.id='sinRpsOverlay';overlay.hidden=true;
  overlay.innerHTML='<canvas id="sinRpsParticles"></canvas><div id="sinRpsStatus" role="status"></div><div id="sinRpsToolbar" style="display:none"><button id="sinRpsResetLayout" hidden>重設版面</button><button id="sinRpsDone">完成</button></div>';
  for(let i=0;i<4;i++){
    const card=document.createElement('button');card.className='sin-rps-card';card.id='sinRpsCard'+i;card.type='button';card.setAttribute('aria-label',i<3?SIN_RPS_NAMES[SIN_RPS_KINDS[i]]:'對手出拳');
    card.innerHTML='<img draggable="false">'+['nw','ne','sw','se'].map(c=>'<span class="rps-handle" data-corner="'+c+'"></span>').join('');
    card.onclick=()=>{if(sinRpsSession&&!sinRpsSession.editing&&!sinRpsSession.revealed&&i<3){sinRpsSession.selected=i;updateSinTowerRps();}};
    card.onpointerdown=e=>beginSinTowerRpsDrag(e,i);overlay.append(card);
  }
  document.body.append(overlay);
  $('sinRpsDone').onclick=()=>closeSinTowerInteraction(true,false,true);
  $('sinRpsResetLayout').onclick=()=>{if(sinRpsSession){sinRpsSession.object.interaction.rpsLayout=sanitizeSinTowerRpsLayout(null);commitSinTowerRpsLayout();updateSinTowerRps();}};
}
// Embedded into the standalone game by the patch script. Keep assets in saved state.
function sanitizeSinAnswerEffects(raw,fallback){
  return {yes:sanitizeSinTowerInfectionEffect(raw?.yes??fallback),no:sanitizeSinTowerInfectionEffect(raw?.no??fallback)};
}
function sanitizeSinMediaRect(raw,defaultRect){
  return {x:clamp(safeFinite(raw?.x,defaultRect.x),0,1),y:clamp(safeFinite(raw?.y,defaultRect.y),0,1),w:clamp(safeFinite(raw?.w,defaultRect.w),.02,1),h:clamp(safeFinite(raw?.h,defaultRect.h),.02,1)};
}
function sanitizeSinAfterVideo(raw){
  return {monoFilter:raw?.monoFilter===true,enabled:raw?.enabled===true,src:typeof raw?.src==='string'&&(/^data:video\/mp4[;,]/i.test(raw.src)||sinPublishedAssetMatches(raw.src,/^data:video\/mp4[;,]/i))?raw.src:'',name:String(raw?.name||'').slice(0,240),frameSrc:typeof raw?.frameSrc==='string'&&(/^data:image\/gif[;,]/i.test(raw.frameSrc)||sinPublishedAssetMatches(raw.frameSrc,/^data:image\/gif[;,]/i))?raw.frameSrc:'',frameName:String(raw?.frameName||'').slice(0,240),layout:{video:sanitizeSinMediaRect(raw?.layout?.video,{x:.5,y:.5,w:.58,h:.5}),frame:sanitizeSinMediaRect(raw?.layout?.frame,{x:.5,y:.5,w:.66,h:.62})}};
}
function sanitizeSinCustomCursor(raw){
  return {enabled:raw?.enabled!==false,src:typeof raw?.src==='string'&&(/^data:image\/gif[;,]/i.test(raw.src)||sinPublishedAssetMatches(raw.src,/^data:image\/gif[;,]/i))?raw.src:'',name:String(raw?.name||'').slice(0,240),size:clamp(safeFinite(raw?.size,40),8,160),anchorVersion:2,hotX:clamp(safeFinite(raw?.anchorVersion===2?raw.hotX:50,50),0,100),hotY:clamp(safeFinite(raw?.anchorVersion===2?raw.hotY:50,50),0,100)};
}
function measureSinCursorCenter(img){
  const w=img.naturalWidth,h=img.naturalHeight;if(!w||!h)return;
  // Measure once per source, before filtering; animation must not move the hotspot.
  const scale=Math.min(1,256/Math.max(w,h)),canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(w*scale));canvas.height=Math.max(1,Math.round(h*scale));
  try{const ctx=canvas.getContext('2d',{willReadFrequently:true});ctx.drawImage(img,0,0,canvas.width,canvas.height);const p=ctx.getImageData(0,0,canvas.width,canvas.height).data;let x0=canvas.width,y0=canvas.height,x1=-1,y1=-1;
    for(let y=0;y<canvas.height;y++)for(let x=0;x<canvas.width;x++)if(p[(y*canvas.width+x)*4+3]>16){x0=Math.min(x0,x);x1=Math.max(x1,x);y0=Math.min(y0,y);y1=Math.max(y1,y);}
    const fit=Math.max(w,h);img._sinCenter=x1<0?{x:.5,y:.5}:{x:(1-w/fit)/2+(x0+x1+1)/2/canvas.width*w/fit,y:(1-h/fit)/2+(y0+y1+1)/2/canvas.height*h/fit};
  }catch{img._sinCenter={x:.5,y:.5};}syncSinGifCursor();
}
function hideSinInteractionCursor(){
  sinCustomCursorPosition.inside=false;const img=$('sinGifCursor');if(img)img.hidden=true;
  document.body.classList.remove('sin-gif-cursor');document.body.classList.add('sin-cursor-closing');
}
let sinAfterVideoSession=null;
let sinCustomCursorPosition={x:0,y:0,inside:false};
function sinExtraObject(id){return SIN_TOWER_EDITOR.props.find(o=>o.id===id)||SIN_TOWER_EDITOR.models.find(o=>o.id===id);}
function commitSinExtraInteraction(object,patch){
  if(!object)return;
  const canonical=sinExtraObject(object.id)||object,rec=sinTowerEditorRuntime.props.get(object.id)||sinTowerEditorRuntime.models.get(object.id);
  for(const target of new Set([canonical,object,rec?.prop,rec?.model].filter(Boolean)))Object.assign(target.interaction,patch);
  scheduleSinTowerRuntimeSave();
}
function applySinAnswerEffect(answer){
  const session=sinTowerPlayObjectUi.resultSession;if(!session||session.preview)return;
  const cfg=session.object.interaction,effects=sanitizeSinAnswerEffects(cfg.answerEffects,cfg.infectionEffect),effect=effects[answer==='yes'?'yes':'no'];
  if(effect.enabled)changeSinTowerInfectionLayers((effect.direction==='remove'?-1:1)*effect.layers);
}
async function readSinLoopingGif(file){
  const bytes=new Uint8Array(await file.arrayBuffer());
  if(String.fromCharCode(...bytes.subarray(0,6))!=='GIF89a'&&String.fromCharCode(...bytes.subarray(0,6))!=='GIF87a')throw Error('請選擇有效的 GIF 檔案');
  const tag='NETSCAPE2.0';let found=false;
  for(let i=0;i<bytes.length-16;i++){if(bytes[i]!==33||bytes[i+1]!==255||bytes[i+2]!==11)continue;if(String.fromCharCode(...bytes.subarray(i+3,i+14))===tag&&bytes[i+14]===3&&bytes[i+15]===1){bytes[i+16]=0;bytes[i+17]=0;found=true;break;}}
  let result=bytes;if(!found){const offset=13+((bytes[10]&128)?3*(1<<((bytes[10]&7)+1)):0);const ext=new Uint8Array([33,255,11,...Array.from(tag,c=>c.charCodeAt(0)),3,1,0,0,0]);result=new Uint8Array(bytes.length+ext.length);result.set(bytes.subarray(0,offset));result.set(ext,offset);result.set(bytes.subarray(offset),offset+ext.length);result[4]=57;result[5]=97;}
  return readSinTowerBlobAsDataUrl(new Blob([result],{type:'image/gif'}));
}
function ensureSinExtraUi(){
  if($('sinExtraStyle'))return;
  const style=document.createElement('style');style.id='sinExtraStyle';style.textContent=`
  #sinAfterVideoOverlay{position:fixed;inset:0;z-index:18000;opacity:1;transition:opacity .45s;background:rgba(0,0,0,.18)}
  #sinAfterVideoOverlay[hidden]{display:none!important}#sinAfterVideoOverlay.closing{opacity:0;pointer-events:none}
  body.sin-after-video-active #sinProEditor,body.sin-after-video-active #sinPlayObjectActions{visibility:hidden!important}
  .sin-after-media{position:fixed;transform:translate(-50%,-50%);object-fit:fill;max-width:none;max-height:none}
  #sinAfterFrame{pointer-events:none}#sinAfterEditBox{position:fixed;transform:translate(-50%,-50%);border:1px dashed #ffe477;box-sizing:border-box;touch-action:none;cursor:move}
  #sinAfterEditBox i{position:absolute;width:12px;height:12px;background:#ffe477;transform:translate(-50%,-50%);touch-action:none}
  #sinAfterToolbar{position:fixed;top:8px;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:2;background:#14263d;padding:8px}
  #sinAfterToolbar[hidden],#sinAfterEditBox[hidden]{display:none!important}#sinAfterToolbar button{background:#f4d66f;color:#14263d;padding:8px}
  #sinAfterPlaybackNotice{position:fixed;left:50%;top:12%;transform:translateX(-50%);color:#ffe477;background:#14263d;padding:10px}
  #sinGifCursor{position:fixed;left:0;top:0;z-index:2147483647;pointer-events:none;object-fit:contain}#sinGifCursor[hidden]{display:none!important}
  body.sin-gif-cursor,body.sin-gif-cursor *{cursor:none!important}
  body.sin-cursor-closing,body.sin-cursor-closing *{cursor:none!important}
  #sinExtraSelected details{margin-top:10px}#sinExtraSelected input[type=file]{max-width:100%}
  `;document.head.append(style);
  const overlay=document.createElement('div');overlay.id='sinAfterVideoOverlay';overlay.hidden=true;overlay.innerHTML='<video id="sinAfterVideo" class="sin-after-media" loop playsinline></video><img id="sinAfterFrame" class="sin-after-media" alt=""><div id="sinAfterEditBox" hidden></div><div id="sinAfterToolbar" hidden><button type="button" data-part="video">影片</button><button type="button" data-part="frame">GIF 影片框</button><button type="button" id="sinAfterEditDone">完成</button></div><button type="button" id="sinAfterPlaybackNotice" hidden>點此播放影片</button>';
  document.body.append(overlay);
  overlay.addEventListener('pointerdown',event=>{event.stopPropagation();const s=sinAfterVideoSession;if(!s||s.editing||event.target===$('sinAfterPlaybackNotice'))return;if(event.target!==$('sinAfterVideo'))closeSinAfterVideo();});
  overlay.addEventListener('click',e=>e.stopPropagation());overlay.addEventListener('contextmenu',e=>{e.preventDefault();e.stopPropagation();});
  $('sinAfterPlaybackNotice').onclick=()=>{$('sinAfterVideo').muted=false;$('sinAfterVideo').play().then(()=>{$('sinAfterPlaybackNotice').hidden=true;}).catch(()=>{setStatus('影片無法播放，請確認 MP4 使用瀏覽器支援的編碼。');});};
  $('sinAfterVideo').onerror=()=>{if(sinAfterVideoSession){$('sinAfterPlaybackNotice').hidden=false;$('sinAfterPlaybackNotice').textContent='影片無法播放，請替換 MP4；點外側關閉';}};
  for(const button of overlay.querySelectorAll('[data-part]'))button.onclick=()=>{if(sinAfterVideoSession){sinAfterVideoSession.part=button.dataset.part;layoutSinAfterVideo();}};
  $('sinAfterEditDone').onclick=()=>closeSinAfterVideo(true);
  const box=$('sinAfterEditBox');for(const [name,x,y] of [['nw',0,0],['n',50,0],['ne',100,0],['e',100,50],['se',100,100],['s',50,100],['sw',0,100],['w',0,50]]){const handle=document.createElement('i');handle.dataset.handle=name;handle.style.left=x+'%';handle.style.top=y+'%';handle.style.cursor=name+'-resize';box.append(handle);}
  box.onpointerdown=e=>{const s=sinAfterVideoSession;if(!s?.editing)return;e.preventDefault();e.stopPropagation();box.setPointerCapture(e.pointerId);s.drag={id:e.pointerId,x:e.clientX,y:e.clientY,handle:e.target.dataset.handle||'',rect:{...s.config.layout[s.part]},viewport:getSinTowerGameViewport()};};
  box.onpointermove=e=>{const s=sinAfterVideoSession,d=s?.drag;if(!d||d.id!==e.pointerId)return;e.preventDefault();const dx=(e.clientX-d.x)/d.viewport.width,dy=(e.clientY-d.y)/d.viewport.height,r={...d.rect},h=d.handle;
    if(!h){r.x+=dx;r.y+=dy;}else{let dw=(h.includes('e')?dx:h.includes('w')?-dx:0),dh=(h.includes('s')?dy:h.includes('n')?-dy:0);if(h.length===2){const factor=Math.max(.02/d.rect.w,.02/d.rect.h,Math.abs(dw/d.rect.w)>=Math.abs(dh/d.rect.h)?1+dw/d.rect.w:1+dh/d.rect.h);dw=d.rect.w*(factor-1);dh=d.rect.h*(factor-1);}r.w=clamp(d.rect.w+dw,.02,1);r.h=clamp(d.rect.h+dh,.02,1);r.x+=(h.includes('e')?1:h.includes('w')?-1:0)*(r.w-d.rect.w)/2;r.y+=(h.includes('s')?1:h.includes('n')?-1:0)*(r.h-d.rect.h)/2;}
    r.x=clamp(r.x,r.w/2,1-r.w/2);r.y=clamp(r.y,r.h/2,1-r.h/2);s.config.layout[s.part]=r;layoutSinAfterVideo();};
  box.onpointerup=box.onpointercancel=e=>{const s=sinAfterVideoSession;if(!s?.drag)return;s.drag=null;try{box.releasePointerCapture(e.pointerId);}catch{}commitSinExtraInteraction(s.object,{afterVideo:sanitizeSinAfterVideo(s.config)});};
  window.addEventListener('resize',layoutSinAfterVideo);
  const cursor=document.createElement('img');cursor.id='sinGifCursor';cursor.hidden=true;cursor.alt='';cursor.onload=()=>measureSinCursorCenter(cursor);document.body.append(cursor);
  window.addEventListener('pointermove',e=>{if(e.pointerType==='touch'){sinCustomCursorPosition.inside=false;}else{sinCustomCursorPosition={x:e.clientX,y:e.clientY,inside:true};}syncSinGifCursor();},{passive:true});
  document.addEventListener('pointerleave',()=>{sinCustomCursorPosition.inside=false;syncSinGifCursor();});
  window.addEventListener('blur',()=>{sinCustomCursorPosition.inside=false;syncSinGifCursor();});
  document.addEventListener('pointerlockchange',syncSinGifCursor);
}
function syncSinGifCursor(){
  const img=$('sinGifCursor');if(!img)return;const cfg=sanitizeSinCustomCursor(STATE.customCursor);
  const hidden=document.body.classList.contains('sin-cursor-closing')||!!document.pointerLockElement||pointerLocked||fallbackMouseLook||(!cursorFreeMode&&desiredPointerLocked)||!sinCustomCursorPosition.inside;
  const enabled=cfg.enabled&&!!cfg.src;document.body.classList.toggle('sin-gif-cursor',enabled&&!hidden);img.hidden=!enabled||hidden;
  if(img.hidden)return;if(img._sinSource!==cfg.src){img._sinCenter={x:.5,y:.5};img.src=cfg.src;img._sinSource=cfg.src;}
  syncSinGifCursorFilter();
  const center=img._sinCenter||{x:.5,y:.5};Object.assign(img.style,{width:cfg.size+'px',height:cfg.size+'px',transform:'translate('+(sinCustomCursorPosition.x-cfg.size*(center.x+(cfg.hotX-50)/100))+'px,'+(sinCustomCursorPosition.y-cfg.size*(center.y+(cfg.hotY-50)/100))+'px)'});
}
function syncSinGifCursorFilter(){
  const img=$('sinGifCursor');if(!img)return;
  const fx=getScreenFxConfig(),k=clamp01(fx.intensity),enabled=fx.enabled&&fx.preset!=='none'&&k>.001;
  if(!enabled){img.style.filter='none';return;}
  const brightness=THREE.MathUtils.lerp(1,clamp(safeFinite(fx.brightness,1),.2,2),k),contrast=THREE.MathUtils.lerp(1,clamp(safeFinite(fx.contrast,1),.2,2.6),k);
  if(fx.preset!=='monopixel'){img.style.filter='brightness('+brightness+') contrast('+contrast+') saturate('+THREE.MathUtils.lerp(1,clamp(safeFinite(fx.saturation,1),0,3),k)+') hue-rotate('+(safeFinite(fx.hue,0)*k)+'deg) blur('+(safeFinite(fx.blur,0)*k)+'px)';return;}
  let filter=$('sinCursorMonoFilter');
  if(!filter){const source=$('sinPortalMonoFilter');if(!source)return;filter=source.cloneNode(true);for(const node of [filter,...filter.querySelectorAll('[id]')])node.id=node.id.replace('sinPortal','sinCursor');source.parentNode.append(filter);}
  img.style.filter='url(#sinCursorMonoFilter)';
  const v=getSinTowerGameViewport(),backing=screenFxTargetSize.x>0&&v.width>0?screenFxTargetSize.x/v.width:(renderer?.getPixelRatio?.()||1),grid=Math.max(1,safeFinite(screenFxMaterial?.uniforms?.uDitherGridScale?.value,1));
  const cell=Math.max(.02,(51-clamp(Math.round(safeFinite(fx.monoDetail,50)),1,50))*grid/Math.max(.001,backing)),paper=validColor(fx.monoPaper)?fx.monoPaper:'#f4d66f',ink=validColor(fx.monoInk)?fx.monoInk:'#14263d';
  const signature=[brightness,contrast,cell,paper,ink].join(':');if(filter._sinSignature===signature)return;filter._sinSignature=signature;
  const light=hexToRgb01(paper),dark=hexToRgb01(ink);
  for(const [index,c] of ['R','G','B'].entries()){$('sinCursorMonoAdjust'+c).setAttribute('slope',String(brightness*contrast));$('sinCursorMonoAdjust'+c).setAttribute('intercept',String(.5*(1-contrast)));$('sinCursorMonoPalette'+c).setAttribute('tableValues',dark[index]+' '+light[index]);}
  $('sinCursorMonoBlend').setAttribute('k2','1');$('sinCursorMonoBlend').setAttribute('k3','0');
  const tile=$('sinCursorMonoBayerImage');tile.setAttribute('width',String(cell*4));tile.setAttribute('height',String(cell*4));
  if(!filter._sinBayer){const canvas=document.createElement('canvas');canvas.width=canvas.height=4;const ctx=canvas.getContext('2d'),matrix=[[0,8,2,10],[12,4,14,6],[3,11,1,9],[15,7,13,5]];for(let y=0;y<4;y++)for(let x=0;x<4;x++){const n=Math.round(matrix[y][x]/16*255);ctx.fillStyle='rgb('+n+','+n+','+n+')';ctx.fillRect(x,y,1,1);}filter._sinBayer=canvas.toDataURL();}
  tile.setAttribute('href',filter._sinBayer);
}
function layoutSinAfterVideo(){
  const s=sinAfterVideoSession;if(!s)return;const v=getSinTowerGameViewport();syncSinGifCursorFilter();const fx=getScreenFxConfig();$('sinAfterVideo').style.filter=s.config.monoFilter&&fx.enabled&&fx.preset==='monopixel'?'url(#sinCursorMonoFilter)':'none';
  for(const part of ['video','frame']){const r=s.config.layout[part],el=$(part==='video'?'sinAfterVideo':'sinAfterFrame');Object.assign(el.style,{left:(v.left+r.x*v.width)+'px',top:(v.top+r.y*v.height)+'px',width:r.w*v.width+'px',height:r.h*v.height+'px'});}
  if(s.editing){const selected=$(s.part==='video'?'sinAfterVideo':'sinAfterFrame');for(const key of ['left','top','width','height'])$('sinAfterEditBox').style[key]=selected.style[key];}
}
function showSinAfterVideo(object,editing=false){
  if(sinAfterVideoSession)closeSinAfterVideo(true);
  const config=sanitizeSinAfterVideo(object?.interaction?.afterVideo);if(!config.src){setStatus('請先上傳互動結束後播放的 MP4。');return;}if(!editing&&(!config.enabled||isSinTowerInteractionPlacementActive()))return;
  ensureSinExtraUi();sinAfterVideoSession={object,config,editing,part:'video',autoRun:!!SIN_TOWER_STAIRCASE.autoRun};
  SIN_TOWER_STAIRCASE.autoRun=false;clearMovementKeys();setSinTowerModalCursorFree();
  document.body.classList.add('sin-after-video-active');
  const overlay=$('sinAfterVideoOverlay');overlay.hidden=false;overlay.classList.remove('closing');$('sinAfterToolbar').hidden=!editing;$('sinAfterEditBox').hidden=!editing;
  $('sinAfterPlaybackNotice').hidden=true;$('sinAfterPlaybackNotice').textContent='點此開啟影片聲音';
  const video=$('sinAfterVideo'),frame=$('sinAfterFrame');video.src=config.src;video.loop=true;video.muted=editing;frame.hidden=!config.frameSrc;if(config.frameSrc)frame.src=config.frameSrc;else frame.removeAttribute('src');layoutSinAfterVideo();
  const current=sinAfterVideoSession;video.play().catch(()=>{if(sinAfterVideoSession!==current)return;video.muted=true;video.play().then(()=>{if(sinAfterVideoSession===current)$('sinAfterPlaybackNotice').hidden=editing;}).catch(()=>{if(sinAfterVideoSession===current){$('sinAfterPlaybackNotice').textContent='點此播放影片';$('sinAfterPlaybackNotice').hidden=false;}});});
}
function closeSinAfterVideo(immediate=false){
  const s=sinAfterVideoSession;if(!s||s.closing)return;s.closing=true;
  if(!s.editing)hideSinInteractionCursor();
  const finish=()=>{if(sinAfterVideoSession!==s)return;const video=$('sinAfterVideo');video.pause();video.removeAttribute('src');video.load();$('sinAfterFrame').removeAttribute('src');$('sinAfterVideoOverlay').hidden=true;sinAfterVideoSession=null;document.body.classList.remove('sin-after-video-active');clearMovementKeys();SIN_TOWER_STAIRCASE.autoRun=s.autoRun;
    if(s.editing){commitSinExtraInteraction(s.object,{afterVideo:sanitizeSinAfterVideo(s.config)});enterSinTowerEditorMode();setSinProTab('perf');syncSinProEditor();}else restoreSinTowerPlayLook(false);
  };
  if(immediate)finish();else{$('sinAfterVideoOverlay').classList.add('closing');setTimeout(finish,450);}
}
function handleSinAfterVideoKey(event){if(!sinAfterVideoSession)return false;event.preventDefault();event.stopImmediatePropagation();if(event.code==='Escape')closeSinAfterVideo();return true;}
function syncSinSelectedVideoFilter(object){
  const section=$('sinSelectedVideoFilter'),checkbox=$('sinSceneVideoMono');if(!section||!checkbox)return;
  section.hidden=object?.mediaType!=='video';
  checkbox.checked=object?.monoFilter!==false;
  checkbox.onchange=()=>{
    const selected=getSinTowerSelectedPlayProp();if(selected?.mediaType!=='video')return;
    const canonical=sinExtraObject(selected.id)||selected,rec=sinTowerEditorRuntime.props.get(selected.id);
    for(const target of new Set([selected,canonical,rec?.prop].filter(Boolean)))target.monoFilter=checkbox.checked;
    // Update every repeated instance immediately, even while the editor pauses movement.
    if(rec)updateSinTowerEditorPropRecord(rec,performance.now()*.001);
    scheduleSinTowerRuntimeSave();
    $('sinSelectedVideoFilterStatus').textContent=checkbox.checked?'已套用遊戲單色濾鏡':'已取消濾鏡，顯示影片原色';
  };
  $('sinSelectedVideoFilterStatus').textContent=checkbox.checked?'已套用遊戲單色濾鏡':'已取消濾鏡，顯示影片原色';
}
function syncSinExtraSelected(object){
  ensureSinExtraUi();let panel=$('sinExtraSelected');
  if(!panel){panel=document.createElement('div');panel.id='sinExtraSelected';panel.innerHTML='<details id="sinAnswerEffectsPanel"><summary>YES／NO 各自的腫瘤效果</summary>'+['yes','no'].map(a=>'<fieldset><legend>'+a.toUpperCase()+'</legend><label>啟用<input id="sinAnswer_'+a+'_enabled" type="checkbox"></label><label>效果<select id="sinAnswer_'+a+'_direction"><option value="add">增加</option><option value="remove">減少</option></select></label><label>層數 N<input id="sinAnswer_'+a+'_layers" type="number" min="1" max="1000" step="1"></label></fieldset>').join('')+'<small>每回答一題套用一次；編輯預覽不生效。最低 0 層，最高為肉球完成層數。</small></details><details><summary>互動結束後播放影片</summary><label>啟用<input id="sinAfterEnabled" type="checkbox"></label><label>套用遊戲單色濾鏡<input id="sinAfterMono" type="checkbox"></label><label>上傳 MP4<input id="sinAfterUpload" type="file" accept="video/mp4,.mp4"></label><div id="sinAfterFileName"></div><label>上傳 GIF 影片框<input id="sinAfterFrameUpload" type="file" accept="image/gif,.gif"></label><div id="sinAfterFrameName"></div><button id="sinAfterRemoveFrame" type="button">移除影片框</button><small>位置與尺寸：編輯模式 → 素材效能 → 互動影片與影片框。</small></details>';$('sinSelectedInteractionType').closest('label').after(panel);
    for(const a of ['yes','no'])for(const key of ['enabled','direction','layers'])$('sinAnswer_'+a+'_'+key).onchange=()=>{const obj=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp();if(!obj)return;const effects=sanitizeSinAnswerEffects(obj.interaction.answerEffects,obj.interaction.infectionEffect);effects[a]=sanitizeSinTowerInfectionEffect({enabled:$('sinAnswer_'+a+'_enabled').checked,direction:$('sinAnswer_'+a+'_direction').value,layers:Number($('sinAnswer_'+a+'_layers').value)});commitSinExtraInteraction(obj,{answerEffects:effects});};
    $('sinAfterMono').onchange=()=>{const obj=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp();if(obj)commitSinExtraInteraction(obj,{afterVideo:sanitizeSinAfterVideo({...obj.interaction.afterVideo,monoFilter:$('sinAfterMono').checked})});};
    $('sinAfterEnabled').onchange=()=>{const obj=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp();if(obj)commitSinExtraInteraction(obj,{afterVideo:sanitizeSinAfterVideo({...obj.interaction.afterVideo,enabled:$('sinAfterEnabled').checked})});};
    for(const [id,frame] of [['sinAfterUpload',false],['sinAfterFrameUpload',true]])$(id).onchange=async event=>{const obj=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp(),file=event.target.files?.[0];event.target.value='';if(!obj||!file)return;try{if(!frame&&!/\.mp4$/i.test(file.name))throw Error('請選擇 MP4 檔案');const src=frame?await readSinLoopingGif(file):await readSinTowerBlobAsDataUrl(new Blob([await file.arrayBuffer()],{type:'video/mp4'}));if(!sinExtraObject(obj.id))return;const cfg=sanitizeSinAfterVideo((sinExtraObject(obj.id)||obj).interaction.afterVideo);if(frame){cfg.frameSrc=src;cfg.frameName=file.name;}else{cfg.src=src;cfg.name=file.name;}commitSinExtraInteraction(obj,{afterVideo:cfg});syncSinTowerPlayPropActions();syncSinExtraPerf();setStatus('已匯入 '+file.name+'；請按儲存完整匯出以備份素材。');}catch(e){setStatus(e.message);}};
    $('sinAfterRemoveFrame').onclick=()=>{const obj=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp();if(obj){commitSinExtraInteraction(obj,{afterVideo:sanitizeSinAfterVideo({...obj.interaction.afterVideo,frameSrc:'',frameName:''})});syncSinTowerPlayPropActions();}};
  }
  $('sinAnswerEffectsPanel').hidden=object.interaction.type!=='question';const effects=sanitizeSinAnswerEffects(object.interaction.answerEffects,object.interaction.infectionEffect);
  for(const a of ['yes','no'])for(const key of ['enabled','direction','layers']){const el=$('sinAnswer_'+a+'_'+key);if(document.activeElement===el)continue;if(key==='enabled')el.checked=effects[a][key];else el.value=effects[a][key];}
  const cfg=sanitizeSinAfterVideo(object.interaction.afterVideo);$('sinAfterEnabled').checked=cfg.enabled;$('sinAfterMono').checked=cfg.monoFilter;$('sinAfterFileName').textContent=cfg.name||'尚未上傳 MP4';$('sinAfterFrameName').textContent=cfg.frameName||'尚未上傳 GIF 框';
}
function syncSinExtraPerf(){
  ensureSinExtraUi();let panel=$('sinExtraPerf');if(!panel){panel=document.createElement('div');panel.id='sinExtraPerf';panel.innerHTML='<div class="sin-pro-heading">發布遊戲</div><button id="sinExportPublished" type="button">匯出無編輯功能發布版（GitHub Pages ZIP）</button><p>解壓縮後，上傳全部內容至 Pages 發布目錄。直接開啟本機 HTML 時，請在匯出時選擇本遊戲的 assets 資料夾。</p><div class="sin-pro-heading">互動影片與影片框</div><label class="sin-pro-field">互動物件<select id="sinAfterObjectSelect"></select></label><button id="sinAfterLayoutButton" type="button">編輯影片／GIF 框位置與尺寸</button><p class="sin-pro-muted">先在物件右下角「互動結束後播放影片」上傳 MP4／GIF。編輯時可切換影片或框；四角等比例縮放，四邊中點自由變形。</p><div class="sin-pro-heading">GIF 游標</div><label class="sin-pro-field">上傳 GIF<input id="sinCursorUpload" type="file" accept="image/gif,.gif"></label><div id="sinCursorName"></div><label class="sin-pro-field">使用 GIF 游標<input id="sinCursorEnabled" type="checkbox"></label><label class="sin-pro-field">尺寸<input id="sinCursorSize" type="range" min="8" max="160" step="1"></label><label class="sin-pro-field">中心微調 X %（50 為置中）<input id="sinCursorHotX" type="range" min="0" max="100"></label><label class="sin-pro-field">中心微調 Y %（50 為置中）<input id="sinCursorHotY" type="range" min="0" max="100"></label><button id="sinCursorReset" type="button">恢復系統游標</button>';$('sinPerfRpsEditor').after(panel);
    $('sinExportPublished').onclick=exportSinPublishedGame;
    $('sinAfterLayoutButton').onclick=()=>{const obj=sinExtraObject($('sinAfterObjectSelect').value);if(!obj)return;if(sinTowerPlayObjectUi.activePropId)finalizeSinTowerInteractionClose(false,false);showSinAfterVideo(obj,true);};
    $('sinCursorUpload').onchange=async e=>{const file=e.target.files?.[0];e.target.value='';if(!file)return;try{const src=await readSinLoopingGif(file);STATE.customCursor=sanitizeSinCustomCursor({...STATE.customCursor,enabled:true,src,name:file.name});scheduleSave();scheduleSinTowerRuntimeSave();syncSinExtraPerf();syncSinGifCursor();}catch(error){setStatus(error.message);}};
    for(const id of ['sinCursorEnabled','sinCursorSize','sinCursorHotX','sinCursorHotY'])$(id).oninput=()=>{STATE.customCursor=sanitizeSinCustomCursor({...STATE.customCursor,enabled:$('sinCursorEnabled').checked,size:Number($('sinCursorSize').value),hotX:Number($('sinCursorHotX').value),hotY:Number($('sinCursorHotY').value)});scheduleSave();scheduleSinTowerRuntimeSave();syncSinGifCursor();};
    $('sinCursorReset').onclick=()=>{STATE.customCursor=sanitizeSinCustomCursor({enabled:false});scheduleSave();scheduleSinTowerRuntimeSave();syncSinExtraPerf();syncSinGifCursor();};
  }
  const objects=[...SIN_TOWER_EDITOR.props,...SIN_TOWER_EDITOR.models].filter(o=>o.sceneId===SIN_TOWER_EDITOR.activeSceneId&&o.interaction?.afterVideo?.src),select=$('sinAfterObjectSelect'),previous=select.value,signature=JSON.stringify(objects.map(o=>[o.id,o.title]));
  if(select.dataset.signature!==signature){select.replaceChildren();for(const obj of objects){const option=document.createElement('option');option.value=obj.id;option.textContent=obj.title||obj.id;select.append(option);}if(objects.some(o=>o.id===previous))select.value=previous;if(!objects.length){const option=document.createElement('option');option.textContent='尚無已上傳影片的互動物件';select.append(option);}select.dataset.signature=signature;}
  $('sinAfterLayoutButton').disabled=!objects.length;
  const cfg=sanitizeSinCustomCursor(STATE.customCursor);$('sinCursorEnabled').checked=cfg.enabled;$('sinCursorName').textContent=cfg.name||'目前使用系統游標';for(const [id,key] of [['sinCursorSize','size'],['sinCursorHotX','hotX'],['sinCursorHotY','hotY']])if(document.activeElement!==$(id))$(id).value=cfg[key];syncSinGifCursor();
}

// Publication runs the original renderer, without the legacy gallery quality caps.
function prepareSinPublishedGame(){
  ensureSinExtraUi();document.body.classList.add('sin-published');
  const style=document.createElement('style');style.textContent='body.sin-published .edit-ui,body.sin-published #sinPlayAddButton,body.sin-published #sinPlayAddPanel,body.sin-published #editor,body.sin-published #hud,body.sin-published #status,body.sin-published #sinProEditor,body.sin-published #objectPanel,body.sin-published #lightPanel,body.sin-published #chiselPanel,body.sin-published #sinPlayObjectActions,body.sin-published #sinExtraPerf{display:none!important}';document.head.append(style);
  window.addEventListener('keydown',event=>{
    if(sinAfterVideoSession||sinRpsSession||sinTowerPortalGate?.active)return;
    if(sinTowerPlayObjectUi.activePropId){
      if(event.code==='ArrowLeft'||event.code==='ArrowRight'){if(!event.repeat&&$('sinQuestionOverlay')?.classList.contains('open'))answerSinTowerQuestion(event.code==='ArrowRight'?'yes':'no');}
      else if(event.code==='Escape')closeSinTowerInteraction(true,false);
      event.preventDefault();event.stopImmediatePropagation();return;
    }
    if(event.code==='Escape'){event.preventDefault();event.stopImmediatePropagation();restoreSinTowerPlayLook(false);return;}
    if(event.ctrlKey||event.metaKey||event.altKey||event.shiftKey||!['KeyW','KeyA','KeyS','KeyD','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space','KeyR'].includes(event.code)){event.preventDefault();event.stopImmediatePropagation();}
  },true);
}
function sinReleaseZip(files){
  const encoder=new TextEncoder(),parts=[],central=[];let offset=0,centralSize=0;
  const crcTable=new Uint32Array(256);for(let n=0;n<256;n++){let c=n;for(let k=0;k<8;k++)c=c&1?0xedb88320^(c>>>1):c>>>1;crcTable[n]=c>>>0;}
  for(const [name,content] of files){const data=typeof content==='string'?encoder.encode(content):content,n=encoder.encode(name);let crc=0xffffffff;for(const b of data)crc=crcTable[(crc^b)&255]^(crc>>>8);crc=(crc^0xffffffff)>>>0;
    const local=new Uint8Array(30+n.length),v=new DataView(local.buffer);v.setUint32(0,0x04034b50,true);v.setUint16(4,20,true);v.setUint16(6,0x800,true);v.setUint32(14,crc,true);v.setUint32(18,data.length,true);v.setUint32(22,data.length,true);v.setUint16(26,n.length,true);local.set(n,30);parts.push(local,data);
    const entry=new Uint8Array(46+n.length),d=new DataView(entry.buffer);d.setUint32(0,0x02014b50,true);d.setUint16(4,20,true);d.setUint16(6,20,true);d.setUint16(8,0x800,true);d.setUint32(16,crc,true);d.setUint32(20,data.length,true);d.setUint32(24,data.length,true);d.setUint16(28,n.length,true);d.setUint32(42,offset,true);entry.set(n,46);central.push(entry);centralSize+=entry.length;offset+=local.length+data.length;
  }
  if(offset+centralSize>0xffffffff)throw Error('發布包超出 ZIP 容量，請先減少素材容量');
  const end=new Uint8Array(22),v=new DataView(end.buffer);v.setUint32(0,0x06054b50,true);v.setUint16(8,files.length,true);v.setUint16(10,files.length,true);v.setUint32(12,centralSize,true);v.setUint32(16,offset,true);
  return new Blob([...parts,...central,end],{type:'application/zip'});
}
async function buildSinPublishedPackage(saved,dependencyAssets=null){
  const backup=await buildSinTowerCompleteBackupHtml(saved,{publication:true},dependencyAssets);
  if(backup.meta.dependencies?.unresolved?.length)throw Error('以下素材無法讀取，不能產生缺素材發布版：'+backup.meta.dependencies.unresolved.map(x=>x.url).join('、')+'。請由本機 HTTP 伺服器開啟遊戲後重試。');
  let html=backup.html.replace(/]*>/gi,'').replace('const SIN_TOWER_PUBLISHED = false;','const SIN_TOWER_PUBLISHED = true;');
  html=html.replace(/<title>.*?<\/title>/,'<title>斷罪塔</title>');
  // Keep each repository file below browser upload limits; reconstruct byte-exact
  // HTML before module execution. Relative paths work on /repository/ Pages URLs.
  const bytes=new TextEncoder().encode(html),files=[],names=[];
  for(let offset=0;offset<bytes.length;offset+=8*1024*1024){const name='game/part-'+String(names.length).padStart(4,'0')+'.bin';names.push(name);files.push([name,bytes.subarray(offset,offset+8*1024*1024)]);}
  const loader='<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>斷罪塔</title></head><body style="background:#080808;color:#f4d66f"><p id="loading">正在載入遊戲…</p><script>(async()=>{try{const names='+JSON.stringify(names)+';const parts=[];for(const name of names){const r=await fetch(new URL(name,location.href));if(!r.ok)throw Error(name+" HTTP "+r.status);parts.push(await r.arrayBuffer());}const html=await new Blob(parts).text();document.open();document.write(html);document.close();}catch(e){document.getElementById("loading").textContent="遊戲載入失敗："+e.message;}})();<\/script></body></html>';
  files.unshift(['index.html',loader],['.nojekyll',''],['README.txt','發布方式：解壓縮後，將 index.html、game 資料夾與 .nojekyll 一起放在 GitHub Pages 的發布目錄。不要只上傳 ZIP。這是純遊玩版；編輯請保留原本的完整可編輯存檔。Three.js 模組仍由 HTTPS CDN 載入，需連網。\n']);
  return sinReleaseZip(files);
}
async function exportSinPublishedGame(){
  const button=$('sinExportPublished');if(button?.disabled)return;if(button)button.disabled=true;
  try{const dependencyAssets=null; // Built-in dependencies are embedded; no directory permission required.
    setStatus('正在保存並打包發布版，素材不降畫質…');const saved=await saveStateNow({updateBadge:false}),blob=await buildSinPublishedPackage(saved,dependencyAssets),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='SinTower_GitHubPages.zip';a.click();setTimeout(()=>URL.revokeObjectURL(url),60000);setStatus('已下載發布版 ZIP。解壓縮並將全部內容放進 GitHub Pages 發布目錄；請保留可編輯存檔。');}
  catch(error){setStatus('發布匯出失敗：'+error.message);alert('發布匯出失敗：'+error.message);}finally{if(button)button.disabled=false;}
}


function syncSinTowerPerfRpsEditor(){
  const select=$('sinPerfRpsObject'),button=$('sinPerfEditRpsLayout');if(!select||!button)return;
  const previous=select.value;
  const objects=[...SIN_TOWER_EDITOR.props,...SIN_TOWER_EDITOR.models].filter(o=>o.sceneId===SIN_TOWER_EDITOR.activeSceneId&&o.interaction?.type==='rps');
  const signature=JSON.stringify(objects.map(o=>[o.id,o.title||o.name||o.id]));
  if(select.dataset.signature!==signature){
    select.replaceChildren();
    for(const o of objects){const option=document.createElement('option');option.value=o.id;option.textContent=o.title||o.name||o.id;select.appendChild(option);}
    if(!objects.length){const option=document.createElement('option');option.textContent='目前場景尚無猜拳互動物件';option.value='';select.appendChild(option);}
    if(objects.some(o=>o.id===previous))select.value=previous;
    select.dataset.signature=signature;
  }
  button.disabled=!objects.length;select.disabled=!objects.length;
  $('sinPerfRpsHint').textContent=objects.length?'拖曳圖片移動，拉四角等比例縮放；三張選擇圖與對手圖片可分別調整。完成後返回素材效能。':'先新增物件，將互動模式設為「猜拳互動」，再回到此處編輯。';
  button.onclick=()=>{
    const id=select.value,rec=sinTowerEditorRuntime.props.get(id)||sinTowerEditorRuntime.models.get(id);
    if(!rec){setStatus('此物件尚未載入，請等待素材載入後再試。');return;}
    closeSinTowerPlayAddPanel(false,false);
    if(sinTowerPlayObjectUi.activePropId)finalizeSinTowerInteractionClose(false,false);
    openSinTowerRps(rec,{position:player.position.clone()},true);
    if(sinRpsSession)sinRpsSession.returnToPerf=true;
  };
}
function syncSinTowerRpsEditor(object){
  let panel=$('sinSelectedRpsSettings');
  if(!panel){
    panel=document.createElement('details');panel.id='sinSelectedRpsSettings';
    panel.innerHTML='<summary>猜拳圖片與版面</summary><p>左右選擇，五秒後揭曉。勝利清空腫瘤；失敗增加10層；平手不變。</p><button type="button" id="sinEditRpsLayout">編輯猜拳圖片版面</button><p>拖曳圖片移動；拉四角等比例縮放。三張選擇圖與對手圖可分別調整。</p>';
    $('sinSelectedInteractionType')?.closest('label')?.after(panel);
    $('sinEditRpsLayout').onclick=()=>{
      const obj=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp();if(!obj)return;
      const rec=sinTowerEditorRuntime.props.get(obj.id)||sinTowerEditorRuntime.models.get(obj.id);if(!rec)return;
      if(sinTowerPlayObjectUi.activePropId)finalizeSinTowerInteractionClose(false,false);
      openSinTowerRps(rec,{position:player.position.clone()},true);
    };
  }
  panel.hidden=object?.interaction?.type!=='rps';
}
function openSinTowerRps(rec,nearest,editing=false){
  if(!editing&&isSinTowerInteractionPlacementActive())return;
  const object=rec?.prop||rec?.model,config=object?.interaction;
  if(!config||(!editing&&(!config.enabled||config.consumed||config.dissolving))||sinTowerPlayObjectUi.activePropId||sinTowerPlayObjectUi.panelOpen)return;
  ensureSinTowerRpsUi();
  object.interaction.rpsLayout=sanitizeSinTowerRpsLayout(config.rpsLayout);
  sinTowerPlayObjectUi.resultSession={object,type:'rps',preview:editing,applied:false};
  sinTowerPlayObjectUi.activePropId=object.id;sinTowerPlayObjectUi.activeWorldPosition=nearest.position.clone();
  sinTowerPlayObjectUi.dismissedPropId=null;sinTowerPlayObjectUi.dismissedWorldPosition=null;
  sinTowerPlayObjectUi.lastPlayerPosition.copy(player.position);sinTowerPlayObjectUi.previousAutoRun=!!SIN_TOWER_STAIRCASE.autoRun;
  SIN_TOWER_STAIRCASE.autoRun=false;clearMovementKeys();setSinTowerModalCursorFree();
  const random=new Uint32Array(1);crypto.getRandomValues(random);
  sinRpsSession={object,editing,selected:0,opponent:SIN_RPS_KINDS[random[0]%3],deadline:Infinity,ready:false,revealed:false,finishedAt:0,drag:null};
  document.body.classList.add('play-mode','sin-interaction-open','sin-rps-active');
  const overlay=$('sinRpsOverlay');overlay.hidden=false;overlay.classList.toggle('editing',editing);
  $('sinRpsToolbar').style.display=editing?'flex':'none';$('sinRpsResetLayout').hidden=!editing;
  const current=sinRpsSession;
  prepareSinTowerRpsImages().then(()=>{if(sinRpsSession!==current||current.revealed)return;current.ready=true;current.deadline=performance.now()+5000;updateSinTowerRps();}).catch(()=>{if(sinRpsSession===current){setStatus('猜拳圖片無法載入，已取消本局。');closeSinTowerInteraction(true,false,true);}});
  updateSinTowerRps();
}
function settleSinTowerRps(now=performance.now()){
  const s=sinRpsSession;if(!s||s.editing||s.revealed||now<s.deadline)return;
  s.revealed=true;s.finishedAt=now;
  if(sinTowerPlayObjectUi.resultSession)sinTowerPlayObjectUi.resultSession.postReady=true;
  s.outcome=sinTowerRpsOutcome(SIN_RPS_KINDS[s.selected],s.opponent);
  const session=sinTowerPlayObjectUi.resultSession;
  if(session?.object===s.object&&!session.preview&&!session.applied){
    session.applied=true;
    if(s.outcome==='win'){changeSinTowerInfectionLayers(-Math.max(0,SIN_TOWER_INFECTION.level||0));startSinTowerRpsBlink(s,'win');}
    if(s.outcome==='lose'){s.addedLayers=null;startSinTowerRpsBlink(s,'lose');}
  }
}
const sinTowerRpsBlinks=[];
function startSinTowerRpsBlink(session,kind){
  if(sinTowerRpsBlinks.some(e=>e.object.id===session.object.id))return;
  const rec=sinTowerEditorRuntime.props.get(session.object.id)||sinTowerEditorRuntime.models.get(session.object.id);
  if(!rec)return;
  const root=rec.model?rec.group:rec.root;
  const object=getSinTowerEditorObjectById(session.object.id,rec.model?'model':'prop')||session.object;
  if(kind==='win'){
    for(const target of new Set([object,session.object,rec.prop,rec.model].filter(Boolean))){
      target.interaction.glowEnabledBeforeDissolve=target.interaction.glowEnabled!==false;
      target.interaction.dissolving=true;
    }
  }
  let overlay=$('sinRpsLossFlash');
  if(kind==='lose'&&!overlay){overlay=document.createElement('div');overlay.id='sinRpsLossFlash';overlay.setAttribute('aria-hidden','true');overlay.style.cssText='position:fixed;inset:0;z-index:9500;background:#000;opacity:0;pointer-events:none';document.body.append(overlay);}
  sinTowerRpsBlinks.push({session,object,rec,root,kind,sceneId:object.sceneId,phase:0,phaseAt:performance.now(),originalVisible:root?.visible!==false});
  updateSinTowerRpsBlinks();
}
function cancelSinTowerRpsBlinks(){
  for(const e of sinTowerRpsBlinks){if(e.root)e.root.visible=e.originalVisible;for(const target of new Set([e.object,e.session.object,e.rec.prop,e.rec.model].filter(Boolean)))if(target.interaction)target.interaction.dissolving=false;}
  sinTowerRpsBlinks.length=0;if($('sinRpsLossFlash'))$('sinRpsLossFlash').style.opacity='0';
}
function updateSinTowerRpsBlinks(now=performance.now()){
  let flash=false;
  for(let i=sinTowerRpsBlinks.length-1;i>=0;i--){
    const e=sinTowerRpsBlinks[i];
    if(e.sceneId!==SIN_TOWER_EDITOR.activeSceneId){
      // Resolve an already decided match before leaving, without flashing another scene.
      e.phase=10;
    }else if(now-e.phaseAt>=(e.phase%2===0?140:200)){
      // Advance at most one edge per rendered frame: slow frames cannot skip all flashes.
      e.phase++;e.phaseAt=now;
    }
    if(e.phase>=10){
      if(e.kind==='win')finishSinTowerQuestionDissolve({rec:e.rec,object:e.object,materialRecords:[]});
      else e.session.addedLayers=changeSinTowerInfectionLayers(10);
      sinTowerRpsBlinks.splice(i,1);continue;
    }
    if(e.kind==='win'&&e.root)e.root.visible=e.phase%2!==0;
    if(e.kind==='lose'&&e.phase%2===0)flash=true;
  }
  if($('sinRpsLossFlash'))$('sinRpsLossFlash').style.opacity=flash?'.55':'0';
}

function getSinTowerRpsAnchor(v){
  const point=player.position.clone().project(camera);
  return{x:v.left+clamp((point.x+1)*.5,.22,.78)*v.width,y:v.top+clamp((1-point.y)*.5,.32,.67)*v.height};
}
function updateSinTowerRps(){
  const s=sinRpsSession;if(!s)return;
  if(s.object.sceneId!==SIN_TOWER_EDITOR.activeSceneId||(!s.editing&&!s.object.interaction?.enabled)||s.object.interaction.type!=='rps'||!(sinTowerEditorRuntime.props.get(s.object.id)||sinTowerEditorRuntime.models.get(s.object.id))){closeSinTowerInteraction(true,false,true);return;}
  const now=performance.now();settleSinTowerRps(now);
  if(s.revealed&&now-s.finishedAt>4000){closeSinTowerInteraction(true,false,true);return;}
  const v=getSinTowerGameViewport(),anchor=getSinTowerRpsAnchor(v),layout=s.object.interaction.rpsLayout;
  s.viewport=v;s.anchor=anchor;
  for(let i=0;i<4;i++){
    const card=$('sinRpsCard'+i),p=layout[i];card.hidden=i===3&&!s.revealed&&!s.editing;
    const w=Math.min(v.width*.8,p.w*v.width),h=Math.min(v.height*.8,p.h*v.height);
    const x=clamp(anchor.x+p.x*v.width-w/2,v.left+6,v.left+v.width-w-6),y=clamp(anchor.y+p.y*v.height-h/2,v.top+45,v.top+v.height-h-28);
    Object.assign(card.style,{left:x+'px',top:y+'px',width:w+'px',height:h+'px'});
    const kind=i<3?SIN_RPS_KINDS[i]:(s.editing?'rock':s.opponent),img=card.querySelector('img');
    if(img.dataset.kind!==kind){img.dataset.kind=kind;img.src=SIN_RPS_IMAGES[kind];}
    // Hand images carry no visible labels; aria-label remains for accessibility.
    card.classList.toggle('selected',i===s.selected&&i<3);card.setAttribute('aria-pressed',String(i===s.selected));
  }
  const status=$('sinRpsStatus');status.style.left=v.left+'px';status.style.width=v.width+'px';status.style.top=(v.top+v.height*.22)+'px';
  status.textContent=s.editing?'拖曳圖片與四角調整版面':!s.ready&&!s.revealed?'載入圖片…':s.revealed?'':String(Math.max(1,Math.ceil((s.deadline-now)/1000)));
  const canvas=$('sinRpsParticles');if(canvas.width!==innerWidth||canvas.height!==innerHeight){canvas.width=innerWidth;canvas.height=innerHeight;}
  const ctx=canvas.getContext('2d');ctx.clearRect(0,0,canvas.width,canvas.height);
  if(s.revealed){
    const r=$('sinRpsCard3').getBoundingClientRect(),t=(now-s.finishedAt)/1000;
    ctx.fillStyle='#ffeaa0';ctx.shadowColor='#ffe16b';ctx.shadowBlur=5;
    for(let i=0;i<140;i++){
      const life=(t*(.38+(i%7)*.045)+i*.61803398875)%1;
      const spread=Math.sin(i*7.91),x=r.left+r.width*(.5+spread*.42)+spread*life*35;
      const y=r.bottom-r.height*.35-life*(r.height+65);
      ctx.globalAlpha=(1-life)*.85;ctx.beginPath();ctx.arc(x,y,.55+(i%3)*.3,0,Math.PI*2);ctx.fill();
    }
    ctx.globalAlpha=1;ctx.shadowBlur=0;
  }
}
function commitSinTowerRpsLayout(){
  const s=sinRpsSession;if(!s)return;
  const layout=sanitizeSinTowerRpsLayout(s.object.interaction.rpsLayout);
  const object=SIN_TOWER_EDITOR.props.find(o=>o.id===s.object.id)||SIN_TOWER_EDITOR.models.find(o=>o.id===s.object.id)||s.object;
  object.interaction.rpsLayout=layout;s.object=object;
  const indexed=getSinTowerEditorObjectById(object.id);if(indexed?.interaction)indexed.interaction.rpsLayout=layout;
  const rec=sinTowerEditorRuntime.props.get(object.id)||sinTowerEditorRuntime.models.get(object.id);if(rec){if(rec.model)rec.model=object;else rec.prop=object;}
  scheduleSinTowerRuntimeSave();
}
function beginSinTowerRpsDrag(e,index){
  const s=sinRpsSession;if(!s?.editing)return;
  e.preventDefault();e.stopPropagation();const card=$('sinRpsCard'+index),start={...s.object.interaction.rpsLayout[index]},corner=e.target.dataset.corner;
  const x=e.clientX,y=e.clientY,v=s.viewport;card.setPointerCapture(e.pointerId);
  card.onpointermove=ev=>{
    if(sinRpsSession!==s)return;const dx=(ev.clientX-x)/v.width,dy=(ev.clientY-y)/v.height,p=s.object.interaction.rpsLayout[index];
    if(corner){const sx=corner.includes('e')?1:-1,sy=corner.includes('s')?1:-1;
      const factor=clamp(1+(Math.abs(dx/start.w)>Math.abs(dy/start.h)?sx*dx/start.w:sy*dy/start.h),Math.max(.025/start.w,.035/start.h),Math.min(.8/start.w,.8/start.h));
      p.w=start.w*factor;p.h=start.h*factor;p.x=start.x+sx*(p.w-start.w)/2;p.y=start.y+sy*(p.h-start.h)/2;
    }else{p.x=clamp(start.x+dx,-1,1);p.y=clamp(start.y+dy,-1,1);}
    updateSinTowerRps();
  };
  const end=()=>{card.onpointermove=null;card.onpointerup=null;card.onpointercancel=null;commitSinTowerRpsLayout();};
  card.onpointerup=end;card.onpointercancel=end;
}
function handleSinTowerRpsKey(e){
  const s=sinRpsSession;if(!s)return false;
  if(isTextEditingElement(e.target))return false;
  e.preventDefault();e.stopImmediatePropagation();
  if(e.code==='Escape'){closeSinTowerInteraction(true,false,true);return true;}
  if(!s.editing&&!s.revealed&&(e.code==='ArrowLeft'||e.code==='ArrowRight'||e.code==='KeyA'||e.code==='KeyD')){
    if(!e.repeat)s.selected=(s.selected+((e.code==='ArrowRight'||e.code==='KeyD')?1:2))%3;
    updateSinTowerRps();
  }
  return true;
}
function cleanupSinTowerRps(){const returnToPerf=sinRpsSession?.returnToPerf;document.body.classList.remove('sin-rps-active');sinRpsSession=null;const overlay=$('sinRpsOverlay');if(overlay)overlay.hidden=true;if(returnToPerf)queueMicrotask(()=>{enterSinTowerEditorMode();setSinProTab('perf');syncSinProEditor();});}

function openSinTowerInteraction(rec, nearest){
  if(isSinTowerInteractionPlacementActive())return;
  const prop = rec?.prop || rec?.model;
  const config = prop?.interaction;
  if(config?.type==='rps'){openSinTowerRps(rec,nearest);return;}
  if(config?.type==='question'){openSinTowerQuestionInteraction(rec,nearest);return;}
  const overlay = $('sinInteractionOverlay');
  if(!prop || !config?.enabled || config.consumed || config.dissolving || !overlay || sinTowerPlayObjectUi.panelOpen || sinTowerPlayObjectUi.activePropId) return;
  sinTowerPlayObjectUi.resultSession={object:prop,type:config.type,preview:false,applied:false};
  sinTowerPlayObjectUi.activePropId = prop.id;
  sinTowerPlayObjectUi.dismissedPropId = null;
  sinTowerPlayObjectUi.dismissedWorldPosition = null;
  sinTowerPlayObjectUi.activeWorldPosition = nearest.position.clone();
  applySinTowerInteractionStyle(config);
  sinTowerPlayObjectUi.lastPlayerPosition.copy(player.position);
  sinTowerPlayObjectUi.interactionFrame = -1;
  sinTowerPlayObjectUi.previousAutoRun = !!SIN_TOWER_STAIRCASE.autoRun;
  SIN_TOWER_STAIRCASE.autoRun = false;
  $('sinInteractionTitle').textContent = config.title || prop.title || '';
  const scroll = $('sinInteractionScroll');
  const media = $('sinInteractionMedia');
  const image = $('sinInteractionImage');
  const video = $('sinInteractionVideo');
  scroll.scrollTop = 0;
  scroll.textContent = config.type === 'text' ? (config.text || '……') : '';
  scroll.style.display = config.type === 'text' ? 'block' : 'none';
  media.classList.toggle('active', config.type === 'media');
  image.classList.remove('active');
  video.classList.remove('active');
  video.pause?.();
  video.removeAttribute('src');
  if(config.type === 'media'){
    const videoSrc = config.videoDataUrl || (prop.mediaType === 'video' ? prop.videoDataUrl : null);
    const imageSrc = prop.mediaType === 'gif' ? prop.gifDataUrl : prop.frames?.[0]?.dataUrl;
    if(videoSrc){
      video.src = videoSrc;
      video.classList.add('active');
      video.loop = true;
      video.muted = true;
      video.play().catch(()=>{});
    }else if(imageSrc){
      image.src = imageSrc;
      image.classList.add('active');
    }
  }
  clearTimeout(sinTowerPlayObjectUi.closingTimer);
  overlay.classList.remove('open','closing');
  overlay.classList.add('opening');
  overlay.setAttribute('aria-hidden','false');
  document.body.classList.add('play-mode','sin-interaction-open');
  requestAnimationFrame(()=>requestAnimationFrame(()=>{
    if(sinTowerPlayObjectUi.activePropId !== prop.id) return;
    overlay.classList.remove('opening');
    overlay.classList.add('open');
  }));
  setSinTowerModalCursorFree();
}

function finalizeSinTowerInteractionClose(restore=true, requestLock=false){
  const post=sinTowerPlayObjectUi.resultSession;
  const postObject=post?.postReady&&!post.preview&&post.object?.interaction?.afterVideo?.enabled?post.object:null;
  cleanupSinTowerRps();
  const overlay = $('sinInteractionOverlay');
  overlay?.classList.remove('opening','open','closing');
  const questionOverlay=$('sinQuestionOverlay');
  questionOverlay?.classList.remove('open','closing');$('sinQuestionBar')?.classList.remove('answered');questionOverlay?.setAttribute('aria-hidden','true');
  document.body.classList.remove('sin-question-open');
  clearTimeout(sinTowerPlayObjectUi.questionTimer);sinTowerPlayObjectUi.questionTimer=null;
  sinTowerPlayObjectUi.questionTypewriterToken+=1;$('sinQuestionText')?.classList.remove('typing');
  sinTowerPlayObjectUi.questionPointerId=null;setSinTowerQuestionDrag(0);
  overlay?.setAttribute('aria-hidden','true');
  document.body.classList.remove('sin-interaction-open');
  const video = $('sinInteractionVideo');
  try{ video?.pause?.(); }catch(e){}
  if(video){ video.removeAttribute('src'); video.load?.(); }
  sinTowerPlayObjectUi.resultSession=null;
  sinTowerPlayObjectUi.activePropId = null;
  sinTowerPlayObjectUi.activeWorldPosition = null;
  sinTowerPlayObjectUi.interactionFrame = -1;
  SIN_TOWER_STAIRCASE.autoRun = !!sinTowerPlayObjectUi.previousAutoRun;
  clearMovementKeys();
  if(restore) restoreSinTowerPlayLook(requestLock);
  if(postObject)queueMicrotask(()=>{if(!sinTowerPlayObjectUi.activePropId&&!sinAfterVideoSession&&postObject.sceneId===SIN_TOWER_EDITOR.activeSceneId&&!isSinTowerInteractionPlacementActive())showSinAfterVideo(postObject);});
}

function closeSinTowerInteraction(restore=true, requestLock=false, immediate=false){
  if(sinRpsSession)immediate=true;
  const postSession=sinTowerPlayObjectUi.resultSession;
  if(postSession&&['text','media'].includes(postSession.type))postSession.postReady=true;
  if(!sinTowerPlayObjectUi.activePropId) return;
  if(restore)hideSinInteractionCursor();
  if(sinTowerPlayObjectUi.resultSession?.type==='text')applySinTowerInteractionInfectionEffect();
  sinTowerPlayObjectUi.dismissedPropId = sinTowerPlayObjectUi.activePropId;
  sinTowerPlayObjectUi.dismissedWorldPosition = sinTowerPlayObjectUi.activeWorldPosition?.clone?.() || null;
  sinTowerPlayObjectUi.interactionCooldownUntil = performance.now() + (immediate ? 250 : 1150);
  const overlay = $('sinInteractionOverlay');
  $('sinQuestionOverlay')?.classList.add('closing');
  clearTimeout(sinTowerPlayObjectUi.closingTimer);
  if(immediate){ finalizeSinTowerInteractionClose(restore,requestLock); return; }
  overlay?.classList.remove('opening','open');
  overlay?.classList.add('closing');
  sinTowerPlayObjectUi.closingTimer = setTimeout(()=>finalizeSinTowerInteractionClose(restore,requestLock), 1050);
}

const sinTowerInteractionScratchPosition=new THREE.Vector3();
function isSinTowerInteractionPlacementActive(){
  return !!(sinTowerPlayObjectUi.followPropId || sinTowerModelCarry.active);
}
function suspendSinTowerInteractionsForPlacement(){
  if(!sinTowerPlayObjectUi.activePropId)return;
  clearTimeout(sinTowerPlayObjectUi.closingTimer);sinTowerPlayObjectUi.closingTimer=null;
  if(sinRpsSession)sinRpsSession.returnToPerf=false;
  // Cancel an editing interruption without awarding document/question results.
  finalizeSinTowerInteractionClose(false,false);
}
function updateSinTowerPropInteractions(){
  if(sinAfterVideoSession)return;
  if(isSinTowerInteractionPlacementActive()&&!sinRpsSession?.editing){suspendSinTowerInteractionsForPlacement();return;}
  if(sinRpsSession){updateSinTowerRps();return;}
  if(sinTowerPlayObjectUi.panelOpen)return;const activeId=sinTowerPlayObjectUi.activePropId;
  if(activeId){const rec=sinTowerEditorRuntime.props.get(activeId)||sinTowerEditorRuntime.models.get(activeId),prop=rec?.prop||rec?.model,p=sinTowerPlayObjectUi.activeWorldPosition;if(!prop||!p){closeSinTowerInteraction(true,false,true);return;}if(prop.interaction?.type==='media'&&prop.mediaType!=='video'&&prop.frames?.length&&$('sinInteractionImage')?.classList.contains('active')){const frame=rec.frame||0;if(frame!==sinTowerPlayObjectUi.interactionFrame){sinTowerPlayObjectUi.interactionFrame=frame;$('sinInteractionImage').src=prop.frames[frame%prop.frames.length].dataUrl;}}const dx=player.position.x-p.x,dz=player.position.z-p.z,dy=(player.position.y-p.y)*.35,distance=Math.sqrt(dx*dx+dz*dz+dy*dy),moved=player.position.distanceToSquared(sinTowerPlayObjectUi.lastPlayerPosition)>.0025;sinTowerPlayObjectUi.lastPlayerPosition.copy(player.position);if(moved&&(keys.w||keys.a||keys.s||keys.d)&&distance>safeFinite(prop.interaction?.radius,3.2)*1.14)closeSinTowerInteraction(true,false);return;}
  const now=performance.now();if(now<safeFinite(sinTowerPlayObjectUi.interactionCooldownUntil,0)||now-safeFinite(sinTowerPlayObjectUi.lastInteractionScan,0)<33)return;sinTowerPlayObjectUi.lastInteractionScan=now;
  const dismissed=sinTowerPlayObjectUi.dismissedPropId;if(dismissed){const rec=sinTowerEditorRuntime.props.get(dismissed)||sinTowerEditorRuntime.models.get(dismissed),object=rec?.prop||rec?.model,p=sinTowerPlayObjectUi.dismissedWorldPosition;if(p){const dx=player.position.x-p.x,dz=player.position.z-p.z,dy=(player.position.y-p.y)*.35,distance=Math.sqrt(dx*dx+dz*dz+dy*dy),rearmDistance=safeFinite(object?.interaction?.radius,3.2)+Math.max(.38,safeFinite(object?.interaction?.radius,3.2)*.12);if(distance<=rearmDistance)return;}sinTowerPlayObjectUi.dismissedPropId=null;sinTowerPlayObjectUi.dismissedWorldPosition=null;}
  for(const rec of sinTowerEditorRuntime.props.values()){const prop=rec?.prop;if(!prop?.interaction?.enabled||prop.interaction.consumed||prop.interaction.dissolving||prop.sceneId!==SIN_TOWER_EDITOR.activeSceneId)continue;const nearest=nearestSinTowerPropVisual(rec),radius=safeFinite(prop.interaction.radius,3.2);if(nearest&&nearest.distanceSquared<=radius*radius){openSinTowerInteraction(rec,{...nearest,position:nearest.position.clone()});return;}}
  for(const rec of sinTowerEditorRuntime.models.values()){const model=rec?.model;if(!model?.interaction?.enabled||model.interaction.consumed||model.interaction.dissolving||model.sceneId!==SIN_TOWER_EDITOR.activeSceneId||!rec.group?.visible)continue;rec.group.getWorldPosition(sinTowerInteractionScratchPosition);const dx=player.position.x-sinTowerInteractionScratchPosition.x,dz=player.position.z-sinTowerInteractionScratchPosition.z,dy=(player.position.y-sinTowerInteractionScratchPosition.y)*.35,radius=safeFinite(model.interaction.radius,3.2),distanceSquared=dx*dx+dz*dz+dy*dy;if(distanceSquared<=radius*radius){openSinTowerInteraction(rec,{distance:Math.sqrt(distanceSquared),position:sinTowerInteractionScratchPosition.clone()});return;}}
}

function closeSinTowerPlayPropActions(clearSelection=true){
  sinTowerPlayObjectUi.selectedVisual = null;
  if(clearSelection){
    const selectedType=sinTowerPlayObjectUi.selectedPlayType;
    sinTowerPlayObjectUi.selectedPropId = null;
    sinTowerPlayObjectUi.selectedPlayType = null;
    if(SIN_TOWER_EDITOR.selectedObjectType === selectedType){
      SIN_TOWER_EDITOR.selectedObjectType = null;
      SIN_TOWER_EDITOR.selectedObjectId = null;
    }
  }
  const panel = $('sinPlayObjectActions');
  panel?.classList.remove('open');
  panel?.setAttribute('aria-hidden','true');
}

function getSinTowerSelectedPlayProp(){
  if(sinTowerPlayObjectUi.selectedPlayType!=='prop') return null;
  return getSinTowerEditorObjectById(sinTowerPlayObjectUi.selectedPropId,'prop');
}

function getSinTowerSelectedPlayModel(){
  if(sinTowerPlayObjectUi.selectedPlayType!=='model') return null;
  return getSinTowerEditorObjectById(sinTowerPlayObjectUi.selectedPropId,'model');
}

function getSinTowerSelectedPlayPortal(){
  if(sinTowerPlayObjectUi.selectedPlayType!=='portal') return null;
  return getSinTowerEditorObjectById(sinTowerPlayObjectUi.selectedPropId,'portal');
}

function getSinTowerSelectedPlayObject(){
  return getSinTowerSelectedPlayPortal()||getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp();
}

const sinTowerAudioRuntime={scene:null,objects:new Map(),unlocked:false,lastUpdate:0,worldPoint:new THREE.Vector3(),context:null,retiring:new Set()};
function sinAudioContext(){if(!sinTowerAudioRuntime.context){const C=window.AudioContext||window.webkitAudioContext;if(C)sinTowerAudioRuntime.context=new C();}return sinTowerAudioRuntime.context;}
function sinAudioLevel(entry){const r=entry.ramp;if(!r)return entry.gain?entry.gain.gain.value:entry.audio.volume;const t=clamp((performance.now()-r.start)/r.duration,0,1);return r.from+(r.to-r.from)*t;}
function rampSinAudio(entry,target,duration=650){
  if(!entry)return;target=clamp(target,0,1);if(entry.ramp?.to===target)return;
  const from=sinAudioLevel(entry);entry.ramp={from,to:target,start:performance.now(),duration};
  if(entry.gain){const p=entry.gain.gain,t=sinTowerAudioRuntime.context.currentTime;p.cancelScheduledValues(t);p.setValueAtTime(from,t);p.linearRampToValueAtTime(target,t+duration/1000);}
  else{clearTimeout(entry.fadeTimer);const tick=()=>{entry.audio.volume=sinAudioLevel(entry);if(performance.now()-entry.ramp.start<entry.ramp.duration)entry.fadeTimer=setTimeout(tick,16);};tick();}
}
function stopSinTowerAudioEntry(entry){
  if(!entry||entry.retiring)return;entry.retiring=true;entry.targetVolume=0;sinTowerAudioRuntime.retiring.add(entry);rampSinAudio(entry,0);
  entry.stopTimer=setTimeout(()=>{try{entry.audio.pause();entry.audio.removeAttribute('src');entry.audio.load?.();entry.source?.disconnect();entry.gain?.disconnect();}catch{}clearTimeout(entry.fadeTimer);entry.pending=null;sinTowerAudioRuntime.retiring.delete(entry);},700);
}
function makeSinTowerAudioEntry(key,cfg){
  const audio=new Audio();audio.preload='auto';audio.loop=cfg.loop!==false;audio.src=cfg.dataUrl;audio.volume=0;
  const entry={key,audio,url:cfg.dataUrl,pending:null,targetVolume:0},context=sinAudioContext();
  if(context){entry.source=context.createMediaElementSource(audio);entry.gain=context.createGain();entry.gain.gain.value=0;entry.source.connect(entry.gain).connect(context.destination);audio.volume=1;}return entry;
}
function playSinTowerAudioEntry(entry){
  if(!entry||entry.retiring||!sinTowerAudioRuntime.unlocked||!entry.audio.paused||entry.pending||(!entry.audio.loop&&entry.audio.ended))return;
  entry.pending=entry.audio.play().then(()=>{if(!entry.retiring)rampSinAudio(entry,entry.targetVolume);}).catch(()=>{}).finally(()=>entry.pending=null);
}
function targetSinAudio(entry,target){
  target=document.hidden?0:target;entry.targetVolume=target;
  if(target>.0001){clearTimeout(entry.silentTimer);entry.silentTimer=null;if(entry.audio.paused)playSinTowerAudioEntry(entry);else rampSinAudio(entry,target);}
  else{rampSinAudio(entry,0);if(!entry.audio.paused&&!entry.silentTimer)entry.silentTimer=setTimeout(()=>{entry.silentTimer=null;if(entry.targetVolume===0&&!entry.retiring)entry.audio.pause();},700);}
}
function unlockSinTowerAudio(){if(sinTowerAudioRuntime.unlocked&&sinTowerAudioRuntime.context?.state==='running')return;sinTowerAudioRuntime.unlocked=true;void sinAudioContext()?.resume();void prepareSinMonkHitSound();updateSinTowerAudioRuntime(true);}
window.addEventListener('pointerdown',unlockSinTowerAudio,{capture:true,passive:true});
window.addEventListener('keydown',unlockSinTowerAudio,{capture:true});
document.addEventListener('visibilitychange',()=>updateSinTowerAudioRuntime(true));
function sinTowerObjectAudioDistance(object,type){
  const target=sinTowerAudioRuntime.worldPoint;let best=Infinity;
  if(type==='prop')for(const visual of sinTowerEditorRuntime.props.get(object.id)?.visuals||[]){if(visual.group?.visible===false)continue;visual.group.getWorldPosition(target);best=Math.min(best,player.position.distanceTo(target));}
  else{const rec=type==='model'?sinTowerEditorRuntime.models.get(object.id):type==='portal'?sinTowerEditorRuntime.portals.get(object.id):sinTowerEditorRuntime.stones.get(object.id);const node=rec?.group||rec?.mesh;if(node&&node.visible!==false){node.getWorldPosition(target);best=player.position.distanceTo(target);}}return best;
}
function syncSinTowerSceneAudioRuntime(){
  const sceneState=getSinTowerActiveScene(),cfg=sceneState?.audio;
  if(!cfg?.dataUrl){stopSinTowerAudioEntry(sinTowerAudioRuntime.scene);sinTowerAudioRuntime.scene=null;return;}
  let entry=sinTowerAudioRuntime.scene;if(!entry||entry.key!==sceneState.id||entry.url!==cfg.dataUrl){stopSinTowerAudioEntry(entry);entry=makeSinTowerAudioEntry(sceneState.id,cfg);sinTowerAudioRuntime.scene=entry;}
  entry.audio.loop=cfg.loop!==false;targetSinAudio(entry,clamp(safeFinite(cfg.volume,.7),0,1));
}
function updateSinTowerAudioRuntime(force=false){
  const now=performance.now();if(!force&&now-sinTowerAudioRuntime.lastUpdate<80)return;sinTowerAudioRuntime.lastUpdate=now;syncSinTowerSceneAudioRuntime();
  const active=SIN_TOWER_EDITOR.activeSceneId,live=new Set(),groups=[['prop',SIN_TOWER_EDITOR.props],['model',SIN_TOWER_EDITOR.models],['portal',SIN_TOWER_EDITOR.portals],['stone',SIN_TOWER_EDITOR.stones]];
  for(const [type,items] of groups)for(const object of items){const cfg=object.audio;if(object.sceneId!==active||!cfg?.dataUrl||object.interaction?.consumed)continue;const key=type+':'+object.id;live.add(key);let entry=sinTowerAudioRuntime.objects.get(key);if(!entry||entry.url!==cfg.dataUrl){stopSinTowerAudioEntry(entry);entry=makeSinTowerAudioEntry(key,cfg);sinTowerAudioRuntime.objects.set(key,entry);}entry.audio.loop=cfg.loop!==false;const distance=sinTowerObjectAudioDistance(object,type),ratio=Number.isFinite(distance)?clamp(1-distance/clamp(safeFinite(cfg.maxDistance,18),1,100),0,1):0;targetSinAudio(entry,clamp(safeFinite(cfg.volume,.85),0,1)*Math.pow(ratio,1.35));}
  for(const [key,entry] of sinTowerAudioRuntime.objects)if(!live.has(key)){stopSinTowerAudioEntry(entry);sinTowerAudioRuntime.objects.delete(key);}
}
let sinMonkHitBuffer=null,sinMonkHitPromise=null;const sinMonkHitVoices=new Set();
function prepareSinMonkHitSound(){return sinMonkHitPromise ||= (async()=>{const context=sinAudioContext();if(!context)return;sinMonkHitBuffer=await context.decodeAudioData(await (await fetch(SIN_MONK_HIT_SOUND)).arrayBuffer());})().catch(error=>{sinMonkHitPromise=null;console.warn('Monk collision sound unavailable',error);});}
function playSinMonkHitSound(){
  const context=sinAudioContext();if(!sinTowerAudioRuntime.unlocked||!context||!sinMonkHitBuffer||sinMonkHitVoices.size>=8)return;
  const source=context.createBufferSource(),gain=context.createGain(),t=context.currentTime,d=sinMonkHitBuffer.duration;source.buffer=sinMonkHitBuffer;source.connect(gain).connect(context.destination);gain.gain.setValueAtTime(0,t);gain.gain.linearRampToValueAtTime(.9,t+.008);gain.gain.setValueAtTime(.9,t+Math.max(.009,d-.06));gain.gain.linearRampToValueAtTime(0,t+d);sinMonkHitVoices.add(source);source.onended=()=>{sinMonkHitVoices.delete(source);source.disconnect();gain.disconnect();};source.start();
}

function getSinTowerSelectedAudioObject(){return getSinTowerSelectedPlayObject()||(['prop','model','portal','stone'].includes(SIN_TOWER_EDITOR.selectedObjectType)?getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId,SIN_TOWER_EDITOR.selectedObjectType):null);}
function syncSinTowerSceneAudioControls(sceneState=getSinTowerActiveScene()){const cfg=sceneState?.audio||sanitizeSinTowerAudio(null,false);if($('sinSceneAudioState'))$('sinSceneAudioState').textContent=cfg.dataUrl?'已置入：'+(cfg.name||'場景音效'):'尚未置入場景音效。';if($('sinSceneAudioVolume')&&document.activeElement!==$('sinSceneAudioVolume'))$('sinSceneAudioVolume').value=String(Math.round(cfg.volume*100));if($('sinSceneAudioVolumeValue'))$('sinSceneAudioVolumeValue').textContent=Math.round(cfg.volume*100)+'%';if($('sinSceneAudioLoop'))$('sinSceneAudioLoop').checked=cfg.loop!==false;}
function syncSinTowerSelectedObjectAudioControls(object=getSinTowerSelectedAudioObject()){const panel=$('sinSelectedObjectAudioControls');if(panel)panel.hidden=!object;if(!object)return;const cfg=object.audio||sanitizeSinTowerAudio(null,true);if($('sinSelectedObjectAudioState'))$('sinSelectedObjectAudioState').textContent=cfg.dataUrl?'已置入：'+(cfg.name||'物件音效'):'尚未置入物件音效。';if($('sinSelectedObjectAudioVolume')&&document.activeElement!==$('sinSelectedObjectAudioVolume'))$('sinSelectedObjectAudioVolume').value=String(Math.round(cfg.volume*100));if($('sinSelectedObjectAudioVolumeValue'))$('sinSelectedObjectAudioVolumeValue').textContent=Math.round(cfg.volume*100)+'%';if($('sinSelectedObjectAudioDistance')&&document.activeElement!==$('sinSelectedObjectAudioDistance'))$('sinSelectedObjectAudioDistance').value=String(cfg.maxDistance);if($('sinSelectedObjectAudioDistanceValue'))$('sinSelectedObjectAudioDistanceValue').textContent=cfg.maxDistance.toFixed(1);if($('sinSelectedObjectAudioLoop'))$('sinSelectedObjectAudioLoop').checked=cfg.loop!==false;}
async function importSinTowerSceneAudio(file){const sceneState=getSinTowerActiveScene();if(!sceneState||!file)return;unlockSinTowerAudio();const loaded=await readSinTowerAudioFile(file);sceneState.audio=sanitizeSinTowerAudio({...sceneState.audio,...loaded},false);scheduleSinTowerRuntimeSave();syncSinTowerSceneAudioControls(sceneState);updateSinTowerAudioRuntime(true);setStatus('已為場景「'+sceneState.title+'」置入音效：'+loaded.name);}
async function importSinTowerSelectedObjectAudio(file){const object=getSinTowerSelectedAudioObject();if(!object||!file)return;unlockSinTowerAudio();const loaded=await readSinTowerAudioFile(file);object.audio=sanitizeSinTowerAudio({...object.audio,...loaded},true);scheduleSinTowerRuntimeSave();syncSinTowerSelectedObjectAudioControls(object);updateSinTowerAudioRuntime(true);setStatus('已為物件「'+object.title+'」置入距離音效：'+loaded.name);}
function updateSinTowerSceneAudioFromUi(){const sceneState=getSinTowerActiveScene();if(!sceneState)return;sceneState.audio=sanitizeSinTowerAudio({...sceneState.audio,volume:safeFinite($('sinSceneAudioVolume')?.value,70)/100,loop:$('sinSceneAudioLoop')?.checked!==false},false);scheduleSinTowerRuntimeSave();syncSinTowerSceneAudioControls(sceneState);updateSinTowerAudioRuntime(true);}
function updateSinTowerSelectedObjectAudioFromUi(){const object=getSinTowerSelectedAudioObject();if(!object)return;object.audio=sanitizeSinTowerAudio({...object.audio,volume:safeFinite($('sinSelectedObjectAudioVolume')?.value,85)/100,maxDistance:safeFinite($('sinSelectedObjectAudioDistance')?.value,18),loop:$('sinSelectedObjectAudioLoop')?.checked!==false},true);scheduleSinTowerRuntimeSave();syncSinTowerSelectedObjectAudioControls(object);updateSinTowerAudioRuntime(true);}

function syncSinTowerSelectedPortalRoute(portal){
  const panel=$('sinSelectedPortalRoute'),source=$('sinSelectedPortalSource'),target=$('sinSelectedPortalTarget'),enabled=$('sinSelectedPortalPasswordEnabled'),password=$('sinSelectedPortalPassword');
  if(panel) panel.hidden=!portal;
  if(!portal||!source||!target) return;
  fillSinTowerPortalSceneSelect(source,portal.sceneId,true);
  fillSinTowerPortalSceneSelect(target,portal.targetSceneId,true);
  source.value=portal.sceneId;
  if(SIN_TOWER_EDITOR.scenes.some(sceneState=>sceneState.id===portal.targetSceneId)) target.value=portal.targetSceneId;
  if(enabled) enabled.checked=!!portal.passwordEnabled;
  if(password){password.value=sanitizeSinTowerPortalPassword(portal.password);password.disabled=!portal.passwordEnabled;}
}

function syncSinTowerPlayPropActions(){
  const portal=getSinTowerSelectedPlayPortal();
  const model=getSinTowerSelectedPlayModel();
  const prop=getSinTowerSelectedPlayProp();
  const object=portal||model||prop;
  const panel=$('sinPlayObjectActions');
  if(!object||!panel){closeSinTowerPlayPropActions(true);return;}
  const type=portal?'portal':model?'model':'prop';
  $('sinSelectedPropTitle').textContent=object.title||(portal?'魔法傳送門':model?'3D 模型':'新增物件');
  const following=sinTowerPlayObjectUi.followPropId===object.id&&sinTowerPlayObjectUi.followObjectType===type;
  $('sinSelectedPropFollow').textContent=following?'固定在目前位置':'跟隨角色移動';
  const rotation=portal?safeFinite(object.rotationY,0):model?safeFinite(object.rotation?.y,0):safeFinite(object.rotationZ,0);
  $('sinSelectedPropRotate').textContent='旋轉 +15°（目前 '+Math.round(rotation)+'°）';
  const scaleSlider=$('sinSelectedPropScale'),scaleValue=$('sinSelectedPropScaleValue');
  const proportionalSize=portal
    ?clamp(safeFinite(object.uniformScale,1),.2,240)
    :model
      ?clamp((safeFinite(object.scale?.x,1)+safeFinite(object.scale?.y,1)+safeFinite(object.scale?.z,1))/3,.01,400)
      :clamp(safeFinite(object.height,3),.1,600);
  if(scaleSlider){
    scaleSlider.min=portal?'.2':model?'.01':'.1';
    scaleSlider.max=portal?'240':model?'400':'600';
    scaleSlider.step=model?'.01':'.05';
    if(document.activeElement!==scaleSlider) scaleSlider.value=String(proportionalSize);
  }
  if(scaleValue) scaleValue.textContent=proportionalSize.toFixed(2);
  syncSinSelectedVideoFilter(object);
  syncSinTowerSelectedObjectAudioControls(object);
  syncSinTowerSelectedPortalRoute(portal);

  const interactionPanel=$('sinSelectedInteractionStyle');
  const interaction=!portal&&object.interaction?.enabled?object.interaction:null;
  if(interactionPanel) interactionPanel.hidden=!interaction;
  if(interaction){
    const result=sanitizeSinTowerInfectionEffect(interaction.infectionEffect);
    $('sinSelectedInfectionEnabled').checked=result.enabled;
    $('sinSelectedInfectionDirection').value=result.direction;
    $('sinSelectedInfectionLayers').value=result.layers;
    if($('sinSelectedInteractionType'))$('sinSelectedInteractionType').value=interaction.type||'text';
    syncSinTowerRpsEditor(object);
    syncSinExtraSelected(object);
    const interactionRadius=clamp(safeFinite(interaction.radius,3.2),.8,30);
    if($('sinSelectedInteractionRadius')&&document.activeElement!==$('sinSelectedInteractionRadius'))$('sinSelectedInteractionRadius').value=String(interactionRadius);
    if($('sinSelectedInteractionRadiusValue'))$('sinSelectedInteractionRadiusValue').textContent=interactionRadius.toFixed(1);
    if($('sinSelectedInteractionGlow')) $('sinSelectedInteractionGlow').checked=interaction.glowEnabled!==false;
    const particleCount=clamp(Math.round(safeFinite(interaction.particleCount,840)),120,2400);
    if($('sinSelectedInteractionParticles')){if(document.activeElement!==$('sinSelectedInteractionParticles'))$('sinSelectedInteractionParticles').value=String(particleCount);$('sinSelectedInteractionParticles').disabled=interaction.glowEnabled===false;}
    if($('sinSelectedInteractionParticlesValue'))$('sinSelectedInteractionParticlesValue').textContent=String(particleCount);
    const particleAxes=normalizeSinTowerParticleAxes(interaction.particleAxes);
    for(const [id,key] of [['sinSelectedParticleAxisX','x'],['sinSelectedParticleAxisY','y'],['sinSelectedParticleAxisZ','z']])if($(id)){$(id).checked=particleAxes[key];$(id).disabled=interaction.glowEnabled===false;}
    const isText=interaction.type==='text',isQuestion=interaction.type==='question';
    document.querySelectorAll('.sin-selected-text-only').forEach(node=>node.hidden=!isText);
    document.querySelectorAll('.sin-selected-document-only').forEach(node=>node.hidden=!(isText||isQuestion));
    document.querySelectorAll('.sin-selected-question-only').forEach(node=>node.hidden=!isQuestion);
    $('sinSelectedInfectionEnabled').closest('details').hidden=!isText;
    if(isText||isQuestion){
      const cornerRadius=clamp(safeFinite(interaction.cornerRadius,6),0,32);
      if($('sinSelectedDocRadius')&&document.activeElement!==$('sinSelectedDocRadius'))$('sinSelectedDocRadius').value=String(cornerRadius);
      if($('sinSelectedDocRadiusValue'))$('sinSelectedDocRadiusValue').textContent=Math.round(cornerRadius)+'px';
    }
    if(isText){
      if($('sinSelectedInteractionTitle')&&document.activeElement!==$('sinSelectedInteractionTitle'))$('sinSelectedInteractionTitle').value=interaction.title||object.title||'';
      if($('sinSelectedInteractionText')&&document.activeElement!==$('sinSelectedInteractionText'))$('sinSelectedInteractionText').value=interaction.text||'';
      if($('sinSelectedInteractionFont')) $('sinSelectedInteractionFont').value=interaction.fontFamily||'serif';
      if($('sinSelectedInteractionTitleSize')) $('sinSelectedInteractionTitleSize').value=clamp(safeFinite(interaction.titleSize,38),1,72);
      if($('sinSelectedInteractionBodySize')) $('sinSelectedInteractionBodySize').value=clamp(safeFinite(interaction.bodySize,18),1,42);
      const opacity=Math.round(clamp(safeFinite(interaction.backgroundOpacity,.85),.05,1)*100);
      if($('sinSelectedDocOpacity')&&document.activeElement!==$('sinSelectedDocOpacity'))$('sinSelectedDocOpacity').value=String(opacity);
      if($('sinSelectedDocOpacityValue'))$('sinSelectedDocOpacityValue').textContent=opacity+'%';
      for(const [id,key,fallback,digits] of [['sinSelectedVhsIntensity','vhsIntensity',1,2],['sinSelectedVhsScan','vhsScanDensity',6,2],['sinSelectedVhsOffset','vhsOffset',10,1],['sinSelectedVhsSpeed','vhsSpeed',5,2],['sinSelectedVhsNoise','vhsNoise',.24,2]]){
        const input=$(id),output=$(id+'Value'),value=safeFinite(interaction[key],fallback);
        if(input&&document.activeElement!==input)input.value=String(value);if(output)output.textContent=value.toFixed(digits);
      }
    }
    if(isQuestion){
      const opacity=Math.round(clamp(safeFinite(interaction.backgroundOpacity,.85),.05,1)*100);
      if($('sinSelectedDocOpacity')&&document.activeElement!==$('sinSelectedDocOpacity'))$('sinSelectedDocOpacity').value=String(opacity);
      if($('sinSelectedDocOpacityValue'))$('sinSelectedDocOpacityValue').textContent=opacity+'%';
      for(const [id,key,fallback,digits] of [['sinSelectedVhsIntensity','vhsIntensity',1,2],['sinSelectedVhsScan','vhsScanDensity',6,2],['sinSelectedVhsOffset','vhsOffset',10,1],['sinSelectedVhsSpeed','vhsSpeed',5,2],['sinSelectedVhsNoise','vhsNoise',.24,2]]){
        const input=$(id),output=$(id+'Value'),value=safeFinite(interaction[key],fallback);
        if(input&&document.activeElement!==input)input.value=String(value);if(output)output.textContent=value.toFixed(digits);
      }
      const cps=clamp(safeFinite(interaction.questionTypewriterCps,22),5,80);
      if($('sinSelectedQuestionSpeed')&&document.activeElement!==$('sinSelectedQuestionSpeed'))$('sinSelectedQuestionSpeed').value=String(cps);
      if($('sinSelectedQuestionSpeedValue'))$('sinSelectedQuestionSpeedValue').textContent=Math.round(cps)+' 字／秒';
      const questionSize=clamp(safeFinite(interaction.questionTextSize,23),1,48),questionOpacity=Math.round(clamp(safeFinite(interaction.questionTextOpacity,1),.1,1)*100);
      if($('sinSelectedQuestionTextSize')&&document.activeElement!==$('sinSelectedQuestionTextSize'))$('sinSelectedQuestionTextSize').value=String(questionSize);
      if($('sinSelectedQuestionTextSizeValue'))$('sinSelectedQuestionTextSizeValue').textContent=Math.round(questionSize)+'px';
      if($('sinSelectedQuestionTextOpacity')&&document.activeElement!==$('sinSelectedQuestionTextOpacity'))$('sinSelectedQuestionTextOpacity').value=String(questionOpacity);
      if($('sinSelectedQuestionTextOpacityValue'))$('sinSelectedQuestionTextOpacityValue').textContent=questionOpacity+'%';
      const dissolveCount=clamp(Math.round(safeFinite(interaction.dissolveParticleCount,4200)),400,12000),dissolveDensity=clamp(safeFinite(interaction.dissolveDensity,1.6),.25,4);
      if($('sinSelectedDissolveParticles')&&document.activeElement!==$('sinSelectedDissolveParticles'))$('sinSelectedDissolveParticles').value=String(dissolveCount);
      if($('sinSelectedDissolveParticlesValue'))$('sinSelectedDissolveParticlesValue').textContent=String(dissolveCount);
      if($('sinSelectedDissolveDensity')&&document.activeElement!==$('sinSelectedDissolveDensity'))$('sinSelectedDissolveDensity').value=String(dissolveDensity);
      if($('sinSelectedDissolveDensityValue'))$('sinSelectedDissolveDensityValue').textContent=dissolveDensity.toFixed(2);
      renderSinTowerSelectedQuestions();
    }
  }

  const driftPanel=$('sinSelectedDrift'),driftFields=$('sinSelectedDriftFields');
  const canDrift=!portal&&(!!model||!!prop);
  if(driftPanel) driftPanel.hidden=!canDrift;
  if(canDrift){
    const enabled=!!object.driftEnabled,axes=object.driftAxes||{x:true,y:false,z:false};
    if($('sinSelectedDriftEnabled')) $('sinSelectedDriftEnabled').checked=enabled;
    if(driftFields) driftFields.hidden=!enabled;
    if($('sinSelectedDriftX')) $('sinSelectedDriftX').checked=axes.x!==false;
    if($('sinSelectedDriftY')) $('sinSelectedDriftY').checked=!!axes.y;
    if($('sinSelectedDriftZ')) $('sinSelectedDriftZ').checked=!!axes.z;
    for(const [id,key,fallback] of [['sinSelectedDriftDistance','driftDistance',2],['sinSelectedDriftSpeed','driftSpeed',.65],['sinSelectedDriftIrregularity','driftIrregularity',.45]]){
      const input=$(id),output=$(id+'Value'),value=safeFinite(object[key],fallback);
      if(input&&document.activeElement!==input) input.value=String(value);
      if(output) output.textContent=value.toFixed(2);
    }
  }
  const kindLabel=portal?'傳送門':model?'3D 模型':'PNG／GIF／影片';
  $('sinSelectedPropState').textContent=(following?'跟隨中；按 Enter 或按「固定」完成。':'已固定；Ctrl+9 向上，Ctrl+0 向下。')+' '+kindLabel+(portal?'會保持等比例縮放。':'可設定等比例縮放與不規則巡邏。');
  panel.classList.add('open');panel.setAttribute('aria-hidden','false');
}

function selectSinTowerPlayProp(propId,visual=null){
  const prop=getSinTowerEditorObjectById(propId,'prop');
  if(!prop) return false;
  sinTowerPlayObjectUi.selectedPropId=prop.id;
  sinTowerPlayObjectUi.selectedPlayType='prop';
  sinTowerPlayObjectUi.selectedVisual=visual;
  SIN_TOWER_EDITOR.selectedObjectType='prop';SIN_TOWER_EDITOR.selectedObjectId=prop.id;
  syncSinTowerPlayPropActions();
  setStatus('已選取新增物件：'+prop.title+'。可跟隨、旋轉、等比例縮放、巡邏或刪除。');
  return true;
}

function selectSinTowerPlayModel(modelId){
  const model=getSinTowerEditorObjectById(modelId,'model');
  if(!model) return false;
  sinTowerPlayObjectUi.selectedPropId=model.id;
  sinTowerPlayObjectUi.selectedPlayType='model';
  sinTowerPlayObjectUi.selectedVisual=null;
  SIN_TOWER_EDITOR.selectedObjectType='model';SIN_TOWER_EDITOR.selectedObjectId=model.id;
  sinTowerModelCarry.active=false;sinTowerModelCarry.id=null;
  syncSinTowerPlayPropActions();
  setStatus('已選取 3D 模型：'+model.title+'。可跟隨、旋轉、等比例縮放、巡邏或刪除。');
  return true;
}

function pickSinTowerPlayPropFromPointer(event){
  if(!sinTowerPlayObjectUi.cursorEditMode||!cursorFreeMode||pointerLocked) return false;
  const candidates=[],visualBySprite=new Map();
  for(const rec of sinTowerEditorRuntime.props.values()){
    if(rec?.prop?.sceneId!==SIN_TOWER_EDITOR.activeSceneId) continue;
    for(const visual of rec.visuals||[]){
      if(!visual?.sprite||visual.group?.visible===false) continue;
      candidates.push(visual.sprite);visualBySprite.set(visual.sprite,{rec,visual});
    }
  }
  if(!candidates.length) return false;
  const ray=new THREE.Raycaster();ray.setFromCamera(pointerNDC(event),camera);
  const hit=ray.intersectObjects(candidates,false)[0],picked=hit?visualBySprite.get(hit.object):null;
  return picked?selectSinTowerPlayProp(picked.rec.prop.id,picked.visual):false;
}

function selectSinTowerPlayPortal(portalId){
  const portal=getSinTowerEditorObjectById(portalId,'portal');
  if(!portal) return false;
  sinTowerPlayObjectUi.selectedPropId=portal.id;sinTowerPlayObjectUi.selectedPlayType='portal';sinTowerPlayObjectUi.selectedVisual=null;
  SIN_TOWER_EDITOR.selectedObjectType='portal';SIN_TOWER_EDITOR.selectedObjectId=portal.id;
  syncSinTowerPlayPropActions();
  setStatus('已選取魔法傳送門：'+portal.title+'。可指定起點與終點、移動、旋轉、等比例縮放或刪除。');
  return true;
}

function pickSinTowerPlayPortalFromPointer(event){
  if(!sinTowerPlayObjectUi.cursorEditMode||!cursorFreeMode||pointerLocked) return false;
  const meshes=[];
  for(const rec of sinTowerEditorRuntime.portals.values()) rec.group?.traverse?.(node=>{if(node.isMesh&&node.visible!==false)meshes.push(node);});
  if(!meshes.length) return false;
  const ray=new THREE.Raycaster();ray.setFromCamera(pointerNDC(event),camera);
  const hit=ray.intersectObjects(meshes,false)[0],id=hit?.object?.userData?.sinTowerEditorId;
  return id?selectSinTowerPlayPortal(id):false;
}

function refreshSinTowerPlayPropBasePositions(prop){
  const rec=sinTowerEditorRuntime.props.get(prop?.id);
  if(!rec) return;
  rec.prop=prop;
  for(const visual of rec.visuals||[]){
    const visualStep=prop.repeatOnStairs?safeFinite(visual.step,prop.step):safeFinite(prop.step,visual.step);
    const base=rec.sceneInfo?.type==='stairs'&&prop.followStairs!==false
      ?sinTowerWorldPositionFromStep(visualStep,prop.offset)
      :sinTowerEditorWorldPosition(rec.sceneInfo,prop);
    visual.group.userData.basePosition=base.clone();visual.group.position.copy(base);
  }
}

function setSinTowerPlayPropWorldPosition(prop,world){
  if(!prop) return;
  const sceneInfo=getSinTowerSceneById(prop.sceneId)||getSinTowerActiveScene();
  const placement=sinTowerPropPlacementFromWorld(world,sceneInfo?.type==='stairs'&&prop.followStairs!==false,sceneInfo);
  prop.position=placement.position;prop.step=placement.step;prop.offset=placement.offset;prop.followStairs=placement.followStairs;
  const rec=sinTowerEditorRuntime.props.get(prop.id);if(rec) rec.prop=prop;
  if(!prop.repeatOnStairs) for(const visual of rec?.visuals||[]) visual.step=prop.step;
  refreshSinTowerPlayPropBasePositions(prop);
}

function setSinTowerPlayModelWorldPosition(model,world){
  if(!model||!world) return;
  model.position={x:safeFinite(world.x,0),y:safeFinite(world.y,0),z:safeFinite(world.z,0)};
  const rec=sinTowerEditorRuntime.models.get(model.id);if(rec){rec.model=model;applySinTowerEditorModelTransform(rec);}
}

function setSinTowerPlayPortalWorldPosition(portal,world){
  if(!portal) return;
  const sceneInfo=getSinTowerSceneById(portal.sceneId)||getSinTowerActiveScene();
  const placement=sinTowerPropPlacementFromWorld(world,sceneInfo?.type==='stairs',sceneInfo);
  portal.step=placement.step;portal.offset=placement.offset;
  applySinTowerEditorPortalTransform(sinTowerEditorRuntime.portals.get(portal.id));
}

function updateSinTowerFollowedProp(){
  const type=sinTowerPlayObjectUi.followObjectType;
  if(!type||!sinTowerPlayObjectUi.followPropId) return;
  const object=getSinTowerEditorObjectById(sinTowerPlayObjectUi.followPropId,type);
  if(!object||object.sceneId!==SIN_TOWER_EDITOR.activeSceneId){sinTowerPlayObjectUi.followPropId=null;sinTowerPlayObjectUi.followObjectType=null;return;}
  const forward=getPlayerForward(),world=player.position.clone().addScaledVector(forward,2.5);
  world.y=player.position.y+(type==='portal'?safeFinite(object.height,2.6)*.5:.04);
  if(type==='portal') setSinTowerPlayPortalWorldPosition(object,world);
  else if(type==='model') setSinTowerPlayModelWorldPosition(object,world);
  else setSinTowerPlayPropWorldPosition(object,world);
}

function toggleSinTowerSelectedPropFollow(){
  const portal=getSinTowerSelectedPlayPortal(),model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp();
  const object=portal||model||prop,type=portal?'portal':model?'model':'prop';
  if(!object) return;
  if(sinTowerPlayObjectUi.followPropId===object.id&&sinTowerPlayObjectUi.followObjectType===type){
    sinTowerPlayObjectUi.followPropId=null;sinTowerPlayObjectUi.followObjectType=null;
    if(type==='portal'){sinTowerPlayObjectUi.portalPlacementGraceId=object.id;sinTowerPlayObjectUi.portalPlacementGraceUntil=performance.now()+SIN_TOWER_PORTAL_PLACEMENT_GRACE_MS;}
    scheduleSinTowerRuntimeSave();setStatus('已固定物件：'+object.title+(type==='portal'?'；1 秒後恢復傳送功能。':''));
  }else{
    sinTowerModelCarry.active=false;sinTowerModelCarry.id=null;
    if(prop){
      const needsSingleVisual=prop.repeatOnStairs;
      prop.repeatOnStairs=false;prop.followStairs=false;
      if(needsSingleVisual) rebuildSinTowerEditorRuntime();
    }
    sinTowerPlayObjectUi.followPropId=object.id;sinTowerPlayObjectUi.followObjectType=type;
    suspendSinTowerInteractionsForPlacement();
    if(type==='portal'){sinTowerPlayObjectUi.portalPlacementGraceId=null;sinTowerPlayObjectUi.portalPlacementGraceUntil=0;}
    updateSinTowerFollowedProp();
    setStatus((portal?'傳送門':model?'3D 模型':'物件')+'正在角色前方跟隨，互動暫停；按 Enter 或再次按按鈕固定後恢復。');
  }
  syncSinTowerPlayPropActions();
}

function syncSinTowerSelectedPropRuntime(prop){
  const rec=sinTowerEditorRuntime.props.get(prop?.id);if(!rec)return false;
  rec.prop=prop;updateSinTowerEditorPropRecord(rec,performance.now()*.001);
  for(const visual of rec.visuals||[]){visual.sprite?.updateMatrix?.();visual.glow?.updateMatrix?.();visual.particles?.updateMatrix?.();}
  rec.root.updateMatrixWorld(true);return true;
}

function resizeSinTowerSelectedProp(value){
  const portal=getSinTowerSelectedPlayPortal(),model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp();
  if(portal){
    const scale=clamp(safeFinite(value,portal.uniformScale),.2,240),aspect=clamp(safeFinite(portal.width,1.8)/Math.max(.001,safeFinite(portal.height,2.6)),.1,10);
    portal.uniformScale=scale;portal.height=2.6*scale;portal.width=portal.height*aspect;
    applySinTowerEditorPortalTransform(sinTowerEditorRuntime.portals.get(portal.id));scheduleSinTowerRuntimeSave();
    if($('sinSelectedPropScaleValue')) $('sinSelectedPropScaleValue').textContent=scale.toFixed(2);return true;
  }
  if(model){
    const scale=clamp(safeFinite(value,model.scale?.x||1),.01,400);
    model.scale={x:scale,y:scale,z:scale};
    const rec=sinTowerEditorRuntime.models.get(model.id);if(rec){rec.model=model;applySinTowerEditorModelTransform(rec);}
    scheduleSinTowerRuntimeSave();if($('sinSelectedPropScaleValue'))$('sinSelectedPropScaleValue').textContent=scale.toFixed(2);return true;
  }
  if(!prop) return false;
  prop.height=clamp(safeFinite(value,prop.height),.1,600);syncSinTowerSelectedPropRuntime(prop);scheduleSinTowerRuntimeSave();
  if($('sinSelectedPropScaleValue')) $('sinSelectedPropScaleValue').textContent=prop.height.toFixed(2);return true;
}

function rotateSinTowerSelectedProp(){
  const portal=getSinTowerSelectedPlayPortal(),model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp();
  if(portal){portal.rotationY=(Math.round(safeFinite(portal.rotationY,0)/15)*15+15)%360;applySinTowerEditorPortalTransform(sinTowerEditorRuntime.portals.get(portal.id));}
  else if(model){model.rotation=model.rotation||{x:0,y:0,z:0};model.rotation.y=(Math.round(safeFinite(model.rotation.y,0)/15)*15+15)%360;const rec=sinTowerEditorRuntime.models.get(model.id);if(rec){rec.model=model;applySinTowerEditorModelTransform(rec);}}
  else if(prop){prop.rotationZ=(Math.round(safeFinite(prop.rotationZ,0)/15)*15+15)%360;syncSinTowerSelectedPropRuntime(prop);}
  else return;
  scheduleSinTowerRuntimeSave();syncSinTowerPlayPropActions();
}

function renderSinTowerSelectedQuestions(){
  const object=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp(),list=$('sinSelectedQuestionList');
  if(!list)return;
  list.textContent='';
  const questions=Array.isArray(object?.interaction?.questions)?object.interaction.questions:[];
  questions.forEach((question,index)=>{
    const row=document.createElement('div');row.className='sin-question-edit-row';
    const text=document.createElement('textarea');text.value=String(question.text||'');text.maxLength=500;text.setAttribute('aria-label','問題 '+(index+1)+' 文字內容');
    text.oninput=()=>{question.text=String(text.value||'').slice(0,500);scheduleSinTowerRuntimeSave();};
    text.onchange=()=>{question.text=String(text.value||'').trim().slice(0,500);text.value=question.text;scheduleSinTowerRuntimeSave();};
    const remove=document.createElement('button');remove.type='button';remove.textContent='×';remove.title='刪除問題';
    remove.onclick=()=>{object.interaction.questions.splice(index,1);scheduleSinTowerRuntimeSave();renderSinTowerSelectedQuestions();};
    row.append(text,remove);list.append(row);
  });
  if(!questions.length){const empty=document.createElement('span');empty.textContent='尚未新增問題。';list.append(empty);}
}

function addSinTowerSelectedQuestion(){
  const object=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp(),draft=$('sinSelectedQuestionDraft');
  const text=String(draft?.value||'').trim();
  if(!object?.interaction?.enabled||!text){setStatus('請先輸入要新增的問題。');return false;}
  object.interaction.type='question';object.interaction.consumed=false;object.interaction.questions=Array.isArray(object.interaction.questions)?object.interaction.questions:[];
  object.interaction.questions.push({id:uid('question'),text:text.slice(0,500)});
  object.interaction.questions=object.interaction.questions.slice(0,24);if(draft)draft.value='';
  scheduleSinTowerRuntimeSave();syncSinTowerPlayPropActions();renderSinTowerSelectedQuestions();setStatus('已新增問答題目。');return true;
}

function previewSinTowerSelectedInteraction(){
  const model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp(),object=model||prop;
  const rec=model?sinTowerEditorRuntime.models.get(model.id):sinTowerEditorRuntime.props.get(prop?.id);
  if(!object?.interaction?.enabled||!rec)return false;
  if(object.interaction.type==='question'&&!object.interaction.questions?.length){setStatus('請先新增至少一個問題。');return false;}
  if(sinTowerPlayObjectUi.activePropId)finalizeSinTowerInteractionClose(false,false);
  const position=model?rec.group.getWorldPosition(new THREE.Vector3()):(nearestSinTowerPropVisual(rec)?.position||player.position.clone());
  openSinTowerInteraction(rec,{distance:0,position});if(sinTowerPlayObjectUi.resultSession)sinTowerPlayObjectUi.resultSession.preview=true;return true;
}

function updateSinTowerSelectedInteractionStyle(){
  const model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp(),object=model||prop;
  if(!object?.interaction?.enabled) return false;
  object.interaction.infectionEffect=sanitizeSinTowerInfectionEffect({enabled:$('sinSelectedInfectionEnabled')?.checked,direction:$('sinSelectedInfectionDirection')?.value,layers:$('sinSelectedInfectionLayers')?.value});
  const oldType=object.interaction.type;
  const requestedType=$('sinSelectedInteractionType')?.value||oldType||'text';
  object.interaction.type=['text','media','question','rps'].includes(requestedType)?requestedType:'text';
  object.interaction.glowEnabled=$('sinSelectedInteractionGlow')?.checked!==false;
  object.interaction.radius=clamp(safeFinite($('sinSelectedInteractionRadius')?.value,object.interaction.radius||3.2),.8,30);
  if($('sinSelectedInteractionRadiusValue'))$('sinSelectedInteractionRadiusValue').textContent=object.interaction.radius.toFixed(1);
  object.interaction.particleCount=clamp(Math.round(safeFinite($('sinSelectedInteractionParticles')?.value,840)),120,2400);
  if($('sinSelectedInteractionParticlesValue'))$('sinSelectedInteractionParticlesValue').textContent=String(object.interaction.particleCount);
  if($('sinSelectedInteractionParticles'))$('sinSelectedInteractionParticles').disabled=!object.interaction.glowEnabled;
  let particleAxes={x:!!$('sinSelectedParticleAxisX')?.checked,y:!!$('sinSelectedParticleAxisY')?.checked,z:!!$('sinSelectedParticleAxisZ')?.checked};
  if(!particleAxes.x&&!particleAxes.y&&!particleAxes.z){particleAxes.y=true;if($('sinSelectedParticleAxisY'))$('sinSelectedParticleAxisY').checked=true;}
  object.interaction.particleAxes=particleAxes;
  for(const id of ['sinSelectedParticleAxisX','sinSelectedParticleAxisY','sinSelectedParticleAxisZ'])if($(id))$(id).disabled=!object.interaction.glowEnabled;
  if(object.interaction.type==='text'||object.interaction.type==='question'){
    object.interaction.cornerRadius=clamp(safeFinite($('sinSelectedDocRadius')?.value,6),0,32);
    if($('sinSelectedDocRadiusValue'))$('sinSelectedDocRadiusValue').textContent=Math.round(object.interaction.cornerRadius)+'px';
  }
  if(object.interaction.type==='text'){
    object.interaction.title=String($('sinSelectedInteractionTitle')?.value||object.title||'').slice(0,100);
    object.interaction.text=String($('sinSelectedInteractionText')?.value||'').slice(0,30000);
    object.interaction.fontFamily=String($('sinSelectedInteractionFont')?.value||'serif');
    object.interaction.titleSize=clamp(safeFinite($('sinSelectedInteractionTitleSize')?.value,38),1,72);
    object.interaction.bodySize=clamp(safeFinite($('sinSelectedInteractionBodySize')?.value,18),1,42);
    object.interaction.backgroundOpacity=clamp(safeFinite($('sinSelectedDocOpacity')?.value,85)/100,.05,1);
    object.interaction.vhsIntensity=clamp(safeFinite($('sinSelectedVhsIntensity')?.value,1),0,2);
    object.interaction.vhsScanDensity=clamp(safeFinite($('sinSelectedVhsScan')?.value,6),1,12);
    object.interaction.vhsOffset=clamp(safeFinite($('sinSelectedVhsOffset')?.value,10),0,24);
    object.interaction.vhsSpeed=clamp(safeFinite($('sinSelectedVhsSpeed')?.value,5),0,20);
    object.interaction.vhsNoise=clamp(safeFinite($('sinSelectedVhsNoise')?.value,.24),0,1);
    if($('sinSelectedDocOpacityValue'))$('sinSelectedDocOpacityValue').textContent=Math.round(object.interaction.backgroundOpacity*100)+'%';
    for(const [id,key,digits] of [['sinSelectedVhsIntensity','vhsIntensity',2],['sinSelectedVhsScan','vhsScanDensity',2],['sinSelectedVhsOffset','vhsOffset',1],['sinSelectedVhsSpeed','vhsSpeed',2],['sinSelectedVhsNoise','vhsNoise',2]])if($(id+'Value'))$(id+'Value').textContent=object.interaction[key].toFixed(digits);
    if(sinTowerPlayObjectUi.activePropId===object.id){applySinTowerInteractionStyle(object.interaction);if($('sinInteractionTitle'))$('sinInteractionTitle').textContent=object.interaction.title;if($('sinInteractionScroll'))$('sinInteractionScroll').textContent=object.interaction.text||'……';}
  }
  if(object.interaction.type==='question'){
    object.interaction.backgroundOpacity=clamp(safeFinite($('sinSelectedDocOpacity')?.value,85)/100,.05,1);
    object.interaction.vhsIntensity=clamp(safeFinite($('sinSelectedVhsIntensity')?.value,1),0,2);
    object.interaction.vhsScanDensity=clamp(safeFinite($('sinSelectedVhsScan')?.value,6),1,12);
    object.interaction.vhsOffset=clamp(safeFinite($('sinSelectedVhsOffset')?.value,10),0,24);
    object.interaction.vhsSpeed=clamp(safeFinite($('sinSelectedVhsSpeed')?.value,5),0,20);
    object.interaction.vhsNoise=clamp(safeFinite($('sinSelectedVhsNoise')?.value,.24),0,1);
    object.interaction.questionTypewriterCps=clamp(safeFinite($('sinSelectedQuestionSpeed')?.value,22),5,80);
    object.interaction.questionTextSize=clamp(safeFinite($('sinSelectedQuestionTextSize')?.value,23),1,48);
    object.interaction.questionTextOpacity=clamp(safeFinite($('sinSelectedQuestionTextOpacity')?.value,100)/100,.1,1);
    object.interaction.dissolveParticleCount=clamp(Math.round(safeFinite($('sinSelectedDissolveParticles')?.value,4200)),400,12000);
    object.interaction.dissolveDensity=clamp(safeFinite($('sinSelectedDissolveDensity')?.value,1.6),.25,4);
    if($('sinSelectedDissolveParticlesValue'))$('sinSelectedDissolveParticlesValue').textContent=String(object.interaction.dissolveParticleCount);
    if($('sinSelectedDissolveDensityValue'))$('sinSelectedDissolveDensityValue').textContent=object.interaction.dissolveDensity.toFixed(2);
    if($('sinSelectedQuestionSpeedValue'))$('sinSelectedQuestionSpeedValue').textContent=Math.round(object.interaction.questionTypewriterCps)+' 字／秒';
    if($('sinSelectedQuestionTextSizeValue'))$('sinSelectedQuestionTextSizeValue').textContent=Math.round(object.interaction.questionTextSize)+'px';
    if($('sinSelectedQuestionTextOpacityValue'))$('sinSelectedQuestionTextOpacityValue').textContent=Math.round(object.interaction.questionTextOpacity*100)+'%';
    renderSinTowerSelectedQuestions();
  }
  if((object.interaction.type==='text'||object.interaction.type==='question')&&sinTowerPlayObjectUi.activePropId===object.id)applySinTowerInteractionStyle(object.interaction);
  if(oldType!==object.interaction.type&&sinTowerPlayObjectUi.activePropId===object.id){finalizeSinTowerInteractionClose(false,false);setTimeout(previewSinTowerSelectedInteraction,0);}
  if(model){const rec=sinTowerEditorRuntime.models.get(model.id);if(rec){rec.model=model;syncSinTowerModelInteractiveFx(rec);}}
  if(prop){const rec=sinTowerEditorRuntime.props.get(prop.id);if(rec){rec.prop=prop;for(const visual of rec.visuals||[])setSinTowerPropVisualGlowEnabled(visual,prop,object.interaction.glowEnabled);}}
  scheduleSinTowerRuntimeSave();syncSinTowerPlayPropActions();return true;
}

function updateSinTowerSelectedDrift(){
  const model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp(),object=model||prop;
  if(!object) return false;
  object.driftEnabled=!!$('sinSelectedDriftEnabled')?.checked;
  let axes={x:!!$('sinSelectedDriftX')?.checked,y:!!$('sinSelectedDriftY')?.checked,z:!!$('sinSelectedDriftZ')?.checked};
  if(object.driftEnabled&&!axes.x&&!axes.y&&!axes.z){axes.x=true;if($('sinSelectedDriftX'))$('sinSelectedDriftX').checked=true;}
  object.driftAxes=axes;
  object.driftDistance=clamp(safeFinite($('sinSelectedDriftDistance')?.value,2),.05,20);
  object.driftSpeed=clamp(safeFinite($('sinSelectedDriftSpeed')?.value,.65),.05,5);
  object.driftIrregularity=clamp(safeFinite($('sinSelectedDriftIrregularity')?.value,.45),0,1);
  if(!Number.isFinite(object.driftSeed)) object.driftSeed=Math.random()*100000;
  if(model){const rec=sinTowerEditorRuntime.models.get(model.id);if(rec)rec.model=model;}
  if(prop){const rec=sinTowerEditorRuntime.props.get(prop.id);if(rec)rec.prop=prop;refreshSinTowerPlayPropBasePositions(prop);}
  scheduleSinTowerRuntimeSave();syncSinTowerPlayPropActions();return true;
}

function updateSinTowerSelectedPortalSecurity(commit=true){
  const portal=getSinTowerSelectedPlayPortal();if(!portal)return false;
  const input=$('sinSelectedPortalPassword'),enabled=!!$('sinSelectedPortalPasswordEnabled')?.checked;
  const cleaned=String(input?.value||'').toUpperCase().replace(/[^0-9A-F]/g,'').slice(0,4);
  portal.passwordEnabled=enabled;
  portal.password=sanitizeSinTowerPortalPassword(cleaned);
  if(input){input.disabled=!enabled;if(commit)input.value=portal.password;}
  scheduleSinTowerRuntimeSave();
  setStatus(enabled?'傳送門密碼已啟用：'+portal.password:'傳送門密碼已停用。');
  return true;
}

function updateSinTowerSelectedPortalRoute(){
  const portal=getSinTowerSelectedPlayPortal();if(!portal)return false;
  const oldSource=portal.sceneId;
  const sourceId=$('sinSelectedPortalSource')?.value||oldSource;
  let targetId=$('sinSelectedPortalTarget')?.value||portal.targetSceneId;
  if(targetId===sourceId&&SIN_TOWER_EDITOR.scenes.length>1) targetId=SIN_TOWER_EDITOR.scenes.find(sceneState=>sceneState.id!==sourceId)?.id||targetId;
  portal.sceneId=sourceId;portal.targetSceneId=targetId;
  if(sourceId!==oldSource){
    const sourceScene=getSinTowerSceneById(sourceId),base=sourceId===SIN_TOWER_EDITOR.activeSceneId?player.position:sourceScene?.spawn;
    const world=new THREE.Vector3(safeFinite(base?.x,0),safeFinite(base?.y,0)+1.3,safeFinite(base?.z,0));
    const placement=sinTowerPropPlacementFromWorld(world,sourceScene?.type==='stairs',sourceScene);
    portal.step=placement.step;portal.offset=placement.offset;
  }
  scheduleSinTowerRuntimeSave();rebuildSinTowerEditorRuntime();syncSinTowerPlayPropActions();
  setStatus('傳送路線已更新：'+(getSinTowerSceneById(sourceId)?.title||sourceId)+' → '+(getSinTowerSceneById(targetId)?.title||targetId));return true;
}

function moveSinTowerSelectedPropVertical(delta){
  const playModel=getSinTowerSelectedPlayModel();
  const model=playModel||(!sinTowerPlayObjectUi.selectedPlayType?selectedSinTowerEditorModel():null);
  if(model&&model.sceneId===SIN_TOWER_EDITOR.activeSceneId){
    model.position=model.position||{x:0,y:0,z:0};model.position.y=safeFinite(model.position.y,0)+delta;
    const rec=sinTowerEditorRuntime.models.get(model.id);if(rec){rec.model=model;applySinTowerEditorModelTransform(rec);}
    scheduleSinTowerRuntimeSave();
    if(playModel) syncSinTowerPlayPropActions();else syncSinProFields();
    setStatus(model.title+(delta>0?' 向上 ':' 向下 ')+Math.abs(delta).toFixed(2)+'；此位置已設為新基準。');return true;
  }
  const portal=getSinTowerSelectedPlayPortal();
  if(portal){portal.offset=portal.offset||{x:0,y:0,z:0};portal.offset.y=safeFinite(portal.offset.y,0)+delta;applySinTowerEditorPortalTransform(sinTowerEditorRuntime.portals.get(portal.id));scheduleSinTowerRuntimeSave();syncSinTowerPlayPropActions();setStatus(portal.title+(delta>0?' 向上 ':' 向下 ')+Math.abs(delta).toFixed(2));return true;}
  const prop=getSinTowerSelectedPlayProp();
  if(!prop){setStatus('請先按右鍵顯示游標，再點選要上下移動的新增物件。');return false;}
  prop.offset=prop.offset||{x:0,y:0,z:0};prop.position=prop.position||{x:0,y:0,z:0};
  prop.offset.y=safeFinite(prop.offset.y,0)+delta;prop.position.y=safeFinite(prop.position.y,0)+delta;
  refreshSinTowerPlayPropBasePositions(prop);scheduleSinTowerRuntimeSave();syncSinTowerPlayPropActions();
  setStatus(prop.title+(delta>0?' 向上 ':' 向下 ')+Math.abs(delta).toFixed(2)+'；此位置已設為新基準。');return true;
}

function deleteSinTowerSelectedPlayProp(){
  const portal=getSinTowerSelectedPlayPortal(),model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp(),object=portal||model||prop;
  if(!object) return false;
  if(sinTowerPlayObjectUi.activePropId===object.id) closeSinTowerInteraction(false,false,true);
  if(portal) SIN_TOWER_EDITOR.portals=SIN_TOWER_EDITOR.portals.filter(item=>item.id!==object.id);
  else if(model) SIN_TOWER_EDITOR.models=SIN_TOWER_EDITOR.models.filter(item=>item.id!==object.id);
  else SIN_TOWER_EDITOR.props=SIN_TOWER_EDITOR.props.filter(item=>item.id!==object.id);
  if(sinTowerPlayObjectUi.followPropId===object.id){sinTowerPlayObjectUi.followPropId=null;sinTowerPlayObjectUi.followObjectType=null;}
  closeSinTowerPlayPropActions(true);rebuildSinTowerEditorRuntime();scheduleSinTowerRuntimeSave();syncSinProEditor?.();
  setStatus('已刪除'+(portal?'傳送門':model?' 3D 模型':'新增物件')+'：'+object.title);return true;
}

let lastSinTowerRightClickCursorAt = -Infinity;
let sinTowerLastModelPick = null;
function showSinTowerObjectCursorFromRightClick(){
  if(EXPORTED_GALLERY_VIEWER) return;
  if(sinTowerPlayObjectUi.activePropId) closeSinTowerInteraction(false,false,true);
  if(!sinTowerPlayObjectUi.cursorEditMode){
    sinTowerPlayObjectUi.cursorEditPreviousAutoRun = !!SIN_TOWER_STAIRCASE.autoRun;
  }
  sinTowerPlayObjectUi.cursorEditMode = true;
  SIN_TOWER_STAIRCASE.autoRun = false;
  playAction('idle');
  showCursorByEsc();
  document.body.classList.add('play-mode');
  setStatus('物件游標已顯示：點選 PNG、GIF、影片、3D 模型或魔法傳送門，可移動、旋轉、縮放或刪除。');
}

function handleSinTowerRightClickCursor(e){
  if(SIN_TOWER_PUBLISHED || EXPORTED_GALLERY_VIEWER || e?.button !== 2 || !isPlayMode() || isInsideEditUi(e.target) || isInsideMobileControls(e.target)) return false;
  e.preventDefault?.();
  e.stopPropagation?.();
  e.stopImmediatePropagation?.();
  const now = performance.now();
  if(now - lastSinTowerRightClickCursorAt > 80){
    lastSinTowerRightClickCursorAt = now;
    showSinTowerObjectCursorFromRightClick();
  }
  return true;
}

function finishSinTowerObjectCursorMode(){
  if(!sinTowerPlayObjectUi.cursorEditMode) return;
  sinTowerPlayObjectUi.cursorEditMode = false;
  sinTowerPlayObjectUi.followPropId = null;
  sinTowerPlayObjectUi.followObjectType = null;
  closeSinTowerPlayPropActions(true);
  SIN_TOWER_STAIRCASE.autoRun = !!sinTowerPlayObjectUi.cursorEditPreviousAutoRun;
}

function openSinTowerStairJump(){
  if(EXPORTED_GALLERY_VIEWER||sinTowerPlayObjectUi.stairJumpOpen||!isPlayMode()||!isSinTowerStairSceneActive()||sinTowerPlayObjectUi.panelOpen||sinTowerPlayObjectUi.activePropId)return false;
  sinTowerPlayObjectUi.stairJumpOpen=true;sinTowerPlayObjectUi.stairJumpPreviousAutoRun=!!SIN_TOWER_STAIRCASE.autoRun;sinTowerPlayObjectUi.stairJumpPreviousCursorEdit=!!sinTowerPlayObjectUi.cursorEditMode;SIN_TOWER_STAIRCASE.autoRun=false;playAction('idle');
  const current=getSinTowerCurrentStepIndex()+1,total=getSinTowerTotalStepCount(),max=total||SIN_TOWER_STAIRCASE.virtualCount||1000000,input=$('sinStairJumpInput'),totalInput=$('sinStairTotalInput');
  if(input){input.max=String(max);input.value=String(Math.min(current,max));}
  if(totalInput)totalInput.value=String(total||0);
  if($('sinStairJumpHint'))$('sinStairJumpHint').textContent='目前第 '+current.toLocaleString()+' 階；總階梯數 '+(total?total.toLocaleString():'無限（輸入 0）')+'。跟隨物件會一起跳轉。';
  $('sinStairJumpOverlay')?.classList.add('open');$('sinStairJumpOverlay')?.setAttribute('aria-hidden','false');document.body.classList.add('play-mode','sin-stair-jump-open');setSinTowerModalCursorFree();
  setTimeout(()=>{input?.focus();input?.select();},0);return true;
}

function closeSinTowerStairJump(restore=true,requestLock=false){
  if(!sinTowerPlayObjectUi.stairJumpOpen)return;
  const overlay=$('sinStairJumpOverlay');if(overlay?.contains(document.activeElement))document.activeElement?.blur?.();
  sinTowerPlayObjectUi.stairJumpOpen=false;overlay?.classList.remove('open');overlay?.setAttribute('aria-hidden','true');document.body.classList.remove('sin-stair-jump-open');
  SIN_TOWER_STAIRCASE.autoRun=!!sinTowerPlayObjectUi.stairJumpPreviousAutoRun&&!sinTowerRunFinished;
  const resumeCursorEdit=!!sinTowerPlayObjectUi.stairJumpPreviousCursorEdit;sinTowerPlayObjectUi.stairJumpPreviousCursorEdit=false;
  if(restore){if(resumeCursorEdit){sinTowerPlayObjectUi.cursorEditMode=true;setSinTowerModalCursorFree();syncSinTowerPlayPropActions();}else restoreSinTowerPlayLook(requestLock);}
}

function jumpSinTowerToRequestedStep(){
  if(!sinTowerPlayObjectUi.stairJumpOpen||!isSinTowerStairSceneActive())return false;
  const total=setSinTowerTotalStepCount($('sinStairTotalInput')?.value),max=total||SIN_TOWER_STAIRCASE.virtualCount||1000000;
  const humanStep=clamp(Math.round(safeFinite($('sinStairJumpInput')?.value,1)),1,max),index=humanStep-1,c=SIN_TOWER_STAIRCASE;
  const x=clamp(player.position.x,c.startX-c.width*.45,c.startX+c.width*.45),target=sinTowerWorldPositionFromStep(index,{x:x-c.startX,y:0,z:0});
  player.position.copy(target);playerVelocityY=0;playerGroup?.position.copy(player.position);sinTowerRunFinished=false;enforceSinTowerStairTravelBounds();
  updateSinTowerVisibleStairs(true);refreshInfiniteSinTowerMonkWindow();updateSinTowerMonks(0);
  updateSinTowerFollowedProp();updateSinTowerModelCarry();updateSinTowerCarriedStone();updateSinTowerEditorRuntime(0);updateCamera();
  sinTowerPlayObjectUi.stairJumpPreviousAutoRun=false;playAction('idle');
  scheduleSinTowerRuntimeSave();closeSinTowerStairJump(true,true);setStatus('已跳轉至第 '+humanStep.toLocaleString()+' 階；總長 '+(total?total.toLocaleString()+' 階':'無限')+'；已暫停自動前進，跟隨物件已同步移動。');return true;
}

function openSinTowerShortcutHelp(){
  if(sinTowerPlayObjectUi.shortcutOpen) return;
  sinTowerPlayObjectUi.shortcutOpen = true;
  sinTowerPlayObjectUi.shortcutPreviousAutoRun = !!SIN_TOWER_STAIRCASE.autoRun;
  SIN_TOWER_STAIRCASE.autoRun = false;
  $('sinShortcutOverlay')?.classList.add('open');
  $('sinShortcutOverlay')?.setAttribute('aria-hidden','false');
  document.body.classList.add('play-mode','sin-shortcuts-open');
  setSinTowerModalCursorFree();
}

function closeSinTowerShortcutHelp(restore=true,requestLock=false){
  if(!sinTowerPlayObjectUi.shortcutOpen) return;
  sinTowerPlayObjectUi.shortcutOpen = false;
  $('sinShortcutOverlay')?.classList.remove('open');
  $('sinShortcutOverlay')?.setAttribute('aria-hidden','true');
  document.body.classList.remove('sin-shortcuts-open');
  SIN_TOWER_STAIRCASE.autoRun = !!sinTowerPlayObjectUi.shortcutPreviousAutoRun;
  if(restore) restoreSinTowerPlayLook(requestLock);
}

function bindInput(){
  updateCursorVisibility();
  bindSinTowerPlayObjectUi();
  bindWaterControls();
  if($('sinStairJumpCancel'))$('sinStairJumpCancel').onclick=()=>closeSinTowerStairJump(true,true);
  if($('sinStairJumpGo'))$('sinStairJumpGo').onclick=jumpSinTowerToRequestedStep;
  for(const id of ['sinStairJumpInput','sinStairTotalInput'])if($(id))$(id).onkeydown=event=>{if(event.code==='Enter'){event.preventDefault();event.stopPropagation();jumpSinTowerToRequestedStep();}else if(event.code==='Escape'){event.preventDefault();event.stopPropagation();closeSinTowerStairJump(true,true);}};
  setupMobileControls();

  document.body.addEventListener('click', e=>{
    if(EXPORTED_GALLERY_VIEWER) return;
    if(isInsideEditUi(e.target) || isInsideMobileControls(e.target)) return;
    if(transformControls?.dragging || wallScaleMode || artworkScaleMode) return;
    if(cursorFreeMode || pointerLocked) return;
    desiredPointerLocked = true;
    requestStablePointerLock();
  });
  document.addEventListener('pointerlockchange', ()=>{
    pointerLocked = hasActivePointerLock();
    if(pointerLocked){
      desiredPointerLocked = true;
      cursorFreeMode = false;
      fallbackMouseLook = false;
      resetFallbackLookAnchor();
      clearSelectableSelection();
    }else{
      lastPointerUnlockAt = performance.now();
      if(desiredPointerLocked && !cursorFreeMode){
        // A delayed unlock event can arrive after the editor's Play button
        // has already restored play mode. Keep the play look state active;
        // otherwise cursorFreeMode becomes true and the fallback mouse-look
        // handler intentionally ignores every horizontal movement.
        if(document.body.classList.contains('play-mode') && !sinTowerStonePickMode.active) cursorFreeMode = false;
        // Keep mouse-look alive while Pointer Lock is pending or unavailable.
        // Otherwise play mode remains active but the mousemove handler returns
        // before updating the camera.
        fallbackMouseLook = !IS_TOUCH_DEVICE;
      }else{
        desiredPointerLocked = false;
        cursorFreeMode = true;
        fallbackMouseLook = false;
      }
    }
    updateCursorVisibility();
  });
  document.addEventListener('pointerlockerror', ()=>{
    pointerLocked = false;
    if(desiredPointerLocked && !cursorFreeMode){
      // Pointer Lock failure must fall back to ordinary mouse movement rather
      // than leave a play-mode state that ignores mousemove entirely.
      fallbackMouseLook = !IS_TOUCH_DEVICE;
      updateCursorVisibility();
      setStatus('已進入遊玩模式。Pointer Lock 尚未鎖定；點擊畫面會重新嘗試鎖定視角。');
      return;
    }
    desiredPointerLocked = false;
    cursorFreeMode = true;
    updateCursorVisibility();
    setStatus('Pointer Lock 未啟用；請再次點擊畫面或按 ESC 重新切換游標。');
  });
  window.addEventListener('blur', ()=>{
    desiredPointerLocked = false;
    cursorFreeMode = true;
    fallbackMouseLook = false;
    resetFallbackLookAnchor();
    ctrlViewDrag = false;
    ctrlViewDragLastX = 0;
    ctrlViewDragLastY = 0;
    updateCursorVisibility();
  });
  $('canvas').addEventListener('pointerdown', e=>{
    if(isInsideEditUi(e.target) || isInsideMobileControls(e.target)) return;
    if(consumePlayModePointerEvent(e)) return;
    if(sinTowerStonePickMode.active){
      if(pickSinTowerStoneFromPointer(e)){
        e.preventDefault();
        e.stopPropagation();
      }
      return;
    }
    if(startMiddleViewDrag(e)) return;
    if(!pointerLocked && !fallbackMouseLook){
      if(pickSinTowerPlayPropFromPointer(e)){
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      if(pickSinTowerPlayPortalFromPointer(e)){
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      if(selectSinTowerEditorModelFromPointer(e)){
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      if(transformControls?.enabled && transformControls?.visible) return;
      if(sandPileEnabled()){
        if(startSandPilePointer(e)){
          e.preventDefault();
          e.stopPropagation();
        }
        return;
      }
      if(chiselEnabled()){
        if(chiselFromPointer(e, false)){
          e.preventDefault();
          e.stopPropagation();
          updateChiselPreview(e);
        }
        return;
      }
      if(pickSelectableFromPointer(e)){
        e.preventDefault();
        e.stopPropagation();
      }
      return;
    }
    if(e.shiftKey){
      if(pickSelectableFromPointer(e)){
        e.preventDefault();
        e.stopPropagation();
      }
      return;
    }
    if(pendingWallId && pickWallFromPointer(e)) return;
    pickArtworkFromPointer(e);
  });
  document.addEventListener('pointerdown', e=>{
    if(!isMiddleButtonEvent(e)) return;
    if(isInsideEditUi(e.target) || isInsideMobileControls(e.target)) return;
    e.preventDefault();
    e.stopPropagation();
    startMiddleViewDrag(e);
  }, true);
  document.addEventListener('mousedown', e=>{
    if(!isMiddleButtonEvent(e)) return;
    if(isInsideEditUi(e.target) || isInsideMobileControls(e.target)) return;
    e.preventDefault();
    e.stopPropagation();
    startMiddleViewDrag(e);
  }, true);
  $('canvas').addEventListener('auxclick', e=>{
    if(e.button === 1){ e.preventDefault(); e.stopPropagation(); }
  });
  document.addEventListener('pointerdown', handleSinTowerRightClickCursor, true);
  document.addEventListener('mousedown', handleSinTowerRightClickCursor, true);
  document.addEventListener('contextmenu', e=>{
    if(handleSinTowerRightClickCursor(e)) return;
    if(e.target === renderer?.domElement) e.preventDefault();
  }, true);
  document.addEventListener('pointermove', e=>{
    if(isTextEditingEventTarget(e)) return;
    if(updateSandPileHandleModeFromPointer(e)){ e.preventDefault(); e.stopPropagation(); return; }
    if(applyMiddleViewDragMove(e)) return;
    if(isPlayCursorDisabled()){
      hideChiselPreview();
      return;
    }
    if(!isInsideEditUi(e.target) && !isInsideMobileControls(e.target)){
      lastChiselPointer = {clientX:e.clientX, clientY:e.clientY};
      if(updateSandPilePointerDrag(e)){ e.preventDefault(); e.stopPropagation(); return; }
      if(sandPileEnabled()) updateSandPilePreview(e);
      if(chiselEnabled()) updateChiselPreview(e);
    }
  }, true);
  window.addEventListener('pointercancel', e=>{ cancelSandPilePointer(e); stopMiddleViewDrag(e); }, true);
  window.addEventListener('pointerup', e=>{ if(finishSandPilePointer(e)){ e.preventDefault(); e.stopPropagation(); } }, true);
  document.addEventListener('mousemove', e=>{
    if(Number.isFinite(e.clientX)) fallbackPointerX = e.clientX;
    if(Number.isFinite(e.clientY)) fallbackPointerY = e.clientY;
    if(isTextEditingEventTarget(e)) return;
    if(!ctrlViewDrag && !pointerLocked && !fallbackMouseLook && isMiddleButtonEvent(e) && !isInsideEditUi(e.target)){
      startMiddleViewDrag(e);
    }
    if(applyMiddleViewDragMove(e)) return;
    if(multiObjectScaleMode){ resizeMultiSelectedObjectsByMouse(e); return; }
    if(artworkScaleMode){ resizeSelectedArtworkByMouse(e); return; }
    if(wallScaleMode){ resizeSelectedWallByMouse(e); return; }
    if((!pointerLocked && !fallbackMouseLook) || transformControls?.dragging) return;
    if(fallbackMouseLook && cursorFreeMode) return;
    if(fallbackMouseLook && !pointerLocked){
      updateFallbackLookAxis(e);
      return;
    }
    applyCameraLookDelta(e.movementX, e.movementY);
    // movementY 往上為負值；這裡轉成鏡頭 pitch，而不是平移鏡頭高度。
  }, true);
  window.addEventListener('wheel', e=>{
    if(sinTowerPlayObjectUi.activePropId){
      e.preventDefault();
      e.stopPropagation();
      const scroll = $('sinInteractionScroll');
      if(scroll && scroll.style.display !== 'none') scroll.scrollTop += e.deltaY;
      return;
    }
    if(isTextEditingEventTarget(e)) return;
    if(isInsideEditUi(e.target) || isInsideMobileControls(e.target)) return;
    e.preventDefault();
    zoomCamera(e.deltaY);
  }, {passive:false});
  window.addEventListener('keydown', e=>{
    if(handleSinAfterVideoKey(e))return;
    if(handleSinTowerRpsKey(e))return;
    if(handleSinTowerHideCursorShortcut(e))return;
    if(handleSinTowerMobileControlsShortcut(e))return;
    if(handleSinTowerPortalPasswordKey(e)) return;
    if(EXPORTED_GALLERY_VIEWER){
      handleExportedViewerKeyDown(e);
      return;
    }
    if(e.shiftKey && !e.ctrlKey && !e.altKey && !e.metaKey && e.code === 'KeyH' && !isTextEditingElement(document.activeElement)){
      e.preventDefault(); e.stopPropagation();
      if(sinTowerPlayObjectUi.shortcutOpen) closeSinTowerShortcutHelp(true,false); else openSinTowerShortcutHelp();
      return;
    }
    if(e.shiftKey&&!e.ctrlKey&&!e.altKey&&!e.metaKey&&e.code==='KeyQ'&&!isTextEditingElement(document.activeElement)&&isSinTowerStairSceneActive()&&isPlayMode()&&!sinTowerPlayObjectUi.panelOpen&&!sinTowerPlayObjectUi.activePropId){
      e.preventDefault();e.stopPropagation();openSinTowerStairJump();return;
    }
    if(sinTowerPlayObjectUi.stairJumpOpen){
      if(e.code==='Escape'){e.preventDefault();e.stopPropagation();closeSinTowerStairJump(true,true);}return;
    }
    if(sinTowerPlayObjectUi.shortcutOpen){
      if(e.code === 'Escape'){ e.preventDefault(); e.stopPropagation(); closeSinTowerShortcutHelp(true,false); }
      return;
    }
    if(sinTowerPlayObjectUi.activePropId&&$('sinQuestionOverlay')?.classList.contains('open')&&(e.code==='ArrowLeft'||e.code==='ArrowRight')){
      e.preventDefault();e.stopPropagation();
      if(!e.repeat)answerSinTowerQuestion(e.code==='ArrowRight'?'yes':'no');
      return;
    }
    if(e.code === 'Escape' && sinTowerPlayObjectUi.activePropId){
      e.preventDefault(); e.stopPropagation(); closeSinTowerInteraction(true,true); return;
    }
    if(e.code === 'Escape' && sinTowerPlayObjectUi.panelOpen){
      e.preventDefault(); e.stopPropagation(); closeSinTowerPlayAddPanel(true,true); return;
    }
    if(!sinTowerPlayObjectUi.panelOpen && !sinTowerPlayObjectUi.activePropId && !isTextEditingElement(document.activeElement) && (e.code === 'NumpadAdd' || (e.code === 'Equal' && e.shiftKey))){
      e.preventDefault(); e.stopPropagation(); openSinTowerPlayAddPanel(); return;
    }
    if(shouldBypassSceneShortcut(e)) return;
    if(e.ctrlKey && !e.altKey && !e.metaKey && (e.code === 'Digit9' || e.code === 'Numpad9' || e.code === 'Digit0' || e.code === 'Numpad0')){
      e.preventDefault();
      e.stopPropagation();
      moveSinTowerSelectedPropVertical((e.code === 'Digit9' || e.code === 'Numpad9') ? .1 : -.1);
      return;
    }
    if(e.ctrlKey && !e.altKey && !e.metaKey && e.code === 'KeyZ' && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      undoLastStep();
      return;
    }
    if(e.ctrlKey && !e.altKey && !e.metaKey && e.code === 'KeyG' && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      createObjectGroupFromMultiSelection();
      return;
    }
    if(e.code === 'KeyX' && sandPileEnabled() && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      sandPileAtPreviewOrView();
      return;
    }
    if(e.code === 'KeyX' && chiselEnabled() && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      chiselAtPreviewOrView();
      return;
    }
    if(e.code === 'KeyP' && !e.ctrlKey && !e.altKey && !e.metaKey && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      SIN_TOWER_STAIRCASE.autoRun = !SIN_TOWER_STAIRCASE.autoRun;
      if(!SIN_TOWER_STAIRCASE.autoRun) playAction('idle');
      setStatus(SIN_TOWER_STAIRCASE.autoRun ? '自動前進已恢復。按 P 可停止。' : '自動前進已停止。按 P 可恢復。');
      return;
    }
    if(e.shiftKey && !e.ctrlKey && !e.altKey && !e.metaKey && (e.code==='Digit0' || e.code==='Numpad0') && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      toggleSinTowerStonePickMode();
      return;
    }
    if(e.shiftKey && !e.ctrlKey && !e.altKey && !e.metaKey && (e.code==='Digit1' || e.code==='Numpad1') && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      debugIncreaseSinTowerInfectionByShortcut();
      return;
    }
    if(e.ctrlKey && !e.altKey && !e.metaKey && (e.code==='Digit1' || e.code==='Digit2' || e.code==='Digit3' || e.code==='Numpad1' || e.code==='Numpad2' || e.code==='Numpad3')){
      e.preventDefault();
      e.stopPropagation();
      if(e.code==='Digit1' || e.code==='Numpad1') setCameraViewPreset('top');
      if(e.code==='Digit2' || e.code==='Numpad2') setCameraViewPreset('angle45');
      if(e.code==='Digit3' || e.code==='Numpad3') setCameraViewPreset('level');
      return;
    }
    if(e.code==='KeyC' && e.shiftKey){ e.preventDefault(); toggleSinTowerEditorMode(); return; }
    if(e.code==='KeyA' && e.shiftKey){
      e.preventDefault();
      e.stopPropagation();
      if(sandPileEnabled() && getSelectedFloorPhysicsTarget?.()){ startSandPileHandleByShiftA(); return; }
      toggleScaleModeForSelection();
      return;
    }
    if(e.code==='KeyT' && e.shiftKey){ e.preventDefault(); activateWallRotationControls(); return; }
    if((e.code==='Enter' || e.code==='Escape') && sandPileHandleMode?.active){
      e.preventDefault();
      e.stopPropagation();
      if(e.code==='Enter') commitSandPileHandleMode(); else cancelSandPileHandleMode();
      return;
    }
    if((e.code==='Enter' || e.code==='Escape') && (wallScaleMode || artworkScaleMode || multiObjectScaleMode)){
      e.preventDefault();
      e.stopPropagation();
      stopScaleModesByKey(e.code);
      return;
    }
    if(e.code==='Enter' && sinTowerModelCarry.active){
      e.preventDefault();
      e.stopPropagation();
      toggleSinTowerModelCarry();
      return;
    }
    if(e.code==='Enter' && sinTowerPlayObjectUi.followPropId){
      e.preventDefault();
      e.stopPropagation();
      toggleSinTowerSelectedPropFollow();
      return;
    }
    if(e.code==='Enter' && sinTowerStoneCarry.active){
      e.preventDefault();
      e.stopPropagation();
      placeSinTowerCarriedStone();
      return;
    }
    if(e.code==='Enter'){
      if(pendingWallId || pendingArtworkId || pendingFloorTileId || pendingWaterBodyId){
        e.preventDefault();
        e.stopPropagation();
        if(confirmPendingPlacementPreservingWindows()) return;
      }
    }
    if(e.code==='Escape' && sinTowerStonePickMode.active){
      e.preventDefault();
      e.stopPropagation();
      setSinTowerStonePickMode(false);
      setStatus('已離開石頭選取模式，返回遊玩。');
      return;
    }
    if(e.code==='Escape'){
      e.preventDefault();
      e.stopPropagation();
      if(e.repeat) return;
      toggleCursorByEsc(e.type);
      return;
    }
    if(e.code==='Delete' || e.code==='Backspace'){
      if(e.defaultPrevented||e.isComposing||isTextEditingElement(e.target)||isTextEditingElement(document.activeElement)) return;
      if(deleteSinTowerSelectedPlayProp() || deleteSinTowerSelectedModel() || deleteSelectedArtwork() || deleteSelectedFloorTile() || deleteSelectedWaterBody() || deleteSelectedWall()){
        e.preventDefault();
        e.stopPropagation();
      }
      return;
    }
    if(e.code==='KeyW') keys.w = true;
    if(e.code==='KeyA') keys.a = true;
    if(e.code==='KeyS') keys.s = true;
    if(e.code==='KeyD') keys.d = true;
    if(e.code==='Space') jump();
    if(e.code==='KeyQ'){ addWallAhead(); }
    if(e.code==='KeyE'){ deleteWallAhead(); }
    if(e.code==='KeyR'){ resetPlayer(); }
  }, true);
  window.addEventListener('keyup', e=>{
    if(sinTowerPortalGate.active){clearMovementKeys();e.preventDefault();e.stopPropagation();return;}
    if(EXPORTED_GALLERY_VIEWER){
      handleExportedViewerKeyUp(e);
      return;
    }
    if(shouldBypassSceneShortcut(e)) return;
    if(e.code==='Escape' && pendingEscRelock){
      e.preventDefault();
      e.stopPropagation();
      pendingEscRelock = false;
      lockPointerAfterEscRelease();
      return;
    }
    if(e.code==='KeyW') keys.w = false;
    if(e.code==='KeyA') keys.a = false;
    if(e.code==='KeyS') keys.s = false;
    if(e.code==='KeyD') keys.d = false;
  }, true);
  window.addEventListener('pointerup', e=>{
    stopMiddleViewDrag(e);
  }, true);
  window.addEventListener('mouseup', e=>{
    if(!ctrlViewDrag) return;
    // 滾輪釋放時 e.button 仍可能是 1；不能因 isMiddleButtonEvent 而跳過清除。
    if(e.button === 1 || ((e.buttons || 0) & 4) === 0) stopMiddleViewDrag(e);
  }, true);
}


function hashUndoAssetString(str){
  let h = 2166136261;
  const step = Math.max(1, Math.floor(str.length / 4096));
  for(let i=0; i<str.length; i+=step){
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return `${str.length}_${(h >>> 0).toString(36)}`;
}

function encodeUndoValue(value){
  if(typeof value !== 'string' || value.length < UNDO_ASSET_THRESHOLD) return value;
  if(!((value.startsWith('data:image')||sinPublishedAssetMatches(value,"data:image")) || (value.startsWith('data:video')||sinPublishedAssetMatches(value,"data:video")) || (value.startsWith('data:application/octet-stream')||sinPublishedAssetMatches(value,"data:application/octet-stream")) || (value.startsWith('data:model')||sinPublishedAssetMatches(value,"data:model")))) return value;
  const id = hashUndoAssetString(value);
  undoAssetStore.set(id, value);
  return `${UNDO_ASSET_PREFIX}${id}`;
}

function decodeUndoValue(value){
  if(typeof value === 'string' && value.startsWith(UNDO_ASSET_PREFIX)){
    const id = value.slice(UNDO_ASSET_PREFIX.length);
    return undoAssetStore.get(id) || null;
  }
  return value;
}

function stateSnapshot(){
  return JSON.stringify(STATE, (key,value)=>encodeUndoValue(value));
}

function pruneUndoAssetStore(){
  if(!undoAssetStore.size) return;
  const used = new Set();
  for(const snap of undoStack){
    if(typeof snap !== 'string' || !snap.includes(UNDO_ASSET_PREFIX)) continue;
    for(const key of undoAssetStore.keys()){
      if(snap.includes(`${UNDO_ASSET_PREFIX}${key}`)) used.add(key);
    }
  }
  for(const key of Array.from(undoAssetStore.keys())){
    if(!used.has(key)) undoAssetStore.delete(key);
  }
}

function pushUndoState(label=''){
  if(undoApplying || !STATE) return;
  const snap = stateSnapshot();
  if(undoStack[undoStack.length - 1] === snap) return;
  undoStack.push(snap);
  while(undoStack.length > UNDO_LIMIT) undoStack.shift();
  pruneUndoAssetStore();
}

function rebuildAfterStateRestore(){
  selectedWallId = null;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedArtworkActive = false;
  pendingWallId = null;
  wallScaleMode = false;
  artworkScaleMode = false;
  wallFollowPlayer = false;
  pendingArtworkId = null;
  artworkFollowPlayer = false;
  pendingFloorTileId = null;
  floorTileFollowPlayer = false;
  selectedWaterBodyId = null;
  selectedGroupId = null;
  clearObjectMultiSelection();
  pendingWaterBodyId = null;
  waterBodyFollowPlayer = false;
  detachWallRotationControls();
  buildSkyBackground();
  buildAtmosphereEffect();
  buildRoom();
  buildWaterBodies();
  buildArtworks();
  applyActorSettings();
  syncActorEditor(); syncSinTowerTumorEditor();
syncSinTowerFireEditor();
  syncSurfaceEditor();
  syncObjectEditor();
  syncWallEditor();
  syncArtEditor();
  syncChiselPanel();
  renderObjectPanel();
  updateCursorVisibility();
}

function undoLastStep(){
  if(undoStack.length <= 1){
    setStatus('沒有可還原的上一步。');
    return;
  }
  undoApplying = true;
  try{
    const current = stateSnapshot();
    if(undoStack[undoStack.length - 1] !== current) undoStack.push(current);
    undoStack.pop();
    const snap = undoStack[undoStack.length - 1];
    STATE = sanitizeState(JSON.parse(snap, (key,value)=>decodeUndoValue(value)));
    rebuildAfterStateRestore();
    clearTimeout(saveTimer);
    saveStateNow();
    setStatus('已還原到上一步。');
  }catch(err){
    console.error(err);
    setStatus('還原失敗：狀態資料無法讀取。');
  }finally{
    undoApplying = false;
  }
}

function isTextEditingElement(el){
  if(!el) return false;
  const tag = String(el.tagName || '').toLowerCase();
  return tag === 'input' || tag === 'textarea' || tag === 'select' || !!el.isContentEditable;
}

function getActiveTextEditingElement(){
  const active = document.activeElement;
  return isTextEditingElement(active) ? active : null;
}

function isUserTyping(){
  return !!getActiveTextEditingElement();
}

function clearMovementKeys(){
  keys.w = false;
  keys.a = false;
  keys.s = false;
  keys.d = false;
}

function shouldBypassSceneShortcut(e){
  const active = getActiveTextEditingElement();
  if(!active) return false;
  // Any text/number/select/range control owns the keyboard while focused.
  // The global handler must not move the player, trigger tools, group objects, undo, delete, or scale while the user is typing/editing values.
  clearMovementKeys();
  return true;
}

function isTextEditingEventTarget(e){
  return isTextEditingElement(e?.target) || isTextEditingElement(document.activeElement);
}


function isPlayMode(){
  return sinTowerPortalGate.active || sinTowerPlayObjectUi.panelOpen || !!sinTowerPlayObjectUi.activePropId || sinTowerPlayObjectUi.cursorEditMode || sinTowerPlayObjectUi.shortcutOpen || sinTowerPlayObjectUi.stairJumpOpen || sinTowerStonePickMode.active || pointerLocked || fallbackMouseLook || (!cursorFreeMode && desiredPointerLocked);
}

function isPlayCursorDisabled(){
  if(sinTowerPlayObjectUi.panelOpen || sinTowerPlayObjectUi.activePropId || sinTowerPlayObjectUi.cursorEditMode || sinTowerPlayObjectUi.shortcutOpen || sinTowerPlayObjectUi.stairJumpOpen) return false;
  return isPlayMode() && !sinTowerStonePickMode.active;
}

function consumePlayModePointerEvent(event){
  if(!isPlayCursorDisabled()) return false;
  if(isInsideEditUi(event?.target) || isInsideMobileControls(event?.target)) return false;
  clearSelectableSelection();
  forceSelectableOpaque();
  hideChiselPreview();
  // A failed initial lock uses ordinary mouse movement temporarily. Every
  // later canvas click is still a valid user gesture and must retry Pointer
  // Lock; otherwise the hidden OS cursor eventually reaches a screen edge and
  // horizontal camera movement appears to freeze permanently.
  if(!pointerLocked && desiredPointerLocked) requestStablePointerLock();
  event?.preventDefault?.();
  event?.stopPropagation?.();
  return true;
}

function updateEditingWindowsVisibility(){
  const play = isPlayMode();
  document.body.classList.toggle('play-mode', play);
  updateLightMarkerVisibility();
  applyPlayModePerformanceLighting(play);
}

function getObjectState(type, id){
  if(type === 'artwork') return (STATE.artworks || []).find(a=>a.id===id) || null;
  if(type === 'customWall' || type === 'wall') return (STATE.customWalls || []).find(w=>w.id===id) || null;
  if(type === 'floorTile') return (STATE.floorTiles || []).find(t=>t.id===id) || null;
  if(type === 'waterBody' || type === 'water') return (STATE.waterBodies || []).find(w=>w.id===id) || null;
  if(type === 'roomSurface' || type === 'surface') return STATE.surfaces?.[id] || null;
  if(type === 'referenceArchitecture') return STATE.referenceArchitecture || null;
  if(type === 'light') return (STATE.lightSystem?.lights || []).find(l=>l.id===id) || null;
  if(type === 'objectGroup') return (STATE.objectGroups || []).find(g=>g.id===id) || null;
  return null;
}

function isObjectVisible(type, id){
  const obj = getObjectState(type, id);
  return !obj || obj.visible !== false;
}

function isObjectLocked(type, id){
  const obj = getObjectState(type, id);
  return !!obj?.locked;
}

function isObjectSelectable(type, id){
  return isObjectVisible(type, id) && !isObjectLocked(type, id);
}

function selectableCandidate(candidate){
  if(!candidate) return null;
  if(!isObjectSelectable(candidate.type, candidate.id)) return null;
  return candidate;
}

function clearSelectionIfObject(type, id){
  if(type === 'artwork' && selectedArtworkId === id){ selectedArtworkActive = false; }
  if((type === 'customWall' || type === 'wall') && selectedWallId === id) selectedWallId = null;
  if(type === 'floorTile' && selectedFloorTileId === id) selectedFloorTileId = null;
  if((type === 'waterBody' || type === 'water') && selectedWaterBodyId === id) selectedWaterBodyId = null;
  if((type === 'roomSurface' || type === 'surface') && selectedRoomWallKey === id) selectedRoomWallKey = null;
  if(type === 'referenceArchitecture') selectedReferenceArchitectureActive = false;
  if(type === 'light') selectedLightObjectActive = false;
  if(type === 'objectGroup' && selectedGroupId === id) selectedGroupId = null;
  multiSelectedObjectKeys.delete(makeObjectKey(type, id));
  detachWallRotationControls();
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  syncObjectEditor();
  renderObjectPanel();
}

function applyObjectVisibilityLocks(){
  for(const key of SURFACE_KEYS){
    const visible = !((STATE.deletedSurfaces || []).includes(key)) && STATE.surfaces?.[key]?.visible !== false;
    if(surfaces[key]) surfaces[key].visible = visible;
    const relief = groundReliefMeshes[`surface:${key}`] || (key === 'floor' ? groundReliefMeshes.floor : null);
    if(relief) relief.visible = visible;
  }
  for(const w of STATE.customWalls || []){
    const visible = w.visible !== false;
    if(customWallMeshes[w.id]) customWallMeshes[w.id].visible = visible;
    if(groundReliefMeshes[`wall:${w.id}`]) groundReliefMeshes[`wall:${w.id}`].visible = visible;
  }
  for(const t of STATE.floorTiles || []){
    const visible = t.visible !== false;
    if(floorTileMeshes[t.id]) floorTileMeshes[t.id].visible = visible;
    if(groundReliefMeshes[`floorTile:${t.id}`]) groundReliefMeshes[`floorTile:${t.id}`].visible = visible;
  }
  for(const water of STATE.waterBodies || []){
    if(waterBodyMeshes[water.id]) waterBodyMeshes[water.id].visible = water.visible !== false;
  }
  for(const art of STATE.artworks || []){
    if(artworkMeshes[art.id]) artworkMeshes[art.id].visible = art.visible !== false;
  }
  if(referenceArchitectureGroup){
    referenceArchitectureGroup.visible = STATE.referenceArchitecture?.enabled !== false && STATE.referenceArchitecture?.visible !== false;
  }
  for(const light of STATE.lightSystem?.lights || []){
    const group = lightControlObjects[light.id];
    if(group) group.visible = light.visible !== false;
  }
}

function selectedObjectKey(){
  if(selectedGroupId) return `objectGroup:${selectedGroupId}`;
  if(selectedArtworkActive && selectedArtworkId) return `artwork:${selectedArtworkId}`;
  if(selectedWallId) return `customWall:${selectedWallId}`;
  if(selectedFloorTileId) return `floorTile:${selectedFloorTileId}`;
  if(selectedWaterBodyId) return `waterBody:${selectedWaterBodyId}`;
  if(selectedRoomWallKey) return `roomSurface:${selectedRoomWallKey}`;
  if(selectedReferenceArchitectureActive) return 'referenceArchitecture:referenceArchitecture';
  if(selectedLightObjectActive && selectedLightId) return `light:${selectedLightId}`;
  return '';
}

function getObjectPanelBaseItems(){
  const items = [];
  if(STATE.referenceArchitecture && STATE.referenceArchitecture.enabled !== false){
    items.push({type:'referenceArchitecture', id:'referenceArchitecture', label:STATE.referenceArchitecture.title || '參考圖建築', kind:'整體建築', visible:STATE.referenceArchitecture.enabled !== false && STATE.referenceArchitecture.visible !== false, locked:!!STATE.referenceArchitecture.locked});
  }
  for(const key of SURFACE_KEYS){
    if((STATE.deletedSurfaces || []).includes(key)) continue;
    const cfg = STATE.surfaces?.[key] || {};
    items.push({type:'roomSurface', id:key, label:cfg.title || SURFACE_LABELS[key] || key, kind:'空間基底', visible:cfg.visible !== false, locked:!!cfg.locked});
  }
  for(const w of STATE.customWalls || []) items.push({type:'customWall', id:w.id, label:w.title || w.id, kind:isCurvedWall(w) ? '曲面牆' : '自建牆', visible:w.visible !== false, locked:!!w.locked});
  for(const t of STATE.floorTiles || []) items.push({type:'floorTile', id:t.id, label:t.title || t.id, kind:'地板塊', visible:t.visible !== false, locked:!!t.locked});
  for(const w of STATE.waterBodies || []) items.push({type:'waterBody', id:w.id, label:w.title || w.id, kind:w.shape === 'rect' ? '水體｜矩形' : (w.shape === 'oval' ? '水體｜橢圓' : '水體｜圓形'), visible:w.visible !== false, locked:!!w.locked});
  for(const l of STATE.lightSystem?.lights || []) items.push({type:'light', id:l.id, label:l.title || l.id, kind:l.type === 'directional' ? '光源｜平行光' : (l.type === 'spot' ? '光源｜聚光燈' : '光源｜點光源'), visible:l.visible !== false, locked:!!l.locked});
  for(const a of STATE.artworks || []) items.push({type:'artwork', id:a.id, label:a.title || a.id, kind:a.type === 'model' ? '3D作品' : '作品', visible:a.visible !== false, locked:!!a.locked});
  return items;
}

function getObjectPanelMemberKeySet(){
  const set = new Set();
  for(const g of STATE.objectGroups || []){
    for(const key of objectGroupMemberKeys(g)) set.add(key);
  }
  return set;
}

function getObjectPanelItems(){
  const baseItems = getObjectPanelBaseItems();
  const baseMap = new Map(baseItems.map(item=>[makeObjectKey(item.type, item.id), item]));
  const groupedKeys = new Set();
  const items = [];
  for(const g of STATE.objectGroups || []){
    const memberKeys = objectGroupMemberKeys(g).filter(key=>baseMap.has(key));
    for(const key of memberKeys) groupedKeys.add(key);
    items.push({type:'objectGroup', id:g.id, label:g.title || g.id, kind:`群組｜${memberKeys.length}件${g.expanded ? '｜展開' : '｜收合'}`, visible:g.visible !== false, locked:!!g.locked, depth:0, expanded:g.expanded === true});
    if(g.expanded === true){
      for(const key of memberKeys){
        const member = baseMap.get(key);
        if(member) items.push({...member, depth:1, parentGroupId:g.id});
      }
    }
  }
  for(const item of baseItems){
    const key = makeObjectKey(item.type, item.id);
    if(groupedKeys.has(key)) continue;
    items.push({...item, depth:0});
  }
  return items;
}

function getObjectPanelSelectableKeysInOrder(){
  return getObjectPanelItems()
    .filter(item=>item.type !== 'objectGroup' && isObjectSelectable(item.type, item.id))
    .map(item=>makeObjectKey(item.type, item.id));
}

function clearObjectMultiSelection(){
  multiSelectedObjectKeys = new Set();
  objectPanelRangeAnchorKey = null;
}

function objectGroupMemberKeys(group){
  return (group?.members || []).map(m=>makeObjectKey(m.type, m.id)).filter(k=>objectExistsByKey(k));
}

function addObjectKeyToPanelMultiSelection(type, id){
  const key = makeObjectKey(type, id);
  if(type === 'objectGroup'){
    const group = getObjectState(type, id);
    for(const memberKey of objectGroupMemberKeys(group)) multiSelectedObjectKeys.add(memberKey);
    return true;
  }
  if(!isObjectSelectable(type, id)) return false;
  multiSelectedObjectKeys.add(key);
  return true;
}

function objectPanelRangeSelect(type, id){
  const key = makeObjectKey(type, id);
  if(type === 'objectGroup'){
    const group = getObjectState(type, id);
    if(!group) return;
    for(const memberKey of objectGroupMemberKeys(group)) multiSelectedObjectKeys.add(memberKey);
    selectedGroupId = id;
    renderObjectPanel();
    setStatus(`已加入群組成員：${group.title || id}。`);
    return;
  }
  if(!isObjectSelectable(type, id)){ setStatus('該物件已鎖定或不可視，無法加入多選。'); return; }
  const ordered = getObjectPanelSelectableKeysInOrder();
  const anchor = objectPanelRangeAnchorKey && ordered.includes(objectPanelRangeAnchorKey) ? objectPanelRangeAnchorKey : key;
  const a = ordered.indexOf(anchor);
  const b = ordered.indexOf(key);
  if(a < 0 || b < 0){
    addObjectKeyToPanelMultiSelection(type, id);
    objectPanelRangeAnchorKey = key;
  }else{
    const [from, to] = a <= b ? [a,b] : [b,a];
    multiSelectedObjectKeys = new Set(ordered.slice(from, to + 1));
  }
  const preserved = new Set(multiSelectedObjectKeys);
  selectedGroupId = null;
  objectPanelSelect(type, id, {preserveMulti:true, fromRangeSelection:true});
  multiSelectedObjectKeys = preserved;
  selectedGroupId = null;
  renderObjectPanel();
  setStatus(`已選取連續物件：${multiSelectedObjectKeys.size} 件。Ctrl+G 可建立群組。`);
}

function toggleObjectPanelMultiSelection(type, id){
  const key = makeObjectKey(type, id);
  if(type === 'objectGroup'){
    const group = getObjectState(type, id);
    for(const memberKey of objectGroupMemberKeys(group)){
      if(multiSelectedObjectKeys.has(memberKey)) multiSelectedObjectKeys.delete(memberKey);
      else multiSelectedObjectKeys.add(memberKey);
    }
    selectedGroupId = id;
    renderObjectPanel();
    setStatus(`已切換群組成員多選：${group?.title || id}。`);
    return;
  }
  if(!isObjectSelectable(type, id)){ setStatus('該物件已鎖定或不可視，無法加入多選。'); return; }
  if(multiSelectedObjectKeys.has(key)) multiSelectedObjectKeys.delete(key);
  else multiSelectedObjectKeys.add(key);
  objectPanelRangeAnchorKey = key;
  const preservedMultiSelection = new Set(multiSelectedObjectKeys);
  selectedGroupId = null;
  objectPanelSelect(type, id, {preserveMulti:true});
  multiSelectedObjectKeys = preservedMultiSelection;
  selectedGroupId = null;
  renderObjectPanel();
  setStatus(`多選數量：${multiSelectedObjectKeys.size}。Ctrl+G 可建立群組。`);
}

function createObjectGroupFromMultiSelection(){
  const keys = new Set(multiSelectedObjectKeys);
  const single = selectedObjectKey();
  if(single && !single.startsWith('objectGroup:')) keys.add(single);
  const members = Array.from(keys).map(parseObjectKey).filter(m=>m.id && m.type !== 'objectGroup' && getObjectState(m.type, m.id));
  const deduped = [];
  const seen = new Set();
  for(const m of members){
    const key = makeObjectKey(m.type, m.id);
    if(seen.has(key)) continue;
    seen.add(key);
    deduped.push({type:m.type, id:m.id});
  }
  if(deduped.length < 2){
    setStatus('至少需要在物件視窗 Shift+左鍵多選兩個物件，才能 Ctrl+G 建立群組。');
    return false;
  }
  pushUndoState('create object group');
  STATE.objectGroups = Array.isArray(STATE.objectGroups) ? STATE.objectGroups : [];
  const selectedKeys = new Set(deduped.map(m=>makeObjectKey(m.type, m.id)));
  for(const g of STATE.objectGroups){
    g.members = (g.members || []).filter(m=>!selectedKeys.has(makeObjectKey(m.type, m.id)));
  }
  STATE.objectGroups = STATE.objectGroups.filter(g=>(g.members || []).length > 0);
  const group = {id:uid('group'), title:`群組 ${STATE.objectGroups.length + 1}`, members:deduped, visible:true, locked:false, expanded:false};
  STATE.objectGroups.push(group);
  selectedGroupId = group.id;
  multiSelectedObjectKeys = new Set(deduped.map(m=>makeObjectKey(m.type, m.id)));
  scheduleSave();
  renderObjectPanel();
  setStatus(`已建立群組：${group.title}，含 ${deduped.length} 個物件。雙擊名稱可重新命名。`);
  return true;
}

function startObjectPanelInlineRename(row){
  const type = row?.dataset?.type;
  const id = row?.dataset?.id;
  const nameEl = row?.querySelector?.('.object-name');
  const obj = getObjectState(type, id);
  if(!nameEl || !obj) return;
  const current = getObjectDisplayName(type, id);
  const input = document.createElement('input');
  input.className = 'object-rename-input';
  input.type = 'text';
  input.value = current;
  input.setAttribute('aria-label','重新命名物件');
  nameEl.innerHTML = '';
  nameEl.appendChild(input);
  input.focus();
  input.select();
  let done = false;
  const finish = commit=>{
    if(done) return;
    done = true;
    const title = String(input.value || '').trim();
    if(commit && title && title !== current){
      pushUndoState('rename object');
      setObjectDisplayName(type, id, title);
      scheduleSave();
      syncAllEditor();
      setStatus(`已重新命名：${title}`);
    }else{
      renderObjectPanel();
    }
  };
  input.addEventListener('click', ev=>ev.stopPropagation());
  input.addEventListener('mousedown', ev=>ev.stopPropagation());
  input.addEventListener('keydown', ev=>{
    if(ev.code === 'Enter'){ ev.preventDefault(); ev.stopPropagation(); finish(true); }
    if(ev.code === 'Escape'){ ev.preventDefault(); ev.stopPropagation(); finish(false); }
  });
  input.addEventListener('blur', ()=>finish(true));
}

function renameObjectFromPanel(type, id){
  const obj = getObjectState(type, id);
  if(!obj) return;
  const current = getObjectDisplayName(type, id);
  const next = prompt('重新命名', current);
  if(next === null) return;
  const title = String(next).trim();
  if(!title) return;
  pushUndoState('rename object');
  setObjectDisplayName(type, id, title);
  scheduleSave();
  syncAllEditor();
  setStatus(`已重新命名：${title}`);
}

function getObjectDisplayName(type, id){
  const obj = getObjectState(type, id);
  if(!obj) return id;
  if(type === 'roomSurface') return obj.title || SURFACE_LABELS[id] || id;
  if(type === 'referenceArchitecture') return obj.title || '參考圖建築';
  return obj.title || obj.name || id;
}

function setObjectDisplayName(type, id, title){
  const obj = getObjectState(type, id);
  if(!obj) return;
  obj.title = title;
  if(type === 'light') syncLightEditor();
  if(type === 'artwork') syncArtSelect();
  if(type === 'customWall') syncWallSelect();
  if(type === 'waterBody') syncWaterSelect?.();
}


function objectPanelSelect(type, id, options={}){
  if(type === 'objectGroup'){
    const group = getObjectState(type, id);
    if(!group){ setStatus('找不到此群組。'); return; }
    selectedGroupId = id;
    multiSelectedObjectKeys = new Set(objectGroupMemberKeys(group));
    if(options.toggleExpanded){
      group.expanded = group.expanded !== true;
      scheduleSave();
    }
    renderObjectPanel();
    setStatus(`已選取群組：${group.title || id}。${group.expanded ? '目前已展開。' : '目前已收合。'} 雙擊名稱可重新命名；Visible/Lock 會同步套用到群組成員。`);
    return;
  }
  if(!options.preserveMulti) selectedGroupId = null;
  if(!isObjectSelectable(type, id)){ setStatus('該物件已鎖定或不可視，無法選取。'); return; }
  if(type === 'artwork') selectArtworkById(id);
  else if(type === 'customWall') selectCustomWall(id);
  else if(type === 'floorTile') selectFloorTile(id);
  else if(type === 'waterBody') selectWaterBody(id);
  else if(type === 'roomSurface') selectRoomWall(id);
  else if(type === 'referenceArchitecture') selectReferenceArchitecture();
  else if(type === 'light') selectLightObject(id);
  renderObjectPanel();
}

function setObjectFlag(type, id, flag, value){
  const obj = getObjectState(type, id);
  if(!obj) return;
  pushUndoState(`${flag} object`);
  obj[flag] = value;
  if(type === 'objectGroup'){
    for(const m of obj.members || []){
      const member = getObjectState(m.type, m.id);
      if(!member) continue;
      member[flag] = value;
      if(m.type === 'referenceArchitecture' && flag === 'visible'){
        member.enabled = !!value;
        member.visible = !!value;
        if(value) buildReferenceArchitecture();
      }
    }
    if(flag === 'visible' && value === false) selectedGroupId = null;
  }
  if(type === 'referenceArchitecture' && flag === 'visible'){
    obj.enabled = !!value;
    obj.visible = !!value;
    if(value) buildReferenceArchitecture();
  }
  if(type === 'light'){
    rebuildLightSystem();
    if(flag === 'visible' && value !== false) attachLightTranslateControls(id);
    syncLightEditor();
  }
  if(type === 'objectGroup') rebuildLightSystem();
  if(flag === 'visible' && value === false) clearSelectionIfObject(type, id);
  if(flag === 'locked' && value === true) clearSelectionIfObject(type, id);
  applyObjectVisibilityLocks();
  renderObjectPanel();
  scheduleSave();
}

function renderObjectPanel(){
  const list = $('objectList');
  if(!list || !STATE) return;
  applyObjectVisibilityLocks();
  const selected = selectedObjectKey();
  const items = getObjectPanelItems();
  list.innerHTML = items.map(item=>{
    const key = makeObjectKey(item.type, item.id);
    const group = item.type === 'objectGroup' ? getObjectState(item.type, item.id) : null;
    const groupMemberSelected = group ? objectGroupMemberKeys(group).some(k=>multiSelectedObjectKeys.has(k)) : false;
    const multi = multiSelectedObjectKeys.has(key) || groupMemberSelected;
    const depth = safeFinite(item.depth,0);
    const arrow = item.type === 'objectGroup' ? `<span class="group-arrow">${item.expanded ? '▾' : '▸'}</span>` : (depth > 0 ? '<span class="group-arrow">↳</span>' : '');
    return `<div class="object-row" data-type="${escapeHtml(item.type)}" data-id="${escapeHtml(item.id)}" data-depth="${depth}" data-parent="${escapeHtml(item.parentGroupId || '')}" data-expanded="${item.expanded === true}" data-selected="${key===selected}" data-multiselected="${multi}" data-visible="${item.visible}" data-locked="${item.locked}">
      <div class="object-name" data-action="select" title="${escapeHtml(item.label)}">${arrow}${escapeHtml(item.label)}<span class="object-type">${escapeHtml(item.kind)}</span></div>
      <button data-action="visible">${item.visible ? 'Visible' : 'Hidden'}</button>
      <button data-action="locked">${item.locked ? 'Unlock' : 'Lock'}</button>
    </div>`;
  }).join('') || '<p class="small">目前沒有可列出的物件。</p>';
}

function escapeHtml(value){
  return String(value ?? '').replace(/[&<>"]/g, ch=>({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[ch]));
}



function installStrictObjectPanelRangeSelection(list){
  if(!list || list.dataset.strictRangeBound === '1') return;
  list.dataset.strictRangeBound = '1';

  const isLeftPointer = e => e.button === undefined || e.button === 0;
  const rowFromEvent = e => {
    const row = e.target?.closest?.('.object-row');
    return row && list.contains(row) ? row : null;
  };
  const isPanelNameTarget = e => !!e.target?.closest?.('.object-name');
  const isInlineRenameTarget = e => !!e.target?.closest?.('.object-rename-input');
  const isButtonLikeTarget = e => !!e.target?.closest?.('button,input,textarea,select');
  const rowKey = row => makeObjectKey(row?.dataset?.type, row?.dataset?.id);

  function visibleSelectableRows(){
    return Array.from(list.querySelectorAll('.object-row')).filter(row=>{
      const type = row.dataset.type;
      const id = row.dataset.id;
      if(type === 'objectGroup') return false;
      return isObjectSelectable(type, id);
    });
  }

  function selectSingleRowStrict(row){
    const type = row.dataset.type;
    const id = row.dataset.id;
    const key = rowKey(row);
    if(type === 'objectGroup'){
      clearObjectMultiSelection();
      objectPanelRangeAnchorKey = null;
      objectPanelSelect(type, id, {toggleExpanded:true});
      return;
    }
    if(!isObjectSelectable(type, id)){
      setStatus('該物件已鎖定或不可視，無法選取。');
      return;
    }
    clearObjectMultiSelection();
    objectPanelRangeAnchorKey = key;
    selectedGroupId = null;
    objectPanelSelect(type, id);
  }

  function selectRangeToRowStrict(row){
    const type = row.dataset.type;
    const id = row.dataset.id;
    if(type === 'objectGroup'){
      const group = getObjectState(type, id);
      if(!group) return;
      const keys = objectGroupMemberKeys(group);
      multiSelectedObjectKeys = new Set(keys);
      selectedGroupId = id;
      renderObjectPanel();
      setStatus(`已選取群組內物件：${keys.length} 件。Ctrl+G 可再建立新群組。`);
      return;
    }
    if(!isObjectSelectable(type, id)){
      setStatus('該物件已鎖定或不可視，無法加入多選。');
      return;
    }

    const rows = visibleSelectableRows();
    const keys = rows.map(rowKey);
    const targetKey = makeObjectKey(type, id);
    let anchorKey = objectPanelRangeAnchorKey;
    if(!anchorKey || !keys.includes(anchorKey)){
      const selectedKey = selectedObjectKey();
      anchorKey = selectedKey && keys.includes(selectedKey) ? selectedKey : targetKey;
    }
    const a = keys.indexOf(anchorKey);
    const b = keys.indexOf(targetKey);
    if(a < 0 || b < 0){
      multiSelectedObjectKeys.add(targetKey);
      objectPanelRangeAnchorKey = targetKey;
    }else{
      const from = Math.min(a,b);
      const to = Math.max(a,b);
      multiSelectedObjectKeys = new Set(keys.slice(from, to + 1));
    }

    const preserved = new Set(multiSelectedObjectKeys);
    selectedGroupId = null;
    objectPanelSelect(type, id, {preserveMulti:true, fromRangeSelection:true});
    multiSelectedObjectKeys = preserved;
    selectedGroupId = null;
    renderObjectPanel();
    setStatus(`已連續選取 ${multiSelectedObjectKeys.size} 件物件。Ctrl+G 建立群組。`);
  }

  function ownObjectPanelPointer(e){
    if(!isLeftPointer(e)) return false;
    if(isInlineRenameTarget(e)) return false;
    const row = rowFromEvent(e);
    if(!row) return false;
    if(isButtonLikeTarget(e)) return false;
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation?.();
    if(e.shiftKey) selectRangeToRowStrict(row);
    else selectSingleRowStrict(row);
    return true;
  }

  document.addEventListener('pointerdown', e=>{
    ownObjectPanelPointer(e);
  }, true);

  document.addEventListener('mousedown', e=>{
    const row = rowFromEvent(e);
    if(!row || isInlineRenameTarget(e) || isButtonLikeTarget(e) || !isLeftPointer(e)) return;
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation?.();
  }, true);

  document.addEventListener('click', e=>{
    const row = rowFromEvent(e);
    if(!row || isInlineRenameTarget(e) || isButtonLikeTarget(e)) return;
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation?.();
  }, true);

  document.addEventListener('dblclick', e=>{
    if(isInlineRenameTarget(e)) return;
    const row = rowFromEvent(e);
    if(!row || !isPanelNameTarget(e)) return;
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation?.();
    startObjectPanelInlineRename(row);
  }, true);

  document.addEventListener('selectstart', e=>{
    if(isInlineRenameTarget(e)) return;
    if(rowFromEvent(e)){
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation?.();
    }
  }, true);
}

function bindObjectPanel(){
  const list = $('objectList');
  if(!list || list.dataset.bound) return;
  list.dataset.bound = '1';
  let suppressNextClick = false;

  function getObjectPanelRowFromEvent(e){
    const row = e.target?.closest?.('.object-row');
    if(!row || !list.contains(row)) return null;
    return row;
  }

  function getObjectPanelActionFromEvent(e){
    return e.target?.closest?.('[data-action]')?.dataset?.action || 'select';
  }

  function handleObjectPanelRowActivation(e, source='click'){
    if(e.target.closest('.object-rename-input')) return true;
    const row = getObjectPanelRowFromEvent(e);
    if(!row) return false;
    const type = row.dataset.type;
    const id = row.dataset.id;
    const action = getObjectPanelActionFromEvent(e);
    const obj = getObjectState(type, id);
    if(!obj) return true;

    e.preventDefault();
    e.stopPropagation();

    if(action === 'visible'){
      if(source === 'click') setObjectFlag(type, id, 'visible', obj.visible === false);
      return true;
    }
    if(action === 'locked'){
      if(source === 'click') setObjectFlag(type, id, 'locked', !obj.locked);
      return true;
    }

    if(e.shiftKey){
      objectPanelRangeSelect(type, id);
      suppressNextClick = true;
      return true;
    }

    if(source !== 'click') return true;
    if(type === 'objectGroup'){
      clearObjectMultiSelection();
      objectPanelSelect(type, id, {toggleExpanded:true});
      return true;
    }
    clearObjectMultiSelection();
    objectPanelRangeAnchorKey = makeObjectKey(type, id);
    objectPanelSelect(type, id);
    return true;
  }

  list.addEventListener('pointerdown', e=>{
    if(e.button !== undefined && e.button !== 0) return;
    if(e.target.closest('button,input,select,textarea')) return;
    const row = getObjectPanelRowFromEvent(e);
    if(!row) return;
    e.preventDefault();
    if(e.shiftKey){
      handleObjectPanelRowActivation(e, 'pointerdown');
    }
  }, true);

  list.addEventListener('mousedown', e=>{
    if(e.button !== undefined && e.button !== 0) return;
    if(e.target.closest('button,input,select,textarea')) return;
    const row = getObjectPanelRowFromEvent(e);
    if(!row) return;
    e.preventDefault();
    if(e.shiftKey){
      handleObjectPanelRowActivation(e, 'mousedown');
    }
  }, true);

  list.addEventListener('selectstart', e=>{
    if(!e.target.closest('.object-rename-input')) e.preventDefault();
  }, true);

  list.addEventListener('click', e=>{
    if(e.target.closest('.object-rename-input')) return;
    const row = getObjectPanelRowFromEvent(e);
    if(!row) return;
    e.preventDefault();
    e.stopPropagation();
    if(suppressNextClick){
      suppressNextClick = false;
      return;
    }
    if(e.detail > 1) return;
    handleObjectPanelRowActivation(e, 'click');
  }, true);

  list.addEventListener('dblclick', e=>{
    const name = e.target.closest('.object-name');
    if(!name || e.target.closest('.object-rename-input')) return;
    const row = name.closest('.object-row');
    if(!row) return;
    e.preventDefault();
    e.stopPropagation();
    startObjectPanelInlineRename(row);
  }, true);

  installStrictObjectPanelRangeSelection(list);
}

document.addEventListener('focusin', e=>{ if(isTextEditingElement(e.target)) clearMovementKeys(); }, true);
document.addEventListener('focusout', e=>{ if(isTextEditingElement(e.target)) clearMovementKeys(); }, true);

function captureFloatingWindowStates(){
  const states = {};
  for(const id of ['editor','hud','status','tumorPanel','sinTowerAssetPanel','sinTowerFirePanel','objectPanel','lightPanel','chiselPanel']){
    const el = $(id);
    if(!el) continue;
    states[id] = {
      minimized: el.classList.contains('is-minimized'),
      left: el.style.left || '', top: el.style.top || '', width: el.style.width || '', height: el.style.height || ''
    };
  }
  return states;
}

function restoreFloatingWindowStates(states={}){
  for(const [id, st] of Object.entries(states || {})){
    const el = $(id);
    if(!el || !st) continue;
    el.classList.toggle('is-minimized', !!st.minimized);
    const btn = el.querySelector('.window-minimize');
    if(btn) btn.textContent = el.classList.contains('is-minimized') ? '+' : '–';
    if(st.left) el.style.left = st.left;
    if(st.top) el.style.top = st.top;
    if(st.width) el.style.width = st.width;
    if(st.height) el.style.height = st.height;
  }
}

function confirmPendingPlacementPreservingWindows(){
  const windowStates = captureFloatingWindowStates();
  const confirmed = confirmPendingWall() || confirmPendingArtwork() || confirmPendingFloorTile() || confirmPendingWaterBody();
  restoreFloatingWindowStates(windowStates);
  return confirmed;
}

let sinTowerFloatingTopZ = 80;
function bringFloatingWindowToFront(el){
  if(!el) return;
  sinTowerFloatingTopZ = Math.max(sinTowerFloatingTopZ + 1, 80);
  el.style.zIndex = String(sinTowerFloatingTopZ);
}

function setupFloatingWindows(){
  for(const id of ['editor','hud','status','tumorPanel','sinTowerAssetPanel','sinTowerFirePanel','objectPanel','lightPanel','chiselPanel']){
    const el = $(id);
    if(!el || el.dataset.floatingReady) continue;
    el.dataset.floatingReady = '1';
    el.classList.add('edit-ui','floating-window');
    el.addEventListener('pointerdown', ()=>bringFloatingWindowToFront(el), true);
    el.addEventListener('mousedown', ()=>bringFloatingWindowToFront(el), true);
    el.addEventListener('focusin', ()=>bringFloatingWindowToFront(el), true);
    bringFloatingWindowToFront(el);
    const title = el.dataset.windowTitle || id;
    const body = document.createElement('div');
    body.className = 'window-body';
    while(el.firstChild) body.appendChild(el.firstChild);
    const header = document.createElement('div');
    header.className = 'window-header';
    header.innerHTML = `<span class="window-title">${escapeHtml(title)}</span><button class="window-minimize" type="button" title="最小化">–</button>`;
    el.insertBefore(header, el.firstChild);
    el.appendChild(body);
    const rect = el.getBoundingClientRect();
    el.style.left = rect.left + 'px';
    el.style.top = rect.top + 'px';
    el.style.right = 'auto';
    el.style.bottom = 'auto';
    el.style.width = Math.max(rect.width, id === 'status' ? 240 : 180) + 'px';
    if(id !== 'status' && rect.height > 48) el.style.height = Math.min(rect.height, window.innerHeight - 28) + 'px';
    const minBtn = header.querySelector('.window-minimize');
    minBtn.addEventListener('click', ev=>{
      ev.stopPropagation();
      el.classList.toggle('is-minimized');
      minBtn.textContent = el.classList.contains('is-minimized') ? '+' : '–';
    });
    let dragging = false, startX=0, startY=0, baseX=0, baseY=0;
    header.addEventListener('pointerdown', ev=>{
      if(ev.target === minBtn) return;
      dragging = true;
      startX = ev.clientX; startY = ev.clientY;
      const r = el.getBoundingClientRect();
      baseX = r.left; baseY = r.top;
      header.setPointerCapture?.(ev.pointerId);
      ev.preventDefault();
    });
    header.addEventListener('pointermove', ev=>{
      if(!dragging) return;
      const nx = clamp(baseX + ev.clientX - startX, 0, window.innerWidth - 48);
      const ny = clamp(baseY + ev.clientY - startY, 0, window.innerHeight - 36);
      el.style.left = nx + 'px';
      el.style.top = ny + 'px';
    });
    const stop = ev=>{ dragging = false; try{ header.releasePointerCapture?.(ev.pointerId); }catch{} };
    header.addEventListener('pointerup', stop);
    header.addEventListener('pointercancel', stop);
  }
  bindObjectPanel();
  renderObjectPanel();
  updateEditingWindowsVisibility();
}

function updateCursorVisibility(){
  syncSinGifCursor();
  if(EXPORTED_GALLERY_VIEWER){
    document.body.classList.add('exported-viewer','play-mode');
    document.body.style.cursor = IS_TOUCH_DEVICE ? 'default' : 'none';
    if(renderer?.domElement) renderer.domElement.style.cursor = IS_TOUCH_DEVICE ? 'default' : 'none';
    hideChiselPreview();
    applyPlayModePerformanceLighting(true);
    return;
  }
  const hidden = pointerLocked || fallbackMouseLook || (!cursorFreeMode && desiredPointerLocked);
  const value = hidden ? 'none' : 'default';
  document.body.style.cursor = value;
  if(renderer?.domElement) renderer.domElement.style.cursor = value;
  if(hidden){
    clearSelectableSelection();
    forceSelectableOpaque();
    hideChiselPreview();
  }
  updateEditingWindowsVisibility();
}

function clearSelectableSelection(){
  selectedWallId = null;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedWaterBodyId = null;
  selectedArtworkActive = false;
  selectedReferenceArchitectureActive = false;
  selectedLightObjectActive = false;
  selectedGroupId = null;
  clearObjectMultiSelection();
  detachWallRotationControls();
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  refreshWaterSelectionVisuals();
  syncWaterEditor();
  syncWallEditor();
  syncObjectEditor();
  renderObjectPanel();
}

function forceSelectableOpaque(){
  for(const mesh of Object.values(surfaces)) applyWallVisualState(mesh, false, false);
  for(const [id,mesh] of Object.entries(customWallMeshes)){
    const w = STATE.customWalls.find(item=>item.id===id);
    applyWallVisualState(mesh, false, !!w?.isDraft);
  }
  for(const [id,mesh] of Object.entries(floorTileMeshes)){
    const t = (STATE.floorTiles || []).find(item=>item.id===id);
    applyWallVisualState(mesh, false, !!t?.isDraft);
  }
  for(const body of STATE.waterBodies || []) applyWaterVisualState(waterBodyMeshes[body.id], false, !!body.isDraft);
  for(const art of STATE.artworks || []) applyArtworkVisualState(artworkMeshes[art.id], false, !!art.isDraft);
}

function showCursorByEsc(){
  if(SIN_TOWER_PUBLISHED)return;
  document.body.classList.remove('sin-cursor-closing');
  pendingEscRelock = false;
  desiredPointerLocked = false;
  cursorFreeMode = true;
  fallbackMouseLook = false;
  resetFallbackLookAnchor();
  const hadPointerLock = pointerLocked || hasActivePointerLock();
  pointerLocked = false;
  if(hadPointerLock){
    try{ document.exitPointerLock?.(); }catch(error){ console.warn('Pointer Lock release failed',error); }
  }
  updateCursorVisibility();
  setStatus('滑鼠游標已顯示。現在可直接點選場景物件；點選畫面不會讓游標消失。');
}

function handleSinTowerHideCursorShortcut(event){
  const keyMatches=event?.code==='KeyM'||String(event?.key||'').toLowerCase()==='m';
  const modifierMatches=!!event?.shiftKey&&!event?.ctrlKey&&!event?.altKey&&!event?.metaKey;
  const modalOpen=sinTowerPortalGate.active||sinTowerPlayObjectUi.panelOpen||!!sinTowerPlayObjectUi.activePropId||sinTowerPlayObjectUi.shortcutOpen||sinTowerPlayObjectUi.stairJumpOpen||sinTowerPortalLayoutEditor.active||sinTowerMobileLayoutEditor.active;
  const inGame=EXPORTED_GALLERY_VIEWER||document.body.classList.contains('play-mode')||isPlayMode();
  if(!keyMatches||!modifierMatches||event?.repeat||isTextEditingElement(document.activeElement)||modalOpen||!inGame)return false;
  event.preventDefault?.();
  event.stopPropagation?.();
  event.stopImmediatePropagation?.();
  lockPointerAfterEscRelease();
  setStatus('Shift+M：滑鼠游標已隱藏，錄影中可繼續旋轉視角。');
  return true;
}

function lockPointerAfterEscRelease(){
  finishSinTowerObjectCursorMode();
  clearSelectableSelection();
  forceSelectableOpaque();
  cameraViewMode = 'shoulder';
  desiredPointerLocked = true;
  cursorFreeMode = false;
  fallbackMouseLook = !pointerLocked && !IS_TOUCH_DEVICE;
  resetFallbackLookAnchor();
  updateCursorVisibility();
  requestStablePointerLock();
  setStatus('滑鼠游標已隱藏。按 ESC 可再次顯示游標。');
  setTimeout(()=>{
    if(!pointerLocked && desiredPointerLocked && !cursorFreeMode){
      fallbackMouseLook = !IS_TOUCH_DEVICE;
      updateCursorVisibility();
      setStatus('已進入遊玩模式。Pointer Lock 尚未維持；點擊畫面會重新嘗試鎖定視角，浮動視窗不會自動彈回。');
    }
  }, 220);
}

function toggleCursorByEsc(){
  cancelWallEditModes();
  if(pointerLocked || fallbackMouseLook || (!cursorFreeMode && desiredPointerLocked)){
    showCursorByEsc();
    return;
  }
  // 不在 keydown 當下 requestPointerLock。瀏覽器會把同一次 ESC 視為解除鎖定，
  // 造成「隱藏一瞬間又彈出游標」。改到 keyup 後再鎖定。
  clearSelectableSelection();
  forceSelectableOpaque();
  pendingEscRelock = true;
  desiredPointerLocked = true;
  cursorFreeMode = false;
  fallbackMouseLook = false;
  updateCursorVisibility();
}



function pointerNDC(event){
  const rect = renderer.domElement.getBoundingClientRect();
  return pointerLocked
    ? new THREE.Vector2(0,0)
    : new THREE.Vector2(((event.clientX-rect.left)/rect.width)*2-1, -((event.clientY-rect.top)/rect.height)*2+1);
}

function selectCustomWall(id){
  if(!id || !customWallMeshes[id]) return false;
  selectedWallId = id;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedWaterBodyId = null;
  selectedArtworkActive = false;
  selectedReferenceArchitectureActive = false;
  selectedGroupId = null;
  clearObjectMultiSelection();
  syncWallEditor();
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  renderObjectPanel();
  return true;
}

function selectRoomWall(key){
  if(!SURFACE_KEYS.includes(key) || !surfaces[key]) return false;
  selectedRoomWallKey = key;
  selectedWallId = null;
  selectedFloorTileId = null;
  selectedWaterBodyId = null;
  selectedArtworkActive = false;
  selectedReferenceArchitectureActive = false;
  selectedLightObjectActive = false;
  selectedGroupId = null;
  clearObjectMultiSelection();
  detachWallRotationControls();
  if($('surfaceSelect')) $('surfaceSelect').value = key;
  syncSurfaceEditor();
  syncWallEditor();
  refreshWallSelectionVisuals();
  renderObjectPanel();
  return true;
}

function selectFloorTile(id){
  if(!id || !floorTileMeshes[id] && !(STATE.floorTiles||[]).some(t=>t.id===id)) return false;
  selectedFloorTileId = id;
  selectedWallId = null;
  selectedRoomWallKey = null;
  selectedWaterBodyId = null;
  selectedArtworkActive = false;
  selectedGroupId = null;
  clearObjectMultiSelection();
  detachWallRotationControls();
  syncSurfaceEditor();
  syncGroundReliefEditor();
  syncFloorPhysicsEditor();
  syncWallEditor();
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  renderObjectPanel();
  return true;
}

function isVisibleInHierarchy(obj){
  let cur = obj;
  while(cur){
    if(cur.visible === false) return false;
    cur = cur.parent;
  }
  return true;
}

function findUserDataValueInHierarchy(obj, key, stopAt=null){
  let cur = obj;
  while(cur){
    if(cur.userData && cur.userData[key] !== undefined && cur.userData[key] !== null) return cur.userData[key];
    if(stopAt && cur === stopAt) break;
    cur = cur.parent;
  }
  return null;
}

function selectableRaycasterFromPointer(event){
  const raycaster = new THREE.Raycaster();
  raycaster.setFromCamera(pointerNDC(event), camera);
  raycaster.params.Mesh = raycaster.params.Mesh || {};
  return raycaster;
}

function selectableObjectsForRaycast(){
  return [
    artworkGroup,
    waterGroup,
    referenceArchitectureGroup,
    lightRigGroup,
    ...[...sinTowerEditorRuntime.stones.values()].map(rec=>rec?.mesh).filter(Boolean),
    ...Object.values(groundReliefMeshes).filter(Boolean),
    ...Object.values(floorTileMeshes).filter(Boolean),
    ...Object.values(customWallMeshes).filter(Boolean),
    ...SURFACE_KEYS.map(k=>surfaces[k]).filter(Boolean)
  ].filter(Boolean);
}

function selectableCandidateFromHit(hit){
  if(!hit?.object || !isVisibleInHierarchy(hit.object)) return null;
  const stoneId = findUserDataValueInHierarchy(hit.object, 'sinTowerEditorId', scene);
  if(stoneId && getSinTowerEditorObjectById(stoneId, 'stone')){
    return selectableCandidate({type:'sinTowerStone', id:stoneId, distance:hit.distance, hit, priority:-1, key:`sinTowerStone:${stoneId}`});
  }
  const artId = findUserDataValueInHierarchy(hit.object, 'artId', scene);
  if(artId && (STATE.artworks || []).some(art=>art.id === artId)){
    return selectableCandidate({type:'artwork', id:artId, distance:hit.distance, hit, priority:0, key:`artwork:${artId}`});
  }
  const waterId = findUserDataValueInHierarchy(hit.object, 'waterId', scene);
  if(waterId && ((STATE.waterBodies || []).some(w=>w.id === waterId) || waterBodyMeshes[waterId])){
    return selectableCandidate({type:'waterBody', id:waterId, distance:hit.distance, hit, priority:1, key:`waterBody:${waterId}`});
  }
  const floorTileId = findUserDataValueInHierarchy(hit.object, 'floorTileId', scene);
  if(floorTileId && ((STATE.floorTiles || []).some(t=>t.id === floorTileId) || floorTileMeshes[floorTileId])){
    return selectableCandidate({type:'floorTile', id:floorTileId, distance:hit.distance, hit, priority:3, key:`floorTile:${floorTileId}`});
  }
  const wallId = findUserDataValueInHierarchy(hit.object, 'wallId', scene);
  if(wallId && customWallMeshes[wallId]){
    return selectableCandidate({type:'customWall', id:wallId, distance:hit.distance, hit, priority:2, key:`wall:${wallId}`});
  }
  const lightId = findUserDataValueInHierarchy(hit.object, 'lightId', scene);
  if(lightId && (STATE.lightSystem?.lights || []).some(l=>l.id === lightId)){
    return selectableCandidate({type:'light', id:lightId, distance:hit.distance, hit, priority:2, key:`light:${lightId}`});
  }
  const referenceArchitectureId = findUserDataValueInHierarchy(hit.object, 'referenceArchitectureId', scene);
  if(referenceArchitectureId === 'referenceArchitecture' && STATE.referenceArchitecture){
    return selectableCandidate({type:'referenceArchitecture', id:'referenceArchitecture', distance:hit.distance, hit, priority:5, key:'referenceArchitecture:referenceArchitecture'});
  }
  const surfaceKey = findUserDataValueInHierarchy(hit.object, 'surfaceKey', scene);
  if(surfaceKey && SURFACE_KEYS.includes(surfaceKey) && surfaces[surfaceKey]){
    return selectableCandidate({type:'roomSurface', id:surfaceKey, distance:hit.distance, hit, priority:4, key:`surface:${surfaceKey}`});
  }
  return null;
}

function selectReferenceArchitecture(){
  if(!STATE.referenceArchitecture) return false;
  selectedReferenceArchitectureActive = true;
  selectedArtworkActive = false;
  selectedWallId = null;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedWaterBodyId = null;
  selectedLightObjectActive = false;
  selectedGroupId = null;
  clearObjectMultiSelection();
  detachWallRotationControls();
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  syncSurfaceEditor();
  syncGroundReliefEditor();
  syncObjectEditor();
  setStatus('已選取參考圖建築。可在「選取物件材質」匯入皮膚材質，並在「表面凹凸起伏」調整整體建築凹凸；凹凸會套用到上、下、左、右、前、後所有面。');
  renderObjectPanel();
  return true;
}

function selectArtworkById(id){
  if(!id || !artworkMeshes[id]) return false;
  selectedArtworkId = id;
  selectedArtworkActive = true;
  selectedWallId = null;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedWaterBodyId = null;
  selectedReferenceArchitectureActive = false;
  selectedLightObjectActive = false;
  selectedGroupId = null;
  clearObjectMultiSelection();
  detachWallRotationControls();
  syncWallEditor();
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  syncArtSelect();
  syncArtEditor();
  syncGroundReliefEditor();
  setStatus(`已選取作品：${getSelectedArt()?.title || selectedArtworkId}。Shift+T 可開啟 XYZ 旋轉軸；可在「表面凹凸起伏」套用作品表面凹凸。`);
