function addSinTowerEditorStoneFromUi(){
  const stone = sinTowerStoneFromUi({id:uid('stone'), title:'石塊', seed:Date.now() % 100000});
  SIN_TOWER_EDITOR.stones.push(stone);
  SIN_TOWER_EDITOR.selectedObjectType = 'stone';
  SIN_TOWER_EDITOR.selectedObjectId = stone.id;
