    s.source=null;if(s.canvas)s.canvas.hidden=true;original.style.visibility='';original.setAttribute('src',source);
    console.warn('Using native GIF playback:',error.message);
  }});return s.promise;
}
function drawSinPortalSmooth(){
  const s=sinPortalSmooth;cancelAnimationFrame(s.raf);if(!sinPortalPasswordVisible())return;
  if(s.stream){
    const stream=s.stream;if(!s.durations.length||!stream.width)return;
    const {index}=sinPortalTimeline(performance.now()-s.start,s.durations);
    if(index!==s.index&&!stream.pending){stream.pending=true;const recycle=stream.recycle;stream.recycle=null;
      sinGifRequest(stream.slot,{type:'frame',key:stream.key,index,recycle}).then(result=>paintSinPortalStream(stream,result)).catch(error=>{if(!stream.disposed)console.warn('Password GIF decode failed:',error.message);}).finally(()=>{stream.pending=false;});
    }
    s.raf=requestAnimationFrame(drawSinPortalSmooth);return;
  }
  if(!s.frames.length)return;
  const {index,next,blend}=sinPortalTimeline(performance.now()-s.start,s.durations);s.index=index;s.blend=blend;const ctx=s.canvas.getContext('2d');ctx.clearRect(0,0,s.canvas.width,s.canvas.height);ctx.globalAlpha=1-blend;ctx.globalCompositeOperation='source-over';ctx.drawImage(s.frames[index],0,0);ctx.globalCompositeOperation='lighter';ctx.globalAlpha=blend;ctx.drawImage(s.frames[next],0,0);ctx.globalAlpha=1;ctx.globalCompositeOperation='source-over';s.raf=requestAnimationFrame(drawSinPortalSmooth);
}

function getSinTowerPortalPasswordGifSource(){
  return STATE?.portalPasswordGifDataUrl||SIN_TOWER_PORTAL_PASSWORD_DEFAULT_GIF;
}

function applySinTowerPortalPasswordGifSource(){
  const source=getSinTowerPortalPasswordGifSource(),frame=$('sinPortalPasswordFrame');
  if(frame&&frame._sinPortalSource!==source){frame._sinPortalSource=source;frame.setAttribute('src',source);}
  void prepareSinPortalSmooth();
  return source;
}

function getSinTowerPortalPasswordSlotArtSource(){
  return STATE?.portalPasswordSlotArtDataUrl||SIN_TOWER_PORTAL_PASSWORD_DEFAULT_SLOT_ART;
}

function applySinTowerPortalPasswordSlotArtSource(){
  const source=getSinTowerPortalPasswordSlotArtSource();
  for(const image of document.querySelectorAll('.sin-portal-password-slot-art,.sin-portal-password-slot-preview-art'))if(image.getAttribute('src')!==source)image.setAttribute('src',source);
  return source;
}

function syncSinTowerPortalPasswordSlotArtEditor(){
  applySinTowerPortalPasswordSlotArtSource();
  const state=$('sinPerfPortalPasswordSlotArtState');
  if(state)state.textContent=STATE?.portalPasswordSlotArtDataUrl?'目前：'+(STATE.portalPasswordSlotArtName||'自訂欄位素材')+'（已保存）':'目前：內建 Codeframe.png';
}

async function importSinTowerPortalPasswordSlotArt(file){
  if(!file)return false;
  const state=$('sinPerfPortalPasswordSlotArtState'),type=String(file.type||'').toLowerCase(),validType=/^image\/(?:png|gif|webp|jpeg)$/.test(type)||/\.(?:png|gif|webp|jpe?g)$/i.test(file.name||'');
  if(!validType){if(state)state.textContent='匯入失敗：請選擇 PNG、GIF、WebP 或 JPG。';setStatus('密碼欄位素材只接受圖片或 GIF。');return false;}
  if(safeFinite(file.size,0)>32*1024*1024){if(state)state.textContent='匯入失敗：檔案超過 32 MB。';setStatus('密碼欄位素材不可超過 32 MB。');return false;}
  if(state)state.textContent='正在讀取 '+(file.name||'欄位素材')+'…';
  try{
    const dataUrl=await readFileAsDataURL(file);
    if(typeof dataUrl!=='string'||!(/^data:image\/(?:png|gif|webp|jpeg)(?:;[^,]*)?,/i.test(dataUrl)||sinPublishedAssetMatches(dataUrl,/^data:image\/(?:png|gif|webp|jpeg)(?:;[^,]*)?,/i)))throw new Error('檔案不是有效的圖片或 GIF。');
    const dimensions=await readImageDimensions(dataUrl);
    if(!dimensions?.width||!dimensions?.height)throw new Error('無法解析欄位素材尺寸。');
    pushUndoState('portal-password-slot-art');
    STATE.portalPasswordSlotArtDataUrl=dataUrl;STATE.portalPasswordSlotArtName=String(file.name||'自訂欄位素材').slice(0,240);
    syncSinTowerPortalPasswordSlotArtEditor();await saveStateNow();
    setStatus('密碼欄位圖片已替換並保存：'+STATE.portalPasswordSlotArtName+'（'+dimensions.width+'×'+dimensions.height+'）。');return true;
  }catch(error){console.error('Portal password slot art import failed',error);if(state)state.textContent='匯入失敗：'+(error?.message||error);setStatus('密碼欄位素材匯入失敗：'+(error?.message||error));return false;}
}

async function resetSinTowerPortalPasswordSlotArt(){
  pushUndoState('reset-portal-password-slot-art');STATE.portalPasswordSlotArtDataUrl=null;STATE.portalPasswordSlotArtName='';syncSinTowerPortalPasswordSlotArtEditor();await saveStateNow();setStatus('四格密碼欄位已還原為內建 Codeframe.png。');
}

function syncSinTowerPortalPasswordGifEditor(){
  const source=getSinTowerPortalPasswordGifSource(),preview=$('sinPerfPortalPasswordGifPreview'),state=$('sinPerfPortalPasswordGifState');
  if(preview){if(preview.getAttribute('src')!==source)preview.setAttribute('src',source);preview.classList.add('ready');}
  if(state)state.textContent=STATE?.portalPasswordGifDataUrl?'目前：'+(STATE.portalPasswordGifName||'自訂 GIF')+'（已保存）':'目前：內建 CODE3.gif';
  syncSinTowerPortalFxEditor();
}

async function importSinTowerPortalPasswordGif(file){
  if(!file)return false;
  const state=$('sinPerfPortalPasswordGifState');
  if(!(String(file.type||'').toLowerCase()==='image/gif'||/\.gif$/i.test(file.name||''))){if(state)state.textContent='匯入失敗：請選擇 GIF 動畫檔。';setStatus('密碼畫面只接受 GIF 動畫。');return false;}
  if(state)state.textContent='正在讀取 '+(file.name||'GIF')+'…';
  try{
    const dataUrl=await readSinLoopingGif(file);
    if(typeof dataUrl!=='string'||!(/^data:image\/gif(?:;base64)?,/i.test(dataUrl)||sinPublishedAssetMatches(dataUrl,/^data:image\/gif(?:;base64)?,/i)))throw new Error('檔案不是有效的 GIF 動畫。');
    const dimensions=await readImageDimensions(dataUrl);
    if(!dimensions?.width||!dimensions?.height)throw new Error('無法解析 GIF 尺寸。');
    pushUndoState('portal-password-gif');
    STATE.portalPasswordGifDataUrl=dataUrl;
    STATE.portalPasswordGifName=String(file.name||'自訂 GIF').slice(0,240);
    applySinTowerPortalPasswordGifSource();
    syncSinTowerPortalPasswordGifEditor();
    await saveStateNow();
    setStatus('密碼畫面 GIF 已替換並保存：'+STATE.portalPasswordGifName+'（'+dimensions.width+'×'+dimensions.height+'）。');
    return true;
  }catch(error){
    console.error('Portal password GIF import failed',error);
    if(state)state.textContent='匯入失敗：'+(error?.message||error);
    setStatus('密碼畫面 GIF 匯入失敗：'+(error?.message||error));
    return false;
  }
}

async function resetSinTowerPortalPasswordGif(){
  pushUndoState('reset-portal-password-gif');
  STATE.portalPasswordGifDataUrl=null;
  STATE.portalPasswordGifName='';
  applySinTowerPortalPasswordGifSource();
  syncSinTowerPortalPasswordGifEditor();
  await saveStateNow();
  setStatus('密碼畫面已還原為內建 CODE3.gif。');
}

function getSinTowerPortalPasswordFx(){if(!STATE?.portalPasswordFx&&STATE)STATE.portalPasswordFx=createDefaultPortalPasswordFx();return STATE?.portalPasswordFx||createDefaultPortalPasswordFx();}

function syncSinTowerPortalFxEditor(){
  const value=getSinTowerPortalPasswordFx(),fields=[['sinPerfPortalClarity','sinPerfPortalClarityValue',Math.round(value.clarity*100),'%'],['sinPerfPortalBrightness','sinPerfPortalBrightnessValue',Math.round(value.brightness*100),'%'],['sinPerfPortalContrast','sinPerfPortalContrastValue',Math.round(value.contrast*100),'%'],['sinPerfPortalDitherScale','sinPerfPortalDitherScaleValue',value.ditherScale,'×'],['sinPerfPortalTextScale','sinPerfPortalTextScaleValue',Math.round(value.textScale*100),'%'],['sinPerfPortalTextWeight','sinPerfPortalTextWeightValue',value.textWeight,''],['sinPerfPortalSlotDitherStrength','sinPerfPortalSlotDitherStrengthValue',Math.round(value.slotDitherStrength*100),'%'],['sinPerfPortalSlotDitherDetail','sinPerfPortalSlotDitherDetailValue',Math.round(value.slotDitherDetail*100),'%'],['sinPerfPortalSlotBrightness','sinPerfPortalSlotBrightnessValue',Math.round(value.slotBrightness*100),'%'],['sinPerfPortalSlotContrast','sinPerfPortalSlotContrastValue',Math.round(value.slotContrast*100),'%'],['sinPerfPortalSlotTextOffsetX','sinPerfPortalSlotTextOffsetXValue',Math.round(value.slotTextOffsetX),'%'],['sinPerfPortalSlotTextOffsetY','sinPerfPortalSlotTextOffsetYValue',Math.round(value.slotTextOffsetY),'%']];
  for(const [inputId,outputId,next,suffix] of fields){const input=$(inputId),output=$(outputId);if(input&&document.activeElement!==input)input.value=next;if(output)output.textContent=next+suffix;}
  syncSinTowerPortalScreenFx();
}

function applySinTowerPortalFxFromEditor(){
  if(!STATE)return;STATE.portalPasswordFx=sanitizePortalPasswordFx({clarity:safeFinite($('sinPerfPortalClarity')?.value,82)/100,brightness:safeFinite($('sinPerfPortalBrightness')?.value,100)/100,contrast:safeFinite($('sinPerfPortalContrast')?.value,115)/100,ditherScale:safeFinite($('sinPerfPortalDitherScale')?.value,1),textScale:safeFinite($('sinPerfPortalTextScale')?.value,155)/100,textWeight:safeFinite($('sinPerfPortalTextWeight')?.value,900),slotDitherStrength:safeFinite($('sinPerfPortalSlotDitherStrength')?.value,100)/100,slotDitherDetail:safeFinite($('sinPerfPortalSlotDitherDetail')?.value,94)/100,slotBrightness:safeFinite($('sinPerfPortalSlotBrightness')?.value,110)/100,slotContrast:safeFinite($('sinPerfPortalSlotContrast')?.value,150)/100,slotTextOffsetX:safeFinite($('sinPerfPortalSlotTextOffsetX')?.value,0),slotTextOffsetY:safeFinite($('sinPerfPortalSlotTextOffsetY')?.value,-10)});
  syncSinTowerPortalScreenFx();applySinTowerPortalPasswordLayout();syncSinTowerPortalFxEditor();scheduleSave();scheduleSinTowerRuntimeSave();
}

function resetSinTowerPortalFx(){pushUndoState('reset-portal-password-fx');STATE.portalPasswordFx=createDefaultPortalPasswordFx();syncSinTowerPortalFxEditor();applySinTowerPortalPasswordLayout();scheduleSave();scheduleSinTowerRuntimeSave();setStatus('密碼畫面清晰度已還原。');}

function resetSinTowerPortalSlotFx(){
  const defaults=createDefaultPortalPasswordFx(),current=getSinTowerPortalPasswordFx();pushUndoState('reset-portal-password-slot-fx');
  STATE.portalPasswordFx=sanitizePortalPasswordFx({...current,slotDitherStrength:defaults.slotDitherStrength,slotDitherDetail:defaults.slotDitherDetail,slotBrightness:defaults.slotBrightness,slotContrast:defaults.slotContrast,slotTextOffsetX:defaults.slotTextOffsetX,slotTextOffsetY:defaults.slotTextOffsetY});
  syncSinTowerPortalFxEditor();applySinTowerPortalPasswordLayout();scheduleSave();scheduleSinTowerRuntimeSave();setStatus('四格密碼欄位的點陣與字符對齊已還原。');
}

function syncSinTowerPortalScreenFx(fx=getScreenFxConfig()){
  const overlay=$('sinPortalPasswordOverlay');if(!overlay)return;
  const portalFx=getSinTowerPortalPasswordFx(),paper=validColor(fx.monoPaper)?fx.monoPaper:'#f4d66f',ink=validColor(fx.monoInk)?fx.monoInk:'#14263d',preview=$('sinPerfPortalPasswordGifPreview'),previewSlots=$('sinPerfPortalPasswordSlotsPreview');
  for(const node of [overlay,preview,previewSlots]){node?.style.setProperty('--portal-paper',paper);node?.style.setProperty('--portal-ink',ink);}
  for(const node of [previewSlots,$('sinPortalPasswordGroup')]){node?.style.setProperty('--portal-slot-text-offset-x',portalFx.slotTextOffsetX+'%');node?.style.setProperty('--portal-slot-text-offset-y',portalFx.slotTextOffsetY+'%');}
  previewSlots?.style.setProperty('--portal-preview-text-scale',portalFx.textScale);previewSlots?.style.setProperty('--portal-preview-text-weight',portalFx.textWeight);
  const group=$('sinPortalPasswordGroup');group?.style.setProperty('--portal-slot-text-scale',portalFx.textScale);group?.style.setProperty('--portal-slot-text-weight',portalFx.textWeight);
  const paperRgb=hexToRgb01(paper),slotSlope=portalFx.slotBrightness*portalFx.slotContrast,slotIntercept=.5*(1-portalFx.slotContrast);
  for(const id of ['sinPortalSlotMonoAdjustR','sinPortalSlotMonoAdjustG','sinPortalSlotMonoAdjustB']){const fn=$(id);fn?.setAttribute('slope',String(slotSlope));fn?.setAttribute('intercept',String(slotIntercept));}
  $('sinPortalSlotMonoPaper')?.setAttribute('flood-color',paper);$('sinPortalSlotMonoInk')?.setAttribute('flood-color',ink);
  const slotBlend=$('sinPortalSlotMonoBlend');slotBlend?.setAttribute('k2',String(portalFx.slotDitherStrength));slotBlend?.setAttribute('k3',String(1-portalFx.slotDitherStrength));
  const viewport=getSinTowerGameViewport(),backingScale=screenFxTargetSize.x>0&&viewport.width>0?screenFxTargetSize.x/viewport.width:(renderer?.getPixelRatio?.()||1),gridScale=Math.max(1,safeFinite(screenFxMaterial?.uniforms?.uDitherGridScale?.value,1)),slotLogicalCell=THREE.MathUtils.lerp(4.25,.25,portalFx.slotDitherDetail),slotCell=Math.max(.25,Math.round(slotLogicalCell*gridScale/Math.max(.001,backingScale)*4)/4),slotKey=[slotCell,paper,slotSlope,slotIntercept].join(':');
