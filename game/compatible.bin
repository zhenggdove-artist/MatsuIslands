  return true;
}


function currentSelectedCandidateKey(){
  if(SIN_TOWER_EDITOR.selectedObjectType === 'stone' && SIN_TOWER_EDITOR.selectedObjectId) return `sinTowerStone:${SIN_TOWER_EDITOR.selectedObjectId}`;
  if(selectedArtworkActive && selectedArtworkId) return `artwork:${selectedArtworkId}`;
  if(selectedFloorTileId) return `floorTile:${selectedFloorTileId}`;
  if(selectedWaterBodyId) return `waterBody:${selectedWaterBodyId}`;
  if(selectedWallId) return `wall:${selectedWallId}`;
  if(selectedRoomWallKey) return `surface:${selectedRoomWallKey}`;
  if(selectedReferenceArchitectureActive) return 'referenceArchitecture:referenceArchitecture';
  if(selectedLightObjectActive && selectedLightId) return `light:${selectedLightId}`;
  return null;
}

function confirmOtherPendingObjects(exceptType=null, exceptId=null){
  if(pendingWallId && !(exceptType === 'customWall' && pendingWallId === exceptId)) confirmPendingWall();
  if(pendingArtworkId && !(exceptType === 'artwork' && pendingArtworkId === exceptId)) confirmPendingArtwork();
  if(pendingFloorTileId && !(exceptType === 'floorTile' && pendingFloorTileId === exceptId)) confirmPendingFloorTile();
  if(pendingWaterBodyId && !(exceptType === 'waterBody' && pendingWaterBodyId === exceptId)) confirmPendingWaterBody();
}

function startCandidateFollow(candidate){
  if(!candidate) return false;
  if(candidate.type === 'sinTowerStone') return startSinTowerStoneCarry(candidate.id);
  if(candidate.type === 'artwork'){
    const art = STATE.artworks.find(a=>a.id===candidate.id);
    if(!art || !artworkMeshes[art.id]) return false;
    confirmOtherPendingObjects('artwork', art.id);
    pushUndoState('follow artwork');
    selectedArtworkId = art.id;
    selectedArtworkActive = true;
    selectedWallId = null;
    selectedRoomWallKey = null;
    selectedFloorTileId = null;
    art.position = art.position || {x:0,y:safeFinite(art.y,2.2),z:0};
    art.rotation = art.rotation || {x:0,y:0,z:0};
    art.manualRotation = true;
    art.isDraft = true;
    pendingArtworkId = art.id;
    artworkFollowPlayer = true;
    detachWallRotationControls();
    refreshWallSelectionVisuals();
    refreshArtworkSelectionVisuals();
    syncArtEditor();
    setStatus('作品已進入跟隨模式。移動角色定位，按 Enter 後恢復不透明並固定。');
    return true;
  }
  if(candidate.type === 'customWall'){
    const w = STATE.customWalls.find(item=>item.id===candidate.id);
    if(!w || !customWallMeshes[w.id]) return false;
    confirmOtherPendingObjects('customWall', w.id);
    pushUndoState('follow wall');
    selectedWallId = w.id;
    selectedRoomWallKey = null;
    selectedFloorTileId = null;
    selectedArtworkActive = false;
    selectedReferenceArchitectureActive = false;
    selectedLightObjectActive = false;
    w.isDraft = true;
    w.manualRotation = true;
    pendingWallId = w.id;
    wallFollowPlayer = true;
    wallScaleMode = false;
    detachWallRotationControls();
    refreshWallSelectionVisuals();
    syncWallEditor();
    setStatus('牆面已進入跟隨模式。移動角色定位，按 Enter 後恢復不透明並固定。');
    return true;
  }
  if(candidate.type === 'floorTile'){
    const tile = (STATE.floorTiles || []).find(t=>t.id===candidate.id);
    if(!tile || !floorTileMeshes[tile.id]) return false;
    confirmOtherPendingObjects('floorTile', tile.id);
    pushUndoState('follow floor tile');
    selectedFloorTileId = tile.id;
    selectedWallId = null;
    selectedRoomWallKey = null;
    selectedArtworkActive = false;
    selectedReferenceArchitectureActive = false;
    selectedLightObjectActive = false;
    tile.isDraft = true;
    pendingFloorTileId = tile.id;
    floorTileFollowPlayer = true;
    detachWallRotationControls();
    refreshWallSelectionVisuals();
    syncObjectEditor();
    setStatus('地板塊已進入跟隨模式。移動角色定位，按 Enter 後恢復不透明並固定。');
    return true;
  }
  if(candidate.type === 'waterBody'){
    const body = (STATE.waterBodies || []).find(w=>w.id===candidate.id);
    if(!body || !waterBodyMeshes[body.id]) return false;
    confirmOtherPendingObjects('waterBody', body.id);
    pushUndoState('follow water body');
    selectedWaterBodyId = body.id;
    selectedWallId = null;
    selectedRoomWallKey = null;
    selectedFloorTileId = null;
    selectedArtworkActive = false;
    selectedReferenceArchitectureActive = false;
    selectedLightObjectActive = false;
    body.isDraft = true;
    pendingWaterBodyId = body.id;
    waterBodyFollowPlayer = true;
    detachWallRotationControls();
    refreshWaterSelectionVisuals();
    syncWaterSelect();
    syncWaterEditor();
    syncObjectEditor();
    renderObjectPanel();
    setStatus('水體已進入跟隨模式。移動角色定位，按 Enter 後恢復不透明並固定。');
    return true;
  }
  if(candidate.type === 'light'){
    selectLightObject(candidate.id);
    return true;
  }
  if(candidate.type === 'referenceArchitecture'){
    selectReferenceArchitecture();
    return true;
  }
  if(candidate.type === 'roomSurface'){
    setStatus('原始牆面／地板／天花板屬於空間基底，不進入跟隨模式；可用右側尺寸欄或新增物件調整。');
    return true;
  }
  return false;
}

function applySelectableCandidate(candidate){
  if(!candidate) return false;
  if(candidate.type === 'sinTowerStone'){
    selectSinTowerEditorObject('stone', candidate.id, 'stones');
    setStatus('已選取石塊。可在石塊分頁調整尺寸、位置、旋轉、形狀與材質；再次點選同一石塊或按「角色攜帶」即可移動。');
    return true;
  }
  if(candidate.type === 'artwork') return selectArtworkById(candidate.id);
  if(candidate.type === 'floorTile'){
    selectFloorTile(candidate.id);
    setStatus('已選取地板塊。右側可輸入尺寸；Delete 可刪除。');
    return true;
  }
  if(candidate.type === 'customWall'){
    selectCustomWall(candidate.id);
    setStatus(`已選取牆壁：${STATE.customWalls.find(w=>w.id===selectedWallId)?.title || selectedWallId}。右側可輸入尺寸；Shift+A 調整大小；Shift+T 旋轉；Delete 刪除。`);
    return true;
  }
  if(candidate.type === 'waterBody'){
    selectWaterBody(candidate.id);
    setStatus('已選取水體。右側可調整容器形狀、長寬高、水色、水位、晃動與濺水強度；Delete 可刪除。');
    return true;
  }
  if(candidate.type === 'roomSurface'){
    selectRoomWall(candidate.id);
    const canDelete = DELETABLE_SURFACE_KEYS.includes(selectedRoomWallKey) ? '；Delete 可刪除此面' : '';
    setStatus(`已選取：${SURFACE_LABELS[selectedRoomWallKey]}。右側可輸入尺寸${canDelete}。`);
    return true;
  }
  if(candidate.type === 'referenceArchitecture') return selectReferenceArchitecture();
  if(candidate.type === 'light') return selectLightObject(candidate.id);
  return false;
}

function pickSelectableFromPointer(event){
  if(isPlayCursorDisabled()) return false;
  const raycaster = selectableRaycasterFromPointer(event);
  const hits = raycaster.intersectObjects(selectableObjectsForRaycast(), true);
  const bestByTarget = new Map();
  for(const hit of hits){
    const candidate = selectableCandidateFromHit(hit);
    if(!candidate) continue;
    const existing = bestByTarget.get(candidate.key);
    if(!existing || candidate.distance < existing.distance) bestByTarget.set(candidate.key, candidate);
  }
  const candidates = [...bestByTarget.values()].sort((a,b)=>a.distance - b.distance);
  if(!candidates.length) return false;

  // 作品通常緊貼在牆面或凹凸表面上；單純按距離排序時，牆面 shell 可能因浮點或凹凸凸點
  // 比作品平面早一點被射線命中，造成「點到作品卻選到後方牆」。
  // 先找出最前方命中點，再在極近距離內以作品優先，仍保留真正遮擋物件的距離判斷。
  const nearest = candidates[0].distance;
  const near = candidates.filter(c=>c.distance <= nearest + 0.35);
  near.sort((a,b)=>a.priority - b.priority || a.distance - b.distance);
  const chosen = near[0];
  if(cursorFreeMode && !pointerLocked && !fallbackMouseLook && currentSelectedCandidateKey() === chosen.key){
    return startCandidateFollow(chosen);
  }
  return applySelectableCandidate(chosen);
}

function pickWallFromPointer(event){
  if(isPlayCursorDisabled()) return false;
  const raycaster = selectableRaycasterFromPointer(event);
  const objects = [
    ...Object.values(groundReliefMeshes).filter(Boolean),
    ...Object.values(floorTileMeshes).filter(Boolean),
    ...Object.values(customWallMeshes).filter(Boolean),
    ...SURFACE_KEYS.map(k=>surfaces[k]).filter(Boolean)
  ];
  const hits = raycaster.intersectObjects(objects, true);
  const candidates = [];
  for(const hit of hits){
    const candidate = selectableCandidateFromHit(hit);
    if(candidate && candidate.type !== 'artwork') candidates.push(candidate);
  }
  candidates.sort((a,b)=>a.distance - b.distance || a.priority - b.priority);
  return applySelectableCandidate(candidates[0]);
}

function pickArtworkFromPointer(event){
  if(isPlayCursorDisabled()) return false;
  const raycaster = selectableRaycasterFromPointer(event);
  const hits = raycaster.intersectObjects(artworkGroup.children, true);
  for(const hit of hits){
    const candidate = selectableCandidateFromHit(hit);
    if(candidate?.type === 'artwork') return selectArtworkById(candidate.id);
  }
  return false;
}



function syncSinTowerStoneMaterialUi(){
  const activeScene = getSinTowerActiveScene();
  const selected = SIN_TOWER_EDITOR.selectedObjectType === 'stone'
    ? getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId, 'stone')
    : null;
  const setMaterialUi = (stateId, previewId, src, filename, emptyText)=>{
    const state = $(stateId);
    const preview = $(previewId);
    if(state) state.textContent = src ? `已載入：${filename || '材質圖片'}` : emptyText;
    if(preview){
      if(src){
        preview.src = src;
        preview.classList.add('ready');
      }else{
        preview.removeAttribute('src');
        preview.classList.remove('ready');
      }
    }
  };
  setMaterialUi(
    'sinStoneSharedTextureState',
    'sinStoneSharedTexturePreview',
    activeScene?.sharedStoneTextureDataUrl || null,
    activeScene?.sharedStoneTextureName,
    '尚未載入目前場景的共用材質'
  );
  setMaterialUi(
    'sinStoneTextureState',
    'sinStoneTexturePreview',
    selected?.textureDataUrl || null,
    selected?.textureName,
    selected ? '尚未載入選取構件的個別材質' : '請先選取石塊'
  );
  const picked = getSinTowerEditorObjectById(sinTowerStonePickMode.selectedId, 'stone');
  setMaterialUi(
    'sinPlayStoneTextureState',
    'sinPlayStoneTexturePreview',
    picked?.textureDataUrl || null,
    picked?.textureName,
    picked ? '尚未載入此石塊的個別材質' : '尚未選取石頭'
  );
}

function syncSinTowerStonePickPanel(){
  const selected = getSinTowerEditorObjectById(sinTowerStonePickMode.selectedId, 'stone');
  const name = $('sinStonePickSelected');
  const input = $('sinPlayStoneTexture');
  if(name) name.textContent = selected ? `已選取：${selected.title || '石塊'}（ID：${selected.id}）` : '尚未選取石頭';
  if(input) input.disabled = !selected;
  syncSinTowerStoneMaterialUi();
}

function pickSinTowerStoneFromPointer(event){
  if(!sinTowerStonePickMode.active || !event || event.button !== 0) return false;
  const raycaster = selectableRaycasterFromPointer(event);
  const objects = sinTowerEditorSceneRoot
    ? [sinTowerEditorSceneRoot]
    : [...sinTowerEditorRuntime.stones.values()].map(rec=>rec?.mesh).filter(Boolean);
  const hits = raycaster.intersectObjects(objects, true);
  for(const hit of hits){
    const id = findUserDataValueInHierarchy(hit.object, 'sinTowerEditorId', scene);
    if(!id || !getSinTowerEditorObjectById(id, 'stone')) continue;
    sinTowerStonePickMode.selectedId = id;
    SIN_TOWER_EDITOR.selectedObjectType = 'stone';
    SIN_TOWER_EDITOR.selectedObjectId = id;
    syncSinTowerStonePickPanel();
    syncSinProFields();
    setStatus(`已選取石頭：${getSinTowerEditorObjectById(id, 'stone')?.title || id}。右側可匯入個別材質。`);
    return true;
  }
  setStatus(`沒有點到石頭（目前場景可選 ${sinTowerEditorRuntime.stones.size} 塊）。請把游標移到石頭表面再點擊。`);
  return false;
}

function setSinTowerStonePickMode(active){
  if(active){
    if(!isPlayMode()){
      setStatus('請先進入遊玩模式，再按 Shift+0 開啟石頭選取。');
      return false;
    }
    sinTowerStonePickMode.active = true;
    sinTowerStonePickMode.selectedId = null;
    desiredPointerLocked = false;
    cursorFreeMode = true;
    pointerLocked = false;
    fallbackMouseLook = false;
    ctrlViewDrag = false;
    try{ if(document.pointerLockElement) document.exitPointerLock?.(); }catch{}
    document.body.classList.add('sin-stone-pick-mode');
    updateCursorVisibility();
    syncSinTowerStonePickPanel();
    setStatus(`石頭選取模式已開啟，目前場景有 ${sinTowerEditorRuntime.stones.size} 塊可選石頭。點擊石頭後，右側可匯入個別材質；按 Shift+0 或 Esc 返回遊玩。`);
    return true;
  }
  sinTowerStonePickMode.active = false;
  sinTowerStonePickMode.selectedId = null;
  document.body.classList.remove('sin-stone-pick-mode');
  desiredPointerLocked = true;
  cursorFreeMode = false;
  pointerLocked = hasActivePointerLock();
  fallbackMouseLook = !pointerLocked && !IS_TOUCH_DEVICE;
  updateCursorVisibility();
  syncSinTowerStonePickPanel();
  return true;
}

function toggleSinTowerStonePickMode(){
  return setSinTowerStonePickMode(!sinTowerStonePickMode.active);
}

function sinTowerStonePickModeIsActive(){ return !!sinTowerStonePickMode.active; }

function sandPileEnabled(){ return !!$('sandPileEnabled')?.checked; }
function getSandPileUiSettings(){ return {mode:$('sandPileMode')?.value==='lower'?'lower':'raise', radius:clamp(safeFinite($('sandPileRadius')?.value,1.2),.15,12), strength:clamp(safeFinite($('sandPileStrength')?.value,.38),.01,1), maxHeight:clamp(safeFinite($('sandPileMaxHeight')?.value,2.2),.05,6)}; }
function sandPileSignedHeight(settings, handleHeight=null){ const s=settings||getSandPileUiSettings(); const mag=handleHeight===null ? s.strength*.48 : Math.abs(handleHeight); return (s.mode==='lower'?-1:1)*clamp(mag,.01,s.maxHeight); }
function selectedSandMaterialTarget(){ const target=getSelectedFloorPhysicsTarget?.(); if(target && sandEnabledForMaterial(target.cfg)) return target; return null; }
function sandTargetsForRaycast(){ return Object.values(sandTerrainMeshes||{}).filter(m=>m && m.visible!==false && m.parent); }
function sandInfoFromMesh(mesh, point){
  if(!mesh || !point) return null;
  const local=mesh.worldToLocal(point.clone());
  const w=safeFinite(mesh.userData.sandWidth,1), d=safeFinite(mesh.userData.sandDepth,1);
  let cfg=null,label='沙地',key='surface:floor';
  if(mesh.userData.floorTileId){ const tile=(STATE.floorTiles||[]).find(t=>t.id===mesh.userData.floorTileId); cfg=tile?.material; label=`地板塊｜${tile?.title || mesh.userData.floorTileId}`; key=`floorTile:${mesh.userData.floorTileId}`; }
  else { const surfaceKey=mesh.userData.surfaceKey || 'floor'; cfg=STATE.surfaces?.[surfaceKey]; label=`原始面｜${SURFACE_LABELS[surfaceKey] || '地板'}`; key=`surface:${surfaceKey}`; }
  if(!cfg || !sandEnabledForMaterial(cfg)) return null;
  return {mesh,key,cfg,label,localX:local.x,localZ:local.z,width:w,depth:d,worldPoint:point.clone(),localY:local.y};
}
function findSandPileTarget(pointerEvent=null,useCenter=false){
  if(!scene || !camera) return null;
  const raycaster=chiselRaycasterFromPointer(pointerEvent,useCenter);
  const hits=raycaster.intersectObjects(sandTargetsForRaycast(),false);
  for(const hit of hits){ const info=sandInfoFromMesh(hit.object, hit.point); if(info) return info; }
  return null;
}
function disposeSandPilePreview(){ if(!sandPilePreviewGroup) return; scene?.remove(sandPilePreviewGroup); disposeObjectTree(sandPilePreviewGroup); sandPilePreviewGroup=null; }
function ensureSandPilePreview(){
  if(sandPilePreviewGroup) return sandPilePreviewGroup;
  const group=new THREE.Group(); group.name='sand-pile-preview';
  const ringMat=new THREE.MeshBasicMaterial({color:0xffdc7a,transparent:true,opacity:.9,depthWrite:false,side:THREE.DoubleSide});
  const ring=new THREE.Mesh(new THREE.RingGeometry(.98,1.03,96),ringMat); ring.rotation.x=-Math.PI/2; ring.name='sand-pile-radius-ring'; group.add(ring);
  const handleMat=new THREE.MeshBasicMaterial({color:0xfff0b0,transparent:true,opacity:.94,depthWrite:false});
  const line=new THREE.Mesh(new THREE.CylinderGeometry(.018,.018,1,10),handleMat); line.name='sand-pile-height-line'; line.position.y=.5; line.visible=false; group.add(line);
  const knob=new THREE.Mesh(new THREE.SphereGeometry(.09,16,10),handleMat.clone()); knob.name='sand-pile-height-knob'; knob.visible=false; group.add(knob);
  const cone=new THREE.Mesh(new THREE.ConeGeometry(.075,.22,16),handleMat.clone()); cone.name='sand-pile-height-arrow'; cone.visible=false; group.add(cone);
  scene.add(group); sandPilePreviewGroup=group; return group;
}
function setSandPileHandleVisible(visible,height=0){
  const group=ensureSandPilePreview(); const h=Math.max(.05,Math.abs(height));
  const line=group.getObjectByName('sand-pile-height-line'), knob=group.getObjectByName('sand-pile-height-knob'), cone=group.getObjectByName('sand-pile-height-arrow');
  for(const obj of [line,knob,cone]) if(obj) obj.visible=!!visible;
  if(line){ line.scale.y=h; line.position.y=h/2; }
  if(knob) knob.position.y=h;
  if(cone){ cone.position.y=h+.16; cone.rotation.x=0; }
}
function updateSandPilePreview(pointerEvent=null){
  if(!sandPileEnabled()){ disposeSandPilePreview(); sandPilePreviewInfo=null; if($('sandPileTargetInfo')) $('sandPileTargetInfo').value='堆疊模式未啟用'; return null; }
  const info=findSandPileTarget(pointerEvent,!pointerEvent);
  if(!info){ if(sandPilePreviewGroup) sandPilePreviewGroup.visible=false; sandPilePreviewInfo=null; if($('sandPileTargetInfo')) $('sandPileTargetInfo').value='尚未命中沙地'; return null; }
  const settings=getSandPileUiSettings(); const group=ensureSandPilePreview(); group.visible=true;
  const localHeight=sandHeightLocal(info.localX,info.localZ,info.width,info.depth,ensureSandConfigOnMaterial(info.cfg));
  group.position.set(info.worldPoint.x,info.mesh.position.y+localHeight+.035,info.worldPoint.z);
  const ring=group.getObjectByName('sand-pile-radius-ring'); if(ring) ring.scale.set(settings.radius,settings.radius,settings.radius);
  if(!sandPilePointerState?.handleActive) setSandPileHandleVisible(false);
  sandPilePreviewInfo=info; if($('sandPileTargetInfo')) $('sandPileTargetInfo').value=info.label; return info;
}
function rebuildSandTargetFromInfo(info){ if(!info) return; if(info.key?.startsWith('floorTile:')) rebuildFloorTiles(); else buildRoom(); refreshWallSelectionVisuals(); renderObjectPanel(); }
function applySandPileAtInfo(info,heightOverride=null){
  if(!info || !info.cfg) return false;
  const sand=ensureSandConfigOnMaterial(info.cfg), settings=getSandPileUiSettings();
  const h=sandPileSignedHeight(settings,heightOverride);
  pushUndoState('sand pile');
  sand.deforms=sanitizeSandDeforms([...(sand.deforms||[]),{x:info.localX,z:info.localZ,radius:settings.radius,height:h,falloff:settings.mode==='lower'?'rim':'smooth',seed:performance.now()%99991}]);
  info.cfg.sand=sand;
  rebuildSandTargetFromInfo(info); scheduleSave();
  setStatus(`${settings.mode==='lower'?'已下陷沙地':'已抬高沙丘'}：${info.label}｜高度 ${h.toFixed(2)}｜半徑 ${settings.radius.toFixed(2)}`);
  return true;
}
function sandPileFromPointer(e=null,useCenter=false){ const info=findSandPileTarget(e,useCenter); if(!info){ setStatus('沒有命中沙地。請先把主地板或地板塊的物理材質切換為沙地。'); return false; } return applySandPileAtInfo(info,null); }
function sandPileAtPreviewOrView(){ const info=sandPilePreviewInfo || updateSandPilePreview() || findSandPileTarget(null,true); if(!info){ setStatus('沒有可堆疊的沙地預覽位置。'); return false; } return applySandPileAtInfo(info,null); }
function beginSandPileLongPress(e,info){
  clearTimeout(sandPileLongPressTimer); sandPileHeightValue=0;
  sandPilePointerState={pointerId:e.pointerId,startX:e.clientX,startY:e.clientY,lastX:e.clientX,lastY:e.clientY,info,handleActive:false};
  sandPileLongPressTimer=setTimeout(()=>{ if(!sandPilePointerState || sandPilePointerState.pointerId!==e.pointerId) return; sandPilePointerState.handleActive=true; sandPileHeightValue=Math.max(.06,getSandPileUiSettings().strength*.48); setSandPileHandleVisible(true,sandPileHeightValue); setSandStackScreenOverlayVisible(true,sandPilePointerState.info,sandPileHeightValue); setStatus('堆疊拉桿已啟用。向上拖曳決定沙丘高度，放開滑鼠寫入沙面。'); }, SAND_PILE_LONG_PRESS_MS);
}
function startSandPilePointer(e){
  if(!sandPileEnabled() || e.button!==0) return false;
  const info=updateSandPilePreview(e) || findSandPileTarget(e,false);
  if(!info){ setStatus('沒有命中沙地。'); return false; }
  beginSandPileLongPress(e,info);
  try{ $('canvas').setPointerCapture?.(e.pointerId); }catch(err){}
  return true;
}
function updateSandPilePointerDrag(e){
  if(!sandPilePointerState || sandPilePointerState.pointerId!==e.pointerId) return false;
  sandPilePointerState.lastX=e.clientX; sandPilePointerState.lastY=e.clientY;
  if(sandPilePointerState.handleActive){ const settings=getSandPileUiSettings(); const dy=sandPilePointerState.startY-e.clientY; sandPileHeightValue=clamp(dy*.018,.02,settings.maxHeight); setSandPileHandleVisible(true,sandPileHeightValue); setSandStackScreenOverlayVisible(true,sandPilePointerState.info,sandPileHeightValue); if($('sandPileTargetInfo')) $('sandPileTargetInfo').value=`${sandPilePointerState.info.label}｜拉高 ${sandPileHeightValue.toFixed(2)}`; }
  else updateSandPilePreview(e);
  return true;
}
function finishSandPilePointer(e){
  if(!sandPilePointerState || sandPilePointerState.pointerId!==e.pointerId) return false;
  clearTimeout(sandPileLongPressTimer); const state=sandPilePointerState; sandPilePointerState=null;
  try{ $('canvas').releasePointerCapture?.(e.pointerId); }catch(err){}
  applySandPileAtInfo(state.info, state.handleActive ? sandPileHeightValue : null);
  setSandPileHandleVisible(false); setSandStackScreenOverlayVisible(false); updateSandPilePreview({clientX:e.clientX,clientY:e.clientY}); return true;
}
function cancelSandPilePointer(e){ clearTimeout(sandPileLongPressTimer); sandPilePointerState=null; setSandPileHandleVisible(false); setSandStackScreenOverlayVisible(false); }
function undoLastSandPile(){
  const target=selectedSandMaterialTarget();
  if(!target){ setStatus('請先選取一個沙地地板或地板塊。'); return; }
  const sand=ensureSandConfigOnMaterial(target.cfg);
  if(!sand.deforms?.length){ setStatus('目前沙地沒有堆疊紀錄。'); return; }
  pushUndoState('undo sand pile');
  sand.deforms.pop();
  target.cfg.sand=sand;
  rebuildSelectedMaterialTarget(target);
  scheduleSave();
  setStatus(`已復原上一筆沙地堆疊：${target.label}`);
}
function clearCurrentSandPiles(){
  const target=selectedSandMaterialTarget();
  if(!target){ setStatus('請先選取一個沙地地板或地板塊。'); return; }
  const sand=ensureSandConfigOnMaterial(target.cfg);
  pushUndoState('clear sand piles');
  sand.deforms=[];
  target.cfg.sand=sand;
  rebuildSelectedMaterialTarget(target);
  scheduleSave();
  setStatus(`已清除沙地堆疊資料：${target.label}`);
}


function sandSelectedTargetKey(target=null){
  const t = target || getSelectedFloorPhysicsTarget?.();
  if(!t) return null;
  if(t.kind === 'surface' && t.key === 'floor') return 'surface:floor';
  if(t.kind === 'floorTile' && selectedFloorTileId) return `floorTile:${selectedFloorTileId}`;
  return null;
}
function sandMeshForTargetKey(key){
  return key ? (sandTerrainMeshes?.[key] || groundReliefMeshes?.[key] || null) : null;
}
function ensureSelectedFloorIsSandForPile(){
  const target = getSelectedFloorPhysicsTarget?.();
  if(!target){ setStatus('堆疊工具需要先選取主地板或地板塊。'); return null; }
  const sand = ensureSandConfigOnMaterial(target.cfg);
  const colorFromUi = validColor($('sandColor')?.value) ? $('sandColor').value : sand.color;
  sand.enabled = true;
  sand.color = validColor(colorFromUi) ? colorFromUi : DEFAULT_SAND_CONFIG.color;
  sand.grain = clamp(safeFinite($('sandGrain')?.value, sand.grain), 0, 1);
  sand.reaction = clamp(safeFinite($('sandReaction')?.value, sand.reaction), 0, 1);
  target.cfg.sand = sand;
  target.cfg.color = sand.color;
  target.cfg.roughness = .96;
  target.cfg.metalness = 0;
  target.cfg.relief = normalizeReliefConfig({preset:'flat', amount:0, variation:.5, seed:104729});
  rebuildSelectedMaterialTarget(target);
  syncFloorPhysicsEditor();
  syncGroundReliefEditor();
  scheduleSave();
  return target;
}
function sandInfoForSelectedFloorCenter(autoConvert=true){
  let target = getSelectedFloorPhysicsTarget?.();
  if(!target) return null;
  if(autoConvert || !sandEnabledForMaterial(target.cfg)) target = ensureSelectedFloorIsSandForPile();
  if(!target || !sandEnabledForMaterial(target.cfg)) return null;
  const key = sandSelectedTargetKey(target);
  let mesh = sandMeshForTargetKey(key);
  if(!mesh){ rebuildSelectedMaterialTarget(target); mesh = sandMeshForTargetKey(key); }
  if(!mesh) return null;
  const w = safeFinite(mesh.userData.sandWidth, 1), d = safeFinite(mesh.userData.sandDepth, 1);
  const localX = 0, localZ = 0;
  const localY = sandHeightLocal(localX, localZ, w, d, ensureSandConfigOnMaterial(target.cfg));
  const worldPoint = mesh.localToWorld(new THREE.Vector3(localX, localY, localZ));
  return {mesh, key, cfg:target.cfg, label:target.label, localX, localZ, width:w, depth:d, worldPoint, localY};
}
function showSandPilePreviewInfo(info, handleVisible=false, handleHeight=0){
  if(!info) return null;
  const settings = getSandPileUiSettings();
  const group = ensureSandPilePreview();
  group.visible = true;
  const sand = ensureSandConfigOnMaterial(info.cfg);
  const localHeight = sandHeightLocal(info.localX, info.localZ, info.width, info.depth, sand);
  const worldAtLocal = info.mesh.localToWorld(new THREE.Vector3(info.localX, localHeight, info.localZ));
  group.position.copy(worldAtLocal).add(new THREE.Vector3(0, .055, 0));
  const ring = group.getObjectByName('sand-pile-radius-ring');
  if(ring){
    ring.visible = true;
    ring.scale.set(settings.radius, settings.radius, settings.radius);
    ring.material.opacity = .98;
  }
  setSandPileHandleVisible(!!handleVisible, handleHeight);
  setSandStackScreenOverlayVisible(!!handleVisible, info, handleHeight);
  sandPilePreviewInfo = info;
  if($('sandPileTargetInfo')) $('sandPileTargetInfo').value = `${info.label}${handleVisible ? `｜拉高 ${Math.abs(handleHeight).toFixed(2)}` : ''}`;
  return info;
}
function sandStackWorldPointToScreen(info){
  try{
    const p = (info?.worldPoint || info?.mesh?.localToWorld?.(new THREE.Vector3(info?.localX||0, info?.localY||0, info?.localZ||0)) || new THREE.Vector3()).clone();
    p.project(camera);
    if(!Number.isFinite(p.x) || !Number.isFinite(p.y) || p.z < -1 || p.z > 1) return null;
    const rect = renderer.domElement.getBoundingClientRect();
    return {x:rect.left + (p.x + 1) * rect.width / 2, y:rect.top + (-p.y + 1) * rect.height / 2};
  }catch(err){ return null; }
}
function ensureSandStackScreenOverlay(){
  let el = document.getElementById('sandStackScreenOverlay');
  if(!el){
    el = document.createElement('div');
    el.id = 'sandStackScreenOverlay';
    el.innerHTML = '<div class="sand-stack-ring"></div><div class="sand-stack-cross"></div><div class="sand-stack-handle"></div><div class="sand-stack-knob"></div><div class="sand-stack-label">SHIFT+A 堆疊拉桿</div>';
    document.body.appendChild(el);
  }
  return el;
}
function setSandStackScreenOverlayVisible(visible, info=null, height=0){
  const el = ensureSandStackScreenOverlay();
  if(!visible){ el.style.display='none'; return; }
  sandStackOverlayLastInfo = info || sandStackOverlayLastInfo;
  const settings = getSandPileUiSettings();
  const pos = sandStackWorldPointToScreen(info || sandStackOverlayLastInfo) || {x:innerWidth/2, y:innerHeight/2};
  const ringPx = clamp(settings.radius * 78, 70, Math.min(innerWidth, innerHeight) * .46);
  const hPx = clamp((Math.abs(height) / Math.max(.01, settings.maxHeight)) * 190 + 46, 46, 236);
  el.style.display='block';
  el.style.left = `${pos.x}px`;
  el.style.top = `${pos.y}px`;
  const ring = el.querySelector('.sand-stack-ring');
  const handle = el.querySelector('.sand-stack-handle');
  const knob = el.querySelector('.sand-stack-knob');
  const label = el.querySelector('.sand-stack-label');
  if(ring){ ring.style.width = `${ringPx}px`; ring.style.height = `${ringPx}px`; }
  if(handle) handle.style.height = `${hPx}px`;
  if(knob) knob.style.bottom = `calc(50% + ${hPx}px)`;
  if(label) label.textContent = `SHIFT+A 沙丘高度 ${Math.abs(height).toFixed(2)}｜Enter 套用｜Esc 取消`;
}
function startSandPileHandleByShiftA(){
  if(!sandPileEnabled()) return false;
  const info = sandInfoForSelectedFloorCenter(true);
  if(!info){ setStatus('請先選取主地板或地板塊，再開啟堆疊模式。'); return true; }
  const settings = getSandPileUiSettings();
  const initialHeight = Math.max(.08, settings.strength * .65);
  sandPileHandleMode = {
    info,
    startY: lastChiselPointer?.clientY ?? Math.round(innerHeight * .52),
    currentHeight: initialHeight,
    active: true
  };
  showSandPilePreviewInfo(info, true, initialHeight);
  setStatus('SHIFT+A 堆疊拉桿已啟用。上下移動滑鼠調整高度；Enter 寫入沙丘並隱藏拉桿；Esc 取消。');
  return true;
}
function updateSandPileHandleModeFromPointer(e){
  if(!sandPileHandleMode?.active) return false;
  const settings = getSandPileUiSettings();
  const dy = sandPileHandleMode.startY - e.clientY;
  sandPileHandleMode.currentHeight = clamp(Math.max(.04, dy * .018 + settings.strength * .65), .04, settings.maxHeight);
  showSandPilePreviewInfo(sandPileHandleMode.info, true, sandPileHandleMode.currentHeight);
  return true;
}
function commitSandPileHandleMode(){
  if(!sandPileHandleMode?.active) return false;
  const state = sandPileHandleMode;
  sandPileHandleMode = null;
  applySandPileAtInfo(state.info, state.currentHeight);
  setSandPileHandleVisible(false);
  setSandStackScreenOverlayVisible(false);
  if(sandPilePreviewGroup) sandPilePreviewGroup.visible = false;
  setStatus('已用 SHIFT+A 拉桿寫入沙丘高度。');
  return true;
}
function cancelSandPileHandleMode(){
  if(!sandPileHandleMode?.active) return false;
  sandPileHandleMode = null;
  setSandPileHandleVisible(false);
  setSandStackScreenOverlayVisible(false);
  if(sandPilePreviewGroup) sandPilePreviewGroup.visible = false;
  setStatus('已取消 SHIFT+A 沙地堆疊拉桿。');
  return true;
}

function chiselEnabled(){
  return !!$('chiselEnabled')?.checked;
}

function getChiselUiSettings(){
  const shape = $('chiselShape')?.value || 'rect';
  const width = clamp(safeFinite($('chiselWidth')?.value, 1.6), .1, 20);
  const height = clamp(safeFinite($('chiselHeight')?.value, 2.0), .1, 20);
  const radius01 = clamp(safeFinite($('chiselRadius')?.value, .18), 0, 1);
  const bottom = clamp(safeFinite($('chiselBottom')?.value, 0), 0, 50);
  const depth = clamp(safeFinite($('chiselDepth')?.value, 2), .01, 20);
  return {shape, width, height, radius01, bottom, depth};
}

function syncChiselPanel(){
  const el = $('chiselTargetInfo');
  if(!el) return;
  if(!lastChiselTarget){ el.value = '尚未命中牆面'; return; }
  if(lastChiselTarget.type === 'reference') el.value = `參考圖建築｜${lastChiselTarget.panelName || ''}`;
  else if(lastChiselTarget.type === 'custom'){
    const w = (STATE.customWalls || []).find(item=>item.id === lastChiselTarget.wallId);
    el.value = `自建牆｜${w?.title || lastChiselTarget.wallId}`;
  }else el.value = '尚未命中牆面';
}

function chiselRaycasterFromPointer(event=null, center=false){
  const raycaster = new THREE.Raycaster();
  const ndc = center ? new THREE.Vector2(0,0) : pointerNDC(event);
  raycaster.setFromCamera(ndc, camera);
  raycaster.far = CHISEL_MAX_CAMERA_RAY_DISTANCE;
  raycaster.params.Mesh = raycaster.params.Mesh || {};
  return raycaster;
}

function chiselReachOrigin(){
  const y = Math.min(Math.max(safeFinite(player?.height,1.72) * .62, .9), 1.28);
  return player.position.clone().add(new THREE.Vector3(0,y,0));
}

function chiselHitReachStatus(hit){
  if(!hit?.point) return '鑿子沒有命中可切割的牆面。';
  const origin = chiselReachOrigin();
  const toHit = hit.point.clone().sub(origin);
  const dist = toHit.length();
  if(dist > CHISEL_MAX_PLAYER_DISTANCE){
    return `目標距離 ${dist.toFixed(2)} 超出鑿子有效範圍 ${CHISEL_MAX_PLAYER_DISTANCE.toFixed(2)}。鑿子只能作用在主角面前固定近距離。`;
  }
  const forward = getCameraForward3D();
  if(forward.lengthSq() > .0001 && toHit.clone().normalize().dot(forward) < -.08){
    return '目標不在主角目前視線前方，鑿子不會穿透到背後物件。';
  }
  return '';
}

function chiselTargetObjects(){
  const out = [];
  if(referenceArchitectureGroup && STATE?.referenceArchitecture?.enabled !== false && STATE?.referenceArchitecture?.visible !== false){
    for(const item of referenceCollisionItems){
      // Include solid boxes as blockers.  This prevents the ray from passing through a near pillar
      // and cutting a distant wall behind it.  Only wallPanel/customWall hits become cuttable targets.
      if((item?.type === 'referenceWallPanel' || item?.type === 'referenceBox') && item.mesh?.visible !== false) out.push(item.mesh);
    }
  }
  for(const [id, mesh] of Object.entries(customWallMeshes || {})){
    const wall = (STATE.customWalls || []).find(w=>w.id === id);
    if(!wall || isCurvedWall(wall) || wall.visible === false || wall.locked) continue;
    if(mesh?.visible !== false) out.push(mesh);
  }
  return out;
}

function localChiselInfoFromHit(hit){
  if(!hit?.object) return null;
  let obj = hit.object;
  while(obj && obj !== scene){
    const panelName = obj.userData?.referencePanelName;
    if(panelName && obj.userData?.referenceCollisionType === 'wallPanel'){
      obj.updateMatrixWorld(true);
      const local = hit.point.clone().applyMatrix4(new THREE.Matrix4().copy(obj.matrixWorld).invert());
      const width = Math.max(.02, safeFinite(obj.userData.referenceCollisionWidth, 1));
      const height = Math.max(.02, safeFinite(obj.userData.referenceCollisionHeight, 1));
      const camLocal = camera.position.clone().applyMatrix4(new THREE.Matrix4().copy(obj.matrixWorld).invert());
      const side = camLocal.z >= 0 ? 1 : -1;
      return {type:'reference', mesh:obj, panelName, localX:local.x, localY:local.y, width, height, thickness:safeFinite(obj.userData.referenceCollisionThickness,.38), side};
    }
    if(obj.userData?.referenceCollisionType === 'box'){
      const panelName = obj.userData?.referencePanelName || obj.name;
      const size = obj.userData?.referenceCollisionSize || {x:1,y:1,z:1};
      obj.updateMatrixWorld(true);
      const localRaw = hit.point.clone().applyMatrix4(new THREE.Matrix4().copy(obj.matrixWorld).invert());
      const baked = !!obj.userData?.referenceGeometryBaked;
      const local = baked ? localRaw : new THREE.Vector3(localRaw.x * size.x, localRaw.y * size.y, localRaw.z * size.z);
      const n = hit.face?.normal ? hit.face.normal.clone().normalize() : new THREE.Vector3(0,0,1);
      if(Math.abs(n.y) > Math.max(Math.abs(n.x), Math.abs(n.z))){
        return {type:'unsupported', reason:'目前命中的是柱子或樑的上／下表面。請對準側面鑿洞。'};
      }
      const axis = Math.abs(n.x) > Math.abs(n.z) ? 'x' : 'z';
      const side = axis === 'x' ? (n.x >= 0 ? 1 : -1) : (n.z >= 0 ? 1 : -1);
      const localX = axis === 'x' ? local.z : local.x;
      const width = axis === 'x' ? Math.max(.02, safeFinite(size.z,1)) : Math.max(.02, safeFinite(size.x,1));
      const height = Math.max(.02, safeFinite(size.y,1));
      const thickness = axis === 'x' ? Math.max(.02, safeFinite(size.x,1)) : Math.max(.02, safeFinite(size.z,1));
      return {type:'reference', targetType:'box', mesh:obj, panelName, localX, localY:local.y + height/2, width, height, thickness, side, axis};
    }
    const wallId = obj.userData?.wallId;
    if(wallId){
      const wall = (STATE.customWalls || []).find(w=>w.id === wallId);
      if(!wall || isCurvedWall(wall)) return {type:'unsupported', reason:'曲面牆暫不做布林切割。'};
      obj.updateMatrixWorld(true);
      const local = hit.point.clone().applyMatrix4(new THREE.Matrix4().copy(obj.matrixWorld).invert());
      const width = clamp(safeFinite(wall.size?.w,3), .5, 500);
      const height = clamp(safeFinite(wall.size?.h,ROOM.height), .5, 500);
      const localX = customWallHasChiselHoles(wall) ? local.x : local.x * width;
      const localY = customWallHasChiselHoles(wall) ? (local.y + height/2) : (local.y + .5) * height;
      const camLocal = camera.position.clone().applyMatrix4(new THREE.Matrix4().copy(obj.matrixWorld).invert());
      const side = camLocal.z >= 0 ? 1 : -1;
      return {type:'custom', mesh:obj, wall, wallId, localX, localY, width, height, thickness:clamp(safeFinite(wall.size?.t,.18), .02, 500), side};
    }
    obj = obj.parent;
  }
  return null;
}

function buildChiselHoleForTarget(info){
  const cfg = getChiselUiSettings();
  const width = Math.max(.05, cfg.width);
  const height = Math.max(.05, cfg.height);
  let bottom = safeFinite(info.localY, 0) - height / 2;
  if(cfg.shape === 'arch' && cfg.bottom > .001) bottom = cfg.bottom;
  const x = safeFinite(info.localX, 0);
  const type = chiselShapeToHoleType(cfg.shape);
  const hole = {
    id:uid('hole'),
    type,
    x,
    y:bottom,
    w:width,
    h:height,
    r: cfg.shape === 'rect' ? Math.max(.001, Math.min(width,height) * cfg.radius01 * .5) : cfg.radius01,
    depth: cfg.depth,
    side: safeFinite(info.side, 1) < 0 ? -1 : 1
  };
  if(info.targetType === 'box'){
    hole.targetType = 'box';
    hole.axis = info.axis === 'x' ? 'x' : 'z';
  }else{
    hole.targetType = 'wall';
    hole.axis = 'z';
  }
  if(type === 'rect' && hole.r > .015) hole.type = 'roundRect';
  return hole;
}

function applyChiselHole(info, hole){
  if(!info || !hole) return false;
  pushUndoState('chisel hole');
  if(info.type === 'reference'){
    STATE.referenceArchitecture = STATE.referenceArchitecture || {enabled:true, visible:true, locked:false, material:createReferenceArchitectureMaterial(), chiselHoles:[]};
    const holes = Array.isArray(STATE.referenceArchitecture.chiselHoles) ? STATE.referenceArchitecture.chiselHoles : [];
    holes.push({...hole, panelName:info.panelName});
    STATE.referenceArchitecture.chiselHoles = sanitizeChiselHoles(holes, true).slice(-240);
    lastChiselTarget = {type:'reference', panelName:info.panelName};
    buildReferenceArchitecture();
    applyObjectVisibilityLocks();
    renderObjectPanel();
  }else if(info.type === 'custom'){
    const wall = (STATE.customWalls || []).find(w=>w.id === info.wallId);
    if(!wall || isCurvedWall(wall)) return false;
    wall.chiselHoles = sanitizeChiselHoles([...(wall.chiselHoles || []), hole], false).slice(-120);
    lastChiselTarget = {type:'custom', wallId:wall.id};
    rebuildCustomWalls();
    refreshWallSelectionVisuals();
    renderObjectPanel();
  }else return false;
  syncChiselPanel();
  scheduleSave();
  setStatus(`已鑿出${chiselHoleLabel(hole)}：寬 ${hole.w.toFixed(2)}，高 ${hole.h.toFixed(2)}，深 ${safeFinite(hole.depth,0).toFixed(2)}。深度小於牆厚時建立實體內凹體積；深度大於牆厚時建立真正穿透洞口。`);
  return true;
}

function findChiselTarget(event=null, center=false){
  if(!chiselEnabled()) return null;
  const targets = chiselTargetObjects();
  if(!targets.length) return {status:'沒有可鑿洞的參考圖牆面、柱子、厚樑或自建直牆。'};
  const useCenter = !!center || (!event && (!lastChiselPointer || pointerLocked || fallbackMouseLook || !cursorFreeMode));
  const rayEvent = event || lastChiselPointer;
  const raycaster = chiselRaycasterFromPointer(rayEvent, useCenter);
  const hits = raycaster.intersectObjects(targets, true).filter(h=>h?.object && isVisibleInHierarchy(h.object) && !h.object.userData?.skipChiselTarget);
  for(const hit of hits){
    const reachStatus = chiselHitReachStatus(hit);
    if(reachStatus) return {status:reachStatus, unsupported:true};
    const info = localChiselInfoFromHit(hit);
    if(!info) continue;
    if(info.type === 'unsupported') return {status:info.reason || '此物件暫不支援鑿洞。', unsupported:true};
    const hole = buildChiselHoleForTarget(info);
    return {hit, info, hole};
  }
  return {status:'鑿子沒有命中近距離內可切割的牆面。請靠近牆面後再按 X 或點擊。'};
}

function hideChiselPreview(){
  chiselPreviewTarget = null;
  chiselPreviewKey = '';
  if(chiselPreviewMesh){
    scene?.remove(chiselPreviewMesh);
    chiselPreviewMesh.geometry?.dispose?.();
    if(Array.isArray(chiselPreviewMesh.material)) chiselPreviewMesh.material.forEach(m=>m.dispose?.());
    else chiselPreviewMesh.material?.dispose?.();
    chiselPreviewMesh = null;
  }
}

function updateChiselPreview(event=null){
  if(isPlayCursorDisabled()){
    hideChiselPreview();
    return;
  }
  if(!scene || !camera || !chiselEnabled()){
    hideChiselPreview();
    return;
  }
  const found = findChiselTarget(event, false);
  if(!found || !found.hit || !found.info || !found.hole){
    chiselPreviewTarget = null;
    if(found?.status && $('chiselTargetInfo')) $('chiselTargetInfo').value = found.status;
    hideChiselPreview();
    return;
  }
  const {hit, info, hole} = found;
  chiselPreviewTarget = {info, hole};
  lastChiselTarget = info.type === 'reference' ? {type:'reference', panelName:info.panelName} : {type:'custom', wallId:info.wallId};
  syncChiselPanel();
  const key = `${hole.type}|${hole.w.toFixed(3)}|${hole.h.toFixed(3)}|${safeFinite(hole.r,0).toFixed(3)}|${safeFinite(hole.depth,0).toFixed(3)}`;
  if(!chiselPreviewMesh || chiselPreviewKey !== key){
    hideChiselPreview();
    const geo = makeChiselPreviewGeometry(hole);
    const mat = new THREE.MeshBasicMaterial({
      color:0xd8c07f,
      transparent:true,
      opacity:.42,
      side:THREE.DoubleSide,
      depthTest:false,
      depthWrite:false,
      wireframe:false,
      toneMapped:false
    });
    chiselPreviewMesh = new THREE.Mesh(geo, mat);
    chiselPreviewMesh.name = 'chisel-cut-preview';
    chiselPreviewMesh.renderOrder = 999;
    scene.add(chiselPreviewMesh);
    chiselPreviewKey = key;
  }
  const obj = hit.object;
  obj.updateMatrixWorld(true);
  const localTangent = info.targetType === 'box' && info.axis === 'x' ? new THREE.Vector3(0,0,1) : new THREE.Vector3(1,0,0);
  const tangent = localTangent.transformDirection(obj.matrixWorld).normalize();
  const up = new THREE.Vector3(0,1,0).transformDirection(obj.matrixWorld).normalize();
  let normal = hit.face?.normal ? hit.face.normal.clone().transformDirection(obj.matrixWorld).normalize() : new THREE.Vector3().crossVectors(tangent, up).normalize();
  if(normal.dot(camera.position.clone().sub(hit.point)) < 0) normal.multiplyScalar(-1);
  const basis = new THREE.Matrix4().makeBasis(tangent, up, normal);
  chiselPreviewMesh.quaternion.setFromRotationMatrix(basis);
  chiselPreviewMesh.position.copy(hit.point).addScaledVector(normal, .035);
  const depthRatio = clamp(safeFinite(hole.depth,0) / Math.max(.001, safeFinite(info.thickness,.18)), 0, 1);
  chiselPreviewMesh.material.opacity = .24 + depthRatio * .28;
  chiselPreviewMesh.material.color.set(depthRatio >= .98 ? 0xd8c07f : 0x6fd0ff);
  chiselPreviewMesh.visible = true;
}

function chiselFromPointer(event=null, center=false){
  if(!center && isPlayCursorDisabled()) return false;
  if(!center && !chiselEnabled()) return false;
  const found = findChiselTarget(event, center);
  if(found?.status){ setStatus(found.status); return !!found.unsupported; }
  if(found?.info && found?.hole) return applyChiselHole(found.info, found.hole);
  setStatus('鑿子沒有命中可切割的牆面。請點擊參考圖建築牆面或自建直牆。');
  return false;
}

function chiselAtPreviewOrView(){
  if(!chiselEnabled()) return false;
  if(chiselPreviewTarget?.info && chiselPreviewTarget?.hole){
    return applyChiselHole(chiselPreviewTarget.info, chiselPreviewTarget.hole);
  }
  return chiselFromPointer(null, true);
}

function removeLastChiselHole(){
  if(lastChiselTarget?.type === 'reference'){
    const holes = Array.isArray(STATE.referenceArchitecture?.chiselHoles) ? STATE.referenceArchitecture.chiselHoles : [];
    for(let i=holes.length-1; i>=0; i--){
      if(holes[i]?.panelName === lastChiselTarget.panelName){
        pushUndoState('undo chisel hole');
        holes.splice(i,1);
        STATE.referenceArchitecture.chiselHoles = sanitizeChiselHoles(holes, true);
        buildReferenceArchitecture();
        scheduleSave();
        setStatus('已復原目前參考圖牆面的上一個鑿洞。');
        syncChiselPanel();
        return true;
      }
    }
  }
  if(lastChiselTarget?.type === 'custom'){
    const wall = (STATE.customWalls || []).find(w=>w.id === lastChiselTarget.wallId);
    if(wall?.chiselHoles?.length){
      pushUndoState('undo chisel hole');
      wall.chiselHoles.pop();
      wall.chiselHoles = sanitizeChiselHoles(wall.chiselHoles, false);
      rebuildCustomWalls();
      scheduleSave();
      setStatus('已復原目前自建牆的上一個鑿洞。');
      syncChiselPanel();
      return true;
    }
  }
  // Fallback: remove the newest reference hole, then newest custom-wall hole.
  const refHoles = STATE.referenceArchitecture?.chiselHoles;
  if(Array.isArray(refHoles) && refHoles.length){
    pushUndoState('undo chisel hole');
    const removed = refHoles.pop();
    STATE.referenceArchitecture.chiselHoles = sanitizeChiselHoles(refHoles, true);
    lastChiselTarget = removed?.panelName ? {type:'reference', panelName:removed.panelName} : null;
    buildReferenceArchitecture();
    scheduleSave();
    setStatus('已復原上一個參考圖建築鑿洞。');
    syncChiselPanel();
    return true;
  }
  for(let i=(STATE.customWalls||[]).length-1; i>=0; i--){
    const wall = STATE.customWalls[i];
    if(wall?.chiselHoles?.length){
      pushUndoState('undo chisel hole');
      wall.chiselHoles.pop();
      wall.chiselHoles = sanitizeChiselHoles(wall.chiselHoles, false);
      lastChiselTarget = {type:'custom', wallId:wall.id};
      rebuildCustomWalls();
      scheduleSave();
      setStatus('已復原上一個自建牆鑿洞。');
      syncChiselPanel();
      return true;
    }
  }
  setStatus('目前沒有可復原的鑿洞。');
  return false;
}

function clearChiselHolesForCurrentTarget(){
  const target = lastChiselTarget || (selectedWallId ? {type:'custom', wallId:selectedWallId} : (selectedReferenceArchitectureActive ? {type:'reference'} : null));
  if(!target){ setStatus('尚未選取或命中可清除的牆面。'); return false; }
  if(target.type === 'reference'){
    const panelName = target.panelName;
    const holes = Array.isArray(STATE.referenceArchitecture?.chiselHoles) ? STATE.referenceArchitecture.chiselHoles : [];
    const next = panelName ? holes.filter(h=>h.panelName !== panelName) : [];
    if(next.length === holes.length){ setStatus('目前參考圖牆面沒有鑿洞可清除。'); return false; }
    pushUndoState('clear chisel holes');
    STATE.referenceArchitecture.chiselHoles = sanitizeChiselHoles(next, true);
    buildReferenceArchitecture();
    scheduleSave();
    setStatus(panelName ? '已清除目前參考圖牆面的鑿洞。' : '已清除所有參考圖建築鑿洞。');
    syncChiselPanel();
    return true;
  }
  if(target.type === 'custom'){
    const wall = (STATE.customWalls || []).find(w=>w.id === target.wallId);
    if(!wall?.chiselHoles?.length){ setStatus('目前自建牆沒有鑿洞可清除。'); return false; }
    pushUndoState('clear chisel holes');
    wall.chiselHoles = [];
    rebuildCustomWalls();
    scheduleSave();
    setStatus('已清除目前自建牆的所有鑿洞。');
    syncChiselPanel();
    return true;
  }
  return false;
}

function resetPlayer(){
  if(SIN_TOWER_STAIRCASE.enabled){
    resetSinTowerPlayer();
    return;
  }
  player.position.set(0,0,5.8);
  playerVelocityY = 0;
  camYaw = 0;
  playerYaw = 0;
  resetSinTowerInfection();
}

function getPlayerJumpPower(){
  return clamp(safeFinite(STATE.player?.jumpPower,1), .1, 5);
}

function getSinTowerTotalStepCount(){
  const c=SIN_TOWER_STAIRCASE,manual=Math.round(safeFinite(c.totalSteps,0));
  if(manual>0)return clamp(manual,1,c.virtualCount||1000000);
  return c.infinite?0:Math.max(1,Math.floor(c.count||1));
}

function sinTowerEffectiveStepCount(){return getSinTowerTotalStepCount()||(SIN_TOWER_STAIRCASE.virtualCount||1000000);}

function sinTowerStairLength(){return sinTowerEffectiveStepCount()*SIN_TOWER_STAIRCASE.depth;}

function sinTowerStairEndZ(){const c=SIN_TOWER_STAIRCASE;return c.startZ+c.directionZ*sinTowerStairLength();}

function getSinTowerStairBounds(){
  if(!SIN_TOWER_STAIRCASE.enabled)return null;
  const c=SIN_TOWER_STAIRCASE,z0=c.startZ,z1=sinTowerStairEndZ();
  return {minX:c.startX-c.width/2-c.sideMargin,maxX:c.startX+c.width/2+c.sideMargin,minZ:Math.min(z0,z1)-c.floorExtra,maxZ:Math.max(z0,z1)+c.floorExtra};
}

function sinTowerStepIndexAtWorld(x,z){
  if(!SIN_TOWER_STAIRCASE.enabled)return -1;
  const c=SIN_TOWER_STAIRCASE;if(Math.abs(x-c.startX)>c.width/2+c.sideMargin)return -1;
  const along=(z-c.startZ)*c.directionZ;if(along<0)return -1;
  const idx=Math.floor(along/c.depth),total=getSinTowerTotalStepCount();
  if(total>0){if(idx>=total)return -1;return clamp(idx,0,total-1);}
  return Math.max(0,Math.min(idx,(c.virtualCount||1000000)-1));
}

function getSinTowerStairGroundYAtWorld(x,z){
  const idx = sinTowerStepIndexAtWorld(x,z);
  if(idx < 0) return null;
  return SIN_TOWER_STAIRCASE.baseY + (idx + 1) * SIN_TOWER_STAIRCASE.rise;
}

function resetSinTowerPlayer(){
  if(!SIN_TOWER_STAIRCASE.enabled) return;
  const c = SIN_TOWER_STAIRCASE;
  const z = c.startZ + c.directionZ * c.depth * .5;
  player.position.set(c.startX, c.baseY + c.rise, z);
  playerVelocityY = 0;
  camYaw = 0;
  camPitch = deg(-11);
  cameraDistance = 5.15 * Math.pow(1.12, 3);
  playerYaw = 0;
  sinTowerRunFinished = false;
  resetSinTowerInfection();
  resetSinTowerMonkHits();
  playerGroup?.position.copy(player.position);
}

function applySinTowerStaircaseSceneState(state){
  if(!SIN_TOWER_STAIRCASE.enabled) return state;
  const s = state || createDefaultState();
  const c = SIN_TOWER_STAIRCASE;
  const z0 = c.startZ;
  const z1 = sinTowerStairEndZ();
  const floorDepth = c.infinite ? 500 : Math.min(500, Math.abs(z1 - z0) + c.floorExtra * 2);
  const floorCenterZ = c.infinite ? (z0 + c.directionZ * floorDepth / 2) : ((z0 + z1) / 2);
  s.room = {width:Math.max(10, c.width + 6), depth:floorDepth, height:80, thickness:.12};
  s.backgroundColor = '#181512';
  s.skyTexture = SIN_TOWER_BUNDLED_STAIR_BACKGROUND;
  s.skyTintColor = '#ffffff';
  s.skyTintStrength = 0;
  s.hideFloorGrid = true;
  s.deletedSurfaces = ['front','back','left','right','ceiling'];
  s.referenceArchitecture = {enabled:false, visible:false, locked:true, material:createReferenceArchitectureMaterial(), chiselHoles:[]};
  s.customWalls = [];
  s.floorTiles = [];
  s.waterBodies = [];
  s.artworks = [];
  s.objectGroups = [];
  s.surfaceTransforms = {
    floor:{
      position:{x:c.startX, y:-.09, z:floorCenterZ},
      size:{x:c.width + 3.2, y:.12, z:floorDepth}
    }
  };
  s.surfaces = {...(s.surfaces || {})};
  s.surfaces.floor = {
    ...(s.surfaces.floor || {}),
    color:'#2f2a22', roughness:.96, metalness:0, texture:null, repeat:[8,80],
    relief:{preset:'cementRough', amount:.18, variation:.76, seed:23061993},
    sand:{...DEFAULT_SAND_CONFIG}, visible:true, locked:true
  };
  for(const key of ['front','back','left','right','ceiling']){
    s.surfaces[key] = {...(s.surfaces[key] || {}), color:'#050505', roughness:1, metalness:0, texture:null, repeat:[1,1], visible:false, locked:true};
  }
  s.atmosphere = {enabled:true, color:'#8b7658', intensity:.28, opacity:.18, layers:.58};
  s.screenFx = {enabled:true,preset:'monopixel',intensity:1,noise:.08,scanlines:0,chromatic:0,warp:0,glow:0,vignette:.08,saturation:0,contrast:1.18,brightness:1.04,blur:0,hue:0,monoPaper:'#f4d66f',monoInk:'#14263d',colorPlayer:false,colorTumor:false,colorTentacle:false,colorEye:false};
  s.player = {...(s.player || {}), modelYOffset:0.68, modelYawOffset:180, speed:c.autoRunSpeed, jumpPower:1, scale:1};
  s.lightSystem = {
    enabled:true,
    ambient:{color:'#c4aa82', intensity:1.18},
    hemisphere:{skyColor:'#9a886c', groundColor:'#3a3026', intensity:1.35},
    lights:[
      createLightState('directional',{id:'sin_tower_key_light',title:'斷罪塔｜上方斜光',color:'#ffe2a0',intensity:7.4,position:{x:-5,y:28,z:10},target:{x:0,y:12,z:-120},castShadow:true,visible:true}),
      createLightState('point',{id:'sin_tower_first_step_light',title:'斷罪塔｜第一階弱光',color:'#ffd28a',intensity:2.8,position:{x:0,y:2.6,z:c.startZ+1.2},distance:28,decay:2,castShadow:false,visible:true}),
      createLightState('point',{id:'sin_tower_follow_light',title:'斷罪塔｜路徑補光',color:'#b6d2ff',intensity:2.2,position:{x:0,y:12,z:-70},distance:160,decay:1.25,castShadow:false,visible:true})
    ]
  };
  s.lightBake = createDefaultLightBake();
  return sanitizeState(s);
}

function sinTowerVisibleStepCount(){
  const c=SIN_TOWER_STAIRCASE;return c.infinite?Math.max(60,Math.floor(c.visibleCount||720)):Math.max(1,c.count);
}

function setSinTowerStepInstanceMatrix(instanced, localIndex, stepIndex){
  const c = SIN_TOWER_STAIRCASE;
  const h = (stepIndex + 1) * c.rise;
  const mat4 = new THREE.Matrix4();
  const pos = new THREE.Vector3(c.startX, c.baseY + h / 2, c.startZ + c.directionZ * (stepIndex * c.depth + c.depth / 2));
  const quat = new THREE.Quaternion();
  const scl = new THREE.Vector3(1, h, 1);
  mat4.compose(pos, quat, scl);
  instanced.setMatrixAt(localIndex, mat4);
}

function updateSinTowerVisibleStairs(force=false){
  const c=SIN_TOWER_STAIRCASE;
  if(!c.enabled||!c.infinite||!sinTowerStairInstanced)return;
  const capacity=sinTowerVisibleStepCount(),total=getSinTowerTotalStepCount();
  const current=Math.max(0,sinTowerStepIndexAtWorld(player.position.x,player.position.z));
  const lead=Math.max(0,Math.floor(c.visibleLead||capacity*.18));
  const start=Math.max(0,current-lead),visibleCount=total>0?Math.max(0,Math.min(capacity,total-start)):capacity;
  if(!force&&start===sinTowerStairVisibleStart&&visibleCount===sinTowerStairVisibleInstanceCount)return;
  sinTowerStairVisibleStart=start;sinTowerStairVisibleInstanceCount=visibleCount;sinTowerStairInstanced.count=visibleCount;
  for(let i=0;i<visibleCount;i++)setSinTowerStepInstanceMatrix(sinTowerStairInstanced,i,start+i);
  sinTowerStairInstanced.instanceMatrix.needsUpdate=true;
}

function applySinTowerStairTextureToMaterial(mat){
  if(!mat) return;
  if(!SIN_TOWER_STAIRCASE.textureDataUrl){
    if(sinTowerStairTexture){ sinTowerStairTexture.dispose?.(); sinTowerStairTexture = null; }
    mat.map = null;
    mat.color.set(SIN_TOWER_STAIRCASE.color || '#3b372f');
    mat.needsUpdate = true;
    return;
  }
  const repeat = Math.max(.25, safeFinite(SIN_TOWER_STAIRCASE.textureRepeat, 3));
  new THREE.TextureLoader().load(SIN_TOWER_STAIRCASE.textureDataUrl, tex=>{
    if(sinTowerStairTexture && sinTowerStairTexture !== tex) sinTowerStairTexture.dispose?.();
    sinTowerStairTexture = tex;
    tex.colorSpace = THREE.SRGBColorSpace;
    tex.wrapS = THREE.RepeatWrapping;
    tex.wrapT = THREE.RepeatWrapping;
    tex.repeat.set(repeat, repeat);
    tex.anisotropy = renderer?.capabilities?.getMaxAnisotropy?.() || 1;
    mat.map = tex;
    mat.color.set('#ffffff');
    mat.needsUpdate = true;
    setStatus('樓梯地板材質已套用。');
  }, undefined, err=>{
    console.warn(err);
    setStatus('樓梯材質載入失敗。');
  });
}

function refreshSinTowerStairMaterial(){
  const mat = sinTowerStairInstanced?.material;
  if(mat) applySinTowerStairTextureToMaterial(mat);
}

async function loadSinTowerStairTextureFile(file){
  if(!file) return;
  const src = await readAsDataURL(file, {maxSize:SIN_TOWER_EDITOR.perf.textureMaxSize, preserveAlpha:false, mimeType:'image/webp', quality:SIN_TOWER_EDITOR.perf.textureQuality});
  SIN_TOWER_STAIRCASE.textureDataUrl = src;
  refreshSinTowerStairMaterial();
  scheduleSinTowerRuntimeSave();
}

function clearSinTowerStairTexture(){
  SIN_TOWER_STAIRCASE.textureDataUrl = null;
  refreshSinTowerStairMaterial();
  scheduleSinTowerRuntimeSave();
  setStatus('已移除樓梯地板材質。');
}

function syncSinTowerStairLimitVisuals(){
  if(!sinTowerStairGroup)return;
  for(const object of sinTowerStairLimitVisuals){object.parent?.remove(object);object.geometry?.dispose?.();object.material?.dispose?.();}
  sinTowerStairLimitVisuals=[];
  const total=getSinTowerTotalStepCount();
  for(const child of sinTowerStairGroup.children)if(Number.isFinite(child.userData?.sinTowerStepIndex))child.visible=total<=0||child.userData.sinTowerStepIndex<total;
  if(total<=0)return;
  const c=SIN_TOWER_STAIRCASE,endZ=c.startZ+c.directionZ*(total*c.depth),topY=c.baseY+total*c.rise;
  const guideMat=new THREE.LineBasicMaterial({color:0xb89a57,transparent:true,opacity:.34});
  for(const side of [-1,1]){
    const x=c.startX+side*(c.width/2+.16),guide=new THREE.Line(new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(x,c.baseY+c.rise+.05,c.startZ),new THREE.Vector3(x,topY+.05,endZ)]),guideMat.clone());
    guide.name=side<0?'斷罪塔｜有限左側導線':'斷罪塔｜有限右側導線';sinTowerStairGroup.add(guide);sinTowerStairLimitVisuals.push(guide);
  }
  const endMaterial=new THREE.MeshStandardMaterial({color:0xb89a57,roughness:.7,metalness:0}),endPlate=new THREE.Mesh(new THREE.BoxGeometry(c.width+1.2,.05,.9),endMaterial);
  endPlate.position.set(c.startX,topY+.034,c.startZ+c.directionZ*((total-.5)*c.depth));endPlate.name='斷罪塔｜最後一階 '+total.toLocaleString();endPlate.userData.sinTowerFiniteEnd=true;
  sinTowerStairGroup.add(endPlate);sinTowerStairLimitVisuals.push(endPlate);
}

function setSinTowerTotalStepCount(value){
  const c=SIN_TOWER_STAIRCASE,next=Math.round(safeFinite(value,0));c.totalSteps=next>0?clamp(next,1,c.virtualCount||1000000):0;sinTowerRunFinished=false;
  syncSinTowerStairLimitVisuals();sinTowerStairVisibleStart=-1;sinTowerStairVisibleInstanceCount=-1;updateSinTowerVisibleStairs(true);refreshInfiniteSinTowerMonkWindow();scheduleSinTowerRuntimeSave();return getSinTowerTotalStepCount();
}

function enforceSinTowerStairTravelBounds(){
  if(!player||!isSinTowerStairSceneActive()||!SIN_TOWER_STAIRCASE.enabled)return false;
  const c=SIN_TOWER_STAIRCASE,radius=Math.max(.12,safeFinite(player.radius,.32)),halfWidth=Math.max(.08,c.width*.5-radius-.06);
  player.position.x=clamp(player.position.x,c.startX-halfWidth,c.startX+halfWidth);
  let along=(player.position.z-c.startZ)*c.directionZ;
  const minAlong=Math.min(c.depth*.5,radius+.04);along=Math.max(minAlong,along);
  const total=getSinTowerTotalStepCount();let reachedEnd=false;
  if(total>0){
    const maxAlong=Math.max(minAlong,total*c.depth-radius-.06);
    if(along>=maxAlong){along=maxAlong;reachedEnd=true;}
    else if(sinTowerRunFinished&&along<maxAlong-c.depth*1.25)sinTowerRunFinished=false;
  }
  player.position.z=c.startZ+c.directionZ*along;
  if(reachedEnd&&!sinTowerRunFinished){sinTowerRunFinished=true;c.autoRun=false;playAction('idle');setStatus('已抵達第 '+total.toLocaleString()+' 階；前方不再生成樓梯。往回移動後可按 P 恢復自動前進。');}
  return reachedEnd;
}

function buildSinTowerStaircase(){
  if(!scene || !SIN_TOWER_STAIRCASE.enabled) return;
  if(sinTowerStairGroup){
    scene.remove(sinTowerStairGroup);
    disposeObjectTree(sinTowerStairGroup);
    sinTowerStairGroup = null;
    sinTowerStairInstanced = null;
    sinTowerStairVisibleStart = -1;
    sinTowerStairVisibleInstanceCount = -1;
    sinTowerStairLimitVisuals = [];
  }
  const c = SIN_TOWER_STAIRCASE;
  sinTowerStairGroup = new THREE.Group();
  sinTowerStairGroup.name = '斷罪塔｜300階向上樓梯';

  const stepGeo = new THREE.BoxGeometry(c.width, 1, c.depth);
  const stepMat = new THREE.MeshStandardMaterial({
    color:new THREE.Color(c.textureDataUrl ? '#ffffff' : c.color),
    roughness:.92,
    metalness:0,
    side:THREE.FrontSide
  });
  applySinTowerStairTextureToMaterial(stepMat);
  const edgeMat = new THREE.LineBasicMaterial({color:new THREE.Color(c.edgeColor), transparent:true, opacity:.38});
  const visibleCount = sinTowerVisibleStepCount();
  const instanced = new THREE.InstancedMesh(stepGeo, stepMat, visibleCount);
  instanced.name = c.infinite ? '無限延伸樓梯實體｜循環視窗' : '300階樓梯實體';
  instanced.castShadow = true;
  instanced.receiveShadow = true;
  for(let i=0;i<visibleCount;i++) setSinTowerStepInstanceMatrix(instanced, i, i);
  instanced.instanceMatrix.needsUpdate = true;
  instanced.userData.locked = true;
  sinTowerStairInstanced = instanced;
  sinTowerStairVisibleStart = 0;
  sinTowerStairGroup.add(instanced);

  const markerGeo = new THREE.BoxGeometry(c.width + .18, .035, .045);
  const markerMat = new THREE.MeshStandardMaterial({color:0xb89a57, roughness:.7, metalness:0});
  for(const i of [0,49,99,149,199,249,299]){
    const marker = new THREE.Mesh(markerGeo, markerMat);
    const topY = c.baseY + (i + 1) * c.rise + .024;
    marker.position.set(c.startX, topY, c.startZ + c.directionZ * (i * c.depth + .055));
    marker.name = `斷罪塔｜第 ${i+1} 階標線`;
    marker.userData.sinTowerStepIndex = i;
    marker.castShadow = false;
    marker.receiveShadow = true;
    sinTowerStairGroup.add(marker);
  }

  const startPlate = new THREE.Mesh(new THREE.BoxGeometry(c.width + 1.2, .05, .9), markerMat);
  startPlate.position.set(c.startX, c.baseY + c.rise + .034, c.startZ + c.directionZ * .2);
  startPlate.name = c.firstStepLabel;
  sinTowerStairGroup.add(startPlate);

  scene.add(sinTowerStairGroup);
  syncSinTowerStairLimitVisuals();
  updateSinTowerVisibleStairs(true);
  resetSinTowerPlayer();
}

function sinTowerEditorVec3(raw, fallback={x:0,y:0,z:0}){
  return {
    x:safeFinite(raw?.x, fallback.x || 0),
    y:safeFinite(raw?.y, fallback.y || 0),
    z:safeFinite(raw?.z, fallback.z || 0)
  };
}

function sinTowerEditorDimensions(raw, fallback={w:18,h:12,d:24}){
  return {
    w:clamp(safeFinite(raw?.w, fallback.w), 2, 200),
    h:clamp(safeFinite(raw?.h, fallback.h), 2, 120),
    d:clamp(safeFinite(raw?.d, fallback.d), 2, 240)
  };
}

function sinTowerEditorSceneTypeLabel(type){
  return type === 'stairs' ? '樓梯' : type === 'church' ? '破敗教堂' : '空白';
}

function sinTowerEditorObjectTypeLabel(type){
  return type === 'prop' ? 'PNG' : type === 'model' ? '3D 模型' : type === 'portal' ? '傳送門' : '教堂構件';
}

function sinTowerEditorLegacyTitle(title, type){
  const aliases = {
    'Stair Scene':'樓梯場景',
    'Stone Cave':'破敗教堂',
    'Empty Scene':'空白場景',
    'PNG Prop':'PNG 物件',
    'Portal':'傳送門',
    'Stone':'石塊'
  };
  const value = String(title || '').trim();
  if(aliases[value]) return aliases[value];
  const caveStone = value.match(/^Cave Stone\s+(\d+)$/i);
  if(caveStone) return `教堂舊構件 ${caveStone[1]}`;
  const stoneCave = value.match(/^Stone Cave\s+(\d+)$/i);
  if(stoneCave) return `破敗教堂 ${stoneCave[1]}`;
  const legacyChineseCave = value.match(/^(?:石洞場景|洞穴場景)(?:\s+(\d+))?$/);
  if(legacyChineseCave) return `破敗教堂${legacyChineseCave[1] ? ' '+legacyChineseCave[1] : ''}`;
  const legacyChineseStone = value.match(/^洞穴(.+?)石塊(?:\s+(\d+))?$/);
  if(legacyChineseStone) return `教堂舊構件 ${legacyChineseStone[1]}${legacyChineseStone[2] ? ' '+legacyChineseStone[2] : ''}`;
  const genericScene = value.match(/^Scene\s+(\d+)$/i);
  if(genericScene) return `場景 ${genericScene[1]}`;
  if(type === 'stairs' && !value) return '樓梯場景';
  if(type === 'church' && !value) return '破敗教堂';
  if(type === 'empty' && !value) return '空白場景';
  return value;
}

function sanitizeSinTowerEditorSkybox(raw, type='empty'){
  const fallback = type === 'church' ? '#d8bc62' : type === 'stairs' ? '#090b10' : '#101216';
  return {color:validColor(raw?.color) ? raw.color : fallback};
}

function sanitizeSinTowerAudio(raw,spatial=false){
  const dataUrl=typeof raw?.dataUrl==='string'&&(raw.dataUrl.startsWith('data:audio/')||sinPublishedAssetMatches(raw.dataUrl,"data:audio/"))?raw.dataUrl:null;
  return {dataUrl,name:String(raw?.name||'').slice(0,180),volume:clamp(safeFinite(raw?.volume,spatial?.85:.7),0,1),loop:raw?.loop!==false,maxDistance:spatial?clamp(safeFinite(raw?.maxDistance,18),1,100):0};
}

function sanitizeSinTowerChurchProfile(raw){
  if(!raw || typeof raw !== 'object') return null;
  const text = (value,fallback)=>String(value || fallback).slice(0,80);
  const counts = {};
  for(const role of ['floor','wall','column','roof','window','cross','furniture','altar','rubble']) counts[role]=Math.max(0,Math.floor(safeFinite(raw?.counts?.[role],0)));
  return {
    seed:safeFinite(raw.seed,0),
    decay:clamp(safeFinite(raw.decay,.68),0,1),
    completeness:clamp(Math.round(safeFinite(raw.completeness,32)),0,100),
    ruinLabel:text(raw.ruinLabel,'殘破'),
    floorPlan:text(raw.floorPlan,'長方巴西利卡'),
    topology:text(raw.topology,raw.floorPlan||'basilica'),
    columnStyle:text(raw.columnStyle,'八角單柱'),
    roofStyle:text(raw.roofStyle,'哥德尖頂木架'),
    windowStyle:text(raw.windowStyle,'尖拱長窗'),
    crossStyle:text(raw.crossStyle,'拉丁十字'),
    furnitureStyle:text(raw.furnitureStyle,'長椅列'),
    altarStyle:text(raw.altarStyle,'階梯祭壇'),
    signature:text(raw.signature,'legacy'),
    counts
  };
}

function sanitizeSinTowerEditorScene(raw){
  const requestedType = raw?.type === "cave" ? 'church' : raw?.type;
  const type = ['stairs','church','empty'].includes(requestedType) ? requestedType : 'empty';
  const fallbackSpawn = type === 'stairs' ? {x:0,y:SIN_TOWER_STAIRCASE.rise,z:SIN_TOWER_STAIRCASE.startZ} : {x:0,y:0,z:0};
  const sharedStoneTextureDataUrl = typeof raw?.sharedStoneTextureDataUrl === 'string' && (raw.sharedStoneTextureDataUrl.startsWith('data:image/')||sinPublishedAssetMatches(raw.sharedStoneTextureDataUrl,"data:image/")) ? raw.sharedStoneTextureDataUrl : null;
  return {
    id:String(raw?.id || uid('scene')),
    title:sinTowerEditorLegacyTitle(raw?.title || (type === 'church' ? '破敗教堂' : type === 'stairs' ? '樓梯場景' : '空白場景'), type).slice(0,80),
    type,
    spawn:sinTowerEditorVec3(raw?.spawn, fallbackSpawn),
    dimensions:sinTowerEditorDimensions(raw?.dimensions, type === 'stairs' ? {w:18,h:80,d:500} : type === 'church' ? {w:20,h:11,d:32} : {w:18,h:10,d:24}),
    skybox:sanitizeSinTowerEditorSkybox(raw?.skybox, type),
    sharedStoneTextureDataUrl,
    sharedStoneTextureName:String(raw?.sharedStoneTextureName || '').slice(0,160),
    stoneTextureMapping:sanitizeSinTowerStoneTextureMapping(raw?.stoneTextureMapping, 'box'),
    churchProfile:type === 'church' ? sanitizeSinTowerChurchProfile(raw?.churchProfile) : null,
    audio:sanitizeSinTowerAudio(raw?.audio,false)
  };
}

function sanitizeSinTowerEditorFrame(raw, index=0){
  const dataUrl = typeof raw?.dataUrl === 'string' && (raw.dataUrl.startsWith('data:image/')||sinPublishedAssetMatches(raw.dataUrl,"data:image/")) ? raw.dataUrl : null;
  if(!dataUrl) return null;
  return {
    dataUrl,
    ratio:clamp(safeFinite(raw?.ratio, .65), .02, 20),
    no:safeFinite(raw?.no, index + 1),
    name:String(raw?.name || '').slice(0,120)
  };
}

function sanitizeSinTowerEditorProp(raw){
  const frames = Array.isArray(raw?.frames) ? raw.frames.map(sanitizeSinTowerEditorFrame).filter(Boolean).slice(0,120) : [];
  const mediaType = raw?.mediaType === 'video' ? 'video' : raw?.mediaType === 'gif' ? 'gif' : 'pngSequence';
  const gifDataUrl = typeof raw?.gifDataUrl === 'string' && (/^data:image\/gif(?:;|,)/i.test(raw.gifDataUrl)||sinPublishedAssetMatches(raw.gifDataUrl,/^data:image\/gif(?:;|,)/i)) ? raw.gifDataUrl : null;
  const videoDataUrl = typeof raw?.videoDataUrl === 'string' && (raw.videoDataUrl.startsWith('data:video/')||sinPublishedAssetMatches(raw.videoDataUrl,"data:video/")) ? raw.videoDataUrl : null;
  const interactionRaw = raw?.interaction || {};
  const interactionVideoDataUrl = typeof interactionRaw.videoDataUrl === 'string' && (interactionRaw.videoDataUrl.startsWith('data:video/')||sinPublishedAssetMatches(interactionRaw.videoDataUrl,"data:video/")) ? interactionRaw.videoDataUrl : null;
  return {
    id:String(raw?.id || uid('prop')),
    sceneId:String(raw?.sceneId || SIN_TOWER_EDITOR.activeSceneId || 'stairs_main'),
    title:sinTowerEditorLegacyTitle(raw?.title || (mediaType === 'video' ? '影片物件' : mediaType === 'gif' ? 'GIF 動畫物件' : 'PNG 物件')).slice(0,80),
    mediaType,
    monoFilter:raw?.monoFilter!==false,
    gifDataUrl,
    gifName:String(raw?.gifName || '').slice(0,160),
    gifRatio:clamp(safeFinite(raw?.gifRatio,1),.05,20),
    videoDataUrl,
    videoName:String(raw?.videoName || '').slice(0,160),
    videoRatio:clamp(safeFinite(raw?.videoRatio, 16/9), .05, 20),
    step:Math.max(0, Math.floor(safeFinite(raw?.step, 12))),
    offset:sinTowerEditorVec3(raw?.offset, {x:-4.5,y:0,z:0}),
    position:sinTowerEditorVec3(raw?.position, raw?.offset || {x:0,y:0,z:0}),
    followStairs:raw?.followStairs !== false,
    repeatOnStairs:raw?.repeatOnStairs === true,
    repeatEvery:clamp(Math.round(safeFinite(raw?.repeatEvery, 20)), 1, 1000),
    repeatVariance:clamp(Math.round(safeFinite(raw?.repeatVariance, 20)), 0, 1000),
    repeatSeed:safeFinite(raw?.repeatSeed, Math.random() * 100000),
    height:clamp(safeFinite(raw?.height, 2), .1, 600),
    widthMul:clamp(safeFinite(raw?.widthMul, 1), .1, 12),
    rotationZ:clamp(safeFinite(raw?.rotationZ, 0), -3600, 3600),
    fps:clamp(safeFinite(raw?.fps, 12), 1, 60),
    motion:['float','patrol','static'].includes(raw?.motion) ? raw.motion : 'float',
    floatAmp:clamp(safeFinite(raw?.floatAmp, .18), 0, 10),
    patrolAxis:['x','y','z'].includes(raw?.patrolAxis) ? raw.patrolAxis : 'x',
    patrolDistance:clamp(safeFinite(raw?.patrolDistance, 2), 0, 100),
    patrolSpeed:clamp(safeFinite(raw?.patrolSpeed, .65), .01, 20),
    driftEnabled:raw?.driftEnabled === true,
    driftAxes:{x:raw?.driftAxes ? raw.driftAxes.x === true : true,y:raw?.driftAxes?.y === true,z:raw?.driftAxes?.z === true},
    driftDistance:clamp(safeFinite(raw?.driftDistance,2),.05,20),
    driftSpeed:clamp(safeFinite(raw?.driftSpeed,.65),.05,5),
    driftIrregularity:clamp(safeFinite(raw?.driftIrregularity,.45),0,1),
    driftSeed:safeFinite(raw?.driftSeed,Math.random()*100000),
    audio:sanitizeSinTowerAudio(raw?.audio,true),
    interaction:{
      enabled:interactionRaw.enabled === true,
      glowEnabled:interactionRaw.glowEnabled !== false,
      particleCount:clamp(Math.round(safeFinite(interactionRaw.particleCount,840)),120,2400),
      particleAxes:normalizeSinTowerParticleAxes(interactionRaw.particleAxes),
      type:['text','media','question','rps'].includes(interactionRaw.type) ? interactionRaw.type : 'text',
      radius:clamp(safeFinite(interactionRaw.radius, 3.2), .8, 30),
      title:String(interactionRaw.title || raw?.title || '被遺忘的手稿').slice(0,100),
      text:String(interactionRaw.text || '').slice(0,30000),
      fontFamily:['serif','gothic','mono','sans'].includes(interactionRaw.fontFamily) ? interactionRaw.fontFamily : 'serif',
      titleSize:clamp(safeFinite(interactionRaw.titleSize,38),1,72),
      bodySize:clamp(safeFinite(interactionRaw.bodySize,18),1,42),
      infectionEffect:sanitizeSinTowerInfectionEffect(interactionRaw.infectionEffect),
      answerEffects:sanitizeSinAnswerEffects(interactionRaw.answerEffects,interactionRaw.infectionEffect),
      afterVideo:sanitizeSinAfterVideo(interactionRaw.afterVideo),
      rpsLayout:sanitizeSinTowerRpsLayout(interactionRaw.rpsLayout),
      backgroundOpacity:clamp(safeFinite(interactionRaw.backgroundOpacity,.85),.05,1),
      cornerRadius:clamp(safeFinite(interactionRaw.cornerRadius,6),0,32),
      vhsIntensity:clamp(safeFinite(interactionRaw.vhsIntensity,1),0,2),
      vhsScanDensity:clamp(safeFinite(interactionRaw.vhsScanDensity,6),1,12),
      vhsOffset:clamp(safeFinite(interactionRaw.vhsOffset,10),0,24),
      vhsSpeed:clamp(safeFinite(interactionRaw.vhsSpeed,5),0,20),
      vhsNoise:clamp(safeFinite(interactionRaw.vhsNoise,.24),0,1),
      questions:(Array.isArray(interactionRaw.questions)?interactionRaw.questions:[]).map(question=>({id:String(question?.id||uid('question')),text:String(question?.text||question||'').trim().slice(0,500)})).filter(question=>question.text).slice(0,24),
      questionTypewriterCps:clamp(safeFinite(interactionRaw.questionTypewriterCps,22),5,80),
      questionTextSize:clamp(safeFinite(interactionRaw.questionTextSize,23),1,48),
      questionTextOpacity:clamp(safeFinite(interactionRaw.questionTextOpacity,1),.1,1),
      dissolveParticleCount:clamp(Math.round(safeFinite(interactionRaw.dissolveParticleCount,4200)),400,12000),
      dissolveDensity:clamp(safeFinite(interactionRaw.dissolveDensity,1.6),.25,4),
      consumed:interactionRaw.consumed === true,
      answers:(Array.isArray(interactionRaw.answers)?interactionRaw.answers:[]).map(answer=>({questionId:String(answer?.questionId||''),answer:answer?.answer==='yes'?'yes':'no',at:safeFinite(answer?.at,Date.now())})).slice(-120),
      videoDataUrl:interactionVideoDataUrl,
      videoName:String(interactionRaw.videoName || '').slice(0,160)
    },
    frames
  };
}

function sanitizeSinTowerEditorModel(raw){
  const embeddedSourceDataUrl = typeof raw?.sourceUrl === 'string' && (/^data:(?:model\/gltf-binary|application\/octet-stream);base64,/i.test(raw.sourceUrl)||sinPublishedAssetMatches(raw.sourceUrl,/^data:(?:model\/gltf-binary|application\/octet-stream);base64,/i)) && /\.glb$/i.test(String(raw?.modelName || '')) ? raw.sourceUrl : null;
  const modelDataUrl = typeof raw?.modelDataUrl === 'string' && (/^data:[^,]*;base64,/i.test(raw.modelDataUrl)||sinPublishedAssetMatches(raw.modelDataUrl,/^data:[^,]*;base64,/i)) && /\.glb$/i.test(String(raw?.modelName || '')) ? raw.modelDataUrl : embeddedSourceDataUrl;
  const sourceUrl = !embeddedSourceDataUrl && typeof raw?.sourceUrl === 'string' && (raw.sourceUrl.startsWith('./') || raw.sourceUrl.startsWith('assets/')) ? raw.sourceUrl : null;
  const textureDataUrl = typeof raw?.textureDataUrl === 'string' && (raw.textureDataUrl.startsWith('data:image/')||sinPublishedAssetMatches(raw.textureDataUrl,"data:image/")) ? raw.textureDataUrl : null;
  const interactionRaw = raw?.interaction || {};
  const interactionVideoDataUrl = typeof interactionRaw.videoDataUrl === 'string' && (interactionRaw.videoDataUrl.startsWith('data:video/')||sinPublishedAssetMatches(interactionRaw.videoDataUrl,"data:video/")) ? interactionRaw.videoDataUrl : null;
  return {
    id:String(raw?.id || uid('model')),
    sceneId:String(raw?.sceneId || SIN_TOWER_EDITOR.activeSceneId || 'stairs_main'),
    title:String(raw?.title || '3D 物件').trim().slice(0,80) || '3D 物件',
    modelDataUrl,
    sourceUrl,
    modelName:String(raw?.modelName || '').slice(0,160),
    textureDataUrl,
    textureName:String(raw?.textureName || '').slice(0,160),
    position:sinTowerEditorVec3(raw?.position,{x:0,y:.5,z:0}),
    rotation:raw?.bundledAsset === 'book01' && Math.abs(safeFinite(raw?.rotation?.x,0)) < .001 && Math.abs(safeFinite(raw?.rotation?.z,90)-90) < .001 ? {x:-90,y:0,z:0} : sinTowerEditorVec3(raw?.rotation,{x:0,y:0,z:0}),
    scale:sinTowerEditorVec3(raw?.scale,{x:1,y:1,z:1}),
    bundledAsset:raw?.bundledAsset === 'book01' ? 'book01' : null,
    driftEnabled:raw?.driftEnabled === true,
    driftAxes:{x:raw?.driftAxes ? raw.driftAxes.x === true : true,y:raw?.driftAxes?.y === true,z:raw?.driftAxes?.z === true},
    driftDistance:clamp(safeFinite(raw?.driftDistance,2),.05,20),
    driftSpeed:clamp(safeFinite(raw?.driftSpeed,.65),.05,5),
    driftIrregularity:clamp(safeFinite(raw?.driftIrregularity,.45),0,1),
    driftSeed:safeFinite(raw?.driftSeed,Math.random()*100000),
    audio:sanitizeSinTowerAudio(raw?.audio,true),
    interaction:{enabled:interactionRaw.enabled === true,glowEnabled:interactionRaw.glowEnabled !== false,particleCount:clamp(Math.round(safeFinite(interactionRaw.particleCount,840)),120,2400),particleAxes:normalizeSinTowerParticleAxes(interactionRaw.particleAxes),type:['text','media','question','rps'].includes(interactionRaw.type) ? interactionRaw.type : 'text',radius:clamp(safeFinite(interactionRaw.radius,3.2),.8,30),title:String(interactionRaw.title || raw?.title || '被遺忘的手稿').slice(0,100),text:String(interactionRaw.text || '').slice(0,30000),fontFamily:['serif','gothic','mono','sans'].includes(interactionRaw.fontFamily) ? interactionRaw.fontFamily : 'serif',titleSize:clamp(safeFinite(interactionRaw.titleSize,38),1,72),bodySize:clamp(safeFinite(interactionRaw.bodySize,18),1,42),
      infectionEffect:sanitizeSinTowerInfectionEffect(interactionRaw.infectionEffect),
      answerEffects:sanitizeSinAnswerEffects(interactionRaw.answerEffects,interactionRaw.infectionEffect),
      afterVideo:sanitizeSinAfterVideo(interactionRaw.afterVideo),
      rpsLayout:sanitizeSinTowerRpsLayout(interactionRaw.rpsLayout),
      backgroundOpacity:clamp(safeFinite(interactionRaw.backgroundOpacity,.85),.05,1),
      cornerRadius:clamp(safeFinite(interactionRaw.cornerRadius,6),0,32),
      vhsIntensity:clamp(safeFinite(interactionRaw.vhsIntensity,1),0,2),
      vhsScanDensity:clamp(safeFinite(interactionRaw.vhsScanDensity,6),1,12),
      vhsOffset:clamp(safeFinite(interactionRaw.vhsOffset,10),0,24),
      vhsSpeed:clamp(safeFinite(interactionRaw.vhsSpeed,5),0,20),
      vhsNoise:clamp(safeFinite(interactionRaw.vhsNoise,.24),0,1),
      questions:(Array.isArray(interactionRaw.questions)?interactionRaw.questions:[]).map(question=>({id:String(question?.id||uid('question')),text:String(question?.text||question||'').trim().slice(0,500)})).filter(question=>question.text).slice(0,24),
      questionTypewriterCps:clamp(safeFinite(interactionRaw.questionTypewriterCps,22),5,80),
      questionTextSize:clamp(safeFinite(interactionRaw.questionTextSize,23),1,48),
      questionTextOpacity:clamp(safeFinite(interactionRaw.questionTextOpacity,1),.1,1),
      dissolveParticleCount:clamp(Math.round(safeFinite(interactionRaw.dissolveParticleCount,4200)),400,12000),
      dissolveDensity:clamp(safeFinite(interactionRaw.dissolveDensity,1.6),.25,4),
      consumed:interactionRaw.consumed === true,
      answers:(Array.isArray(interactionRaw.answers)?interactionRaw.answers:[]).map(answer=>({questionId:String(answer?.questionId||''),answer:answer?.answer==='yes'?'yes':'no',at:safeFinite(answer?.at,Date.now())})).slice(-120),videoDataUrl:interactionVideoDataUrl,videoName:String(interactionRaw.videoName || '').slice(0,160)}
  };
}

function makeSinTowerBundledBookModel(sceneState){
  const depth = safeFinite(sceneState?.dimensions?.d,32);
  return sanitizeSinTowerEditorModel({
    id:'bundled_book_01_' + sceneState.id,
    sceneId:sceneState.id,
    title:'祭壇上的腐朽之書',
    sourceUrl:SIN_TOWER_BUNDLED_BOOK_MODEL_URL,
    modelName:'書籍_01_optimized.glb',
    position:{x:0,y:1.60,z:-depth/2+2.7},
    rotation:{x:-90,y:0,z:0},
    scale:{x:1.15,y:1.15,z:1.15},
    bundledAsset:'book01'
  });
}

function ensureSinTowerBundledBookModel(sceneState){
  if(!sceneState || sceneState.type !== 'church' || SIN_TOWER_EDITOR.bundledBookInitialized) return null;
  const existing = SIN_TOWER_EDITOR.models.find(model=>model.bundledAsset === 'book01');
  SIN_TOWER_EDITOR.bundledBookInitialized = true;
  if(existing) return existing;
  const model = makeSinTowerBundledBookModel(sceneState);
  SIN_TOWER_EDITOR.models.push(model);
  return model;
}

const SIN_TOWER_PORTAL_STYLES = [
  {name:'秘藍雙螺旋',color:'#65d7ff',arms:2,turns:3.1,direction:1,speed:.58,wave:3,depth:.55,hue:.08},
  {name:'緋紅逆渦',color:'#ff5277',arms:2,turns:4.2,direction:-1,speed:.72,wave:5,depth:.82,hue:-.06},
  {name:'紫晶三重裂隙',color:'#b078ff',arms:3,turns:3.7,direction:1,speed:.44,wave:7,depth:1.05,hue:.12},
  {name:'翡翠靈魂環',color:'#52f0a5',arms:4,turns:2.8,direction:-1,speed:.36,wave:4,depth:.62,hue:-.1},
  {name:'聖金六芒渦',color:'#ffd66b',arms:6,turns:3.3,direction:1,speed:.31,wave:6,depth:.46,hue:.08},
  {name:'冰白星霜',color:'#d8f5ff',arms:5,turns:4.8,direction:-1,speed:.27,wave:9,depth:.9,hue:.15},
  {name:'玫紅日蝕',color:'#ff65ca',arms:3,turns:5.2,direction:1,speed:.63,wave:8,depth:1.12,hue:-.14},
  {name:'灰燼虛空',color:'#aeb8c5',arms:7,turns:2.5,direction:-1,speed:.22,wave:11,depth:1.25,hue:.04},
  {name:'青碧時計渦',color:'#3fffe0',arms:8,turns:3.9,direction:1,speed:.49,wave:12,depth:.72,hue:.18},
  {name:'深淵十字星流',color:'#7490ff',arms:4,turns:6.1,direction:-1,speed:.83,wave:10,depth:1.35,hue:-.18}
];

function getSinTowerPortalStylePreset(value){
  return SIN_TOWER_PORTAL_STYLES[clamp(Math.floor(safeFinite(value,1)),1,10)-1] || SIN_TOWER_PORTAL_STYLES[0];
}

function sanitizeSinTowerPortalPassword(value){
  const cleaned=String(value ?? 'B2F7').toUpperCase().replace(/[^0-9A-F]/g,'').slice(0,4);
  return (cleaned+'0000').slice(0,4);
}

function sanitizeSinTowerEditorPortal(raw){
  const width=clamp(safeFinite(raw?.width,1.8),.3,480);
  const height=clamp(safeFinite(raw?.height,2.6),.5,640);
  const inferredScale=Math.sqrt(Math.max(.001,(width/1.8)*(height/2.6)));
  return {
    id:String(raw?.id || uid('portal')),
    sceneId:String(raw?.sceneId || SIN_TOWER_EDITOR.activeSceneId || 'stairs_main'),
    targetSceneId:String(raw?.targetSceneId || 'stairs_main'),
    title:sinTowerEditorLegacyTitle(raw?.title || '傳送門').slice(0,80),
    step:Math.max(0, Math.floor(safeFinite(raw?.step, 24))),
    offset:sinTowerEditorVec3(raw?.offset, {x:0,y:.9,z:0}),
    width,
    height,
    uniformScale:clamp(safeFinite(raw?.uniformScale,inferredScale),.2,240),
    rotationY:safeFinite(raw?.rotationY,0),
    portalStyle:clamp(Math.floor(safeFinite(raw?.portalStyle ?? raw?.style,1)),1,10),
    color:validColor(raw?.color) ? raw.color : getSinTowerPortalStylePreset(raw?.portalStyle).color,
    passwordEnabled:raw?.passwordEnabled===true,
    password:sanitizeSinTowerPortalPassword(raw?.password),
    audio:sanitizeSinTowerAudio(raw?.audio,true)
  };
}

const sinTowerPortalLayoutEditor={active:false,drag:null,bound:false};

function getSinTowerPortalPasswordLayout(){
  if(!STATE.portalPasswordLayout)STATE.portalPasswordLayout=createDefaultPortalPasswordLayout();
  const orientation=STATE.displayOrientation==='portrait'?'portrait':'landscape';
  return STATE.portalPasswordLayout[orientation];
}

function applySinTowerPortalPasswordLayout(){
  const overlay=$('sinPortalPasswordOverlay'),shell=overlay?.querySelector('.sin-portal-password-shell'),group=$('sinPortalPasswordGroup');
  if(!overlay||!shell||!group)return;
  const layout=getSinTowerPortalPasswordLayout(),frame=layout.frame,slots=layout.slots;
  Object.assign(shell.style,{left:frame.x+'%',top:frame.y+'%',width:frame.w+'%',height:frame.h+'%'});
  Object.assign(group.style,{left:slots.x+'%',top:slots.y+'%',width:slots.w+'%',height:slots.h+'%'});
  const bounds=overlay.getBoundingClientRect(),groupWidth=bounds.width*slots.w/100,groupHeight=bounds.height*slots.h/100;
  group.style.setProperty('--portal-slot-gap',Math.max(.35,Math.min(18,groupWidth*.035))+'px');
  group.style.setProperty('--portal-slot-font-size',Math.max(3,Math.min(groupHeight*.62,groupWidth*.17))+'px');
  const portalFx=getSinTowerPortalPasswordFx();group.style.setProperty('--portal-slot-text-scale',portalFx.textScale);group.style.setProperty('--portal-slot-text-weight',portalFx.textWeight);
  group.style.setProperty('--portal-slot-radius',Math.max(1,Math.min(10,Math.min(groupHeight,groupWidth*.25)*.12))+'px');
  layoutSinPortalPad();
}

function setSinTowerPortalLayoutRect(target,next){
  const layout=getSinTowerPortalPasswordLayout();
  layout[target]={x:next.x,y:next.y,w:next.w,h:next.h};
  applySinTowerPortalPasswordLayout();
  scheduleSave();
}

function openSinTowerPortalLayoutEditor(){
  if(isPlayMode())return false;
  sinTowerPortalLayoutEditor.active=true;
  sinTowerPortalGate.values=[...'B2F7'];sinTowerPortalGate.selected=3;
  syncSinTowerPortalPasswordUi();
  const countdown=$('sinPortalPasswordCountdown');if(countdown)countdown.textContent='30';
  const overlay=$('sinPortalPasswordOverlay');overlay?.classList.add('layout-editing');
  setSinTowerPortalPasswordOverlay(true);requestAnimationFrame(applySinTowerPortalPasswordLayout);
  return true;
}

function closeSinTowerPortalLayoutEditor(){
  sinTowerPortalLayoutEditor.active=false;sinTowerPortalLayoutEditor.drag=null;
  $('sinPortalPasswordOverlay')?.classList.remove('layout-editing');setSinTowerPortalPasswordOverlay(false);
  scheduleSave();scheduleSinTowerRuntimeSave();
}

function resetSinTowerPortalLayoutEditor(){
  const orientation=STATE.displayOrientation==='portrait'?'portrait':'landscape';
  STATE.portalPasswordLayout[orientation]=createDefaultPortalPasswordLayout()[orientation];
  applySinTowerPortalPasswordLayout();scheduleSave();
}

function sinTowerPortalLayoutPixels(value,bounds){
  const w=bounds.width*value.w/100,h=bounds.height*value.h/100;
  return{x:bounds.width*value.x/100-w/2,y:bounds.height*value.y/100-h/2,w,h};
}

function sinTowerPortalLayoutPercent(rect,bounds){
  return{x:(rect.x+rect.w/2)/bounds.width*100,y:(rect.y+rect.h/2)/bounds.height*100,w:rect.w/bounds.width*100,h:rect.h/bounds.height*100};
}

function bindSinTowerPortalLayoutEditor(){
  if(sinTowerPortalLayoutEditor.bound)return;sinTowerPortalLayoutEditor.bound=true;
  const overlay=$('sinPortalPasswordOverlay');
  for(const root of [overlay?.querySelector('.sin-portal-password-shell'),$('sinPortalPasswordGroup')]){
    if(!root)continue;
    root.addEventListener('pointerdown',event=>{
      if(!sinTowerPortalLayoutEditor.active||event.button!==0)return;
      const bounds=overlay.getBoundingClientRect(),target=root.dataset.layoutTarget,handle=event.target.closest('.sin-portal-layout-handle')?.dataset.handle||'move';
      sinTowerPortalLayoutEditor.drag={pointerId:event.pointerId,target,handle,startX:event.clientX,startY:event.clientY,bounds,start:sinTowerPortalLayoutPixels({...getSinTowerPortalPasswordLayout()[target]},bounds)};
      root.setPointerCapture?.(event.pointerId);event.preventDefault();event.stopPropagation();
    });
    root.addEventListener('pointermove',event=>{
      const drag=sinTowerPortalLayoutEditor.drag;if(!drag||drag.pointerId!==event.pointerId||drag.target!==root.dataset.layoutTarget)return;
      const bounds=drag.bounds,start=drag.start,minW=drag.target==='frame'?80:28,minH=drag.target==='frame'?96:12,dx=event.clientX-drag.startX,dy=event.clientY-drag.startY;
      let rect={...start};
      if(drag.handle==='move'){
        rect.x=clamp(start.x+dx,0,bounds.width-start.w);rect.y=clamp(start.y+dy,0,bounds.height-start.h);
      }else if(drag.handle.length===2){
        const west=drag.handle.includes('w'),north=drag.handle.includes('n'),anchorX=west?start.x+start.w:start.x,anchorY=north?start.y+start.h:start.y;
        const pointerX=clamp(event.clientX-bounds.left,0,bounds.width),pointerY=clamp(event.clientY-bounds.top,0,bounds.height);
        const rawW=Math.abs(pointerX-anchorX),rawH=Math.abs(pointerY-anchorY),minScale=Math.max(minW/start.w,minH/start.h),maxScale=Math.min((west?anchorX:bounds.width-anchorX)/start.w,(north?anchorY:bounds.height-anchorY)/start.h);
        const scale=clamp((rawW/start.w+rawH/start.h)/2,minScale,Math.max(minScale,maxScale));rect.w=start.w*scale;rect.h=start.h*scale;rect.x=west?anchorX-rect.w:anchorX;rect.y=north?anchorY-rect.h:anchorY;
      }else{
        const px=clamp(event.clientX-bounds.left,0,bounds.width),py=clamp(event.clientY-bounds.top,0,bounds.height),right=start.x+start.w,bottom=start.y+start.h;
        if(drag.handle==='e')rect.w=Math.max(minW,px-start.x);
        if(drag.handle==='w'){rect.x=Math.min(px,right-minW);rect.w=right-rect.x;}
        if(drag.handle==='s')rect.h=Math.max(minH,py-start.y);
        if(drag.handle==='n'){rect.y=Math.min(py,bottom-minH);rect.h=bottom-rect.y;}
      }
      rect.w=Math.min(rect.w,bounds.width);rect.h=Math.min(rect.h,bounds.height);rect.x=clamp(rect.x,0,bounds.width-rect.w);rect.y=clamp(rect.y,0,bounds.height-rect.h);
      setSinTowerPortalLayoutRect(drag.target,sinTowerPortalLayoutPercent(rect,bounds));event.preventDefault();
    });
    const finish=event=>{if(sinTowerPortalLayoutEditor.drag?.pointerId!==event.pointerId)return;sinTowerPortalLayoutEditor.drag=null;scheduleSave();scheduleSinTowerRuntimeSave();event.preventDefault();};
    root.addEventListener('pointerup',finish);root.addEventListener('pointercancel',finish);
  }
  $('sinPortalLayoutDone')?.addEventListener('click',closeSinTowerPortalLayoutEditor);
  $('sinPortalLayoutReset')?.addEventListener('click',resetSinTowerPortalLayoutEditor);
  document.addEventListener('keydown',event=>{if(sinTowerPortalLayoutEditor.active&&event.code==='Escape'){event.preventDefault();event.stopImmediatePropagation();closeSinTowerPortalLayoutEditor();}},true);
}

let sinTowerMobileControlsHidden=false;
const sinTowerMobileLayoutEditor={active:false,selected:'movePad',drag:null,bound:false};

function getSinTowerMobileControlsLayout(){
  if(!STATE.mobileControlsLayout)STATE.mobileControlsLayout=createDefaultMobileControlsLayout();
  const orientation=STATE.displayOrientation==='portrait'?'portrait':'landscape';
  return STATE.mobileControlsLayout[orientation];
}

function ensureSinTowerMobileLayoutUi(){
  const controls=$('mobileControls');if(!controls)return;
  const handles=['nw','n','ne','e','se','s','sw','w'].map(handle=>'<i class="sin-mobile-layout-handle" data-handle="'+handle+'" aria-hidden="true"></i>').join('');
  for(const root of [controls.querySelector('[data-mobile-layout-target="movePad"]'),controls.querySelector('[data-mobile-layout-target="jump"]')])if(root&&!root.querySelector('.sin-mobile-layout-outline')){const outline=document.createElement('div');outline.className='sin-mobile-layout-outline';outline.setAttribute('aria-hidden','true');outline.innerHTML=handles;root.appendChild(outline);}
  if(!$('sinMobileLayoutToolbar')){const toolbar=document.createElement('div');toolbar.id='sinMobileLayoutToolbar';toolbar.innerHTML='<span id="sinMobileLayoutSelectionLabel">移動搖桿</span><button id="sinMobileLayoutReset" type="button">重設</button><button id="sinMobileLayoutDone" type="button">完成</button>';controls.appendChild(toolbar);}
}

function applySinTowerMobileControlsLayout(){
  if(sinPortalPad.active&&isSinPortalPadMode()){applySinTowerPortalPasswordLayout();return;}
  const controls=$('mobileControls');if(!controls||!STATE)return;ensureSinTowerMobileLayoutUi();
  const layout=getSinTowerMobileControlsLayout(),entries=[['movePad',$('mobileMovePad')],['jump',$('mobileJumpButton')]];
  for(const [key,node] of entries){const rect=layout[key];if(!node||!rect)continue;Object.assign(node.style,{left:rect.x+'%',top:rect.y+'%',width:rect.w+'%',height:rect.h+'%'});node.classList.toggle('selected',sinTowerMobileLayoutEditor.active&&sinTowerMobileLayoutEditor.selected===key);}
  const label=$('sinMobileLayoutSelectionLabel');if(label)label.textContent=sinTowerMobileLayoutEditor.selected==='jump'?'跳躍按鍵':'移動搖桿';
  document.body.classList.toggle('sin-mobile-controls-hidden',sinTowerMobileControlsHidden);
}

function selectSinTowerMobileLayoutTarget(key){
  if(!['movePad','jump'].includes(key))return false;sinTowerMobileLayoutEditor.selected=key;applySinTowerMobileControlsLayout();return true;
}

function setSinTowerMobileLayoutRect(key,next){
  const layout=getSinTowerMobileControlsLayout();layout[key]={x:next.x,y:next.y,w:next.w,h:next.h};applySinTowerMobileControlsLayout();scheduleSave();
}

function openSinTowerMobileLayoutEditor(){
  if(isPlayMode()||sinTowerPortalGate.active)return false;sinTowerMobileLayoutEditor.active=true;sinTowerMobileLayoutEditor.drag=null;sinTowerMobileControlsHidden=false;
  if(STATE.displayOrientation!=='portrait')setSinTowerDisplayOrientation('portrait');
  document.body.classList.add('sin-mobile-layout-editing');ensureSinTowerMobileLayoutUi();selectSinTowerMobileLayoutTarget(sinTowerMobileLayoutEditor.selected);applySinTowerMobileControlsLayout();setStatus('點選移動搖桿或跳躍按鍵；拖曳本體移動，對角點等比縮放，邊線中點自由變形。');return true;
}

function closeSinTowerMobileLayoutEditor(){
  sinTowerMobileLayoutEditor.active=false;sinTowerMobileLayoutEditor.drag=null;document.body.classList.remove('sin-mobile-layout-editing');applySinTowerMobileControlsLayout();scheduleSave();scheduleSinTowerRuntimeSave();syncSinProEditor();setStatus('已儲存手機浮動按鍵版面。');
}

function resetSinTowerMobileLayoutEditor(){
  const orientation=STATE.displayOrientation==='portrait'?'portrait':'landscape';STATE.mobileControlsLayout[orientation]=createDefaultMobileControlsLayout()[orientation];applySinTowerMobileControlsLayout();scheduleSave();
}

function handleSinTowerMobileControlsShortcut(event){
  const keyMatches=event?.code==='KeyK'||String(event?.key||'').toLowerCase()==='k',allowed=document.body.classList.contains('play-mode')||document.body.classList.contains('sin-mobile-layout-editing')||EXPORTED_GALLERY_VIEWER;
  if(!keyMatches||!event.shiftKey||event.ctrlKey||event.altKey||event.metaKey||event.repeat||isTextEditingElement(document.activeElement)||STATE?.displayOrientation!=='portrait'||!allowed)return false;
  event.preventDefault();event.stopPropagation();event.stopImmediatePropagation?.();toggleSinTowerMobileControlsHidden();return true;
}

function toggleSinTowerMobileControlsHidden(){
  if(STATE?.displayOrientation!=='portrait')return false;sinTowerMobileControlsHidden=!sinTowerMobileControlsHidden;applySinTowerMobileControlsLayout();setStatus(sinTowerMobileControlsHidden?'手機浮動按鍵已隱藏；按 Shift+K 恢復。':'手機浮動按鍵已顯示。');return true;
}

function bindSinTowerMobileLayoutEditor(){
  if(sinTowerMobileLayoutEditor.bound)return;sinTowerMobileLayoutEditor.bound=true;ensureSinTowerMobileLayoutUi();const controls=$('mobileControls');
  for(const root of [controls?.querySelector('[data-mobile-layout-target="movePad"]'),controls?.querySelector('[data-mobile-layout-target="jump"]')]){
    if(!root)continue;root.addEventListener('pointerdown',event=>{
      if(!sinTowerMobileLayoutEditor.active||event.button!==0)return;const key=root.dataset.mobileLayoutTarget;selectSinTowerMobileLayoutTarget(key);
