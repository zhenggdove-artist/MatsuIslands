      <div id="sinQuestionText"></div>
      <div class="sin-question-choices"><button id="sinQuestionNo" class="sin-question-no" type="button" aria-label="回答 NO">← NO</button><button id="sinQuestionYes" class="sin-question-yes" type="button" aria-label="回答 YES">YES →</button></div>
    </div>
  </article>
</div>

<div id="sinInteractionOverlay" aria-hidden="true" class="">
  <article class="sin-interaction-paper" role="dialog" aria-modal="true" aria-labelledby="sinInteractionTitle" style="--sin-interaction-font: Arial,'Noto Sans TC',sans-serif; --sin-interaction-title-size: 15px; --sin-interaction-body-size: 13px; --sin-doc-opacity: 0.850; --sin-doc-radius: 6.0px; --sin-doc-vhs-line-size: 5.32px; --sin-doc-vhs-noise: 0.240; --sin-doc-vhs-speed: 0.523s; --hud-light: #f4d66f;">
    <button id="sinInteractionClose" type="button" aria-label="關閉互動頁面">×</button>
    <h2 id="sinInteractionTitle">QQQQ</h2>
    <div id="sinInteractionScroll" style="display: block;">嗚嗚嗚嗚嗚嗚嗚嗚嗚嗚嗚 </div>
    <div id="sinInteractionMedia"><img id="sinInteractionImage" alt="互動動畫"><video id="sinInteractionVideo" playsinline="" muted="" controls=""></video></div>
  </article>
</div>

<div id="sinPortalPasswordOverlay" aria-hidden="true" class="portal-fx-monopixel" style="--portal-paper: #f4d66f; --portal-ink: #14263d;">
  <img id="sinPortalPasswordSky" alt="傳送門密碼背景">
  <section class="sin-portal-password-shell" data-layout-target="frame" role="dialog" aria-modal="true" aria-label="傳送門四碼密碼" style="left: 50%; top: 51.4836%; width: 100%; height: 97.0328%;">
    <img id="sinPortalPasswordFrame" alt="黑白生物骨質傳送門密碼畫面" style="visibility: hidden;">
    <div class="sin-portal-layout-outline" aria-hidden="true"><i class="sin-portal-layout-handle" data-handle="nw" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="n" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="ne" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="e" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="se" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="s" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="sw" aria-hidden="true"></i><i class="sin-portal-layout-handle" data-handle="w" aria-hidden="true"></i></div>
  </section>
  <div class="sin-portal-password-console">
