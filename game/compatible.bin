const SIN_TOWER_PORTAL_PASSWORD_DEFAULT_GIF="./media/2d4195910cfc8b5db96e0095021ee8e7b1cb108ea06c053bcbc91393f26102e8.gif";
const SIN_TOWER_PORTAL_PASSWORD_DEFAULT_SLOT_ART='./media/400d13361c2c2611372dc4ac34d342e928f294300ebc39aeb7603c6a7e1a60be.png';
const SIN_TOWER_PORTAL_PASSWORD_CHARS='0123456789ABCDEF';
const SIN_TOWER_PORTAL_COOLDOWN_MS=5000;
const SIN_TOWER_PORTAL_PLACEMENT_GRACE_MS=1000;
let sinTowerPortalMonoBayerKey='';
let sinTowerPortalSlotMonoBayerKey='';
function sinTowerPortalCooldownRemaining(now=performance.now()){const last=sinTowerEditorRuntime.lastPortalAt;return Number.isFinite(last)?Math.max(0,SIN_TOWER_PORTAL_COOLDOWN_MS-(now-last)):0;}
function isSinTowerPortalTemporarilyDisabled(portal,now=performance.now()){if(!portal)return true;if(sinTowerPlayObjectUi.followObjectType==='portal'&&sinTowerPlayObjectUi.followPropId===portal.id)return true;return sinTowerPlayObjectUi.portalPlacementGraceId===portal.id&&now<sinTowerPlayObjectUi.portalPlacementGraceUntil;}
const sinTowerPortalGate={active:false,mode:'idle',phase:'idle',portalId:null,sourceSceneId:null,targetSceneId:null,values:['0','0','0','0'],selected:3,changed:false,deadline:0,countdown:-1,previousAutoRun:false,sequence:0,timers:[]};

function clearSinTowerPortalGateTimers(){for(const timer of sinTowerPortalGate.timers)clearTimeout(timer);sinTowerPortalGate.timers.length=0;}
function scheduleSinTowerPortalGate(callback,delay){const sequence=sinTowerPortalGate.sequence,timer=setTimeout(()=>{if(sequence===sinTowerPortalGate.sequence)callback();},delay);sinTowerPortalGate.timers.push(timer);return timer;}
function setSinTowerPortalFade(opaque,duration=1000){const fade=$('sinPortalTransitionFade');if(!fade)return;fade.style.transitionDuration=Math.max(0,duration)+'ms';fade.getBoundingClientRect();fade.classList.toggle('opaque',!!opaque);}
const sinPortalSmooth={source:null,promise:null,frames:[],durations:[],cycle:0,start:0,canvas:null,raf:0,generation:0,index:0,blend:0,stream:null};
function sinPortalPasswordVisible(){return !!$('sinPortalPasswordOverlay')?.classList.contains('open');}
function sinPortalTimeline(elapsed,durations){const cycle=durations.reduce((a,b)=>a+b,0);let t=((elapsed%cycle)+cycle)%cycle,index=0;while(index<durations.length-1&&t>=durations[index])t-=durations[index++];return {index,next:(index+1)%durations.length,blend:t/durations[index]};}
function showSinPortalCanvas(width,height){
  const s=sinPortalSmooth,original=$('sinPortalPasswordFrame');
  if(!s.canvas){s.canvas=document.createElement('canvas');s.canvas.id='sinPortalSmoothCanvas';s.canvas.style.cssText='position:absolute;inset:0;width:100%;height:100%;pointer-events:none';original.after(s.canvas);}
  if(s.canvas.width!==width)s.canvas.width=width;if(s.canvas.height!==height)s.canvas.height=height;
  s.canvas.hidden=false;original.style.visibility='hidden';original._sinPortalSource=s.source;original.removeAttribute('src');
}
async function prepareSinPortalStream(source,token){
  const s=sinPortalSmooth,slot=sinGifWorkerSlot(),stream={slot,key:'portal:'+token+':'+source,pending:false,recycle:null,disposed:false};slot.loads++;s.stream=stream;
  const result=await sinGifRequest(slot,{type:'load',key:stream.key,url:new URL(source,document.baseURI).href});
  if(token!==s.generation||stream.disposed){slot.worker.postMessage({type:'release',key:stream.key});return;}
  stream.width=result.width;stream.height=result.height;s.durations=result.durations;s.cycle=s.durations.reduce((a,b)=>a+b,0);s.start=performance.now();
  paintSinPortalStream(stream,result);drawSinPortalSmooth();
