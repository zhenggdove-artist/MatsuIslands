') format('woff');font-style:normal;font-weight:100 900;font-display:swap;unicode-range:U+2000-206F,U+2E80-2EFF,U+3000-303F,U+3100-312F,U+31A0-31BF,U+31C0-31EF,U+3400-4DBF,U+4E00-9FFF,U+F900-FAFF,U+FF00-FFEF}
  :root{--bg:#060606;--panel:rgba(11,11,12,.9);--line:rgba(255,255,255,.18);--text:#eee;--muted:#aaa;--gold:#d8c07f;--danger:#d66;--ok:#8fd08f}
  html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:Arial,'Noto Sans TC',sans-serif}
  body,body *{font-family:'SinTowerTypography','Noto Sans TC',sans-serif!important}
  #canvas{position:fixed;inset:0;display:block;outline:none;touch-action:none;user-select:none}
  #hud{position:fixed;left:14px;top:14px;z-index:10;max-width:360px;padding:10px 12px;border:1px solid var(--line);background:rgba(0,0,0,.55);font-size:12px;line-height:1.55;pointer-events:none;backdrop-filter:blur(8px)}
  #status{position:fixed;left:14px;bottom:14px;z-index:10;max-width:min(520px,calc(100vw - 28px));padding:9px 11px;border:1px solid rgba(216,192,127,.35);background:rgba(0,0,0,.58);font:12px/1.45 monospace;pointer-events:none;white-space:pre-wrap}
  #editor{position:fixed;right:14px;top:14px;z-index:20;width:380px;max-height:calc(100vh - 28px);overflow:auto;padding:14px;border:1px solid var(--line);background:var(--panel);box-shadow:0 18px 50px rgba(0,0,0,.55);backdrop-filter:blur(10px)}
  #editor[hidden]{display:none}
  h1{font-size:13px;margin:0 0 12px;letter-spacing:.08em;text-transform:uppercase}
  h2{font-size:12px;margin:16px 0 8px;color:var(--gold)}
  label{display:grid;grid-template-columns:104px 1fr;gap:8px;align-items:center;margin:7px 0;font-size:11px;color:#bbb}
  label.check{grid-template-columns:1fr auto}
  label.check input{width:auto}
  [data-force-hidden]{display:none!important}
  input,select,button{width:100%;box-sizing:border-box;background:#111;border:1px solid #333;color:#eee;padding:7px;font:12px monospace}
  input[type="range"]{padding:0}
  input[type="color"]{height:32px;padding:2px}
  button{cursor:pointer;background:#1b1b1b;font-family:Arial,'Noto Sans TC',sans-serif}
  button:hover{border-color:#777}
  button.danger{border-color:rgba(214,102,102,.55);color:#ffd6d6}
  button.ok{border-color:rgba(143,208,143,.55);color:#dcffdc}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:7px 0}
  .row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin:7px 0}
  .note{font-size:11px;line-height:1.45;color:#999;margin:8px 0 0}
  .small{font-size:10px;color:#888;line-height:1.4}

  .edit-ui.floating-window{position:fixed;z-index:25;pointer-events:auto!important;resize:both;overflow:hidden;min-width:180px;min-height:42px;box-sizing:border-box}
  .floating-window .window-header{height:28px;display:flex;align-items:center;justify-content:space-between;gap:8px;margin:-6px -6px 10px;padding:4px 6px;border-bottom:1px solid rgba(255,255,255,.14);cursor:move;user-select:none;background:rgba(255,255,255,.04);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--gold)}
  .floating-window .window-title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .floating-window .window-minimize{width:26px;height:22px;padding:0;line-height:1;background:#151515;border:1px solid #444;color:#eee;font:14px/1 monospace;cursor:pointer;flex:0 0 auto}
  .floating-window .window-body{overflow:auto;max-height:calc(100% - 38px)}
  .floating-window.is-minimized{height:36px!important;min-height:36px;resize:none}
  .floating-window.is-minimized .window-body{display:none}
  body.play-mode .edit-ui{display:none!important}
  #objectPanel{right:410px;top:14px;width:310px;max-height:calc(100vh - 28px);padding:14px;border:1px solid var(--line);background:var(--panel);box-shadow:0 18px 50px rgba(0,0,0,.55);backdrop-filter:blur(10px);font-size:11px}
  #lightPanel{right:738px;top:14px;width:340px;max-height:calc(100vh - 28px);padding:14px;border:1px solid var(--line);background:var(--panel);box-shadow:0 18px 50px rgba(0,0,0,.55);backdrop-filter:blur(10px);font-size:11px}
  #chiselPanel{left:14px;top:196px;width:330px;max-height:calc(100vh - 250px);padding:14px;border:1px solid rgba(216,192,127,.35);background:var(--panel);box-shadow:0 18px 50px rgba(0,0,0,.55);backdrop-filter:blur(10px);font-size:11px}
  #tumorPanel{right:410px;top:14px;width:330px;max-height:calc(100vh - 28px);padding:14px;border:1px solid rgba(224,88,142,.45);background:rgba(12,6,10,.92);box-shadow:0 18px 50px rgba(0,0,0,.55);backdrop-filter:blur(10px);font-size:11px}
  #sinProSectionInfection #tumorPanel.sin-pro-embedded-tumor{position:static!important;inset:auto!important;display:block!important;width:auto;max-width:none;max-height:none;padding:0;border:0;background:transparent;box-shadow:none;backdrop-filter:none;font-size:inherit;}
  #sinProSectionInfection #tumorPanel.sin-pro-embedded-tumor h1{display:none}
  #sinProSectionInfection #tumorPanel.sin-pro-embedded-tumor .small{margin:10px 0 0;color:var(--muted)}
  #objectList{display:flex;flex-direction:column;gap:5px;margin-top:8px;user-select:none;-webkit-user-select:none}
  #objectList *:not(.object-rename-input){user-select:none;-webkit-user-select:none}
  .object-row{display:grid;grid-template-columns:1fr 58px 58px;gap:5px;align-items:center;padding:5px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.035);user-select:none;-webkit-user-select:none}
  .object-row[data-selected="true"]{border-color:rgba(216,192,127,.7);background:rgba(216,192,127,.11)}
  .object-row[data-multiselected="true"]{border-color:rgba(126,190,255,.75);background:rgba(126,190,255,.10)}
  .object-row[data-type="objectGroup"]{border-color:rgba(216,192,127,.32);background:rgba(216,192,127,.055)}
  .object-row[data-depth="1"]{margin-left:18px;border-left:3px solid rgba(216,192,127,.35);background:rgba(255,255,255,.025)}
  .object-row[data-locked="true"] .object-name{color:#777}
  .object-row[data-visible="false"] .object-name{opacity:.45;text-decoration:line-through}
  .object-name{cursor:pointer;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;line-height:1.25;user-select:none;-webkit-user-select:none}
  .object-name .group-arrow{display:inline-block;width:16px;color:var(--gold)}
  .object-rename-input{width:100%;min-width:0;padding:4px 6px;background:#050505;border:1px solid rgba(216,192,127,.75);color:#fff;font:11px Arial,'Noto Sans TC',sans-serif}
  .object-type{display:block;color:#888;font-size:10px;margin-top:2px}
  .object-row button{font-size:10px;padding:5px 3px}


  #screenFxOverlay{position:fixed;inset:0;z-index:4;pointer-events:none;opacity:0;mix-blend-mode:normal;background:transparent;transform:translate3d(0,0,0);will-change:opacity,transform,filter;background-size:100% 100%,180px 180px,100% 3px}
  #screenFxOverlay::before{content:"";position:absolute;inset:-4px;opacity:var(--fx-scan-opacity,0);background:repeating-linear-gradient(to bottom,rgba(255,255,255,.16) 0 1px,rgba(0,0,0,.12) 1px 3px,transparent 3px 5px);mix-blend-mode:overlay;transform:translateY(var(--fx-scan-y,0px));}
  #screenFxOverlay::after{content:"";position:absolute;inset:-18px;opacity:var(--fx-noise-opacity,0);background-image:var(--fx-noise-url);background-size:160px 160px;mix-blend-mode:overlay;transform:translate3d(var(--fx-noise-x,0px),var(--fx-noise-y,0px),0);filter:contrast(1.35)}
  body.fx-enabled #canvas{filter:var(--fx-canvas-filter,none);transform:translate3d(var(--fx-jitter-x,0px),var(--fx-jitter-y,0px),0) scale(var(--fx-scale,1));transform-origin:50% 50%;}
  body.fx-enabled #screenFxOverlay{opacity:var(--fx-overlay-opacity,0);background-image:radial-gradient(circle at 50% 50%,transparent 0%,transparent calc(58% - var(--fx-vignette-size,0%)),rgba(0,0,0,var(--fx-vignette-opacity,0)) 100%),linear-gradient(120deg,rgba(var(--fx-wash-r,255),var(--fx-wash-g,255),var(--fx-wash-b,255),var(--fx-wash-a,0)),rgba(var(--fx-wash2-r,0),var(--fx-wash2-g,0),var(--fx-wash2-b,0),var(--fx-wash2-a,0)));}
  body.fx-enabled.fx-vhs #screenFxOverlay{mix-blend-mode:screen;}
  body.fx-enabled.fx-dreamcore #screenFxOverlay{mix-blend-mode:soft-light;}
  body.fx-enabled.fx-weirdcore #screenFxOverlay{mix-blend-mode:difference;}

  #mobileControls{position:fixed;left:0;top:0;z-index:60;display:none;width:100vw;height:100vh;pointer-events:none;user-select:none;-webkit-user-select:none;touch-action:none}
  #mobileMovePad,#mobileJumpButton{position:absolute;box-sizing:border-box;transform:translate(-50%,-50%);overflow:visible;pointer-events:auto;touch-action:none;backdrop-filter:blur(4px);background:color-mix(in srgb,var(--pixel-paper,#f4d66f) 72%,transparent);border:1px solid var(--pixel-paper,#f4d66f);box-shadow:0 0 0 1px color-mix(in srgb,var(--pixel-ink,#14263d) 78%,transparent),0 0 12px color-mix(in srgb,var(--pixel-paper,#f4d66f) 24%,transparent)}
  #mobileMovePad{width:94px;height:94px;border-radius:999px}
  #mobileMovePad::after,#mobileJumpButton::after{content:"";position:absolute;inset:0;z-index:3;border-radius:inherit;background-image:radial-gradient(circle,var(--pixel-ink,#14263d) 0 .52px,transparent .74px);background-size:2px 2px;mix-blend-mode:multiply;opacity:.82;pointer-events:none}
  #mobileMoveKnob{position:absolute;left:33%;top:33%;z-index:2;width:34%;height:34%;border-radius:999px;background:var(--pixel-ink,#14263d);border:1px solid var(--pixel-paper,#f4d66f);box-shadow:0 0 8px color-mix(in srgb,var(--pixel-paper,#f4d66f) 42%,transparent);transform:translate3d(0,0,0);pointer-events:none}
  #mobileJumpButton{width:59px;height:59px;border-radius:999px;color:transparent;font-size:0;display:block;padding:0}
  body.sin-mobile-controls-hidden #mobileMovePad,body.sin-mobile-controls-hidden #mobileJumpButton{display:none!important}
  .sin-mobile-layout-outline{position:absolute;inset:0;z-index:8;display:none;box-sizing:border-box;border:1px dashed var(--pixel-paper,#f4d66f);border-radius:inherit;box-shadow:0 0 9px var(--pixel-paper,#f4d66f);pointer-events:none}
  .sin-mobile-layout-handle{position:absolute;width:13px;height:13px;border:1px solid var(--pixel-ink,#14263d);background:var(--pixel-paper,#f4d66f);box-shadow:0 0 7px var(--pixel-paper,#f4d66f);transform:translate(-50%,-50%);pointer-events:auto;touch-action:none}
  .sin-mobile-layout-handle[data-handle="nw"]{left:0;top:0;cursor:nwse-resize}.sin-mobile-layout-handle[data-handle="n"]{left:50%;top:0;cursor:ns-resize}.sin-mobile-layout-handle[data-handle="ne"]{left:100%;top:0;cursor:nesw-resize}
  .sin-mobile-layout-handle[data-handle="e"]{left:100%;top:50%;cursor:ew-resize}.sin-mobile-layout-handle[data-handle="se"]{left:100%;top:100%;cursor:nwse-resize}.sin-mobile-layout-handle[data-handle="s"]{left:50%;top:100%;cursor:ns-resize}
  .sin-mobile-layout-handle[data-handle="sw"]{left:0;top:100%;cursor:nesw-resize}.sin-mobile-layout-handle[data-handle="w"]{left:0;top:50%;cursor:ew-resize}
  #sinMobileLayoutToolbar{position:absolute;left:50%;top:12px;z-index:20;display:none;grid-template-columns:auto auto auto;gap:7px;transform:translateX(-50%);pointer-events:auto}
  #sinMobileLayoutToolbar button,#sinMobileLayoutSelectionLabel{width:auto;min-width:76px;padding:8px 11px;border:1px solid var(--pixel-paper,#f4d66f);border-radius:3px;background:color-mix(in srgb,var(--pixel-ink,#14263d) 90%,transparent);color:var(--pixel-paper,#f4d66f);box-shadow:0 0 8px color-mix(in srgb,var(--pixel-paper,#f4d66f) 32%,transparent);font:12px/1.2 'SinTowerTypography','Noto Sans TC',sans-serif;text-align:center}
  body.sin-mobile-layout-editing #sinProEditor{display:none!important}
  body.sin-mobile-layout-editing #mobileControls{display:block!important;z-index:265;pointer-events:auto}
  body.sin-mobile-layout-editing #mobileControls [data-mobile-layout-target]{cursor:move;pointer-events:auto}
  body.sin-mobile-layout-editing #mobileControls [data-mobile-layout-target].selected .sin-mobile-layout-outline{display:block}
  body.sin-mobile-layout-editing #sinMobileLayoutToolbar{display:grid}
  body.exported-viewer .edit-ui{display:none!important}
  body.exported-viewer #mobileControls{display:flex}
  #viewerEscHint{position:fixed;right:18px;top:18px;z-index:62;display:none;padding:8px 10px;border:1px solid rgba(255,255,255,.22);border-radius:10px;background:rgba(0,0,0,.38);color:rgba(255,255,255,.82);font:12px/1.2 Arial,'Noto Sans TC',sans-serif;letter-spacing:.04em;pointer-events:none;backdrop-filter:blur(6px)}
  body.exported-viewer #viewerEscHint{display:block}
  @media (hover:none), (pointer:coarse), (max-width:820px){
    #mobileControls{display:block}
    #editor,#objectPanel,#lightPanel{max-width:calc(100vw - 28px);width:calc(100vw - 28px);right:14px;left:auto}
  }


  #sandStackScreenOverlay{position:fixed;left:50%;top:50%;z-index:95;display:none;pointer-events:none;transform:translate(-50%,-50%);font-family:Arial,'Noto Sans TC',sans-serif}
  #sandStackScreenOverlay .sand-stack-ring{position:absolute;left:50%;top:50%;width:140px;height:140px;border:2px solid rgba(255,222,126,.95);border-radius:999px;transform:translate(-50%,-50%);box-shadow:0 0 0 1px rgba(0,0,0,.55),0 0 24px rgba(255,210,92,.22);background:radial-gradient(circle,rgba(255,209,88,.07),rgba(255,209,88,.015) 58%,transparent 61%)}
  #sandStackScreenOverlay .sand-stack-cross{position:absolute;left:50%;top:50%;width:16px;height:16px;transform:translate(-50%,-50%)}
  #sandStackScreenOverlay .sand-stack-cross:before,#sandStackScreenOverlay .sand-stack-cross:after{content:"";position:absolute;background:rgba(255,242,188,.96);box-shadow:0 0 5px rgba(0,0,0,.7)}
  #sandStackScreenOverlay .sand-stack-cross:before{left:7px;top:0;width:2px;height:16px}
  #sandStackScreenOverlay .sand-stack-cross:after{left:0;top:7px;width:16px;height:2px}
  #sandStackScreenOverlay .sand-stack-handle{position:absolute;left:50%;bottom:50%;width:7px;height:88px;transform:translateX(-50%);background:linear-gradient(to top,rgba(255,220,112,.36),rgba(255,245,186,.98));border-radius:6px;box-shadow:0 0 0 1px rgba(0,0,0,.55),0 0 18px rgba(255,220,112,.45)}
  #sandStackScreenOverlay .sand-stack-knob{position:absolute;left:50%;bottom:calc(50% + 88px);width:18px;height:18px;border-radius:999px;transform:translate(-50%,50%);background:rgba(255,236,154,.98);box-shadow:0 0 0 2px rgba(0,0,0,.55),0 0 18px rgba(255,220,112,.7)}
  #sandStackScreenOverlay .sand-stack-label{position:absolute;left:50%;top:calc(50% + 84px);transform:translateX(-50%);white-space:nowrap;color:#fff3c3;background:rgba(0,0,0,.68);border:1px solid rgba(255,220,112,.48);padding:6px 8px;font:12px/1.25 monospace;text-shadow:0 1px 2px #000}

  body.sin-pro-editor-active:not(.sin-pro-show-legacy) #hud,
  body.sin-pro-editor-active:not(.sin-pro-show-legacy) #editor,
  body.sin-pro-editor-active:not(.sin-pro-show-legacy) #tumorPanel,
  body.sin-pro-editor-active:not(.sin-pro-show-legacy) #sinTowerAssetPanel,
  body.sin-pro-editor-active:not(.sin-pro-show-legacy) #sinTowerFirePanel,
  body.sin-pro-editor-active:not(.sin-pro-show-legacy) #objectPanel,
  body.sin-pro-editor-active:not(.sin-pro-show-legacy) #lightPanel,
  body.sin-pro-editor-active:not(.sin-pro-show-legacy) #chiselPanel{display:none!important}
  body.play-mode #sinProEditor{display:none!important}
  #sinProEditor{position:fixed;left:8px;top:8px;z-index:70;width:min(1040px,calc(100vw - 16px));height:calc(100vh - 16px);min-width:min(560px,calc(100vw - 16px));min-height:min(360px,calc(100vh - 16px));max-width:calc(100vw - 8px);max-height:calc(100vh - 8px);display:grid;grid-template-columns:minmax(220px,250px) minmax(0,1fr);grid-template-rows:48px minmax(0,1fr);resize:both;overflow:hidden;background:rgba(8,9,10,.96);border:1px solid rgba(216,192,127,.30);box-shadow:18px 0 50px rgba(0,0,0,.42);font:12px/1.35 Arial,'Noto Sans TC',sans-serif;color:#e8e1cf;backdrop-filter:blur(10px)}
  #sinProEditor button,#sinProEditor input,#sinProEditor select{width:100%;box-sizing:border-box;border:1px solid rgba(255,255,255,.15);background:#101112;color:#eee;padding:7px;font:12px Arial,'Noto Sans TC',sans-serif}
  #sinProEditor .sin-pro-resize-handle{position:absolute;right:0;bottom:0;z-index:40;width:26px;height:26px;box-sizing:border-box;cursor:nwse-resize;touch-action:none;pointer-events:auto;background:linear-gradient(135deg,transparent 0 45%,var(--pixel-ink) 46% 52%,transparent 53% 61%,var(--pixel-ink) 62% 68%,transparent 69%)}
  #sinProEditor button{cursor:pointer;background:#17191b}
  #sinProEditor button:hover{border-color:rgba(216,192,127,.55)}
  #sinProEditor button.ok{border-color:rgba(118,193,139,.58);color:#dff8e5}
  #sinProEditor button.danger{border-color:rgba(214,102,102,.62);color:#ffd8d8}
  #sinProEditor input[type="range"]{padding:0}
  #sinProEditor input[type="color"]{height:30px;padding:2px}
  .sin-pro-top{grid-column:1/3;display:flex;align-items:center;gap:8px;padding:0 10px;border-bottom:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.03)}
  .sin-pro-title{font-weight:700;letter-spacing:.04em;color:#f0d893;white-space:nowrap}
  .sin-pro-top .sin-pro-spacer{flex:1}
  .sin-pro-top button{width:auto;min-width:82px;padding:6px 10px}
  #sinProSave{min-width:158px;font-weight:900}
  #sinProSave[aria-busy="true"]{opacity:.72;cursor:wait}
  #sinProSaveBadge{max-width:190px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:4px 7px;border:1px solid rgba(255,255,255,.16);font-size:10px;line-height:1;color:#c9c9c9}
  #sinProSaveBadge.pending{color:#f0d893;border-color:rgba(240,216,147,.45)}
  #sinProSaveBadge.saved{color:#a9e2ad;border-color:rgba(169,226,173,.35)}
  #sinProSaveBadge.error{color:#ff9a9a;border-color:rgba(255,154,154,.45)}
  @media(max-width:980px){#sinProSaveBadge{display:none}}
  .sin-pro-sidebar{overflow:auto;border-right:1px solid rgba(255,255,255,.10);padding:12px;background:rgba(0,0,0,.22)}
  .sin-pro-inspector{min-width:0;overflow:auto;padding:0 16px 20px}
  .sin-pro-tabs{position:sticky;top:0;z-index:4;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px;margin:0 -16px 14px;padding:10px 16px;background:rgba(8,9,10,.98);border-bottom:1px solid rgba(255,255,255,.10)}
  .sin-pro-tab{padding:8px 4px;font-size:11px;min-height:32px}
  .sin-pro-tab.active{border-color:rgba(216,192,127,.70);background:rgba(216,192,127,.13);color:#ffe6a8}
  .sin-pro-section{display:none}
  .sin-pro-section.active{display:block}
  .sin-pro-heading{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#d8c07f;margin:12px 0 7px}
  .sin-pro-list{display:flex;flex-direction:column;gap:5px;margin-bottom:8px}
  .sin-pro-list button{display:flex;justify-content:space-between;gap:8px;text-align:left}
  .sin-pro-list button.active{border-color:rgba(216,192,127,.70);background:rgba(216,192,127,.13)}
  .sin-pro-object-tools{display:grid;grid-template-columns:minmax(0,1fr) 88px;gap:6px;margin:0 0 8px}
  .sin-pro-object-tools input,.sin-pro-object-tools select{min-width:0;padding:6px}
  .sin-pro-group-row{border-style:dashed!important;background:rgba(216,192,127,.055)!important;color:#dfd4ba!important}
  .sin-pro-badge{color:#aaa;font-size:10px;white-space:nowrap}
  .sin-pro-grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .sin-pro-grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
  .sin-pro-field{display:grid;grid-template-columns:112px 1fr;gap:8px;align-items:center;margin:7px 0;color:#bdb7a8}
  .sin-pro-field.compact{grid-template-columns:1fr}
  .sin-pro-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}
  .sin-pro-muted{color:#8e887b;font-size:11px}
  .sin-pro-help{display:block;color:#8e887b;font-size:10px;line-height:1.45;margin-top:3px}
  .sin-pro-cave-callout{margin:8px 0 10px;padding:9px 10px;border:1px solid rgba(216,192,127,.28);background:rgba(216,192,127,.07);color:#c9c0ad;font-size:11px;line-height:1.5}
  .sin-pro-cave-callout strong{display:block;color:#f0d893;margin-bottom:3px}
  .sin-pro-perf-intro{margin:0 0 10px;padding:10px 11px;border-left:3px solid rgba(216,192,127,.72);background:rgba(216,192,127,.08);color:#c9c0ad;line-height:1.55}
  .sin-pro-perf-intro strong{display:block;color:#f0d893;margin-bottom:3px}
  .sin-pro-perf-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:8px 0 12px}
  .sin-pro-perf-card{padding:8px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.035);min-height:54px}
  .sin-pro-perf-card strong{display:block;color:#eee4cb;font-size:11px;margin-bottom:3px}
  .sin-pro-perf-card span{color:#9e988d;font-size:10px;line-height:1.4}
  .sin-pro-advanced{margin:10px 0;border:1px solid rgba(255,255,255,.12);background:rgba(0,0,0,.14)}
  .sin-pro-advanced summary{cursor:pointer;padding:8px 10px;color:#cfc6b2}
  .sin-pro-advanced[open]{padding:0 10px 8px}
  .sin-pro-file-state{display:block;min-height:18px;margin:4px 0 7px;color:#bdb5a7;font-size:11px;line-height:1.35;word-break:break-word}
  .sin-pro-file-preview{display:none;width:84px;height:52px;object-fit:cover;margin:4px 0 8px;border:1px solid rgba(216,192,127,.45);background:#151515}
  #sinPerfPortalPasswordGifPreview{width:100%;height:180px;object-fit:contain;background:#050505;box-sizing:border-box}
  #sinPerfPortalPasswordGifPreview.portal-preview-filtered{filter:url(#sinPortalMonoFilter)}
  .sin-pro-range-control{display:grid;grid-template-columns:minmax(0,1fr) 52px;gap:8px;align-items:center}
  .sin-pro-range-control input{min-width:0;padding:0!important}
  .sin-pro-range-control output{text-align:right;color:var(--pixel-ink,#14263d);font:700 11px/1 monospace}
  #sinPerfPortalPasswordSlotsPreview{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;width:min(320px,82%);margin:0 auto 10px;--portal-preview-text-scale:1.55;--portal-preview-text-weight:900}
  #sinPerfPortalPasswordSlotsPreview span{display:grid;place-items:center;min-height:42px;box-sizing:border-box;border:1px solid var(--portal-paper,#f4d66f);border-radius:4px;background:var(--portal-ink,#14263d);color:var(--portal-paper,#f4d66f);font-family:'SinTowerTypography',serif;font-size:calc(22px * var(--portal-preview-text-scale));font-weight:var(--portal-preview-text-weight);line-height:1}
  #sinPerfPortalPasswordSlotsPreview span:last-child{background:var(--portal-paper,#f4d66f);color:var(--portal-ink,#14263d);box-shadow:0 0 9px var(--portal-paper,#f4d66f)}
  .sin-pro-file-preview.ready{display:block}
  .sin-pro-control-group{margin:0 0 10px;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.025)}
  .sin-pro-control-group>summary{display:flex;align-items:center;justify-content:space-between;gap:8px;cursor:pointer;padding:10px 12px;color:#f0d893;font-weight:700;list-style:none}
  .sin-pro-control-group>summary::-webkit-details-marker{display:none}
  .sin-pro-control-group>summary::after{content:'+';color:#9e988d;font:15px/1 monospace}
  .sin-pro-control-group[open]>summary{border-bottom:1px solid rgba(255,255,255,.10)}
  .sin-pro-control-group[open]>summary::after{content:'−'}
  .sin-pro-control-group-body{padding:10px 12px 12px}
  .sin-pro-control-group .sin-pro-heading{display:none}
  .sin-pro-section>.sin-pro-heading:first-child{margin-top:2px}
  .sin-pro-section.active{max-width:760px;margin:0 auto}
  .sin-stone-pick-panel{position:fixed;right:18px;top:18px;z-index:82;display:none;width:min(300px,calc(100vw - 36px));padding:13px;border:1px solid rgba(216,192,127,.55);background:rgba(10,11,12,.94);box-shadow:0 14px 40px rgba(0,0,0,.4);color:#eee4cf;font:12px/1.45 Arial,'Noto Sans TC',sans-serif;backdrop-filter:blur(10px)}
  body.sin-stone-pick-mode .sin-stone-pick-panel,
  body.play-mode.sin-stone-pick-mode .sin-stone-pick-panel{display:block!important}
  .sin-stone-pick-title{font-weight:700;color:#f0d893;margin-bottom:6px}
  .sin-stone-pick-selected{padding:7px 8px;margin:7px 0;border:1px solid rgba(255,255,255,.13);background:rgba(255,255,255,.04);color:#cfc6b2}
  .sin-stone-pick-panel input[type=file]{width:100%;box-sizing:border-box;margin:7px 0;padding:7px;border:1px solid rgba(255,255,255,.15);background:#101112;color:#eee}
  .sin-stone-pick-panel button{width:100%;box-sizing:border-box;padding:8px;border:1px solid rgba(255,255,255,.15);background:#17191b;color:#eee;cursor:pointer}
  .sin-stone-pick-panel button:hover{border-color:rgba(216,192,127,.65)}
  .sin-stone-pick-help{color:#9e988d;font-size:10px;line-height:1.5;margin-top:8px}
  @media (max-width:820px){
    #sinProEditor{left:4px;top:4px;width:calc(100vw - 8px);height:calc(100vh - 8px);min-width:min(360px,calc(100vw - 8px));min-height:320px;grid-template-columns:1fr;grid-template-rows:48px minmax(120px,176px) minmax(0,1fr);resize:both}
    .sin-pro-top{grid-column:1}
    .sin-pro-sidebar{border-right:0;border-bottom:1px solid rgba(255,255,255,.10)}
    .sin-pro-tabs{grid-template-columns:repeat(3,minmax(0,1fr))}
  }


  /* Sin Tower monochrome pixel language: warm paper and midnight ink. */
  :root{
    --pixel-paper:#f4d66f;
    --pixel-paper-deep:#dfbd57;
    --pixel-ink:#14263d;
    --pixel-ink-soft:#263b50;
    --bg:var(--pixel-paper);
    --panel:var(--pixel-paper);
    --line:var(--pixel-ink);
    --text:var(--pixel-ink);
    --muted:var(--pixel-ink-soft);
    --gold:var(--pixel-ink);
    --danger:var(--pixel-ink);
    --ok:var(--pixel-ink);
  }
  html,body{background:var(--pixel-paper);color:var(--pixel-ink);font-family:'Courier New','Noto Sans TC',monospace}
  #canvas{image-rendering:pixelated;image-rendering:crisp-edges;background:var(--pixel-paper)}
  ::selection{background:var(--pixel-ink);color:var(--pixel-paper)}
  #hud,#status,#editor,#objectPanel,#lightPanel,#chiselPanel,#tumorPanel,#sinTowerAssetPanel,#sinTowerFirePanel,
  #sinProEditor,.sin-stone-pick-panel{
    background:var(--pixel-paper)!important;
    color:var(--pixel-ink)!important;
    border:2px solid var(--pixel-ink)!important;
    border-radius:0!important;
    box-shadow:6px 6px 0 var(--pixel-ink)!important;
    backdrop-filter:none!important;
  }
  #hud,#status{background:var(--pixel-paper)!important;text-shadow:none!important}
  #sinProEditor{font-family:'Courier New','Noto Sans TC',monospace}
  #sinProEditor button,#sinProEditor input,#sinProEditor select,
  .edit-ui button,.edit-ui input,.edit-ui select,.sin-stone-pick-panel button,.sin-stone-pick-panel input{
    background:var(--pixel-paper)!important;
    color:var(--pixel-ink)!important;
    border:2px solid var(--pixel-ink)!important;
    border-radius:0!important;
    box-shadow:none!important;
    font-family:'Courier New','Noto Sans TC',monospace!important;
  }
  #sinProEditor button:hover,#sinProEditor button.active,.edit-ui button:hover,
  .sin-pro-list button.active,.sin-pro-tab.active{
    background:var(--pixel-ink)!important;
    color:var(--pixel-paper)!important;
  }
  #sinProEditor button.ok,#sinProEditor button.danger,.edit-ui button.ok,.edit-ui button.danger{
    border-color:var(--pixel-ink)!important;
    color:var(--pixel-ink)!important;
  }
  #sinProEditor button.ok:hover,#sinProEditor button.danger:hover,.edit-ui button.ok:hover,.edit-ui button.danger:hover{
    color:var(--pixel-paper)!important;
  }
  #sinProEditor input[type='range'],.edit-ui input[type='range']{accent-color:var(--pixel-ink)}
  .sin-pro-top,.sin-pro-sidebar,.sin-pro-tabs,.sin-pro-control-group,.sin-pro-control-group>summary,
  .sin-pro-perf-card,.sin-pro-advanced,.sin-pro-group-row,.object-row,.floating-window .window-header{
    background:var(--pixel-paper)!important;
    border-color:var(--pixel-ink)!important;
    color:var(--pixel-ink)!important;
  }
  .sin-pro-title,.sin-pro-heading,.sin-pro-field,.sin-pro-muted,.sin-pro-help,.sin-pro-badge,
  .sin-pro-control-group>summary,.sin-pro-file-state,.small,.note,h1,h2,label,
  .sin-pro-cave-callout,.sin-pro-cave-callout strong,.sin-pro-perf-intro,.sin-pro-perf-intro strong{
    color:var(--pixel-ink)!important;
    text-shadow:none!important;
  }
  .sin-pro-cave-callout,.sin-pro-perf-intro{
    background:repeating-conic-gradient(var(--pixel-paper-deep) 0 25%,var(--pixel-paper) 0 50%) 0/4px 4px!important;
    border:2px solid var(--pixel-ink)!important;
  }
  #sinProEditor ::-webkit-scrollbar,.edit-ui ::-webkit-scrollbar{width:12px;height:12px}
  #sinProEditor ::-webkit-scrollbar-track,.edit-ui ::-webkit-scrollbar-track{background:var(--pixel-paper)}
  #sinProEditor ::-webkit-scrollbar-thumb,.edit-ui ::-webkit-scrollbar-thumb{background:var(--pixel-ink);border:2px solid var(--pixel-paper)}




  /* Play-mode object authoring and diegetic interaction pages. */
  #sinPlayAddButton{position:fixed;right:24px;bottom:24px;z-index:86;display:none;width:62px;height:62px;padding:0;border:3px solid var(--pixel-ink);border-radius:0;background:var(--pixel-paper);color:var(--pixel-ink);box-shadow:7px 7px 0 var(--pixel-ink);font:900 40px/1 monospace;align-items:center;justify-content:center;cursor:pointer}
  #sinPlayAddButton:hover{transform:translate(-2px,-2px);box-shadow:9px 9px 0 var(--pixel-ink)}
  body.play-mode:not(.sin-play-add-open):not(.sin-interaction-open) #sinPlayAddButton{display:none!important}
  body.exported-viewer #sinPlayAddButton{display:none!important}
  #sinPlayAddPanel{position:fixed;right:18px;top:18px;bottom:18px;z-index:90;display:none;width:min(430px,calc(100vw - 36px));box-sizing:border-box;overflow:hidden;border:3px solid var(--pixel-ink);background:var(--pixel-paper);color:var(--pixel-ink);box-shadow:10px 10px 0 var(--pixel-ink);font:12px/1.4 Arial,'Noto Sans TC',sans-serif}
  body.sin-play-add-open #sinPlayAddPanel{display:flex;flex-direction:column}
  #sinPlayAddPanel header{display:flex;align-items:center;gap:10px;padding:10px 12px;border-bottom:3px solid var(--pixel-ink);background:var(--pixel-ink);color:var(--pixel-paper)}
  #sinPlayAddPanel header strong{flex:1;font-size:14px;letter-spacing:.08em}
  #sinPlayAddPanel header button{width:34px;height:30px;padding:0;border:2px solid var(--pixel-paper);background:transparent;color:var(--pixel-paper);font:700 18px/1 monospace}
  .sin-play-add-body{overflow:auto;padding:10px 14px 18px;scrollbar-color:var(--pixel-ink) var(--pixel-paper-deep)}
  #sinPlayAddPanel label{display:grid;grid-template-columns:118px minmax(0,1fr);gap:8px;align-items:center;margin:8px 0;color:var(--pixel-ink);font-size:11px}
  #sinPlayAddPanel input,#sinPlayAddPanel select,#sinPlayAddPanel textarea,#sinPlayAddPanel button{box-sizing:border-box;width:100%;border:2px solid var(--pixel-ink);border-radius:0;background:#f8df83;color:var(--pixel-ink);padding:7px;font:12px/1.35 monospace}
  #sinPlayAddPanel textarea{min-height:118px;resize:vertical;font-family:Arial,'Noto Sans TC',sans-serif}
  #sinPlayAddPanel input[type=checkbox]{width:20px;height:20px;justify-self:end;accent-color:var(--pixel-ink)}
  #sinPlayAddPanel input[type=range]{padding:0;accent-color:var(--pixel-ink)}
  .sin-play-section{margin:12px 0 0;padding-top:10px;border-top:2px dashed var(--pixel-ink)}
  .sin-play-section-title{font-weight:800;letter-spacing:.06em;margin-bottom:7px}
  .sin-play-coordinate{display:grid;grid-template-columns:20px minmax(0,1fr) 82px;gap:7px;align-items:center;margin:6px 0}
  .sin-play-coordinate b{text-align:center}
  .sin-play-coordinate input{min-width:0}
  .sin-play-note{margin:7px 0;color:var(--pixel-ink-soft);font-size:10px;line-height:1.55}
  #sinPlayCreateObject{margin-top:14px;padding:11px;background:var(--pixel-ink);color:var(--pixel-paper);font-weight:800;letter-spacing:.08em}
  #sinPlayAddPanel:not([data-media='png']) .sin-play-png-source,#sinPlayAddPanel:not([data-media='gif']) .sin-play-gif-source,#sinPlayAddPanel:not([data-media='video']) .sin-play-video-source,#sinPlayAddPanel:not([data-media='model']) .sin-play-model-source,#sinPlayAddPanel:not([data-media='portal']) .sin-play-portal-source,#sinPlayAddPanel:not([data-media='model']) .sin-play-model-transform,#sinPlayAddPanel[data-media='model'] .sin-play-billboard-only,#sinPlayAddPanel[data-media='model'] .sin-play-repeat-section,#sinPlayAddPanel[data-media='portal'] .sin-play-billboard-only,#sinPlayAddPanel[data-media='portal'] .sin-play-model-transform,#sinPlayAddPanel[data-media='portal'] .sin-play-repeat-section,#sinPlayAddPanel[data-media='portal'] .sin-play-interaction-section{display:none}
  .sin-play-portal-source{margin:9px 0;padding:8px;border:2px solid var(--pixel-ink);background:rgba(255,255,255,.12)}
  .sin-play-portal-source .sin-play-coordinate{margin:0}
  #sinPlayInteractionFields[hidden],#sinPlayTextFields[hidden],#sinPlayMediaFields[hidden],#sinPlayRepeatFields[hidden]{display:none!important}

  #sinInteractionOverlay{position:fixed;inset:0;z-index:94;display:none;align-items:center;justify-content:center;padding:5vh 5vw;box-sizing:border-box;background:rgba(4,7,10,.38);opacity:0;transition:opacity 1s ease;pointer-events:auto}
  #sinInteractionOverlay.opening,#sinInteractionOverlay.open,#sinInteractionOverlay.closing{display:flex}
  #sinInteractionOverlay.open{opacity:1}
  #sinInteractionOverlay.opening,#sinInteractionOverlay.closing{opacity:0}
  #sinInteractionOverlay .sin-interaction-paper{opacity:0;transform:translateY(12px) scale(.985);transition:opacity 1s ease,transform 1s ease}
  #sinInteractionOverlay.open .sin-interaction-paper{opacity:1;transform:translateY(0) scale(1)}
  .sin-interaction-paper{position:relative;width:min(760px,90vw);max-height:84vh;box-sizing:border-box;padding:34px 36px 30px;background:#d1b66d url('data:image/jpeg;base64,') center/cover no-repeat;color:#271f17;filter:drop-shadow(14px 16px 0 rgba(13,23,35,.72));border:1px solid rgba(61,43,24,.55);border-radius:3px;box-shadow:0 18px 48px rgba(8,12,16,.55)}
  .sin-interaction-paper::before{content:'';position:absolute;inset:0;pointer-events:none;opacity:.6;background:radial-gradient(circle at 12% 16%,rgba(72,43,20,.22),transparent 17%),radial-gradient(circle at 84% 77%,rgba(66,38,15,.2),transparent 20%),repeating-linear-gradient(8deg,rgba(74,46,20,.025) 0 2px,transparent 2px 7px);mix-blend-mode:multiply}
  #sinInteractionClose{position:absolute;right:25px;top:22px;z-index:2;width:38px;height:34px;padding:0;border:2px solid #271f17;border-radius:clamp(1px,calc(var(--sin-doc-radius,6px)*.55),10px);background:rgba(3,3,3,var(--sin-doc-opacity,.85));color:#271f17;font:900 19px/1 monospace;cursor:pointer}
  #sinInteractionTitle{position:relative;margin:0 50px 18px 0;padding-bottom:11px;border-bottom:2px solid rgba(39,31,23,.7);font:800 clamp(22px,4vw,38px)/1.1 Georgia,'Noto Serif TC',serif;letter-spacing:.06em}
  #sinInteractionScroll{position:relative;max-height:63vh;overflow:auto;padding:2px 16px 14px 2px;white-space:pre-wrap;font:18px/1.9 Georgia,'Noto Serif TC',serif;scrollbar-color:#493822 transparent}
  #sinInteractionMedia{position:relative;display:none;align-items:center;justify-content:center;max-height:64vh;overflow:hidden;background:#111b25;border:4px solid #271f17}
  #sinInteractionMedia.active{display:flex}
  #sinInteractionMedia img,#sinInteractionMedia video{display:none;max-width:100%;max-height:62vh;object-fit:contain;image-rendering:pixelated}
  #sinInteractionMedia img.active,#sinInteractionMedia video.active{display:block}
  #sinPlayObjectActions{position:fixed;right:18px;bottom:18px;z-index:96;display:none;width:min(330px,calc(100vw - 36px));box-sizing:border-box;border:3px solid var(--pixel-ink);background:var(--pixel-paper);color:var(--pixel-ink);box-shadow:9px 9px 0 var(--pixel-ink);font:12px/1.45 Arial,'Noto Sans TC',sans-serif;pointer-events:none}
  #sinPlayObjectActions.open{display:block}
  #sinPlayObjectActions header{display:flex;align-items:center;gap:8px;padding:9px 10px;border-bottom:3px solid var(--pixel-ink);background:var(--pixel-ink);color:var(--pixel-paper)}
  #sinSelectedPropTitle{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #sinSelectedPropClose{position:relative;z-index:3;width:32px;height:28px;padding:0;border:2px solid var(--pixel-paper);background:transparent;color:var(--pixel-paper);pointer-events:auto}
  .sin-selected-prop-body{padding:11px;pointer-events:none}
  .sin-selected-prop-actions{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1fr;gap:7px}
  .sin-selected-prop-actions button{position:relative;z-index:3;padding:9px;border:2px solid var(--pixel-ink);background:#f8df83;color:var(--pixel-ink);pointer-events:auto}
  #sinSelectedPropDelete{grid-column:1/-1;background:var(--pixel-ink);color:var(--pixel-paper)}
  .sin-selected-prop-scale{margin:10px 0 2px;padding:9px;border:2px solid var(--pixel-ink);background:#f8df83;pointer-events:auto}
  .sin-selected-prop-scale label{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:0 0 7px;font:800 12px/1.3 monospace}
  #sinSelectedPropScale{display:block;width:100%;height:24px;padding:0;border:0;background:transparent;accent-color:var(--pixel-ink);pointer-events:auto}
  #sinSelectedPropScaleValue{font-weight:400;font-variant-numeric:tabular-nums}
  #sinSelectedPropState{position:relative;z-index:1;margin:9px 0 0;color:var(--pixel-ink-soft);font:11px/1.55 monospace;pointer-events:none}
  #sinShortcutOverlay{position:fixed;inset:0;z-index:110;display:none;align-items:center;justify-content:center;padding:5vh 5vw;box-sizing:border-box;background:rgba(4,7,10,.64)}
  #sinShortcutOverlay.open{display:flex}
  .sin-shortcut-card{position:relative;width:min(820px,94vw);max-height:88vh;overflow:auto;box-sizing:border-box;padding:28px 30px;border:4px solid var(--pixel-ink);background:var(--pixel-paper);color:var(--pixel-ink);box-shadow:12px 12px 0 var(--pixel-ink)}
  .sin-shortcut-card h2{margin:0 46px 18px 0;color:var(--pixel-ink)!important;font:900 24px/1.1 monospace}
  #sinShortcutClose{position:absolute;right:18px;top:16px;width:36px;height:32px;padding:0;border:2px solid var(--pixel-ink);background:transparent;color:var(--pixel-ink)}
  .sin-shortcut-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px 24px}
  .sin-shortcut-row{display:grid;grid-template-columns:142px 1fr;gap:9px;padding:7px 0;border-bottom:1px dashed rgba(23,42,58,.45)}
  .sin-shortcut-row kbd{font:800 12px/1.3 monospace}
  .sin-pro-scene-row{display:grid;grid-template-columns:minmax(0,1fr) 34px;gap:5px;margin-bottom:5px}
  .sin-pro-scene-row>button{margin:0!important}
  .sin-pro-scene-delete{padding:4px!important;border-color:var(--danger)!important;color:var(--danger)!important}
  @media(max-width:650px){.sin-shortcut-grid{grid-template-columns:1fr}.sin-shortcut-card{padding:22px 18px}.sin-shortcut-row{grid-template-columns:112px 1fr}}
  @media(max-width:620px){#sinPlayAddPanel{right:0;top:0;bottom:0;width:100vw}.sin-interaction-paper{padding:28px 22px 24px}#sinInteractionScroll{font-size:16px}.sin-play-coordinate{grid-template-columns:18px minmax(0,1fr) 72px}}

  /* v108: game-palette VHS document frame and live object controls */
  .sin-interaction-paper{--sin-interaction-font:Georgia,'Noto Serif TC',serif;--sin-interaction-title-size:38px;--sin-interaction-body-size:18px;--hud-light:#f4d66f;--hud-dark:#030303;box-sizing:border-box;width:min(620px,calc(100vw - 42px));max-height:82vh;padding:38px 36px 30px;background:repeating-linear-gradient(0deg,rgba(244,214,111,.018) 0 1px,transparent 1px 3px),radial-gradient(circle at 50% 20%,rgba(244,214,111,.055),transparent 57%),var(--hud-dark)!important;background-image:repeating-linear-gradient(0deg,rgba(244,214,111,.018) 0 1px,transparent 1px 3px),radial-gradient(circle at 50% 20%,rgba(244,214,111,.055),transparent 57%)!important;color:var(--hud-light)!important;border:0!important;border-radius:0!important;box-shadow:0 0 0 1px rgba(244,214,111,.28),0 0 11px rgba(244,214,111,.36),0 0 28px rgba(244,214,111,.14),inset 0 0 22px rgba(244,214,111,.055)!important;filter:none!important;isolation:isolate;overflow:hidden}
  .sin-interaction-paper::before{content:'';position:absolute;inset:8px;z-index:0!important;pointer-events:none;opacity:1!important;border:1px solid rgba(244,214,111,.92)!important;background:none!important;mix-blend-mode:normal!important;box-shadow:0 0 4px rgba(244,214,111,.78),0 0 10px rgba(244,214,111,.26),inset 0 0 4px rgba(244,214,111,.18);-webkit-mask-image:repeating-linear-gradient(to bottom,#000 0 2.55px,transparent 2.55px 2.8px,#000 2.8px 5px);mask-image:repeating-linear-gradient(to bottom,#000 0 2.55px,transparent 2.55px 2.8px,#000 2.8px 5px)}
  .sin-interaction-paper::after{content:'';position:absolute;inset:0;z-index:0;pointer-events:none;opacity:1;background:radial-gradient(circle at 9px 9px,#fff8d4 0 1.5px,#f4d66f 1.7px 2.7px,transparent 3.8px),radial-gradient(circle at calc(100% - 9px) 9px,#fff8d4 0 1.5px,#f4d66f 1.7px 2.7px,transparent 3.8px),radial-gradient(circle at 9px calc(100% - 9px),#fff8d4 0 1.5px,#f4d66f 1.7px 2.7px,transparent 3.8px),radial-gradient(circle at calc(100% - 9px) calc(100% - 9px),#fff8d4 0 1.5px,#f4d66f 1.7px 2.7px,transparent 3.8px),repeating-linear-gradient(to bottom,transparent 0 2.55px,rgba(0,0,0,.34) 2.55px 2.8px,transparent 2.8px 5px);filter:drop-shadow(0 0 4px rgba(244,214,111,.85))}
  #sinInteractionClose,#sinInteractionTitle,#sinInteractionScroll,#sinInteractionMedia{z-index:1;color:var(--hud-light)!important;text-shadow:0 0 2px #fff4bb,0 0 7px rgba(244,214,111,.82),0 0 14px rgba(244,214,111,.28)}
  #sinInteractionClose{border:1px solid var(--hud-light)!important;border-radius:clamp(1px,calc(var(--sin-doc-radius,6px)*.55),10px)!important;background:rgba(3,3,3,var(--sin-doc-opacity,.85))!important;box-shadow:0 0 6px rgba(244,214,111,.56),inset 0 0 5px rgba(244,214,111,.12)}
  #sinInteractionTitle{margin-right:42px!important;padding-bottom:14px!important;border:0!important;font-family:var(--sin-interaction-font)!important;font-size:var(--sin-interaction-title-size)!important;letter-spacing:.045em!important;background:linear-gradient(var(--hud-light),var(--hud-light)) bottom left/100% 1px no-repeat!important;filter:drop-shadow(0 0 4px rgba(244,214,111,.56))}
  #sinInteractionScroll{font-family:var(--sin-interaction-font)!important;font-size:var(--sin-interaction-body-size)!important;color:var(--hud-light)!important;scrollbar-color:#f4d66f #050505}
  #sinInteractionMedia{border:1px solid var(--hud-light)!important;background:#020202!important;box-shadow:0 0 9px rgba(244,214,111,.35)}
  .sin-selected-interaction-style{display:grid;gap:8px;margin-top:9px;padding:10px;border:2px solid var(--ink);background:rgba(255,255,255,.13);pointer-events:auto}
  .sin-selected-interaction-style[hidden],.sin-selected-text-only[hidden],#sinSelectedDriftFields[hidden]{display:none!important}
  .sin-selected-interaction-style label{display:grid;grid-template-columns:minmax(0,1fr) 110px;align-items:center;gap:8px}
  .sin-selected-interaction-style select,.sin-selected-interaction-style input[type=range]{width:100%;min-width:0}
  .sin-selected-interaction-style input[type=checkbox]{width:18px;height:18px;justify-self:end;accent-color:var(--pixel-ink)}
  .sin-selected-particle-density{grid-template-columns:minmax(0,1fr) 56px!important}
  .sin-selected-particle-density output{text-align:right;font:12px/1.2 monospace}
  .sin-selected-particle-density input{grid-column:1/-1}
  .sin-selected-drift #sinSelectedDriftFields{display:grid;gap:7px}
  .sin-selected-drift #sinSelectedDriftFields>label{grid-template-columns:78px 42px minmax(0,1fr)}
  .sin-selected-axis{display:grid;grid-template-columns:1fr repeat(3,44px);align-items:center;gap:4px}
  .sin-selected-axis label{display:flex!important;grid-template-columns:none!important;justify-content:center;gap:3px}
  #sinPlayObjectActions{max-height:calc(100vh - 36px);overflow:hidden}
  .sin-selected-prop-body{max-height:calc(100vh - 100px);overflow:auto}
  .sin-model-uniform-scale{display:grid;gap:6px;padding:8px;border:2px solid var(--ink)}
  .sin-model-uniform-scale label{display:flex;justify-content:space-between;gap:8px}


  /* v109: codec-safe capture, stair jump, per-object document VHS and RPG questions */
  @keyframes sinDocVhsScan{0%{background-position:0 0}100%{background-position:0 var(--sin-doc-vhs-line-size,3px)}}
  @keyframes sinQuestionEnter{from{opacity:0;transform:translate(-50%,18px)}to{opacity:1;transform:translate(-50%,0)}}
  #sinInteractionOverlay{background:rgba(0,0,0,.18)}
  .sin-interaction-paper{--sin-doc-opacity:.85;--sin-doc-vhs-line-size:3px;--sin-doc-vhs-noise:.24;--sin-doc-vhs-speed:1.2s;--hud-light:var(--pixel-paper,#f4d66f);--hud-dark:#030303;background:repeating-linear-gradient(to bottom,rgba(244,214,111,.055) 0 1px,transparent 1px var(--sin-doc-vhs-line-size)),radial-gradient(circle at 50% 16%,rgba(244,214,111,.07),transparent 58%),rgba(3,3,3,var(--sin-doc-opacity))!important;background-image:repeating-linear-gradient(to bottom,rgba(244,214,111,.055) 0 1px,transparent 1px var(--sin-doc-vhs-line-size)),radial-gradient(circle at 50% 16%,rgba(244,214,111,.07),transparent 58%)!important;filter:url(#sinInteractionVhsFilter) drop-shadow(0 0 10px rgba(244,214,111,.35))!important}
  .sin-interaction-paper::before{-webkit-mask-image:repeating-linear-gradient(to bottom,#000 0 calc(var(--sin-doc-vhs-line-size) - .72px),transparent calc(var(--sin-doc-vhs-line-size) - .72px) var(--sin-doc-vhs-line-size))!important;mask-image:repeating-linear-gradient(to bottom,#000 0 calc(var(--sin-doc-vhs-line-size) - .72px),transparent calc(var(--sin-doc-vhs-line-size) - .72px) var(--sin-doc-vhs-line-size))!important;filter:url(#sinInteractionVhsBorderFilter) drop-shadow(0 0 4px rgba(244,214,111,.9))!important}
  .sin-interaction-paper::after{background:radial-gradient(circle at 9px 9px,#fff8d4 0 1.5px,var(--hud-light) 1.7px 2.7px,transparent 3.8px),radial-gradient(circle at calc(100% - 9px) 9px,#fff8d4 0 1.5px,var(--hud-light) 1.7px 2.7px,transparent 3.8px),radial-gradient(circle at 9px calc(100% - 9px),#fff8d4 0 1.5px,var(--hud-light) 1.7px 2.7px,transparent 3.8px),radial-gradient(circle at calc(100% - 9px) calc(100% - 9px),#fff8d4 0 1.5px,var(--hud-light) 1.7px 2.7px,transparent 3.8px),repeating-linear-gradient(to bottom,transparent 0 calc(var(--sin-doc-vhs-line-size) - 1px),rgba(244,214,111,.38) calc(var(--sin-doc-vhs-line-size) - 1px) var(--sin-doc-vhs-line-size))!important;opacity:var(--sin-doc-vhs-noise)!important;animation:sinDocVhsScan var(--sin-doc-vhs-speed) steps(2,end) infinite}
  .sin-selected-vhs-controls{border:1px solid var(--pixel-ink);background:rgba(3,3,3,.08);pointer-events:auto}
  .sin-selected-vhs-controls>summary{cursor:pointer;padding:7px 8px;font-weight:800;list-style:none}
  .sin-selected-vhs-controls>summary::-webkit-details-marker{display:none}
  .sin-selected-vhs-controls>summary::after{content:' ＋';float:right}
  .sin-selected-vhs-controls[open]>summary::after{content:' −'}
  .sin-selected-vhs-body{display:grid;gap:7px;padding:8px;border-top:1px solid var(--pixel-ink)}
  .sin-selected-vhs-body label{grid-template-columns:82px 44px minmax(0,1fr)!important}
  .sin-selected-vhs-body output{text-align:right;font:11px/1 monospace}
  #sinSelectedInteractionPreview,#sinSelectedQuestionAdd{padding:7px;border:1px solid var(--pixel-ink);background:var(--pixel-ink);color:var(--pixel-paper);pointer-events:auto}
  .sin-selected-text-content .sin-selected-vhs-body label{grid-template-columns:82px minmax(0,1fr)!important;align-items:start!important}
  .sin-selected-text-content input,.sin-selected-text-content textarea{box-sizing:border-box;width:100%;min-width:0;border:1px solid var(--pixel-ink);background:#f8df83;color:var(--pixel-ink);font:12px/1.45 monospace;pointer-events:auto}
  .sin-selected-text-content textarea{min-height:110px;resize:vertical}
  #sinSelectedQuestionEditor{display:grid;gap:7px;padding-top:7px;border-top:1px dashed var(--pixel-ink)}
  #sinSelectedQuestionEditor[hidden]{display:none!important}
  #sinSelectedQuestionDraft{box-sizing:border-box;width:100%;min-height:58px;resize:vertical;border:1px solid var(--pixel-ink);background:#f8df83;color:var(--pixel-ink);font:12px/1.4 monospace;pointer-events:auto}
  #sinSelectedQuestionList{display:grid;gap:5px}
  .sin-question-edit-row{display:grid;grid-template-columns:minmax(0,1fr) 34px;gap:5px;align-items:start;padding:6px;border:1px solid rgba(20,38,61,.55);background:rgba(255,255,255,.16)}
  .sin-question-edit-row span{word-break:break-word}
  .sin-question-edit-row textarea{box-sizing:border-box;width:100%;min-width:0;min-height:56px;resize:vertical;padding:5px 7px;border:1px solid rgba(20,38,61,.72);background:#f8df83;color:var(--pixel-ink);font:12px/1.45 monospace;pointer-events:auto}
  .sin-question-edit-row textarea:focus{outline:2px solid var(--pixel-ink);outline-offset:1px}
  .sin-question-edit-row button{width:34px;padding:3px;border:1px solid var(--pixel-ink);background:transparent;color:var(--pixel-ink);pointer-events:auto}
  .sin-audio-controls{border:1px solid var(--pixel-ink);background:rgba(3,3,3,.06);pointer-events:auto}
  .sin-audio-controls>summary{cursor:pointer;padding:7px 8px;font-weight:900;list-style:none}
  .sin-audio-controls>summary::-webkit-details-marker{display:none}.sin-audio-controls>summary::after{content:' ＋';float:right}.sin-audio-controls[open]>summary::after{content:' −'}
  .sin-audio-body{display:grid;gap:7px;padding:8px;border-top:1px solid var(--pixel-ink)}
  .sin-audio-body label{display:grid;grid-template-columns:96px minmax(0,1fr);align-items:center;gap:7px}
  .sin-audio-body input[type=file]{min-width:0;width:100%}.sin-audio-body output{text-align:right;font:11px/1 monospace}.sin-audio-body button{padding:7px;border:1px solid var(--pixel-ink);background:var(--pixel-ink);color:var(--pixel-paper);pointer-events:auto}
  #sinStairJumpOverlay{position:fixed;inset:0;z-index:125;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.34);pointer-events:auto}
  #sinStairJumpOverlay.open{display:flex}
  .sin-stair-jump-card{position:relative;z-index:1;pointer-events:auto;width:min(390px,calc(100vw - 36px));box-sizing:border-box;padding:18px;border:3px solid var(--pixel-ink);background:var(--pixel-paper);color:var(--pixel-ink);box-shadow:10px 10px 0 var(--pixel-ink)}
  .sin-stair-jump-card h2{margin:0 0 12px;color:var(--pixel-ink)!important;font:900 18px/1.2 monospace}
  .sin-stair-jump-card label{display:grid;grid-template-columns:110px 1fr;align-items:center;gap:8px;color:var(--pixel-ink)}
  .sin-stair-jump-card input,.sin-stair-jump-card button{box-sizing:border-box;width:100%;padding:9px;border:2px solid var(--pixel-ink);background:#f8df83;color:var(--pixel-ink);font:13px/1.2 monospace}
  .sin-stair-jump-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
  #sinStairJumpGo{background:var(--pixel-ink);color:var(--pixel-paper)}
  #sinQuestionOverlay{position:fixed;inset:0;z-index:98;display:none;pointer-events:none}
  #sinQuestionOverlay.open{display:block}
  .sin-question-bar{--sin-question-drag-x:0px;--sin-doc-opacity:.9;--sin-doc-vhs-line-size:3px;--sin-doc-vhs-noise:.24;--sin-doc-vhs-speed:1.2s;--sin-question-font-size:23px;--sin-question-text-opacity:1;position:absolute;left:50%;bottom:5vh;transform:translateX(-50%);width:min(980px,calc(100vw - 38px));box-sizing:border-box;padding:17px 24px 15px;border:1px solid var(--pixel-paper);background:repeating-linear-gradient(to bottom,rgba(244,214,111,.04) 0 1px,transparent 1px var(--sin-doc-vhs-line-size)),rgba(3,3,3,var(--sin-doc-opacity));color:var(--pixel-paper);filter:url(#sinInteractionVhsFilter);box-shadow:0 0 8px rgba(244,214,111,.5),0 0 28px rgba(244,214,111,.18),inset 0 0 18px rgba(244,214,111,.06);pointer-events:auto;touch-action:none;animation:sinQuestionEnter .28s ease-out both;transition:opacity .85s ease,transform .85s ease}
  .sin-question-bar::before{content:'';position:absolute;inset:5px;pointer-events:none;border:1px solid rgba(244,214,111,.48);background:repeating-linear-gradient(to bottom,rgba(244,214,111,.035) 0 1px,transparent 1px 3px)}
  #sinQuestionClose{position:absolute;right:9px;top:7px;z-index:3;width:30px;height:26px;padding:0;border:1px solid var(--pixel-paper);border-radius:clamp(1px,calc(var(--sin-doc-radius,6px)*.55),10px);background:rgba(3,3,3,var(--sin-doc-opacity,.85));color:var(--pixel-paper);pointer-events:auto}
  #sinQuestionContent{position:relative;z-index:1;transform:translateX(var(--sin-question-drag-x));transition:transform .13s ease,opacity .13s ease;will-change:transform}
  .sin-question-bar.dragging #sinQuestionContent{transition:none}
  #sinQuestionText{padding:3px 42px 12px;text-align:center;font:700 var(--sin-question-font-size)/1.45 Georgia,'Noto Serif TC',serif;opacity:var(--sin-question-text-opacity);overflow-wrap:anywhere;text-shadow:0 0 8px rgba(244,214,111,.56)}
  .sin-question-choices{display:flex;justify-content:space-between;border-top:1px solid rgba(244,214,111,.5);padding-top:8px;font:900 12px/1 monospace;letter-spacing:.14em}
  .sin-question-choices button{appearance:none;border:0;padding:6px 10px;background:transparent;font:inherit;letter-spacing:inherit;cursor:pointer;pointer-events:auto;text-shadow:0 0 7px currentColor}
  .sin-question-choices button:hover,.sin-question-choices button:focus-visible{outline:1px solid currentColor;background:rgba(244,214,111,.08)}
  .sin-question-no{color:#d5bd72}.sin-question-yes{color:#fff1a6}
  .sin-question-bar[data-direction='no']{box-shadow:0 0 12px rgba(191,108,82,.7),0 0 32px rgba(191,108,82,.2)}
  .sin-question-bar[data-direction='yes']{box-shadow:0 0 12px rgba(244,214,111,.8),0 0 32px rgba(244,214,111,.25)}
  /* Adjustable single-border document and RPG dialogue frames. */
  .sin-interaction-paper{--sin-doc-radius:6px;border-radius:var(--sin-doc-radius)!important}
  .sin-interaction-paper::before{display:none!important}
  .sin-interaction-paper::after{border-radius:var(--sin-doc-radius)}
  .sin-question-bar{--sin-doc-radius:6px;border-radius:var(--sin-doc-radius);overflow:hidden}
  .sin-question-bar::before{display:none!important}
  #sinQuestionText.typing::after{content:'▋';display:inline-block;margin-left:.12em;color:var(--pixel-paper);animation:sinDocVhsScan .48s steps(2,end) infinite}
  #sinQuestionOverlay.closing .sin-question-bar{animation:none;opacity:0;transform:translate(-50%,12px)}
  .sin-question-bar.answered .sin-question-choices{opacity:0;transition:opacity .2s ease}

  /* v112: fixed-size scrollable RPG question panel. */
  .sin-question-bar{height:clamp(210px,30vh,270px);min-height:clamp(210px,30vh,270px);max-height:clamp(210px,30vh,270px)}
  #sinQuestionContent{height:100%;min-height:0;display:flex;flex-direction:column}
  #sinQuestionText{box-sizing:border-box;flex:1 1 auto;min-height:0;overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;scrollbar-gutter:stable;padding-right:42px}
  #sinQuestionText::-webkit-scrollbar{width:8px}
  #sinQuestionText::-webkit-scrollbar-track{background:rgba(244,214,111,.08);border-left:1px solid rgba(244,214,111,.18)}
  #sinQuestionText::-webkit-scrollbar-thumb{background:var(--pixel-paper);border:2px solid #030303;border-radius:8px;box-shadow:0 0 5px rgba(244,214,111,.45)}
  .sin-question-choices{flex:0 0 auto}


  #sinPortalPasswordOverlay{position:fixed;inset:0;z-index:240;display:none;place-items:center;overflow:hidden;background:#050403;color:#f7db70;isolation:isolate}
  #sinPortalPasswordOverlay.open{display:grid}
  #sinPortalPasswordSky{position:absolute;inset:-3%;width:106%;height:106%;object-fit:cover;filter:brightness(.48) contrast(1.32) saturate(.62) sepia(.24);transform:scale(1.02);z-index:-3}
  #sinPortalPasswordOverlay::before{content:"";position:absolute;inset:0;z-index:-2;background:radial-gradient(circle at 50% 45%,rgba(3,3,2,.18) 0 30%,rgba(2,2,1,.78) 78%,#020201 100%),repeating-linear-gradient(0deg,rgba(247,219,112,.035) 0 1px,transparent 1px 4px);pointer-events:none}
  #sinPortalPasswordOverlay::after{content:"";position:absolute;inset:0;z-index:-1;box-shadow:inset 0 0 18vmin 6vmin #000;pointer-events:none}
  .sin-portal-password-shell{position:relative;height:min(92vh,960px);aspect-ratio:3/4;max-width:90vw;filter:drop-shadow(0 0 15px rgba(247,219,112,.22));animation:sinPortalGateBreathe 3.8s ease-in-out infinite}
  #sinPortalPasswordFrame{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;image-rendering:auto;filter:sepia(.44) saturate(1.35) hue-rotate(358deg) brightness(.92) contrast(1.15)}
  .sin-portal-password-console{position:absolute;left:14.5%;right:12%;top:29%;bottom:18%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:clamp(10px,1.8vh,22px);padding:clamp(18px,3vh,34px);box-sizing:border-box;background:radial-gradient(ellipse at center,rgba(8,7,4,.8),rgba(0,0,0,.97) 72%);border:1px solid rgba(247,219,112,.24);box-shadow:inset 0 0 34px rgba(247,219,112,.08);clip-path:polygon(2% 0,97% 1%,100% 94%,94% 100%,4% 98%,0 7%)}
  .sin-portal-password-title{font:700 clamp(11px,1.45vh,16px)/1.2 "Courier New",monospace;letter-spacing:.42em;text-indent:.42em;color:#f7db70;text-shadow:0 0 8px rgba(247,219,112,.85)}
  #sinPortalPasswordSlots{display:flex;direction:ltr;gap:clamp(8px,1.4vw,17px);align-items:center;justify-content:center}
  .sin-portal-password-slot{position:relative;display:grid;place-items:center;width:clamp(50px,7.2vh,76px);height:clamp(66px,9.5vh,98px);border:1px solid rgba(247,219,112,.42);background:rgba(5,5,3,.82);font:700 clamp(34px,5.8vh,62px)/1 "Courier New",monospace;color:#e9e5d2;text-shadow:0 0 7px rgba(255,255,255,.6);box-shadow:inset 0 0 12px rgba(247,219,112,.08);transition:transform .13s ease,border-color .13s ease,box-shadow .13s ease,color .13s ease}
  .sin-portal-password-slot.selected{color:#fff1a6;border-color:#fff1a6;transform:translateY(-5px);box-shadow:0 0 12px rgba(247,219,112,.58),inset 0 0 16px rgba(247,219,112,.14)}
  .sin-portal-password-slot.selected::before,.sin-portal-password-slot.selected::after{position:absolute;left:50%;transform:translateX(-50%);color:#fff1a6;font:700 13px/1 monospace;text-shadow:0 0 5px currentColor}
  .sin-portal-password-slot.selected::before{content:"▲";top:-17px}.sin-portal-password-slot.selected::after{content:"▼";bottom:-17px}
  #sinPortalPasswordMessage{min-height:1.2em;margin:0;font:700 clamp(10px,1.35vh,14px)/1.3 "Courier New",monospace;letter-spacing:.16em;text-align:center;color:rgba(247,219,112,.78);text-shadow:0 0 6px rgba(247,219,112,.38)}
  #sinPortalPasswordOverlay.wrong .sin-portal-password-console{animation:sinPortalWrong .32s linear 1;border-color:#ff684f}
  #sinPortalPasswordOverlay.wrong #sinPortalPasswordMessage{color:#ff7660;text-shadow:0 0 7px #ff3b21}
  #sinPortalPasswordOverlay.success .sin-portal-password-console{border-color:#fff1a6;box-shadow:0 0 22px rgba(247,219,112,.36),inset 0 0 36px rgba(247,219,112,.16)}
  #sinPortalTransitionFade{position:fixed;inset:0;z-index:250;background:#000;opacity:0;pointer-events:none;transition-property:opacity;transition-duration:1000ms;transition-timing-function:ease-in-out}
  #sinPortalTransitionFade.opaque{opacity:1}
  @keyframes sinPortalGateBreathe{0%,100%{filter:drop-shadow(0 0 12px rgba(247,219,112,.18))}50%{filter:drop-shadow(0 0 22px rgba(247,219,112,.3))}}
  @keyframes sinPortalWrong{0%,100%{transform:translateX(0)}25%{transform:translateX(-7px)}75%{transform:translateX(7px)}}
  @media(max-width:620px){.sin-portal-password-shell{width:94vw;height:auto}.sin-portal-password-console{left:15%;right:12.5%;top:29%;bottom:18%;padding:14px}.sin-portal-password-slot{width:12vw;height:16vw;font-size:9vw}}

  /* Portrait-safe 9:16 game viewport. Scene coordinates stay unchanged; only projection and play UI are reflowed. */
  body.sin-portrait-game #canvas,body.sin-portrait-game #screenFxOverlay{inset:auto;left:var(--sin-game-left);top:var(--sin-game-top);width:var(--sin-game-width);height:var(--sin-game-height)}
  body.sin-portrait-game #sinInteractionOverlay,body.sin-portrait-game #sinQuestionOverlay,body.sin-portrait-game #sinStairJumpOverlay,body.sin-portrait-game #sinShortcutOverlay,body.sin-portrait-game #sinPortalPasswordOverlay,body.sin-portrait-game #sinPortalTransitionFade{inset:auto;left:var(--sin-game-left);top:var(--sin-game-top);width:var(--sin-game-width);height:var(--sin-game-height)}
  body.sin-portrait-game #sinPlayAddPanel{right:calc(100vw - var(--sin-game-left) - var(--sin-game-width) + 10px);top:calc(var(--sin-game-top) + 10px);bottom:auto;width:min(430px,calc(var(--sin-game-width) - 20px));height:calc(var(--sin-game-height) - 20px)}
  body.sin-portrait-game #sinPlayObjectActions{right:calc(100vw - var(--sin-game-left) - var(--sin-game-width) + 10px);bottom:calc(100vh - var(--sin-game-top) - var(--sin-game-height) + 10px);width:min(330px,calc(var(--sin-game-width) - 20px));max-height:calc(var(--sin-game-height) - 20px)}
  body.sin-portrait-game.play-mode #mobileControls,body.sin-portrait-game.exported-viewer #mobileControls,body.sin-portrait-game.sin-mobile-layout-editing #mobileControls{display:block;left:var(--sin-game-left);top:var(--sin-game-top);right:auto;bottom:auto;width:var(--sin-game-width);height:var(--sin-game-height)}
  body.sin-portrait-game #viewerEscHint{right:calc(100vw - var(--sin-game-left) - var(--sin-game-width) + 14px);top:calc(var(--sin-game-top) + 14px)}
  body.sin-portrait-game .sin-interaction-paper{width:calc(var(--sin-game-width) - 26px);max-height:calc(var(--sin-game-height) - 32px);padding:30px 22px 24px}
  body.sin-portrait-game #sinInteractionScroll{max-height:calc(var(--sin-game-height) - 180px)}
  body.sin-portrait-game .sin-question-bar{width:calc(var(--sin-game-width) - 22px);max-width:none;left:50%;bottom:calc(100vh - var(--sin-game-top) - var(--sin-game-height) + 12px)}
  body.sin-portrait-game .sin-shortcut-card{width:calc(var(--sin-game-width) - 24px);max-height:calc(var(--sin-game-height) - 34px)}
  body.sin-portrait-game .sin-portal-password-shell{width:94%;height:auto;max-width:94%;max-height:94%}
  #sinPortalPasswordOverlay{--portal-paper:#f4d66f;--portal-ink:#14263d;background:var(--portal-ink)}
  #sinPortalPasswordSky{filter:grayscale(1) brightness(.62) contrast(1.72);mix-blend-mode:screen}
  #sinPortalPasswordFrame{filter:grayscale(1) brightness(1.12) contrast(1.55);mix-blend-mode:screen}
  .sin-portal-password-console{background:transparent;border:0;box-shadow:none;clip-path:none}
  .sin-portal-password-title,#sinPortalPasswordMessage{display:none!important}
  #sinPortalPasswordCountdown{position:absolute;inset:0;z-index:0;display:grid;place-items:center;font:900 clamp(128px,27vh,290px)/1 "Courier New",monospace;color:var(--portal-paper);opacity:.13;letter-spacing:-.12em;text-indent:-.12em;text-shadow:0 0 24px var(--portal-paper);pointer-events:none}
  #sinPortalPasswordSlots{position:relative;z-index:2}
  .sin-portal-password-slot{border-color:color-mix(in srgb,var(--portal-paper) 48%,transparent);background:color-mix(in srgb,var(--portal-ink) 86%,transparent);color:var(--portal-paper)}
  .sin-portal-password-slot.selected{background:var(--portal-paper);color:var(--portal-ink);border-color:var(--portal-paper);text-shadow:none;box-shadow:0 0 18px var(--portal-paper),inset 0 0 0 2px var(--portal-ink)}
  .sin-portal-password-tone,.sin-portal-password-dither{position:absolute;inset:0;pointer-events:none}
  .sin-portal-password-tone{z-index:20;background:var(--portal-paper);mix-blend-mode:multiply;opacity:.94}
  .sin-portal-password-dither{z-index:21;background-image:radial-gradient(circle,var(--portal-paper) 0 .48px,transparent .68px),repeating-linear-gradient(0deg,transparent 0 2px,color-mix(in srgb,var(--portal-ink) 28%,transparent) 2px 3px);background-size:3px 3px,100% 3px;mix-blend-mode:screen;opacity:.28}

  /* Direct manipulation editor for the portal GIF and the four password cells. */
  .sin-portal-password-shell{position:absolute;height:auto;aspect-ratio:auto;max-width:none;max-height:none;transform:translate(-50%,-50%);touch-action:none}
  #sinPortalPasswordFrame{inset:0;width:100%;height:100%;object-fit:fill;pointer-events:none}
  .sin-portal-password-console{position:absolute;inset:0;display:block;padding:0;background:transparent;border:0;box-shadow:none;clip-path:none;pointer-events:none}
  #sinPortalPasswordGroup{position:absolute;z-index:2;transform:translate(-50%,-50%);touch-action:none;pointer-events:none}
  #sinPortalPasswordSlots{position:relative;width:100%;height:100%;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));align-items:stretch;justify-content:stretch;gap:var(--portal-slot-gap,10px)}
  .sin-portal-password-slot{box-sizing:border-box;width:100%;height:100%;min-width:0;font-size:var(--portal-slot-font-size,48px);border-radius:var(--portal-slot-radius,5px)}
  .sin-portal-layout-outline{position:absolute;inset:0;z-index:5;display:none;box-sizing:border-box;border:1px dashed var(--portal-paper);box-shadow:0 0 8px color-mix(in srgb,var(--portal-paper) 72%,transparent);pointer-events:none}
  .sin-portal-layout-handle{position:absolute;width:13px;height:13px;border:1px solid var(--portal-ink);background:var(--portal-paper);box-shadow:0 0 8px var(--portal-paper);transform:translate(-50%,-50%);pointer-events:auto;touch-action:none}
  .sin-portal-layout-handle[data-handle="nw"]{left:0;top:0;cursor:nwse-resize}.sin-portal-layout-handle[data-handle="n"]{left:50%;top:0;cursor:ns-resize}.sin-portal-layout-handle[data-handle="ne"]{left:100%;top:0;cursor:nesw-resize}
  .sin-portal-layout-handle[data-handle="e"]{left:100%;top:50%;cursor:ew-resize}.sin-portal-layout-handle[data-handle="se"]{left:100%;top:100%;cursor:nwse-resize}.sin-portal-layout-handle[data-handle="s"]{left:50%;top:100%;cursor:ns-resize}
  .sin-portal-layout-handle[data-handle="sw"]{left:0;top:100%;cursor:nesw-resize}.sin-portal-layout-handle[data-handle="w"]{left:0;top:50%;cursor:ew-resize}
  #sinPortalLayoutToolbar{position:absolute;z-index:45;left:50%;top:14px;display:none;gap:8px;transform:translateX(-50%);pointer-events:auto}
  #sinPortalLayoutToolbar button{min-width:88px;padding:8px 14px;border:1px solid var(--portal-paper);border-radius:3px;background:color-mix(in srgb,var(--portal-ink) 88%,transparent);color:var(--portal-paper);font:700 13px/1.2 Arial,'Noto Sans TC',sans-serif;box-shadow:0 0 9px color-mix(in srgb,var(--portal-paper) 35%,transparent);cursor:pointer}
  #sinPortalPasswordOverlay.layout-editing .sin-portal-password-shell{z-index:30;cursor:move;pointer-events:auto;animation:none}
  #sinPortalPasswordOverlay.layout-editing .sin-portal-password-console{z-index:31}
  #sinPortalPasswordOverlay.layout-editing #sinPortalPasswordGroup{cursor:move;pointer-events:auto}
  #sinPortalPasswordOverlay.layout-editing .sin-portal-layout-outline,#sinPortalPasswordOverlay.layout-editing #sinPortalLayoutToolbar{display:block}
  #sinPortalPasswordOverlay.layout-editing #sinPortalLayoutToolbar{display:flex}
  #sinPortalPasswordOverlay.layout-editing .sin-portal-password-tone,#sinPortalPasswordOverlay.layout-editing .sin-portal-password-dither{opacity:.12}

  /* Current password artwork: keep the four cipher cells clean below it, without a shared backplate. */
  #sinPortalPasswordOverlay.portal-fx-monopixel #sinPortalPasswordSky,#sinPortalPasswordOverlay.portal-fx-monopixel .sin-portal-password-shell{filter:url(#sinPortalMonoFilter)}
  #sinPortalPasswordOverlay::before,#sinPortalPasswordOverlay::after{content:none;display:none;background:none;box-shadow:none}
  #sinPortalPasswordSky{inset:0;width:100%;height:100%;transform:none;filter:none;mix-blend-mode:normal}
  .sin-portal-password-shell{filter:none;animation:none}
  #sinPortalPasswordFrame{object-fit:fill;filter:none;mix-blend-mode:normal}
  .sin-portal-password-tone,.sin-portal-password-dither{display:none!important}
  #sinPortalPasswordGroup{isolation:auto;filter:none}
  #sinPortalPasswordGroup::before{content:none;display:none}
  #sinPortalPasswordGroup::after{content:none;display:none}
  #sinPortalPasswordSlots{position:relative;z-index:2;padding:0;box-sizing:border-box}
  .sin-portal-password-slot{border:1px solid color-mix(in srgb,var(--portal-paper) 78%,#d7d8d4 22%);background:radial-gradient(circle at 50% 8%,color-mix(in srgb,var(--portal-paper) 17%,transparent),transparent 34%),repeating-linear-gradient(112deg,rgba(255,255,255,.025) 0 1px,transparent 1px 5px),linear-gradient(180deg,#161716 0,#030303 42%,#0b0c0b 100%);color:color-mix(in srgb,var(--portal-paper) 78%,#f3f4ed 22%);font-family:'SinTowerTypography',serif;font-weight:800;letter-spacing:.035em;text-shadow:0 0 5px currentColor,0 1px 0 #000;box-shadow:inset 0 0 0 1px rgba(0,0,0,.86),inset 0 0 10px color-mix(in srgb,var(--portal-paper) 14%,transparent),0 0 5px color-mix(in srgb,var(--portal-paper) 26%,transparent);transition:transform .13s ease,border-color .13s ease,box-shadow .13s ease,color .13s ease,background .13s ease}
  .sin-portal-password-slot.selected{background:radial-gradient(circle at 50% 38%,#fff 0 5%,color-mix(in srgb,var(--portal-paper) 88%,#e9e9e5 12%) 34%,color-mix(in srgb,var(--portal-paper) 56%,#7d7e79 44%) 100%);color:#050505;border-color:#fff;transform:translateY(-4px);text-shadow:0 1px 0 rgba(255,255,255,.46);box-shadow:0 0 13px var(--portal-paper),0 0 26px color-mix(in srgb,var(--portal-paper) 38%,transparent),inset 0 0 0 2px #080808}
  .sin-portal-password-slot{font-size:calc(var(--portal-slot-font-size,48px) * var(--portal-slot-text-scale,1.55));font-weight:var(--portal-slot-text-weight,900)}
  .sin-portal-password-slot.selected::before,.sin-portal-password-slot.selected::after{content:none;display:none}

  /* v135: four independently rendered ornate image cells, still transformed as one group. */
  #sinPortalPasswordSlots{overflow:visible}
  .sin-portal-password-slot{position:relative;isolation:isolate;overflow:hidden;border:0!important;border-radius:0!important;background:transparent!important;box-shadow:none!important;text-shadow:none;filter:none}
  .sin-portal-password-slot-art{position:absolute;z-index:0;left:50%;top:50%;width:178%;height:auto;max-width:none;max-height:none;transform:translate(-50%,-48%);object-fit:contain;mix-blend-mode:normal;opacity:.96;pointer-events:none;user-select:none;filter:url(#sinPortalSlotMonoFilter)}
  .sin-portal-password-character{position:relative;z-index:1;display:grid;place-items:center;width:42%;height:42%;border-radius:50%;background:color-mix(in srgb,var(--portal-ink) 82%,transparent);color:color-mix(in srgb,var(--portal-paper) 80%,#fff 20%);font:inherit;line-height:1;text-shadow:0 0 5px currentColor,0 1px 0 #000}
  .sin-portal-password-character-glyph{display:block;line-height:1;transform:translate(var(--portal-slot-text-offset-x,0%),var(--portal-slot-text-offset-y,-10%));will-change:transform}
  .sin-portal-password-slot.selected{border:0!important;background:transparent!important;box-shadow:none!important;transform:translateY(-4px);filter:drop-shadow(0 0 5px color-mix(in srgb,var(--portal-paper) 72%,transparent))}
  .sin-portal-password-slot.selected .sin-portal-password-slot-art{opacity:1;filter:url(#sinPortalSlotMonoFilter)}
  .sin-portal-password-slot.selected .sin-portal-password-character{background:var(--portal-paper);color:var(--portal-ink);text-shadow:none;box-shadow:0 0 7px var(--portal-paper),0 0 16px color-mix(in srgb,var(--portal-paper) 58%,transparent)}
  #sinPerfPortalPasswordSlotsPreview span.sin-portal-password-slot-preview{position:relative;isolation:isolate;overflow:hidden;min-height:58px;aspect-ratio:1;border:0;border-radius:0;background:transparent;color:var(--portal-paper,#f4d66f);box-shadow:none}
  .sin-portal-password-slot-preview-art{position:absolute;z-index:0;left:50%;top:50%;width:178%;height:auto;max-width:none;transform:translate(-50%,-48%);mix-blend-mode:normal;opacity:.96;pointer-events:none;filter:url(#sinPortalSlotMonoFilter)}
  #sinPerfPortalPasswordSlotsPreview span.sin-portal-password-slot-preview b{position:relative;z-index:1;display:grid;place-items:center;width:42%;height:42%;border-radius:50%;background:color-mix(in srgb,var(--portal-ink,#14263d) 82%,transparent);font:inherit;font-family:'SinTowerTypography',serif;font-size:calc(22px * var(--portal-preview-text-scale));font-weight:var(--portal-preview-text-weight);line-height:1}
  #sinPerfPortalPasswordSlotsPreview .sin-portal-password-character-glyph{display:block;line-height:1;transform:translate(var(--portal-slot-text-offset-x,0%),var(--portal-slot-text-offset-y,-10%));will-change:transform}
  #sinPerfPortalPasswordSlotsPreview span.sin-portal-password-slot-preview.selected{background:transparent;color:var(--portal-ink,#14263d);box-shadow:none;filter:drop-shadow(0 0 4px color-mix(in srgb,var(--portal-paper,#f4d66f) 72%,transparent))}
  #sinPerfPortalPasswordSlotsPreview span.sin-portal-password-slot-preview.selected .sin-portal-password-slot-preview-art{opacity:1;filter:url(#sinPortalSlotMonoFilter)}
  #sinPerfPortalPasswordSlotsPreview span.sin-portal-password-slot-preview.selected b{background:var(--portal-paper,#f4d66f);box-shadow:0 0 7px var(--portal-paper,#f4d66f)}
</style>
<script type="importmap">
