  }
}
</script>
</head>
<body class="sin-portrait-game fx-enabled fx-monopixel sin-pro-show-legacy sin-pro-editor-active" style="background: rgb(24, 21, 18); --sin-game-left: 475.47px; --sin-game-top: 0.00px; --sin-game-width: 329.06px; --sin-game-height: 585.00px; cursor: default;">
