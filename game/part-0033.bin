  const active = getSinTowerActiveScene?.();
  const infectionVisual = getSinTowerInfectionVisualStats?.();
  const activeStone = SIN_TOWER_EDITOR.selectedObjectType === 'stone'
    ? getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId, 'stone')
    : null;
  return JSON.stringify({
    coordinateSystem:'world: x right, y up, z forward/back',
    rps:sinRpsSession?{editing:sinRpsSession.editing,selected:SIN_RPS_KINDS[sinRpsSession.selected],remaining:Math.max(0,Math.ceil((sinRpsSession.deadline-performance.now())/1000)),revealed:sinRpsSession.revealed,opponent:sinRpsSession.revealed?sinRpsSession.opponent:null,outcome:sinRpsSession.outcome||null}:null,
    mode:isPlayMode() ? 'play' : 'edit',
    persistence:{lastSavedAt:sinTowerLastPersistence.lastSavedAt,browserVerified:!!sinTowerLastPersistence.browserVerified,lastExportAt:sinTowerLastPersistence.lastExportAt,lastFilename:sinTowerLastPersistence.lastFilename,lastExportBytes:sinTowerLastPersistence.lastExportBytes,persistentStorage:sinTowerLastPersistence.persistentStorage,assetCount:sinTowerLastPersistence.assetCount,restoredBackupId:sinTowerLastPersistence.restoredBackupId,saveInProgress:sinTowerCompleteSaveInProgress},
    display:{orientation:STATE?.displayOrientation||'landscape',viewport:getSinTowerGameViewport(),mobileControls:{hidden:sinTowerMobileControlsHidden,layoutEditing:sinTowerMobileLayoutEditor.active,selected:sinTowerMobileLayoutEditor.selected,layout:getSinTowerMobileControlsLayout()}},
    camera:{yaw:+camYaw.toFixed(4),pitch:+camPitch.toFixed(4),pointerLocked:!!pointerLocked,fallbackMouseLook:!!fallbackMouseLook,cursorFreeMode:!!cursorFreeMode,desiredPointerLocked:!!desiredPointerLocked,fallbackAxis:[+fallbackLookAxisX.toFixed(3),+fallbackLookAxisY.toFixed(3)]},
    activeScene:active ? {id:active.id,title:active.title,type:active.type,skybox:active.skybox?.color || null,hasSharedStoneTexture:!!active.sharedStoneTextureDataUrl,sharedStoneTextureName:active.sharedStoneTextureName || null,churchProfile:active.churchProfile || null,audio:{name:active.audio?.name||null,hasAudio:!!active.audio?.dataUrl,volume:safeFinite(active.audio?.volume,0),loop:active.audio?.loop!==false}} : null,
    player:{x:+player.position.x.toFixed(3), y:+player.position.y.toFixed(3), groundY:+safeFinite(getPlayerGroundY(),0).toFixed(3), z:+player.position.z.toFixed(3), step:getSinTowerCurrentStepIndex?.() ?? -1, speed:getPlayerMovementSpeed(), infectionLevel:Math.floor(SIN_TOWER_INFECTION.level || 0)},
    sinTower:{
      autoRun:isSinTowerAutoRunActive(),
      stairVisible:!!sinTowerStairGroup?.visible,
