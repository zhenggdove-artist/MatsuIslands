  }else{
    const bayZ=topology==='star'?[0]:topology==='greekCross'?[-d.d*.18,0,d.d*.18]:[-d.d*.26,-d.d*.08,d.d*.1,d.d*.28];
    bayZ.forEach((z,bay)=>{const span=topology==='star'?Math.min(d.w,d.d)*.35:d.w*.34;for(let i=0;i<9;i++){if(i>0&&i<8&&damaged(1350+bay*20+i,.42))continue;const a=i/8*Math.PI;add('roof',bay===0&&(i===0||i===4||i===8),'拱頂肋骨 '+(bay+1)+'-'+(i+1),'voussoir',{x:Math.cos(a)*span,y:roofBase+Math.sin(a)*span*.48,z},{x:Math.PI*span/8*1.08,y:.28,z:.34},{x:0,y:0,z:THREE.MathUtils.radToDeg(a+Math.PI/2)});}});
    add('roof',true,'中殿脊飾','cornice',{x:0,y:roofBase+Math.min(d.w*.18,2.6),z:(minZ+maxZ)*.5},{x:.42,y:.38,z:Math.max(4,(maxZ-minZ)*.74)});
  }
  const altarZ=minZ+Math.min(3,d.d*.12);
  add('altar',true,'祭壇下層','cornice',{x:0,y:.34,z:altarZ},{x:5,y:.68,z:2.45});add('altar',true,'祭壇上層','cornice',{x:0,y:.86,z:altarZ-.22},{x:4.15,y:.48,z:1.82});add('altar',true,profile.altarStyle,'carvedPanel',{x:0,y:2.55,z:altarZ-.85},{x:3.8,y:3.65,z:.34});
  for(const side of [-1,1]){add('altar',false,'祭壇欄柱 '+side,'baluster',{x:side*1.7,y:1.65,z:altarZ-.5},{x:.52,y:2.7,z:.52});add('altar',false,'祭壇渦卷 '+side,'rosette',{x:side*1.66,y:3.15,z:altarZ-.98},{x:.72,y:.2,z:.72},{x:90,y:0,z:0});}
  const crossY=Math.min(d.h*.65,5.9),crossZ=altarZ-1.08;
  add('cross',true,profile.crossStyle+' 縱樑','cornice',{x:0,y:crossY,z:crossZ},{x:.42,y:3.4,z:.38});add('cross',true,profile.crossStyle+' 橫樑','cornice',{x:0,y:crossY+.55,z:crossZ},{x:2.35,y:.42,z:.38});add('cross',false,'十字中央光輪','rosette',{x:0,y:crossY+.55,z:crossZ-.18},{x:1.05,y:.18,z:1.05},{x:90,y:0,z:0});
  const furnitureRows=topology==='rotunda'||topology==='oval'?4:6;
  for(let row=0;row<furnitureRows;row++){if(row>1&&damaged(1510+row,.7))continue;const z=maxZ-d.d*.2-row*d.d*.085;for(const side of [-1,1]){const x=side*Math.min(d.w*.2,3.3);add('furniture',row===0,'雕花長椅座 '+(row+1)+'-'+side,'cornice',{x,y:.62,z},{x:Math.min(d.w*.31,4.5),y:.18,z:.68},{x:jitter(1540+row+side,2),y:jitter(1570+row+side,3),z:0},'free',dark,false);add('furniture',false,'雕花長椅背 '+(row+1)+'-'+side,'carvedPanel',{x,y:1.12,z:z+.29},{x:Math.min(d.w*.31,4.5),y:.88,z:.14},{x:-7,y:jitter(1600+row+side,3),z:0},'free',dark,false);for(const leg of [-1,1])add('furniture',false,'長椅欄柱 '+row+'-'+side+'-'+leg,'baluster',{x:x+leg*Math.min(d.w*.12,1.55),y:.34,z},{x:.22,y:.62,z:.22},undefined,'free',dark,false);}}
  const desiredRubble=clamp(Math.round(5+decay*targetCount*.27),5,Math.floor(targetCount*.34));
  for(let i=0;i<desiredRubble+36;i++){const angle=random(1710+i)*Math.PI*2,radius=.32+random(1740+i)*.7,x=Math.cos(angle)*d.w*.48*radius,z=Math.sin(angle)*d.d*.46*radius;if(!inside(x,z)&&random(1770+i)>.35)continue;const sx=.28+random(1800+i)*1.05,sy=.16+random(1830+i)*.62,sz=.3+random(1860+i)*1.1;add('rubble',false,'雕刻殘片 '+(i+1),random(1890+i)>.72?'capital':random(1920+i)>.48?'slab':'boulder',{x,y:sy*.52,z},{x:sx,y:sy,z:sz},{x:jitter(1950+i,18),y:random(1980+i)*360,z:jitter(2010+i,18)});}
  const structuralRoles=roles.filter(role=>role!=='rubble'),essentials=structuralRoles.flatMap(role=>buckets[role].essential),optionals=structuralRoles.flatMap(role=>buckets[role].optional).sort((a,b)=>sinTowerRand(a.seed+seed*.013)-sinTowerRand(b.seed+seed*.013)),rubble=buckets.rubble.optional.sort((a,b)=>sinTowerRand(a.seed+seed*.017)-sinTowerRand(b.seed+seed*.017));
  const structureBudget=Math.max(essentials.length,targetCount-desiredRubble),stones=essentials.slice(0,targetCount);stones.push(...optionals.slice(0,Math.max(0,Math.min(structureBudget,targetCount)-stones.length)));stones.push(...rubble.slice(0,Math.max(0,targetCount-stones.length)));if(stones.length<targetCount)stones.push(...optionals.slice(Math.max(0,structureBudget-essentials.length),Math.max(0,structureBudget-essentials.length)+targetCount-stones.length));
  const finalStones=stones.slice(0,targetCount),counts=Object.fromEntries(roles.map(role=>[role,finalStones.filter(stone=>stone.generatedRole===role).length]));active.churchProfile=sanitizeSinTowerChurchProfile({...profile,counts});
  SIN_TOWER_EDITOR.stones=SIN_TOWER_EDITOR.stones.filter(item=>item.sceneId!==active.id||!item.generated).concat(finalStones);SIN_TOWER_EDITOR.activeSceneId=active.id;
  if(finalStones[0]){SIN_TOWER_EDITOR.selectedObjectType='stone';SIN_TOWER_EDITOR.selectedObjectId=finalStones[0].id;}
  rebuildSinTowerEditorRuntime();if(player){placePlayerAtSinTowerSceneSpawn(active);updateCamera();}syncSinProEditor();scheduleSinTowerRuntimeSave();setStatus('已生成 '+profile.floorPlan+'：'+profile.columnStyle+'／'+profile.roofStyle+'／'+profile.windowStyle+'；完整度 '+profile.completeness+'%，共 '+finalStones.length+' 個可編輯構件。');
}

function renameSinTowerListEntry(target,kind){
  if(!target)return false;
  const focused=document.activeElement;
  if(focused&&focused!==document.body&&typeof focused.blur==='function')focused.blur();
  const canonical=kind==='場景'?(getSinTowerSceneById(target.id)||target):(getSinTowerEditorObjectById(target.id)||target);
  const current=String(canonical.title||'').trim();
  const next=window.prompt('重新命名'+kind,current);
  if(next===null)return false;
  const clean=String(next).trim().slice(0,80);
  if(!clean){setStatus(kind+'名稱不能是空白。');return false;}
  if(clean===current){syncSinProEditor();return false;}
  canonical.title=clean;
  if(target!==canonical)target.title=clean;
  const propRec=sinTowerEditorRuntime.props.get(canonical.id),modelRec=sinTowerEditorRuntime.models.get(canonical.id),portalRec=sinTowerEditorRuntime.portals.get(canonical.id),stoneRec=sinTowerEditorRuntime.stones?.get?.(canonical.id);
  if(propRec){propRec.prop=canonical;propRec.root.name=clean;for(const visual of propRec.visuals||[])visual.group.name=clean;}
  if(modelRec){modelRec.model=canonical;modelRec.group.name=clean;}
  if(portalRec){portalRec.portal=canonical;if(portalRec.group)portalRec.group.name=clean;}
  if(stoneRec?.mesh)stoneRec.mesh.name=clean;
  syncSinProEditor();
  scheduleSinTowerRuntimeSave();
  void saveSinTowerRuntimeStateNow();
  setStatus('已將'+kind+'重新命名為「'+clean+'」。');
  return true;
}
function syncSinProSceneList(){
  const list = $('sinProSceneList');
  if(!list) return;
  list.innerHTML = '';
  for(const sceneState of SIN_TOWER_EDITOR.scenes){
    const row = document.createElement('div');
    row.className = 'sin-pro-scene-row';
    const selectButton = document.createElement('button');
    selectButton.type = 'button';
    selectButton.className = sceneState.id === SIN_TOWER_EDITOR.activeSceneId ? 'active' : '';
    selectButton.innerHTML = '<span>' + escapeHtml(sceneState.title) + '</span><span class="sin-pro-badge">' + escapeHtml(sinTowerEditorSceneTypeLabel(sceneState.type)) + '</span>';
    selectButton.title = 'Ctrl + 左鍵：重新命名場景';
    selectButton.onclick = event=>{if(event.ctrlKey){event.preventDefault();event.stopPropagation();renameSinTowerListEntry(sceneState,'場景');return;}setSinTowerActiveScene(sceneState.id);};
    const deleteButton = document.createElement('button');
    deleteButton.type = 'button';
    deleteButton.className = 'sin-pro-scene-delete';
    deleteButton.title = '刪除此場景';
    deleteButton.setAttribute('aria-label','刪除場景 ' + sceneState.title);
    deleteButton.textContent = '×';
    deleteButton.disabled = SIN_TOWER_EDITOR.scenes.length <= 1;
    deleteButton.onclick = event=>{
      event.preventDefault();
      event.stopPropagation();
      deleteSinTowerSceneById(sceneState.id);
    };
    row.append(selectButton,deleteButton);
    list.appendChild(row);
  }
}

function syncSinProObjectList(){
  const list = $('sinProObjectList');
  if(!list) return;
  list.innerHTML = '';
  const active = SIN_TOWER_EDITOR.activeSceneId;
  const filter = $('sinProObjectFilter')?.value || 'all';
  const query = String($('sinProObjectSearch')?.value || '').trim().toLowerCase();
  const generatedStones = SIN_TOWER_EDITOR.stones.filter(s=>s.sceneId === active && (s.generated || /(?:floor|ceiling|left|right)/i.test(String(s.title || ''))));
  const generatedIds = new Set(generatedStones.map(s=>s.id));
  const items = [
    ...SIN_TOWER_EDITOR.props.filter(p=>p.sceneId === active).map(p=>({type:'prop', id:p.id, label:p.title, badge:p.mediaType === 'video' ? '影片' : 'PNG'})),
    ...SIN_TOWER_EDITOR.models.filter(model=>model.sceneId === active).map(model=>({type:'model',id:model.id,label:model.title,badge:'3D'})),
    ...SIN_TOWER_EDITOR.portals.filter(p=>p.sceneId === active).map(p=>({type:'portal', id:p.id, label:p.title, badge:'傳送門'})),
    ...SIN_TOWER_EDITOR.stones.filter(s=>s.sceneId === active && !generatedIds.has(s.id)).map((s,i)=>({type:'stone', id:s.id, label:s.title || `石塊 ${i+1}`, badge:'構件'}))
  ].filter(item=>(filter === 'all' || item.type === filter) && (!query || String(item.label || '').toLowerCase().includes(query)));
  const renderItem = item=>{
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = item.id === SIN_TOWER_EDITOR.selectedObjectId ? 'active' : '';
    btn.innerHTML = `<span>${escapeHtml(item.label)}</span><span class="sin-pro-badge">${escapeHtml(item.badge)}</span>`;
    btn.title = 'Ctrl + 左鍵：重新命名物件';
    btn.onclick = event=>{const object=getSinTowerEditorObjectById(item.id,item.type);if(event.ctrlKey){event.preventDefault();event.stopPropagation();renameSinTowerListEntry(object,'物件');return;}selectSinTowerEditorObject(item.type,item.id,item.type === 'prop' ? 'props' : item.type === 'model' ? 'models' : item.type === 'portal' ? 'portals' : 'stones');};
    list.appendChild(btn);
  };
  for(const item of items) renderItem(item);

  const showGenerated = (filter === 'all' || filter === 'stone') && generatedStones.length && (!query || '教堂生成構件'.includes(query) || generatedStones.some(s=>String(s.title || '').toLowerCase().includes(query)));
  if(showGenerated){
    const selectedGenerated = generatedStones.find(s=>s.id === SIN_TOWER_EDITOR.selectedObjectId) || null;
    const group = document.createElement('button');
    group.type = 'button';
    group.className = `sin-pro-group-row${selectedGenerated ? ' active' : ''}`;
    group.innerHTML = `<span>教堂生成構件</span><span class="sin-pro-badge">${generatedStones.length} 件</span>`;
    group.title = 'Ctrl + 左鍵：重新命名目前教堂構件';
    group.onclick = event=>{
      const target = selectedGenerated || generatedStones[0];
      if(event.ctrlKey){event.preventDefault();event.stopPropagation();renameSinTowerListEntry(target,'物件');return;}
      if(target) selectSinTowerEditorObject('stone', target.id, 'stones');
    };
    list.appendChild(group);
    if(selectedGenerated) renderItem({type:'stone', id:selectedGenerated.id, label:`目前選取：${selectedGenerated.title || selectedGenerated.id}`, badge:'單顆'});
  }
  if(!items.length && !showGenerated){
    const empty = document.createElement('div');
    empty.className = 'sin-pro-muted';
    empty.textContent = '目前篩選條件沒有物件';
    list.appendChild(empty);
  }
}

function syncSinProFields(){
  const active = getSinTowerActiveScene();
  if(!active) return;
  syncSinTowerStoneMaterialUi();
  sinProSetValue('sinSceneTitle', active.title);
  sinProSetValue('sinSceneType', active.type);
  sinProSetValue('sinSceneSpawnX', active.spawn.x);
  sinProSetValue('sinSceneSpawnY', active.spawn.y);
  sinProSetValue('sinSceneSpawnZ', active.spawn.z);
  sinProSetValue('sinSceneWidth', active.dimensions.w);
  sinProSetValue('sinSceneHeight', active.dimensions.h);
  sinProSetValue('sinSceneDepth', active.dimensions.d);
  sinProSetValue('sinSceneSkyColor', active.skybox?.color || '#0b0704');
  syncSinTowerSceneAudioControls(active);
  sinProSetValue('sinStoneSharedMapping', active.stoneTextureMapping || 'box');
  const churchDimensions = active.type === 'church' ? active.dimensions : {w:20,h:11,d:32};
  sinProSetValue('sinChurchWidth', churchDimensions.w);
  sinProSetValue('sinChurchHeight', churchDimensions.h);
  sinProSetValue('sinChurchDepth', churchDimensions.d);
  const churchSummary=$('sinChurchProfileSummary');
  if(churchSummary){const p=active.type==='church'?active.churchProfile:null;churchSummary.textContent=p?('目前結構：'+p.floorPlan+'｜'+p.columnStyle+'｜'+p.roofStyle+'｜'+p.windowStyle+'｜'+p.crossStyle+'｜'+p.furnitureStyle+'｜'+p.altarStyle+'；'+p.ruinLabel+'，完整度 '+p.completeness+'%。'):'種子會決定平面、柱式、屋頂、窗型、十字架、家具與祭壇；破敗程度決定結構完整度。';}

  const portalSource=$('sinPortalSource'),target=$('sinPortalTarget');
  fillSinTowerPortalSceneSelect(portalSource,portalSource?.value||active.id);
  fillSinTowerPortalSceneSelect(target,target?.value||SIN_TOWER_EDITOR.scenes.find(sceneState=>sceneState.id!==active.id)?.id||active.id);

  const prop = SIN_TOWER_EDITOR.selectedObjectType === 'prop' ? getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId, 'prop') : null;
  if(prop){
    sinProSetValue('sinPropMediaType',prop.mediaType==='gif'?'gif':'pngSequence');
    syncSinProPropMediaUi();
    sinProSetValue('sinPropName', prop.title);
    sinProSetValue('sinPropStep', prop.step);
    sinProSetValue('sinPropOffsetX', prop.offset.x);
    sinProSetValue('sinPropOffsetY', prop.offset.y);
    sinProSetValue('sinPropOffsetZ', prop.offset.z);
    sinProSetValue('sinPropHeight', prop.height);
    sinProSetValue('sinPropWidthMul', prop.widthMul);
    sinProSetValue('sinPropFps', prop.fps);
    sinProSetValue('sinPropMotion', prop.motion);
    sinProSetValue('sinPropFloatAmp', prop.floatAmp);
    sinProSetValue('sinPropPatrolAxis', prop.patrolAxis);
    sinProSetValue('sinPropPatrolDistance', prop.patrolDistance);
    sinProSetValue('sinPropPatrolSpeed', prop.patrolSpeed);
  }

  const model = SIN_TOWER_EDITOR.selectedObjectType === 'model' ? getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId,'model') : null;
  if(model){
    sinProSetValue('sinModelName',model.title);
    sinProSetValue('sinModelX',model.position.x);
    sinProSetValue('sinModelY',model.position.y);
    sinProSetValue('sinModelZ',model.position.z);
    sinProSetValue('sinModelScaleX',model.scale.x);
    sinProSetValue('sinModelScaleY',model.scale.y);
    sinProSetValue('sinModelScaleZ',model.scale.z);
    const uniformScale = (safeFinite(model.scale.x,1)+safeFinite(model.scale.y,1)+safeFinite(model.scale.z,1))/3;
    if($('sinModelUniformScale') && document.activeElement !== $('sinModelUniformScale')) $('sinModelUniformScale').value = clamp(uniformScale,.01,20);
    if($('sinModelUniformScaleValue')) $('sinModelUniformScaleValue').textContent = uniformScale.toFixed(2);
    sinProSetValue('sinModelRotX',model.rotation.x);
    sinProSetValue('sinModelRotY',model.rotation.y);
    sinProSetValue('sinModelRotZ',model.rotation.z);
    if($('sinModelState')) $('sinModelState').textContent = (model.bundledAsset === 'book01' ? '最佳化範例：4.61 MB／120,008 三角面；Base Color、Normal、ORM 均已保留。' : (model.modelName || '已匯入模型')) + (model.textureName ? '｜外部貼圖：' + model.textureName : '｜使用 GLB 內嵌貼圖');
    if($('sinModelCarry')) $('sinModelCarry').textContent = sinTowerModelCarry.active && sinTowerModelCarry.id === model.id ? '固定在目前位置' : '跟隨角色移動';
  }

  const portal = SIN_TOWER_EDITOR.selectedObjectType === 'portal' ? getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId, 'portal') : null;
  if(portal){
    sinProSetValue('sinPortalName', portal.title);
    sinProSetValue('sinPortalSource',portal.sceneId);
    sinProSetValue('sinPortalTarget', portal.targetSceneId);
    sinProSetValue('sinPortalStep', portal.step);
    sinProSetValue('sinPortalOffsetX', portal.offset.x);
    sinProSetValue('sinPortalOffsetY', portal.offset.y);
    sinProSetValue('sinPortalOffsetZ', portal.offset.z);
    sinProSetValue('sinPortalWidth', portal.width);
    sinProSetValue('sinPortalHeight', portal.height);
    sinProSetValue('sinPortalScale', portal.uniformScale || 1);
    sinProSetValue('sinPortalStyle', portal.portalStyle || 1);
    sinProSetValue('sinPortalColor', portal.color);
  }

  const stone = SIN_TOWER_EDITOR.selectedObjectType === 'stone' ? getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId, 'stone') : null;
  if(stone){
    sinProSetValue('sinStoneShape', stone.shape || 'layered');
    sinProSetValue('sinStoneSurface', stone.surface || 'floor');
    sinProSetValue('sinStoneColor', stone.color);
    sinProSetValue('sinStoneUseShared', stone.useSharedMaterial !== false ? 'true' : 'false');
    sinProSetValue('sinStoneMapping', stone.textureMapping || 'box');
    sinProSetValue('sinStoneX', stone.position.x);
    sinProSetValue('sinStoneY', stone.position.y);
    sinProSetValue('sinStoneZ', stone.position.z);
    sinProSetValue('sinStoneScaleX', stone.scale.x);
    sinProSetValue('sinStoneScaleY', stone.scale.y);
    sinProSetValue('sinStoneScaleZ', stone.scale.z);
    sinProSetValue('sinStoneRotX', stone.rotation.x);
    sinProSetValue('sinStoneRotY', stone.rotation.y);
    sinProSetValue('sinStoneRotZ', stone.rotation.z);
  }

  const carryState = $('sinStoneCarryState');
  if(carryState){
    carryState.textContent = sinTowerStoneCarry.active
      ? `攜帶中：${stone?.title || '石塊'}。使用 WASD 移動主角，按 Enter 固定位置。`
      : '尚未攜帶構件。選取構件後可讓角色帶著它移動，按 Enter 或「放置石塊」固定。';
  }

  if($('sinPerfGameOrientation'))$('sinPerfGameOrientation').value=STATE?.displayOrientation==='portrait'?'portrait':'landscape';
  syncSinTowerPortalPasswordGifEditor();
  syncSinTowerPortalPasswordSlotArtEditor();
  sinProSetValue('sinPerfSpriteMaxSize', SIN_TOWER_EDITOR.perf.spriteMaxSize);
  sinProSetValue('sinPerfTextureMaxSize', SIN_TOWER_EDITOR.perf.textureMaxSize);
  sinProSetValue('sinPerfTextureQuality', SIN_TOWER_EDITOR.perf.textureQuality);
  const spriteFrames = SIN_TOWER_EDITOR.props.reduce((sum,p)=>sum + (p.frames?.length || 0), 0) + (SIN_TOWER_MONKS.spriteFrames?.length || 0);
  const stones = SIN_TOWER_EDITOR.stones.length;
  sinProSetValue('sinPerfStats', `${SIN_TOWER_EDITOR.scenes.length} 個場景｜${spriteFrames} 張 PNG 影格｜${stones} 個構件`);
  syncSinPerfPanel();
}

function syncSinProEditor(){
  syncSinExtraPerf();
  syncSinTowerPerfRpsEditor();
  ensureSinTowerEditorState();
  document.body.classList.toggle('sin-pro-editor-active', !isPlayMode());
  document.body.classList.toggle('sin-pro-show-legacy', !!SIN_TOWER_EDITOR.ui.legacyVisible);
  setSinProTab(SIN_TOWER_EDITOR.ui.activeTab);
  syncSinProSceneList();
  syncSinProObjectList();
  syncSinProFields();
}

function buildSinProEditor(){
  const root = $('sinProEditor');
  if(!root || root.dataset.bound) return;
  root.dataset.bound = '1';
  bindSinTowerPortalLayoutEditor();
  bindSinTowerMobileLayoutEditor();
  const resizeHandle = document.createElement('div');
  resizeHandle.className = 'sin-pro-resize-handle';
  resizeHandle.title = '拖曳調整編輯器大小';
  resizeHandle.setAttribute('aria-label','拖曳調整編輯器大小');
  root.appendChild(resizeHandle);
  let resizeState = null;
  resizeHandle.addEventListener('pointerdown', event=>{
    const rect = root.getBoundingClientRect();
    resizeState = {pointerId:event.pointerId,startX:event.clientX,startY:event.clientY,width:rect.width,height:rect.height,left:rect.left,top:rect.top};
    resizeHandle.setPointerCapture?.(event.pointerId);
    event.preventDefault();
    event.stopPropagation();
  });
  resizeHandle.addEventListener('pointermove', event=>{
    if(!resizeState || event.pointerId !== resizeState.pointerId) return;
    const maxWidth = Math.max(320,window.innerWidth-resizeState.left-4);
    const maxHeight = Math.max(260,window.innerHeight-resizeState.top-4);
    const minWidth = Math.min(560,maxWidth);
    const minHeight = Math.min(360,maxHeight);
    root.style.width = clamp(resizeState.width+event.clientX-resizeState.startX,minWidth,maxWidth)+'px';
    root.style.height = clamp(resizeState.height+event.clientY-resizeState.startY,minHeight,maxHeight)+'px';
    event.preventDefault();
  });
  const finishResize = event=>{
    if(!resizeState || (event.pointerId !== undefined && event.pointerId !== resizeState.pointerId)) return;
    try{ resizeHandle.releasePointerCapture?.(resizeState.pointerId); }catch(error){}
    resizeState = null;
    event.preventDefault?.();
  };
  resizeHandle.addEventListener('pointerup',finishResize);
  resizeHandle.addEventListener('pointercancel',finishResize);
  ensureSinPerfPanel();
  ensureSinProEditorStructure();
  const perfTab = root.querySelector('[data-sin-pro-tab="perf"]');
  if(perfTab) perfTab.textContent = '素材效能';
  const mappingLabels = {
    box:'原圖環繞（推薦）',
    rockUv:'岩紋重複 2×',
    cylindrical:'水平環繞一次',
    planar:'正面原圖投影'
  };
  for(const id of ['sinStoneSharedMapping','sinStoneMapping']){
    const select = $(id);
    for(const option of select?.options || []) option.textContent = mappingLabels[option.value] || option.textContent;
  }
  const tumorPanel = $('tumorPanel');
  const infectionMount = $('sinProInfectionMount');
  if(tumorPanel && infectionMount){
    tumorPanel.classList.add('sin-pro-embedded-tumor');
    infectionMount.appendChild(tumorPanel);
  }
  document.body.classList.toggle('sin-pro-editor-active', !isPlayMode());
  if($('sinProObjectSearch')) $('sinProObjectSearch').oninput = syncSinProObjectList;
  if($('sinProObjectFilter')) $('sinProObjectFilter').onchange = syncSinProObjectList;
  for(const btn of root.querySelectorAll('[data-sin-pro-tab]')) btn.onclick = ()=>{ setSinProTab(btn.dataset.sinProTab); syncSinProEditor(); scheduleSinTowerRuntimeSave(); };
  $('sinProModeEdit').onclick = enterSinTowerEditorMode;
  $('sinProModePlay').onclick = ()=>{
    enterDefaultSinTowerPlayMode();
    // The Play button is a user gesture, so Pointer Lock can be requested here.
    // If the browser declines it, enterDefaultSinTowerPlayMode already enabled
    // ordinary mouse-look as the permanent fallback.
    if(!IS_TOUCH_DEVICE) requestStablePointerLock();
  };
  $('sinProSave').onclick = ()=>{ void saveAndExportSinTowerCompleteGame(); };
  if($('sinProRebuildInfection')) $('sinProRebuildInfection').onclick = ()=>{
    updateSinTowerTumorEditor();
    clearTimeout(sinTowerTumorParamRebuildTimer);
    const level = Math.floor(SIN_TOWER_INFECTION.level || 0);
    if(level > 0 && !isSinTowerMeatballMode()) rebuildSinTowerInfectionCoverFromScratch(level);
    setStatus(level > 0 ? '已套用並重建目前腫瘤與觸手效果。' : '已儲存腫瘤與觸手參數，下一次感染時套用。');
  };
  $('sinProLegacyToggle').onclick = ()=>{ SIN_TOWER_EDITOR.ui.legacyVisible = !SIN_TOWER_EDITOR.ui.legacyVisible; syncSinProEditor(); scheduleSinTowerRuntimeSave(); };
  $('sinSceneAddEmpty').onclick = ()=>createSinTowerEditorScene('empty');
  $('sinSceneAddChurch').onclick = ()=>{
    const dimensions = sinTowerEditorDimensions({
      w:sinProNumber('sinChurchWidth', 20),
      h:sinProNumber('sinChurchHeight', 11),
      d:sinProNumber('sinChurchDepth', 32)
    }, {w:20,h:11,d:32});
    createSinTowerEditorScene('church', {withPortal:true, dimensions});
    // A new church is immediately playable and every generated ruin piece remains editable.
    setSinProTab('stones');
    syncSinProEditor();
    generateSinTowerChurchFromUi();
  };
  $('sinSceneApply').onclick = applySinTowerSceneFromUi;
  $('sinSceneDelete').onclick = deleteSinTowerActiveScene;
  if($('sinSceneAudioFile'))$('sinSceneAudioFile').onchange=async event=>{const file=event.target.files?.[0];try{if(file)await importSinTowerSceneAudio(file);}catch(error){setStatus('場景音效匯入失敗：'+String(error?.message||error));}event.target.value='';};
  if($('sinSceneAudioVolume'))$('sinSceneAudioVolume').oninput=updateSinTowerSceneAudioFromUi;
  if($('sinSceneAudioLoop'))$('sinSceneAudioLoop').onchange=updateSinTowerSceneAudioFromUi;
  if($('sinSceneAudioClear'))$('sinSceneAudioClear').onclick=()=>{const sceneState=getSinTowerActiveScene();if(!sceneState)return;sceneState.audio=sanitizeSinTowerAudio(null,false);scheduleSinTowerRuntimeSave();syncSinTowerSceneAudioControls(sceneState);updateSinTowerAudioRuntime(true);setStatus('已移除場景音效。');};
  $('sinModelAdd').onclick = addSinTowerEditorModelFromUi;
  $('sinModelApply').onclick = ()=>{ if(updateSinTowerModelFromUi()) setStatus('已更新 3D 模型位置、旋轉與尺寸。'); };
  $('sinModelCarry').onclick = toggleSinTowerModelCarry;
  $('sinModelDelete').onclick = deleteSinTowerSelectedModel;
  for(const id of ['sinModelName','sinModelX','sinModelY','sinModelZ','sinModelScaleX','sinModelScaleY','sinModelScaleZ','sinModelRotX','sinModelRotY','sinModelRotZ']) if($(id)){
    $(id).oninput = updateSinTowerModelFromUi;
    $(id).onchange = updateSinTowerModelFromUi;
  }
  if($('sinModelUniformScale')){
    $('sinModelUniformScale').oninput = event=>setSinTowerModelUniformScale(event.target.value);
    $('sinModelUniformScale').onchange = event=>setSinTowerModelUniformScale(event.target.value);
  }
  $('sinPropMediaType').onchange = syncSinProPropMediaUi;
  syncSinProPropMediaUi();
  $('sinPropAdd').onclick = addSinTowerEditorPropFromUi;
  $('sinPropApply').onclick = applySinTowerEditorPropFromUi;
  $('sinPropDelete').onclick = deleteSinTowerSelectedProp;
  $('sinPortalAdd').onclick = addSinTowerEditorPortalFromUi;
  $('sinPortalApply').onclick = applySinTowerEditorPortalFromUi;
  $('sinPortalDelete').onclick = deleteSinTowerSelectedPortal;
  if($('sinPortalScale')) $('sinPortalScale').oninput=()=>{const scale=clamp(safeFinite($('sinPortalScale').value,1),.2,12);sinProSetValue('sinPortalWidth',1.8*scale);sinProSetValue('sinPortalHeight',2.6*scale);};
  $('sinStoneAdd').onclick = addSinTowerEditorStoneFromUi;
  $('sinStoneApply').onclick = applySinTowerEditorStoneFromUi;
  $('sinStoneCarry').onclick = ()=>startSinTowerStoneCarry();
  $('sinStonePlace').onclick = ()=>placeSinTowerCarriedStone();
  $('sinStoneDelete').onclick = deleteSinTowerSelectedStone;
  $('sinChurchGenerate').onclick = generateSinTowerChurchFromUi;
  $('sinStoneSharedMapping').onchange = ()=>{
    const activeScene = getSinTowerActiveScene();
    if(!activeScene) return;
    activeScene.stoneTextureMapping = sanitizeSinTowerStoneTextureMapping($('sinStoneSharedMapping').value, 'box');
    rebuildSinTowerEditorRuntime();
    scheduleSinTowerRuntimeSave();
    setStatus(`已更新目前場景共用材質映射：${$('sinStoneSharedMapping').selectedOptions[0]?.textContent || activeScene.stoneTextureMapping}。`);
  };
  $('sinStoneMapping').onchange = ()=>{
    const stone = SIN_TOWER_EDITOR.selectedObjectType === 'stone' ? getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId, 'stone') : null;
    if(!stone) return;
    stone.textureMapping = sanitizeSinTowerStoneTextureMapping($('sinStoneMapping').value, 'box');
    rebuildSinTowerEditorRuntime();
    scheduleSinTowerRuntimeSave();
    setStatus(`已更新選取石塊個別材質映射：${$('sinStoneMapping').selectedOptions[0]?.textContent || stone.textureMapping}。`);
  };
  for(const id of ['sinStoneSharedTexture','sinStoneTexture','sinPlayStoneTexture']){
    const input = $(id);
    if(input && input.dataset.resetOnOpen !== '1'){
      input.dataset.resetOnOpen = '1';
      input.addEventListener('click', ()=>{ input.value = ''; });
    }
  }
  $('sinStoneTexture').onchange = async e=>{ const file=e.target.files?.[0]; await applySinTowerSelectedStoneTexture(file); };
  $('sinStoneApplySharedAll').onclick = applySinTowerSharedMaterialToAllStones;
  $('sinStoneSharedTexture').onchange = async e=>{
    const file=e.target.files?.[0]; if(!file) return;
    const src = await readAsDataURL(file, {maxSize:SIN_TOWER_EDITOR.perf.textureMaxSize, preserveAlpha:true, mimeType:'image/png'});
    const activeScene = getSinTowerActiveScene();
    if(activeScene){
      activeScene.sharedStoneTextureDataUrl = src;
      activeScene.sharedStoneTextureName = file.name || '';
    }
    // Keep the legacy field for v91 saves, but runtime materials read the
    // scene-owned value above so a cave upload cannot alter another scene.
    SIN_TOWER_EDITOR.sharedStoneTextureDataUrl = src;
    rebuildSinTowerEditorRuntime();
    scheduleSinTowerRuntimeSave();
    const sharedCount = SIN_TOWER_EDITOR.stones.filter(stone=>stone.sceneId === activeScene?.id && stone.useSharedMaterial !== false).length;
    syncSinTowerStoneMaterialUi();
    setStatus(`已載入目前場景共用材質：${file.name}。目前 ${sharedCount} 塊石頭會使用它；其他場景不會被改動。`);
  };
  $('sinPlayStoneTexture').onchange = async e=>{
    const file = e.target.files?.[0];
    await applySinTowerStoneTextureToId(sinTowerStonePickMode.selectedId, file, '已套用目前石頭的個別材質');
  };
  $('sinStonePickExit').onclick = ()=>{
    setSinTowerStonePickMode(false);
    setStatus('已離開石頭選取模式，返回遊玩。');
  };
  if($('sinPerfGameOrientation'))$('sinPerfGameOrientation').onchange=event=>setSinTowerDisplayOrientation(event.target.value);
  if($('sinPerfPortalPasswordGif'))$('sinPerfPortalPasswordGif').onchange=async event=>{const file=event.target.files?.[0];event.target.value='';if(file)await importSinTowerPortalPasswordGif(file);};
  if($('sinPerfPortalPasswordSlotArt'))$('sinPerfPortalPasswordSlotArt').onchange=async event=>{const file=event.target.files?.[0];event.target.value='';if(file)await importSinTowerPortalPasswordSlotArt(file);};
  for(const id of ['sinPerfPortalClarity','sinPerfPortalBrightness','sinPerfPortalContrast','sinPerfPortalDitherScale','sinPerfPortalTextScale','sinPerfPortalTextWeight','sinPerfPortalSlotDitherStrength','sinPerfPortalSlotDitherDetail','sinPerfPortalSlotBrightness','sinPerfPortalSlotContrast','sinPerfPortalSlotTextOffsetX','sinPerfPortalSlotTextOffsetY'])if($(id)){$(id).oninput=applySinTowerPortalFxFromEditor;$(id).onchange=applySinTowerPortalFxFromEditor;}
  if($('sinPerfResetPortalFx'))$('sinPerfResetPortalFx').onclick=resetSinTowerPortalFx;
  if($('sinPerfResetPortalSlotFx'))$('sinPerfResetPortalSlotFx').onclick=resetSinTowerPortalSlotFx;
  if($('sinPerfResetPortalPasswordGif'))$('sinPerfResetPortalPasswordGif').onclick=()=>resetSinTowerPortalPasswordGif();
  if($('sinPerfResetPortalPasswordSlotArt'))$('sinPerfResetPortalPasswordSlotArt').onclick=()=>resetSinTowerPortalPasswordSlotArt();
  if($('sinPerfEditPortalPasswordLayout'))$('sinPerfEditPortalPasswordLayout').onclick=openSinTowerPortalLayoutEditor;
  if($('sinPerfEditMobileControlsLayout'))$('sinPerfEditMobileControlsLayout').onclick=openSinTowerMobileLayoutEditor;
  $('sinPerfApply').onclick = ()=>{
    const preset = $('sinPerfPreset')?.value;
    if(preset && preset !== 'custom') applySinPerfPreset(preset);
    SIN_TOWER_EDITOR.perf.spriteMaxSize = clamp(sinProNumber('sinPerfSpriteMaxSize', 768),128,2048);
    SIN_TOWER_EDITOR.perf.textureMaxSize = clamp(sinProNumber('sinPerfTextureMaxSize',1536),256,4096);
    SIN_TOWER_EDITOR.perf.textureQuality = clamp(sinProNumber('sinPerfTextureQuality',.78),.3,.95);
    syncSinProEditor();
    scheduleSinTowerRuntimeSave();
    setStatus('素材效能上限已更新，新的上傳會套用新上限。');
  };
  $('sinPerfClearHeavy').onclick = ()=>{
    clearSinTowerMonkSpriteSequence();
    SIN_TOWER_EDITOR.props = [];
    SIN_TOWER_EDITOR.selectedObjectId = null;
    SIN_TOWER_EDITOR.selectedObjectType = null;
    rebuildSinTowerEditorRuntime();
    scheduleSinTowerRuntimeSave();
    setStatus('已清除已儲存的 PNG 序列素材。');
  };
  syncSinProEditor();
}

function buildEditor(){
  buildSinProEditor();
  const surfaceSelect = $('surfaceSelect');
  surfaceSelect.innerHTML = '';
  for(const key of SURFACE_KEYS) surfaceSelect.add(new Option(SURFACE_LABELS[key],key));
  const artWall = $('artWall');
  artWall.innerHTML = '';
  for(const key of WALL_KEYS) artWall.add(new Option(SURFACE_LABELS[key],key));

  $('saveNow').onclick = ()=>{ void saveAndExportSinTowerCompleteGame(); };
  $('exportJson').onclick = exportJson;
  if($('exportHtml')) $('exportHtml').onclick = ()=>{ void saveAndExportSinTowerCompleteGame(); };
  $('resetState').onclick = async()=>{
    await dbSet(STATE_KEY,null);
    await dbSet(SIN_TOWER_RUNTIME_KEY,null);
    STATE = createDefaultState();
    ensureSinTowerEditorState({activeSceneId:'stairs_main', scenes:[{id:'stairs_main', title:'Stair Scene', type:'stairs', spawn:{x:0,y:.18,z:5.8}, dimensions:{w:18,h:80,d:500}}], props:[], portals:[], stones:[], perf:SIN_TOWER_EDITOR.perf});
    selectedArtworkId = null;
    selectedWallId = null;
    selectedRoomWallKey = null;
    selectedFloorTileId = null;
    selectedReferenceArchitectureActive = false;
    pendingWallId = null;
    wallFollowPlayer = false;
    wallScaleMode = false;
    detachWallRotationControls();
    applyEnvironmentColors();
    buildSkyBackground();
    buildAtmosphereEffect();
    applyScreenFx();
    rebuildLightSystem();
    buildRoom(); buildReferenceArchitecture(); buildWaterBodies(); buildArtworks(); rebuildSinTowerEditorRuntime(); applyObjectVisibilityLocks(); renderObjectPanel(); syncAllEditor(); saveStateNow();
    setStatus('已回到空白十字空間預設。');
  };

  $('spaceBgColor').oninput = updateBackgroundFromEditor;
  if($('skyTintColor')) $('skyTintColor').oninput = updateSkyTintFromEditor;
  if($('skyTintStrength')) $('skyTintStrength').oninput = updateSkyTintFromEditor;
  if($('atmosphereEnabled')) $('atmosphereEnabled').onchange = updateAtmosphereFromEditor;
  if($('atmosphereColor')) $('atmosphereColor').oninput = updateAtmosphereFromEditor;
  if($('atmosphereIntensity')) $('atmosphereIntensity').oninput = updateAtmosphereFromEditor;
  if($('atmosphereOpacity')) $('atmosphereOpacity').oninput = updateAtmosphereFromEditor;
  if($('atmosphereLayers')) $('atmosphereLayers').oninput = updateAtmosphereFromEditor;
  bindScreenFxEditor();
  $('importSkyTexture').onclick = ()=>$('skyTextureInput').click();
  if($('buildReferenceArchitecture')) $('buildReferenceArchitecture').onclick = buildReferenceArchitecturePreset;
  if($('toggleReferenceArchitecture')) $('toggleReferenceArchitecture').onclick = toggleReferenceArchitecture;
  for(const id of ['referenceArchitectureColor','referenceArchitectureRoughness','referenceArchitectureMetalness','referenceArchitectureRepeatX','referenceArchitectureRepeatY']) if($(id)) $(id).oninput = updateReferenceArchitectureMaterialFromEditor;
  if($('importReferenceArchitectureTexture')) $('importReferenceArchitectureTexture').onclick = ()=>$('referenceArchitectureTextureInput').click();
  if($('referenceArchitectureTextureInput')) $('referenceArchitectureTextureInput').onchange = async e=>{
    const file = e.target.files?.[0]; if(!file) return;
    STATE.referenceArchitecture = STATE.referenceArchitecture || {enabled:true, material:createReferenceArchitectureMaterial()};
    STATE.referenceArchitecture.material = sanitizeReferenceArchitectureMaterial(STATE.referenceArchitecture.material);
    STATE.referenceArchitecture.material.texture = await readAsDataURL(file);
    rebuildReferenceArchitectureMaterials();
    syncReferenceArchitectureMaterialEditor();
    scheduleSave();
    setStatus(`已匯入參考圖建築材質：${file.name}`);
    e.target.value = '';
  };
  if($('clearReferenceArchitectureTexture')) $('clearReferenceArchitectureTexture').onclick = ()=>{
    STATE.referenceArchitecture = STATE.referenceArchitecture || {enabled:true, material:createReferenceArchitectureMaterial()};
    STATE.referenceArchitecture.material = sanitizeReferenceArchitectureMaterial(STATE.referenceArchitecture.material);
    STATE.referenceArchitecture.material.texture = null;
    rebuildReferenceArchitectureMaterials();
    syncReferenceArchitectureMaterialEditor();
    scheduleSave();
    setStatus('已清除參考圖建築材質。');
  };

  if($('chiselFromView')) $('chiselFromView').onclick = ()=>chiselFromPointer(null, true);
  if($('chiselUndoLast')) $('chiselUndoLast').onclick = removeLastChiselHole;
  if($('chiselClearTarget')) $('chiselClearTarget').onclick = clearChiselHolesForCurrentTarget;
  if($('chiselEnabled')) $('chiselEnabled').onchange = ()=>{
    setStatus($('chiselEnabled').checked ? '鑿子模式已啟用。游標模式下點擊參考圖牆面、柱子、厚樑或自建直牆即可鑿洞。' : '鑿子模式已關閉。');
  };
  for(const id of ['chiselShape','chiselWidth','chiselHeight','chiselRadius','chiselBottom','chiselDepth']) if($(id)) $(id).oninput = ()=>{ syncChiselPanel(); updateChiselPreview(); };
  if($('chiselEnabled')) $('chiselEnabled').onchange = ()=>{ if(chiselEnabled()){ if($('sandPileEnabled')) $('sandPileEnabled').checked = false; disposeSandPilePreview(); updateChiselPreview(); } else hideChiselPreview(); };
  if($('sandPileEnabled')) $('sandPileEnabled').onchange = ()=>{
    if(sandPileEnabled()){
      if($('chiselEnabled')) $('chiselEnabled').checked = false;
      hideChiselPreview();
      const target = getSelectedFloorPhysicsTarget?.();
      if(target) ensureSelectedFloorIsSandForPile();
      showSandPilePreviewInfo(sandInfoForSelectedFloorCenter(false) || updateSandPilePreview() || sandPilePreviewInfo, false, 0);
      setStatus('堆疊模式已啟用。選取地板後按 SHIFT+A 會立即出現圓圈與垂直拉桿；Enter 寫入沙丘。');
    }
    else { cancelSandPileHandleMode(); disposeSandPilePreview(); setSandStackScreenOverlayVisible(false); setStatus('堆疊模式已關閉。'); }
  };
  if($('sandPileFromView')) $('sandPileFromView').onclick = ()=>sandPileFromPointer(null, true);
  if($('sandPileUndo')) $('sandPileUndo').onclick = undoLastSandPile;
  if($('sandPileClear')) $('sandPileClear').onclick = clearCurrentSandPiles;
  for(const id of ['sandPileMode','sandPileRadius','sandPileStrength','sandPileMaxHeight']) if($(id)) $(id).oninput = ()=>updateSandPilePreview();
  syncChiselPanel();
  $('skyTextureInput').onchange = async e=>{
    const file = e.target.files?.[0]; if(!file) return;
    STATE.skyTexture = await readAsDataURL(file);
    buildSkyBackground();
    scheduleSave();
    setStatus(`已匯入天空全景圖：${file.name}`);
    e.target.value = '';
  };
  $('clearSkyTexture').onclick = ()=>{
    STATE.skyTexture = null;
    disposeSkyBackground();
    scheduleSave();
    setStatus('已清除天空全景圖，背景改用空間底色。');
  };
  for(const id of OBJECT_EDITOR_FIELDS){
    const el = $(id);
    if(!el) continue;
    el.oninput = markObjectEditorDirty;
    el.onkeydown = (ev)=>{
      if(ev.key === 'Enter'){
        ev.preventDefault();
        applyObjectEditorValues();
        el.blur();
      }
    };
  }
  if($('applyObjectValues')) $('applyObjectValues').onclick = applyObjectEditorValues;
  $('addFloorTile').onclick = addFloorTile;
  $('deleteSelectedFloorTile').onclick = ()=>{ if(!deleteSelectedFloorTile()) setStatus('尚未選取地板塊。'); };
  if($('groundReliefPreset')) $('groundReliefPreset').onchange = updateGroundReliefFromEditor;
  if($('groundReliefAmount')) $('groundReliefAmount').oninput = updateGroundReliefFromEditor;
  if($('groundReliefVariation')) $('groundReliefVariation').oninput = updateGroundReliefFromEditor;
  for(const id of ['floorPhysicsMaterial','sandColor','sandGrain','sandReaction']){
    if($(id)){
      $(id).oninput = updateFloorPhysicsFromEditor;
      $(id).onchange = updateFloorPhysicsFromEditor;
    }
  }

  if($('surfaceSelect')) $('surfaceSelect').onchange = syncSurfaceEditor;
  for(const id of ['surfaceColor','surfaceRoughness','surfaceMetalness','surfaceRepeatX','surfaceRepeatY']) $(id).oninput = updateSurfaceFromEditor;
  $('importSurfaceTexture').onclick = ()=>{
    if(!getSelectedMaterialTarget() && !getValidatedMultiMaterialTargets({allowArtwork:false}).length){ setStatus('請先選取一個物件，或多選牆面／地板／天花板／地板塊／參考建築後再匯入材質。'); return; }
    $('surfaceTextureInput').click();
  };
  $('surfaceTextureInput').onchange = async e=>{
    const file = e.target.files?.[0]; if(!file) return;
    const src = await readAsDataURL(file);
    if(applyMultiSurfaceTexture(src, file.name)){ e.target.value = ''; return; }
    const target = getSelectedMaterialTarget();
    if(!target){ setStatus('材質未套用：尚未選取物件，或多選中含有無材質物件。'); e.target.value = ''; return; }
    target.cfg.texture = src;
    rebuildSelectedMaterialTarget(target);
    scheduleSave();
    setStatus(`已將材質置入目前選取物件：${target.label}｜${file.name}`);
    e.target.value = '';
  };
  $('clearSurfaceTexture').onclick = ()=>{
    if(clearMultiSurfaceTexture()) return;
    const target = getSelectedMaterialTarget();
    if(!target){ setStatus('請先選取要清除貼圖的物件。'); return; }
    target.cfg.texture = null;
    rebuildSelectedMaterialTarget(target);
    scheduleSave();
    setStatus(`已清除目前選取物件貼圖：${target.label}`);
  };
  $('deleteSelectedSurface').onclick = ()=>{
    if(selectedWallId){ deleteWall(selectedWallId); setStatus('已刪除選取自建牆。'); return; }
    if(selectedFloorTileId){ deleteSelectedFloorTile(); return; }
    if(selectedRoomWallKey && DELETABLE_SURFACE_KEYS.includes(selectedRoomWallKey)){
      const key = selectedRoomWallKey;
      deleteRoomWall(key);
      setStatus(`已刪除選取面：${SURFACE_LABELS[key]}`);
      return;
    }
    setStatus('目前選取物件不可刪除，或尚未選取任何物件。');
  };
  $('restoreRoomWalls').onclick = restoreRoomWalls;

  $('importArtwork').onclick = ()=>$('artworkFileInput').click();
  $('artworkFileInput').onchange = async e=>{
    const files = Array.from(e.target.files||[]);
    if(!files.length) return;
    if(pendingArtworkId) confirmPendingArtwork();
    if(pendingWallId) confirmPendingWall();
    if(pendingFloorTileId) confirmPendingFloorTile();
    for(const file of files){
      const src = await readAsDataURL(file);
      const name = file.name.replace(/\.[^.]+$/,'');
      const ext = (file.name.split('.').pop() || '').toLowerCase();
      const isModel = ['fbx','glb','gltf'].includes(ext) || /gltf|fbx/i.test(file.type || '');
      const imageSize = isModel ? null : await readImageDimensions(src);
      const aspect = imageSize?.width && imageSize?.height ? clamp(imageSize.width / imageSize.height, .01, 1000) : 1;
      const defaultImageH = 2.8;
      const f = getPlayerForward();
      const p = player.position.clone().addScaledVector(f, isModel ? 3.1 : 2.65);
      const b = wallPlacementBounds();
      const art = {
        id:uid('art'), title:name || 'Artwork', src,
        type:isModel ? 'model' : 'image', format:isModel ? (ext === 'fbx' ? 'fbx' : 'glb') : ext,
        transparent:!isModel && (file.type.includes('png') || file.type.includes('webp')),
        wall:'front', offset:0, y:isModel ? 0 : player.position.y + 2.2, gap:.014, depth:isModel ? .01 : .10,
        position:{x:clamp(p.x,b.minX,b.maxX), y:isModel ? 0 : player.position.y + 2.2, z:clamp(p.z,b.minZ,b.maxZ)},
        rotation:{x:0,y:radToDeg(camYaw),z:0}, manualRotation:false, snapToWall:false, doubleSided:false,
        backColor:ARTWORK_BACK_DEFAULT_COLOR, backColorManual:false, backLight:ARTWORK_BACK_DEFAULT_LIGHT, backLightManual:false, backRelief:defaultArtworkBackRelief(),
        preserveAspect:!isModel, naturalAspect:isModel ? null : aspect,
        edgeTintColor:'#ffffff', edgeTintStrength:0, surfaceMaterial:defaultArtworkSurfaceMaterial(), size:isModel ? {w:1.6,h:1.6,d:1.6} : {w:clamp(defaultImageH * aspect,.35,12),h:defaultImageH,d:1},
        visible:true, locked:false,
        isDraft:true
      };
      STATE.artworks.push(art);
      selectedArtworkId = art.id;
      selectedArtworkActive = true;
      pendingArtworkId = art.id;
      artworkFollowPlayer = true;
    }
    selectedWallId = null;
    selectedRoomWallKey = null;
    selectedFloorTileId = null;
    detachWallRotationControls();
    buildArtworks(); syncArtEditor(); refreshWallSelectionVisuals(); refreshArtworkSelectionVisuals();
    setStatus(`已匯入 ${files.length} 件作品。圖片／3D 模型都會先半透明跟隨角色；移動到位置後按 Enter 固定，選取後 Shift+T 可 XYZ 旋轉。`);
    e.target.value = '';
  };
  $('artSelect').onchange = ()=>{ selectedArtworkId = $('artSelect').value; selectedArtworkActive = !!selectedArtworkId; syncArtEditor(); syncGroundReliefEditor(); refreshArtworkSelectionVisuals(); };
  for(const id of ART_NUMERIC_FIELDS){
    const el = $(id);
    if(!el) continue;
    el.oninput = markArtEditorDirty;
    el.onchange = markArtEditorDirty;
    el.addEventListener('wheel', ev=>{
      if(document.activeElement === el) ev.preventDefault();
    }, {passive:false});
    el.onkeydown = ev=>{
      if(ev.key === 'Enter'){
        ev.preventDefault();
        applyArtEditorValues();
        el.blur();
      }
    };
  }
  if($('applyArtValues')) $('applyArtValues').onclick = applyArtEditorValues;
  if($('artBackColor')) $('artBackColor').oninput = applyArtBackOptionsFromEditor;
  if($('artBackLight')) $('artBackLight').oninput = applyArtBackOptionsFromEditor;
  if($('artEdgeTintColor')) $('artEdgeTintColor').oninput = applyArtVisualOptionsFromEditor;
  if($('artEdgeTintStrength')) $('artEdgeTintStrength').oninput = applyArtVisualOptionsFromEditor;
  if($('artSnapToWall')) $('artSnapToWall').onchange = applyArtEditorValues;
  if($('artDoubleSided')) $('artDoubleSided').onchange = applyArtEditorValues;
  $('deleteArtwork').onclick = ()=>{
    const currentArt = getSelectedArt();
    const deletedId = selectedArtworkId || currentArt?.id;
    if(!deleteArtworkById(deletedId, '已刪除作品。')) setStatus('目前沒有可刪除的作品。');
  };
  $('frameArtwork').onclick = frameSelectedArtwork;

  bindLightEditor();

  for(const id of ['actorScale','actorYOffset','actorYawOffset','playerSpeed','playerJumpPower']) if($(id)) $(id).oninput = updateActorFromEditor;
  for(const id of ['sinTumorSizeRange','sinTumorColorVar','sinTumorEyeScale','sinEyeRimColor','sinEyePupilColor','sinEyeBlinkFreq','sinTentacleLengthMul','sinTentacleThickMin','sinTentacleThickMax','sinTumorBatchMul','sinTumorGrowSpeed','sinSecondarySkeletonLevel','sinThirdSkeletonLevel','sinMeatballLevel','sinFungusColorVar','sinFungusShapeVar','sinFungusClusterMul']) if($(id)) $(id).oninput = updateSinTowerTumorEditor;
if($('sinTumorPaletteAdd')) $('sinTumorPaletteAdd').onclick = ()=> addSinTowerTumorPaletteColor($('sinTumorPalettePicker')?.value || '#d24b8c');
if($('sinTumorPaletteClear')) $('sinTumorPaletteClear').onclick = ()=>{ if($('sinTumorPaletteStore')) $('sinTumorPaletteStore').value = ''; rebuildSinTowerTumorPaletteUI(); updateSinTowerTumorEditor(); };
if($('sinStairTextureFile')) $('sinStairTextureFile').onchange = e=> loadSinTowerStairTextureFile(e.target.files?.[0]);
if($('sinStairTextureRepeat')) $('sinStairTextureRepeat').oninput = ()=>{ SIN_TOWER_STAIRCASE.textureRepeat = Number($('sinStairTextureRepeat').value || 3); refreshSinTowerStairMaterial(); scheduleSinTowerRuntimeSave(); };
if($('sinStairTextureClear')) $('sinStairTextureClear').onclick = clearSinTowerStairTexture;
if($('sinMonkModelFile')) $('sinMonkModelFile').onchange = e=> loadSinTowerMonkModelFile(e.target.files?.[0]);
if($('sinMonkPngSequenceFolder')) $('sinMonkPngSequenceFolder').onchange = e=> loadSinTowerMonkPngSequenceFiles(e.target.files);
if($('sinMonkSpriteClear')) $('sinMonkSpriteClear').onclick = clearSinTowerMonkSpriteSequence;
if($('sinMonkSpriteFps')) $('sinMonkSpriteFps').oninput = ()=>{ SIN_TOWER_MONKS.spriteFps = Number($('sinMonkSpriteFps').value || 12); scheduleSinTowerRuntimeSave(); };
if($('sinMonkSpriteStart')) $('sinMonkSpriteStart').oninput = ()=>{ SIN_TOWER_MONKS.spriteFrameStart = Number($('sinMonkSpriteStart').value || 1); scheduleSinTowerRuntimeSave(); };
if($('sinMonkSpriteEnd')) $('sinMonkSpriteEnd').oninput = ()=>{ SIN_TOWER_MONKS.spriteFrameEnd = Number($('sinMonkSpriteEnd').value || 10); scheduleSinTowerRuntimeSave(); };
if($('sinMonkSpritePause')) $('sinMonkSpritePause').oninput = ()=>{ SIN_TOWER_MONKS.spriteLoopPause = Number($('sinMonkSpritePause').value || .35); for(const rec of (SIN_TOWER_MONKS.instances||[])){ if(rec?.model?.userData) rec.model.userData.spriteFrame = -1; } scheduleSinTowerRuntimeSave(); };
if($('sinMonkSpritePingpong')) $('sinMonkSpritePingpong').onchange = ()=>{ SIN_TOWER_MONKS.spritePingpong = $('sinMonkSpritePingpong').checked !== false; for(const rec of (SIN_TOWER_MONKS.instances||[])){ if(rec?.model?.userData) rec.model.userData.spriteFrame = -1; } scheduleSinTowerRuntimeSave(); };
if($('sinMonkSpriteHeight')) $('sinMonkSpriteHeight').oninput = ()=>{ SIN_TOWER_MONKS.spriteHeight = Number($('sinMonkSpriteHeight').value || 1.18); for(const rec of (SIN_TOWER_MONKS.instances||[])){ if(rec?.model?.userData) rec.model.userData.spriteFrame = -1; } scheduleSinTowerRuntimeSave(); };
if($('sinMonkSpriteWidthMul')) $('sinMonkSpriteWidthMul').oninput = ()=>{ SIN_TOWER_MONKS.spriteWidthMul = Number($('sinMonkSpriteWidthMul').value || 1); for(const rec of (SIN_TOWER_MONKS.instances||[])){ if(rec?.model?.userData) rec.model.userData.spriteFrame = -1; } scheduleSinTowerRuntimeSave(); };
if($('sinMonkModelReset')) $('sinMonkModelReset').onclick = resetSinTowerMonkModelToDefault;
if($('sinMonkVisibleSteps')) $('sinMonkVisibleSteps').oninput = ()=>{ SIN_TOWER_MONKS.visibleStepWindow = Number($('sinMonkVisibleSteps').value || 50); refreshInfiniteSinTowerMonkWindow(); };
if($('sinMonkPoolCount')) $('sinMonkPoolCount').oninput = ()=>{ SIN_TOWER_MONKS.poolCount = Number($('sinMonkPoolCount').value || 16); populateSinTowerMonks(sinTowerBaseMonkModel); };
for(const id of ['sinFireParticleSize','sinFireParticleCount','sinFireShape','sinFireColorA','sinFireColorB','sinFireColorC','sinFireRadius','sinFireHeight','sinFireSwirl','sinFireDuration']) if($(id)) $(id).oninput = updateSinTowerFireEditor;
if($('sinFireTest')) $('sinFireTest').onclick = ()=>{ updateSinTowerFireEditor(); triggerSinTowerFireFx(); };

  $('idleBtn').onclick = ()=>playAction('idle',true);
  $('walkBtn').onclick = ()=>playAction('walk',true);
  $('jumpBtn').onclick = ()=>playAction('jump',true);

  $('addWallAhead').onclick = addWallAhead;
  if($('addCurvedWallAhead')) $('addCurvedWallAhead').onclick = addCurvedWallAhead;
  $('deleteWallAhead').onclick = deleteWallAhead;
  $('wallSelect').onchange = ()=>{ selectedWallId = $('wallSelect').value || null; selectedRoomWallKey = null; selectedFloorTileId = null; detachWallRotationControls(); syncWallEditor(); refreshWallSelectionVisuals(); }; 
  for(const id of ['wallW','wallH','wallRY','wallColor','wallShape','wallCurveAmount','wallCurveDirection']) if($(id)) $(id).oninput = updateWallFromEditor;
  $('deleteSelectedWall').onclick = ()=>{ if(!deleteSelectedWall()) setStatus('尚未選取牆壁。'); };

  syncAllEditor();
  setupFloatingWindows();
}

function syncAllEditor(){
  syncEnvironmentEditor(); syncReferenceArchitectureMaterialEditor(); syncAtmosphereEditor(); syncScreenFxEditor(); syncGroundReliefEditor(); syncSurfaceEditor(); syncFloorPhysicsEditor(); syncArtSelect(); syncArtEditor(); syncActorEditor(); syncSinTowerTumorEditor(); if($('sinStairTextureRepeat')) $('sinStairTextureRepeat').value = SIN_TOWER_STAIRCASE.textureRepeat; if($('sinMonkVisibleSteps')) $('sinMonkVisibleSteps').value = SIN_TOWER_MONKS.visibleStepWindow; if($('sinMonkPoolCount')) $('sinMonkPoolCount').value = SIN_TOWER_MONKS.poolCount; if($('sinMonkSpriteFps')) $('sinMonkSpriteFps').value = SIN_TOWER_MONKS.spriteFps; if($('sinMonkSpriteStart')) $('sinMonkSpriteStart').value = SIN_TOWER_MONKS.spriteFrameStart; if($('sinMonkSpriteEnd')) $('sinMonkSpriteEnd').value = SIN_TOWER_MONKS.spriteFrameEnd; if($('sinMonkSpritePause')) $('sinMonkSpritePause').value = SIN_TOWER_MONKS.spriteLoopPause; if($('sinMonkSpritePingpong')) $('sinMonkSpritePingpong').checked = !!SIN_TOWER_MONKS.spritePingpong; if($('sinMonkSpriteHeight')) $('sinMonkSpriteHeight').value = SIN_TOWER_MONKS.spriteHeight; if($('sinMonkSpriteWidthMul')) $('sinMonkSpriteWidthMul').value = SIN_TOWER_MONKS.spriteWidthMul; syncWallSelect(); syncWallEditor(); syncObjectEditor(); syncLightEditor(); syncChiselPanel(); syncSinProEditor(); renderObjectPanel();
}

function setGroundReliefEditorDisabled(disabled){
  for(const id of ['groundReliefPreset','groundReliefAmount','groundReliefVariation']){
    if($(id)) $(id).disabled = disabled;
  }
}

function getSelectedReliefTarget(){
  if(selectedArtworkActive && selectedArtworkId){
    const art = (STATE.artworks || []).find(a=>a.id === selectedArtworkId);
    if(art && art.type !== 'model'){
      return {kind:'artwork', id:art.id, label:`作品｜${art.title || art.id}`, cfg:ensureArtworkSurfaceMaterial(art)};
    }
  }
  return getSelectedMaterialTarget();
}

function syncGroundReliefEditor(){
  if(syncGroundReliefEditorForMultiSelection()) return;
  const target = getSelectedReliefTarget();
  if(!target){
    setGroundReliefEditorDisabled(true);
    if($('groundReliefPreset')) $('groundReliefPreset').value = 'flat';
    if($('groundReliefAmount')) $('groundReliefAmount').value = 0;
    if($('groundReliefVariation')) $('groundReliefVariation').value = .5;
    return;
  }
  setGroundReliefEditorDisabled(false);
  const cfg = getReliefConfigForMaterial(target.cfg);
  if($('groundReliefPreset')) $('groundReliefPreset').value = cfg.preset;
  if($('groundReliefAmount')) $('groundReliefAmount').value = cfg.amount;
  if($('groundReliefVariation')) $('groundReliefVariation').value = cfg.variation;
}

function updateGroundReliefFromEditor(){
  if(updateGroundReliefFromEditorMulti()) return;
  const target = getSelectedReliefTarget();
  if(!target){
    setStatus('請先在游標模式下點選一個牆面、天花板、地板、地板塊或作品。');
    syncGroundReliefEditor();
    return;
  }
  const current = ensureReliefConfigOnMaterial(target.cfg);
  target.cfg.relief = {
    ...current,
    preset: $('groundReliefPreset')?.value || 'flat',
    amount: clamp(safeFinite($('groundReliefAmount')?.value,0),0,1),
    variation: clamp(safeFinite($('groundReliefVariation')?.value,.5),0,1),
    seed: safeFinite(current.seed,104729)
  };
  rebuildSelectedMaterialTarget(target);
  syncGroundReliefEditor();
  scheduleSave();
  setStatus(`已把凹凸起伏套用到：${target.label}。`);
}


function getSelectedFloorPhysicsTarget(){
  const target = getSelectedMaterialTarget();
  if(!target) return null;
  if(target.kind === 'surface' && target.key === 'floor') return target;
  if(target.kind === 'floorTile') return target;
  return null;
}
function setFloorPhysicsEditorDisabled(disabled){ for(const id of ['floorPhysicsMaterial','sandColor','sandGrain','sandReaction']) if($(id)) $(id).disabled = disabled; }
function syncFloorPhysicsEditor(){
  if(syncFloorPhysicsEditorForMultiSelection()) return;
  const target = getSelectedFloorPhysicsTarget();
  if(!target){ setFloorPhysicsEditorDisabled(true); if($('floorPhysicsMaterial')) $('floorPhysicsMaterial').value='solid'; if($('sandColor')) $('sandColor').value=DEFAULT_SAND_CONFIG.color; if($('sandGrain')) $('sandGrain').value=DEFAULT_SAND_CONFIG.grain; if($('sandReaction')) $('sandReaction').value=DEFAULT_SAND_CONFIG.reaction; return; }
  setFloorPhysicsEditorDisabled(false); const sand=ensureSandConfigOnMaterial(target.cfg);
  if($('floorPhysicsMaterial')) $('floorPhysicsMaterial').value=sand.enabled?'sand':'solid';
  if($('sandColor')) $('sandColor').value=validColor(sand.color)?sand.color:DEFAULT_SAND_CONFIG.color;
  if($('sandGrain')) $('sandGrain').value=clamp(safeFinite(sand.grain,DEFAULT_SAND_CONFIG.grain),0,1);
  if($('sandReaction')) $('sandReaction').value=clamp(safeFinite(sand.reaction,DEFAULT_SAND_CONFIG.reaction),0,1);
}
function updateFloorPhysicsFromEditor(){
  if(updateFloorPhysicsFromEditorMulti()) return;
  const target=getSelectedFloorPhysicsTarget();
  if(!target){ setStatus('請先選取主地板或地板塊，再切換沙地材質。'); syncFloorPhysicsEditor(); return; }
  const sand=ensureSandConfigOnMaterial(target.cfg);
  sand.enabled = $('floorPhysicsMaterial')?.value === 'sand';
  const nextSandColor = validColor($('sandColor')?.value) ? $('sandColor').value : sand.color;
  sand.color = isNearBlackHex(nextSandColor) ? DEFAULT_SAND_CONFIG.color : nextSandColor;
  sand.grain = clamp(safeFinite($('sandGrain')?.value,sand.grain),0,1);
  sand.reaction = clamp(safeFinite($('sandReaction')?.value,sand.reaction),0,1);
  sandTextureCache.clear();
  target.cfg.sand=sand;
  if(sand.enabled){ target.cfg.color=sand.color; target.cfg.roughness=.96; target.cfg.metalness=0; target.cfg.relief=normalizeReliefConfig({preset:'flat',amount:0,variation:.5,seed:104729}); }
  rebuildSelectedMaterialTarget(target); syncFloorPhysicsEditor(); syncSurfaceEditor(); syncObjectEditor(); syncGroundReliefEditor(); scheduleSave();
  setStatus(sand.enabled ? `已將 ${target.label} 切換為沙地，沙色已套用為 ${sand.color}。` : `已將 ${target.label} 切回一般硬質地板。`);
}

function syncReferenceArchitectureMaterialEditor(){
  const cfg = sanitizeReferenceArchitectureMaterial(STATE?.referenceArchitecture?.material);
  STATE.referenceArchitecture = STATE.referenceArchitecture || {enabled:true, material:cfg};
  STATE.referenceArchitecture.material = cfg;
  if($('referenceArchitectureColor')) $('referenceArchitectureColor').value = cfg.color;
  if($('referenceArchitectureRoughness')) $('referenceArchitectureRoughness').value = cfg.roughness;
  if($('referenceArchitectureMetalness')) $('referenceArchitectureMetalness').value = cfg.metalness;
  if($('referenceArchitectureRepeatX')) $('referenceArchitectureRepeatX').value = cfg.repeat?.[0] ?? 1;
  if($('referenceArchitectureRepeatY')) $('referenceArchitectureRepeatY').value = cfg.repeat?.[1] ?? 1;
}

function updateReferenceArchitectureMaterialFromEditor(){
  STATE.referenceArchitecture = STATE.referenceArchitecture || {enabled:true, material:createReferenceArchitectureMaterial()};
  const cfg = sanitizeReferenceArchitectureMaterial(STATE.referenceArchitecture.material);
  if($('referenceArchitectureColor')) cfg.color = validColor($('referenceArchitectureColor').value) ? $('referenceArchitectureColor').value : cfg.color;
  if($('referenceArchitectureRoughness')) cfg.roughness = clamp(safeFinite($('referenceArchitectureRoughness').value, cfg.roughness), 0, 1);
  if($('referenceArchitectureMetalness')) cfg.metalness = clamp(safeFinite($('referenceArchitectureMetalness').value, cfg.metalness), 0, 1);
  cfg.repeat = [
    clamp(safeFinite($('referenceArchitectureRepeatX')?.value, cfg.repeat?.[0] ?? 1), .2, 24),
    clamp(safeFinite($('referenceArchitectureRepeatY')?.value, cfg.repeat?.[1] ?? 1), .2, 24)
  ];
  STATE.referenceArchitecture.material = cfg;
  rebuildReferenceArchitectureMaterials();
  scheduleSave();
}

function syncEnvironmentEditor(){
  if($('spaceBgColor')) $('spaceBgColor').value = validColor(STATE.backgroundColor) ? STATE.backgroundColor : '#080808';
  if($('skyTintColor')) $('skyTintColor').value = validColor(STATE.skyTintColor) ? STATE.skyTintColor : '#ffffff';
  if($('skyTintStrength')) $('skyTintStrength').value = clamp(safeFinite(STATE.skyTintStrength,0),0,1);
}

function updateBackgroundFromEditor(){
  STATE.backgroundColor = $('spaceBgColor').value;
  applyEnvironmentColors();
  scheduleSave();
}

function getSelectedMaterialTarget(){
  if(selectedWallId){
    const w = getSelectedWall();
    if(!w) return null;
    w.material = {...{color:'#d6d1c6',roughness:.95,metalness:0,texture:null,repeat:[1,1]}, ...(w.material||{})};
    return {kind:'customWall', label:`自建牆｜${w.title}`, cfg:w.material};
  }
  if(selectedRoomWallKey){
    const key = selectedRoomWallKey;
    if(!STATE.surfaces[key]) return null;
    STATE.surfaces[key] = {...{color:'#cccccc',roughness:.95,metalness:0,texture:null,repeat:[1,1]}, ...(STATE.surfaces[key]||{})};
    return {kind:'surface', key, label:`原始面｜${SURFACE_LABELS[key]}`, cfg:STATE.surfaces[key]};
  }
  if(selectedFloorTileId){
    const t = (STATE.floorTiles||[]).find(item=>item.id===selectedFloorTileId);
    if(!t) return null;
    t.material = {...(STATE.surfaces.floor||{color:'#8d897f',roughness:.9,metalness:0,texture:null,repeat:[4,4]}), ...(t.material||{})};
    return {kind:'floorTile', label:`地板塊｜${t.title || t.id}`, cfg:t.material};
  }
  if(selectedReferenceArchitectureActive){
    STATE.referenceArchitecture = STATE.referenceArchitecture || {enabled:true, visible:true, locked:false, material:createReferenceArchitectureMaterial()};
    STATE.referenceArchitecture.material = sanitizeReferenceArchitectureMaterial(STATE.referenceArchitecture.material);
    return {kind:'referenceArchitecture', label:'參考圖建築｜整體', cfg:STATE.referenceArchitecture.material};
  }
  return null;
}

function setSurfaceEditorDisabled(disabled){
  for(const id of ['surfaceColor','surfaceRoughness','surfaceMetalness','surfaceRepeatX','surfaceRepeatY','importSurfaceTexture','clearSurfaceTexture','deleteSelectedSurface']){
    if($(id)) $(id).disabled = disabled;
  }
  if($('restoreRoomWalls')) $('restoreRoomWalls').disabled = false;
}

function rebuildSelectedMaterialTarget(target){
  if(!target) return;
  if(target.kind === 'customWall') rebuildCustomWalls();
  else if(target.kind === 'floorTile') rebuildFloorTiles();
  else if(target.kind === 'surface') buildRoom();
  else if(target.kind === 'referenceArchitecture') buildReferenceArchitecture();
  else if(target.kind === 'artwork'){
    const art = (STATE.artworks || []).find(a=>a.id === target.id);
    if(art) refreshImageArtworkSurface(art);
  }
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
}

function syncSurfaceEditor(){
  if(syncSurfaceEditorForMultiSelection()) return;
  const target = getSelectedMaterialTarget();
  if(!target){
    setSurfaceEditorDisabled(true);
    if($('surfaceColor')) $('surfaceColor').value = '#ffffff';
    if($('surfaceRoughness')) $('surfaceRoughness').value = 0.95;
    if($('surfaceMetalness')) $('surfaceMetalness').value = 0;
    if($('surfaceRepeatX')) $('surfaceRepeatX').value = 1;
    if($('surfaceRepeatY')) $('surfaceRepeatY').value = 1;
    syncFloorPhysicsEditor();
    return;
  }
  setSurfaceEditorDisabled(false);
  const cfg = target.cfg;
  const sand = normalizeSandConfig(cfg.sand || {});
  $('surfaceColor').value = sand.enabled && validColor(sand.color) ? sand.color : (validColor(cfg.color) ? cfg.color : '#cccccc');
  $('surfaceRoughness').value = clamp(safeFinite(cfg.roughness,.95),0,1);
  $('surfaceMetalness').value = clamp(safeFinite(cfg.metalness,0),0,1);
  $('surfaceRepeatX').value = clamp(safeFinite(cfg.repeat?.[0],1),1,12);
  $('surfaceRepeatY').value = clamp(safeFinite(cfg.repeat?.[1],1),1,12);
  syncFloorPhysicsEditor();
}

function updateSurfaceFromEditor(){
  if(updateSurfaceFromEditorMulti()) return;
  const target = getSelectedMaterialTarget();
  if(!target){ setStatus('請先在游標模式下點選一個牆面、天花板、地板或地板塊。'); return; }
  const cfg = target.cfg;
  const chosenColor = validColor($('surfaceColor')?.value) ? $('surfaceColor').value : (cfg.color || '#cccccc');
  cfg.color = chosenColor;
  const sand = ensureSandConfigOnMaterial(cfg);
  if(sand.enabled){
    sand.color = isNearBlackHex(chosenColor) ? DEFAULT_SAND_CONFIG.color : chosenColor;
    cfg.sand = sand;
    sandTextureCache.clear();
    if($('sandColor')) $('sandColor').value = sand.color;
  }
  cfg.roughness = Number($('surfaceRoughness').value);
  cfg.metalness = Number($('surfaceMetalness').value);
  cfg.repeat = [Number($('surfaceRepeatX').value), Number($('surfaceRepeatY').value)];
  rebuildSelectedMaterialTarget(target);
  syncObjectEditor();
  syncFloorPhysicsEditor();
  scheduleSave();
}


function getActiveMultiSelectionItems(){
  const result = [];
  const seen = new Set();
  for(const key of Array.from(multiSelectedObjectKeys || [])){
    const item = parseObjectKey(key);
    if(!item?.id || item.type === 'objectGroup') continue;
    const normalizedKey = makeObjectKey(item.type, item.id);
    if(seen.has(normalizedKey)) continue;
    if(!getObjectState(item.type, item.id)) continue;
    if(!isObjectSelectable(item.type, item.id)) continue;
    seen.add(normalizedKey);
    result.push({type:item.type, id:item.id, key:normalizedKey});
  }
  return result;
}

function hasUsableMultiSelection(){
  return getActiveMultiSelectionItems().length >= 2;
}

function getMultiSelectionItemsOfType(type){
  const normalized = normalizeObjectKeyType(type);
  return getActiveMultiSelectionItems().filter(item=>item.type === normalized);
}

function getCustomWallForItem(item){
  return item?.type === 'customWall' ? (STATE.customWalls || []).find(w=>w.id === item.id) || null : null;
}

function getFloorTileForItem(item){
  return item?.type === 'floorTile' ? (STATE.floorTiles || []).find(t=>t.id === item.id) || null : null;
}

function getWaterBodyForItem(item){
  return item?.type === 'waterBody' ? (STATE.waterBodies || []).find(w=>w.id === item.id) || null : null;
}

function getArtworkForItem(item){
  return item?.type === 'artwork' ? (STATE.artworks || []).find(a=>a.id === item.id) || null : null;
}

function getLightForItem(item){
  return item?.type === 'light' ? (STATE.lightSystem?.lights || []).find(l=>l.id === item.id) || null : null;
}

function getEditableObjectSize(item){
  if(item.type === 'customWall'){
    const w = getCustomWallForItem(item); if(!w) return null;
    return {x:safeFinite(w.size?.w,3), y:safeFinite(w.size?.h,ROOM.height), z:safeFinite(w.size?.t,.18)};
  }
  if(item.type === 'roomSurface'){
    const tr = getSurfaceTransform(item.id);
    return {x:safeFinite(tr.size?.x,1), y:safeFinite(tr.size?.y,1), z:safeFinite(tr.size?.z,.18)};
  }
  if(item.type === 'floorTile'){
    const t = getFloorTileForItem(item); if(!t) return null;
    return {x:safeFinite(t.size?.w,4), y:safeFinite(t.size?.t,.18), z:safeFinite(t.size?.d,4)};
  }
  if(item.type === 'waterBody'){
    const w = getWaterBodyForItem(item); if(!w) return null;
    return {x:safeFinite(w.size?.w,4), y:safeFinite(w.size?.h,.72), z:safeFinite(w.size?.d,2)};
  }
  if(item.type === 'artwork'){
    const a = getArtworkForItem(item); if(!a) return null;
    a.size = a.size || {w:a.type === 'model' ? 1.5 : 3, h:a.type === 'model' ? 1.5 : 3, d:a.type === 'model' ? 1.5 : 1};
    return {x:safeFinite(a.size?.w,3), y:safeFinite(a.size?.h,3), z:safeFinite(a.size?.d,a.type === 'model' ? 1.5 : 1)};
  }
  return null;
}

function getEditableObjectColor(item){
  if(item.type === 'customWall'){
    const w = getCustomWallForItem(item); return validColor(w?.material?.color) ? w.material.color : '#d6d1c6';
  }
  if(item.type === 'roomSurface'){
    const cfg = STATE.surfaces?.[item.id] || {};
    const sand = normalizeSandConfig(cfg.sand || {});
    return sand.enabled && validColor(sand.color) ? sand.color : (validColor(cfg.color) ? cfg.color : '#cccccc');
  }
  if(item.type === 'floorTile'){
    const t = getFloorTileForItem(item);
    const sand = normalizeSandConfig(t?.material?.sand || {});
    return sand.enabled && validColor(sand.color) ? sand.color : (validColor(t?.material?.color) ? t.material.color : (STATE.surfaces?.floor?.color || '#8d897f'));
  }
  if(item.type === 'waterBody'){
    const w = getWaterBodyForItem(item); return validColor(w?.water?.color) ? w.water.color : '#4bbcff';
  }
  return '#ffffff';
}

function applyEditableObjectValues(item, size, color){
  const flags = {room:false, walls:false, floors:false, water:false, art:false, sand:false};
  if(item.type === 'customWall'){
    const w = getCustomWallForItem(item); if(!w) return flags;
    w.size = w.size || {w:3,h:ROOM.height,t:.18};
    w.size.w = clamp(safeFinite(size.x,w.size.w), .02, 500);
    w.size.h = clamp(safeFinite(size.y,w.size.h), .02, 500);
    w.size.t = clamp(safeFinite(size.z,w.size.t), .02, 500);
    w.material = {...{color:'#d6d1c6',roughness:.95,metalness:0,texture:null,repeat:[1,1]}, ...(w.material||{})};
    if(validColor(color)) w.material.color = color;
    flags.walls = true;
  }else if(item.type === 'roomSurface'){
    const key = item.id;
    if(!STATE.surfaces?.[key]) return flags;
    const tr = getSurfaceTransform(key);
    STATE.surfaceTransforms[key] = {
      position:{x:safeFinite(tr.position?.x,0), y:safeFinite(tr.position?.y,0), z:safeFinite(tr.position?.z,0)},
      size:{x:clamp(safeFinite(size.x,tr.size?.x),.02,500), y:clamp(safeFinite(size.y,tr.size?.y),.02,500), z:clamp(safeFinite(size.z,tr.size?.z),.02,500)}
    };
    if(validColor(color)){
      STATE.surfaces[key].color = color;
      const sand = ensureSandConfigOnMaterial(STATE.surfaces[key]);
      if(sand.enabled){
        sand.color = isNearBlackHex(color) ? DEFAULT_SAND_CONFIG.color : color;
        STATE.surfaces[key].sand = sand;
        flags.sand = true;
      }
    }
    flags.room = true;
  }else if(item.type === 'floorTile'){
    const t = getFloorTileForItem(item); if(!t) return flags;
    t.size = t.size || {w:4,d:4,t:.18};
    t.size.w = clamp(safeFinite(size.x,t.size.w), .02, 500);
    t.size.t = clamp(safeFinite(size.y,t.size.t), .02, 500);
    t.size.d = clamp(safeFinite(size.z,t.size.d), .02, 500);
    t.material = {...(STATE.surfaces?.floor || {color:'#8d897f',roughness:.9,metalness:0,texture:null,repeat:[4,4]}), ...(t.material||{})};
    if(validColor(color)){
      t.material.color = color;
      const sand = ensureSandConfigOnMaterial(t.material);
      if(sand.enabled){
        sand.color = isNearBlackHex(color) ? DEFAULT_SAND_CONFIG.color : color;
        t.material.sand = sand;
        flags.sand = true;
      }
    }
    flags.floors = true;
  }else if(item.type === 'waterBody'){
    const body = getWaterBodyForItem(item); if(!body) return flags;
    body.size = body.size || {w:4,d:2,h:.72,t:.12};
    body.size.w = clamp(safeFinite(size.x,body.size.w), .2, 500);
    body.size.h = clamp(safeFinite(size.y,body.size.h), .05, 500);
    body.size.d = clamp(safeFinite(size.z,body.size.d), .2, 500);
    body.water = body.water || {};
    if(validColor(color)) body.water.color = color;
    flags.water = true;
  }else if(item.type === 'artwork'){
    const art = getArtworkForItem(item); if(!art) return flags;
    art.size = art.size || {w:art.type === 'model' ? 1.5 : 3, h:art.type === 'model' ? 1.5 : 3, d:art.type === 'model' ? 1.5 : 1};
    art.size.w = clamp(safeFinite(size.x,art.size.w), .01, 500);
    art.size.h = clamp(safeFinite(size.y,art.size.h), .01, 500);
    art.size.d = clamp(safeFinite(size.z,art.size.d), .01, 500);
    placeArtwork(art);
    flags.art = true;
  }
  return flags;
}

function mergeRebuildFlags(dst, src){
  for(const k of Object.keys(src || {})) dst[k] = !!(dst[k] || src[k]);
  return dst;
}

function rebuildAfterMultiObjectEdit(flags={}){
  if(flags.sand) sandTextureCache.clear();
  if(flags.room) buildRoom();
  if(flags.walls) rebuildCustomWalls();
  if(flags.floors) rebuildFloorTiles();
  if(flags.water) buildWaterBodies();
  if(flags.art){ refreshArtworkSelectionVisuals(); syncArtEditor(); }
  if(flags.light){ rebuildLightSystem(); markLightingBakeStale('multi-light-change'); }
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  refreshWaterSelectionVisuals?.();
  applyObjectVisibilityLocks();
  renderObjectPanel();
}

function syncObjectEditorForMultiSelection(){
  const items = getActiveMultiSelectionItems();
  if(items.length < 2) return false;
  const editable = items.filter(item=>!!getEditableObjectSize(item));
  $('selectedObjectName').value = editable.length === items.length ? `多選｜${items.length} 件` : `多選｜${editable.length}/${items.length} 件可調尺寸`;
  if(!editable.length){
    setObjectEditorDisabled(true);
    for(const id of ['objectSizeX','objectSizeY','objectSizeZ']) if($(id)) $(id).value = '';
    if($('objectColor')) $('objectColor').value = '#ffffff';
    return true;
  }
  setObjectEditorDisabled(false);
  const firstSize = getEditableObjectSize(editable[0]);
  $('objectSizeX').value = Number(firstSize.x).toFixed(2);
  $('objectSizeY').value = Number(firstSize.y).toFixed(2);
  $('objectSizeZ').value = Number(firstSize.z).toFixed(2);
  $('objectColor').value = getEditableObjectColor(editable[0]);
  return true;
}

function updateMultiObjectFromEditor(){
  const items = getActiveMultiSelectionItems();
  if(items.length < 2) return false;
  const editable = items.filter(item=>!!getEditableObjectSize(item));
  if(!editable.length){ setStatus('目前多選物件沒有可共同調整尺寸的項目。'); return true; }
  const size = {
    x:readObjectNumber('objectSizeX', getEditableObjectSize(editable[0]).x, .01, 500),
    y:readObjectNumber('objectSizeY', getEditableObjectSize(editable[0]).y, .01, 500),
    z:readObjectNumber('objectSizeZ', getEditableObjectSize(editable[0]).z, .01, 500)
  };
  const color = validColor($('objectColor')?.value) ? $('objectColor').value : getEditableObjectColor(editable[0]);
  const flags = {room:false,walls:false,floors:false,water:false,art:false,sand:false};
  for(const item of editable) mergeRebuildFlags(flags, applyEditableObjectValues(item, size, color));
  rebuildAfterMultiObjectEdit(flags);
  syncSurfaceEditor();
  syncFloorPhysicsEditor();
  syncGroundReliefEditor();
  syncWallEditor();
  syncWaterEditor?.();
  syncLightEditor();
  scheduleSave();
  setStatus(`已套用多選物件尺寸／顏色：${editable.length} 件。`);
  return true;
}

function materialTargetFromSelectionItem(item){
  if(item.type === 'customWall'){
    const w = getCustomWallForItem(item); if(!w) return null;
    w.material = {...{color:'#d6d1c6',roughness:.95,metalness:0,texture:null,repeat:[1,1]}, ...(w.material||{})};
    return {kind:'customWall', id:w.id, label:`自建牆｜${w.title || w.id}`, cfg:w.material, item};
  }
  if(item.type === 'roomSurface'){
    const key = item.id;
    if(!STATE.surfaces?.[key]) return null;
    STATE.surfaces[key] = {...{color:'#cccccc',roughness:.95,metalness:0,texture:null,repeat:[1,1]}, ...(STATE.surfaces[key]||{})};
    return {kind:'surface', key, label:`原始面｜${SURFACE_LABELS[key] || key}`, cfg:STATE.surfaces[key], item};
  }
  if(item.type === 'floorTile'){
    const t = getFloorTileForItem(item); if(!t) return null;
    t.material = {...(STATE.surfaces?.floor || {color:'#8d897f',roughness:.9,metalness:0,texture:null,repeat:[4,4]}), ...(t.material||{})};
    return {kind:'floorTile', id:t.id, label:`地板塊｜${t.title || t.id}`, cfg:t.material, item};
  }
  if(item.type === 'referenceArchitecture'){
    STATE.referenceArchitecture = STATE.referenceArchitecture || {enabled:true, visible:true, locked:false, material:createReferenceArchitectureMaterial()};
    STATE.referenceArchitecture.material = sanitizeReferenceArchitectureMaterial(STATE.referenceArchitecture.material);
    return {kind:'referenceArchitecture', label:'參考圖建築｜整體', cfg:STATE.referenceArchitecture.material, item};
  }
  if(item.type === 'artwork'){
    const art = getArtworkForItem(item);
    if(!art || art.type === 'model') return null;
    return {kind:'artwork', id:art.id, label:`作品｜${art.title || art.id}`, cfg:ensureArtworkSurfaceMaterial(art), item};
  }
  return null;
}

function materialTargetGroupKey(target){
  if(!target) return '';
  if(target.kind === 'customWall') return 'wall';
  if(target.kind === 'surface'){
    if(['front','back','left','right'].includes(target.key)) return 'wall';
    if(target.key === 'floor') return 'floor';
    if(target.key === 'ceiling') return 'ceiling';
    return `surface:${target.key}`;
  }
  if(target.kind === 'floorTile') return 'floor';
  return target.kind;
}

function getValidatedMultiMaterialTargets({allowArtwork=false, requireSameGroup=false}={}){
  const items = getActiveMultiSelectionItems();
  if(items.length < 2) return [];
  const targets = items
    .map(materialTargetFromSelectionItem)
    .filter(Boolean)
    .filter(t=>allowArtwork || t.kind !== 'artwork');
  // Common material operations must work across walls, floors, ceiling, floor tiles,
  // and the reference architecture.  The previous implementation rejected mixed
  // wall + floor selections because their group keys differed, so importing one
  // texture to a selected row of walls and floors silently failed.
  if(targets.length < 2 || targets.length !== items.length) return [];
  if(requireSameGroup){
    const group = materialTargetGroupKey(targets[0]);
    if(!group || targets.some(t=>materialTargetGroupKey(t) !== group)) return [];
  }
  return targets;
}

function syncSurfaceEditorForMultiSelection(){
  const items = getActiveMultiSelectionItems();
  if(items.length < 2) return false;
  const targets = getValidatedMultiMaterialTargets({allowArtwork:false});
  if(!targets.length){
    const hasAnyMaterial = items.some(item=>!!materialTargetFromSelectionItem(item));
    if(hasAnyMaterial){
      setSurfaceEditorDisabled(true);
      syncFloorPhysicsEditor();
      return true;
    }
    return false;
  }
  setSurfaceEditorDisabled(false);
  const cfg = targets[0].cfg;
  const sand = normalizeSandConfig(cfg.sand || {});
  $('surfaceColor').value = sand.enabled && validColor(sand.color) ? sand.color : (validColor(cfg.color) ? cfg.color : '#cccccc');
  $('surfaceRoughness').value = clamp(safeFinite(cfg.roughness,.95),0,1);
  $('surfaceMetalness').value = clamp(safeFinite(cfg.metalness,0),0,1);
  $('surfaceRepeatX').value = clamp(safeFinite(cfg.repeat?.[0],1),1,12);
  $('surfaceRepeatY').value = clamp(safeFinite(cfg.repeat?.[1],1),1,12);
  const allFloorPhysicsTargets = targets.every(t=>materialTargetGroupKey(t) === 'floor');
  if(allFloorPhysicsTargets) syncFloorPhysicsEditor();
  else{
    setFloorPhysicsEditorDisabled(true);
    if($('floorPhysicsMaterial')) $('floorPhysicsMaterial').value = 'solid';
    if($('sandColor')) $('sandColor').value = DEFAULT_SAND_CONFIG.color;
    if($('sandGrain')) $('sandGrain').value = DEFAULT_SAND_CONFIG.grain;
    if($('sandReaction')) $('sandReaction').value = DEFAULT_SAND_CONFIG.reaction;
  }
  return true;
}

function rebuildMultiMaterialTargets(targets){
  const flags = {room:false,walls:false,floors:false,art:false,reference:false};
  for(const t of targets){
    if(t.kind === 'customWall') flags.walls = true;
    else if(t.kind === 'floorTile') flags.floors = true;
    else if(t.kind === 'surface') flags.room = true;
    else if(t.kind === 'referenceArchitecture') flags.reference = true;
    else if(t.kind === 'artwork') flags.art = true;
  }
  if(flags.room) buildRoom();
  if(flags.walls) rebuildCustomWalls();
  if(flags.floors) rebuildFloorTiles();
  if(flags.reference) buildReferenceArchitecture();
  if(flags.art){
    for(const t of targets){
      if(t.kind === 'artwork'){
        const art = (STATE.artworks || []).find(a=>a.id === t.id);
        if(art) refreshImageArtworkSurface(art);
      }
    }
  }
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  applyObjectVisibilityLocks();
  renderObjectPanel();
}

function updateSurfaceFromEditorMulti(){
  const items = getActiveMultiSelectionItems();
  if(items.length < 2) return false;
  const targets = getValidatedMultiMaterialTargets({allowArtwork:false});
  if(!targets.length){ setStatus('多選材質未套用：多選中必須全部都是可套用材質的物件，例如牆面、地板、地板塊、天花板或參考建築。'); syncSurfaceEditor(); return true; }
  const chosenColor = validColor($('surfaceColor')?.value) ? $('surfaceColor').value : (targets[0].cfg.color || '#cccccc');
  for(const target of targets){
    const cfg = target.cfg;
    cfg.color = chosenColor;
    const sand = ensureSandConfigOnMaterial(cfg);
    if(sand.enabled){
      sand.color = isNearBlackHex(chosenColor) ? DEFAULT_SAND_CONFIG.color : chosenColor;
      cfg.sand = sand;
      sandTextureCache.clear();
      if($('sandColor')) $('sandColor').value = sand.color;
    }
    cfg.roughness = Number($('surfaceRoughness').value);
    cfg.metalness = Number($('surfaceMetalness').value);
    cfg.repeat = [Number($('surfaceRepeatX').value), Number($('surfaceRepeatY').value)];
  }
  rebuildMultiMaterialTargets(targets);
  syncObjectEditor();
  syncFloorPhysicsEditor();
  scheduleSave();
  setStatus(`已將材質參數同步套用到多選物件：${targets.length} 件。`);
  return true;
}

function applyMultiSurfaceTexture(src, fileName){
  const targets = getValidatedMultiMaterialTargets({allowArtwork:false});
  if(!targets.length) return false;
  for(const target of targets) target.cfg.texture = src;
  rebuildMultiMaterialTargets(targets);
  scheduleSave();
  setStatus(`已將同一張材質貼圖同步套用到多選物件：${targets.length} 件｜${fileName}`);
  return true;
}

function clearMultiSurfaceTexture(){
  const targets = getValidatedMultiMaterialTargets({allowArtwork:false});
  if(!targets.length) return false;
  for(const target of targets) target.cfg.texture = null;
  rebuildMultiMaterialTargets(targets);
  scheduleSave();
  setStatus(`已清除多選物件貼圖：${targets.length} 件。`);
  return true;
}

function getValidatedMultiReliefTargets(){
  return getValidatedMultiMaterialTargets({allowArtwork:true});
}

function updateGroundReliefFromEditorMulti(){
  const items = getActiveMultiSelectionItems();
  if(items.length < 2) return false;
  const targets = getValidatedMultiReliefTargets();
  if(!targets.length){ setStatus('多選凹凸未套用：請只選取同屬性材質物件。'); syncGroundReliefEditor(); return true; }
  for(const target of targets){
    const current = ensureReliefConfigOnMaterial(target.cfg);
    target.cfg.relief = {
      ...current,
      preset: $('groundReliefPreset')?.value || 'flat',
      amount: clamp(safeFinite($('groundReliefAmount')?.value,0),0,1),
      variation: clamp(safeFinite($('groundReliefVariation')?.value,.5),0,1),
      seed: safeFinite(current.seed,104729)
    };
  }
  rebuildMultiMaterialTargets(targets);
  syncGroundReliefEditor();
  scheduleSave();
  setStatus(`已把凹凸起伏套用到多選物件：${targets.length} 件。`);
  return true;
}

function syncGroundReliefEditorForMultiSelection(){
  const items = getActiveMultiSelectionItems();
  if(items.length < 2) return false;
  const targets = getValidatedMultiReliefTargets();
  if(!targets.length) return false;
  setGroundReliefEditorDisabled(false);
  const cfg = getReliefConfigForMaterial(targets[0].cfg);
  if($('groundReliefPreset')) $('groundReliefPreset').value = cfg.preset;
  if($('groundReliefAmount')) $('groundReliefAmount').value = cfg.amount;
  if($('groundReliefVariation')) $('groundReliefVariation').value = cfg.variation;
  return true;
}

function getValidatedMultiFloorPhysicsTargets(){
  const items = getActiveMultiSelectionItems();
  if(items.length < 2) return [];
  const targets = items.map(materialTargetFromSelectionItem).filter(Boolean);
  if(targets.length !== items.length || targets.length < 2) return [];
  if(targets.some(t=>materialTargetGroupKey(t) !== 'floor')) return [];
  return targets;
}

function syncFloorPhysicsEditorForMultiSelection(){
  const targets = getValidatedMultiFloorPhysicsTargets();
  if(!targets.length) return false;
  setFloorPhysicsEditorDisabled(false);
  const sand = ensureSandConfigOnMaterial(targets[0].cfg);
  if($('floorPhysicsMaterial')) $('floorPhysicsMaterial').value = sand.enabled ? 'sand' : 'solid';
  if($('sandColor')) $('sandColor').value = validColor(sand.color) ? sand.color : DEFAULT_SAND_CONFIG.color;
  if($('sandGrain')) $('sandGrain').value = clamp(safeFinite(sand.grain,DEFAULT_SAND_CONFIG.grain),0,1);
  if($('sandReaction')) $('sandReaction').value = clamp(safeFinite(sand.reaction,DEFAULT_SAND_CONFIG.reaction),0,1);
  return true;
}

function updateFloorPhysicsFromEditorMulti(){
  const items = getActiveMultiSelectionItems();
  if(items.length < 2) return false;
  const targets = getValidatedMultiFloorPhysicsTargets();
  if(!targets.length){ setStatus('多選沙地未套用：請只選取主地板與地板塊。'); syncFloorPhysicsEditor(); return true; }
  const enabled = $('floorPhysicsMaterial')?.value === 'sand';
  for(const target of targets){
    const sand = ensureSandConfigOnMaterial(target.cfg);
    sand.enabled = enabled;
    const nextSandColor = validColor($('sandColor')?.value) ? $('sandColor').value : sand.color;
    sand.color = isNearBlackHex(nextSandColor) ? DEFAULT_SAND_CONFIG.color : nextSandColor;
    sand.grain = clamp(safeFinite($('sandGrain')?.value,sand.grain),0,1);
    sand.reaction = clamp(safeFinite($('sandReaction')?.value,sand.reaction),0,1);
    target.cfg.sand = sand;
    if(sand.enabled){ target.cfg.color = sand.color; target.cfg.roughness = .96; target.cfg.metalness = 0; target.cfg.relief = normalizeReliefConfig({preset:'flat',amount:0,variation:.5,seed:104729}); }
  }
  sandTextureCache.clear();
  rebuildMultiMaterialTargets(targets);
  syncFloorPhysicsEditor(); syncSurfaceEditor(); syncObjectEditor(); syncGroundReliefEditor();
  scheduleSave();
  setStatus(enabled ? `已將多選地板切換為沙地：${targets.length} 件。` : `已將多選地板切回硬質地板：${targets.length} 件。`);
  return true;
}

function getMultiCustomWallsForEdit(){
  const list = getMultiSelectionItemsOfType('customWall').map(item=>getCustomWallForItem(item)).filter(Boolean);
  return list.length >= 2 ? list : [];
}

function updateMultiWallsFromEditor(){
  const walls = getMultiCustomWallsForEdit();
  if(!walls.length) return false;
  const shape = $('wallShape')?.value === 'curved' ? 'curved' : 'straight';
  for(const w of walls){
    w.size = w.size || {w:3,h:ROOM.height,t:.18};
    w.size.w = clamp(Number($('wallW').value), .5, 500);
    w.size.h = clamp(Number($('wallH').value), .5, 500);
    const r = wallRotation(w);
    r.y = clamp(Number($('wallRY').value), -180, 180);
    w.rotation = r;
    w.rotationY = r.y;
    w.manualRotation = true;
    w.material = {...{color:'#d6d1c6',roughness:.95,metalness:0,texture:null,repeat:[1,1]}, ...(w.material||{})};
    w.material.color = $('wallColor').value;
    w.shape = shape;
    w.curve = w.curve || {};
    w.curve.enabled = shape === 'curved';
    w.curve.amount = shape === 'curved' ? clamp(Number($('wallCurveAmount')?.value ?? w.curve.amount ?? .35),0,1) : 0;
    w.curve.direction = $('wallCurveDirection')?.value === 'back' ? 'back' : 'front';
  }
  rebuildCustomWalls();
  syncObjectEditor();
  renderObjectPanel();
  scheduleSave();
  setStatus(`已將牆面尺寸／旋轉／型態套用到多選牆面：${walls.length} 面。`);
  return true;
}

function getMultiWaterBodiesForEdit(){
  const list = getMultiSelectionItemsOfType('waterBody').map(item=>getWaterBodyForItem(item)).filter(Boolean);
  return list.length >= 2 ? list : [];
}

function updateMultiWaterBodiesFromEditor(){
  const bodies = getMultiWaterBodiesForEdit();
  if(!bodies.length) return false;
  for(const body of bodies){
    body.shape = ['rect','cylinder','oval'].includes($('waterShape')?.value) ? $('waterShape').value : (body.shape || 'rect');
    body.size = body.size || {w:4,d:2,h:.72,t:.12};
    body.size.w = readWaterNumber('waterW', body.size?.w || 4, .2, 500);
    body.size.d = readWaterNumber('waterD', body.size?.d || 2, .2, 500);
    body.size.h = readWaterNumber('waterH', body.size?.h || .72, .05, 500);
    body.water = body.water || {};
    body.water.level = readWaterNumber('waterLevel', body.water.level ?? .72, .05, .98);
    body.water.color = validColor($('waterColor')?.value) ? $('waterColor').value : (body.water.color || '#4bbcff');
    body.water.opacity = readWaterNumber('waterOpacity', body.water.opacity ?? .55, .05, .95);
    body.water.wave = readWaterNumber('waterWave', body.water.wave ?? .45, 0, 1);
    body.water.causticStrength = readWaterNumber('waterCausticStrength', body.water.causticStrength ?? 1, 0, 3);
    body.water.interferenceStrength = readWaterNumber('waterInterferenceStrength', body.water.interferenceStrength ?? 1, 0, 3);
    body.water.motionDistortion = readWaterNumber('waterMotionDistortion', body.water.motionDistortion ?? 1, 0, 3);
    body.water.splash = readWaterNumber('waterSplash', body.water.splash ?? .65, 0, 1);
    body.containerMaterial = body.containerMaterial || {color:'#50545a',roughness:.82,metalness:.05,texture:null,repeat:[1,1]};
    body.containerMaterial.color = validColor($('waterContainerColor')?.value) ? $('waterContainerColor').value : (validColor(body.containerMaterial.color) ? body.containerMaterial.color : '#50545a');
    body.containerMaterial.repeat = [
      readWaterNumber('waterContainerRepeatX', body.containerMaterial.repeat?.[0] ?? 1, .2, 24),
      readWaterNumber('waterContainerRepeatY', body.containerMaterial.repeat?.[1] ?? 1, .2, 24)
    ];
  }
  buildWaterBodies(); syncWaterEditor(); syncObjectEditor(); renderObjectPanel(); scheduleSave();
  setStatus(`已將水體參數套用到多選水體：${bodies.length} 件。位置不會被同步，避免全部重疊。`);
  return true;
}

function getMultiLightsForEdit(){
  const list = getMultiSelectionItemsOfType('light').map(item=>getLightForItem(item)).filter(Boolean);
  return list.length >= 2 ? list : [];
}

function syncLightEditorForMultiSelection(){
  const lights = getMultiLightsForEdit();
  if(!lights.length) return false;
  const light = lights[0];
  setLightEditorDisabled(false);
  if($('lightTitle')) { $('lightTitle').value = `多選 ${lights.length} 個光源`; $('lightTitle').disabled = true; }
  if($('lightType')) $('lightType').value = light.type || 'point';
  if($('lightColor')) $('lightColor').value = validColor(light.color) ? light.color : '#ffffff';
  if($('lightIntensity')) $('lightIntensity').value = clamp(safeFinite(light.intensity,2),0,20);
  if($('lightX')) { $('lightX').value = ''; $('lightX').disabled = true; }
  if($('lightY')) { $('lightY').value = ''; $('lightY').disabled = true; }
  if($('lightZ')) { $('lightZ').value = ''; $('lightZ').disabled = true; }
  if($('lightTargetX')) $('lightTargetX').value = Number(safeFinite(light.target?.x,0)).toFixed(2);
  if($('lightTargetY')) $('lightTargetY').value = Number(safeFinite(light.target?.y,0)).toFixed(2);
  if($('lightTargetZ')) $('lightTargetZ').value = Number(safeFinite(light.target?.z,0)).toFixed(2);
  if($('lightDistance')) $('lightDistance').value = Number(clamp(safeFinite(light.distance,0),0,500)).toFixed(2);
  if($('lightDecay')) $('lightDecay').value = clamp(safeFinite(light.decay,2),0,4);
  if($('lightAngle')) $('lightAngle').value = clamp(safeFinite(light.angle,.72),0.05,1.55);
  if($('lightPenumbra')) $('lightPenumbra').value = clamp(safeFinite(light.penumbra,.25),0,1);
  if($('lightCastShadow')) $('lightCastShadow').checked = !!light.castShadow;
  if($('lightVisible')) $('lightVisible').checked = light.visible !== false;
  updateLightFieldVisibility(light);
  for(const id of ['lightX','lightY','lightZ']) if($(id)) $(id).disabled = true;
  if($('deleteSelectedLight')) $('deleteSelectedLight').disabled = true;
  if($('applyLightValues')) $('applyLightValues').disabled = false;
  return true;
}

function applyMultiLightsFromEditor(){
  const lights = getMultiLightsForEdit();
  if(!lights.length) return false;
  for(const light of lights){
    light.type = ['point','directional','spot'].includes($('lightType')?.value) ? $('lightType').value : light.type;
    light.color = validColor($('lightColor')?.value) ? $('lightColor').value : light.color;
    light.intensity = clamp(safeFinite($('lightIntensity')?.value, light.intensity),0,20);
    if(light.type !== 'point'){
      light.target = {
        x:safeFinite($('lightTargetX')?.value, light.target?.x || 0),
        y:safeFinite($('lightTargetY')?.value, light.target?.y || 0),
        z:safeFinite($('lightTargetZ')?.value, light.target?.z || 0)
      };
    }
    light.distance = clamp(safeFinite($('lightDistance')?.value, light.distance || 0),0,500);
    light.decay = clamp(safeFinite($('lightDecay')?.value, light.decay || 2),0,4);
    light.angle = clamp(safeFinite($('lightAngle')?.value, light.angle || .72),0.05,1.55);
    light.penumbra = clamp(safeFinite($('lightPenumbra')?.value, light.penumbra || .25),0,1);
    light.castShadow = !!$('lightCastShadow')?.checked;
    light.visible = !!$('lightVisible')?.checked;
    const updated = createLightState(light.type, light);
    Object.assign(light, updated);
  }
  rebuildLightSystem();
  markLightingBakeStale('multi-light-change');
  syncLightSelect();
  syncLightEditor();
  renderObjectPanel();
  scheduleSave();
  setStatus(`已將光源參數套用到多選光源：${lights.length} 個。位置未同步，避免光源全部重疊。`);
  return true;
}

function getMultiScalableItems(){
  const items = getActiveMultiSelectionItems().filter(item=>!!getEditableObjectSize(item));
  return items.length >= 2 ? items : [];
}

function toggleMultiObjectScaleMode(){
  const items = getMultiScalableItems();
  if(!items.length) return false;
  multiObjectScaleMode = !multiObjectScaleMode;
  wallScaleMode = false;
  artworkScaleMode = false;
  if(multiObjectScaleMode){
    detachWallRotationControls();
    desiredPointerLocked = false;
    cursorFreeMode = true;
    fallbackMouseLook = false;
    document.exitPointerLock?.();
    updateCursorVisibility();
    setStatus(`多選尺寸調整中：${items.length} 件。移動滑鼠等比縮放全部可調尺寸物件；Enter 套用，Esc 離開。`);
  }else{
    scheduleSave();
    setStatus('已結束多選尺寸調整。');
  }
  return true;
}

function resizeMultiSelectedObjectsByMouse(e){
  const items = getMultiScalableItems();
  if(!items.length){ multiObjectScaleMode = false; return; }
  const delta = (safeFinite(e.movementX,0) - safeFinite(e.movementY,0)) * .006;
  const factor = clamp(1 + delta, .82, 1.22);
  const flags = {room:false,walls:false,floors:false,water:false,art:false,sand:false};
  for(const item of items){
    const cur = getEditableObjectSize(item);
    if(!cur) continue;
    const color = getEditableObjectColor(item);
    mergeRebuildFlags(flags, applyEditableObjectValues(item, {x:cur.x*factor, y:cur.y*factor, z:cur.z*factor}, color));
  }
  rebuildAfterMultiObjectEdit(flags);
  syncObjectEditor();
}

function getMultiRotationItems(){
  const items = getActiveMultiSelectionItems();
  if(items.length < 2) return [];
  const rotatable = [];
  for(const item of items){
    if(item.type === 'customWall' && customWallMeshes[item.id]) rotatable.push(item);
    else if(item.type === 'artwork' && artworkMeshes[item.id]) rotatable.push(item);
    else if(item.type === 'light'){
      const light = getLightForItem(item);
      if(light && (light.type === 'directional' || light.type === 'spot') && lightControlObjects[item.id]) rotatable.push(item);
    }
  }
  return rotatable.length >= 2 && rotatable.length === items.length ? rotatable : [];
}

function clearMultiTransformAnchor(){
  if(multiTransformAnchor){
    scene?.remove?.(multiTransformAnchor);
    multiTransformAnchor = null;
  }
  multiTransformState = null;
}

function activateMultiRotationControls(){
  const items = getMultiRotationItems();
  if(!items.length || !transformControls) return false;
  clearMultiTransformAnchor();
  const center = new THREE.Vector3();
  const targets = [];
  for(const item of items){
    let obj = null;
    if(item.type === 'customWall') obj = customWallMeshes[item.id];
    else if(item.type === 'artwork') obj = artworkMeshes[item.id];
    else if(item.type === 'light') obj = lightControlObjects[item.id];
    if(!obj) continue;
    obj.updateMatrixWorld(true);
    const pos = new THREE.Vector3();
    const quat = new THREE.Quaternion();
    obj.getWorldPosition(pos);
    obj.getWorldQuaternion(quat);
    const target = {type:item.type, id:item.id, object:obj, position:pos.clone(), quaternion:quat.clone()};
    if(item.type === 'light'){
      const light = getLightForItem(item);
      const lp = new THREE.Vector3(safeFinite(light.position?.x,0), safeFinite(light.position?.y,4), safeFinite(light.position?.z,0));
      const lt = new THREE.Vector3(safeFinite(light.target?.x,0), safeFinite(light.target?.y,0), safeFinite(light.target?.z,0));
      let dir = lt.clone().sub(lp);
      if(dir.lengthSq() < .0001) dir.set(0,-1,0);
      target.lightPosition = lp;
      target.lightDistance = dir.length();
      target.lightDirection = dir.normalize();
    }
    center.add(pos);
    targets.push(target);
  }
  if(targets.length < 2) return false;
  center.multiplyScalar(1 / targets.length);
  multiTransformAnchor = new THREE.Object3D();
  multiTransformAnchor.name = 'multi-selection-rotation-anchor';
  multiTransformAnchor.userData.multiTransformAnchor = true;
  multiTransformAnchor.position.copy(center);
  scene.add(multiTransformAnchor);
  multiTransformState = {anchorStartPosition:center.clone(), anchorStartQuaternion:multiTransformAnchor.quaternion.clone(), targets};
  transformControls.attach(multiTransformAnchor);
  transformControls.setMode('rotate');
  transformControls.setSpace('local');
  transformControls.visible = true;
  transformControls.enabled = true;
  desiredPointerLocked = false;
  cursorFreeMode = true;
  fallbackMouseLook = false;
  document.exitPointerLock?.();
  updateCursorVisibility();
  setStatus(`已開啟多選 XYZ 旋轉軸：${targets.length} 件。拖拉旋轉軸會一起旋轉；Esc 關閉。`);
  return true;
}

function syncMultiTransformFromControls(){
  if(!multiTransformAnchor || !multiTransformState) return;
  const anchorQuat = multiTransformAnchor.quaternion.clone();
  const deltaQ = anchorQuat.multiply(multiTransformState.anchorStartQuaternion.clone().invert());
  const anchorPos = multiTransformState.anchorStartPosition.clone();
  const flags = {walls:false, art:false, light:false};
  for(const target of multiTransformState.targets || []){
    if(target.type === 'light'){
      const light = (STATE.lightSystem?.lights || []).find(l=>l.id === target.id);
      if(!light) continue;
      const newDir = target.lightDirection.clone().applyQuaternion(deltaQ).normalize();
      const dist = Math.max(.2, safeFinite(target.lightDistance,4));
      const newTarget = target.lightPosition.clone().addScaledVector(newDir, dist);
      light.target = {x:newTarget.x, y:newTarget.y, z:newTarget.z};
      flags.light = true;
      continue;
    }
    const rel = target.position.clone().sub(anchorPos).applyQuaternion(deltaQ);
    const newPos = anchorPos.clone().add(rel);
    const newQuat = deltaQ.clone().multiply(target.quaternion);
    const euler = new THREE.Euler().setFromQuaternion(newQuat, 'XYZ');
    if(target.type === 'customWall'){
      const wall = (STATE.customWalls || []).find(w=>w.id === target.id);
      if(!wall) continue;
      wall.position = wall.position || {x:0,y:safeFinite(wall.size?.h,ROOM.height)/2,z:0};
      wall.position.x = newPos.x;
      wall.position.y = newPos.y;
      wall.position.z = newPos.z;
      wall.rotation = {x:radToDeg(euler.x), y:radToDeg(euler.y), z:radToDeg(euler.z)};
      wall.rotationY = wall.rotation.y;
      wall.manualRotation = true;
      flags.walls = true;
    }else if(target.type === 'artwork'){
      const art = (STATE.artworks || []).find(a=>a.id === target.id);
      if(!art) continue;
      art.position = {x:newPos.x, y:newPos.y, z:newPos.z};
      art.rotation = {x:radToDeg(euler.x), y:radToDeg(euler.y), z:radToDeg(euler.z)};
      art.manualRotation = true;
      placeArtwork(art);
      flags.art = true;
    }
  }
  if(flags.walls) rebuildCustomWalls();
  if(flags.light){ rebuildLightSystem(); markLightingBakeStale('multi-light-rotation'); }
  syncWallEditor(); syncArtEditor(); syncLightEditor(); syncObjectEditor(); renderObjectPanel();
  scheduleSave();
}

function setObjectEditorDisabled(disabled){
  for(const id of ['objectSizeX','objectSizeY','objectSizeZ','objectColor']){
    if($(id)) $(id).disabled = disabled;
  }
  if($('applyObjectValues')) $('applyObjectValues').disabled = disabled;
  if($('deleteSelectedFloorTile')) $('deleteSelectedFloorTile').disabled = !selectedFloorTileId;
}

function markObjectEditorDirty(){
  objectEditorDirty = true;
  if($('applyObjectValues')) $('applyObjectValues').disabled = false;
}
function applyObjectEditorValues(){
  if(!$('selectedObjectName') || $('selectedObjectName').value === '無') return;
  objectEditorDirty = false;
  updateObjectFromEditor();
  syncObjectEditor();
  if($('applyObjectValues')) $('applyObjectValues').disabled = false;
  setStatus('已套用選取物數值。');
}

function syncObjectEditor(){
  if(!$('selectedObjectName')) return;
  objectEditorDirty = false;
  if(syncObjectEditorForMultiSelection()) return;
  let label = '無';
  let pos = null, size = null, color = '#ffffff';
  if(selectedWallId){
    const w = getSelectedWall();
    if(w){
      label = `自建牆｜${w.title}`;
      pos = {x:safeFinite(w.position?.x,0), y:safeFinite(w.position?.y,safeFinite(w.size?.h,ROOM.height)/2), z:safeFinite(w.position?.z,0)};
      size = {x:safeFinite(w.size?.w,3), y:safeFinite(w.size?.h,ROOM.height), z:safeFinite(w.size?.t,.18)};
      color = validColor(w.material?.color) ? w.material.color : '#d6d1c6';
    }
  }else if(selectedRoomWallKey){
    const tr = getSurfaceTransform(selectedRoomWallKey);
    label = `原始面｜${SURFACE_LABELS[selectedRoomWallKey]}`;
    pos = tr.position;
    size = tr.size;
    const cfg = STATE.surfaces[selectedRoomWallKey] || {};
    const sand = normalizeSandConfig(cfg.sand || {});
    color = sand.enabled && validColor(sand.color) ? sand.color : (validColor(cfg.color) ? cfg.color : '#cccccc');
  }else if(selectedWaterBodyId){
    const w = getSelectedWaterBody();
    if(w){
      label = `水體｜${w.title || w.id}`;
      pos = w.position;
      size = {x:safeFinite(w.size?.w,4), y:safeFinite(w.size?.h,.72), z:safeFinite(w.size?.d,2)};
      color = validColor(w.water?.color) ? w.water.color : '#4bbcff';
    }
  }else if(selectedFloorTileId){
    const t = (STATE.floorTiles||[]).find(item=>item.id===selectedFloorTileId);
    if(t){
      label = `地板塊｜${t.title || t.id}`;
      pos = {x:safeFinite(t.position?.x,0), y:safeFinite(t.position?.y,-safeFinite(t.size?.t,.18)/2), z:safeFinite(t.position?.z,0)};
      size = {x:safeFinite(t.size?.w,4), y:safeFinite(t.size?.t,.18), z:safeFinite(t.size?.d,4)};
      const sand = normalizeSandConfig(t.material?.sand || {});
      color = sand.enabled && validColor(sand.color) ? sand.color : (validColor(t.material?.color) ? t.material.color : (STATE.surfaces.floor?.color || '#8d897f'));
    }
  }else if(selectedWaterBodyId){
    const w = getSelectedWaterBody();
    if(w){
      label = `水體｜${w.title || w.id}`;
      pos = w.position;
      size = {x:safeFinite(w.size?.w,4), y:safeFinite(w.size?.h,.72), z:safeFinite(w.size?.d,2)};
      color = validColor(w.water?.color) ? w.water.color : '#4bbcff';
    }
  }else if(selectedReferenceArchitectureActive){
    label = '參考圖建築｜整體';
    color = validColor(STATE.referenceArchitecture?.material?.color) ? STATE.referenceArchitecture.material.color : '#e2eee6';
  }
  $('selectedObjectName').value = label;
  const disabled = !(pos && size);
  setObjectEditorDisabled(disabled);
  if(disabled){
    for(const id of ['objectSizeX','objectSizeY','objectSizeZ']) $(id).value = '';
    $('objectColor').value = '#ffffff';
    return;
  }
  $('objectSizeX').value = Number(size.x).toFixed(2);
  $('objectSizeY').value = Number(size.y).toFixed(2);
  $('objectSizeZ').value = Number(size.z).toFixed(2);
  $('objectColor').value = color;
}

function readObjectNumber(id, fallback, min=.02, max=500){
  const el = $(id);
  return clamp(safeFinite(el?.value, fallback), min, max);
}

function updateObjectFromEditor(){
  if(!$('selectedObjectName')) return;
  if(updateMultiObjectFromEditor()) return;
  if(selectedWallId){
    const w = getSelectedWall(); if(!w) return;
    w.position.y = safeFinite(w.position?.y, safeFinite(w.size?.h,ROOM.height)/2);
    w.size.w = readObjectNumber('objectSizeX', w.size?.w || 3, .02, 500);
    w.size.h = readObjectNumber('objectSizeY', w.size?.h || ROOM.height, .02, 500);
    w.size.t = readObjectNumber('objectSizeZ', w.size?.t || .18, .02, 500);
    w.material.color = $('objectColor').value;
    rebuildCustomWalls();
    syncWallEditor();
    if(!w.isDraft) scheduleSave();
    return;
  }
  if(selectedRoomWallKey){
    const key = selectedRoomWallKey;
    const tr = getSurfaceTransform(key);
    STATE.surfaceTransforms[key] = {
      position:{
        x:tr.position.x,
        y:tr.position.y,
        z:tr.position.z
      },
      size:{
        x:readObjectNumber('objectSizeX', tr.size.x, .02, 500),
        y:readObjectNumber('objectSizeY', tr.size.y, .02, 500),
        z:readObjectNumber('objectSizeZ', tr.size.z, .02, 500)
      }
    };
    const chosenColor = validColor($('objectColor')?.value) ? $('objectColor').value : (STATE.surfaces[key].color || '#cccccc');
    STATE.surfaces[key].color = chosenColor;
    const sand = ensureSandConfigOnMaterial(STATE.surfaces[key]);
    if(sand.enabled){
      sand.color = isNearBlackHex(chosenColor) ? DEFAULT_SAND_CONFIG.color : chosenColor;
      STATE.surfaces[key].sand = sand;
      sandTextureCache.clear();
      if($('sandColor')) $('sandColor').value = sand.color;
    }
    buildRoom();
    syncSurfaceEditor();
    syncFloorPhysicsEditor();
    scheduleSave();
    return;
  }
  if(selectedFloorTileId){
    const t = (STATE.floorTiles||[]).find(item=>item.id===selectedFloorTileId); if(!t) return;
    t.position.y = safeFinite(t.position?.y, -safeFinite(t.size?.t,.18)/2);
    t.size.w = readObjectNumber('objectSizeX', t.size?.w || 4, .02, 500);
    t.size.t = readObjectNumber('objectSizeY', t.size?.t || .18, .02, 500);
    t.size.d = readObjectNumber('objectSizeZ', t.size?.d || 4, .02, 500);
    const chosenColor = validColor($('objectColor')?.value) ? $('objectColor').value : (t.material?.color || STATE.surfaces.floor?.color || '#8d897f');
    t.material = {...(t.material || STATE.surfaces.floor), color:chosenColor};
    const sand = ensureSandConfigOnMaterial(t.material);
    if(sand.enabled){
      sand.color = isNearBlackHex(chosenColor) ? DEFAULT_SAND_CONFIG.color : chosenColor;
      t.material.sand = sand;
      sandTextureCache.clear();
      if($('sandColor')) $('sandColor').value = sand.color;
    }
    rebuildFloorTiles();
    syncSurfaceEditor();
    syncFloorPhysicsEditor();
    scheduleSave();
    return;
  }
  if(selectedWaterBodyId){
    const body = getSelectedWaterBody(); if(!body) return;
    body.size = body.size || {w:4,d:2,h:.72,t:.12};
    body.size.w = readObjectNumber('objectSizeX', body.size?.w || 4, .2, 500);
    body.size.h = readObjectNumber('objectSizeY', body.size?.h || .72, .05, 500);
    body.size.d = readObjectNumber('objectSizeZ', body.size?.d || 2, .2, 500);
    body.water = body.water || {};
    body.water.color = validColor($('objectColor')?.value) ? $('objectColor').value : (body.water.color || '#4bbcff');
    buildWaterBodies();
    syncWaterEditor();
    scheduleSave();
    return;
  }
}

function syncArtSelect(){
  const sel = $('artSelect');
  if(!sel) return;
  sel.innerHTML = '';
  for(const art of STATE.artworks) sel.add(new Option(art.title,art.id));
  if(!STATE.artworks.some(a=>a.id===selectedArtworkId)) selectedArtworkId = STATE.artworks[0]?.id || null;
  sel.value = selectedArtworkId || '';
}

function getSelectedArt(){ return STATE.artworks.find(a=>a.id===selectedArtworkId) || STATE.artworks[0] || null; }

function syncArtEditor(){
  const art = getSelectedArt();
  if(!art){
    artEditorDirty = false;
    if($('artSelect')) $('artSelect').value = '';
    for(const id of ART_NUMERIC_FIELDS){ if($(id)) $(id).value = ''; }
    if($('artSnapToWall')) $('artSnapToWall').checked = false;
    if($('artDoubleSided')) $('artDoubleSided').checked = false;
    if($('artBackColor')) $('artBackColor').value = ARTWORK_BACK_DEFAULT_COLOR;
    if($('artBackLight')) $('artBackLight').value = ARTWORK_BACK_DEFAULT_LIGHT;
    if($('artEdgeTintColor')) $('artEdgeTintColor').value = '#ffffff';
    if($('artEdgeTintStrength')) $('artEdgeTintStrength').value = 0;
    document.querySelectorAll('[data-image-only-art-control]').forEach(el=>el.hidden = true);
    if($('applyArtValues')) $('applyArtValues').disabled = true;
    if($('frameArtwork')) $('frameArtwork').disabled = true;
    if($('deleteArtwork')) $('deleteArtwork').disabled = true;
    return;
  }
  if($('frameArtwork')) $('frameArtwork').disabled = false;
  if($('deleteArtwork')) $('deleteArtwork').disabled = false;
  const active = document.activeElement;
  if(artEditorDirty && active && ART_NUMERIC_FIELDS.includes(active.id)) return;
  artEditorDirty = false;
  $('artSelect').value = art.id;
  if($('artWall')) $('artWall').value = art.wall || 'front';
  ensureFreeArtworkPosition(art);
  if($('artX')) $('artX').value = Number(safeFinite(art.position?.x,0)).toFixed(2);
  $('artY').value = Number(safeFinite(art.position?.y, art.type === 'model' ? 0 : 2.2)).toFixed(2);
  if($('artZ')) $('artZ').value = Number(safeFinite(art.position?.z,0)).toFixed(2);
  $('artW').value = safeFinite(art.size?.w, art.type === 'model' ? 1.5 : 3);
  $('artH').value = safeFinite(art.size?.h, art.type === 'model' ? 1.5 : 3);
  if($('artD')) $('artD').value = safeFinite(art.size?.d, art.type === 'model' ? 1.5 : 1);
  $('artDepth').value = art.depth ?? .10;
  $('artGap').value = art.gap ?? .014;
  if($('artSnapToWall')) $('artSnapToWall').checked = !!art.snapToWall;
  if($('artDoubleSided')) $('artDoubleSided').checked = !!art.doubleSided;
  if($('artBackColor')) $('artBackColor').value = getArtworkBackColor(art);
  if($('artBackLight')) $('artBackLight').value = getArtworkBackLight(art);
  $('artEdgeTintColor').value = art.edgeTintColor || '#ffffff';
  $('artEdgeTintStrength').value = clamp(safeFinite(art.edgeTintStrength,0),0,1);
  const imageOnly = document.querySelectorAll('[data-image-only-art-control]');
  for(const el of imageOnly) el.hidden = art.type === 'model';
  if($('applyArtValues')) $('applyArtValues').disabled = false;
}

function markArtEditorDirty(){
  artEditorDirty = true;
  if($('applyArtValues')) $('applyArtValues').disabled = false;
}

function applyArtBackOptionsFromEditor(){
  const art = getSelectedArt();
  if(!art || art.type === 'model') return;
  art.backColor = validColor($('artBackColor')?.value) ? $('artBackColor').value : ARTWORK_BACK_DEFAULT_COLOR;
  art.backColorManual = true;
  art.backLight = clamp(safeFinite($('artBackLight')?.value, ARTWORK_BACK_DEFAULT_LIGHT),0,1);
  art.backLightManual = true;
  art.backRelief = sanitizeArtworkBackRelief(art.backRelief);
  refreshImageArtworkSurface(art);
  scheduleSave();
}

function applyArtVisualOptionsFromEditor(){
  const art = getSelectedArt(); if(!art) return;
  art.snapToWall = !!$('artSnapToWall')?.checked;
  if(art.type !== 'model'){
    art.doubleSided = !!$('artDoubleSided')?.checked;
    art.edgeTintColor = $('artEdgeTintColor').value || '#ffffff';
    art.edgeTintStrength = clamp(Number($('artEdgeTintStrength').value),0,1);
    applyArtworkEdgeTint(artworkMeshes[art.id], art);
  }
  scheduleSave();
}

function applyArtEditorValues(){
  const art = getSelectedArt(); if(!art) return;
  updateArtFromEditor();
  syncArtEditor();
  setStatus('已套用作品數值。');
}

function updateArtFromEditor(){
  const art = getSelectedArt(); if(!art) return;
  ensureFreeArtworkPosition(art);
  if($('artX')) art.position.x = clamp(safeFinite($('artX').value, art.position.x), -500, 500);
  art.position.y = clamp(safeFinite($('artY').value, art.position.y), -500, 500);
  if($('artZ')) art.position.z = clamp(safeFinite($('artZ').value, art.position.z), -500, 500);
  art.size.w = clamp(safeFinite($('artW').value, art.size?.w || 3), .01, 500);
  art.size.h = clamp(safeFinite($('artH').value, art.size?.h || 3), .01, 500);
  if($('artD')) art.size.d = clamp(safeFinite($('artD').value, art.size?.d || 1), .01, 500);
  const oldDepth = art.depth ?? .10;
  const oldDoubleSided = !!art.doubleSided;
  const oldBackColor = getArtworkBackColor(art);
  const oldBackLight = getArtworkBackLight(art);
  art.depth = clamp(safeFinite($('artDepth').value, art.depth ?? .10), .01, 500);
  art.gap = clamp(safeFinite($('artGap').value, art.gap ?? .014), .001, 500);
  art.snapToWall = !!$('artSnapToWall')?.checked;
  if(art.type !== 'model'){
    art.doubleSided = !!$('artDoubleSided')?.checked;
    art.backColor = validColor($('artBackColor')?.value) ? $('artBackColor').value : ARTWORK_BACK_DEFAULT_COLOR;
    art.backColorManual = true;
    art.backLight = clamp(safeFinite($('artBackLight')?.value, ARTWORK_BACK_DEFAULT_LIGHT),0,1);
    art.backLightManual = true;
    art.backRelief = sanitizeArtworkBackRelief(art.backRelief);
    art.edgeTintColor = $('artEdgeTintColor').value || '#ffffff';
    art.edgeTintStrength = clamp(Number($('artEdgeTintStrength').value),0,1);
  }
  if(art.snapToWall) snapArtworkToNearestWall(art);
  placeArtwork(art);
  const group = artworkMeshes[art.id];
  const backVisualChanged = art.type !== 'model' && (oldDoubleSided !== !!art.doubleSided || oldBackColor !== getArtworkBackColor(art) || Math.abs(oldBackLight - getArtworkBackLight(art)) > .0001);
  if(backVisualChanged){
    refreshImageArtworkSurface(art);
  }else if(art.type !== 'model' && Math.abs(oldDepth - art.depth) > .0001){
    const tex = group?.children?.find(c=>c.userData?.isArtworkFront && c.material?.map)?.material?.map || group?.children?.find(c=>c.material?.userData?.sourceTexture)?.material?.userData?.sourceTexture;
    if(group && tex?.image) rebuildArtworkDepth(group, art, tex.image);
  }else if(art.type !== 'model'){
    applyArtworkEdgeTint(group, art);
  }
  artEditorDirty = false;
  scheduleSave();
}

function frameSelectedArtwork(){
  const art = getSelectedArt(); if(!art) return;
  ensureFreeArtworkPosition(art);
  const r = art.rotation || {x:0,y:0,z:0};
  const normal = new THREE.Vector3(0,0,1).applyEuler(new THREE.Euler(deg(safeFinite(r.x,0)), deg(safeFinite(r.y,0)), deg(safeFinite(r.z,0)))).normalize();
  const pos = new THREE.Vector3(safeFinite(art.position.x,0), 0, safeFinite(art.position.z,0)).addScaledVector(normal, 4.0);
  player.position.set(pos.x, 0, pos.z);
  const dir = new THREE.Vector3(safeFinite(art.position.x,0)-player.position.x, 0, safeFinite(art.position.z,0)-player.position.z).normalize();
  camYaw = yawFromDirection(dir);
  playerYaw = camYaw;
  setStatus('角色已移到作品前方。');
}


function syncActorEditor(){
  const cfg = STATE.player || (STATE.player = {modelYOffset:4.68, modelYawOffset:180, speed:6.3, jumpPower:1, scale:1});
  if($('actorScale')) $('actorScale').value = clamp(safeFinite(cfg.scale,1), .1, 5);
  if($('actorYOffset')) $('actorYOffset').value = clamp(safeFinite(cfg.modelYOffset,4.68), -1.2, 20.0);
  if($('actorYawOffset')) $('actorYawOffset').value = clamp(safeFinite(cfg.modelYawOffset,180), -180, 180);
  if($('playerSpeed')) $('playerSpeed').value = clamp(safeFinite(cfg.speed,6.3), 1, 12);
  if($('playerJumpPower')) $('playerJumpPower').value = clamp(safeFinite(cfg.jumpPower,1), .1, 5);
}

function updateActorFromEditor(){
  const cfg = STATE.player || (STATE.player = {modelYOffset:4.68, modelYawOffset:180, speed:6.3, jumpPower:1, scale:1});
  cfg.scale = Number($('actorScale')?.value ?? 1);
  cfg.modelYOffset = Number($('actorYOffset').value);
  cfg.modelYawOffset = Number($('actorYawOffset').value);
  cfg.speed = Number($('playerSpeed').value);
  cfg.jumpPower = Number($('playerJumpPower').value);
  applyActorSettings();
  scheduleSave();
}

function rebuildSinTowerTumorPaletteUI(){
  const store = $('sinTumorPaletteStore');
  const box = $('sinTumorPaletteSwatches');
  if(!store || !box) return;
  const colors = parseSinTowerTumorColorPalette(store.value || getSinTowerTumorParams().tumorColorPalette);
  store.value = colors.join(',');
  box.innerHTML = '';
  colors.forEach((hex, idx)=>{
    const item = document.createElement('button');
    item.type = 'button';
    item.title = `移除 ${hex}`;
    item.style.cssText = `width:28px;height:28px;border-radius:999px;border:2px solid #fff3;box-shadow:0 0 0 1px #0006 inset;background:${hex};cursor:pointer;`;
    item.onclick = ()=>{
      const arr = parseSinTowerTumorColorPalette(store.value).filter((_,i)=>i!==idx);
      store.value = arr.join(',');
      rebuildSinTowerTumorPaletteUI();
      updateSinTowerTumorEditor();
    };
    box.appendChild(item);
  });
}

function addSinTowerTumorPaletteColor(hex){
  const store = $('sinTumorPaletteStore');
  if(!store) return;
  const arr = parseSinTowerTumorColorPalette(store.value || '');
  const low = String(hex || '').toLowerCase();
  if(/^#[0-9a-f]{6}$/.test(low) && !arr.includes(low)) arr.push(low);
  store.value = arr.join(',');
  rebuildSinTowerTumorPaletteUI();
  updateSinTowerTumorEditor();
}

function syncSinTowerFireEditor(){
  const p = getSinTowerFireParams();
  if($('sinFireParticleSize')) $('sinFireParticleSize').value = p.particleSize;
  if($('sinFireParticleCount')) $('sinFireParticleCount').value = p.particleCount;
  if($('sinFireShape')) $('sinFireShape').value = p.shape;
  if($('sinFireColorA')) $('sinFireColorA').value = p.colorA;
  if($('sinFireColorB')) $('sinFireColorB').value = p.colorB;
  if($('sinFireColorC')) $('sinFireColorC').value = p.colorC;
  if($('sinFireRadius')) $('sinFireRadius').value = p.radius;
  if($('sinFireHeight')) $('sinFireHeight').value = p.height;
  if($('sinFireSwirl')) $('sinFireSwirl').value = p.swirl;
  if($('sinFireDuration')) $('sinFireDuration').value = p.duration;
}

function updateSinTowerFireEditor(){
  const p = SIN_TOWER_FIRE_FX.params;
  p.particleSize = Number($('sinFireParticleSize')?.value ?? p.particleSize ?? .075);
  p.particleCount = Number($('sinFireParticleCount')?.value ?? p.particleCount ?? 360);
  p.shape = $('sinFireShape')?.value || p.shape || 'column';
  p.colorA = $('sinFireColorA')?.value || p.colorA || '#fff27a';
  p.colorB = $('sinFireColorB')?.value || p.colorB || '#ff5a00';
  p.colorC = $('sinFireColorC')?.value || p.colorC || '#7b001e';
  p.radius = Number($('sinFireRadius')?.value ?? p.radius ?? .72);
  p.height = Number($('sinFireHeight')?.value ?? p.height ?? 2.3);
  p.swirl = Number($('sinFireSwirl')?.value ?? p.swirl ?? 1.05);
  p.duration = Number($('sinFireDuration')?.value ?? p.duration ?? 1.5);
  scheduleSinTowerRuntimeSave();
}


let sinTowerTumorParamRebuildTimer = null;
function scheduleSinTowerTumorParamRebuild(){
  if(!(SIN_TOWER_INFECTION.level > 0)) return;
  clearTimeout(sinTowerTumorParamRebuildTimer);
  sinTowerTumorParamRebuildTimer = setTimeout(()=>{
    const level = Math.max(0, Math.floor(SIN_TOWER_INFECTION.level || 0));
    if(level > 0 && !isSinTowerMeatballMode()) rebuildSinTowerInfectionCoverFromScratch(level);
  }, 260);
}
function syncSinTowerTumorEditor(){
  const p = getSinTowerTumorParams();
  if($('sinTumorSizeRange')) $('sinTumorSizeRange').value = p.tumorSizeRange;
  if($('sinTumorColorVar')) $('sinTumorColorVar').value = p.colorVariation;
  if($('sinTumorPaletteStore')) $('sinTumorPaletteStore').value = p.tumorColorPalette;
  if($('sinTumorPalettePicker')) $('sinTumorPalettePicker').value = parseSinTowerTumorColorPalette(p.tumorColorPalette)[0] || '#d24b8c';
  rebuildSinTowerTumorPaletteUI();
  if($('sinTumorEyeScale')) $('sinTumorEyeScale').value = p.eyeScale;
  if($('sinEyeRimColor')) $('sinEyeRimColor').value = p.eyeRimColor;
  if($('sinEyePupilColor')) $('sinEyePupilColor').value = p.eyePupilColor;
  if($('sinEyeBlinkFreq')) $('sinEyeBlinkFreq').value = p.eyeBlinkFreq;
  if($('sinTentacleLengthMul')) $('sinTentacleLengthMul').value = p.tentacleLengthMul;
  if($('sinTentacleThickMin')) $('sinTentacleThickMin').value = p.tentacleThickMin;
  if($('sinTentacleThickMax')) $('sinTentacleThickMax').value = p.tentacleThickMax;
  if($('sinTumorBatchMul')) $('sinTumorBatchMul').value = p.batchMul;
  if($('sinTumorGrowSpeed')) $('sinTumorGrowSpeed').value = p.growthSpeed;
  if($('sinSecondarySkeletonLevel')) $('sinSecondarySkeletonLevel').value = p.secondarySkeletonLevel;
  if($('sinThirdSkeletonLevel')) $('sinThirdSkeletonLevel').value = p.thirdSkeletonLevel;
  if($('sinMeatballLevel')) $('sinMeatballLevel').value = p.meatballLevel;
  if($('sinFungusColorVar')) $('sinFungusColorVar').value = p.fungusColorVar;
  if($('sinFungusShapeVar')) $('sinFungusShapeVar').value = p.fungusShapeVar;
  if($('sinFungusClusterMul')) $('sinFungusClusterMul').value = p.fungusClusterMul;
}

function updateSinTowerTumorEditor(){
  const p = SIN_TOWER_INFECTION.params || (SIN_TOWER_INFECTION.params = {});
  p.tumorSizeRange = String($('sinTumorSizeRange')?.value ?? p.tumorSizeRange ?? '3-18').trim();
  p.colorVariation = Number($('sinTumorColorVar')?.value ?? p.colorVariation ?? 1);
  p.tumorColorPalette = String($('sinTumorPaletteStore')?.value ?? p.tumorColorPalette ?? '#d24b8c,#be244f,#e05066,#8f1232,#f06f73,#a9185d,#6d0a20');
  p.eyeScale = Number($('sinTumorEyeScale')?.value ?? p.eyeScale ?? 1.35);
  p.eyeRimColor = $('sinEyeRimColor')?.value || p.eyeRimColor || '#e58aa0';
  p.eyePupilColor = $('sinEyePupilColor')?.value || p.eyePupilColor || '#000000';
  p.eyeBlinkFreq = Number($('sinEyeBlinkFreq')?.value ?? p.eyeBlinkFreq ?? 1.0);
  p.tentacleLengthMul = clamp(Number($('sinTentacleLengthMul')?.value ?? p.tentacleLengthMul ?? 1.3), .25, 2.6);
  p.tentacleThickMin = clamp(Number($('sinTentacleThickMin')?.value ?? p.tentacleThickMin ?? .75), .25, 2.2);
  p.tentacleThickMax = clamp(Number($('sinTentacleThickMax')?.value ?? p.tentacleThickMax ?? 1.65), .25, 2.2);
  if(p.tentacleThickMax < p.tentacleThickMin) p.tentacleThickMax = p.tentacleThickMin;
  p.batchMul = Number($('sinTumorBatchMul')?.value ?? p.batchMul ?? 2.4);
  p.growthSpeed = Number($('sinTumorGrowSpeed')?.value ?? p.growthSpeed ?? 4.0);
  p.secondarySkeletonLevel = Math.round(Number($('sinSecondarySkeletonLevel')?.value ?? p.secondarySkeletonLevel ?? 5));
  p.thirdSkeletonLevel = Math.round(Number($('sinThirdSkeletonLevel')?.value ?? p.thirdSkeletonLevel ?? 10));
  if(p.thirdSkeletonLevel <= p.secondarySkeletonLevel) p.thirdSkeletonLevel = p.secondarySkeletonLevel + 1;
  p.meatballLevel = Math.round(Number($('sinMeatballLevel')?.value ?? p.meatballLevel ?? 20));
  SIN_TOWER_INFECTION.meatballLevel = clamp(p.meatballLevel, 20, 60);
  p.fungusColorVar = Number($('sinFungusColorVar')?.value ?? p.fungusColorVar ?? 1);
  p.fungusShapeVar = Number($('sinFungusShapeVar')?.value ?? p.fungusShapeVar ?? 1);
  p.fungusClusterMul = Number($('sinFungusClusterMul')?.value ?? p.fungusClusterMul ?? 1);
  const sr = parseSinTowerTumorSizeRange(p.tumorSizeRange);
  p.tumorSizeRange = sr.text;
  p.tumorColorPalette = parseSinTowerTumorColorPalette(p.tumorColorPalette).join(',');
  ensureSinTowerRuntimeColorPalettes();
  applySinTowerEyeStyleMaterials();
  scheduleSinTowerTumorParamRebuild();
  scheduleSinTowerRuntimeSave();
  setStatus(`腫瘤參數已更新：尺寸範圍 ${sr.text}，色盤 ${parseSinTowerTumorColorPalette(p.tumorColorPalette).length} 色，眨眼頻率 ${p.eyeBlinkFreq.toFixed(2)}，每次增生倍率 ${p.batchMul.toFixed(1)}，生長速度 ${p.growthSpeed.toFixed(2)}x，第二層骨架 ${p.secondarySkeletonLevel} 次啟動，第三層骨架 ${p.thirdSkeletonLevel} 次啟動，肉球滾動 ${SIN_TOWER_INFECTION.meatballLevel} 次。`);
}

function syncWallSelect(){
  const sel = $('wallSelect'); if(!sel) return;
  sel.innerHTML = '';
  sel.add(new Option('無', ''));
  for(const w of STATE.customWalls) sel.add(new Option(`${w.title} ${w.id.slice(-4)}`, w.id));
  if(selectedWallId && !STATE.customWalls.some(w=>w.id===selectedWallId)) selectedWallId = null;
  sel.value = selectedWallId || '';
}

function getSelectedWall(){ return STATE.customWalls.find(w=>w.id===selectedWallId) || null; }

function syncWallEditor(){
  if(!$('deleteSelectedWall')) return;
  syncWallSelect();
  const w = getSelectedWall();
  const disabled = !w;
  for(const id of ['wallW','wallH','wallRY','wallColor','wallShape','wallCurveAmount','wallCurveDirection']) if($(id)) $(id).disabled = disabled;
  $('deleteSelectedWall').disabled = !(w || (selectedRoomWallKey && DELETABLE_SURFACE_KEYS.includes(selectedRoomWallKey)));
  if(!w) return;
  const curve = normalizedWallCurve(w);
  $('wallW').value = w.size.w;
  $('wallH').value = w.size.h;
  $('wallRY').value = wallRotation(w).y;
  $('wallColor').value = w.material.color;
  if($('wallShape')) $('wallShape').value = isCurvedWall(w) ? 'curved' : 'straight';
  if($('wallCurveAmount')) $('wallCurveAmount').value = curve.amount;
  if($('wallCurveDirection')) $('wallCurveDirection').value = curve.direction;
}

function updateWallFromEditor(){
  if(updateMultiWallsFromEditor()) return;
  const w = getSelectedWall(); if(!w) return;
  w.size.w = clamp(Number($('wallW').value), .5, 500);
  w.size.h = clamp(Number($('wallH').value), .5, 500);
  const r = wallRotation(w);
  r.y = clamp(Number($('wallRY').value), -180, 180);
  w.rotation = r;
  w.rotationY = r.y;
  w.manualRotation = true;
  w.material.color = $('wallColor').value;
  const shape = $('wallShape')?.value === 'curved' ? 'curved' : 'straight';
  w.shape = shape;
  w.curve = w.curve || {};
  w.curve.enabled = shape === 'curved';
  w.curve.amount = shape === 'curved' ? clamp(Number($('wallCurveAmount')?.value ?? w.curve.amount ?? .35),0,1) : 0;
  w.curve.direction = $('wallCurveDirection')?.value === 'back' ? 'back' : 'front';
  rebuildCustomWalls();
  syncObjectEditor();
  renderObjectPanel();
  if(!w.isDraft) scheduleSave();
}

function updatePlayerWithStableElapsedTime(totalDt){
  const elapsed = clamp(safeFinite(totalDt, 1/60), 0, .12);
  const steps = Math.max(1, Math.ceil(elapsed / (1/45)));
  const stepDt = elapsed / steps;
  for(let i=0;i<steps;i++) updatePlayer(stepDt);
}

function updateGameFrame(dt, playerDt=dt){
  if(sinTowerPortalGate.active&&sinTowerPortalGate.phase==='input'&&sinPortalPasswordVisible()){updateSinTowerPortalPasswordCountdown();updateSinTowerAudioRuntime();return;}
  if(sinAfterVideoSession)clearMovementKeys();
  const actorAnimationDt=clamp(safeFinite(playerDt,dt),0,.12);
  sinTowerLastFrameDt=dt;sinTowerLastElapsedDt=playerDt;sinTowerLastActorAnimationDt=actorAnimationDt;
  updatePlayerWithStableElapsedTime(playerDt);
  updateSinTowerMonks(dt);
  updateSinTowerInfection(dt);
  updateSinTowerFireFx(dt);
  updateSinTowerEditorRuntime(dt);
  updateSinTowerRpsBlinks();
  updateSinTowerAudioRuntime();
  updateSinTowerPropInteractions();
  updateSinTowerInteractionVhsEffect();
  updatePendingWallPlacement();
  updatePendingArtworkPlacement();
  updatePendingFloorTilePlacement();
  updatePendingWaterBodyPlacement();
  updateFallbackCameraLook(dt);
  updateCamera();
  if(skyMesh?.visible) skyMesh.position.copy(camera.position);
  if(isSinTowerStairSceneActive()){
    updateAtmosphereEffect(dt);
    updateWaterEffects(dt);
  }
  updateScreenFxEffect(dt);
  updateChiselPreview();
  if(mixer && !isSinTowerMeatballMode()) mixer.update(actorAnimationDt);
  applySwimArmMotion(actorAnimationDt);
}

function animate(){
  requestAnimationFrame(animate);
  if(webglContextLost) return;
  const elapsed = Math.min(clock.getDelta(),.12);
  const dt = Math.min(elapsed,.033);
  updateGameFrame(dt, elapsed);
  renderSceneWithScreenFx();
  finishSinTowerSceneShadowRefreshFrame();
}

function sinTowerRuntimeScreenPoint(runtime){
  if(!runtime?.object||!camera)return null;
  const center=new THREE.Box3().setFromObject(runtime.object).getCenter(new THREE.Vector3()).project(camera);
  const rect=renderer?.domElement?.getBoundingClientRect?.()||{left:0,top:0,width:innerWidth,height:innerHeight};
  return{x:+(rect.left+(center.x+1)*rect.width*.5).toFixed(1),y:+(rect.top+(1-center.y)*rect.height*.5).toFixed(1),depth:+center.z.toFixed(3),visible:center.z>=-1&&center.z<=1&&Math.abs(center.x)<=1&&Math.abs(center.y)<=1};
}

function sinTowerRuntimePropScreenPoint(runtime,prop){
  const visual=runtime?.visuals?.[0];if(!visual?.group||!camera)return null;
  const point=visual.group.localToWorld(new THREE.Vector3(0,safeFinite(prop?.height,2)*.5,0)).project(camera),rect=renderer?.domElement?.getBoundingClientRect?.()||{left:0,top:0,width:innerWidth,height:innerHeight};
  return{x:+(rect.left+(point.x+1)*rect.width*.5).toFixed(1),y:+(rect.top+(1-point.y)*rect.height*.5).toFixed(1),depth:+point.z.toFixed(3),visible:point.z>=-1&&point.z<=1&&Math.abs(point.x)<=1&&Math.abs(point.y)<=1};
}

