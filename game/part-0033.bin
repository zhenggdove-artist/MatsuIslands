function getSinTowerInfectionVisualStats(){
  const inf = SIN_TOWER_INFECTION;
  const stats = {nodes:0,meshes:0,points:0,instanced:0,visibleMeshes:0,tentacles:0,tentacleDirections:{up:0,down:0,lateral:0},coreEntries:inf.tumorBatchEntries?.length || 0,batches:inf.tumorBatches?.size || 0,trackedRoots:inf.ownedRoots?.length || 0,dynamicAttachments:inf.dynamicAttachments?.length || 0,detailQueue:inf.detailQueue?.length || 0,rebuildPhase:inf.rebuildState?.phase || null,lastUpdateMs:+safeFinite(inf.lastUpdateMs,0).toFixed(3),motionMaxRadians:+safeFinite(inf.lastMotionMaxRadians,0).toFixed(4),motionMaxOffset:+safeFinite(inf.lastMotionMaxOffset,0).toFixed(4),rollBridge:!!inf.rollVisualRoot?.userData?.rollBridgeCore,rollGroundRadius:+safeFinite(inf.rollVisualRoot?.userData?.rollGroundRadius,0).toFixed(3),rollRotationRadius:+safeFinite(inf.rollVisualRoot?.userData?.rollRotationRadius,0).toFixed(3),rollScale:+safeFinite(inf.rollFixedScale,0).toFixed(3)};
  const seen = new Set();
  const visit = root=>root?.traverse?.(obj=>{
    if(!obj || seen.has(obj)) return;
    seen.add(obj);
    const ud = obj.userData || {};
    const growth = ud.isSinTowerTumor || ud.sinTowerTumorCore || ud.isSinTowerControlledGrowth || ud.motionProfile === 'tentacle' || ud.motionProfile === 'fungus';
    if(!growth) return;
    if(ud.sinTowerTentacleDirection){
      stats.tentacles++;
      const y = safeFinite(ud.sinTowerTentacleDirection.y,0);
      if(y > .25) stats.tentacleDirections.up++;
      else if(y < -.25) stats.tentacleDirections.down++;
      else stats.tentacleDirections.lateral++;
    }
    stats.nodes++;
    if(obj.isInstancedMesh){ stats.instanced += obj.count || 0; stats.meshes++; }
    else if(obj.isMesh){ stats.meshes++; }
    else if(obj.isPoints){ stats.points++; }
    if(obj.visible !== false && (obj.isMesh || obj.isPoints || obj.isInstancedMesh)) stats.visibleMeshes++;
  });
  visit(playerGroup);
  for(const batch of inf.tumorBatches?.values?.() || []) visit(batch);
  return stats;
}

window.render_game_to_text = renderGameToText;
window.advanceTime = ms=>{
  const steps = Math.max(1, Math.round(safeFinite(ms, 16) / (1000 / 60)));
  for(let i=0;i<steps;i++) updateGameFrame(1 / 60);
  renderSceneWithScreenFx();
  finishSinTowerSceneShadowRefreshFrame();
  return renderGameToText();
};

function getSinTowerGameViewport(){
  if(STATE?.displayOrientation!=='portrait')return{left:0,top:0,width:Math.max(1,innerWidth),height:Math.max(1,innerHeight),orientation:'landscape'};
  const width=Math.max(1,Math.min(innerWidth,innerHeight*9/16)),height=Math.max(1,Math.min(innerHeight,innerWidth*16/9));
  return{left:(innerWidth-width)/2,top:(innerHeight-height)/2,width,height,orientation:'portrait'};
}

function applySinTowerDisplayOrientation(viewport=getSinTowerGameViewport()){
  const portrait=viewport.orientation==='portrait';document.body.classList.toggle('sin-portrait-game',portrait);
  document.body.style.setProperty('--sin-game-left',viewport.left.toFixed(2)+'px');document.body.style.setProperty('--sin-game-top',viewport.top.toFixed(2)+'px');document.body.style.setProperty('--sin-game-width',viewport.width.toFixed(2)+'px');document.body.style.setProperty('--sin-game-height',viewport.height.toFixed(2)+'px');
  for(const id of ['screenGameOrientation','sinPerfGameOrientation'])if($(id)&&document.activeElement!==$(id))$(id).value=portrait?'portrait':'landscape';
  requestAnimationFrame(applySinTowerPortalPasswordLayout);
  requestAnimationFrame(applySinTowerMobileControlsLayout);
}

function setSinTowerDisplayOrientation(value){
  STATE.displayOrientation=value==='portrait'?'portrait':'landscape';const viewport=getSinTowerGameViewport();applySinTowerDisplayOrientation(viewport);onResize();scheduleSave();scheduleSinTowerRuntimeSave();setStatus(STATE.displayOrientation==='portrait'?'已切換為手機直式 9:16；場景座標保持不變。':'已切換為橫式／視窗自動填滿。');
}

function onResize(){
  const viewport=getSinTowerGameViewport();applySinTowerDisplayOrientation(viewport);
  camera.aspect = viewport.width/viewport.height;
  camera.updateProjectionMatrix();
  renderer.setPixelRatio(computeSafePixelRatio(MAX_RENDER_PIXELS));
  renderer.setSize(viewport.width,viewport.height,false);
  resizeScreenFxTarget();
}

async function readSmallFileAsDataURL(file){
  if(!file) throw new Error('沒有可讀取的檔案。');
  const buffer = await Promise.race([
    file.arrayBuffer(),
    new Promise((_,reject)=>setTimeout(()=>reject(new Error('檔案讀取逾時。')),10000))
  ]);
  const bytes = new Uint8Array(buffer);
  let binary = '';
  const chunk = 0x8000;
  for(let i=0;i<bytes.length;i+=chunk) binary += String.fromCharCode(...bytes.subarray(i,Math.min(bytes.length,i+chunk)));
  const ext = String(file.name || '').split('.').pop().toLowerCase();
  const inferred = ext === 'png' ? 'image/png' : ext === 'gif' ? 'image/gif' : /jpe?g/.test(ext) ? 'image/jpeg' : ext === 'webp' ? 'image/webp' : 'application/octet-stream';
  return 'data:' + (file.type || inferred) + ';base64,' + btoa(binary);
}

async function optimizeImageFileForDataUrl(file, options={}){
  const raw = file?.size <= 16*1024*1024 ? await readSmallFileAsDataURL(file) : await readFileAsDataURL(file);
  if(!file || !/^image\//i.test(file.type || '')) return raw;
  try{
    const maxSize = clamp(safeFinite(options.maxSize, SIN_TOWER_EDITOR?.perf?.textureMaxSize || 1536), 64, 4096);
    const quality = clamp(safeFinite(options.quality, SIN_TOWER_EDITOR?.perf?.textureQuality || .78), .3, .95);
    const preserveAlpha = options.preserveAlpha ?? /png|webp/i.test(file.type || '');
    const bitmap = await Promise.race([
      createImageBitmap(file),
      new Promise((_,reject)=>setTimeout(()=>reject(new Error('圖片解碼逾時，改用原始 PNG。')),5000))
    ]);
    const scale = Math.min(1, maxSize / Math.max(bitmap.width || 1, bitmap.height || 1));
    const w = Math.max(1, Math.round((bitmap.width || 1) * scale));
    const h = Math.max(1, Math.round((bitmap.height || 1) * scale));
    if(scale >= .999 && raw.length < 220000 && preserveAlpha) return raw;
    const canvas = document.createElement('canvas');
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d', {alpha:preserveAlpha});
    ctx.imageSmoothingEnabled = true;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(bitmap, 0, 0, w, h);
    bitmap.close?.();
    const mime = options.mimeType || (preserveAlpha ? 'image/png' : 'image/webp');
    const dataUrl = canvas.toDataURL(mime, preserveAlpha ? undefined : quality);
    return typeof dataUrl === 'string' && dataUrl.startsWith('data:image/') ? dataUrl : raw;
  }catch(err){
    console.warn('image optimization skipped', err);
    return raw;
  }
}

function readFileAsDataURL(file){
  return new Promise((resolve,reject)=>{
    const r = new FileReader();
    let settled = false;
    const finish = (ok,value)=>{ if(settled) return; settled = true; clearTimeout(timer); ok ? resolve(value) : reject(value); };
    const timer = setTimeout(async()=>{
      try{ finish(true,await readSmallFileAsDataURL(file)); }
      catch(error){ finish(false,error); }
    },15000);
    r.onload = ()=>finish(true,r.result);
    r.onerror = ()=>finish(false,r.error || new Error('檔案讀取失敗。'));
    r.readAsDataURL(file);
  });
}

function readAsDataURL(file, options={}){
  return optimizeImageFileForDataUrl(file, options);
}

function readImageDimensions(src){
  return new Promise(resolve=>{
    const img = new Image();
    let settled = false;
    const finish = value=>{ if(settled) return; settled = true; clearTimeout(timer); img.onload = img.onerror = null; resolve(value); };
    const timer = setTimeout(()=>finish(null),4000);
    img.onload = ()=>finish({width:img.naturalWidth || img.width || 1, height:img.naturalHeight || img.height || 1});
    img.onerror = ()=>finish(null);
    img.src = src;
  });
}

function getSelectedLightState(){
  const list = STATE?.lightSystem?.lights || [];
  if(!list.length) return null;
  if(!selectedLightId || !list.some(item=>item.id===selectedLightId)) selectedLightId = list[0].id;
  return list.find(item=>item.id===selectedLightId) || null;
}


function meshHasRenderableMaterial(mesh){
  return !!mesh?.isMesh && !!mesh.material;
}

function isStaticLightingBakeTarget(mesh){
  if(!meshHasRenderableMaterial(mesh)) return false;
  if(mesh.userData?.isLightMarker || mesh.userData?.isLightControl || mesh.userData?.skipChiselTarget) return false;
  if(mesh === skyMesh || mesh === atmosphereVolumeMesh || mesh === atmospherePoints || mesh === chiselPreviewMesh) return false;
  const roots = [roomGroup, customWallGroup, floorTileGroup, referenceArchitectureGroup, artworkGroup];
  return roots.some(root=>root && (mesh === root || root.children.includes(mesh) || isDescendantOf(mesh, root)));
}

function isDescendantOf(obj, root){
  let cur = obj;
  while(cur){
    if(cur === root) return true;
    cur = cur.parent;
  }
  return false;
}

function getBakedLightTargetKey(mesh){
  if(!mesh?.isMesh) return null;
  const ud = mesh.userData || {};
  if(ud.surfaceKey) return `surface:${ud.surfaceKey}`;
  if(ud.floorTileId) return `floorTile:${ud.floorTileId}`;
  if(ud.wallId) return `wall:${ud.wallId}:${mesh.name || 'mesh'}`;
  const artId = ud.artId || findUserDataValueInHierarchy(mesh, 'artId', artworkGroup);
  if(artId){
    if(ud.isArtworkFront) return `art:${artId}:front`;
    if(ud.isArtworkBack) return `art:${artId}:back`;
    return `art:${artId}:${mesh.name || mesh.uuid}`;
  }
  if(ud.referenceArchitecture || ud.isReferenceRelief || findUserDataValueInHierarchy(mesh, 'referenceArchitecture', referenceArchitectureGroup)){
    const panel = ud.referencePanelName || findUserDataValueInHierarchy(mesh, 'referencePanelName', referenceArchitectureGroup) || '';
    const kind = ud.referenceMaterialKind || findUserDataValueInHierarchy(mesh, 'referenceMaterialKind', referenceArchitectureGroup) || '';
    return `reference:${panel}:${kind}:${mesh.name || mesh.uuid}`;
  }
  return null;
}

function bakeNormalSetForMesh(mesh){
  const ud = mesh.userData || {};
  const q = new THREE.Quaternion();
  mesh.getWorldQuaternion(q);
  const localNormals = [];
  if(ud.surfaceKey === 'floor' || ud.floorTileId) localNormals.push(new THREE.Vector3(0,1,0));
  else if(ud.surfaceKey === 'ceiling') localNormals.push(new THREE.Vector3(0,-1,0));
  else if(ud.surfaceKey === 'front') localNormals.push(new THREE.Vector3(0,0,1));
  else if(ud.surfaceKey === 'back') localNormals.push(new THREE.Vector3(0,0,-1));
  else if(ud.surfaceKey === 'left') localNormals.push(new THREE.Vector3(1,0,0));
  else if(ud.surfaceKey === 'right') localNormals.push(new THREE.Vector3(-1,0,0));
  else if(ud.isArtworkFront) localNormals.push(new THREE.Vector3(0,0,1));
  else if(ud.isArtworkBack) localNormals.push(new THREE.Vector3(0,0,-1));
  else if(ud.wallId || ud.referencePanelName){
    localNormals.push(new THREE.Vector3(0,0,1), new THREE.Vector3(0,0,-1));
  }else{
    localNormals.push(new THREE.Vector3(0,1,0), new THREE.Vector3(0,0,1), new THREE.Vector3(0,0,-1), new THREE.Vector3(1,0,0), new THREE.Vector3(-1,0,0));
  }
  return localNormals.map(n=>n.applyQuaternion(q).normalize());
}

function colorToBakeEntry(color){
  const c = color.clone();
  c.r = Math.max(0, c.r); c.g = Math.max(0, c.g); c.b = Math.max(0, c.b);
  const maxChannel = Math.max(c.r, c.g, c.b, .001);
  const intensity = clamp(maxChannel, .035, 3.6);
  const tint = c.clone().multiplyScalar(1 / maxChannel);
  tint.r = clamp(tint.r, 0, 1); tint.g = clamp(tint.g, 0, 1); tint.b = clamp(tint.b, 0, 1);
  return {color:'#' + tint.getHexString(), intensity};
}

function evaluateCurrentLightAtPoint(center, normals){
  const sys = sanitizeLightSystem(STATE?.lightSystem);
  if(sys.enabled === false) return colorToBakeEntry(new THREE.Color(.82,.82,.82));
  const result = new THREE.Color(0,0,0);
  const ambientColor = new THREE.Color(sys.ambient?.color || '#ffffff').multiplyScalar(clamp(safeFinite(sys.ambient?.intensity,.62),0,8) * .36);
  result.add(ambientColor);
  const sky = new THREE.Color(sys.hemisphere?.skyColor || '#ffffff');
  const ground = new THREE.Color(sys.hemisphere?.groundColor || '#000000');
  const hemiIntensity = clamp(safeFinite(sys.hemisphere?.intensity,2.15),0,8) * .22;
  if(hemiIntensity > 0){
    const hemi = new THREE.Color(0,0,0);
    for(const n of normals){
      const t = clamp(n.y * .5 + .5, 0, 1);
      hemi.add(ground.clone().lerp(sky, t));
    }
    hemi.multiplyScalar(hemiIntensity / Math.max(1, normals.length));
    result.add(hemi);
  }
  for(const light of sys.lights || []){
    if(light.visible === false) continue;
    const lColor = new THREE.Color(light.color || '#ffffff');
    const intensity = clamp(safeFinite(light.intensity,1),0,20);
    if(intensity <= 0) continue;
    const pos = new THREE.Vector3(safeFinite(light.position?.x,0), safeFinite(light.position?.y,4), safeFinite(light.position?.z,0));
    const target = new THREE.Vector3(safeFinite(light.target?.x,0), safeFinite(light.target?.y,0), safeFinite(light.target?.z,0));
    let lightDirFromPoint = new THREE.Vector3();
    let attenuation = 1;
    if(light.type === 'directional'){
      lightDirFromPoint.copy(pos).sub(target).normalize();
      attenuation = 1;
    }else{
      lightDirFromPoint.copy(pos).sub(center);
      const dist = Math.max(.001, lightDirFromPoint.length());
      lightDirFromPoint.multiplyScalar(1 / dist);
      const range = clamp(safeFinite(light.distance,0),0,500);
      if(range > .001) attenuation = Math.pow(clamp(1 - dist / range, 0, 1), Math.max(.45, safeFinite(light.decay,2)));
      else attenuation = 1 / (1 + dist * dist * .035);
      if(light.type === 'spot'){
        const spotForward = target.clone().sub(pos).normalize();
        const fromLightToPoint = center.clone().sub(pos).normalize();
        const cosAngle = spotForward.dot(fromLightToPoint);
        const cutoff = Math.cos(clamp(safeFinite(light.angle,.72), .05, 1.55));
        const penumbra = clamp(safeFinite(light.penumbra,.25),0,1);
        const inner = THREE.MathUtils.lerp(cutoff, 1, penumbra);
        const cone = clamp((cosAngle - cutoff) / Math.max(.0001, inner - cutoff), 0, 1);
        attenuation *= cone * cone * (3 - 2 * cone);
      }
    }
    if(attenuation <= .0001) continue;
    let diffuse = 0;
    for(const n of normals) diffuse += Math.max(0, n.dot(lightDirFromPoint));
    diffuse /= Math.max(1, normals.length);
    if(diffuse <= .0001) continue;
    result.add(lColor.multiplyScalar(intensity * attenuation * diffuse * .34));
  }
  result.r = clamp(result.r, .035, 3.6);
  result.g = clamp(result.g, .035, 3.6);
  result.b = clamp(result.b, .035, 3.6);
  return colorToBakeEntry(result);
}

function collectStaticLightingBakeTargets(){
  const roots = [roomGroup, customWallGroup, floorTileGroup, referenceArchitectureGroup, artworkGroup];
  const out = [];
  const seen = new Set();
  for(const root of roots){
    if(!root) continue;
    root.updateMatrixWorld(true);
    root.traverse(obj=>{
      if(!isStaticLightingBakeTarget(obj)) return;
      const key = getBakedLightTargetKey(obj);
      if(!key || seen.has(obj)) return;
      seen.add(obj);
      out.push({mesh:obj, key});
    });
  }
  return out;
}

function collectSceneLights(){
  const out = [];
  scene?.traverse?.(obj=>{ if(obj?.isLight) out.push(obj); });
  return out;
}

function countVisibleShadowLights(){
  let count = 0;
  for(const light of collectSceneLights()){
    if(light.visible !== false && light.castShadow && light.shadow) count++;
  }
  return count;
}

function forceUpdateShadowMapsForLightingBake(){
  if(!renderer || !scene || !camera) return;
  const prevEnabled = !!renderer.shadowMap.enabled;
  const prevAutoUpdate = renderer.shadowMap.autoUpdate !== false;
  const previousShadowStates = new Map();
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.autoUpdate = true;
  renderer.shadowMap.needsUpdate = true;
  scene.updateMatrixWorld(true);
  camera.updateMatrixWorld(true);
  for(const light of collectSceneLights()){
    if(!light.shadow) continue;
    previousShadowStates.set(light, {
      autoUpdate: light.shadow.autoUpdate,
      needsUpdate: light.shadow.needsUpdate
    });
    if('autoUpdate' in light.shadow) light.shadow.autoUpdate = true;
    light.shadow.needsUpdate = true;
    light.updateMatrixWorld(true);
    if(light.target) light.target.updateMatrixWorld(true);
  }
  renderer.render(scene, camera);
  for(const [light, state] of previousShadowStates.entries()){
    if(!light?.shadow) continue;
    if('autoUpdate' in light.shadow) light.shadow.autoUpdate = state.autoUpdate;
    light.shadow.needsUpdate = state.needsUpdate;
  }
  renderer.shadowMap.enabled = prevEnabled;
  renderer.shadowMap.autoUpdate = prevAutoUpdate;
  renderer.shadowMap.needsUpdate = false;
}

function bakeCurrentLighting(){
  disableBakedLightingRuntime();
  STATE.lightBake = sanitizeLightBake(STATE?.lightBake);
  forceUpdateShadowMapsForLightingBake();
  const targets = collectStaticLightingBakeTargets();
  const shadowLights = countVisibleShadowLights();
  STATE.lightBake.enabled = true;
  STATE.lightBake.stale = false;
  STATE.lightBake.bakedAt = new Date().toISOString();
  STATE.lightBake.version = LIGHT_BAKE_VERSION;
  STATE.lightBake.mode = 'shadowCache';
  STATE.lightBake.brightness = 1;
  STATE.lightBake.targetCount = targets.length;
  STATE.lightBake.data = {};
  syncLightBakeEditor();
  scheduleSave();
  setStatus(`已烘焙目前光影快取：${targets.length} 個靜態網格、${shadowLights} 盞投影光源。遊玩模式會保留目前打光與陰影形狀，只停止陰影貼圖重算。`);
}

function getBakeEntryForMesh(mesh){
  return null;
}

function copyMaterialRuntimeFlags(source, mat){
  mat.transparent = !!source?.transparent || safeFinite(source?.opacity,1) < 1;
  mat.opacity = safeFinite(source?.opacity,1);
  mat.alphaTest = safeFinite(source?.alphaTest,0);
  mat.side = source?.side ?? THREE.FrontSide;
  mat.depthWrite = source?.depthWrite ?? true;
  mat.depthTest = source?.depthTest ?? true;
  mat.blending = source?.blending ?? THREE.NormalBlending;
  mat.premultipliedAlpha = !!source?.premultipliedAlpha;
  mat.polygonOffset = !!source?.polygonOffset;
  mat.polygonOffsetFactor = safeFinite(source?.polygonOffsetFactor,0);
  mat.polygonOffsetUnits = safeFinite(source?.polygonOffsetUnits,0);
  mat.fog = source?.fog !== false;
  mat.toneMapped = source?.toneMapped !== false;
}

function createBakedBasicMaterialFromSource(source, entry, brightness=1){
  return source;
}

function enableBakedLightingRuntime(){
  const bake = sanitizeLightBake(STATE?.lightBake);
  if(!bake.enabled || bake.stale || bake.useInPlayMode === false) return false;
  if(bakedLightingRuntime.active) return true;
  bakedLightingRuntime.previousShadowEnabled = !!renderer?.shadowMap?.enabled;
  bakedLightingRuntime.previousShadowAutoUpdate = renderer?.shadowMap?.autoUpdate !== false;
  bakedLightingRuntime.hiddenMarkers.clear();
  bakedLightingRuntime.frozenShadowLights.clear();
  bakedLightingRuntime.materialCache.clear();
  if(lightRigGroup) lightRigGroup.visible = isSinTowerStairSceneActive();
  scene?.traverse?.(obj=>{
    if(obj?.userData?.isLightMarker){
      bakedLightingRuntime.hiddenMarkers.set(obj, obj.visible !== false);
      obj.visible = false;
    }
    if(obj?.isLight && obj.shadow){
      bakedLightingRuntime.frozenShadowLights.set(obj, {
        autoUpdate: obj.shadow.autoUpdate,
        needsUpdate: obj.shadow.needsUpdate
      });
      if('autoUpdate' in obj.shadow) obj.shadow.autoUpdate = false;
      obj.shadow.needsUpdate = false;
    }
  });
  if(renderer?.shadowMap){
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.autoUpdate = false;
    renderer.shadowMap.needsUpdate = false;
  }
  bakedLightingRuntime.active = true;
  return true;
}

function disableBakedLightingRuntime(){
  if(!bakedLightingRuntime.active && !bakedLightingRuntime.materialCache.size && !bakedLightingRuntime.hiddenMarkers.size && !bakedLightingRuntime.frozenShadowLights.size) return;
  for(const [mesh, item] of bakedLightingRuntime.materialCache.entries()){
    if(mesh?.material === item.baked) mesh.material = item.original;
    const mats = Array.isArray(item.baked) ? item.baked : [item.baked];
    for(const mat of mats) if(mat?.userData?.isLightingBakeMaterial) mat.dispose?.();
  }
  bakedLightingRuntime.materialCache.clear();
  for(const [marker, wasVisible] of bakedLightingRuntime.hiddenMarkers.entries()){
    if(marker) marker.visible = wasVisible;
  }
  bakedLightingRuntime.hiddenMarkers.clear();
  for(const [light, state] of bakedLightingRuntime.frozenShadowLights.entries()){
    if(!light?.shadow) continue;
    if('autoUpdate' in light.shadow) light.shadow.autoUpdate = state.autoUpdate;
    light.shadow.needsUpdate = state.needsUpdate;
  }
  bakedLightingRuntime.frozenShadowLights.clear();
  if(lightRigGroup) lightRigGroup.visible = isSinTowerStairSceneActive();
  if(renderer?.shadowMap){
    renderer.shadowMap.enabled = bakedLightingRuntime.previousShadowEnabled;
    renderer.shadowMap.autoUpdate = bakedLightingRuntime.previousShadowAutoUpdate;
    renderer.shadowMap.needsUpdate = true;
  }
  bakedLightingRuntime.active = false;
  updateLightMarkerVisibility();
}

function refreshBakedLightingRuntime(){
  const wasActive = bakedLightingRuntime.active;
  disableBakedLightingRuntime();
  if(wasActive && isPlayMode()) enableBakedLightingRuntime();
}

function applyPlayModePerformanceLighting(play=isPlayMode()){
  const bake = sanitizeLightBake(STATE?.lightBake);
  const shouldUseBake = !!play && isSinTowerStairSceneActive() && sinTowerSceneShadowRefreshFrames <= 0 && bake.enabled && bake.useInPlayMode !== false && !bake.stale;
  if(shouldUseBake) enableBakedLightingRuntime();
  else disableBakedLightingRuntime();
}

function clearLightingBake(){
  disableBakedLightingRuntime();
  STATE.lightBake = createDefaultLightBake();
  syncLightBakeEditor();
  scheduleSave();
  setStatus('已清除光照烘焙。遊玩模式會回到即時光源與即時陰影。');
}

function syncLightBakeEditor(){
  STATE.lightBake = sanitizeLightBake(STATE?.lightBake);
  const bake = STATE.lightBake;
  if($('useLightingBakeInPlayMode')) $('useLightingBakeInPlayMode').checked = bake.useInPlayMode !== false;
  if($('lightBakeBrightness')) { $('lightBakeBrightness').value = 1; $('lightBakeBrightness').disabled = true; }
  const info = $('lightBakeInfo');
  if(info){
    if(!bake.enabled) info.textContent = '尚未烘焙。按下後會快取目前即時陰影貼圖；遊玩模式保留原本燈光與陰影外觀，只停止陰影重算以降低耗能。';
    else if(bake.stale) info.textContent = `已有光影快取，但光源、牆面或作品已改動，需要重新烘焙。上次靜態網格數：${bake.targetCount || 0}`;
    else info.textContent = `已快取 ${bake.targetCount || 0} 個靜態網格的光影狀態。遊玩模式保留原本亮度、形狀光與陰影，只停用陰影自動重算。`;
  }
}

function applyLightBakeEditor(){
  STATE.lightBake = sanitizeLightBake(STATE?.lightBake);
  if($('useLightingBakeInPlayMode')) STATE.lightBake.useInPlayMode = !!$('useLightingBakeInPlayMode').checked;
  STATE.lightBake.brightness = 1;
  syncLightBakeEditor();
  refreshBakedLightingRuntime();
  scheduleSave();
}

function syncLightSelect(){
  const sel = $('lightSelect');
  if(!sel) return;
  const lights = STATE?.lightSystem?.lights || [];
  sel.innerHTML = '';
  for(const item of lights) sel.add(new Option(item.title || item.id, item.id));
  if(lights.length){
    if(!selectedLightId || !lights.some(item=>item.id===selectedLightId)) selectedLightId = lights[0].id;
    sel.value = selectedLightId;
  }
}

function setLightEditorDisabled(disabled){
  for(const id of ['lightTitle','lightType','lightColor','lightIntensity','lightX','lightY','lightZ','lightTargetX','lightTargetY','lightTargetZ','lightDistance','lightDecay','lightAngle','lightPenumbra','lightCastShadow','lightVisible','applyLightValues','deleteSelectedLight']) if($(id)) $(id).disabled = disabled;
}

function updateLightFieldVisibility(light){
  const type = light?.type || 'point';
  const targetDisabled = type === 'point';
  const distanceDisabled = type === 'directional';
  const spotOnly = type !== 'spot';
  for(const id of ['lightTargetX','lightTargetY','lightTargetZ']) if($(id)) $(id).disabled = !light || targetDisabled;
  if($('lightDistance')) $('lightDistance').disabled = !light || distanceDisabled;
  if($('lightDecay')) $('lightDecay').disabled = !light || (type === 'directional');
  if($('lightAngle')) $('lightAngle').disabled = !light || spotOnly;
  if($('lightPenumbra')) $('lightPenumbra').disabled = !light || spotOnly;
}

function syncLightEditor(){
  STATE.lightSystem = sanitizeLightSystem(STATE?.lightSystem);
  syncLightBakeEditor();
  const sys = STATE.lightSystem;
  if($('lightSystemEnabled')) $('lightSystemEnabled').checked = sys.enabled !== false;
  if($('ambientLightColor')) $('ambientLightColor').value = validColor(sys.ambient?.color) ? sys.ambient.color : '#ffffff';
  if($('ambientLightIntensity')) $('ambientLightIntensity').value = clamp(safeFinite(sys.ambient?.intensity, .62), 0, 8);
  if($('hemisphereSkyColor')) $('hemisphereSkyColor').value = validColor(sys.hemisphere?.skyColor) ? sys.hemisphere.skyColor : '#ffffff';
  if($('hemisphereGroundColor')) $('hemisphereGroundColor').value = validColor(sys.hemisphere?.groundColor) ? sys.hemisphere.groundColor : '#000000';
  if($('hemisphereIntensity')) $('hemisphereIntensity').value = clamp(safeFinite(sys.hemisphere?.intensity, 2.15), 0, 8);
  syncLightSelect();
  if(syncLightEditorForMultiSelection()) return;
  const light = getSelectedLightState();
  if(!light){
    setLightEditorDisabled(true);
    return;
  }
  setLightEditorDisabled(false);
  if($('lightTitle')) $('lightTitle').value = light.title || '';
  if($('lightType')) $('lightType').value = light.type || 'point';
  if($('lightColor')) $('lightColor').value = validColor(light.color) ? light.color : '#ffffff';
  if($('lightIntensity')) $('lightIntensity').value = clamp(safeFinite(light.intensity,2),0,20);
  if($('lightX')) $('lightX').value = Number(safeFinite(light.position?.x,0)).toFixed(2);
  if($('lightY')) $('lightY').value = Number(safeFinite(light.position?.y,4)).toFixed(2);
  if($('lightZ')) $('lightZ').value = Number(safeFinite(light.position?.z,0)).toFixed(2);
  if($('lightTargetX')) $('lightTargetX').value = Number(safeFinite(light.target?.x,0)).toFixed(2);
  if($('lightTargetY')) $('lightTargetY').value = Number(safeFinite(light.target?.y,0)).toFixed(2);
  if($('lightTargetZ')) $('lightTargetZ').value = Number(safeFinite(light.target?.z,0)).toFixed(2);
  if($('lightDistance')) $('lightDistance').value = Number(clamp(safeFinite(light.distance,0),0,500)).toFixed(2);
  if($('lightDecay')) $('lightDecay').value = clamp(safeFinite(light.decay,2),0,4);
  if($('lightAngle')) $('lightAngle').value = clamp(safeFinite(light.angle,.72),0.05,1.55);
  if($('lightPenumbra')) $('lightPenumbra').value = clamp(safeFinite(light.penumbra,.25),0,1);
  if($('lightCastShadow')) $('lightCastShadow').checked = !!light.castShadow;
  if($('lightVisible')) $('lightVisible').checked = light.visible !== false;
  updateLightFieldVisibility(light);
}

function applyGlobalLightFromEditor(){
  STATE.lightSystem = sanitizeLightSystem(STATE?.lightSystem);
  const sys = STATE.lightSystem;
  if($('lightSystemEnabled')) sys.enabled = !!$('lightSystemEnabled').checked;
  if($('ambientLightColor')) sys.ambient.color = validColor($('ambientLightColor').value) ? $('ambientLightColor').value : sys.ambient.color;
  if($('ambientLightIntensity')) sys.ambient.intensity = clamp(safeFinite($('ambientLightIntensity').value, sys.ambient.intensity),0,8);
  if($('hemisphereSkyColor')) sys.hemisphere.skyColor = validColor($('hemisphereSkyColor').value) ? $('hemisphereSkyColor').value : sys.hemisphere.skyColor;
  if($('hemisphereGroundColor')) sys.hemisphere.groundColor = validColor($('hemisphereGroundColor').value) ? $('hemisphereGroundColor').value : sys.hemisphere.groundColor;
  if($('hemisphereIntensity')) sys.hemisphere.intensity = clamp(safeFinite($('hemisphereIntensity').value, sys.hemisphere.intensity),0,8);
  rebuildLightSystem();
  markLightingBakeStale('global-light-change');
  scheduleSave();
}

function applySelectedLightFromEditor(){
  STATE.lightSystem = sanitizeLightSystem(STATE?.lightSystem);
  if(applyMultiLightsFromEditor()) return;
  const light = getSelectedLightState();
  if(!light) return;
  light.title = String($('lightTitle')?.value || light.title || '光源').trim() || '光源';
  light.type = ['point','directional','spot'].includes($('lightType')?.value) ? $('lightType').value : light.type;
  light.color = validColor($('lightColor')?.value) ? $('lightColor').value : light.color;
  light.intensity = clamp(safeFinite($('lightIntensity')?.value, light.intensity),0,20);
  light.position = {
    x:safeFinite($('lightX')?.value, light.position?.x || 0),
    y:safeFinite($('lightY')?.value, light.position?.y || 4),
    z:safeFinite($('lightZ')?.value, light.position?.z || 0)
  };
  light.target = {
    x:safeFinite($('lightTargetX')?.value, light.target?.x || 0),
    y:safeFinite($('lightTargetY')?.value, light.target?.y || 0),
    z:safeFinite($('lightTargetZ')?.value, light.target?.z || 0)
  };
  light.distance = clamp(safeFinite($('lightDistance')?.value, light.distance || 0),0,500);
  light.decay = clamp(safeFinite($('lightDecay')?.value, light.decay || 2),0,4);
  light.angle = clamp(safeFinite($('lightAngle')?.value, light.angle || .72),0.05,1.55);
  light.penumbra = clamp(safeFinite($('lightPenumbra')?.value, light.penumbra || .25),0,1);
  light.castShadow = !!$('lightCastShadow')?.checked;
  light.visible = !!$('lightVisible')?.checked;
  const updated = createLightState(light.type, light);
  Object.assign(light, updated);
  rebuildLightSystem();
  markLightingBakeStale('selected-light-change');
  if(selectedLightObjectActive && selectedLightId) attachLightTranslateControls(selectedLightId);
  syncLightSelect();
  if($('lightSelect')) $('lightSelect').value = light.id;
  updateLightFieldVisibility(light);
  renderObjectPanel();
  scheduleSave();
}

function addLightByType(type='point'){
  STATE.lightSystem = sanitizeLightSystem(STATE?.lightSystem);
  const forward = getPlayerForward();
  const basePos = player.position.clone().addScaledVector(forward, 2.8).add(new THREE.Vector3(0, 3.0, 0));
  const overrides = {position:{x:basePos.x, y:basePos.y, z:basePos.z}, target:{x:player.position.x, y:1.4, z:player.position.z}, castShadow:type !== 'point'};
  if(type === 'directional') overrides.position = {x:player.position.x + 4, y:10, z:player.position.z + 4};
  if(type === 'spot') overrides.angle = .72;
  const light = createLightState(type, overrides);
  light.title = type === 'directional' ? `平行光 ${(STATE.lightSystem.lights?.length || 0) + 1}` : type === 'spot' ? `聚光燈 ${(STATE.lightSystem.lights?.length || 0) + 1}` : `點光源 ${(STATE.lightSystem.lights?.length || 0) + 1}`;
  STATE.lightSystem.lights.push(light);
  selectedLightId = light.id;
  selectedLightObjectActive = true;
  rebuildLightSystem();
  markLightingBakeStale('light-added');
  attachLightTranslateControls(light.id);
  syncLightEditor();
  renderObjectPanel();
  scheduleSave();
  setStatus(`已新增${type === 'directional' ? '平行光' : type === 'spot' ? '聚光燈' : '點光源'}。已加入物件視窗，並可直接拖拉 XYZ 軸移動。`);
}

function deleteSelectedLightFromEditor(){
  STATE.lightSystem = sanitizeLightSystem(STATE?.lightSystem);
  const lights = STATE.lightSystem.lights || [];
  if(!lights.length || !selectedLightId) return false;
  const index = lights.findIndex(item=>item.id===selectedLightId);
  if(index < 0) return false;
  lights.splice(index,1);
  selectedLightId = lights[0]?.id || null;
  selectedLightObjectActive = !!selectedLightId;
  rebuildLightSystem();
  markLightingBakeStale('light-deleted');
  syncLightEditor();
  renderObjectPanel();
  scheduleSave();
  setStatus('已刪除光源。');
  return true;
}

function bindLightEditor(){
  if($('bakeLightingNow')) $('bakeLightingNow').onclick = bakeCurrentLighting;
  if($('clearLightingBake')) $('clearLightingBake').onclick = clearLightingBake;
  if($('useLightingBakeInPlayMode')) $('useLightingBakeInPlayMode').onchange = applyLightBakeEditor;
  if($('lightBakeBrightness')) $('lightBakeBrightness').oninput = applyLightBakeEditor;
  if($('lightSystemEnabled')) $('lightSystemEnabled').onchange = applyGlobalLightFromEditor;
  for(const id of ['ambientLightColor','ambientLightIntensity','hemisphereSkyColor','hemisphereGroundColor','hemisphereIntensity']) if($(id)) $(id).oninput = applyGlobalLightFromEditor;
  if($('lightSelect') && !$('lightSelect').dataset.bound){
    $('lightSelect').dataset.bound = '1';
    $('lightSelect').onchange = ()=>{ selectedLightId = $('lightSelect').value || null; if(selectedLightId) selectLightObject(selectedLightId); else syncLightEditor(); };
  }
  if($('lightType')) $('lightType').onchange = applySelectedLightFromEditor;
  for(const id of ['lightTitle','lightColor','lightIntensity','lightX','lightY','lightZ','lightTargetX','lightTargetY','lightTargetZ','lightDistance','lightDecay','lightAngle','lightPenumbra']){
    if(!$(id)) continue;
    $(id).oninput = applySelectedLightFromEditor;
    $(id).onkeydown = ev=>{ if(ev.key === 'Enter'){ ev.preventDefault(); applySelectedLightFromEditor(); ev.target.blur(); } };
  }
  for(const id of ['lightCastShadow','lightVisible']) if($(id)) $(id).onchange = applySelectedLightFromEditor;
  if($('applyLightValues')) $('applyLightValues').onclick = applySelectedLightFromEditor;
  if($('deleteSelectedLight')) $('deleteSelectedLight').onclick = ()=>{ if(!deleteSelectedLightFromEditor()) setStatus('目前沒有可刪除的光源。'); };
  if($('addPointLight')) $('addPointLight').onclick = ()=>addLightByType('point');
  if($('addDirectionalLight')) $('addDirectionalLight').onclick = ()=>addLightByType('directional');
  if($('addSpotLight')) $('addSpotLight').onclick = ()=>addLightByType('spot');
}


function captureSinTowerRuntimeState(){
  ensureSinTowerEditorState();
  return {
    stair:{
      textureDataUrl:SIN_TOWER_STAIRCASE.textureDataUrl || null,
      textureRepeat:safeFinite(SIN_TOWER_STAIRCASE.textureRepeat,3),
      totalSteps:getSinTowerTotalStepCount()
    },
    monks:{
      visibleStepWindow:safeFinite(SIN_TOWER_MONKS.visibleStepWindow,50),
      poolCount:safeFinite(SIN_TOWER_MONKS.poolCount,16),
      spriteFps:safeFinite(SIN_TOWER_MONKS.spriteFps,12),
      spriteFrameStart:safeFinite(SIN_TOWER_MONKS.spriteFrameStart,1),
      spriteFrameEnd:safeFinite(SIN_TOWER_MONKS.spriteFrameEnd,10),
      spriteLoopPause:safeFinite(SIN_TOWER_MONKS.spriteLoopPause,.35),
      spritePingpong:SIN_TOWER_MONKS.spritePingpong !== false,
      spriteHeight:safeFinite(SIN_TOWER_MONKS.spriteHeight,1.77),
      spriteWidthMul:safeFinite(SIN_TOWER_MONKS.spriteWidthMul,1),
      useSpriteSequence:!!SIN_TOWER_MONKS.useSpriteSequence,
      spriteFrames:(SIN_TOWER_MONKS.spriteFrames || []).map((f,i)=>({
        dataUrl:f.dataUrl || null,
        ratio:safeFinite(f.ratio,.62),
        no:safeFinite(f.no,i+1),
        name:f.name || ''
      })).filter(f=>!!f.dataUrl)
    },
    infectionParams:{...(SIN_TOWER_INFECTION.params || {})},
    fireParams:{...(SIN_TOWER_FIRE_FX.params || {})},
    editor:{
      version:SIN_TOWER_EDITOR.version,
      activeSceneId:SIN_TOWER_EDITOR.activeSceneId,
      selectedObjectId:SIN_TOWER_EDITOR.selectedObjectId,
      selectedObjectType:SIN_TOWER_EDITOR.selectedObjectType,
      ui:{...SIN_TOWER_EDITOR.ui},
      perf:{...SIN_TOWER_EDITOR.perf},
      sharedStoneTextureDataUrl:SIN_TOWER_EDITOR.sharedStoneTextureDataUrl || null,
      bundledBookInitialized:!!SIN_TOWER_EDITOR.bundledBookInitialized,
      scenes:SIN_TOWER_EDITOR.scenes.map(s=>({...s, spawn:{...s.spawn}, dimensions:{...s.dimensions}, skybox:{...(s.skybox || {})}, sharedStoneTextureDataUrl:s.sharedStoneTextureDataUrl || null, sharedStoneTextureName:s.sharedStoneTextureName || ''})),
      props:SIN_TOWER_EDITOR.props.map(p=>({...p, offset:{...p.offset}, position:{...(p.position || p.offset)}, interaction:{...(p.interaction || {})}, frames:(p.frames||[]).map(f=>({...f}))})),
      models:SIN_TOWER_EDITOR.models.map(model=>({...model,position:{...model.position},rotation:{...model.rotation},scale:{...model.scale}})),
      portals:SIN_TOWER_EDITOR.portals.map(p=>({...p, offset:{...p.offset}})),
      stones:SIN_TOWER_EDITOR.stones.map(s=>({...s, position:{...s.position}, rotation:{...s.rotation}, scale:{...s.scale}, textureName:s.textureName || ''}))
    },
    windows:captureFloatingWindowStates?.() || {}
  };
}

function scheduleSinTowerRuntimeSave(){
  if(SIN_TOWER_PUBLISHED)return;
  clearTimeout(sinTowerRuntimeSaveTimer);
  setSinTowerSaveBadge('有未保存變更', 'pending');
  sinTowerRuntimeSaveTimer = setTimeout(()=>{
    sinTowerRuntimeSaveTimer = null;
    void saveSinTowerRuntimeStateNow();
  }, 360);
}

async function saveSinTowerRuntimeStateNow(){
  const runtimeSnapshot = cloneSinTowerPersistenceValue(captureSinTowerRuntimeState());
  try{
    const result = await enqueueSinTowerPersistenceWrite(async()=>{
      await dbSet(SIN_TOWER_RUNTIME_KEY, runtimeSnapshot);
      return runtimeSnapshot;
    });
    sinTowerLastPersistence.lastSavedAt = Date.now();
    setSinTowerSaveBadge('已自動保存 ' + formatSinTowerSaveClock(sinTowerLastPersistence.lastSavedAt), 'saved');
    return result;
  }catch(err){
    console.warn('sin tower runtime autosave failed', err);
    setSinTowerSaveBadge('自動保存失敗', 'error');
    return null;
  }
}
// Immutable decoded GIF frames are uploaded once while resident. Eviction only
// releases GPU copies; original decoded pixels and animation timing are retained.
// Immutable decoded GIF frames are uploaded once while resident. Eviction only
// releases GPU copies; original decoded pixels and animation timing are retained.
const sinTowerGifResidency = {bytes:0,budget:192*1024*1024,entries:new Set(),sources:new Map(),clock:0};
const sinTowerGifDecodedAssets=new Map();
async function acquireSinTowerGifDecoded(src){
  let asset=sinTowerGifDecodedAssets.get(src);
  if(!asset){
    asset={src,refs:0,promise:null,decoded:null};
    asset.promise=decodeSinTowerGifFrames(src).then(decoded=>{asset.decoded=decoded;if(decoded)decoded.textureSources=decoded.frames.map(bitmap=>new THREE.Source(bitmap));return decoded;});
    sinTowerGifDecodedAssets.set(src,asset);
  }
  asset.refs++;
  try{const decoded=await asset.promise;return{asset,decoded};}
  catch(error){releaseSinTowerGifDecoded(asset);throw error;}
}
function releaseSinTowerGifDecoded(asset){
  if(!asset||--asset.refs>0)return;
  if(sinTowerGifDecodedAssets.get(asset.src)===asset)sinTowerGifDecodedAssets.delete(asset.src);
  for(const bitmap of asset.decoded?.frames||[])bitmap.close?.();
}
function releaseSinTowerGifTexture(entry){
  if(!sinTowerGifResidency.entries.delete(entry))return;
  const source=sinTowerGifResidency.sources.get(entry.texture.source);
  if(source&&--source.refs===0){sinTowerGifResidency.bytes-=source.bytes;sinTowerGifResidency.sources.delete(entry.texture.source);}
  entry.owner.gifTextures.delete(entry.index);
  entry.texture.dispose();
}
function trimSinTowerGifTextures(){
  const pool=sinTowerGifResidency;
  if(pool.bytes<=pool.budget)return;
  for(const entry of pool.entries){if(pool.bytes<=pool.budget)break;if(entry.owner.material.map!==entry.texture)releaseSinTowerGifTexture(entry);}
}
function getSinTowerResidentGifTexture(frame){
  const index=frame.gifFrameIndex;
  let entry=frame.gifTextures.get(index);
  if(!entry){
    const bitmap=frame.gifFrames[index],texture=new THREE.Texture(bitmap);
    if(frame.gifTextureSources?.[index])texture.source=frame.gifTextureSources[index];
    texture.colorSpace=THREE.SRGBColorSpace;
    texture.minFilter=THREE.LinearFilter;texture.magFilter=THREE.LinearFilter;
    texture.generateMipmaps=false;
    texture.anisotropy=frame.texture.anisotropy;
    // ImageBitmap ignores UNPACK_FLIP_Y_WEBGL; invert UVs instead, matching
    // the previous CanvasTexture orientation without copying the bitmap.
    texture.flipY=false;texture.repeat.y=-1;texture.offset.y=1;
    texture.userData.sinTowerAnimatedGif=true;texture.needsUpdate=true;
    entry={owner:frame,index,texture,bytes:bitmap.width*bitmap.height*4,used:0};
    frame.gifTextures.set(index,entry);sinTowerGifResidency.entries.add(entry);
    let source=sinTowerGifResidency.sources.get(texture.source);
    if(!source){source={refs:0,bytes:entry.bytes};sinTowerGifResidency.sources.set(texture.source,source);sinTowerGifResidency.bytes+=entry.bytes;}
    source.refs++;
  }
  entry.used=++sinTowerGifResidency.clock;
  sinTowerGifResidency.entries.delete(entry);sinTowerGifResidency.entries.add(entry);
  return entry.texture;
}
async function decodeSinTowerGifFrames(src){
  if(typeof ImageDecoder !== 'function' || !(await ImageDecoder.isTypeSupported('image/gif'))) return null;
  const bytes = new Uint8Array(await (await fetch(src)).arrayBuffer());
  const decoder = new ImageDecoder({data:bytes,type:'image/gif',preferAnimation:true});
  await decoder.tracks.ready;
  const track = decoder.tracks.selectedTrack;
  const frameCount = clamp(Math.floor(safeFinite(track?.frameCount,1)),1,120);
  const first = await decoder.decode({frameIndex:0,completeFramesOnly:true});
  const firstImage = first.image;
  const sourceWidth = Math.max(1,firstImage.displayWidth || firstImage.codedWidth || 1);
  const sourceHeight = Math.max(1,firstImage.displayHeight || firstImage.codedHeight || 1);
  const maxDimensionScale = Math.min(1,1024/Math.max(sourceWidth,sourceHeight));
  const pixelBudgetScale = Math.min(1,Math.sqrt(24000000/Math.max(1,sourceWidth*sourceHeight*frameCount)));
  const decodeScale = Math.min(maxDimensionScale,pixelBudgetScale);
  const width = Math.max(1,Math.round(sourceWidth*decodeScale));
  const height = Math.max(1,Math.round(sourceHeight*decodeScale));
  const frames = [];
  const durations = [];
  try{
    for(let index=0;index<frameCount;index++){
      const result = index === 0 ? first : await decoder.decode({frameIndex:index,completeFramesOnly:true});
      const image = result.image;
      durations.push(clamp(safeFinite(image.duration,100000)/1000,20,10000));
      frames.push(await createImageBitmap(image,{resizeWidth:width,resizeHeight:height,resizeQuality:'high'}));
      image.close?.();
    }
  }finally{
    decoder.close?.();
  }
  return {frames,durations,width,height,sourceWidth,sourceHeight,frameCount};
}

function updateSinTowerGifFrame(frame,t,allowUpload=true){
  if(!frame)return;
  if(frame.gifFrames?.length){
    if(!Number.isFinite(frame.gifLastTime))frame.gifLastTime=t;
    frame.gifElapsedMs+=Math.max(0,(t-frame.gifLastTime)*1000);frame.gifLastTime=t;
    const cycle=frame.gifCycleMs;
    if(cycle>0)frame.gifElapsedMs%=cycle;
    for(let guard=0;guard<frame.gifFrames.length;guard++){
      const duration=frame.gifDurations[frame.gifFrameIndex]||100;
      if(frame.gifElapsedMs<duration)break;
      frame.gifElapsedMs-=duration;frame.gifFrameIndex=(frame.gifFrameIndex+1)%frame.gifFrames.length;
    }
    if(allowUpload){frame.material.map=getSinTowerResidentGifTexture(frame);trimSinTowerGifTextures();}
    return;
  }
  if(frame.gifFallbackImage&&allowUpload&&t-safeFinite(frame.gifLastUpload,-Infinity)>=1/20){frame.gifContext.clearRect(0,0,frame.gifCanvas.width,frame.gifCanvas.height);frame.gifContext.drawImage(frame.gifFallbackImage,0,0,frame.gifCanvas.width,frame.gifCanvas.height);frame.texture.needsUpdate=true;frame.gifLastUpload=t;}
}

async function makeSinTowerGifFrameFromDataUrl(item){
  const src=item?.dataUrl;
  if(!src) return null;
  let decoded=null,lease=null;
  try{ lease=await acquireSinTowerGifDecoded(src);decoded=lease.decoded; }
  catch(error){ console.warn('Sin Tower explicit GIF decode fallback',error); }
  let fallbackImage=null;
  if(!decoded){
    fallbackImage=await new Promise((resolve,reject)=>{const image=new Image();image.onload=()=>resolve(image);image.onerror=reject;image.src=src;});
    decoded={frames:[],durations:[100],width:fallbackImage.naturalWidth||1,height:fallbackImage.naturalHeight||1,frameCount:1};
  }
  const canvas=document.createElement('canvas');
  canvas.width=decoded.width; canvas.height=decoded.height;
  const context=canvas.getContext('2d',{alpha:true,willReadFrequently:false});
  context.clearRect(0,0,canvas.width,canvas.height);
  context.drawImage(decoded.frames[0] || fallbackImage,0,0,canvas.width,canvas.height);
  const tex=new THREE.CanvasTexture(canvas);
  tex.colorSpace=THREE.SRGBColorSpace;
  tex.minFilter=THREE.LinearFilter;
  tex.magFilter=THREE.LinearFilter;
  tex.generateMipmaps=false;
  tex.anisotropy=Math.min(4,renderer?.capabilities?.getMaxAnisotropy?.()||1);
  tex.userData.sinTowerAnimatedGif=true;
  const ratio=clamp(safeFinite(item.ratio,canvas.width/canvas.height),.05,20);
  const mat=new THREE.SpriteMaterial({map:tex,transparent:true,alphaTest:.018,depthWrite:false,depthTest:true,sizeAttenuation:true});
  const frame={texture:tex,material:mat,ratio,dataUrl:src,name:item.name||'',isGif:true,gifCanvas:canvas,gifContext:context,gifFrames:decoded.frames,gifDurations:decoded.durations,gifFrameCount:decoded.frameCount,gifFrameIndex:0,gifElapsedMs:0,gifLastTime:NaN,gifNeedsUpload:false,gifFallbackImage:fallbackImage};
  frame.gifTextures=new Map();frame.gifTextureSources=decoded.textureSources;
  frame.gifCycleMs=decoded.durations.reduce((sum,duration)=>sum+duration,0);
  if(frame.gifFrames.length)frame.material.map=getSinTowerResidentGifTexture(frame);
  frame.disposeGif=()=>{for(const entry of frame.gifTextures.values())releaseSinTowerGifTexture(entry);releaseSinTowerGifDecoded(lease?.asset);lease=null;frame.gifFrames=[];frame.gifFallbackImage=null;};
  return frame;
}

async function makeSinTowerSpriteFrameFromDataUrl(item){
  const src = item?.dataUrl;
  if(!src) return null;
  const loader = new THREE.TextureLoader();
  const tex = await new Promise((resolve,reject)=>loader.load(src, resolve, undefined, reject));
  tex.colorSpace = THREE.SRGBColorSpace;
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  tex.magFilter = THREE.LinearFilter;
  tex.generateMipmaps = true;
  tex.anisotropy = Math.min(8, renderer?.capabilities?.getMaxAnisotropy?.() || 1);
  tex.needsUpdate = true;
  const img = tex.image || {};
  const ratio = safeFinite(item.ratio, img.width && img.height ? img.width / img.height : .62);
  const mat = new THREE.SpriteMaterial({map:tex, transparent:true, alphaTest:.035, depthWrite:false, depthTest:true, sizeAttenuation:true});
  return {texture:tex, material:mat, ratio, dataUrl:src, no:item.no, name:item.name || ''};
}

async function restoreSinTowerSpriteFramesFromSaved(savedFrames=[]){
  if(!Array.isArray(savedFrames) || !savedFrames.length) return false;
  disposeSinTowerMonkSpriteAssets();
  const frames = [];
  for(const item of savedFrames){
    try{ const frame = await makeSinTowerSpriteFrameFromDataUrl(item); if(frame) frames.push(frame); }
    catch(err){ console.warn('saved PNG sprite frame failed', err); }
  }
  if(!frames.length) return false;
  SIN_TOWER_MONKS.spriteFrames = frames;
  SIN_TOWER_MONKS.spriteUrls = [];
  SIN_TOWER_MONKS.useSpriteSequence = true;
  sinTowerBaseMonkModel = null;
  return true;
}

async function loadSinTowerRuntimeState(sourceOverride=null){
  const raw = sourceOverride || await dbGet(SIN_TOWER_RUNTIME_KEY);
  if(!raw) return;
  const storedRuntimeVersion = safeFinite(raw?.editor?.version, 1);
  if(raw.infectionParams) Object.assign(SIN_TOWER_INFECTION.params, raw.infectionParams);
  getSinTowerTumorParams();
  if(raw.fireParams) Object.assign(SIN_TOWER_FIRE_FX.params, raw.fireParams);
  if(raw.editor) ensureSinTowerEditorState(raw.editor);
  else ensureSinTowerEditorState();
  if(raw.stair){
    SIN_TOWER_STAIRCASE.textureDataUrl = raw.stair.textureDataUrl || null;
    SIN_TOWER_STAIRCASE.textureRepeat = safeFinite(raw.stair.textureRepeat,3);
    SIN_TOWER_STAIRCASE.totalSteps = clamp(Math.round(safeFinite(raw.stair.totalSteps,0)),0,SIN_TOWER_STAIRCASE.virtualCount||1000000);
  }
  if(raw.monks){
    SIN_TOWER_MONKS.visibleStepWindow = safeFinite(raw.monks.visibleStepWindow,50);
    SIN_TOWER_MONKS.poolCount = safeFinite(raw.monks.poolCount,16);
    SIN_TOWER_MONKS.spriteFps = safeFinite(raw.monks.spriteFps,12);
    SIN_TOWER_MONKS.spriteFrameStart = safeFinite(raw.monks.spriteFrameStart,1);
    SIN_TOWER_MONKS.spriteFrameEnd = safeFinite(raw.monks.spriteFrameEnd,10);
    SIN_TOWER_MONKS.spriteLoopPause = safeFinite(raw.monks.spriteLoopPause,.35);
    SIN_TOWER_MONKS.spritePingpong = raw.monks.spritePingpong !== false;
    const savedMonkHeight = safeFinite(raw.monks.spriteHeight,1.18);
    SIN_TOWER_MONKS.spriteHeight = clamp(storedRuntimeVersion < 2 ? savedMonkHeight * 1.5 : savedMonkHeight, .3, 5);
    SIN_TOWER_MONKS.spriteWidthMul = safeFinite(raw.monks.spriteWidthMul,1);
    if(raw.monks.useSpriteSequence && raw.monks.spriteFrames?.length){
      await restoreSinTowerSpriteFramesFromSaved(raw.monks.spriteFrames);
    }
  }
  if(raw.windows) setTimeout(()=>restoreFloatingWindowStates(raw.windows), 80);
}

function formatSinTowerSaveClock(value){
  try{return new Date(value).toLocaleTimeString('zh-TW',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});}
  catch{return ''}
}

function setSinTowerSaveBadge(text,kind=''){
  const badge=$('sinProSaveBadge');
  if(!badge)return;
  badge.textContent=String(text||'');
  badge.classList.remove('pending','saved','error');
  if(kind)badge.classList.add(kind);
}

function markSinTowerSavePending(){setSinTowerSaveBadge('有未保存變更','pending');}

function scheduleSave(){
  if(SIN_TOWER_PUBLISHED)return;
  pushUndoState('change');
  clearTimeout(saveTimer);
  markSinTowerSavePending();
  saveTimer=setTimeout(()=>{
    saveTimer=null;
    void saveStateNow().catch(error=>{
      console.warn('sin tower autosave failed',error);
      setSinTowerSaveBadge('自動保存失敗','error');
    });
  },260);
}

function cloneSinTowerPersistenceValue(value){
  if(typeof structuredClone==='function'){
    try{return structuredClone(value);}catch{}
  }
  return JSON.parse(JSON.stringify(value));
}

function enqueueSinTowerPersistenceWrite(task){
  const run=sinTowerPersistenceWriteChain.then(task,task);
  sinTowerPersistenceWriteChain=run.catch(()=>{});
  return run;
}

async function saveStateNow(options={}){
  clearTimeout(saveTimer);saveTimer=null;
  clearTimeout(sinTowerRuntimeSaveTimer);sinTowerRuntimeSaveTimer=null;
  const savedAt=Date.now();
  const stateSnapshot=cloneSinTowerPersistenceValue(STATE);
  const runtimeSnapshot=cloneSinTowerPersistenceValue(captureSinTowerRuntimeState());
  const result=await enqueueSinTowerPersistenceWrite(async()=>{
    await dbSet(STATE_KEY,stateSnapshot);
    await dbSet(SIN_TOWER_RUNTIME_KEY,runtimeSnapshot);
    return{state:stateSnapshot,runtime:runtimeSnapshot,savedAt};
  });
  sinTowerLastPersistence.lastSavedAt=savedAt;
  sinTowerLastPersistence.browserVerified=false;
  if(options.updateBadge!==false)setSinTowerSaveBadge('已自動保存 '+formatSinTowerSaveClock(savedAt),'saved');
  return result;
}

async function loadState(){
  const raw=await dbGet(STATE_KEY);
  return raw?sanitizeState(raw):null;
}

async function resolveSinTowerInitialPersistence(){
  if(SIN_TOWER_PUBLISHED)return{state:sanitizeState(cloneSinTowerPersistenceValue(EXPORTED_STATE)),runtimeState:cloneSinTowerPersistenceValue(EXPORTED_RUNTIME_STATE),loadStoredRuntime:false,source:'published'};
  if(!EXPORTED_STATE)return{state:(await loadState()||createDefaultState()),runtimeState:null,loadStoredRuntime:true,source:'browser'};
  const backupId=String(EXPORTED_BACKUP_META?.id||'');
  if(!backupId)return{state:sanitizeState(EXPORTED_STATE),runtimeState:EXPORTED_RUNTIME_STATE?cloneSinTowerPersistenceValue(EXPORTED_RUNTIME_STATE):null,loadStoredRuntime:false,source:'legacy-export'};
  const markerKey=SIN_TOWER_BACKUP_ACTIVATION_PREFIX+backupId;
  try{
    const marker=await dbGet(markerKey);
    if(marker){
      const storedState=await loadState(),storedRuntime=await dbGet(SIN_TOWER_RUNTIME_KEY);
      if(storedState&&storedRuntime)return{state:storedState,runtimeState:storedRuntime,loadStoredRuntime:false,source:'browser-after-backup'};
    }
  }catch(error){console.warn('backup activation lookup failed',error);}
  const stateSnapshot=sanitizeState(cloneSinTowerPersistenceValue(EXPORTED_STATE));
  const runtimeSnapshot=EXPORTED_RUNTIME_STATE?cloneSinTowerPersistenceValue(EXPORTED_RUNTIME_STATE):null;
  try{
    await enqueueSinTowerPersistenceWrite(async()=>{
      await dbSet(STATE_KEY,stateSnapshot);
      if(runtimeSnapshot)await dbSet(SIN_TOWER_RUNTIME_KEY,runtimeSnapshot);
      await dbSet(markerKey,{activatedAt:Date.now(),savedAt:EXPORTED_BACKUP_META?.savedAt||null});
    });
    sinTowerLastPersistence.restoredBackupId=backupId;
  }catch(error){console.warn('embedded backup activation failed',error);}
  return{state:stateSnapshot,runtimeState:runtimeSnapshot,loadStoredRuntime:false,source:'embedded-backup'};
}

function exportJson(){
  const payload={format:'sin-tower-complete-backup-v1',savedAt:new Date().toISOString(),state:cloneSinTowerPersistenceValue(STATE),runtime:cloneSinTowerPersistenceValue(captureSinTowerRuntimeState())};
  const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'}),a=document.createElement('a');
  a.href=URL.createObjectURL(blob);a.download='SinTower_complete_state.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),30000);
}

function stripEditorMarkupForExport(html){return html;}

function sinTowerPersistenceFingerprint(value){
  let hash=2166136261>>>0,nodes=0,dataUrls=0,dataChars=0;
  const seen=new WeakSet();
  const mixText=text=>{const value=String(text);hash^=value.length;hash=Math.imul(hash,16777619)>>>0;for(let i=0;i<value.length;i++){hash^=value.charCodeAt(i);hash=Math.imul(hash,16777619)>>>0;}};
  const visit=item=>{
    nodes++;
    if(item===null){mixText('null');return;}
    const type=typeof item;
    if(type==='string'){if(item.startsWith('data:')){dataUrls++;dataChars+=item.length;}mixText('s');mixText(item);return;}
    if(type==='number'||type==='boolean'||type==='undefined'){mixText(type[0]);mixText(String(item));return;}
    if(type!=='object'){mixText(type);return;}
    if(seen.has(item)){mixText('[circular]');return;}
    seen.add(item);
    if(Array.isArray(item)){mixText('[');for(const entry of item)visit(entry);mixText(']');return;}
    mixText('{');
    for(const key of Object.keys(item)){mixText(key);visit(item[key]);}
    mixText('}');
  };
  visit(value);
  return{hash:hash.toString(16).padStart(8,'0'),nodes,dataUrls,dataChars};
}

async function verifySinTowerBrowserSave(saved){
  const storedState=await dbGet(STATE_KEY),storedRuntime=await dbGet(SIN_TOWER_RUNTIME_KEY);
  if(!storedState||!storedRuntime)throw new Error('IndexedDB 回讀不到完整存檔。');
  const expectedState=sinTowerPersistenceFingerprint(saved.state),actualState=sinTowerPersistenceFingerprint(storedState),expectedRuntime=sinTowerPersistenceFingerprint(saved.runtime),actualRuntime=sinTowerPersistenceFingerprint(storedRuntime);
  if(JSON.stringify(expectedState)!==JSON.stringify(actualState)||JSON.stringify(expectedRuntime)!==JSON.stringify(actualRuntime))throw new Error('IndexedDB 回讀內容與目前設定不一致。');
  return{state:actualState,runtime:actualRuntime,assetCount:actualState.dataUrls+actualRuntime.dataUrls,assetCharacters:actualState.dataChars+actualRuntime.dataChars};
}

async function requestSinTowerPersistentStorage(){
  const result={supported:!!navigator.storage,persisted:null,usage:null,quota:null};
  try{
    if(navigator.storage?.persisted)result.persisted=await navigator.storage.persisted();
    if(result.persisted===false&&navigator.storage?.persist)result.persisted=await navigator.storage.persist();
    if(navigator.storage?.estimate){const estimate=await navigator.storage.estimate();result.usage=safeFinite(estimate.usage,null);result.quota=safeFinite(estimate.quota,null);}
  }catch(error){result.error=String(error?.message||error);}
  return result;
}

function readSinTowerBlobAsDataUrl(blob,mimeType='application/octet-stream'){
  return new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(String(reader.result||''));reader.onerror=()=>reject(reader.error||new Error('無法讀取內建素材'));reader.readAsDataURL(blob.type?blob:new Blob([blob],{type:mimeType}));});
}

async function inlineSinTowerBackupDependencies(html,dependencyAssets=null){
  const resources=[
    {literal:'./'+'assets/fonts/saint.woff',mime:'font/woff'},
    {literal:'./'+'assets/fonts/ChillDuanHeiSongPro_Regular.woff',mime:'font/woff'},
    {literal:'./'+'assets/%E5%AF%86%E7%A2%BC%E7%95%AB%E9%9D%A2/CODE3.gif',mime:'image/gif'},
    {literal:'./'+'assets/%E5%AF%86%E7%A2%BC%E7%95%AB%E9%9D%A2/Codeframe.png',mime:'image/png'},
    {literal:'./'+'assets/%E6%9B%B8%E7%B1%8D/%E6%9B%B8%E7%B1%8D_01_optimized.glb',mime:'model/gltf-binary'}
  ];
  let embedded=0,embeddedBytes=0;
  const unresolved=[];
  for(const resource of resources){
    if(!html.includes(resource.literal))continue;
    try{
      const selected=dependencyAssets?.get(decodeURIComponent(resource.literal.replace('./assets/','')));
      const response=selected?new Response(selected,{headers:{'Content-Type':resource.mime}}):await fetch(new URL(resource.literal,document.baseURI).href,{cache:'force-cache'});
      if(!response.ok)throw new Error('HTTP '+response.status);
      const blob=await response.blob(),typedBlob=blob.type?blob:new Blob([blob],{type:resource.mime}),dataUrl=await readSinTowerBlobAsDataUrl(typedBlob,resource.mime);
      html=html.split(resource.literal).join(dataUrl);embedded++;embeddedBytes+=blob.size;
    }catch(error){unresolved.push({url:resource.literal,error:String(error?.message||error)});}
  }
  return{html,report:{embedded,total:resources.length,embeddedBytes,unresolved,sourceBase:new URL('.',document.baseURI).href}};
}

function sinTowerSafeInlineJson(value){return JSON.stringify(value).replace(/</g,'\\u003c').replace(/-->/g,'--\\u003e').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');}

function replaceSinTowerEmbeddedPayload(html,startMarker,endMarker,value){
  const expression=new RegExp('(\\/\\*'+startMarker+'\\*\\/)[\\s\\S]*?(\\/\\*'+endMarker+'\\*\\/)');
  const json=sinTowerSafeInlineJson(value);
  if(!expression.test(html))throw new Error('完整存檔標記遺失：'+startMarker);
  return html.replace(expression,(_match,start,end)=>start+json+end);
}

function createSinTowerBackupId(){return globalThis.crypto?.randomUUID?.()||('backup-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2));}

async function buildSinTowerCompleteBackupHtml(saved,verification,dependencyAssets=null){
  const clone=document.documentElement.cloneNode(true),sourceBase=new URL('.',document.baseURI).href;
  clone.querySelectorAll('#sinRpsOverlay,#sinRpsStyle,#sinSelectedRpsSettings,#sinRpsLossFlash,#sinExtraStyle,#sinExtraSelected,#sinExtraPerf,#sinAfterVideoOverlay,#sinGifCursor,#sinCursorMonoFilter,#sinPortalSmoothCanvas').forEach(node=>node.remove());
  clone.querySelector('body')?.classList.remove('sin-rps-active','sin-after-video-active','sin-gif-cursor');
  const oldBase=clone.querySelector('#sinTowerBackupBase');if(oldBase)oldBase.remove();
  const base=document.createElement('base');base.id='sinTowerBackupBase';base.href=sourceBase;clone.querySelector('head')?.prepend(base);
  const saveButton=clone.querySelector('#sinProSave');if(saveButton){saveButton.textContent='儲存完整遊戲';saveButton.removeAttribute('aria-busy');}
  const legacySave=clone.querySelector('#saveNow');if(legacySave)legacySave.textContent='儲存完整遊戲（自動下載）';
  const badge=clone.querySelector('#sinProSaveBadge');if(badge){badge.textContent='已從完整存檔載入';badge.className='saved';}
  const meta={format:'sin-tower-editable-html-v1',id:createSinTowerBackupId(),savedAt:new Date(saved.savedAt).toISOString(),savedAtEpoch:saved.savedAt,sourceBase,verification};
  let html='<!DOCTYPE html>\n'+clone.outerHTML;
  html=replaceSinTowerEmbeddedPayload(html,'__SIN_TOWER_STATE_START__','__SIN_TOWER_STATE_END__',saved.state);
  html=replaceSinTowerEmbeddedPayload(html,'__SIN_TOWER_RUNTIME_START__','__SIN_TOWER_RUNTIME_END__',saved.runtime);
  html=replaceSinTowerEmbeddedPayload(html,'__SIN_TOWER_BACKUP_META_START__','__SIN_TOWER_BACKUP_META_END__',meta);
  const dependencies=await inlineSinTowerBackupDependencies(html,dependencyAssets);html=dependencies.html;meta.dependencies=dependencies.report;
  html=replaceSinTowerEmbeddedPayload(html,'__SIN_TOWER_BACKUP_META_START__','__SIN_TOWER_BACKUP_META_END__',meta);
  html=html.replace(/<title>.*?<\/title>/,'<title>斷罪塔 - 完整可編輯存檔</title>');
  return{html,meta};
}

function triggerSinTowerBackupDownload(html,savedAt){
  const stamp=new Date(savedAt).toISOString().replace(/[:.]/g,'-'),filename='SinTower_完整可編輯存檔_'+stamp+'.html',blob=new Blob([html],{type:'text/html;charset=utf-8'}),url=URL.createObjectURL(blob),anchor=document.createElement('a');
  anchor.href=url;anchor.download=filename;document.body.append(anchor);anchor.click();anchor.remove();setTimeout(()=>URL.revokeObjectURL(url),60000);
  return{filename,size:blob.size};
}

async function saveAndExportSinTowerCompleteGame(){
  if(sinTowerCompleteSaveInProgress)return null;
  sinTowerCompleteSaveInProgress=true;
  const button=$('sinProSave'),legacy=$('saveNow'),originalText=button?.textContent||'儲存完整遊戲';
  if(button){button.textContent='正在保存與驗證…';button.setAttribute('aria-busy','true');}
  if(legacy)legacy.disabled=true;
  setSinTowerSaveBadge('正在提交 IndexedDB…','pending');
  setStatus('正在保存全部場景、物件、PNG／GIF、3D 模型、貼圖、音效與互動內容……');
  try{
    const storage=await requestSinTowerPersistentStorage(),saved=await saveStateNow({updateBadge:false}),verification=await verifySinTowerBrowserSave(saved);
    sinTowerLastPersistence.browserVerified=true;
    setSinTowerSaveBadge('瀏覽器存檔已驗證，正在匯出…','pending');
    const backup=await buildSinTowerCompleteBackupHtml(saved,verification),download=triggerSinTowerBackupDownload(backup.html,saved.savedAt);
    Object.assign(sinTowerLastPersistence,{lastSavedAt:saved.savedAt,browserVerified:true,lastExportAt:Date.now(),lastFilename:download.filename,lastExportBytes:download.size,persistentStorage:storage.persisted,assetCount:verification.assetCount,dependencyReport:backup.meta.dependencies});
    setSinTowerSaveBadge('已驗證並下載 '+formatSinTowerSaveClock(saved.savedAt),'saved');
    const persistenceLabel=storage.persisted===true?'瀏覽器已允許永久儲存':'瀏覽器可能自行清理資料，請保留下載的 HTML';
    setStatus('儲存完成：IndexedDB 已回讀驗證；已自動下載「'+download.filename+'」（'+(download.size/1048576).toFixed(1)+' MB，'+verification.assetCount+' 個內嵌素材）。'+persistenceLabel+'。');
    return{saved,verification,storage,backup,download};
  }catch(error){
    console.error('complete Sin Tower save failed',error);
    setSinTowerSaveBadge('完整儲存失敗','error');
    setStatus('完整儲存失敗：'+String(error?.message||error)+'。尚未清除任何既有瀏覽器存檔。');
    return null;
  }finally{
    sinTowerCompleteSaveInProgress=false;
    if(button){button.textContent=originalText;button.removeAttribute('aria-busy');}
    if(legacy)legacy.disabled=false;
  }
}

function bindSinTowerPersistenceLifecycle(){
  if(bindSinTowerPersistenceLifecycle.bound)return;bindSinTowerPersistenceLifecycle.bound=true;
  const flush=()=>{if(!STATE||sinTowerCompleteSaveInProgress)return;clearTimeout(saveTimer);clearTimeout(sinTowerRuntimeSaveTimer);void saveStateNow({updateBadge:false}).catch(()=>{});};
  document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='hidden')flush();});
  window.addEventListener('pagehide',flush);
}

function exportCurrentSceneHtml(){return saveAndExportSinTowerCompleteGame();}
function openDB(){
  return new Promise((resolve,reject)=>{
    const req = indexedDB.open(DB_NAME,1);
    req.onupgradeneeded = ()=>req.result.createObjectStore(STORE_NAME);
    req.onsuccess = ()=>resolve(req.result);
    req.onerror = ()=>reject(req.error);
  });
}

async function dbGet(key){
  const db = await openDB();
  return new Promise((resolve,reject)=>{
    const tx = db.transaction(STORE_NAME,'readonly');
    const req = tx.objectStore(STORE_NAME).get(key);
    req.onsuccess = ()=>resolve(req.result);
    req.onerror = ()=>reject(req.error);
  });
}

async function dbSet(key,value){
  const db = await openDB();
  return new Promise((resolve,reject)=>{
    const tx = db.transaction(STORE_NAME,'readwrite');
    const store = tx.objectStore(STORE_NAME);
    let requestError = null;
    const req = value === null ? store.delete(key) : store.put(value,key);
    req.onerror = ()=>{ requestError = req.error || new Error('IndexedDB request failed'); };
    tx.oncomplete = ()=>{ db.close?.(); resolve(true); };
    tx.onabort = ()=>{ const error = tx.error || requestError || new Error('IndexedDB transaction aborted'); db.close?.(); reject(error); };
    tx.onerror = ()=>{ requestError = tx.error || requestError; };
  });
}

function setStatus(text){ const el = $('status'); if(el) el.textContent = text; }

main().catch(err=>{
  console.error('Virtual Gallery init failed:', err);
  const el = document.getElementById('status');
  if(el) el.textContent = '初始化失敗：' + (err?.message || err);
});

</script>


</body></html>