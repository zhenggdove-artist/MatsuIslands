// main() is intentionally called at the end of the module after all const/let declarations are initialized.

async function main(){
  const initialPersistence = await resolveSinTowerInitialPersistence();
  STATE = initialPersistence.state;
  void prepareSinMonkHitSound();
  STATE = applySinTowerStaircaseSceneState(STATE);
  if(initialPersistence.runtimeState) await loadSinTowerRuntimeState(initialPersistence.runtimeState);
  else if(initialPersistence.loadStoredRuntime && !EXPORTED_GALLERY_VIEWER) await loadSinTowerRuntimeState();
  STATE.skyTexture = SIN_TOWER_BUNDLED_STAIR_BACKGROUND;
  void prepareSinPortalSmooth();
  if(!(SIN_TOWER_MONKS.useSpriteSequence && SIN_TOWER_MONKS.spriteFrames?.length)) await loadSinTowerBundledMonkSpriteSequence();
  if(EXPORTED_GALLERY_VIEWER) prepareExportedViewerDom();
  pushUndoState('initial');
  initThree();
  buildSkyBackground();
  buildAtmosphereEffect();
  applyScreenFx();
  buildStaticScene();
  buildRoom();
  buildSinTowerStaircase();
  buildSinTowerMonks();
  rebuildSinTowerEditorRuntime();
  placePlayerAtSinTowerSceneSpawn(getSinTowerActiveScene());
  rebuildSinTowerInfectionVisual();
  buildReferenceArchitecture();
  buildWaterBodies();
  buildArtworks();
  loadStatue();
  loadActor();
  if(!EXPORTED_GALLERY_VIEWER && !SIN_TOWER_PUBLISHED){
    buildEditor();
    setupFloatingWindows();
    applyObjectVisibilityLocks();
    renderObjectPanel();
  }
  if(SIN_TOWER_PUBLISHED)prepareSinPublishedGame();
  bindInput();
  if(!SIN_TOWER_PUBLISHED)bindSinTowerPersistenceLifecycle();
  if(EXPORTED_GALLERY_VIEWER) enterExportedViewerMode();
  else enterDefaultSinTowerPlayMode();
  setStatus(EXPORTED_GALLERY_VIEWER ? '已載入斷罪塔無限樓梯場景。' : '已進入遊玩模式：無限樓梯自動跑動；Shift+1 可直接測試新增腫瘤。');
  animate();
}

function createReferenceArchitectureMaterial(){
  return {color:'#e2eee6', roughness:.96, metalness:0, texture:null, repeat:[1,1]};
}

function createLightState(type='point', overrides={}){
  const base = {
    id: overrides.id || uid('light'),
    title: overrides.title || (type === 'directional' ? '平行光' : type === 'spot' ? '聚光燈' : '點光源'),
    type: ['point','directional','spot'].includes(type) ? type : 'point',
    color: validColor(overrides.color) ? overrides.color : '#ffffff',
    intensity: clamp(safeFinite(overrides.intensity, type === 'directional' ? 3 : 2), 0, 20),
    position: {x:safeFinite(overrides.position?.x,0), y:safeFinite(overrides.position?.y,4), z:safeFinite(overrides.position?.z,0)},
    target: {x:safeFinite(overrides.target?.x,0), y:safeFinite(overrides.target?.y,0), z:safeFinite(overrides.target?.z,0)},
    distance: clamp(safeFinite(overrides.distance, type === 'point' ? 26 : type === 'spot' ? 32 : 0), 0, 500),
    decay: clamp(safeFinite(overrides.decay,2), 0, 4),
    angle: clamp(safeFinite(overrides.angle,0.72), 0.05, 1.55),
    penumbra: clamp(safeFinite(overrides.penumbra,0.25), 0, 1),
    castShadow: !!overrides.castShadow,
    visible: overrides.visible !== false,
    locked: !!overrides.locked
  };
  return base;
}


function createDefaultLightBake(){
  return {enabled:false, useInPlayMode:true, brightness:1, stale:false, bakedAt:null, targetCount:0, version:LIGHT_BAKE_VERSION, mode:'shadowCache', data:{}};
}

function sanitizeLightBake(raw){
  const src = raw && typeof raw === 'object' ? raw : {};
  const data = {};
  if(src.data && typeof src.data === 'object'){
    for(const [key, value] of Object.entries(src.data)){
      if(!key || !value || typeof value !== 'object') continue;
      data[key] = {
        color: validColor(value.color) ? value.color : '#ffffff',
        intensity: clamp(safeFinite(value.intensity, 1), .02, 4)
      };
    }
  }
  return {
    enabled: src.enabled === true,
    useInPlayMode: src.useInPlayMode !== false,
    brightness: 1,
    stale: !!src.stale,
    bakedAt: typeof src.bakedAt === 'string' ? src.bakedAt : null,
    targetCount: clamp(safeFinite(src.targetCount, Object.keys(data).length), 0, 50000),
    version: LIGHT_BAKE_VERSION,
    mode: 'shadowCache',
    data
  };
}

function markLightingBakeStale(reason='light-change'){
  if(!STATE?.lightBake?.enabled) return;
  STATE.lightBake.stale = true;
  disableBakedLightingRuntime();
  syncLightBakeEditor?.();
}

function createReferenceArchitectureLightSystem(){
  return {
    enabled:true,
    ambient:{color:'#dff7ef', intensity:.62},
    hemisphere:{skyColor:'#f2fff8', groundColor:'#223631', intensity:2.15},
    lights:[
      createLightState('directional',{id:'light_key', title:'主平行光', color:'#ffffff', intensity:3.15, position:{x:-8,y:13,z:8}, target:{x:0,y:2,z:0}, castShadow:true}),
      createLightState('point',{id:'light_fill', title:'補光點光源', color:'#dfffee', intensity:2.4, position:{x:6,y:4.8,z:7}, distance:34, decay:2}),
      createLightState('point',{id:'light_water_glow', title:'水面點光源', color:'#8fffe8', intensity:1.65, position:{x:7.5,y:1.1,z:5.2}, distance:22, decay:2})
    ]
  };
}

function sanitizeReferenceArchitectureMaterial(raw){
  const def = createReferenceArchitectureMaterial();
  const cfg = {...def, ...(raw||{})};
  cfg.color = validColor(cfg.color) ? cfg.color : def.color;
  cfg.roughness = clamp(safeFinite(cfg.roughness,def.roughness), 0, 1);
  cfg.metalness = clamp(safeFinite(cfg.metalness,def.metalness), 0, 1);
  cfg.texture = (typeof cfg.texture === 'string' && cfg.texture.startsWith('data:image')) ? cfg.texture : null;
  const rep = Array.isArray(cfg.repeat) ? cfg.repeat : def.repeat;
  cfg.repeat = [clamp(safeFinite(rep[0],1), .2, 24), clamp(safeFinite(rep[1],1), .2, 24)];
  return cfg;
}

function sanitizeLightSystem(raw){
  const def = createReferenceArchitectureLightSystem();
  const src = raw && typeof raw === 'object' ? raw : {};
  const ambient = src.ambient || {};
  const hemisphere = src.hemisphere || {};
  return {
    enabled: src.enabled !== false,
    ambient:{color:validColor(ambient.color) ? ambient.color : def.ambient.color, intensity:clamp(safeFinite(ambient.intensity, def.ambient.intensity),0,8)},
    hemisphere:{skyColor:validColor(hemisphere.skyColor) ? hemisphere.skyColor : def.hemisphere.skyColor, groundColor:validColor(hemisphere.groundColor) ? hemisphere.groundColor : def.hemisphere.groundColor, intensity:clamp(safeFinite(hemisphere.intensity, def.hemisphere.intensity),0,8)},
    lights:Array.isArray(src.lights) ? src.lights.map(item=>createLightState(item?.type || 'point', item || {})) : def.lights.map(item=>createLightState(item.type, item))
  };
}

function sanitizeChiselHoles(raw, referenceMode=false){
  if(!Array.isArray(raw)) return [];
  const out = [];
  for(const item of raw){
    if(!item || typeof item !== 'object') continue;
    const type = ['rect','circle','triangle','pentagon','hexagon','octagon','arch','roundRect'].includes(item.type) ? item.type : 'rect';
    const h = {
      id: item.id || uid('hole'),
      type,
      x: clamp(safeFinite(item.x,0), -500, 500),
      // y is intentionally allowed to go below 0 or above the panel height.
      // A chisel volume may overlap an object's edge; in that case the edge must be removed,
      // not clamped inward into a fake enclosed hole.
      y: clamp(safeFinite(item.y,0), -500, 500),
      w: clamp(safeFinite(item.w,1.2), .05, 500),
      h: clamp(safeFinite(item.h,1.2), .05, 500),
      r: clamp(safeFinite(item.r, .12), 0, 1),
      depth: clamp(safeFinite(item.depth, 2), .001, 500),
      side: safeFinite(item.side, 1) < 0 ? -1 : 1,
      targetType: item.targetType === 'box' ? 'box' : 'wall',
      axis: item.axis === 'x' ? 'x' : 'z'
    };
    if(referenceMode){
      if(typeof item.panelName !== 'string' || !item.panelName) continue;
      h.panelName = item.panelName;
    }
    out.push(h);
  }
  return out.slice(-240);
}

function isPolygonChiselType(type){
  return ['triangle','pentagon','hexagon','octagon'].includes(type);
}

function polygonSidesForChiselType(type){
  if(type === 'triangle') return 3;
  if(type === 'pentagon') return 5;
  if(type === 'hexagon') return 6;
  if(type === 'octagon') return 8;
  return 0;
}

function chiselHoleCutsThrough(hole, thickness){
  if(!hole || !Number.isFinite(Number(hole.depth))) return true;
  return Number(hole.depth) >= Math.max(.001, safeFinite(thickness, .18)) - .004;
}

function chiselHoleSide(hole){
  return safeFinite(hole?.side, 1) < 0 ? -1 : 1;
}

function chiselHolesForCutting(holes=[], thickness=.18){
  return (Array.isArray(holes) ? holes : []).filter(h=>chiselHoleCutsThrough(h, thickness));
}

function chiselHolesForFace(holes=[], thickness=.18, side=1){
  const s = side < 0 ? -1 : 1;
  return (Array.isArray(holes) ? holes : []).filter(h=>chiselHoleCutsThrough(h, thickness) || chiselHoleSide(h) === s);
}

function chiselHolesForWallSubtraction(holes=[]){
  // Full cut-through holes and finite-depth recesses both remove the visible front/back face.
  // Finite-depth recesses are closed again with depth caps, so they read as true gouges rather than pushed-out decals.
  return Array.isArray(holes) ? holes : [];
}

function chiselShapeToHoleType(shape){
  if(shape === 'circle') return 'circle';
  if(shape === 'triangle') return 'triangle';
  if(shape === 'pentagon') return 'pentagon';
  if(shape === 'hexagon') return 'hexagon';
  if(shape === 'octagon') return 'octagon';
  if(shape === 'arch') return 'arch';
  return 'rect';
}

function chiselHoleLabel(h){
  if(!h) return '';
  if(h.type === 'circle') return '圓形';
  if(h.type === 'triangle') return '三角形';
  if(h.type === 'pentagon') return '五邊形';
  if(h.type === 'hexagon') return '六邊形';
  if(h.type === 'octagon') return '八邊形';
  if(h.type === 'arch') return '拱門';
  if(h.type === 'roundRect') return '圓角矩形';
  return '矩形';
}


function createDefaultMobileControlsLayout(){
  return {
    landscape:{movePad:{x:6.2,y:90,w:7.4,h:13.1},jump:{x:94,y:92,w:4.7,h:8.3}},
    portrait:{movePad:{x:15,y:90,w:23.2,h:13.1},jump:{x:90,y:92,w:14.6,h:8.3}}
  };
}

function sanitizeMobileControlsLayout(raw){
  const defaults=createDefaultMobileControlsLayout(),result={};
  for(const orientation of ['landscape','portrait']){
    result[orientation]={};
    for(const key of ['movePad','jump']){
      const input=raw?.[orientation]?.[key]||{},base=defaults[orientation][key];
      const w=clamp(safeFinite(input.w,base.w),1,100),h=clamp(safeFinite(input.h,base.h),1,100);
      result[orientation][key]={x:clamp(safeFinite(input.x,base.x),w/2,100-w/2),y:clamp(safeFinite(input.y,base.y),h/2,100-h/2),w,h};
    }
  }
  return result;
}

function createDefaultPortalPasswordFx(){
  return {clarity:.82,brightness:1,contrast:1.15,ditherScale:1,textScale:1.55,textWeight:900,slotDitherStrength:1,slotDitherDetail:.94,slotBrightness:1.1,slotContrast:1.5,slotTextOffsetX:0,slotTextOffsetY:-10};
}

function sanitizePortalPasswordFx(raw){
  const base=createDefaultPortalPasswordFx(),value=raw&&typeof raw==='object'?raw:{};
  return {clarity:clamp(safeFinite(value.clarity,base.clarity),0,1),brightness:clamp(safeFinite(value.brightness,base.brightness),.5,1.6),contrast:clamp(safeFinite(value.contrast,base.contrast),.5,2),ditherScale:clamp(Math.round(safeFinite(value.ditherScale,base.ditherScale)),1,8),textScale:clamp(safeFinite(value.textScale,base.textScale),.5,3),textWeight:clamp(Math.round(safeFinite(value.textWeight,base.textWeight)/100)*100,400,900),slotDitherStrength:clamp(safeFinite(value.slotDitherStrength,base.slotDitherStrength),0,1),slotDitherDetail:clamp(safeFinite(value.slotDitherDetail,base.slotDitherDetail),.01,1),slotBrightness:clamp(safeFinite(value.slotBrightness,base.slotBrightness),.5,2.5),slotContrast:clamp(safeFinite(value.slotContrast,base.slotContrast),.5,3),slotTextOffsetX:clamp(safeFinite(value.slotTextOffsetX,base.slotTextOffsetX),-100,100),slotTextOffsetY:clamp(safeFinite(value.slotTextOffsetY,base.slotTextOffsetY),-100,100)};
}

function createDefaultPortalPasswordLayout(){
  return {
    landscape:{frame:{x:50,y:39,w:32,h:72},slots:{x:50,y:83,w:29,h:10}},
    portrait:{frame:{x:50,y:36,w:88,h:63},slots:{x:50,y:75,w:72,h:9}}
  };
}

function sanitizePortalPasswordLayout(raw){
  const defaults=createDefaultPortalPasswordLayout(),result={};
  for(const orientation of ['landscape','portrait']){
    const sourceLayout=raw?.[orientation]||{},fallback=defaults[orientation];
    result[orientation]={};
    for(const key of ['frame','slots']){
      const input=sourceLayout[key]||{},base=fallback[key];
      const minW=key==='frame'?8:2,minH=key==='frame'?10:1;
      const w=clamp(safeFinite(input.w,base.w),minW,100),h=clamp(safeFinite(input.h,base.h),minH,100);
      result[orientation][key]={
        x:clamp(safeFinite(input.x,base.x),w/2,100-w/2),
        y:clamp(safeFinite(input.y,base.y),h/2,100-h/2),
        w,h
      };
    }
  }
  return result;
}

