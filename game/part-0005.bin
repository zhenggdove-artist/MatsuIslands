" alt="" aria-hidden="true"><b><span class="sin-portal-password-character-glyph">B</span></b></span><span class="sin-portal-password-slot-preview"><img class="sin-portal-password-slot-preview-art" src="data:image/png;base64," alt="" aria-hidden="true"><b><span class="sin-portal-password-character-glyph">2</span></b></span><span class="sin-portal-password-slot-preview"><img class="sin-portal-password-slot-preview-art" src="data:image/png;base64," alt="" aria-hidden="true"><b><span class="sin-portal-password-character-glyph">F</span></b></span><span class="sin-portal-password-slot-preview selected"><img class="sin-portal-password-slot-preview-art" src="data:image/png;base64," alt="" aria-hidden="true"><b><span class="sin-portal-password-character-glyph">7</span></b></span></div>
      <details class="sin-pro-control-group" open="">
        <summary>四格欄位單色點陣與字符對齊</summary>
        <div class="sin-pro-control-group-body">
          <label class="sin-pro-field"><span>點陣強度</span><span class="sin-pro-range-control"><input id="sinPerfPortalSlotDitherStrength" type="range" min="0" max="100" step="1" value="100"><output id="sinPerfPortalSlotDitherStrengthValue">100%</output></span></label>
          <label class="sin-pro-field"><span>點陣細緻度</span><span class="sin-pro-range-control"><input id="sinPerfPortalSlotDitherDetail" type="range" min="1" max="100" step="1" value="94"><output id="sinPerfPortalSlotDitherDetailValue">94%</output></span></label>
          <label class="sin-pro-field"><span>欄位亮度</span><span class="sin-pro-range-control"><input id="sinPerfPortalSlotBrightness" type="range" min="50" max="250" step="1" value="110"><output id="sinPerfPortalSlotBrightnessValue">110%</output></span></label>
          <label class="sin-pro-field"><span>欄位對比</span><span class="sin-pro-range-control"><input id="sinPerfPortalSlotContrast" type="range" min="50" max="300" step="1" value="150"><output id="sinPerfPortalSlotContrastValue">150%</output></span></label>
          <label class="sin-pro-field"><span>數字水平位置</span><span class="sin-pro-range-control"><input id="sinPerfPortalSlotTextOffsetX" type="range" min="-100" max="100" step="1" value="0"><output id="sinPerfPortalSlotTextOffsetXValue">0%</output></span></label>
          <label class="sin-pro-field"><span>數字垂直位置</span><span class="sin-pro-range-control"><input id="sinPerfPortalSlotTextOffsetY" type="range" min="-100" max="100" step="1" value="-10"><output id="sinPerfPortalSlotTextOffsetYValue">-19%</output></span></label>
          <button id="sinPerfResetPortalSlotFx" type="button">還原四格點陣與字符位置</button>
          <p class="sin-pro-muted">細緻度越高，點陣顆粒越小。數字位置只會移動 B／2／F／7 字符，黑色圓底與四個圖片框都不會移動。</p>
        </div>
      </details>
      <details class="sin-pro-control-group" open="">
        <summary>密碼畫面清晰度</summary>
        <div class="sin-pro-control-group-body">
          <label class="sin-pro-field"><span>圖像清晰度</span><span class="sin-pro-range-control"><input id="sinPerfPortalClarity" type="range" min="0" max="100" step="1" value="82"><output id="sinPerfPortalClarityValue">23%</output></span></label>
          <label class="sin-pro-field"><span>圖像亮度</span><span class="sin-pro-range-control"><input id="sinPerfPortalBrightness" type="range" min="50" max="160" step="1" value="100"><output id="sinPerfPortalBrightnessValue">51%</output></span></label>
          <label class="sin-pro-field"><span>圖像對比</span><span class="sin-pro-range-control"><input id="sinPerfPortalContrast" type="range" min="50" max="200" step="1" value="115"><output id="sinPerfPortalContrastValue">188%</output></span></label>
          <label class="sin-pro-field"><span>點陣尺寸</span><span class="sin-pro-range-control"><input id="sinPerfPortalDitherScale" type="range" min="1" max="8" step="1" value="1"><output id="sinPerfPortalDitherScaleValue">4×</output></span></label>
          <label class="sin-pro-field"><span>密碼字大小</span><span class="sin-pro-range-control"><input id="sinPerfPortalTextScale" type="range" min="50" max="300" step="5" value="155"><output id="sinPerfPortalTextScaleValue">110%</output></span></label>
          <label class="sin-pro-field"><span>密碼字粗細</span><span class="sin-pro-range-control"><input id="sinPerfPortalTextWeight" type="range" min="400" max="900" step="100" value="900"><output id="sinPerfPortalTextWeightValue">700</output></span></label>
          <button id="sinPerfResetPortalFx" type="button">還原密碼清晰度</button>
          <p class="sin-pro-muted">清晰度越高會保留越多原圖階調；點陣尺寸越大顆粒越粗。調整時上方 GIF 與 B2F7 會即時預覽。</p>
        </div>
      </details>
      <button id="sinPerfEditPortalPasswordLayout" type="button">拖拉主畫面與四格尺寸位置</button>
      <div class="sin-pro-actions"><button id="sinPerfResetPortalPasswordGif" type="button">還原主畫面 GIF</button><button id="sinPerfResetPortalPasswordSlotArt" type="button">還原欄位圖片</button></div>
      <p class="sin-pro-muted">主畫面與四格欄位可分別拖曳；四格始終作為一組移動。四角等比例縮放，四邊中點可自由改變寬高。</p>
      <button id="sinPerfEditMobileControlsLayout" type="button">編輯手機浮動按鍵版面</button>
      
      
      
      
      <div class="sin-pro-actions">
        <button id="sinPerfApply" type="button" class="ok">套用效能上限</button>
        <button id="sinPerfClearHeavy" type="button" class="danger">清除已儲存 PNG</button>
      </div>
    </section>
  </div>
 <div class="sin-pro-resize-handle" title="拖曳調整編輯器大小" aria-label="拖曳調整編輯器大小"></div></aside>
<div id="sinStonePickPanel" class="sin-stone-pick-panel edit-ui" aria-live="polite">
  <div class="sin-stone-pick-title">石頭材質選取</div>
  <div id="sinStonePickSelected" class="sin-stone-pick-selected">尚未選取石頭</div>
  <label>個別材質<input id="sinPlayStoneTexture" type="file" accept="image/*" disabled="" data-reset-on-open="1"></label>
  <div id="sinPlayStoneTextureState" class="sin-pro-file-state">尚未選取石頭</div>
  <img id="sinPlayStoneTexturePreview" class="sin-pro-file-preview" alt="遊玩模式石材質預覽">
  <button id="sinStonePickExit" type="button">完成選取，返回遊玩</button>
  <div class="sin-stone-pick-help">Shift+0 開啟／關閉。游標模式下點擊石頭後，材質只會套用到目前選取的石頭。</div>
</div>

<aside id="editor" class="edit-ui floating-window is-minimized" data-window-title="編輯面板" style="inset: 49.3333px auto auto 317.896px; width: 408px; height: 550px; z-index: 103;" data-floating-ready="1"><div class="window-header"><span class="window-title">編輯面板</span><button class="window-minimize" type="button" title="最小化">+</button></div><div class="window-body">
  <h1>Virtual Gallery Editor｜匯入作品／材質／牆面編輯</h1>
  <div class="row">
    <button id="saveNow" class="ok">儲存完整遊戲（自動下載）</button>
  </div>
  <button id="exportJson" type="button" hidden="">下載進階 JSON 備份</button>
  <button id="exportHtml" type="button" hidden="">舊版 HTML 匯出</button>
  <button id="resetState" class="danger">清除儲存狀態並回到預設</button>
  <p class="note">主要儲存按鈕位於「斷罪塔編輯器最上方右側」。按一次會等待 IndexedDB 完整提交、回讀驗證，接著自動下載含全部設定與匯入素材的可編輯 HTML；平時改動仍會自動保存。</p>

  <h2>空間／選取物件尺寸</h2>
  <label>空間底色<input id="spaceBgColor" type="color"></label>
  <label>天空增值色<input id="skyTintColor" type="color"></label>
  <label>天空增值強度<input id="skyTintStrength" type="range" min="0" max="1" step="0.01"></label>
  <div class="row">
    <button id="importSkyTexture">匯入天空全景圖</button>
    <button id="clearSkyTexture">清除天空圖</button>
  </div>
  <div class="row">
    <button id="buildReferenceArchitecture" class="ok">建立十字空間</button>
    <button id="toggleReferenceArchitecture">隱藏／顯示十字空間牆面</button>
  </div>
  <p class="small">「建立參考圖建築」會生成白綠色拱廊、水池、立柱、圓拱開口與右側亮色水底平台。天空預設使用本次附圖。匯入圖片後會包覆成全景背景；天空增值色會以 multiply 方式疊加在原貼圖上。</p>

  <h2>參考圖建築材質</h2>
  <label>建築顏色<input id="referenceArchitectureColor" type="color"></label>
  <label>建築粗糙度<input id="referenceArchitectureRoughness" type="range" min="0" max="1" step="0.01"></label>
  <label>建築金屬感<input id="referenceArchitectureMetalness" type="range" min="0" max="1" step="0.01"></label>
  <label>建築貼圖重複X<input id="referenceArchitectureRepeatX" type="range" min="0.2" max="24" step="0.1"></label>
  <label>建築貼圖重複Y<input id="referenceArchitectureRepeatY" type="range" min="0.2" max="24" step="0.1"></label>
  <div class="row">
    <button id="importReferenceArchitectureTexture">匯入建築材質</button>
    <button id="clearReferenceArchitectureTexture">清除建築材質</button>
  </div>
  <p class="small">此區可一次替整組參考圖建築匯入皮膚材質。匯入後會套用到拱牆、方柱、橫樑與拱框；亮光平面維持原本發光效果。若要讓建築產生凹凸，請在物件視窗選取「參考圖建築」，再使用下方「表面凹凸起伏」控制。</p>
  <h2>空氣煙霧／灰塵粒子</h2>
  <label class="check">啟用煙霧灰塵<input id="atmosphereEnabled" type="checkbox"></label>
  <label>煙霧顏色<input id="atmosphereColor" type="color"></label>
  <label>煙霧強度<input id="atmosphereIntensity" type="range" min="0" max="1" step="0.01"></label>
  <label>煙霧透明度<input id="atmosphereOpacity" type="range" min="0" max="1" step="0.01"></label>
  <label>煙霧層次感<input id="atmosphereLayers" type="range" min="0" max="1" step="0.01"></label>
  <p class="small">此效果使用距離霧、程序化霧體與細微灰塵粒子。透明度控制整體霧體可見度；層次感越高，不規則煙霧塊面會疊加更多尺度。</p>

  <h2>畫面濾鏡</h2>
  <label>遊戲畫面方向<select id="screenGameOrientation"><option value="landscape">橫式／自動填滿</option><option value="portrait">手機直式 9:16</option></select></label>
  <label class="check">啟用濾鏡<input id="screenFxEnabled" type="checkbox"></label>
  <label>濾鏡模式<select id="screenFxPreset">
    <option value="none">無</option>
    <option value="monopixel">單色點陣</option>
    <option value="vhs">VHS</option>
    <option value="dreamcore">夢核</option>
    <option value="weirdcore">怪核</option>
  </select></label>
  <label>總強度<input id="screenFxIntensity" type="range" min="0" max="1" step="0.01"></label>
  <label>雜訊顆粒<input id="screenFxNoise" type="range" min="0" max="1" step="0.01"></label>
  <label class="check">錄影清晰模式<input id="screenFxRecordingFriendly" type="checkbox" checked=""></label>
  <label>點陣細緻度<input id="screenFxMonoPixelSize" type="range" min="1" max="50" step="1" value="50"></label>
  <p class="small">建議使用「高畫質壓縮 WebM」：以 VP9／VP8 保留目前所見畫面與 60 FPS 時間軸，檔案約為舊 PNG-AVI 的數十分之一，也不受 AVI 2 GB 上限限制。PNG-AVI 僅保留給極短的逐格無損測試。</p>
  <label>錄影格式<select id="screenFxCaptureFormat"><option value="webm" selected="">高畫質壓縮 WebM（推薦／長時間）</option><option value="avi">PNG-AVI（僅限極短無損測試）</option></select></label>
  <label>無損影格率<select id="screenFxCaptureLosslessFps"><option value="24">24 FPS</option><option value="30">30 FPS</option><option value="60" selected="">60 FPS</option></select></label>
  <label>WebM 畫質<select id="screenFxCaptureBitrate"><option value="20000000">平衡 20 Mbps（約 143 MB／分鐘）</option><option value="40000000" selected="">高畫質 40 Mbps（約 286 MB／分鐘）</option><option value="80000000">極高畫質 80 Mbps（約 572 MB／分鐘）</option></select></label><label>直式錄影畫素量<select id="screenFxPortraitCapturePixels"><option value="1">原始 1 倍</option><option value="3">精細：整數 2×（4 倍畫素）</option><option value="5" selected="">超精細：整數 3×（9 倍畫素／抗干擾）</option></select></label>
  <label class="check">逐格關鍵幀（檔案會暴增，只供短測試）<input id="screenFxCaptureAllIntra" type="checkbox"></label>
  <div class="row"><button id="screenFxCaptureStart" type="button" class="ok">開始所見即所得錄影</button><button id="screenFxCaptureStop" type="button" disabled="">停止並下載</button></div>
  <p id="screenFxCaptureStatus" class="small">建議使用高畫質壓縮 WebM 並在系統視窗選取目前遊戲分頁；會以瀏覽器的真實影格時間錄製，不會改動遊戲畫面。</p>
  <label>掃描線<input id="screenFxScanlines" type="range" min="0" max="1" step="0.01"></label>
  <label>色差偏移<input id="screenFxChromatic" type="range" min="0" max="1" step="0.01"></label>
  <label>畫面扭曲<input id="screenFxWarp" type="range" min="0" max="1" step="0.01"></label>
  <label>柔光暈染<input id="screenFxGlow" type="range" min="0" max="1" step="0.01"></label>
  <label>暗角<input id="screenFxVignette" type="range" min="0" max="1" step="0.01"></label>
  <label>飽和度<input id="screenFxSaturation" type="range" min="0" max="3" step="0.01"></label>
  <label>對比<input id="screenFxContrast" type="range" min="0.2" max="2.6" step="0.01"></label>
  <label>亮度<input id="screenFxBrightness" type="range" min="0.2" max="2" step="0.01"></label>
  <label>模糊<input id="screenFxBlur" type="range" min="0" max="4" step="0.01"></label>
  <label>色相偏移<input id="screenFxHue" type="range" min="-180" max="180" step="1"></label>
  <label>點陣亮部顏色<input id="screenFxPaperColor" type="color" value="#f4d66f"></label>
  <label>點陣暗部顏色<input id="screenFxInkColor" type="color" value="#14263d"></label>
  <label class="check">主角保持彩色<input id="screenFxPlayerColor" type="checkbox"></label>
  <label class="check">腫瘤保持彩色<input id="screenFxTumorColor" type="checkbox"></label>
  <label class="check">觸手保持彩色<input id="screenFxTentacleColor" type="checkbox"></label>
  <label class="check">眼睛保持彩色<input id="screenFxEyeColor" type="checkbox"></label>
  <p class="small">可自由選擇單色點陣的亮、暗兩色，也可讓主角、腫瘤、觸手或眼睛個別保留原色。只在有勾選彩色部位時才增加一次輕量局部渲染。</p>
  <label>選取物件<input id="selectedObjectName" type="text" value="無" readonly=""></label>
  <label hidden="" data-removed-position-field="">位置Z<input id="objectZ" type="number" step="0.01"></label>
  <label>尺寸X／寬<input id="objectSizeX" type="number" min="0.02" max="500" step="0.01" disabled=""></label>
  <label>尺寸Y／高<input id="objectSizeY" type="number" min="0.02" max="500" step="0.01" disabled=""></label>
  <label>尺寸Z／深<input id="objectSizeZ" type="number" min="0.02" max="500" step="0.01" disabled=""></label>
  <label>選取物顏色<input id="objectColor" type="color" disabled=""></label>
  <button id="applyObjectValues" class="ok" disabled="">套用選取物數值</button>
  <p class="small">尺寸輸入時只會暫存；按下「套用選取物數值」或在欄位內按 Enter 後才會真正更新物件。位置欄位已移除。</p>
  <div class="row">
    <button id="addFloorTile">新增地板塊</button>
    <button id="deleteSelectedFloorTile" class="danger" disabled="">刪除地板塊</button>
  </div>
  <p class="small">按 ESC 顯示游標後，可直接點選原始牆、地板、自建牆或新增地板塊。選取後用上方數值欄調整尺寸與顏色。新增地板塊可拼接不規則地面。</p>

  <h2>表面凹凸起伏</h2>
  <label>表面類型<select id="groundReliefPreset" disabled="">
    <option value="flat">平坦</option>
    <option value="cementSoft">細緻水泥</option>
    <option value="cementRough">粗糙水泥</option>
    <option value="sand">粗糙沙地</option>
    <option value="grass">草地起伏</option>
  </select></label>
  <label>凹凸程度<input id="groundReliefAmount" type="range" min="0" max="1" step="0.01" disabled=""></label>
  <label>變化程度<input id="groundReliefVariation" type="range" min="0" max="1" step="0.01" disabled=""></label>
  <p class="small">此設定只作用於目前被點選並呈半透明的物件：牆面、天花板、地板或地板塊。凹凸程度控制最高與最低位移；變化程度控制隨機分佈、密集凹凸與稀疏凹凸的位置差異，不再使用規律波紋排列。凹凸只影響表面視覺，不改變角色碰撞。</p>

  <h2>地板物理材質／沙地</h2>
  <label>物理材質<select id="floorPhysicsMaterial" disabled="">
    <option value="solid">一般硬質地板</option>
    <option value="sand">沙地</option>
  </select></label>
  <label>沙子顏色<input id="sandColor" type="color" value="#c9ad79" disabled=""></label>
  <label>沙子粗細<input id="sandGrain" type="range" min="0" max="1" step="0.01" value="0.42" disabled=""></label>
  <label>行走反應<input id="sandReaction" type="range" min="0" max="1" step="0.01" value="0.7" disabled=""></label>
  <p class="small">只作用於目前選取的主地板或地板塊。切成沙地後會建立真正可變形的沙面網格；堆疊工具與角色行走會寫入沙面高度資料。</p>

  <h2>選取物件材質</h2>
  <label hidden="" data-old-surface-select="">指定面<select id="surfaceSelect"><option value="front">前牆／北牆／主作品牆</option><option value="back">後牆／南牆／入口牆</option><option value="left">左牆／西牆</option><option value="right">右牆／東牆</option><option value="floor">地板</option><option value="ceiling">天花板</option></select></label>
  <label>顏色<input id="surfaceColor" type="color" disabled=""></label>
  <label>粗糙度<input id="surfaceRoughness" type="range" min="0" max="1" step="0.01" disabled=""></label>
  <label>金屬感<input id="surfaceMetalness" type="range" min="0" max="1" step="0.01" disabled=""></label>
  <label>貼圖重複X<input id="surfaceRepeatX" type="range" min="1" max="12" step="0.1" disabled=""></label>
  <label>貼圖重複Y<input id="surfaceRepeatY" type="range" min="1" max="12" step="0.1" disabled=""></label>
  <div class="row">
    <button id="importSurfaceTexture" disabled="">匯入選取物材質圖</button>
    <button id="clearSurfaceTexture" disabled="">清除選取物貼圖</button>
  </div>
  <div class="row">
    <button id="deleteSelectedSurface" class="danger" disabled="">刪除選取物件</button>
    <button id="restoreRoomWalls">恢復原始牆面／天花板</button>
  </div>
  <p class="small">材質設定直接作用於目前被點選、呈半透明的物件。不再使用下拉選單指定牆面。</p>

  <h2>作品</h2>
  <button id="importArtwork">匯入作品 PNG/JPG/WEBP/FBX/GLB</button>
  <label>作品<select id="artSelect"></select></label>
  <select id="artWall" data-force-hidden="" aria-hidden="true" tabindex="-1"><option value="front">前牆／北牆／主作品牆</option><option value="back">後牆／南牆／入口牆</option><option value="left">左牆／西牆</option><option value="right">右牆／東牆</option></select>
  <input id="artOffset" type="hidden" value="0">
  <label>位置X<input id="artX" type="number" min="-500" max="500" step="0.01"></label>
  <label>位置Y<input id="artY" type="number" min="-500" max="500" step="0.01"></label>
  <label>位置Z<input id="artZ" type="number" min="-500" max="500" step="0.01"></label>
  <label>寬度／Scale X<input id="artW" type="number" min="0.01" max="500" step="0.01"></label>
  <label>高度／Scale Y<input id="artH" type="number" min="0.01" max="500" step="0.01"></label>
  <label>深度／Scale Z<input id="artD" type="number" min="0.01" max="500" step="0.01"></label>
  <label>厚度<input id="artDepth" type="number" min="0.01" max="500" step="0.005"></label>
  <label>離牆距離<input id="artGap" type="number" min="0.001" max="500" step="0.001"></label>
  <label class="check">與最接近牆面平行貼合<input id="artSnapToWall" type="checkbox"></label>
  <label class="check" data-image-only-art-control="" hidden="">雙面作品<input id="artDoubleSided" type="checkbox"></label>
  <label data-image-only-art-control="" hidden="">背面顏色<input id="artBackColor" type="color"></label>
  <label data-image-only-art-control="" hidden="">背面受光程度<input id="artBackLight" type="range" min="0" max="1" step="0.01"></label>
  <label data-image-only-art-control="" hidden="">厚度增值色<input id="artEdgeTintColor" type="color"></label>
  <label data-image-only-art-control="" hidden="">增值強度<input id="artEdgeTintStrength" type="range" min="0" max="1" step="0.01"></label>
  <button id="applyArtValues" class="ok" disabled="">套用作品數值（Enter）</button>
  <div class="row">
    <button id="frameArtwork" disabled="">移動角色到作品前</button>
    <button id="deleteArtwork" class="danger" disabled="">刪除作品</button>
  </div>
  <p class="small">匯入圖片會作為平面／厚度作品；匯入 FBX 或 GLB 會作為可旋轉的立體雕塑作品。勾選牆面吸附後，作品會貼合並平行於最近的牆面。</p>

  <h2>水體／容器</h2>
  <div class="row">
    <button id="addWaterBodyAhead" data-bound="1">角色前方新增水體</button>
    <button id="deleteSelectedWaterBody" class="danger" data-bound="1" disabled="">刪除水體</button>
  </div>
  <label>水體<select id="waterSelect" data-bound="1"></select></label>
  <label>容器形狀<select id="waterShape" data-bound="1" disabled="">
    <option value="rect">矩形池／河道</option>
    <option value="cylinder">圓形碗／杯</option>
    <option value="oval">橢圓池</option>
  </select></label>
  <label>位置X<input id="waterX" type="number" min="-500" max="500" step="0.01" data-bound="1" disabled=""></label>
  <label>位置Y<input id="waterY" type="number" min="-500" max="500" step="0.01" data-bound="1" disabled=""></label>
  <label>位置Z<input id="waterZ" type="number" min="-500" max="500" step="0.01" data-bound="1" disabled=""></label>
  <label>長度／寬X<input id="waterW" type="number" min="0.2" max="500" step="0.01" data-bound="1" disabled=""></label>
  <label>寬度／深Z<input id="waterD" type="number" min="0.2" max="500" step="0.01" data-bound="1" disabled=""></label>
  <label>容器高度<input id="waterH" type="number" min="0.05" max="500" step="0.01" data-bound="1" disabled=""></label>
  <label>水位<input id="waterLevel" type="range" min="0.05" max="0.98" step="0.01" data-bound="1" disabled=""></label>
  <label>水色<input id="waterColor" type="color" data-bound="1" disabled=""></label>
  <label>水透明度<input id="waterOpacity" type="range" min="0.05" max="0.95" step="0.01" data-bound="1" disabled=""></label>
  <label>晃動強度<input id="waterWave" type="range" min="0" max="1" step="0.01" data-bound="1" disabled=""></label>
  <label>網格焦散強度<input id="waterCausticStrength" type="range" min="0" max="3" step="0.01" data-bound="1" disabled=""></label>
  <label>干涉波強度<input id="waterInterferenceStrength" type="range" min="0" max="3" step="0.01" data-bound="1" disabled=""></label>
  <label>角色擾動強度<input id="waterMotionDistortion" type="range" min="0" max="3" step="0.01" data-bound="1" disabled=""></label>
  <label>濺水強度<input id="waterSplash" type="range" min="0" max="1" step="0.01" data-bound="1" disabled=""></label>
  <label>容器顏色<input id="waterContainerColor" type="color" data-bound="1" disabled=""></label>
  <label>容器貼圖重複X<input id="waterContainerRepeatX" type="range" min="0.2" max="24" step="0.1" data-bound="1" disabled=""></label>
  <label>容器貼圖重複Y<input id="waterContainerRepeatY" type="range" min="0.2" max="24" step="0.1" data-bound="1" disabled=""></label>
  <div class="row">
    <button id="importWaterContainerTexture" data-bound="1" disabled="">匯入容器材質</button>
    <button id="clearWaterContainerTexture" data-bound="1" disabled="">清除容器貼圖</button>
  </div>
  <button id="applyWaterValues" class="ok" data-bound="1" disabled="">套用水體數值（Enter）</button>
  <p class="small">水體會被包在上方開放的容器中。容器可另外匯入材質貼圖。角色走進水面範圍時，水面會產生波紋與水花；深水中視角向下並前進時可向下潛水。</p>

  <h2>角色</h2>
  <label>角色等比縮放<input id="actorScale" type="range" min="0.1" max="5" step="0.01"></label>
  <label>角色高度Y<input id="actorYOffset" type="range" min="-1.2" max="20" step="0.01"></label>
  <label>模型朝向偏移<input id="actorYawOffset" type="range" min="-180" max="180" step="1"></label>
  <label>跑步速度<input id="playerSpeed" type="range" min="1" max="12" step="0.1"></label>
  <label>跳躍力倍數<input id="playerJumpPower" type="range" min="0.1" max="5" step="0.05"></label>
  <div class="row3">
    <button id="idleBtn">Idle</button>
    <button id="walkBtn">Run</button>
    <button id="jumpBtn">Jump</button>
  </div>

  <h2>走到現場增刪牆壁</h2>
  <div class="row">
    <button id="addWallAhead">角色前方新增直牆</button>
    <button id="addCurvedWallAhead">角色前方新增曲面牆</button>
  </div>
  <button id="deleteWallAhead" class="danger">刪除前方牆</button>
  <label>自建牆<select id="wallSelect"><option value="">無</option></select></label>
  <label>牆面型態<select id="wallShape" disabled="">
    <option value="straight">直牆</option>
    <option value="curved">曲面牆</option>
  </select></label>
  <label>曲率<input id="wallCurveAmount" type="range" min="0" max="1" step="0.01" disabled=""></label>
  <label>彎曲方向<select id="wallCurveDirection" disabled="">
    <option value="front">向前彎</option>
    <option value="back">向後彎</option>
  </select></label>
  <label hidden="" data-removed-wall-position-field="">X<input id="wallX" type="range" min="-500" max="500" step="0.01"></label>
  <label hidden="" data-removed-wall-position-field="">Z<input id="wallZ" type="range" min="-500" max="500" step="0.01"></label>
  <label>寬度<input id="wallW" type="range" min="0.5" max="500" step="0.01" disabled=""></label>
  <label>高度<input id="wallH" type="range" min="0.5" max="500" step="0.01" disabled=""></label>
  <label>旋轉Y<input id="wallRY" type="range" min="-180" max="180" step="1" disabled=""></label>
  <label>顏色<input id="wallColor" type="color" disabled=""></label>
  <button id="deleteSelectedWall" class="danger" disabled="">刪除選取牆壁</button>
  <p class="small">新增牆面會先以半透明狀態跟隨角色，Enter 後變成實體。Shift+左鍵可重新選取牆壁，Shift+A 調整大小，Shift+T 開啟旋轉軸。原始四面牆也可刪除。</p>
</div></aside>



<aside id="sinTowerAssetPanel" class="edit-ui floating-window is-minimized" data-window-title="斷罪塔素材匯入" style="inset: 125.302px auto auto 953.948px; width: 316px; max-height: calc(-28px + 100vh); padding: 14px; border: 1px solid rgba(216, 192, 127, 0.42); background: rgba(10, 8, 5, 0.94); box-shadow: rgba(0, 0, 0, 0.55) 0px 18px 50px; backdrop-filter: blur(10px); font-size: 11px; z-index: 85; height: 574px;" data-floating-ready="1"><div class="window-header"><span class="window-title">斷罪塔素材匯入</span><button class="window-minimize" type="button" title="最小化">–</button></div><div class="window-body">
  <h1>Sin Tower Assets｜素材匯入</h1>
  <h2>PNG序列和尚</h2>
  <label>PNG序列和尚資料夾<input id="sinMonkPngSequenceFolder" type="file" accept="image/png,.png" multiple="" webkitdirectory="" directory=""></label>
  <label class="check" style="border:1px solid rgba(216,192,127,.45);background:rgba(255,210,90,.08);padding:8px;margin:6px 0;">正放完下一輪倒放<input id="sinMonkSpritePingpong" type="checkbox" checked=""></label>
  <div class="row" style="gap:8px;align-items:end;flex-wrap:wrap;">
    <label style="flex:1 1 80px;min-width:80px;">起始<input id="sinMonkSpriteStart" type="number" min="0" max="9999" step="1" value="1"></label>
    <label style="flex:1 1 80px;min-width:80px;">結束<input id="sinMonkSpriteEnd" type="number" min="0" max="9999" step="1" value="10"></label>
    <label style="flex:1 1 90px;min-width:90px;">FPS<input id="sinMonkSpriteFps" type="number" min="1" max="30" step="1" value="12"></label>
  </div>
  <label>每輪播放後停頓秒數<input id="sinMonkSpritePause" type="number" min="0" max="5" step="0.05" value="0.35"></label>
  <div class="row" style="gap:8px;align-items:end;flex-wrap:wrap;">
    <label style="flex:1 1 120px;min-width:120px;">PNG和尚高度<input id="sinMonkSpriteHeight" type="number" min="0.3" max="5" step="0.01" value="1.77"></label>
    <label style="flex:1 1 120px;min-width:120px;">PNG寬度倍率<input id="sinMonkSpriteWidthMul" type="number" min="0.2" max="5" step="0.01" value="1"></label>
  </div>
  <button id="sinMonkSpriteClear" type="button">清除PNG序列和尚</button>
  <hr>
  <label>樓梯地板材質圖片<input id="sinStairTextureFile" type="file" accept="image/*"></label>
  <label>樓梯材質重複倍率<input id="sinStairTextureRepeat" type="range" min="0.25" max="12" step="0.25" value="3"></label>
  <button id="sinStairTextureClear" type="button">移除樓梯材質</button>
  <hr>
  <label>路上和尚動畫模型 FBX / GLB / GLTF<input id="sinMonkModelFile" type="file" accept=".fbx,.glb,.gltf,model/gltf-binary,model/gltf+json"></label>
  <label>和尚可視階數<input id="sinMonkVisibleSteps" type="range" min="12" max="120" step="1" value="50"></label>
  <label>和尚實體池數量<input id="sinMonkPoolCount" type="range" min="4" max="36" step="1" value="16"></label>
  <button id="sinMonkModelReset" type="button">恢復預設 Praying.fbx</button>
  <p class="small">匯入 FBX / GLB / GLTF 後，只建立近距離僧侶實體池。若模型太重，建議改用 PNG 序列資料夾；PNG 會用 Sprite 永遠正面面對鏡頭，不會露出紙片側面，效能也會穩很多。</p>
</div></aside>

<aside id="sinTowerFirePanel" class="edit-ui floating-window is-minimized" data-window-title="碰撞火焰特效" style="inset: 179.292px auto auto 927.948px; width: 359px; max-height: calc(-344px + 100vh); padding: 14px; border: 1px solid rgba(255, 114, 34, 0.5); background: rgba(18, 7, 2, 0.92); box-shadow: rgba(0, 0, 0, 0.55) 0px 18px 50px; backdrop-filter: blur(10px); font-size: 11px; height: 387px; z-index: 86;" data-floating-ready="1"><div class="window-header"><span class="window-title">碰撞火焰特效</span><button class="window-minimize" type="button" title="最小化">–</button></div><div class="window-body">
  <h1>Hit Flame FX｜撞擊火焰</h1>
  <label>單顆粒子大小<input id="sinFireParticleSize" type="range" min="0.01" max="0.28" step="0.005"></label>
  <label>粒子數量<input id="sinFireParticleCount" type="range" min="30" max="1800" step="10"></label>
  <label>火焰形狀<select id="sinFireShape"><option value="column">柱狀包覆</option><option value="cone">尖錐上竄</option><option value="sphere">球狀爆燃</option><option value="burst">向外爆散</option></select></label>
  <div class="row" style="gap:8px;flex-wrap:wrap;">
    <label style="flex:1 1 90px;min-width:90px;">內焰<input id="sinFireColorA" type="color" value="#fff27a"></label>
    <label style="flex:1 1 90px;min-width:90px;">主焰<input id="sinFireColorB" type="color" value="#ff5a00"></label>
    <label style="flex:1 1 90px;min-width:90px;">暗焰<input id="sinFireColorC" type="color" value="#7b001e"></label>
  </div>
  <label>火焰包覆半徑<input id="sinFireRadius" type="range" min="0.15" max="2.8" step="0.01"></label>
  <label>火焰高度<input id="sinFireHeight" type="range" min="0.4" max="5.5" step="0.01"></label>
  <label>旋轉扭曲<input id="sinFireSwirl" type="range" min="0" max="4" step="0.01"></label>
  <label>持續秒數<input id="sinFireDuration" type="range" min="0.3" max="4" step="0.05"></label>
  <button id="sinFireTest" type="button">測試火焰</button>
  <p class="small">撞到僧侶時會啟動火焰，預設 1.5 秒。粒子會覆蓋主角外觀根節點周圍，不會改動腫瘤生長。</p>
</div></aside>

<aside id="objectPanel" class="edit-ui floating-window is-minimized" data-window-title="物件視窗" style="inset: 451.271px auto auto 881.323px; width: 394px; height: 520px; z-index: 87;" data-floating-ready="1"><div class="window-header"><span class="window-title">物件視窗</span><button class="window-minimize" type="button" title="最小化">–</button></div><div class="window-body">
  <h1>Object Window｜物件視窗</h1>
  <p class="small">可切換可視／不可視。Lock 後該物件保留在場景中，但不會再被滑鼠選取。先點第一個物件，再 Shift+左鍵點第二個物件，會選取兩者之間整段；Ctrl+G 建立群組；點群組可收合／展開；雙擊名稱可重新命名。</p>
  <div id="objectList" data-bound="1" data-strict-range-bound="1"><div class="object-row" data-type="roomSurface" data-id="floor" data-depth="0" data-parent="" data-expanded="false" data-selected="false" data-multiselected="false" data-visible="true" data-locked="true">
      <div class="object-name" data-action="select" title="地板">地板<span class="object-type">空間基底</span></div>
      <button data-action="visible">Visible</button>
      <button data-action="locked">Unlock</button>
    </div><div class="object-row" data-type="light" data-id="sin_tower_key_light" data-depth="0" data-parent="" data-expanded="false" data-selected="false" data-multiselected="false" data-visible="true" data-locked="false">
      <div class="object-name" data-action="select" title="斷罪塔｜上方斜光">斷罪塔｜上方斜光<span class="object-type">光源｜平行光</span></div>
      <button data-action="visible">Visible</button>
      <button data-action="locked">Lock</button>
    </div><div class="object-row" data-type="light" data-id="sin_tower_first_step_light" data-depth="0" data-parent="" data-expanded="false" data-selected="false" data-multiselected="false" data-visible="true" data-locked="false">
      <div class="object-name" data-action="select" title="斷罪塔｜第一階弱光">斷罪塔｜第一階弱光<span class="object-type">光源｜點光源</span></div>
      <button data-action="visible">Visible</button>
      <button data-action="locked">Lock</button>
    </div><div class="object-row" data-type="light" data-id="sin_tower_follow_light" data-depth="0" data-parent="" data-expanded="false" data-selected="false" data-multiselected="false" data-visible="true" data-locked="false">
      <div class="object-name" data-action="select" title="斷罪塔｜路徑補光">斷罪塔｜路徑補光<span class="object-type">光源｜點光源</span></div>
      <button data-action="visible">Visible</button>
      <button data-action="locked">Lock</button>
    </div></div>
</div></aside>

<aside id="lightPanel" class="edit-ui floating-window is-minimized" data-window-title="光照系統" style="inset: 68.6667px auto auto 1022.67px; width: 180px; height: 557px; z-index: 88;" data-floating-ready="1"><div class="window-header"><span class="window-title">光照系統</span><button class="window-minimize" type="button" title="最小化">–</button></div><div class="window-body">
  <h1>Lighting System｜光照系統</h1>
  <h2>全域光</h2>
  <label class="check">啟用光照系統<input id="lightSystemEnabled" type="checkbox"></label>
  <h2>光照烘焙／遊玩模式效能</h2>
  <div class="row">
    <button id="bakeLightingNow" class="ok">烘焙目前光影快取</button>
    <button id="clearLightingBake" class="danger">清除烘焙</button>
  </div>
  <label class="check">遊玩模式使用烘焙低耗能<input id="useLightingBakeInPlayMode" type="checkbox"></label>
  <label>亮度校正<input id="lightBakeBrightness" type="range" min="1" max="1" step="0.01" value="1" disabled=""></label>
  <p id="lightBakeInfo" class="small">尚未烘焙。按下後會快取目前即時陰影貼圖；遊玩模式保留原本燈光與陰影外觀，只停止陰影重算以降低耗能。</p>
  <label>環境光顏色<input id="ambientLightColor" type="color"></label>
  <label>環境光強度<input id="ambientLightIntensity" type="range" min="0" max="8" step="0.01"></label>
  <label>半球天空色<input id="hemisphereSkyColor" type="color"></label>
  <label>半球地面色<input id="hemisphereGroundColor" type="color"></label>
  <label>半球光強度<input id="hemisphereIntensity" type="range" min="0" max="8" step="0.01"></label>
  <h2>獨立光源</h2>
  <div class="row3">
    <button id="addPointLight">新增點光源</button>
    <button id="addDirectionalLight">新增平行光</button>
    <button id="addSpotLight">新增聚光燈</button>
  </div>
  <label>光源<select id="lightSelect" data-bound="1"><option value="sin_tower_key_light">斷罪塔｜上方斜光</option><option value="sin_tower_first_step_light">斷罪塔｜第一階弱光</option><option value="sin_tower_follow_light">斷罪塔｜路徑補光</option></select></label>
  <label>名稱<input id="lightTitle" type="text"></label>
  <label>類型<select id="lightType">
    <option value="point">點光源</option>
    <option value="directional">平行光</option>
    <option value="spot">聚光燈</option>
  </select></label>
  <label>光色<input id="lightColor" type="color"></label>
  <label>光照強度<input id="lightIntensity" type="range" min="0" max="20" step="0.01"></label>
  <label>位置X<input id="lightX" type="number" min="-500" max="500" step="0.01"></label>
  <label>位置Y<input id="lightY" type="number" min="-500" max="500" step="0.01"></label>
  <label>位置Z<input id="lightZ" type="number" min="-500" max="500" step="0.01"></label>
  <label>目標X<input id="lightTargetX" type="number" min="-500" max="500" step="0.01"></label>
  <label>目標Y<input id="lightTargetY" type="number" min="-500" max="500" step="0.01"></label>
  <label>目標Z<input id="lightTargetZ" type="number" min="-500" max="500" step="0.01"></label>
  <label>作用距離<input id="lightDistance" type="number" min="0" max="500" step="0.01" disabled=""></label>
  <label>衰減<input id="lightDecay" type="range" min="0" max="4" step="0.01" disabled=""></label>
  <label>光束角度<input id="lightAngle" type="range" min="0.05" max="1.55" step="0.01" disabled=""></label>
  <label>邊緣柔化<input id="lightPenumbra" type="range" min="0" max="1" step="0.01" disabled=""></label>
  <label class="check">陰影<input id="lightCastShadow" type="checkbox"></label>
  <label class="check">顯示<input id="lightVisible" type="checkbox"></label>
  <div class="row">
    <button id="applyLightValues" class="ok">套用光源數值</button>
    <button id="deleteSelectedLight" class="danger">刪除光源</button>
  </div>
  <p class="small">可單獨調整點光源、平行光與聚光燈的顏色、強度、位置、陰影與目標位置。光照系統獨立於建築材質。</p>
</div></aside>

<aside id="chiselPanel" class="edit-ui floating-window is-minimized" data-window-title="鑿子工具" style="inset: 16.6667px auto auto 1041.31px; width: 180px; height: 335.323px; z-index: 89;" data-floating-ready="1"><div class="window-header"><span class="window-title">鑿子工具</span><button class="window-minimize" type="button" title="最小化">–</button></div><div class="window-body">
  <h1>Chisel Tool｜鑿子工具</h1>
  <label class="check">啟用鑿子模式<input id="chiselEnabled" type="checkbox"></label>
  <label>鑿子形狀<select id="chiselShape">
    <option value="rect">矩形</option>
    <option value="circle">圓形／橢圓</option>
    <option value="triangle">三角形</option>
    <option value="pentagon">五邊形</option>
    <option value="hexagon">六邊形</option>
    <option value="octagon">八邊形</option>
    <option value="arch">拱門</option>
  </select></label>
  <label>寬度<input id="chiselWidth" type="number" min="0.1" max="20" step="0.05" value="1.6"></label>
  <label>高度<input id="chiselHeight" type="number" min="0.1" max="20" step="0.05" value="2.0"></label>
  <label>圓角／拱頂<input id="chiselRadius" type="range" min="0" max="1" step="0.01" value="0.18"></label>
  <label>底部高度<input id="chiselBottom" type="number" min="0" max="50" step="0.05" value="0"></label>
  <label>鑿洞深度<input id="chiselDepth" type="number" min="0.01" max="20" step="0.01" value="2.0"></label>
  <div class="row">
    <button id="chiselFromView" class="ok">從畫面中心鑿洞</button>
    <button id="chiselUndoLast">復原上一個洞</button>
  </div>
  <button id="chiselClearTarget" class="danger">清除目前選取牆面的鑿洞</button>

  <h2>堆疊工具／沙地</h2>
  <label class="check">啟用堆疊模式<input id="sandPileEnabled" type="checkbox"></label>
  <label>堆疊模式<select id="sandPileMode">
    <option value="raise">抬高沙堆</option>
    <option value="lower">下陷沙坑</option>
  </select></label>
  <label>尺寸<input id="sandPileRadius" type="number" min="0.15" max="12" step="0.05" value="1.2"></label>
  <label>力道<input id="sandPileStrength" type="range" min="0.01" max="1" step="0.01" value="0.38"></label>
  <label>拉桿最大高度<input id="sandPileMaxHeight" type="number" min="0.05" max="6" step="0.05" value="2.2"></label>
  <div class="row">
    <button id="sandPileFromView" class="ok">從畫面中心堆疊</button>
    <button id="sandPileUndo">復原上一筆沙地</button>
  </div>
  <button id="sandPileClear" class="danger">清除目前沙地堆疊</button>
  <label>沙地目標<input id="sandPileTargetInfo" type="text" value="尚未命中沙地" readonly=""></label>
  <p class="small">選取主地板或地板塊後開啟堆疊模式，按 SHIFT+A 會在圓圈中心直接顯示垂直拉桿；上下移動滑鼠調整沙丘高度，按 Enter 寫入並隱藏拉桿，Esc 取消。游標模式點擊沙地仍可快速堆疊；按 X 可從預覽位置執行一次。</p>

  <label>目前目標<input id="chiselTargetInfo" type="text" value="尚未命中牆面" readonly=""></label>
  <p class="small">開啟後，在游標模式直接點擊參考圖建築外牆／內牆或自建直牆，即會以命中點為中心鑿出洞。圓形可用寬高做橢圓；三角形、五邊形、六邊形、八邊形會依照寬高生成等距多邊形；拱門可輸入底部高度，0 代表仍以點擊中心計算。按 X 會直接在預覽位置鑿洞；Ctrl+Z 可還原鑿洞。鑿洞深度大於牆厚時會切穿牆面；深度低於牆厚時會形成非穿透凹洞。曲面牆暫不做布林切割，避免生成破面。</p>
</div></aside>

<input id="surfaceTextureInput" type="file" accept="image/*" hidden="">
<input id="referenceArchitectureTextureInput" type="file" accept="image/*" hidden="">
<input id="waterContainerTextureInput" type="file" accept="image/png,image/jpeg,image/webp" hidden="" data-bound="1">
<input id="skyTextureInput" type="file" accept="image/png,image/jpeg,image/webp" hidden="">
<input id="artworkFileInput" type="file" accept="image/png,image/jpeg,image/webp,.fbx,.glb,.gltf,model/gltf-binary,model/gltf+json" multiple="" hidden="">

<script type="module">
