  project01: 'data:image/png;base64,',
  statueTexture: 'data:image/jpeg;base64,',
  actorTexture: 'data:image/jpeg;base64,',
  statueObj: 'data:text/plain;base64,',
  actorIdle: 'data:application/octet-stream;base64,