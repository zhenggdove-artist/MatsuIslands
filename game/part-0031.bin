  #sinAfterVideoOverlay{position:fixed;inset:0;z-index:18000;opacity:1;transition:opacity .45s;background:rgba(0,0,0,.18)}
  #sinAfterVideoOverlay[hidden]{display:none!important}#sinAfterVideoOverlay.closing{opacity:0;pointer-events:none}
  body.sin-after-video-active #sinProEditor,body.sin-after-video-active #sinPlayObjectActions{visibility:hidden!important}
  .sin-after-media{position:fixed;transform:translate(-50%,-50%);object-fit:fill;max-width:none;max-height:none}
  #sinAfterFrame{pointer-events:none}#sinAfterEditBox{position:fixed;transform:translate(-50%,-50%);border:1px dashed #ffe477;box-sizing:border-box;touch-action:none;cursor:move}
  #sinAfterEditBox i{position:absolute;width:12px;height:12px;background:#ffe477;transform:translate(-50%,-50%);touch-action:none}
  #sinAfterToolbar{position:fixed;top:8px;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:2;background:#14263d;padding:8px}
  #sinAfterToolbar[hidden],#sinAfterEditBox[hidden]{display:none!important}#sinAfterToolbar button{background:#f4d66f;color:#14263d;padding:8px}
  #sinAfterPlaybackNotice{position:fixed;left:50%;top:12%;transform:translateX(-50%);color:#ffe477;background:#14263d;padding:10px}
  #sinGifCursor{position:fixed;left:0;top:0;z-index:2147483647;pointer-events:none;object-fit:contain}#sinGifCursor[hidden]{display:none!important}
  body.sin-gif-cursor,body.sin-gif-cursor *{cursor:none!important}
  body.sin-cursor-closing,body.sin-cursor-closing *{cursor:none!important}
  #sinExtraSelected details{margin-top:10px}#sinExtraSelected input[type=file]{max-width:100%}
  `;document.head.append(style);
  const overlay=document.createElement('div');overlay.id='sinAfterVideoOverlay';overlay.hidden=true;overlay.innerHTML='<video id="sinAfterVideo" class="sin-after-media" loop playsinline></video><img id="sinAfterFrame" class="sin-after-media" alt=""><div id="sinAfterEditBox" hidden></div><div id="sinAfterToolbar" hidden><button type="button" data-part="video">影片</button><button type="button" data-part="frame">GIF 影片框</button><button type="button" id="sinAfterEditDone">完成</button></div><button type="button" id="sinAfterPlaybackNotice" hidden>點此播放影片</button>';
  document.body.append(overlay);
  overlay.addEventListener('pointerdown',event=>{event.stopPropagation();const s=sinAfterVideoSession;if(!s||s.editing||event.target===$('sinAfterPlaybackNotice'))return;if(event.target!==$('sinAfterVideo'))closeSinAfterVideo();});
  overlay.addEventListener('click',e=>e.stopPropagation());overlay.addEventListener('contextmenu',e=>{e.preventDefault();e.stopPropagation();});
  $('sinAfterPlaybackNotice').onclick=()=>{$('sinAfterVideo').muted=false;$('sinAfterVideo').play().then(()=>{$('sinAfterPlaybackNotice').hidden=true;}).catch(()=>{setStatus('影片無法播放，請確認 MP4 使用瀏覽器支援的編碼。');});};
  $('sinAfterVideo').onerror=()=>{if(sinAfterVideoSession){$('sinAfterPlaybackNotice').hidden=false;$('sinAfterPlaybackNotice').textContent='影片無法播放，請替換 MP4；點外側關閉';}};
  for(const button of overlay.querySelectorAll('[data-part]'))button.onclick=()=>{if(sinAfterVideoSession){sinAfterVideoSession.part=button.dataset.part;layoutSinAfterVideo();}};
  $('sinAfterEditDone').onclick=()=>closeSinAfterVideo(true);
  const box=$('sinAfterEditBox');for(const [name,x,y] of [['nw',0,0],['n',50,0],['ne',100,0],['e',100,50],['se',100,100],['s',50,100],['sw',0,100],['w',0,50]]){const handle=document.createElement('i');handle.dataset.handle=name;handle.style.left=x+'%';handle.style.top=y+'%';handle.style.cursor=name+'-resize';box.append(handle);}
  box.onpointerdown=e=>{const s=sinAfterVideoSession;if(!s?.editing)return;e.preventDefault();e.stopPropagation();box.setPointerCapture(e.pointerId);s.drag={id:e.pointerId,x:e.clientX,y:e.clientY,handle:e.target.dataset.handle||'',rect:{...s.config.layout[s.part]},viewport:getSinTowerGameViewport()};};
  box.onpointermove=e=>{const s=sinAfterVideoSession,d=s?.drag;if(!d||d.id!==e.pointerId)return;e.preventDefault();const dx=(e.clientX-d.x)/d.viewport.width,dy=(e.clientY-d.y)/d.viewport.height,r={...d.rect},h=d.handle;
    if(!h){r.x+=dx;r.y+=dy;}else{let dw=(h.includes('e')?dx:h.includes('w')?-dx:0),dh=(h.includes('s')?dy:h.includes('n')?-dy:0);if(h.length===2){const factor=Math.max(.02/d.rect.w,.02/d.rect.h,Math.abs(dw/d.rect.w)>=Math.abs(dh/d.rect.h)?1+dw/d.rect.w:1+dh/d.rect.h);dw=d.rect.w*(factor-1);dh=d.rect.h*(factor-1);}r.w=clamp(d.rect.w+dw,.02,1);r.h=clamp(d.rect.h+dh,.02,1);r.x+=(h.includes('e')?1:h.includes('w')?-1:0)*(r.w-d.rect.w)/2;r.y+=(h.includes('s')?1:h.includes('n')?-1:0)*(r.h-d.rect.h)/2;}
    r.x=clamp(r.x,r.w/2,1-r.w/2);r.y=clamp(r.y,r.h/2,1-r.h/2);s.config.layout[s.part]=r;layoutSinAfterVideo();};
  box.onpointerup=box.onpointercancel=e=>{const s=sinAfterVideoSession;if(!s?.drag)return;s.drag=null;try{box.releasePointerCapture(e.pointerId);}catch{}commitSinExtraInteraction(s.object,{afterVideo:sanitizeSinAfterVideo(s.config)});};
  window.addEventListener('resize',layoutSinAfterVideo);
  const cursor=document.createElement('img');cursor.id='sinGifCursor';cursor.hidden=true;cursor.alt='';cursor.onload=()=>measureSinCursorCenter(cursor);document.body.append(cursor);
  window.addEventListener('pointermove',e=>{if(e.pointerType==='touch'){sinCustomCursorPosition.inside=false;}else{sinCustomCursorPosition={x:e.clientX,y:e.clientY,inside:true};}syncSinGifCursor();},{passive:true});
  document.addEventListener('pointerleave',()=>{sinCustomCursorPosition.inside=false;syncSinGifCursor();});
  window.addEventListener('blur',()=>{sinCustomCursorPosition.inside=false;syncSinGifCursor();});
  document.addEventListener('pointerlockchange',syncSinGifCursor);
}
function syncSinGifCursor(){
  const img=$('sinGifCursor');if(!img)return;const cfg=sanitizeSinCustomCursor(STATE.customCursor);
  const hidden=document.body.classList.contains('sin-cursor-closing')||!!document.pointerLockElement||pointerLocked||fallbackMouseLook||(!cursorFreeMode&&desiredPointerLocked)||!sinCustomCursorPosition.inside;
  const enabled=cfg.enabled&&!!cfg.src;document.body.classList.toggle('sin-gif-cursor',enabled&&!hidden);img.hidden=!enabled||hidden;
  if(img.hidden)return;if(img._sinSource!==cfg.src){img._sinCenter={x:.5,y:.5};img.src=cfg.src;img._sinSource=cfg.src;}
  syncSinGifCursorFilter();
  const center=img._sinCenter||{x:.5,y:.5};Object.assign(img.style,{width:cfg.size+'px',height:cfg.size+'px',transform:'translate('+(sinCustomCursorPosition.x-cfg.size*(center.x+(cfg.hotX-50)/100))+'px,'+(sinCustomCursorPosition.y-cfg.size*(center.y+(cfg.hotY-50)/100))+'px)'});
}
function syncSinGifCursorFilter(){
  const img=$('sinGifCursor');if(!img)return;
  const fx=getScreenFxConfig(),k=clamp01(fx.intensity),enabled=fx.enabled&&fx.preset!=='none'&&k>.001;
  if(!enabled){img.style.filter='none';return;}
  const brightness=THREE.MathUtils.lerp(1,clamp(safeFinite(fx.brightness,1),.2,2),k),contrast=THREE.MathUtils.lerp(1,clamp(safeFinite(fx.contrast,1),.2,2.6),k);
  if(fx.preset!=='monopixel'){img.style.filter='brightness('+brightness+') contrast('+contrast+') saturate('+THREE.MathUtils.lerp(1,clamp(safeFinite(fx.saturation,1),0,3),k)+') hue-rotate('+(safeFinite(fx.hue,0)*k)+'deg) blur('+(safeFinite(fx.blur,0)*k)+'px)';return;}
  let filter=$('sinCursorMonoFilter');
  if(!filter){const source=$('sinPortalMonoFilter');if(!source)return;filter=source.cloneNode(true);for(const node of [filter,...filter.querySelectorAll('[id]')])node.id=node.id.replace('sinPortal','sinCursor');source.parentNode.append(filter);}
  img.style.filter='url(#sinCursorMonoFilter)';
  const v=getSinTowerGameViewport(),backing=screenFxTargetSize.x>0&&v.width>0?screenFxTargetSize.x/v.width:(renderer?.getPixelRatio?.()||1),grid=Math.max(1,safeFinite(screenFxMaterial?.uniforms?.uDitherGridScale?.value,1));
  const cell=Math.max(.02,(51-clamp(Math.round(safeFinite(fx.monoDetail,50)),1,50))*grid/Math.max(.001,backing)),paper=validColor(fx.monoPaper)?fx.monoPaper:'#f4d66f',ink=validColor(fx.monoInk)?fx.monoInk:'#14263d';
  const signature=[brightness,contrast,cell,paper,ink].join(':');if(filter._sinSignature===signature)return;filter._sinSignature=signature;
  const light=hexToRgb01(paper),dark=hexToRgb01(ink);
  for(const [index,c] of ['R','G','B'].entries()){$('sinCursorMonoAdjust'+c).setAttribute('slope',String(brightness*contrast));$('sinCursorMonoAdjust'+c).setAttribute('intercept',String(.5*(1-contrast)));$('sinCursorMonoPalette'+c).setAttribute('tableValues',dark[index]+' '+light[index]);}
  $('sinCursorMonoBlend').setAttribute('k2','1');$('sinCursorMonoBlend').setAttribute('k3','0');
  const tile=$('sinCursorMonoBayerImage');tile.setAttribute('width',String(cell*4));tile.setAttribute('height',String(cell*4));
  if(!filter._sinBayer){const canvas=document.createElement('canvas');canvas.width=canvas.height=4;const ctx=canvas.getContext('2d'),matrix=[[0,8,2,10],[12,4,14,6],[3,11,1,9],[15,7,13,5]];for(let y=0;y<4;y++)for(let x=0;x<4;x++){const n=Math.round(matrix[y][x]/16*255);ctx.fillStyle='rgb('+n+','+n+','+n+')';ctx.fillRect(x,y,1,1);}filter._sinBayer=canvas.toDataURL();}
  tile.setAttribute('href',filter._sinBayer);
}
function layoutSinAfterVideo(){
  const s=sinAfterVideoSession;if(!s)return;const v=getSinTowerGameViewport();syncSinGifCursorFilter();const fx=getScreenFxConfig();$('sinAfterVideo').style.filter=s.config.monoFilter&&fx.enabled&&fx.preset==='monopixel'?'url(#sinCursorMonoFilter)':'none';
  for(const part of ['video','frame']){const r=s.config.layout[part],el=$(part==='video'?'sinAfterVideo':'sinAfterFrame');Object.assign(el.style,{left:(v.left+r.x*v.width)+'px',top:(v.top+r.y*v.height)+'px',width:r.w*v.width+'px',height:r.h*v.height+'px'});}
  if(s.editing){const selected=$(s.part==='video'?'sinAfterVideo':'sinAfterFrame');for(const key of ['left','top','width','height'])$('sinAfterEditBox').style[key]=selected.style[key];}
}
function showSinAfterVideo(object,editing=false){
  if(sinAfterVideoSession)closeSinAfterVideo(true);
  const config=sanitizeSinAfterVideo(object?.interaction?.afterVideo);if(!config.src){setStatus('請先上傳互動結束後播放的 MP4。');return;}if(!editing&&(!config.enabled||isSinTowerInteractionPlacementActive()))return;
  ensureSinExtraUi();sinAfterVideoSession={object,config,editing,part:'video',autoRun:!!SIN_TOWER_STAIRCASE.autoRun};
  SIN_TOWER_STAIRCASE.autoRun=false;clearMovementKeys();setSinTowerModalCursorFree();
  document.body.classList.add('sin-after-video-active');
  const overlay=$('sinAfterVideoOverlay');overlay.hidden=false;overlay.classList.remove('closing');$('sinAfterToolbar').hidden=!editing;$('sinAfterEditBox').hidden=!editing;
  $('sinAfterPlaybackNotice').hidden=true;$('sinAfterPlaybackNotice').textContent='點此開啟影片聲音';
  const video=$('sinAfterVideo'),frame=$('sinAfterFrame');video.src=config.src;video.loop=true;video.muted=editing;frame.hidden=!config.frameSrc;if(config.frameSrc)frame.src=config.frameSrc;else frame.removeAttribute('src');layoutSinAfterVideo();
  const current=sinAfterVideoSession;video.play().catch(()=>{if(sinAfterVideoSession!==current)return;video.muted=true;video.play().then(()=>{if(sinAfterVideoSession===current)$('sinAfterPlaybackNotice').hidden=editing;}).catch(()=>{if(sinAfterVideoSession===current){$('sinAfterPlaybackNotice').textContent='點此播放影片';$('sinAfterPlaybackNotice').hidden=false;}});});
}
function closeSinAfterVideo(immediate=false){
  const s=sinAfterVideoSession;if(!s||s.closing)return;s.closing=true;
  if(!s.editing)hideSinInteractionCursor();
  const finish=()=>{if(sinAfterVideoSession!==s)return;const video=$('sinAfterVideo');video.pause();video.removeAttribute('src');video.load();$('sinAfterFrame').removeAttribute('src');$('sinAfterVideoOverlay').hidden=true;sinAfterVideoSession=null;document.body.classList.remove('sin-after-video-active');clearMovementKeys();SIN_TOWER_STAIRCASE.autoRun=s.autoRun;
    if(s.editing){commitSinExtraInteraction(s.object,{afterVideo:sanitizeSinAfterVideo(s.config)});enterSinTowerEditorMode();setSinProTab('perf');syncSinProEditor();}else restoreSinTowerPlayLook(false);
  };
  if(immediate)finish();else{$('sinAfterVideoOverlay').classList.add('closing');setTimeout(finish,450);}
}
function handleSinAfterVideoKey(event){if(!sinAfterVideoSession)return false;event.preventDefault();event.stopImmediatePropagation();if(event.code==='Escape')closeSinAfterVideo();return true;}
function syncSinSelectedVideoFilter(object){
  const section=$('sinSelectedVideoFilter'),checkbox=$('sinSceneVideoMono');if(!section||!checkbox)return;
  section.hidden=object?.mediaType!=='video';
  checkbox.checked=object?.monoFilter!==false;
  checkbox.onchange=()=>{
    const selected=getSinTowerSelectedPlayProp();if(selected?.mediaType!=='video')return;
    const canonical=sinExtraObject(selected.id)||selected,rec=sinTowerEditorRuntime.props.get(selected.id);
    for(const target of new Set([selected,canonical,rec?.prop].filter(Boolean)))target.monoFilter=checkbox.checked;
    // Update every repeated instance immediately, even while the editor pauses movement.
    if(rec)updateSinTowerEditorPropRecord(rec,performance.now()*.001);
    scheduleSinTowerRuntimeSave();
    $('sinSelectedVideoFilterStatus').textContent=checkbox.checked?'已套用遊戲單色濾鏡':'已取消濾鏡，顯示影片原色';
  };
  $('sinSelectedVideoFilterStatus').textContent=checkbox.checked?'已套用遊戲單色濾鏡':'已取消濾鏡，顯示影片原色';
}
function syncSinExtraSelected(object){
  ensureSinExtraUi();let panel=$('sinExtraSelected');
  if(!panel){panel=document.createElement('div');panel.id='sinExtraSelected';panel.innerHTML='<details id="sinAnswerEffectsPanel"><summary>YES／NO 各自的腫瘤效果</summary>'+['yes','no'].map(a=>'<fieldset><legend>'+a.toUpperCase()+'</legend><label>啟用<input id="sinAnswer_'+a+'_enabled" type="checkbox"></label><label>效果<select id="sinAnswer_'+a+'_direction"><option value="add">增加</option><option value="remove">減少</option></select></label><label>層數 N<input id="sinAnswer_'+a+'_layers" type="number" min="1" max="1000" step="1"></label></fieldset>').join('')+'<small>每回答一題套用一次；編輯預覽不生效。最低 0 層，最高為肉球完成層數。</small></details><details><summary>互動結束後播放影片</summary><label>啟用<input id="sinAfterEnabled" type="checkbox"></label><label>套用遊戲單色濾鏡<input id="sinAfterMono" type="checkbox"></label><label>上傳 MP4<input id="sinAfterUpload" type="file" accept="video/mp4,.mp4"></label><div id="sinAfterFileName"></div><label>上傳 GIF 影片框<input id="sinAfterFrameUpload" type="file" accept="image/gif,.gif"></label><div id="sinAfterFrameName"></div><button id="sinAfterRemoveFrame" type="button">移除影片框</button><small>位置與尺寸：編輯模式 → 素材效能 → 互動影片與影片框。</small></details>';$('sinSelectedInteractionType').closest('label').after(panel);
    for(const a of ['yes','no'])for(const key of ['enabled','direction','layers'])$('sinAnswer_'+a+'_'+key).onchange=()=>{const obj=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp();if(!obj)return;const effects=sanitizeSinAnswerEffects(obj.interaction.answerEffects,obj.interaction.infectionEffect);effects[a]=sanitizeSinTowerInfectionEffect({enabled:$('sinAnswer_'+a+'_enabled').checked,direction:$('sinAnswer_'+a+'_direction').value,layers:Number($('sinAnswer_'+a+'_layers').value)});commitSinExtraInteraction(obj,{answerEffects:effects});};
    $('sinAfterMono').onchange=()=>{const obj=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp();if(obj)commitSinExtraInteraction(obj,{afterVideo:sanitizeSinAfterVideo({...obj.interaction.afterVideo,monoFilter:$('sinAfterMono').checked})});};
    $('sinAfterEnabled').onchange=()=>{const obj=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp();if(obj)commitSinExtraInteraction(obj,{afterVideo:sanitizeSinAfterVideo({...obj.interaction.afterVideo,enabled:$('sinAfterEnabled').checked})});};
    for(const [id,frame] of [['sinAfterUpload',false],['sinAfterFrameUpload',true]])$(id).onchange=async event=>{const obj=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp(),file=event.target.files?.[0];event.target.value='';if(!obj||!file)return;try{if(!frame&&!/\.mp4$/i.test(file.name))throw Error('請選擇 MP4 檔案');const src=frame?await readSinLoopingGif(file):await readSinTowerBlobAsDataUrl(new Blob([await file.arrayBuffer()],{type:'video/mp4'}));if(!sinExtraObject(obj.id))return;const cfg=sanitizeSinAfterVideo((sinExtraObject(obj.id)||obj).interaction.afterVideo);if(frame){cfg.frameSrc=src;cfg.frameName=file.name;}else{cfg.src=src;cfg.name=file.name;}commitSinExtraInteraction(obj,{afterVideo:cfg});syncSinTowerPlayPropActions();syncSinExtraPerf();setStatus('已匯入 '+file.name+'；請按儲存完整匯出以備份素材。');}catch(e){setStatus(e.message);}};
    $('sinAfterRemoveFrame').onclick=()=>{const obj=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp();if(obj){commitSinExtraInteraction(obj,{afterVideo:sanitizeSinAfterVideo({...obj.interaction.afterVideo,frameSrc:'',frameName:''})});syncSinTowerPlayPropActions();}};
  }
  $('sinAnswerEffectsPanel').hidden=object.interaction.type!=='question';const effects=sanitizeSinAnswerEffects(object.interaction.answerEffects,object.interaction.infectionEffect);
  for(const a of ['yes','no'])for(const key of ['enabled','direction','layers']){const el=$('sinAnswer_'+a+'_'+key);if(document.activeElement===el)continue;if(key==='enabled')el.checked=effects[a][key];else el.value=effects[a][key];}
  const cfg=sanitizeSinAfterVideo(object.interaction.afterVideo);$('sinAfterEnabled').checked=cfg.enabled;$('sinAfterMono').checked=cfg.monoFilter;$('sinAfterFileName').textContent=cfg.name||'尚未上傳 MP4';$('sinAfterFrameName').textContent=cfg.frameName||'尚未上傳 GIF 框';
}
function syncSinExtraPerf(){
  ensureSinExtraUi();let panel=$('sinExtraPerf');if(!panel){panel=document.createElement('div');panel.id='sinExtraPerf';panel.innerHTML='<div class="sin-pro-heading">發布遊戲</div><button id="sinExportPublished" type="button">匯出無編輯功能發布版（GitHub Pages ZIP）</button><p>解壓縮後，上傳全部內容至 Pages 發布目錄。直接開啟本機 HTML 時，請在匯出時選擇本遊戲的 assets 資料夾。</p><div class="sin-pro-heading">互動影片與影片框</div><label class="sin-pro-field">互動物件<select id="sinAfterObjectSelect"></select></label><button id="sinAfterLayoutButton" type="button">編輯影片／GIF 框位置與尺寸</button><p class="sin-pro-muted">先在物件右下角「互動結束後播放影片」上傳 MP4／GIF。編輯時可切換影片或框；四角等比例縮放，四邊中點自由變形。</p><div class="sin-pro-heading">GIF 游標</div><label class="sin-pro-field">上傳 GIF<input id="sinCursorUpload" type="file" accept="image/gif,.gif"></label><div id="sinCursorName"></div><label class="sin-pro-field">使用 GIF 游標<input id="sinCursorEnabled" type="checkbox"></label><label class="sin-pro-field">尺寸<input id="sinCursorSize" type="range" min="8" max="160" step="1"></label><label class="sin-pro-field">中心微調 X %（50 為置中）<input id="sinCursorHotX" type="range" min="0" max="100"></label><label class="sin-pro-field">中心微調 Y %（50 為置中）<input id="sinCursorHotY" type="range" min="0" max="100"></label><button id="sinCursorReset" type="button">恢復系統游標</button>';$('sinPerfRpsEditor').after(panel);
    $('sinExportPublished').onclick=exportSinPublishedGame;
    $('sinAfterLayoutButton').onclick=()=>{const obj=sinExtraObject($('sinAfterObjectSelect').value);if(!obj)return;if(sinTowerPlayObjectUi.activePropId)finalizeSinTowerInteractionClose(false,false);showSinAfterVideo(obj,true);};
    $('sinCursorUpload').onchange=async e=>{const file=e.target.files?.[0];e.target.value='';if(!file)return;try{const src=await readSinLoopingGif(file);STATE.customCursor=sanitizeSinCustomCursor({...STATE.customCursor,enabled:true,src,name:file.name});scheduleSave();scheduleSinTowerRuntimeSave();syncSinExtraPerf();syncSinGifCursor();}catch(error){setStatus(error.message);}};
    for(const id of ['sinCursorEnabled','sinCursorSize','sinCursorHotX','sinCursorHotY'])$(id).oninput=()=>{STATE.customCursor=sanitizeSinCustomCursor({...STATE.customCursor,enabled:$('sinCursorEnabled').checked,size:Number($('sinCursorSize').value),hotX:Number($('sinCursorHotX').value),hotY:Number($('sinCursorHotY').value)});scheduleSave();scheduleSinTowerRuntimeSave();syncSinGifCursor();};
    $('sinCursorReset').onclick=()=>{STATE.customCursor=sanitizeSinCustomCursor({enabled:false});scheduleSave();scheduleSinTowerRuntimeSave();syncSinExtraPerf();syncSinGifCursor();};
  }
  const objects=[...SIN_TOWER_EDITOR.props,...SIN_TOWER_EDITOR.models].filter(o=>o.sceneId===SIN_TOWER_EDITOR.activeSceneId&&o.interaction?.afterVideo?.src),select=$('sinAfterObjectSelect'),previous=select.value,signature=JSON.stringify(objects.map(o=>[o.id,o.title]));
  if(select.dataset.signature!==signature){select.replaceChildren();for(const obj of objects){const option=document.createElement('option');option.value=obj.id;option.textContent=obj.title||obj.id;select.append(option);}if(objects.some(o=>o.id===previous))select.value=previous;if(!objects.length){const option=document.createElement('option');option.textContent='尚無已上傳影片的互動物件';select.append(option);}select.dataset.signature=signature;}
  $('sinAfterLayoutButton').disabled=!objects.length;
  const cfg=sanitizeSinCustomCursor(STATE.customCursor);$('sinCursorEnabled').checked=cfg.enabled;$('sinCursorName').textContent=cfg.name||'目前使用系統游標';for(const [id,key] of [['sinCursorSize','size'],['sinCursorHotX','hotX'],['sinCursorHotY','hotY']])if(document.activeElement!==$(id))$(id).value=cfg[key];syncSinGifCursor();
}

// Publication runs the original renderer, without the legacy gallery quality caps.
function prepareSinPublishedGame(){
  ensureSinExtraUi();document.body.classList.add('sin-published');
  const style=document.createElement('style');style.textContent='body.sin-published .edit-ui,body.sin-published #sinPlayAddButton,body.sin-published #sinPlayAddPanel,body.sin-published #editor,body.sin-published #hud,body.sin-published #status,body.sin-published #sinProEditor,body.sin-published #objectPanel,body.sin-published #lightPanel,body.sin-published #chiselPanel,body.sin-published #sinPlayObjectActions,body.sin-published #sinExtraPerf{display:none!important}';document.head.append(style);
  window.addEventListener('keydown',event=>{
    if(sinAfterVideoSession||sinRpsSession||sinTowerPortalGate?.active)return;
    if(sinTowerPlayObjectUi.activePropId){
      if(event.code==='ArrowLeft'||event.code==='ArrowRight'){if(!event.repeat&&$('sinQuestionOverlay')?.classList.contains('open'))answerSinTowerQuestion(event.code==='ArrowRight'?'yes':'no');}
      else if(event.code==='Escape')closeSinTowerInteraction(true,false);
      event.preventDefault();event.stopImmediatePropagation();return;
    }
    if(event.code==='Escape'){event.preventDefault();event.stopImmediatePropagation();restoreSinTowerPlayLook(false);return;}
    if(event.ctrlKey||event.metaKey||event.altKey||event.shiftKey||!['KeyW','KeyA','KeyS','KeyD','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space','KeyR'].includes(event.code)){event.preventDefault();event.stopImmediatePropagation();}
  },true);
}
function sinReleaseZip(files){
  const encoder=new TextEncoder(),parts=[],central=[];let offset=0,centralSize=0;
  const crcTable=new Uint32Array(256);for(let n=0;n<256;n++){let c=n;for(let k=0;k<8;k++)c=c&1?0xedb88320^(c>>>1):c>>>1;crcTable[n]=c>>>0;}
  for(const [name,content] of files){const data=typeof content==='string'?encoder.encode(content):content,n=encoder.encode(name);let crc=0xffffffff;for(const b of data)crc=crcTable[(crc^b)&255]^(crc>>>8);crc=(crc^0xffffffff)>>>0;
    const local=new Uint8Array(30+n.length),v=new DataView(local.buffer);v.setUint32(0,0x04034b50,true);v.setUint16(4,20,true);v.setUint16(6,0x800,true);v.setUint32(14,crc,true);v.setUint32(18,data.length,true);v.setUint32(22,data.length,true);v.setUint16(26,n.length,true);local.set(n,30);parts.push(local,data);
    const entry=new Uint8Array(46+n.length),d=new DataView(entry.buffer);d.setUint32(0,0x02014b50,true);d.setUint16(4,20,true);d.setUint16(6,20,true);d.setUint16(8,0x800,true);d.setUint32(16,crc,true);d.setUint32(20,data.length,true);d.setUint32(24,data.length,true);d.setUint16(28,n.length,true);d.setUint32(42,offset,true);entry.set(n,46);central.push(entry);centralSize+=entry.length;offset+=local.length+data.length;
  }
  if(offset+centralSize>0xffffffff)throw Error('發布包超出 ZIP 容量，請先減少素材容量');
  const end=new Uint8Array(22),v=new DataView(end.buffer);v.setUint32(0,0x06054b50,true);v.setUint16(8,files.length,true);v.setUint16(10,files.length,true);v.setUint32(12,centralSize,true);v.setUint32(16,offset,true);
  return new Blob([...parts,...central,end],{type:'application/zip'});
}
async function buildSinPublishedPackage(saved,dependencyAssets=null){
  const backup=await buildSinTowerCompleteBackupHtml(saved,{publication:true},dependencyAssets);
  if(backup.meta.dependencies?.unresolved?.length)throw Error('以下素材無法讀取，不能產生缺素材發布版：'+backup.meta.dependencies.unresolved.map(x=>x.url).join('、')+'。請由本機 HTTP 伺服器開啟遊戲後重試。');
  let html=backup.html.replace(/]*>/gi,'').replace('const SIN_TOWER_PUBLISHED = false;','const SIN_TOWER_PUBLISHED = true;');
  html=html.replace(/<title>.*?<\/title>/,'<title>斷罪塔</title>');
  // Keep each repository file below browser upload limits; reconstruct byte-exact
  // HTML before module execution. Relative paths work on /repository/ Pages URLs.
  const bytes=new TextEncoder().encode(html),files=[],names=[];
  for(let offset=0;offset<bytes.length;offset+=8*1024*1024){const name='game/part-'+String(names.length).padStart(4,'0')+'.bin';names.push(name);files.push([name,bytes.subarray(offset,offset+8*1024*1024)]);}
  const loader='<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>斷罪塔</title></head><body style="background:#080808;color:#f4d66f"><p id="loading">正在載入遊戲…</p><script>(async()=>{try{const names='+JSON.stringify(names)+';const parts=[];for(const name of names){const r=await fetch(new URL(name,location.href));if(!r.ok)throw Error(name+" HTTP "+r.status);parts.push(await r.arrayBuffer());}const html=await new Blob(parts).text();document.open();document.write(html);document.close();}catch(e){document.getElementById("loading").textContent="遊戲載入失敗："+e.message;}})();<\/script></body></html>';
  files.unshift(['index.html',loader],['.nojekyll',''],['README.txt','發布方式：解壓縮後，將 index.html、game 資料夾與 .nojekyll 一起放在 GitHub Pages 的發布目錄。不要只上傳 ZIP。這是純遊玩版；編輯請保留原本的完整可編輯存檔。Three.js 模組仍由 HTTPS CDN 載入，需連網。\n']);
  return sinReleaseZip(files);
}
async function exportSinPublishedGame(){
  const button=$('sinExportPublished');if(button?.disabled)return;if(button)button.disabled=true;
  try{const dependencyAssets=null; // Built-in dependencies are embedded; no directory permission required.
    setStatus('正在保存並打包發布版，素材不降畫質…');const saved=await saveStateNow({updateBadge:false}),blob=await buildSinPublishedPackage(saved,dependencyAssets),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='SinTower_GitHubPages.zip';a.click();setTimeout(()=>URL.revokeObjectURL(url),60000);setStatus('已下載發布版 ZIP。解壓縮並將全部內容放進 GitHub Pages 發布目錄；請保留可編輯存檔。');}
  catch(error){setStatus('發布匯出失敗：'+error.message);alert('發布匯出失敗：'+error.message);}finally{if(button)button.disabled=false;}
}


function syncSinTowerPerfRpsEditor(){
  const select=$('sinPerfRpsObject'),button=$('sinPerfEditRpsLayout');if(!select||!button)return;
  const previous=select.value;
  const objects=[...SIN_TOWER_EDITOR.props,...SIN_TOWER_EDITOR.models].filter(o=>o.sceneId===SIN_TOWER_EDITOR.activeSceneId&&o.interaction?.type==='rps');
  const signature=JSON.stringify(objects.map(o=>[o.id,o.title||o.name||o.id]));
  if(select.dataset.signature!==signature){
    select.replaceChildren();
    for(const o of objects){const option=document.createElement('option');option.value=o.id;option.textContent=o.title||o.name||o.id;select.appendChild(option);}
    if(!objects.length){const option=document.createElement('option');option.textContent='目前場景尚無猜拳互動物件';option.value='';select.appendChild(option);}
    if(objects.some(o=>o.id===previous))select.value=previous;
    select.dataset.signature=signature;
  }
  button.disabled=!objects.length;select.disabled=!objects.length;
  $('sinPerfRpsHint').textContent=objects.length?'拖曳圖片移動，拉四角等比例縮放；三張選擇圖與對手圖片可分別調整。完成後返回素材效能。':'先新增物件，將互動模式設為「猜拳互動」，再回到此處編輯。';
  button.onclick=()=>{
    const id=select.value,rec=sinTowerEditorRuntime.props.get(id)||sinTowerEditorRuntime.models.get(id);
    if(!rec){setStatus('此物件尚未載入，請等待素材載入後再試。');return;}
    closeSinTowerPlayAddPanel(false,false);
    if(sinTowerPlayObjectUi.activePropId)finalizeSinTowerInteractionClose(false,false);
    openSinTowerRps(rec,{position:player.position.clone()},true);
    if(sinRpsSession)sinRpsSession.returnToPerf=true;
  };
}
function syncSinTowerRpsEditor(object){
  let panel=$('sinSelectedRpsSettings');
  if(!panel){
    panel=document.createElement('details');panel.id='sinSelectedRpsSettings';
    panel.innerHTML='<summary>猜拳圖片與版面</summary><p>左右選擇，五秒後揭曉。勝利清空腫瘤；失敗增加10層；平手不變。</p><button type="button" id="sinEditRpsLayout">編輯猜拳圖片版面</button><p>拖曳圖片移動；拉四角等比例縮放。三張選擇圖與對手圖可分別調整。</p>';
    $('sinSelectedInteractionType')?.closest('label')?.after(panel);
    $('sinEditRpsLayout').onclick=()=>{
      const obj=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp();if(!obj)return;
      const rec=sinTowerEditorRuntime.props.get(obj.id)||sinTowerEditorRuntime.models.get(obj.id);if(!rec)return;
      if(sinTowerPlayObjectUi.activePropId)finalizeSinTowerInteractionClose(false,false);
      openSinTowerRps(rec,{position:player.position.clone()},true);
    };
  }
  panel.hidden=object?.interaction?.type!=='rps';
}
function openSinTowerRps(rec,nearest,editing=false){
  if(!editing&&isSinTowerInteractionPlacementActive())return;
  const object=rec?.prop||rec?.model,config=object?.interaction;
  if(!config||(!editing&&(!config.enabled||config.consumed||config.dissolving))||sinTowerPlayObjectUi.activePropId||sinTowerPlayObjectUi.panelOpen)return;
  ensureSinTowerRpsUi();
  object.interaction.rpsLayout=sanitizeSinTowerRpsLayout(config.rpsLayout);
  sinTowerPlayObjectUi.resultSession={object,type:'rps',preview:editing,applied:false};
  sinTowerPlayObjectUi.activePropId=object.id;sinTowerPlayObjectUi.activeWorldPosition=nearest.position.clone();
  sinTowerPlayObjectUi.dismissedPropId=null;sinTowerPlayObjectUi.dismissedWorldPosition=null;
  sinTowerPlayObjectUi.lastPlayerPosition.copy(player.position);sinTowerPlayObjectUi.previousAutoRun=!!SIN_TOWER_STAIRCASE.autoRun;
  SIN_TOWER_STAIRCASE.autoRun=false;clearMovementKeys();setSinTowerModalCursorFree();
  const random=new Uint32Array(1);crypto.getRandomValues(random);
  sinRpsSession={object,editing,selected:0,opponent:SIN_RPS_KINDS[random[0]%3],deadline:Infinity,ready:false,revealed:false,finishedAt:0,drag:null};
  document.body.classList.add('play-mode','sin-interaction-open','sin-rps-active');
  const overlay=$('sinRpsOverlay');overlay.hidden=false;overlay.classList.toggle('editing',editing);
  $('sinRpsToolbar').style.display=editing?'flex':'none';$('sinRpsResetLayout').hidden=!editing;
  const current=sinRpsSession;
  prepareSinTowerRpsImages().then(()=>{if(sinRpsSession!==current||current.revealed)return;current.ready=true;current.deadline=performance.now()+5000;updateSinTowerRps();}).catch(()=>{if(sinRpsSession===current){setStatus('猜拳圖片無法載入，已取消本局。');closeSinTowerInteraction(true,false,true);}});
  updateSinTowerRps();
}
function settleSinTowerRps(now=performance.now()){
  const s=sinRpsSession;if(!s||s.editing||s.revealed||now<s.deadline)return;
  s.revealed=true;s.finishedAt=now;
  if(sinTowerPlayObjectUi.resultSession)sinTowerPlayObjectUi.resultSession.postReady=true;
  s.outcome=sinTowerRpsOutcome(SIN_RPS_KINDS[s.selected],s.opponent);
  const session=sinTowerPlayObjectUi.resultSession;
  if(session?.object===s.object&&!session.preview&&!session.applied){
    session.applied=true;
    if(s.outcome==='win'){changeSinTowerInfectionLayers(-Math.max(0,SIN_TOWER_INFECTION.level||0));startSinTowerRpsBlink(s,'win');}
    if(s.outcome==='lose'){s.addedLayers=null;startSinTowerRpsBlink(s,'lose');}
  }
}
const sinTowerRpsBlinks=[];
function startSinTowerRpsBlink(session,kind){
  if(sinTowerRpsBlinks.some(e=>e.object.id===session.object.id))return;
  const rec=sinTowerEditorRuntime.props.get(session.object.id)||sinTowerEditorRuntime.models.get(session.object.id);
  if(!rec)return;
  const root=rec.model?rec.group:rec.root;
  const object=getSinTowerEditorObjectById(session.object.id,rec.model?'model':'prop')||session.object;
  if(kind==='win'){
    for(const target of new Set([object,session.object,rec.prop,rec.model].filter(Boolean))){
      target.interaction.glowEnabledBeforeDissolve=target.interaction.glowEnabled!==false;
      target.interaction.dissolving=true;
    }
  }
  let overlay=$('sinRpsLossFlash');
  if(kind==='lose'&&!overlay){overlay=document.createElement('div');overlay.id='sinRpsLossFlash';overlay.setAttribute('aria-hidden','true');overlay.style.cssText='position:fixed;inset:0;z-index:9500;background:#000;opacity:0;pointer-events:none';document.body.append(overlay);}
  sinTowerRpsBlinks.push({session,object,rec,root,kind,sceneId:object.sceneId,phase:0,phaseAt:performance.now(),originalVisible:root?.visible!==false});
  updateSinTowerRpsBlinks();
}
function cancelSinTowerRpsBlinks(){
  for(const e of sinTowerRpsBlinks){if(e.root)e.root.visible=e.originalVisible;for(const target of new Set([e.object,e.session.object,e.rec.prop,e.rec.model].filter(Boolean)))if(target.interaction)target.interaction.dissolving=false;}
  sinTowerRpsBlinks.length=0;if($('sinRpsLossFlash'))$('sinRpsLossFlash').style.opacity='0';
}
function updateSinTowerRpsBlinks(now=performance.now()){
  let flash=false;
  for(let i=sinTowerRpsBlinks.length-1;i>=0;i--){
    const e=sinTowerRpsBlinks[i];
    if(e.sceneId!==SIN_TOWER_EDITOR.activeSceneId){
      // Resolve an already decided match before leaving, without flashing another scene.
      e.phase=10;
    }else if(now-e.phaseAt>=(e.phase%2===0?140:200)){
      // Advance at most one edge per rendered frame: slow frames cannot skip all flashes.
      e.phase++;e.phaseAt=now;
    }
    if(e.phase>=10){
      if(e.kind==='win')finishSinTowerQuestionDissolve({rec:e.rec,object:e.object,materialRecords:[]});
      else e.session.addedLayers=changeSinTowerInfectionLayers(10);
      sinTowerRpsBlinks.splice(i,1);continue;
    }
    if(e.kind==='win'&&e.root)e.root.visible=e.phase%2!==0;
    if(e.kind==='lose'&&e.phase%2===0)flash=true;
  }
  if($('sinRpsLossFlash'))$('sinRpsLossFlash').style.opacity=flash?'.55':'0';
}

function getSinTowerRpsAnchor(v){
  const point=player.position.clone().project(camera);
  return{x:v.left+clamp((point.x+1)*.5,.22,.78)*v.width,y:v.top+clamp((1-point.y)*.5,.32,.67)*v.height};
}
function updateSinTowerRps(){
  const s=sinRpsSession;if(!s)return;
  if(s.object.sceneId!==SIN_TOWER_EDITOR.activeSceneId||(!s.editing&&!s.object.interaction?.enabled)||s.object.interaction.type!=='rps'||!(sinTowerEditorRuntime.props.get(s.object.id)||sinTowerEditorRuntime.models.get(s.object.id))){closeSinTowerInteraction(true,false,true);return;}
  const now=performance.now();settleSinTowerRps(now);
  if(s.revealed&&now-s.finishedAt>4000){closeSinTowerInteraction(true,false,true);return;}
  const v=getSinTowerGameViewport(),anchor=getSinTowerRpsAnchor(v),layout=s.object.interaction.rpsLayout;
  s.viewport=v;s.anchor=anchor;
  for(let i=0;i<4;i++){
    const card=$('sinRpsCard'+i),p=layout[i];card.hidden=i===3&&!s.revealed&&!s.editing;
    const w=Math.min(v.width*.8,p.w*v.width),h=Math.min(v.height*.8,p.h*v.height);
    const x=clamp(anchor.x+p.x*v.width-w/2,v.left+6,v.left+v.width-w-6),y=clamp(anchor.y+p.y*v.height-h/2,v.top+45,v.top+v.height-h-28);
    Object.assign(card.style,{left:x+'px',top:y+'px',width:w+'px',height:h+'px'});
    const kind=i<3?SIN_RPS_KINDS[i]:(s.editing?'rock':s.opponent),img=card.querySelector('img');
    if(img.dataset.kind!==kind){img.dataset.kind=kind;img.src=SIN_RPS_IMAGES[kind];}
    // Hand images carry no visible labels; aria-label remains for accessibility.
    card.classList.toggle('selected',i===s.selected&&i<3);card.setAttribute('aria-pressed',String(i===s.selected));
  }
  const status=$('sinRpsStatus');status.style.left=v.left+'px';status.style.width=v.width+'px';status.style.top=(v.top+v.height*.22)+'px';
  status.textContent=s.editing?'拖曳圖片與四角調整版面':!s.ready&&!s.revealed?'載入圖片…':s.revealed?'':String(Math.max(1,Math.ceil((s.deadline-now)/1000)));
  const canvas=$('sinRpsParticles');if(canvas.width!==innerWidth||canvas.height!==innerHeight){canvas.width=innerWidth;canvas.height=innerHeight;}
  const ctx=canvas.getContext('2d');ctx.clearRect(0,0,canvas.width,canvas.height);
  if(s.revealed){
    const r=$('sinRpsCard3').getBoundingClientRect(),t=(now-s.finishedAt)/1000;
    ctx.fillStyle='#ffeaa0';ctx.shadowColor='#ffe16b';ctx.shadowBlur=5;
    for(let i=0;i<140;i++){
      const life=(t*(.38+(i%7)*.045)+i*.61803398875)%1;
      const spread=Math.sin(i*7.91),x=r.left+r.width*(.5+spread*.42)+spread*life*35;
      const y=r.bottom-r.height*.35-life*(r.height+65);
      ctx.globalAlpha=(1-life)*.85;ctx.beginPath();ctx.arc(x,y,.55+(i%3)*.3,0,Math.PI*2);ctx.fill();
    }
    ctx.globalAlpha=1;ctx.shadowBlur=0;
  }
}
function commitSinTowerRpsLayout(){
  const s=sinRpsSession;if(!s)return;
  const layout=sanitizeSinTowerRpsLayout(s.object.interaction.rpsLayout);
  const object=SIN_TOWER_EDITOR.props.find(o=>o.id===s.object.id)||SIN_TOWER_EDITOR.models.find(o=>o.id===s.object.id)||s.object;
  object.interaction.rpsLayout=layout;s.object=object;
  const indexed=getSinTowerEditorObjectById(object.id);if(indexed?.interaction)indexed.interaction.rpsLayout=layout;
  const rec=sinTowerEditorRuntime.props.get(object.id)||sinTowerEditorRuntime.models.get(object.id);if(rec){if(rec.model)rec.model=object;else rec.prop=object;}
  scheduleSinTowerRuntimeSave();
}
function beginSinTowerRpsDrag(e,index){
  const s=sinRpsSession;if(!s?.editing)return;
  e.preventDefault();e.stopPropagation();const card=$('sinRpsCard'+index),start={...s.object.interaction.rpsLayout[index]},corner=e.target.dataset.corner;
  const x=e.clientX,y=e.clientY,v=s.viewport;card.setPointerCapture(e.pointerId);
  card.onpointermove=ev=>{
    if(sinRpsSession!==s)return;const dx=(ev.clientX-x)/v.width,dy=(ev.clientY-y)/v.height,p=s.object.interaction.rpsLayout[index];
    if(corner){const sx=corner.includes('e')?1:-1,sy=corner.includes('s')?1:-1;
      const factor=clamp(1+(Math.abs(dx/start.w)>Math.abs(dy/start.h)?sx*dx/start.w:sy*dy/start.h),Math.max(.025/start.w,.035/start.h),Math.min(.8/start.w,.8/start.h));
      p.w=start.w*factor;p.h=start.h*factor;p.x=start.x+sx*(p.w-start.w)/2;p.y=start.y+sy*(p.h-start.h)/2;
    }else{p.x=clamp(start.x+dx,-1,1);p.y=clamp(start.y+dy,-1,1);}
    updateSinTowerRps();
  };
  const end=()=>{card.onpointermove=null;card.onpointerup=null;card.onpointercancel=null;commitSinTowerRpsLayout();};
  card.onpointerup=end;card.onpointercancel=end;
}
function handleSinTowerRpsKey(e){
  const s=sinRpsSession;if(!s)return false;
  if(isTextEditingElement(e.target))return false;
  e.preventDefault();e.stopImmediatePropagation();
  if(e.code==='Escape'){closeSinTowerInteraction(true,false,true);return true;}
  if(!s.editing&&!s.revealed&&(e.code==='ArrowLeft'||e.code==='ArrowRight'||e.code==='KeyA'||e.code==='KeyD')){
    if(!e.repeat)s.selected=(s.selected+((e.code==='ArrowRight'||e.code==='KeyD')?1:2))%3;
    updateSinTowerRps();
  }
  return true;
}
function cleanupSinTowerRps(){const returnToPerf=sinRpsSession?.returnToPerf;document.body.classList.remove('sin-rps-active');sinRpsSession=null;const overlay=$('sinRpsOverlay');if(overlay)overlay.hidden=true;if(returnToPerf)queueMicrotask(()=>{enterSinTowerEditorMode();setSinProTab('perf');syncSinProEditor();});}

function openSinTowerInteraction(rec, nearest){
  if(isSinTowerInteractionPlacementActive())return;
  const prop = rec?.prop || rec?.model;
  const config = prop?.interaction;
  if(config?.type==='rps'){openSinTowerRps(rec,nearest);return;}
  if(config?.type==='question'){openSinTowerQuestionInteraction(rec,nearest);return;}
  const overlay = $('sinInteractionOverlay');
  if(!prop || !config?.enabled || config.consumed || config.dissolving || !overlay || sinTowerPlayObjectUi.panelOpen || sinTowerPlayObjectUi.activePropId) return;
  sinTowerPlayObjectUi.resultSession={object:prop,type:config.type,preview:false,applied:false};
  sinTowerPlayObjectUi.activePropId = prop.id;
  sinTowerPlayObjectUi.dismissedPropId = null;
  sinTowerPlayObjectUi.dismissedWorldPosition = null;
  sinTowerPlayObjectUi.activeWorldPosition = nearest.position.clone();
  applySinTowerInteractionStyle(config);
  sinTowerPlayObjectUi.lastPlayerPosition.copy(player.position);
  sinTowerPlayObjectUi.interactionFrame = -1;
  sinTowerPlayObjectUi.previousAutoRun = !!SIN_TOWER_STAIRCASE.autoRun;
  SIN_TOWER_STAIRCASE.autoRun = false;
  $('sinInteractionTitle').textContent = config.title || prop.title || '';
  const scroll = $('sinInteractionScroll');
  const media = $('sinInteractionMedia');
  const image = $('sinInteractionImage');
  const video = $('sinInteractionVideo');
  scroll.scrollTop = 0;
  scroll.textContent = config.type === 'text' ? (config.text || '……') : '';
  scroll.style.display = config.type === 'text' ? 'block' : 'none';
  media.classList.toggle('active', config.type === 'media');
  image.classList.remove('active');
  video.classList.remove('active');
  video.pause?.();
  video.removeAttribute('src');
  if(config.type === 'media'){
    const videoSrc = config.videoDataUrl || (prop.mediaType === 'video' ? prop.videoDataUrl : null);
    const imageSrc = prop.mediaType === 'gif' ? prop.gifDataUrl : prop.frames?.[0]?.dataUrl;
    if(videoSrc){
      video.src = videoSrc;
      video.classList.add('active');
      video.loop = true;
      video.muted = true;
      video.play().catch(()=>{});
    }else if(imageSrc){
      image.src = imageSrc;
      image.classList.add('active');
    }
  }
  clearTimeout(sinTowerPlayObjectUi.closingTimer);
  overlay.classList.remove('open','closing');
  overlay.classList.add('opening');
  overlay.setAttribute('aria-hidden','false');
  document.body.classList.add('play-mode','sin-interaction-open');
  requestAnimationFrame(()=>requestAnimationFrame(()=>{
    if(sinTowerPlayObjectUi.activePropId !== prop.id) return;
    overlay.classList.remove('opening');
    overlay.classList.add('open');
  }));
  setSinTowerModalCursorFree();
}

function finalizeSinTowerInteractionClose(restore=true, requestLock=false){
  const post=sinTowerPlayObjectUi.resultSession;
  const postObject=post?.postReady&&!post.preview&&post.object?.interaction?.afterVideo?.enabled?post.object:null;
  cleanupSinTowerRps();
  const overlay = $('sinInteractionOverlay');
  overlay?.classList.remove('opening','open','closing');
  const questionOverlay=$('sinQuestionOverlay');
  questionOverlay?.classList.remove('open','closing');$('sinQuestionBar')?.classList.remove('answered');questionOverlay?.setAttribute('aria-hidden','true');
  document.body.classList.remove('sin-question-open');
  clearTimeout(sinTowerPlayObjectUi.questionTimer);sinTowerPlayObjectUi.questionTimer=null;
  sinTowerPlayObjectUi.questionTypewriterToken+=1;$('sinQuestionText')?.classList.remove('typing');
  sinTowerPlayObjectUi.questionPointerId=null;setSinTowerQuestionDrag(0);
  overlay?.setAttribute('aria-hidden','true');
  document.body.classList.remove('sin-interaction-open');
  const video = $('sinInteractionVideo');
  try{ video?.pause?.(); }catch(e){}
  if(video){ video.removeAttribute('src'); video.load?.(); }
  sinTowerPlayObjectUi.resultSession=null;
  sinTowerPlayObjectUi.activePropId = null;
  sinTowerPlayObjectUi.activeWorldPosition = null;
  sinTowerPlayObjectUi.interactionFrame = -1;
  SIN_TOWER_STAIRCASE.autoRun = !!sinTowerPlayObjectUi.previousAutoRun;
  clearMovementKeys();
  if(restore) restoreSinTowerPlayLook(requestLock);
  if(postObject)queueMicrotask(()=>{if(!sinTowerPlayObjectUi.activePropId&&!sinAfterVideoSession&&postObject.sceneId===SIN_TOWER_EDITOR.activeSceneId&&!isSinTowerInteractionPlacementActive())showSinAfterVideo(postObject);});
}

function closeSinTowerInteraction(restore=true, requestLock=false, immediate=false){
  if(sinRpsSession)immediate=true;
  const postSession=sinTowerPlayObjectUi.resultSession;
  if(postSession&&['text','media'].includes(postSession.type))postSession.postReady=true;
  if(!sinTowerPlayObjectUi.activePropId) return;
  if(restore)hideSinInteractionCursor();
  if(sinTowerPlayObjectUi.resultSession?.type==='text')applySinTowerInteractionInfectionEffect();
  sinTowerPlayObjectUi.dismissedPropId = sinTowerPlayObjectUi.activePropId;
  sinTowerPlayObjectUi.dismissedWorldPosition = sinTowerPlayObjectUi.activeWorldPosition?.clone?.() || null;
  sinTowerPlayObjectUi.interactionCooldownUntil = performance.now() + (immediate ? 250 : 1150);
  const overlay = $('sinInteractionOverlay');
  $('sinQuestionOverlay')?.classList.add('closing');
  clearTimeout(sinTowerPlayObjectUi.closingTimer);
  if(immediate){ finalizeSinTowerInteractionClose(restore,requestLock); return; }
  overlay?.classList.remove('opening','open');
  overlay?.classList.add('closing');
  sinTowerPlayObjectUi.closingTimer = setTimeout(()=>finalizeSinTowerInteractionClose(restore,requestLock), 1050);
}

const sinTowerInteractionScratchPosition=new THREE.Vector3();
function isSinTowerInteractionPlacementActive(){
  return !!(sinTowerPlayObjectUi.followPropId || sinTowerModelCarry.active);
}
function suspendSinTowerInteractionsForPlacement(){
  if(!sinTowerPlayObjectUi.activePropId)return;
  clearTimeout(sinTowerPlayObjectUi.closingTimer);sinTowerPlayObjectUi.closingTimer=null;
  if(sinRpsSession)sinRpsSession.returnToPerf=false;
  // Cancel an editing interruption without awarding document/question results.
  finalizeSinTowerInteractionClose(false,false);
}
function updateSinTowerPropInteractions(){
  if(sinAfterVideoSession)return;
  if(isSinTowerInteractionPlacementActive()&&!sinRpsSession?.editing){suspendSinTowerInteractionsForPlacement();return;}
  if(sinRpsSession){updateSinTowerRps();return;}
  if(sinTowerPlayObjectUi.panelOpen)return;const activeId=sinTowerPlayObjectUi.activePropId;
  if(activeId){const rec=sinTowerEditorRuntime.props.get(activeId)||sinTowerEditorRuntime.models.get(activeId),prop=rec?.prop||rec?.model,p=sinTowerPlayObjectUi.activeWorldPosition;if(!prop||!p){closeSinTowerInteraction(true,false,true);return;}if(prop.interaction?.type==='media'&&prop.mediaType!=='video'&&prop.frames?.length&&$('sinInteractionImage')?.classList.contains('active')){const frame=rec.frame||0;if(frame!==sinTowerPlayObjectUi.interactionFrame){sinTowerPlayObjectUi.interactionFrame=frame;$('sinInteractionImage').src=prop.frames[frame%prop.frames.length].dataUrl;}}const dx=player.position.x-p.x,dz=player.position.z-p.z,dy=(player.position.y-p.y)*.35,distance=Math.sqrt(dx*dx+dz*dz+dy*dy),moved=player.position.distanceToSquared(sinTowerPlayObjectUi.lastPlayerPosition)>.0025;sinTowerPlayObjectUi.lastPlayerPosition.copy(player.position);if(moved&&(keys.w||keys.a||keys.s||keys.d)&&distance>safeFinite(prop.interaction?.radius,3.2)*1.14)closeSinTowerInteraction(true,false);return;}
  const now=performance.now();if(now<safeFinite(sinTowerPlayObjectUi.interactionCooldownUntil,0)||now-safeFinite(sinTowerPlayObjectUi.lastInteractionScan,0)<33)return;sinTowerPlayObjectUi.lastInteractionScan=now;
  const dismissed=sinTowerPlayObjectUi.dismissedPropId;if(dismissed){const rec=sinTowerEditorRuntime.props.get(dismissed)||sinTowerEditorRuntime.models.get(dismissed),object=rec?.prop||rec?.model,p=sinTowerPlayObjectUi.dismissedWorldPosition;if(p){const dx=player.position.x-p.x,dz=player.position.z-p.z,dy=(player.position.y-p.y)*.35,distance=Math.sqrt(dx*dx+dz*dz+dy*dy),rearmDistance=safeFinite(object?.interaction?.radius,3.2)+Math.max(.38,safeFinite(object?.interaction?.radius,3.2)*.12);if(distance<=rearmDistance)return;}sinTowerPlayObjectUi.dismissedPropId=null;sinTowerPlayObjectUi.dismissedWorldPosition=null;}
  for(const rec of sinTowerEditorRuntime.props.values()){const prop=rec?.prop;if(!prop?.interaction?.enabled||prop.interaction.consumed||prop.interaction.dissolving||prop.sceneId!==SIN_TOWER_EDITOR.activeSceneId)continue;const nearest=nearestSinTowerPropVisual(rec),radius=safeFinite(prop.interaction.radius,3.2);if(nearest&&nearest.distanceSquared<=radius*radius){openSinTowerInteraction(rec,{...nearest,position:nearest.position.clone()});return;}}
  for(const rec of sinTowerEditorRuntime.models.values()){const model=rec?.model;if(!model?.interaction?.enabled||model.interaction.consumed||model.interaction.dissolving||model.sceneId!==SIN_TOWER_EDITOR.activeSceneId||!rec.group?.visible)continue;rec.group.getWorldPosition(sinTowerInteractionScratchPosition);const dx=player.position.x-sinTowerInteractionScratchPosition.x,dz=player.position.z-sinTowerInteractionScratchPosition.z,dy=(player.position.y-sinTowerInteractionScratchPosition.y)*.35,radius=safeFinite(model.interaction.radius,3.2),distanceSquared=dx*dx+dz*dz+dy*dy;if(distanceSquared<=radius*radius){openSinTowerInteraction(rec,{distance:Math.sqrt(distanceSquared),position:sinTowerInteractionScratchPosition.clone()});return;}}
}

function closeSinTowerPlayPropActions(clearSelection=true){
  sinTowerPlayObjectUi.selectedVisual = null;
  if(clearSelection){
    const selectedType=sinTowerPlayObjectUi.selectedPlayType;
    sinTowerPlayObjectUi.selectedPropId = null;
    sinTowerPlayObjectUi.selectedPlayType = null;
    if(SIN_TOWER_EDITOR.selectedObjectType === selectedType){
      SIN_TOWER_EDITOR.selectedObjectType = null;
      SIN_TOWER_EDITOR.selectedObjectId = null;
    }
  }
  const panel = $('sinPlayObjectActions');
  panel?.classList.remove('open');
  panel?.setAttribute('aria-hidden','true');
}

function getSinTowerSelectedPlayProp(){
  if(sinTowerPlayObjectUi.selectedPlayType!=='prop') return null;
  return getSinTowerEditorObjectById(sinTowerPlayObjectUi.selectedPropId,'prop');
}

function getSinTowerSelectedPlayModel(){
  if(sinTowerPlayObjectUi.selectedPlayType!=='model') return null;
  return getSinTowerEditorObjectById(sinTowerPlayObjectUi.selectedPropId,'model');
}

function getSinTowerSelectedPlayPortal(){
  if(sinTowerPlayObjectUi.selectedPlayType!=='portal') return null;
  return getSinTowerEditorObjectById(sinTowerPlayObjectUi.selectedPropId,'portal');
}

function getSinTowerSelectedPlayObject(){
  return getSinTowerSelectedPlayPortal()||getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp();
}

const sinTowerAudioRuntime={scene:null,objects:new Map(),unlocked:false,lastUpdate:0,worldPoint:new THREE.Vector3(),context:null,retiring:new Set()};
function sinAudioContext(){if(!sinTowerAudioRuntime.context){const C=window.AudioContext||window.webkitAudioContext;if(C)sinTowerAudioRuntime.context=new C();}return sinTowerAudioRuntime.context;}
function sinAudioLevel(entry){const r=entry.ramp;if(!r)return entry.gain?entry.gain.gain.value:entry.audio.volume;const t=clamp((performance.now()-r.start)/r.duration,0,1);return r.from+(r.to-r.from)*t;}
function rampSinAudio(entry,target,duration=650){
  if(!entry)return;target=clamp(target,0,1);if(entry.ramp?.to===target)return;
  const from=sinAudioLevel(entry);entry.ramp={from,to:target,start:performance.now(),duration};
  if(entry.gain){const p=entry.gain.gain,t=sinTowerAudioRuntime.context.currentTime;p.cancelScheduledValues(t);p.setValueAtTime(from,t);p.linearRampToValueAtTime(target,t+duration/1000);}
  else{clearTimeout(entry.fadeTimer);const tick=()=>{entry.audio.volume=sinAudioLevel(entry);if(performance.now()-entry.ramp.start<entry.ramp.duration)entry.fadeTimer=setTimeout(tick,16);};tick();}
}
function stopSinTowerAudioEntry(entry){
  if(!entry||entry.retiring)return;entry.retiring=true;entry.targetVolume=0;sinTowerAudioRuntime.retiring.add(entry);rampSinAudio(entry,0);
  entry.stopTimer=setTimeout(()=>{try{entry.audio.pause();entry.audio.removeAttribute('src');entry.audio.load?.();entry.source?.disconnect();entry.gain?.disconnect();}catch{}clearTimeout(entry.fadeTimer);entry.pending=null;sinTowerAudioRuntime.retiring.delete(entry);},700);
}
function makeSinTowerAudioEntry(key,cfg){
  const audio=new Audio();audio.preload='auto';audio.loop=cfg.loop!==false;audio.src=cfg.dataUrl;audio.volume=0;
  const entry={key,audio,url:cfg.dataUrl,pending:null,targetVolume:0},context=sinAudioContext();
  if(context){entry.source=context.createMediaElementSource(audio);entry.gain=context.createGain();entry.gain.gain.value=0;entry.source.connect(entry.gain).connect(context.destination);audio.volume=1;}return entry;
}
function playSinTowerAudioEntry(entry){
  if(!entry||entry.retiring||!sinTowerAudioRuntime.unlocked||!entry.audio.paused||entry.pending||(!entry.audio.loop&&entry.audio.ended))return;
  entry.pending=entry.audio.play().then(()=>{if(!entry.retiring)rampSinAudio(entry,entry.targetVolume);}).catch(()=>{}).finally(()=>entry.pending=null);
}
function targetSinAudio(entry,target){
  target=document.hidden?0:target;entry.targetVolume=target;
  if(target>.0001){clearTimeout(entry.silentTimer);entry.silentTimer=null;if(entry.audio.paused)playSinTowerAudioEntry(entry);else rampSinAudio(entry,target);}
  else{rampSinAudio(entry,0);if(!entry.audio.paused&&!entry.silentTimer)entry.silentTimer=setTimeout(()=>{entry.silentTimer=null;if(entry.targetVolume===0&&!entry.retiring)entry.audio.pause();},700);}
}
function unlockSinTowerAudio(){if(sinTowerAudioRuntime.unlocked&&sinTowerAudioRuntime.context?.state==='running')return;sinTowerAudioRuntime.unlocked=true;void sinAudioContext()?.resume();void prepareSinMonkHitSound();updateSinTowerAudioRuntime(true);}
window.addEventListener('pointerdown',unlockSinTowerAudio,{capture:true,passive:true});
window.addEventListener('keydown',unlockSinTowerAudio,{capture:true});
document.addEventListener('visibilitychange',()=>updateSinTowerAudioRuntime(true));
function sinTowerObjectAudioDistance(object,type){
  const target=sinTowerAudioRuntime.worldPoint;let best=Infinity;
  if(type==='prop')for(const visual of sinTowerEditorRuntime.props.get(object.id)?.visuals||[]){if(visual.group?.visible===false)continue;visual.group.getWorldPosition(target);best=Math.min(best,player.position.distanceTo(target));}
  else{const rec=type==='model'?sinTowerEditorRuntime.models.get(object.id):type==='portal'?sinTowerEditorRuntime.portals.get(object.id):sinTowerEditorRuntime.stones.get(object.id);const node=rec?.group||rec?.mesh;if(node&&node.visible!==false){node.getWorldPosition(target);best=player.position.distanceTo(target);}}return best;
}
function syncSinTowerSceneAudioRuntime(){
  const sceneState=getSinTowerActiveScene(),cfg=sceneState?.audio;
  if(!cfg?.dataUrl){stopSinTowerAudioEntry(sinTowerAudioRuntime.scene);sinTowerAudioRuntime.scene=null;return;}
  let entry=sinTowerAudioRuntime.scene;if(!entry||entry.key!==sceneState.id||entry.url!==cfg.dataUrl){stopSinTowerAudioEntry(entry);entry=makeSinTowerAudioEntry(sceneState.id,cfg);sinTowerAudioRuntime.scene=entry;}
  entry.audio.loop=cfg.loop!==false;targetSinAudio(entry,clamp(safeFinite(cfg.volume,.7),0,1));
}
function updateSinTowerAudioRuntime(force=false){
  const now=performance.now();if(!force&&now-sinTowerAudioRuntime.lastUpdate<80)return;sinTowerAudioRuntime.lastUpdate=now;syncSinTowerSceneAudioRuntime();
  const active=SIN_TOWER_EDITOR.activeSceneId,live=new Set(),groups=[['prop',SIN_TOWER_EDITOR.props],['model',SIN_TOWER_EDITOR.models],['portal',SIN_TOWER_EDITOR.portals],['stone',SIN_TOWER_EDITOR.stones]];
  for(const [type,items] of groups)for(const object of items){const cfg=object.audio;if(object.sceneId!==active||!cfg?.dataUrl||object.interaction?.consumed)continue;const key=type+':'+object.id;live.add(key);let entry=sinTowerAudioRuntime.objects.get(key);if(!entry||entry.url!==cfg.dataUrl){stopSinTowerAudioEntry(entry);entry=makeSinTowerAudioEntry(key,cfg);sinTowerAudioRuntime.objects.set(key,entry);}entry.audio.loop=cfg.loop!==false;const distance=sinTowerObjectAudioDistance(object,type),ratio=Number.isFinite(distance)?clamp(1-distance/clamp(safeFinite(cfg.maxDistance,18),1,100),0,1):0;targetSinAudio(entry,clamp(safeFinite(cfg.volume,.85),0,1)*Math.pow(ratio,1.35));}
  for(const [key,entry] of sinTowerAudioRuntime.objects)if(!live.has(key)){stopSinTowerAudioEntry(entry);sinTowerAudioRuntime.objects.delete(key);}
}
let sinMonkHitBuffer=null,sinMonkHitPromise=null;const sinMonkHitVoices=new Set();
function prepareSinMonkHitSound(){return sinMonkHitPromise ||= (async()=>{const context=sinAudioContext();if(!context)return;sinMonkHitBuffer=await context.decodeAudioData(await (await fetch(SIN_MONK_HIT_SOUND)).arrayBuffer());})().catch(error=>{sinMonkHitPromise=null;console.warn('Monk collision sound unavailable',error);});}
function playSinMonkHitSound(){
  const context=sinAudioContext();if(!sinTowerAudioRuntime.unlocked||!context||!sinMonkHitBuffer||sinMonkHitVoices.size>=8)return;
  const source=context.createBufferSource(),gain=context.createGain(),t=context.currentTime,d=sinMonkHitBuffer.duration;source.buffer=sinMonkHitBuffer;source.connect(gain).connect(context.destination);gain.gain.setValueAtTime(0,t);gain.gain.linearRampToValueAtTime(.9,t+.008);gain.gain.setValueAtTime(.9,t+Math.max(.009,d-.06));gain.gain.linearRampToValueAtTime(0,t+d);sinMonkHitVoices.add(source);source.onended=()=>{sinMonkHitVoices.delete(source);source.disconnect();gain.disconnect();};source.start();
}

function getSinTowerSelectedAudioObject(){return getSinTowerSelectedPlayObject()||(['prop','model','portal','stone'].includes(SIN_TOWER_EDITOR.selectedObjectType)?getSinTowerEditorObjectById(SIN_TOWER_EDITOR.selectedObjectId,SIN_TOWER_EDITOR.selectedObjectType):null);}
function syncSinTowerSceneAudioControls(sceneState=getSinTowerActiveScene()){const cfg=sceneState?.audio||sanitizeSinTowerAudio(null,false);if($('sinSceneAudioState'))$('sinSceneAudioState').textContent=cfg.dataUrl?'已置入：'+(cfg.name||'場景音效'):'尚未置入場景音效。';if($('sinSceneAudioVolume')&&document.activeElement!==$('sinSceneAudioVolume'))$('sinSceneAudioVolume').value=String(Math.round(cfg.volume*100));if($('sinSceneAudioVolumeValue'))$('sinSceneAudioVolumeValue').textContent=Math.round(cfg.volume*100)+'%';if($('sinSceneAudioLoop'))$('sinSceneAudioLoop').checked=cfg.loop!==false;}
function syncSinTowerSelectedObjectAudioControls(object=getSinTowerSelectedAudioObject()){const panel=$('sinSelectedObjectAudioControls');if(panel)panel.hidden=!object;if(!object)return;const cfg=object.audio||sanitizeSinTowerAudio(null,true);if($('sinSelectedObjectAudioState'))$('sinSelectedObjectAudioState').textContent=cfg.dataUrl?'已置入：'+(cfg.name||'物件音效'):'尚未置入物件音效。';if($('sinSelectedObjectAudioVolume')&&document.activeElement!==$('sinSelectedObjectAudioVolume'))$('sinSelectedObjectAudioVolume').value=String(Math.round(cfg.volume*100));if($('sinSelectedObjectAudioVolumeValue'))$('sinSelectedObjectAudioVolumeValue').textContent=Math.round(cfg.volume*100)+'%';if($('sinSelectedObjectAudioDistance')&&document.activeElement!==$('sinSelectedObjectAudioDistance'))$('sinSelectedObjectAudioDistance').value=String(cfg.maxDistance);if($('sinSelectedObjectAudioDistanceValue'))$('sinSelectedObjectAudioDistanceValue').textContent=cfg.maxDistance.toFixed(1);if($('sinSelectedObjectAudioLoop'))$('sinSelectedObjectAudioLoop').checked=cfg.loop!==false;}
async function importSinTowerSceneAudio(file){const sceneState=getSinTowerActiveScene();if(!sceneState||!file)return;unlockSinTowerAudio();const loaded=await readSinTowerAudioFile(file);sceneState.audio=sanitizeSinTowerAudio({...sceneState.audio,...loaded},false);scheduleSinTowerRuntimeSave();syncSinTowerSceneAudioControls(sceneState);updateSinTowerAudioRuntime(true);setStatus('已為場景「'+sceneState.title+'」置入音效：'+loaded.name);}
async function importSinTowerSelectedObjectAudio(file){const object=getSinTowerSelectedAudioObject();if(!object||!file)return;unlockSinTowerAudio();const loaded=await readSinTowerAudioFile(file);object.audio=sanitizeSinTowerAudio({...object.audio,...loaded},true);scheduleSinTowerRuntimeSave();syncSinTowerSelectedObjectAudioControls(object);updateSinTowerAudioRuntime(true);setStatus('已為物件「'+object.title+'」置入距離音效：'+loaded.name);}
function updateSinTowerSceneAudioFromUi(){const sceneState=getSinTowerActiveScene();if(!sceneState)return;sceneState.audio=sanitizeSinTowerAudio({...sceneState.audio,volume:safeFinite($('sinSceneAudioVolume')?.value,70)/100,loop:$('sinSceneAudioLoop')?.checked!==false},false);scheduleSinTowerRuntimeSave();syncSinTowerSceneAudioControls(sceneState);updateSinTowerAudioRuntime(true);}
function updateSinTowerSelectedObjectAudioFromUi(){const object=getSinTowerSelectedAudioObject();if(!object)return;object.audio=sanitizeSinTowerAudio({...object.audio,volume:safeFinite($('sinSelectedObjectAudioVolume')?.value,85)/100,maxDistance:safeFinite($('sinSelectedObjectAudioDistance')?.value,18),loop:$('sinSelectedObjectAudioLoop')?.checked!==false},true);scheduleSinTowerRuntimeSave();syncSinTowerSelectedObjectAudioControls(object);updateSinTowerAudioRuntime(true);}

function syncSinTowerSelectedPortalRoute(portal){
  const panel=$('sinSelectedPortalRoute'),source=$('sinSelectedPortalSource'),target=$('sinSelectedPortalTarget'),enabled=$('sinSelectedPortalPasswordEnabled'),password=$('sinSelectedPortalPassword');
  if(panel) panel.hidden=!portal;
  if(!portal||!source||!target) return;
  fillSinTowerPortalSceneSelect(source,portal.sceneId,true);
  fillSinTowerPortalSceneSelect(target,portal.targetSceneId,true);
  source.value=portal.sceneId;
  if(SIN_TOWER_EDITOR.scenes.some(sceneState=>sceneState.id===portal.targetSceneId)) target.value=portal.targetSceneId;
  if(enabled) enabled.checked=!!portal.passwordEnabled;
  if(password){password.value=sanitizeSinTowerPortalPassword(portal.password);password.disabled=!portal.passwordEnabled;}
}

function syncSinTowerPlayPropActions(){
  const portal=getSinTowerSelectedPlayPortal();
  const model=getSinTowerSelectedPlayModel();
  const prop=getSinTowerSelectedPlayProp();
  const object=portal||model||prop;
  const panel=$('sinPlayObjectActions');
  if(!object||!panel){closeSinTowerPlayPropActions(true);return;}
  const type=portal?'portal':model?'model':'prop';
  $('sinSelectedPropTitle').textContent=object.title||(portal?'魔法傳送門':model?'3D 模型':'新增物件');
  const following=sinTowerPlayObjectUi.followPropId===object.id&&sinTowerPlayObjectUi.followObjectType===type;
  $('sinSelectedPropFollow').textContent=following?'固定在目前位置':'跟隨角色移動';
  const rotation=portal?safeFinite(object.rotationY,0):model?safeFinite(object.rotation?.y,0):safeFinite(object.rotationZ,0);
  $('sinSelectedPropRotate').textContent='旋轉 +15°（目前 '+Math.round(rotation)+'°）';
  const scaleSlider=$('sinSelectedPropScale'),scaleValue=$('sinSelectedPropScaleValue');
  const proportionalSize=portal
    ?clamp(safeFinite(object.uniformScale,1),.2,240)
    :model
      ?clamp((safeFinite(object.scale?.x,1)+safeFinite(object.scale?.y,1)+safeFinite(object.scale?.z,1))/3,.01,400)
      :clamp(safeFinite(object.height,3),.1,600);
  if(scaleSlider){
    scaleSlider.min=portal?'.2':model?'.01':'.1';
    scaleSlider.max=portal?'240':model?'400':'600';
    scaleSlider.step=model?'.01':'.05';
    if(document.activeElement!==scaleSlider) scaleSlider.value=String(proportionalSize);
  }
  if(scaleValue) scaleValue.textContent=proportionalSize.toFixed(2);
  syncSinSelectedVideoFilter(object);
  syncSinTowerSelectedObjectAudioControls(object);
  syncSinTowerSelectedPortalRoute(portal);

  const interactionPanel=$('sinSelectedInteractionStyle');
  const interaction=!portal&&object.interaction?.enabled?object.interaction:null;
  if(interactionPanel) interactionPanel.hidden=!interaction;
  if(interaction){
    const result=sanitizeSinTowerInfectionEffect(interaction.infectionEffect);
    $('sinSelectedInfectionEnabled').checked=result.enabled;
    $('sinSelectedInfectionDirection').value=result.direction;
    $('sinSelectedInfectionLayers').value=result.layers;
    if($('sinSelectedInteractionType'))$('sinSelectedInteractionType').value=interaction.type||'text';
    syncSinTowerRpsEditor(object);
    syncSinExtraSelected(object);
    const interactionRadius=clamp(safeFinite(interaction.radius,3.2),.8,30);
    if($('sinSelectedInteractionRadius')&&document.activeElement!==$('sinSelectedInteractionRadius'))$('sinSelectedInteractionRadius').value=String(interactionRadius);
    if($('sinSelectedInteractionRadiusValue'))$('sinSelectedInteractionRadiusValue').textContent=interactionRadius.toFixed(1);
    if($('sinSelectedInteractionGlow')) $('sinSelectedInteractionGlow').checked=interaction.glowEnabled!==false;
    const particleCount=clamp(Math.round(safeFinite(interaction.particleCount,840)),120,2400);
    if($('sinSelectedInteractionParticles')){if(document.activeElement!==$('sinSelectedInteractionParticles'))$('sinSelectedInteractionParticles').value=String(particleCount);$('sinSelectedInteractionParticles').disabled=interaction.glowEnabled===false;}
    if($('sinSelectedInteractionParticlesValue'))$('sinSelectedInteractionParticlesValue').textContent=String(particleCount);
    const particleAxes=normalizeSinTowerParticleAxes(interaction.particleAxes);
    for(const [id,key] of [['sinSelectedParticleAxisX','x'],['sinSelectedParticleAxisY','y'],['sinSelectedParticleAxisZ','z']])if($(id)){$(id).checked=particleAxes[key];$(id).disabled=interaction.glowEnabled===false;}
    const isText=interaction.type==='text',isQuestion=interaction.type==='question';
    document.querySelectorAll('.sin-selected-text-only').forEach(node=>node.hidden=!isText);
    document.querySelectorAll('.sin-selected-document-only').forEach(node=>node.hidden=!(isText||isQuestion));
    document.querySelectorAll('.sin-selected-question-only').forEach(node=>node.hidden=!isQuestion);
    $('sinSelectedInfectionEnabled').closest('details').hidden=!isText;
    if(isText||isQuestion){
      const cornerRadius=clamp(safeFinite(interaction.cornerRadius,6),0,32);
      if($('sinSelectedDocRadius')&&document.activeElement!==$('sinSelectedDocRadius'))$('sinSelectedDocRadius').value=String(cornerRadius);
      if($('sinSelectedDocRadiusValue'))$('sinSelectedDocRadiusValue').textContent=Math.round(cornerRadius)+'px';
    }
    if(isText){
      if($('sinSelectedInteractionTitle')&&document.activeElement!==$('sinSelectedInteractionTitle'))$('sinSelectedInteractionTitle').value=interaction.title||object.title||'';
      if($('sinSelectedInteractionText')&&document.activeElement!==$('sinSelectedInteractionText'))$('sinSelectedInteractionText').value=interaction.text||'';
      if($('sinSelectedInteractionFont')) $('sinSelectedInteractionFont').value=interaction.fontFamily||'serif';
      if($('sinSelectedInteractionTitleSize')) $('sinSelectedInteractionTitleSize').value=clamp(safeFinite(interaction.titleSize,38),1,72);
      if($('sinSelectedInteractionBodySize')) $('sinSelectedInteractionBodySize').value=clamp(safeFinite(interaction.bodySize,18),1,42);
      const opacity=Math.round(clamp(safeFinite(interaction.backgroundOpacity,.85),.05,1)*100);
      if($('sinSelectedDocOpacity')&&document.activeElement!==$('sinSelectedDocOpacity'))$('sinSelectedDocOpacity').value=String(opacity);
      if($('sinSelectedDocOpacityValue'))$('sinSelectedDocOpacityValue').textContent=opacity+'%';
      for(const [id,key,fallback,digits] of [['sinSelectedVhsIntensity','vhsIntensity',1,2],['sinSelectedVhsScan','vhsScanDensity',6,2],['sinSelectedVhsOffset','vhsOffset',10,1],['sinSelectedVhsSpeed','vhsSpeed',5,2],['sinSelectedVhsNoise','vhsNoise',.24,2]]){
        const input=$(id),output=$(id+'Value'),value=safeFinite(interaction[key],fallback);
        if(input&&document.activeElement!==input)input.value=String(value);if(output)output.textContent=value.toFixed(digits);
      }
    }
    if(isQuestion){
      const opacity=Math.round(clamp(safeFinite(interaction.backgroundOpacity,.85),.05,1)*100);
      if($('sinSelectedDocOpacity')&&document.activeElement!==$('sinSelectedDocOpacity'))$('sinSelectedDocOpacity').value=String(opacity);
      if($('sinSelectedDocOpacityValue'))$('sinSelectedDocOpacityValue').textContent=opacity+'%';
      for(const [id,key,fallback,digits] of [['sinSelectedVhsIntensity','vhsIntensity',1,2],['sinSelectedVhsScan','vhsScanDensity',6,2],['sinSelectedVhsOffset','vhsOffset',10,1],['sinSelectedVhsSpeed','vhsSpeed',5,2],['sinSelectedVhsNoise','vhsNoise',.24,2]]){
        const input=$(id),output=$(id+'Value'),value=safeFinite(interaction[key],fallback);
        if(input&&document.activeElement!==input)input.value=String(value);if(output)output.textContent=value.toFixed(digits);
      }
      const cps=clamp(safeFinite(interaction.questionTypewriterCps,22),5,80);
      if($('sinSelectedQuestionSpeed')&&document.activeElement!==$('sinSelectedQuestionSpeed'))$('sinSelectedQuestionSpeed').value=String(cps);
      if($('sinSelectedQuestionSpeedValue'))$('sinSelectedQuestionSpeedValue').textContent=Math.round(cps)+' 字／秒';
      const questionSize=clamp(safeFinite(interaction.questionTextSize,23),1,48),questionOpacity=Math.round(clamp(safeFinite(interaction.questionTextOpacity,1),.1,1)*100);
      if($('sinSelectedQuestionTextSize')&&document.activeElement!==$('sinSelectedQuestionTextSize'))$('sinSelectedQuestionTextSize').value=String(questionSize);
      if($('sinSelectedQuestionTextSizeValue'))$('sinSelectedQuestionTextSizeValue').textContent=Math.round(questionSize)+'px';
      if($('sinSelectedQuestionTextOpacity')&&document.activeElement!==$('sinSelectedQuestionTextOpacity'))$('sinSelectedQuestionTextOpacity').value=String(questionOpacity);
      if($('sinSelectedQuestionTextOpacityValue'))$('sinSelectedQuestionTextOpacityValue').textContent=questionOpacity+'%';
      const dissolveCount=clamp(Math.round(safeFinite(interaction.dissolveParticleCount,4200)),400,12000),dissolveDensity=clamp(safeFinite(interaction.dissolveDensity,1.6),.25,4);
      if($('sinSelectedDissolveParticles')&&document.activeElement!==$('sinSelectedDissolveParticles'))$('sinSelectedDissolveParticles').value=String(dissolveCount);
      if($('sinSelectedDissolveParticlesValue'))$('sinSelectedDissolveParticlesValue').textContent=String(dissolveCount);
      if($('sinSelectedDissolveDensity')&&document.activeElement!==$('sinSelectedDissolveDensity'))$('sinSelectedDissolveDensity').value=String(dissolveDensity);
      if($('sinSelectedDissolveDensityValue'))$('sinSelectedDissolveDensityValue').textContent=dissolveDensity.toFixed(2);
      renderSinTowerSelectedQuestions();
    }
  }

  const driftPanel=$('sinSelectedDrift'),driftFields=$('sinSelectedDriftFields');
  const canDrift=!portal&&(!!model||!!prop);
  if(driftPanel) driftPanel.hidden=!canDrift;
  if(canDrift){
    const enabled=!!object.driftEnabled,axes=object.driftAxes||{x:true,y:false,z:false};
    if($('sinSelectedDriftEnabled')) $('sinSelectedDriftEnabled').checked=enabled;
    if(driftFields) driftFields.hidden=!enabled;
    if($('sinSelectedDriftX')) $('sinSelectedDriftX').checked=axes.x!==false;
    if($('sinSelectedDriftY')) $('sinSelectedDriftY').checked=!!axes.y;
    if($('sinSelectedDriftZ')) $('sinSelectedDriftZ').checked=!!axes.z;
    for(const [id,key,fallback] of [['sinSelectedDriftDistance','driftDistance',2],['sinSelectedDriftSpeed','driftSpeed',.65],['sinSelectedDriftIrregularity','driftIrregularity',.45]]){
      const input=$(id),output=$(id+'Value'),value=safeFinite(object[key],fallback);
      if(input&&document.activeElement!==input) input.value=String(value);
      if(output) output.textContent=value.toFixed(2);
    }
  }
  const kindLabel=portal?'傳送門':model?'3D 模型':'PNG／GIF／影片';
  $('sinSelectedPropState').textContent=(following?'跟隨中；按 Enter 或按「固定」完成。':'已固定；Ctrl+9 向上，Ctrl+0 向下。')+' '+kindLabel+(portal?'會保持等比例縮放。':'可設定等比例縮放與不規則巡邏。');
  panel.classList.add('open');panel.setAttribute('aria-hidden','false');
}

function selectSinTowerPlayProp(propId,visual=null){
  const prop=getSinTowerEditorObjectById(propId,'prop');
  if(!prop) return false;
  sinTowerPlayObjectUi.selectedPropId=prop.id;
  sinTowerPlayObjectUi.selectedPlayType='prop';
  sinTowerPlayObjectUi.selectedVisual=visual;
  SIN_TOWER_EDITOR.selectedObjectType='prop';SIN_TOWER_EDITOR.selectedObjectId=prop.id;
  syncSinTowerPlayPropActions();
  setStatus('已選取新增物件：'+prop.title+'。可跟隨、旋轉、等比例縮放、巡邏或刪除。');
  return true;
}

function selectSinTowerPlayModel(modelId){
  const model=getSinTowerEditorObjectById(modelId,'model');
  if(!model) return false;
  sinTowerPlayObjectUi.selectedPropId=model.id;
  sinTowerPlayObjectUi.selectedPlayType='model';
  sinTowerPlayObjectUi.selectedVisual=null;
  SIN_TOWER_EDITOR.selectedObjectType='model';SIN_TOWER_EDITOR.selectedObjectId=model.id;
  sinTowerModelCarry.active=false;sinTowerModelCarry.id=null;
  syncSinTowerPlayPropActions();
  setStatus('已選取 3D 模型：'+model.title+'。可跟隨、旋轉、等比例縮放、巡邏或刪除。');
  return true;
}

function pickSinTowerPlayPropFromPointer(event){
  if(!sinTowerPlayObjectUi.cursorEditMode||!cursorFreeMode||pointerLocked) return false;
  const candidates=[],visualBySprite=new Map();
  for(const rec of sinTowerEditorRuntime.props.values()){
    if(rec?.prop?.sceneId!==SIN_TOWER_EDITOR.activeSceneId) continue;
    for(const visual of rec.visuals||[]){
      if(!visual?.sprite||visual.group?.visible===false) continue;
      candidates.push(visual.sprite);visualBySprite.set(visual.sprite,{rec,visual});
    }
  }
  if(!candidates.length) return false;
  const ray=new THREE.Raycaster();ray.setFromCamera(pointerNDC(event),camera);
  const hit=ray.intersectObjects(candidates,false)[0],picked=hit?visualBySprite.get(hit.object):null;
  return picked?selectSinTowerPlayProp(picked.rec.prop.id,picked.visual):false;
}

function selectSinTowerPlayPortal(portalId){
  const portal=getSinTowerEditorObjectById(portalId,'portal');
  if(!portal) return false;
  sinTowerPlayObjectUi.selectedPropId=portal.id;sinTowerPlayObjectUi.selectedPlayType='portal';sinTowerPlayObjectUi.selectedVisual=null;
  SIN_TOWER_EDITOR.selectedObjectType='portal';SIN_TOWER_EDITOR.selectedObjectId=portal.id;
  syncSinTowerPlayPropActions();
  setStatus('已選取魔法傳送門：'+portal.title+'。可指定起點與終點、移動、旋轉、等比例縮放或刪除。');
  return true;
}

function pickSinTowerPlayPortalFromPointer(event){
  if(!sinTowerPlayObjectUi.cursorEditMode||!cursorFreeMode||pointerLocked) return false;
  const meshes=[];
  for(const rec of sinTowerEditorRuntime.portals.values()) rec.group?.traverse?.(node=>{if(node.isMesh&&node.visible!==false)meshes.push(node);});
  if(!meshes.length) return false;
  const ray=new THREE.Raycaster();ray.setFromCamera(pointerNDC(event),camera);
  const hit=ray.intersectObjects(meshes,false)[0],id=hit?.object?.userData?.sinTowerEditorId;
  return id?selectSinTowerPlayPortal(id):false;
}

function refreshSinTowerPlayPropBasePositions(prop){
  const rec=sinTowerEditorRuntime.props.get(prop?.id);
  if(!rec) return;
  rec.prop=prop;
  for(const visual of rec.visuals||[]){
    const visualStep=prop.repeatOnStairs?safeFinite(visual.step,prop.step):safeFinite(prop.step,visual.step);
    const base=rec.sceneInfo?.type==='stairs'&&prop.followStairs!==false
      ?sinTowerWorldPositionFromStep(visualStep,prop.offset)
      :sinTowerEditorWorldPosition(rec.sceneInfo,prop);
    visual.group.userData.basePosition=base.clone();visual.group.position.copy(base);
  }
}

function setSinTowerPlayPropWorldPosition(prop,world){
  if(!prop) return;
  const sceneInfo=getSinTowerSceneById(prop.sceneId)||getSinTowerActiveScene();
  const placement=sinTowerPropPlacementFromWorld(world,sceneInfo?.type==='stairs'&&prop.followStairs!==false,sceneInfo);
  prop.position=placement.position;prop.step=placement.step;prop.offset=placement.offset;prop.followStairs=placement.followStairs;
  const rec=sinTowerEditorRuntime.props.get(prop.id);if(rec) rec.prop=prop;
  if(!prop.repeatOnStairs) for(const visual of rec?.visuals||[]) visual.step=prop.step;
  refreshSinTowerPlayPropBasePositions(prop);
}

function setSinTowerPlayModelWorldPosition(model,world){
  if(!model||!world) return;
  model.position={x:safeFinite(world.x,0),y:safeFinite(world.y,0),z:safeFinite(world.z,0)};
  const rec=sinTowerEditorRuntime.models.get(model.id);if(rec){rec.model=model;applySinTowerEditorModelTransform(rec);}
}

function setSinTowerPlayPortalWorldPosition(portal,world){
  if(!portal) return;
  const sceneInfo=getSinTowerSceneById(portal.sceneId)||getSinTowerActiveScene();
  const placement=sinTowerPropPlacementFromWorld(world,sceneInfo?.type==='stairs',sceneInfo);
  portal.step=placement.step;portal.offset=placement.offset;
  applySinTowerEditorPortalTransform(sinTowerEditorRuntime.portals.get(portal.id));
}

function updateSinTowerFollowedProp(){
  const type=sinTowerPlayObjectUi.followObjectType;
  if(!type||!sinTowerPlayObjectUi.followPropId) return;
  const object=getSinTowerEditorObjectById(sinTowerPlayObjectUi.followPropId,type);
  if(!object||object.sceneId!==SIN_TOWER_EDITOR.activeSceneId){sinTowerPlayObjectUi.followPropId=null;sinTowerPlayObjectUi.followObjectType=null;return;}
  const forward=getPlayerForward(),world=player.position.clone().addScaledVector(forward,2.5);
  world.y=player.position.y+(type==='portal'?safeFinite(object.height,2.6)*.5:.04);
  if(type==='portal') setSinTowerPlayPortalWorldPosition(object,world);
  else if(type==='model') setSinTowerPlayModelWorldPosition(object,world);
  else setSinTowerPlayPropWorldPosition(object,world);
}

function toggleSinTowerSelectedPropFollow(){
  const portal=getSinTowerSelectedPlayPortal(),model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp();
  const object=portal||model||prop,type=portal?'portal':model?'model':'prop';
  if(!object) return;
  if(sinTowerPlayObjectUi.followPropId===object.id&&sinTowerPlayObjectUi.followObjectType===type){
    sinTowerPlayObjectUi.followPropId=null;sinTowerPlayObjectUi.followObjectType=null;
    if(type==='portal'){sinTowerPlayObjectUi.portalPlacementGraceId=object.id;sinTowerPlayObjectUi.portalPlacementGraceUntil=performance.now()+SIN_TOWER_PORTAL_PLACEMENT_GRACE_MS;}
    scheduleSinTowerRuntimeSave();setStatus('已固定物件：'+object.title+(type==='portal'?'；1 秒後恢復傳送功能。':''));
  }else{
    sinTowerModelCarry.active=false;sinTowerModelCarry.id=null;
    if(prop){
      const needsSingleVisual=prop.repeatOnStairs;
      prop.repeatOnStairs=false;prop.followStairs=false;
      if(needsSingleVisual) rebuildSinTowerEditorRuntime();
    }
    sinTowerPlayObjectUi.followPropId=object.id;sinTowerPlayObjectUi.followObjectType=type;
    suspendSinTowerInteractionsForPlacement();
    if(type==='portal'){sinTowerPlayObjectUi.portalPlacementGraceId=null;sinTowerPlayObjectUi.portalPlacementGraceUntil=0;}
    updateSinTowerFollowedProp();
    setStatus((portal?'傳送門':model?'3D 模型':'物件')+'正在角色前方跟隨，互動暫停；按 Enter 或再次按按鈕固定後恢復。');
  }
  syncSinTowerPlayPropActions();
}

function syncSinTowerSelectedPropRuntime(prop){
  const rec=sinTowerEditorRuntime.props.get(prop?.id);if(!rec)return false;
  rec.prop=prop;updateSinTowerEditorPropRecord(rec,performance.now()*.001);
  for(const visual of rec.visuals||[]){visual.sprite?.updateMatrix?.();visual.glow?.updateMatrix?.();visual.particles?.updateMatrix?.();}
  rec.root.updateMatrixWorld(true);return true;
}

function resizeSinTowerSelectedProp(value){
  const portal=getSinTowerSelectedPlayPortal(),model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp();
  if(portal){
    const scale=clamp(safeFinite(value,portal.uniformScale),.2,240),aspect=clamp(safeFinite(portal.width,1.8)/Math.max(.001,safeFinite(portal.height,2.6)),.1,10);
    portal.uniformScale=scale;portal.height=2.6*scale;portal.width=portal.height*aspect;
    applySinTowerEditorPortalTransform(sinTowerEditorRuntime.portals.get(portal.id));scheduleSinTowerRuntimeSave();
    if($('sinSelectedPropScaleValue')) $('sinSelectedPropScaleValue').textContent=scale.toFixed(2);return true;
  }
  if(model){
    const scale=clamp(safeFinite(value,model.scale?.x||1),.01,400);
    model.scale={x:scale,y:scale,z:scale};
    const rec=sinTowerEditorRuntime.models.get(model.id);if(rec){rec.model=model;applySinTowerEditorModelTransform(rec);}
    scheduleSinTowerRuntimeSave();if($('sinSelectedPropScaleValue'))$('sinSelectedPropScaleValue').textContent=scale.toFixed(2);return true;
  }
  if(!prop) return false;
  prop.height=clamp(safeFinite(value,prop.height),.1,600);syncSinTowerSelectedPropRuntime(prop);scheduleSinTowerRuntimeSave();
  if($('sinSelectedPropScaleValue')) $('sinSelectedPropScaleValue').textContent=prop.height.toFixed(2);return true;
}

function rotateSinTowerSelectedProp(){
  const portal=getSinTowerSelectedPlayPortal(),model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp();
  if(portal){portal.rotationY=(Math.round(safeFinite(portal.rotationY,0)/15)*15+15)%360;applySinTowerEditorPortalTransform(sinTowerEditorRuntime.portals.get(portal.id));}
  else if(model){model.rotation=model.rotation||{x:0,y:0,z:0};model.rotation.y=(Math.round(safeFinite(model.rotation.y,0)/15)*15+15)%360;const rec=sinTowerEditorRuntime.models.get(model.id);if(rec){rec.model=model;applySinTowerEditorModelTransform(rec);}}
  else if(prop){prop.rotationZ=(Math.round(safeFinite(prop.rotationZ,0)/15)*15+15)%360;syncSinTowerSelectedPropRuntime(prop);}
  else return;
  scheduleSinTowerRuntimeSave();syncSinTowerPlayPropActions();
}

function renderSinTowerSelectedQuestions(){
  const object=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp(),list=$('sinSelectedQuestionList');
  if(!list)return;
  list.textContent='';
  const questions=Array.isArray(object?.interaction?.questions)?object.interaction.questions:[];
  questions.forEach((question,index)=>{
    const row=document.createElement('div');row.className='sin-question-edit-row';
    const text=document.createElement('textarea');text.value=String(question.text||'');text.maxLength=500;text.setAttribute('aria-label','問題 '+(index+1)+' 文字內容');
    text.oninput=()=>{question.text=String(text.value||'').slice(0,500);scheduleSinTowerRuntimeSave();};
    text.onchange=()=>{question.text=String(text.value||'').trim().slice(0,500);text.value=question.text;scheduleSinTowerRuntimeSave();};
    const remove=document.createElement('button');remove.type='button';remove.textContent='×';remove.title='刪除問題';
    remove.onclick=()=>{object.interaction.questions.splice(index,1);scheduleSinTowerRuntimeSave();renderSinTowerSelectedQuestions();};
    row.append(text,remove);list.append(row);
  });
  if(!questions.length){const empty=document.createElement('span');empty.textContent='尚未新增問題。';list.append(empty);}
}

function addSinTowerSelectedQuestion(){
  const object=getSinTowerSelectedPlayModel()||getSinTowerSelectedPlayProp(),draft=$('sinSelectedQuestionDraft');
  const text=String(draft?.value||'').trim();
  if(!object?.interaction?.enabled||!text){setStatus('請先輸入要新增的問題。');return false;}
  object.interaction.type='question';object.interaction.consumed=false;object.interaction.questions=Array.isArray(object.interaction.questions)?object.interaction.questions:[];
  object.interaction.questions.push({id:uid('question'),text:text.slice(0,500)});
  object.interaction.questions=object.interaction.questions.slice(0,24);if(draft)draft.value='';
  scheduleSinTowerRuntimeSave();syncSinTowerPlayPropActions();renderSinTowerSelectedQuestions();setStatus('已新增問答題目。');return true;
}

function previewSinTowerSelectedInteraction(){
  const model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp(),object=model||prop;
  const rec=model?sinTowerEditorRuntime.models.get(model.id):sinTowerEditorRuntime.props.get(prop?.id);
  if(!object?.interaction?.enabled||!rec)return false;
  if(object.interaction.type==='question'&&!object.interaction.questions?.length){setStatus('請先新增至少一個問題。');return false;}
  if(sinTowerPlayObjectUi.activePropId)finalizeSinTowerInteractionClose(false,false);
  const position=model?rec.group.getWorldPosition(new THREE.Vector3()):(nearestSinTowerPropVisual(rec)?.position||player.position.clone());
  openSinTowerInteraction(rec,{distance:0,position});if(sinTowerPlayObjectUi.resultSession)sinTowerPlayObjectUi.resultSession.preview=true;return true;
}

function updateSinTowerSelectedInteractionStyle(){
  const model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp(),object=model||prop;
  if(!object?.interaction?.enabled) return false;
  object.interaction.infectionEffect=sanitizeSinTowerInfectionEffect({enabled:$('sinSelectedInfectionEnabled')?.checked,direction:$('sinSelectedInfectionDirection')?.value,layers:$('sinSelectedInfectionLayers')?.value});
  const oldType=object.interaction.type;
  const requestedType=$('sinSelectedInteractionType')?.value||oldType||'text';
  object.interaction.type=['text','media','question','rps'].includes(requestedType)?requestedType:'text';
  object.interaction.glowEnabled=$('sinSelectedInteractionGlow')?.checked!==false;
  object.interaction.radius=clamp(safeFinite($('sinSelectedInteractionRadius')?.value,object.interaction.radius||3.2),.8,30);
  if($('sinSelectedInteractionRadiusValue'))$('sinSelectedInteractionRadiusValue').textContent=object.interaction.radius.toFixed(1);
  object.interaction.particleCount=clamp(Math.round(safeFinite($('sinSelectedInteractionParticles')?.value,840)),120,2400);
  if($('sinSelectedInteractionParticlesValue'))$('sinSelectedInteractionParticlesValue').textContent=String(object.interaction.particleCount);
  if($('sinSelectedInteractionParticles'))$('sinSelectedInteractionParticles').disabled=!object.interaction.glowEnabled;
  let particleAxes={x:!!$('sinSelectedParticleAxisX')?.checked,y:!!$('sinSelectedParticleAxisY')?.checked,z:!!$('sinSelectedParticleAxisZ')?.checked};
  if(!particleAxes.x&&!particleAxes.y&&!particleAxes.z){particleAxes.y=true;if($('sinSelectedParticleAxisY'))$('sinSelectedParticleAxisY').checked=true;}
  object.interaction.particleAxes=particleAxes;
  for(const id of ['sinSelectedParticleAxisX','sinSelectedParticleAxisY','sinSelectedParticleAxisZ'])if($(id))$(id).disabled=!object.interaction.glowEnabled;
  if(object.interaction.type==='text'||object.interaction.type==='question'){
    object.interaction.cornerRadius=clamp(safeFinite($('sinSelectedDocRadius')?.value,6),0,32);
    if($('sinSelectedDocRadiusValue'))$('sinSelectedDocRadiusValue').textContent=Math.round(object.interaction.cornerRadius)+'px';
  }
  if(object.interaction.type==='text'){
    object.interaction.title=String($('sinSelectedInteractionTitle')?.value||object.title||'').slice(0,100);
    object.interaction.text=String($('sinSelectedInteractionText')?.value||'').slice(0,30000);
    object.interaction.fontFamily=String($('sinSelectedInteractionFont')?.value||'serif');
    object.interaction.titleSize=clamp(safeFinite($('sinSelectedInteractionTitleSize')?.value,38),1,72);
    object.interaction.bodySize=clamp(safeFinite($('sinSelectedInteractionBodySize')?.value,18),1,42);
    object.interaction.backgroundOpacity=clamp(safeFinite($('sinSelectedDocOpacity')?.value,85)/100,.05,1);
    object.interaction.vhsIntensity=clamp(safeFinite($('sinSelectedVhsIntensity')?.value,1),0,2);
    object.interaction.vhsScanDensity=clamp(safeFinite($('sinSelectedVhsScan')?.value,6),1,12);
    object.interaction.vhsOffset=clamp(safeFinite($('sinSelectedVhsOffset')?.value,10),0,24);
    object.interaction.vhsSpeed=clamp(safeFinite($('sinSelectedVhsSpeed')?.value,5),0,20);
    object.interaction.vhsNoise=clamp(safeFinite($('sinSelectedVhsNoise')?.value,.24),0,1);
    if($('sinSelectedDocOpacityValue'))$('sinSelectedDocOpacityValue').textContent=Math.round(object.interaction.backgroundOpacity*100)+'%';
    for(const [id,key,digits] of [['sinSelectedVhsIntensity','vhsIntensity',2],['sinSelectedVhsScan','vhsScanDensity',2],['sinSelectedVhsOffset','vhsOffset',1],['sinSelectedVhsSpeed','vhsSpeed',2],['sinSelectedVhsNoise','vhsNoise',2]])if($(id+'Value'))$(id+'Value').textContent=object.interaction[key].toFixed(digits);
    if(sinTowerPlayObjectUi.activePropId===object.id){applySinTowerInteractionStyle(object.interaction);if($('sinInteractionTitle'))$('sinInteractionTitle').textContent=object.interaction.title;if($('sinInteractionScroll'))$('sinInteractionScroll').textContent=object.interaction.text||'……';}
  }
  if(object.interaction.type==='question'){
    object.interaction.backgroundOpacity=clamp(safeFinite($('sinSelectedDocOpacity')?.value,85)/100,.05,1);
    object.interaction.vhsIntensity=clamp(safeFinite($('sinSelectedVhsIntensity')?.value,1),0,2);
    object.interaction.vhsScanDensity=clamp(safeFinite($('sinSelectedVhsScan')?.value,6),1,12);
    object.interaction.vhsOffset=clamp(safeFinite($('sinSelectedVhsOffset')?.value,10),0,24);
    object.interaction.vhsSpeed=clamp(safeFinite($('sinSelectedVhsSpeed')?.value,5),0,20);
    object.interaction.vhsNoise=clamp(safeFinite($('sinSelectedVhsNoise')?.value,.24),0,1);
    object.interaction.questionTypewriterCps=clamp(safeFinite($('sinSelectedQuestionSpeed')?.value,22),5,80);
    object.interaction.questionTextSize=clamp(safeFinite($('sinSelectedQuestionTextSize')?.value,23),1,48);
    object.interaction.questionTextOpacity=clamp(safeFinite($('sinSelectedQuestionTextOpacity')?.value,100)/100,.1,1);
    object.interaction.dissolveParticleCount=clamp(Math.round(safeFinite($('sinSelectedDissolveParticles')?.value,4200)),400,12000);
    object.interaction.dissolveDensity=clamp(safeFinite($('sinSelectedDissolveDensity')?.value,1.6),.25,4);
    if($('sinSelectedDissolveParticlesValue'))$('sinSelectedDissolveParticlesValue').textContent=String(object.interaction.dissolveParticleCount);
    if($('sinSelectedDissolveDensityValue'))$('sinSelectedDissolveDensityValue').textContent=object.interaction.dissolveDensity.toFixed(2);
    if($('sinSelectedQuestionSpeedValue'))$('sinSelectedQuestionSpeedValue').textContent=Math.round(object.interaction.questionTypewriterCps)+' 字／秒';
    if($('sinSelectedQuestionTextSizeValue'))$('sinSelectedQuestionTextSizeValue').textContent=Math.round(object.interaction.questionTextSize)+'px';
    if($('sinSelectedQuestionTextOpacityValue'))$('sinSelectedQuestionTextOpacityValue').textContent=Math.round(object.interaction.questionTextOpacity*100)+'%';
    renderSinTowerSelectedQuestions();
  }
  if((object.interaction.type==='text'||object.interaction.type==='question')&&sinTowerPlayObjectUi.activePropId===object.id)applySinTowerInteractionStyle(object.interaction);
  if(oldType!==object.interaction.type&&sinTowerPlayObjectUi.activePropId===object.id){finalizeSinTowerInteractionClose(false,false);setTimeout(previewSinTowerSelectedInteraction,0);}
  if(model){const rec=sinTowerEditorRuntime.models.get(model.id);if(rec){rec.model=model;syncSinTowerModelInteractiveFx(rec);}}
  if(prop){const rec=sinTowerEditorRuntime.props.get(prop.id);if(rec){rec.prop=prop;for(const visual of rec.visuals||[])setSinTowerPropVisualGlowEnabled(visual,prop,object.interaction.glowEnabled);}}
  scheduleSinTowerRuntimeSave();syncSinTowerPlayPropActions();return true;
}

function updateSinTowerSelectedDrift(){
  const model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp(),object=model||prop;
  if(!object) return false;
  object.driftEnabled=!!$('sinSelectedDriftEnabled')?.checked;
  let axes={x:!!$('sinSelectedDriftX')?.checked,y:!!$('sinSelectedDriftY')?.checked,z:!!$('sinSelectedDriftZ')?.checked};
  if(object.driftEnabled&&!axes.x&&!axes.y&&!axes.z){axes.x=true;if($('sinSelectedDriftX'))$('sinSelectedDriftX').checked=true;}
  object.driftAxes=axes;
  object.driftDistance=clamp(safeFinite($('sinSelectedDriftDistance')?.value,2),.05,20);
  object.driftSpeed=clamp(safeFinite($('sinSelectedDriftSpeed')?.value,.65),.05,5);
  object.driftIrregularity=clamp(safeFinite($('sinSelectedDriftIrregularity')?.value,.45),0,1);
  if(!Number.isFinite(object.driftSeed)) object.driftSeed=Math.random()*100000;
  if(model){const rec=sinTowerEditorRuntime.models.get(model.id);if(rec)rec.model=model;}
  if(prop){const rec=sinTowerEditorRuntime.props.get(prop.id);if(rec)rec.prop=prop;refreshSinTowerPlayPropBasePositions(prop);}
  scheduleSinTowerRuntimeSave();syncSinTowerPlayPropActions();return true;
}

function updateSinTowerSelectedPortalSecurity(commit=true){
  const portal=getSinTowerSelectedPlayPortal();if(!portal)return false;
  const input=$('sinSelectedPortalPassword'),enabled=!!$('sinSelectedPortalPasswordEnabled')?.checked;
  const cleaned=String(input?.value||'').toUpperCase().replace(/[^0-9A-F]/g,'').slice(0,4);
  portal.passwordEnabled=enabled;
  portal.password=sanitizeSinTowerPortalPassword(cleaned);
  if(input){input.disabled=!enabled;if(commit)input.value=portal.password;}
  scheduleSinTowerRuntimeSave();
  setStatus(enabled?'傳送門密碼已啟用：'+portal.password:'傳送門密碼已停用。');
  return true;
}

function updateSinTowerSelectedPortalRoute(){
  const portal=getSinTowerSelectedPlayPortal();if(!portal)return false;
  const oldSource=portal.sceneId;
  const sourceId=$('sinSelectedPortalSource')?.value||oldSource;
  let targetId=$('sinSelectedPortalTarget')?.value||portal.targetSceneId;
  if(targetId===sourceId&&SIN_TOWER_EDITOR.scenes.length>1) targetId=SIN_TOWER_EDITOR.scenes.find(sceneState=>sceneState.id!==sourceId)?.id||targetId;
  portal.sceneId=sourceId;portal.targetSceneId=targetId;
  if(sourceId!==oldSource){
    const sourceScene=getSinTowerSceneById(sourceId),base=sourceId===SIN_TOWER_EDITOR.activeSceneId?player.position:sourceScene?.spawn;
    const world=new THREE.Vector3(safeFinite(base?.x,0),safeFinite(base?.y,0)+1.3,safeFinite(base?.z,0));
    const placement=sinTowerPropPlacementFromWorld(world,sourceScene?.type==='stairs',sourceScene);
    portal.step=placement.step;portal.offset=placement.offset;
  }
  scheduleSinTowerRuntimeSave();rebuildSinTowerEditorRuntime();syncSinTowerPlayPropActions();
  setStatus('傳送路線已更新：'+(getSinTowerSceneById(sourceId)?.title||sourceId)+' → '+(getSinTowerSceneById(targetId)?.title||targetId));return true;
}

function moveSinTowerSelectedPropVertical(delta){
  const playModel=getSinTowerSelectedPlayModel();
  const model=playModel||(!sinTowerPlayObjectUi.selectedPlayType?selectedSinTowerEditorModel():null);
  if(model&&model.sceneId===SIN_TOWER_EDITOR.activeSceneId){
    model.position=model.position||{x:0,y:0,z:0};model.position.y=safeFinite(model.position.y,0)+delta;
    const rec=sinTowerEditorRuntime.models.get(model.id);if(rec){rec.model=model;applySinTowerEditorModelTransform(rec);}
    scheduleSinTowerRuntimeSave();
    if(playModel) syncSinTowerPlayPropActions();else syncSinProFields();
    setStatus(model.title+(delta>0?' 向上 ':' 向下 ')+Math.abs(delta).toFixed(2)+'；此位置已設為新基準。');return true;
  }
  const portal=getSinTowerSelectedPlayPortal();
  if(portal){portal.offset=portal.offset||{x:0,y:0,z:0};portal.offset.y=safeFinite(portal.offset.y,0)+delta;applySinTowerEditorPortalTransform(sinTowerEditorRuntime.portals.get(portal.id));scheduleSinTowerRuntimeSave();syncSinTowerPlayPropActions();setStatus(portal.title+(delta>0?' 向上 ':' 向下 ')+Math.abs(delta).toFixed(2));return true;}
  const prop=getSinTowerSelectedPlayProp();
  if(!prop){setStatus('請先按右鍵顯示游標，再點選要上下移動的新增物件。');return false;}
  prop.offset=prop.offset||{x:0,y:0,z:0};prop.position=prop.position||{x:0,y:0,z:0};
  prop.offset.y=safeFinite(prop.offset.y,0)+delta;prop.position.y=safeFinite(prop.position.y,0)+delta;
  refreshSinTowerPlayPropBasePositions(prop);scheduleSinTowerRuntimeSave();syncSinTowerPlayPropActions();
  setStatus(prop.title+(delta>0?' 向上 ':' 向下 ')+Math.abs(delta).toFixed(2)+'；此位置已設為新基準。');return true;
}

function deleteSinTowerSelectedPlayProp(){
  const portal=getSinTowerSelectedPlayPortal(),model=getSinTowerSelectedPlayModel(),prop=getSinTowerSelectedPlayProp(),object=portal||model||prop;
  if(!object) return false;
  if(sinTowerPlayObjectUi.activePropId===object.id) closeSinTowerInteraction(false,false,true);
  if(portal) SIN_TOWER_EDITOR.portals=SIN_TOWER_EDITOR.portals.filter(item=>item.id!==object.id);
  else if(model) SIN_TOWER_EDITOR.models=SIN_TOWER_EDITOR.models.filter(item=>item.id!==object.id);
  else SIN_TOWER_EDITOR.props=SIN_TOWER_EDITOR.props.filter(item=>item.id!==object.id);
  if(sinTowerPlayObjectUi.followPropId===object.id){sinTowerPlayObjectUi.followPropId=null;sinTowerPlayObjectUi.followObjectType=null;}
  closeSinTowerPlayPropActions(true);rebuildSinTowerEditorRuntime();scheduleSinTowerRuntimeSave();syncSinProEditor?.();
  setStatus('已刪除'+(portal?'傳送門':model?' 3D 模型':'新增物件')+'：'+object.title);return true;
}

let lastSinTowerRightClickCursorAt = -Infinity;
let sinTowerLastModelPick = null;
function showSinTowerObjectCursorFromRightClick(){
  if(EXPORTED_GALLERY_VIEWER) return;
  if(sinTowerPlayObjectUi.activePropId) closeSinTowerInteraction(false,false,true);
  if(!sinTowerPlayObjectUi.cursorEditMode){
    sinTowerPlayObjectUi.cursorEditPreviousAutoRun = !!SIN_TOWER_STAIRCASE.autoRun;
  }
  sinTowerPlayObjectUi.cursorEditMode = true;
  SIN_TOWER_STAIRCASE.autoRun = false;
  playAction('idle');
  showCursorByEsc();
  document.body.classList.add('play-mode');
  setStatus('物件游標已顯示：點選 PNG、GIF、影片、3D 模型或魔法傳送門，可移動、旋轉、縮放或刪除。');
}

function handleSinTowerRightClickCursor(e){
  if(SIN_TOWER_PUBLISHED || EXPORTED_GALLERY_VIEWER || e?.button !== 2 || !isPlayMode() || isInsideEditUi(e.target) || isInsideMobileControls(e.target)) return false;
  e.preventDefault?.();
  e.stopPropagation?.();
  e.stopImmediatePropagation?.();
  const now = performance.now();
  if(now - lastSinTowerRightClickCursorAt > 80){
    lastSinTowerRightClickCursorAt = now;
    showSinTowerObjectCursorFromRightClick();
  }
  return true;
}

function finishSinTowerObjectCursorMode(){
  if(!sinTowerPlayObjectUi.cursorEditMode) return;
  sinTowerPlayObjectUi.cursorEditMode = false;
  sinTowerPlayObjectUi.followPropId = null;
  sinTowerPlayObjectUi.followObjectType = null;
  closeSinTowerPlayPropActions(true);
  SIN_TOWER_STAIRCASE.autoRun = !!sinTowerPlayObjectUi.cursorEditPreviousAutoRun;
}

function openSinTowerStairJump(){
  if(EXPORTED_GALLERY_VIEWER||sinTowerPlayObjectUi.stairJumpOpen||!isPlayMode()||!isSinTowerStairSceneActive()||sinTowerPlayObjectUi.panelOpen||sinTowerPlayObjectUi.activePropId)return false;
  sinTowerPlayObjectUi.stairJumpOpen=true;sinTowerPlayObjectUi.stairJumpPreviousAutoRun=!!SIN_TOWER_STAIRCASE.autoRun;sinTowerPlayObjectUi.stairJumpPreviousCursorEdit=!!sinTowerPlayObjectUi.cursorEditMode;SIN_TOWER_STAIRCASE.autoRun=false;playAction('idle');
  const current=getSinTowerCurrentStepIndex()+1,total=getSinTowerTotalStepCount(),max=total||SIN_TOWER_STAIRCASE.virtualCount||1000000,input=$('sinStairJumpInput'),totalInput=$('sinStairTotalInput');
  if(input){input.max=String(max);input.value=String(Math.min(current,max));}
  if(totalInput)totalInput.value=String(total||0);
  if($('sinStairJumpHint'))$('sinStairJumpHint').textContent='目前第 '+current.toLocaleString()+' 階；總階梯數 '+(total?total.toLocaleString():'無限（輸入 0）')+'。跟隨物件會一起跳轉。';
  $('sinStairJumpOverlay')?.classList.add('open');$('sinStairJumpOverlay')?.setAttribute('aria-hidden','false');document.body.classList.add('play-mode','sin-stair-jump-open');setSinTowerModalCursorFree();
  setTimeout(()=>{input?.focus();input?.select();},0);return true;
}

function closeSinTowerStairJump(restore=true,requestLock=false){
  if(!sinTowerPlayObjectUi.stairJumpOpen)return;
  const overlay=$('sinStairJumpOverlay');if(overlay?.contains(document.activeElement))document.activeElement?.blur?.();
  sinTowerPlayObjectUi.stairJumpOpen=false;overlay?.classList.remove('open');overlay?.setAttribute('aria-hidden','true');document.body.classList.remove('sin-stair-jump-open');
  SIN_TOWER_STAIRCASE.autoRun=!!sinTowerPlayObjectUi.stairJumpPreviousAutoRun&&!sinTowerRunFinished;
  const resumeCursorEdit=!!sinTowerPlayObjectUi.stairJumpPreviousCursorEdit;sinTowerPlayObjectUi.stairJumpPreviousCursorEdit=false;
  if(restore){if(resumeCursorEdit){sinTowerPlayObjectUi.cursorEditMode=true;setSinTowerModalCursorFree();syncSinTowerPlayPropActions();}else restoreSinTowerPlayLook(requestLock);}
}

function jumpSinTowerToRequestedStep(){
  if(!sinTowerPlayObjectUi.stairJumpOpen||!isSinTowerStairSceneActive())return false;
  const total=setSinTowerTotalStepCount($('sinStairTotalInput')?.value),max=total||SIN_TOWER_STAIRCASE.virtualCount||1000000;
  const humanStep=clamp(Math.round(safeFinite($('sinStairJumpInput')?.value,1)),1,max),index=humanStep-1,c=SIN_TOWER_STAIRCASE;
  const x=clamp(player.position.x,c.startX-c.width*.45,c.startX+c.width*.45),target=sinTowerWorldPositionFromStep(index,{x:x-c.startX,y:0,z:0});
  player.position.copy(target);playerVelocityY=0;playerGroup?.position.copy(player.position);sinTowerRunFinished=false;enforceSinTowerStairTravelBounds();
  updateSinTowerVisibleStairs(true);refreshInfiniteSinTowerMonkWindow();updateSinTowerMonks(0);
  updateSinTowerFollowedProp();updateSinTowerModelCarry();updateSinTowerCarriedStone();updateSinTowerEditorRuntime(0);updateCamera();
  sinTowerPlayObjectUi.stairJumpPreviousAutoRun=false;playAction('idle');
  scheduleSinTowerRuntimeSave();closeSinTowerStairJump(true,true);setStatus('已跳轉至第 '+humanStep.toLocaleString()+' 階；總長 '+(total?total.toLocaleString()+' 階':'無限')+'；已暫停自動前進，跟隨物件已同步移動。');return true;
}

function openSinTowerShortcutHelp(){
  if(sinTowerPlayObjectUi.shortcutOpen) return;
  sinTowerPlayObjectUi.shortcutOpen = true;
  sinTowerPlayObjectUi.shortcutPreviousAutoRun = !!SIN_TOWER_STAIRCASE.autoRun;
  SIN_TOWER_STAIRCASE.autoRun = false;
  $('sinShortcutOverlay')?.classList.add('open');
  $('sinShortcutOverlay')?.setAttribute('aria-hidden','false');
  document.body.classList.add('play-mode','sin-shortcuts-open');
  setSinTowerModalCursorFree();
}

function closeSinTowerShortcutHelp(restore=true,requestLock=false){
  if(!sinTowerPlayObjectUi.shortcutOpen) return;
  sinTowerPlayObjectUi.shortcutOpen = false;
  $('sinShortcutOverlay')?.classList.remove('open');
  $('sinShortcutOverlay')?.setAttribute('aria-hidden','true');
  document.body.classList.remove('sin-shortcuts-open');
  SIN_TOWER_STAIRCASE.autoRun = !!sinTowerPlayObjectUi.shortcutPreviousAutoRun;
  if(restore) restoreSinTowerPlayLook(requestLock);
}

function bindInput(){
  updateCursorVisibility();
  bindSinTowerPlayObjectUi();
  bindWaterControls();
  if($('sinStairJumpCancel'))$('sinStairJumpCancel').onclick=()=>closeSinTowerStairJump(true,true);
  if($('sinStairJumpGo'))$('sinStairJumpGo').onclick=jumpSinTowerToRequestedStep;
  for(const id of ['sinStairJumpInput','sinStairTotalInput'])if($(id))$(id).onkeydown=event=>{if(event.code==='Enter'){event.preventDefault();event.stopPropagation();jumpSinTowerToRequestedStep();}else if(event.code==='Escape'){event.preventDefault();event.stopPropagation();closeSinTowerStairJump(true,true);}};
  setupMobileControls();

  document.body.addEventListener('click', e=>{
    if(EXPORTED_GALLERY_VIEWER) return;
    if(isInsideEditUi(e.target) || isInsideMobileControls(e.target)) return;
    if(transformControls?.dragging || wallScaleMode || artworkScaleMode) return;
    if(cursorFreeMode || pointerLocked) return;
    desiredPointerLocked = true;
    requestStablePointerLock();
  });
  document.addEventListener('pointerlockchange', ()=>{
    pointerLocked = hasActivePointerLock();
    if(pointerLocked){
      desiredPointerLocked = true;
      cursorFreeMode = false;
      fallbackMouseLook = false;
      resetFallbackLookAnchor();
      clearSelectableSelection();
    }else{
      lastPointerUnlockAt = performance.now();
      if(desiredPointerLocked && !cursorFreeMode){
        // A delayed unlock event can arrive after the editor's Play button
        // has already restored play mode. Keep the play look state active;
        // otherwise cursorFreeMode becomes true and the fallback mouse-look
        // handler intentionally ignores every horizontal movement.
        if(document.body.classList.contains('play-mode') && !sinTowerStonePickMode.active) cursorFreeMode = false;
        // Keep mouse-look alive while Pointer Lock is pending or unavailable.
        // Otherwise play mode remains active but the mousemove handler returns
        // before updating the camera.
        fallbackMouseLook = !IS_TOUCH_DEVICE;
      }else{
        desiredPointerLocked = false;
        cursorFreeMode = true;
        fallbackMouseLook = false;
      }
    }
    updateCursorVisibility();
  });
  document.addEventListener('pointerlockerror', ()=>{
    pointerLocked = false;
    if(desiredPointerLocked && !cursorFreeMode){
      // Pointer Lock failure must fall back to ordinary mouse movement rather
      // than leave a play-mode state that ignores mousemove entirely.
      fallbackMouseLook = !IS_TOUCH_DEVICE;
      updateCursorVisibility();
      setStatus('已進入遊玩模式。Pointer Lock 尚未鎖定；點擊畫面會重新嘗試鎖定視角。');
      return;
    }
    desiredPointerLocked = false;
    cursorFreeMode = true;
    updateCursorVisibility();
    setStatus('Pointer Lock 未啟用；請再次點擊畫面或按 ESC 重新切換游標。');
  });
  window.addEventListener('blur', ()=>{
    desiredPointerLocked = false;
    cursorFreeMode = true;
    fallbackMouseLook = false;
    resetFallbackLookAnchor();
    ctrlViewDrag = false;
    ctrlViewDragLastX = 0;
    ctrlViewDragLastY = 0;
    updateCursorVisibility();
  });
  $('canvas').addEventListener('pointerdown', e=>{
    if(isInsideEditUi(e.target) || isInsideMobileControls(e.target)) return;
    if(consumePlayModePointerEvent(e)) return;
    if(sinTowerStonePickMode.active){
      if(pickSinTowerStoneFromPointer(e)){
        e.preventDefault();
        e.stopPropagation();
      }
      return;
    }
    if(startMiddleViewDrag(e)) return;
    if(!pointerLocked && !fallbackMouseLook){
      if(pickSinTowerPlayPropFromPointer(e)){
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      if(pickSinTowerPlayPortalFromPointer(e)){
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      if(selectSinTowerEditorModelFromPointer(e)){
        e.preventDefault();
        e.stopPropagation();
        return;
      }
      if(transformControls?.enabled && transformControls?.visible) return;
      if(sandPileEnabled()){
        if(startSandPilePointer(e)){
          e.preventDefault();
          e.stopPropagation();
        }
        return;
      }
      if(chiselEnabled()){
        if(chiselFromPointer(e, false)){
          e.preventDefault();
          e.stopPropagation();
          updateChiselPreview(e);
        }
        return;
      }
      if(pickSelectableFromPointer(e)){
        e.preventDefault();
        e.stopPropagation();
      }
      return;
    }
    if(e.shiftKey){
      if(pickSelectableFromPointer(e)){
        e.preventDefault();
        e.stopPropagation();
      }
      return;
    }
    if(pendingWallId && pickWallFromPointer(e)) return;
    pickArtworkFromPointer(e);
  });
  document.addEventListener('pointerdown', e=>{
    if(!isMiddleButtonEvent(e)) return;
    if(isInsideEditUi(e.target) || isInsideMobileControls(e.target)) return;
    e.preventDefault();
    e.stopPropagation();
    startMiddleViewDrag(e);
  }, true);
  document.addEventListener('mousedown', e=>{
    if(!isMiddleButtonEvent(e)) return;
    if(isInsideEditUi(e.target) || isInsideMobileControls(e.target)) return;
    e.preventDefault();
    e.stopPropagation();
    startMiddleViewDrag(e);
  }, true);
  $('canvas').addEventListener('auxclick', e=>{
    if(e.button === 1){ e.preventDefault(); e.stopPropagation(); }
  });
  document.addEventListener('pointerdown', handleSinTowerRightClickCursor, true);
  document.addEventListener('mousedown', handleSinTowerRightClickCursor, true);
  document.addEventListener('contextmenu', e=>{
    if(handleSinTowerRightClickCursor(e)) return;
    if(e.target === renderer?.domElement) e.preventDefault();
  }, true);
  document.addEventListener('pointermove', e=>{
    if(isTextEditingEventTarget(e)) return;
    if(updateSandPileHandleModeFromPointer(e)){ e.preventDefault(); e.stopPropagation(); return; }
    if(applyMiddleViewDragMove(e)) return;
    if(isPlayCursorDisabled()){
      hideChiselPreview();
      return;
    }
    if(!isInsideEditUi(e.target) && !isInsideMobileControls(e.target)){
      lastChiselPointer = {clientX:e.clientX, clientY:e.clientY};
      if(updateSandPilePointerDrag(e)){ e.preventDefault(); e.stopPropagation(); return; }
      if(sandPileEnabled()) updateSandPilePreview(e);
      if(chiselEnabled()) updateChiselPreview(e);
    }
  }, true);
  window.addEventListener('pointercancel', e=>{ cancelSandPilePointer(e); stopMiddleViewDrag(e); }, true);
  window.addEventListener('pointerup', e=>{ if(finishSandPilePointer(e)){ e.preventDefault(); e.stopPropagation(); } }, true);
  document.addEventListener('mousemove', e=>{
    if(Number.isFinite(e.clientX)) fallbackPointerX = e.clientX;
    if(Number.isFinite(e.clientY)) fallbackPointerY = e.clientY;
    if(isTextEditingEventTarget(e)) return;
    if(!ctrlViewDrag && !pointerLocked && !fallbackMouseLook && isMiddleButtonEvent(e) && !isInsideEditUi(e.target)){
      startMiddleViewDrag(e);
    }
    if(applyMiddleViewDragMove(e)) return;
    if(multiObjectScaleMode){ resizeMultiSelectedObjectsByMouse(e); return; }
    if(artworkScaleMode){ resizeSelectedArtworkByMouse(e); return; }
    if(wallScaleMode){ resizeSelectedWallByMouse(e); return; }
    if((!pointerLocked && !fallbackMouseLook) || transformControls?.dragging) return;
    if(fallbackMouseLook && cursorFreeMode) return;
    if(fallbackMouseLook && !pointerLocked){
      updateFallbackLookAxis(e);
      return;
    }
    applyCameraLookDelta(e.movementX, e.movementY);
    // movementY 往上為負值；這裡轉成鏡頭 pitch，而不是平移鏡頭高度。
  }, true);
  window.addEventListener('wheel', e=>{
    if(sinTowerPlayObjectUi.activePropId){
      e.preventDefault();
      e.stopPropagation();
      const scroll = $('sinInteractionScroll');
      if(scroll && scroll.style.display !== 'none') scroll.scrollTop += e.deltaY;
      return;
    }
    if(isTextEditingEventTarget(e)) return;
    if(isInsideEditUi(e.target) || isInsideMobileControls(e.target)) return;
    e.preventDefault();
    zoomCamera(e.deltaY);
  }, {passive:false});
  window.addEventListener('keydown', e=>{
    if(handleSinAfterVideoKey(e))return;
    if(handleSinTowerRpsKey(e))return;
    if(handleSinTowerHideCursorShortcut(e))return;
    if(handleSinTowerMobileControlsShortcut(e))return;
    if(handleSinTowerPortalPasswordKey(e)) return;
    if(EXPORTED_GALLERY_VIEWER){
      handleExportedViewerKeyDown(e);
      return;
    }
    if(e.shiftKey && !e.ctrlKey && !e.altKey && !e.metaKey && e.code === 'KeyH' && !isTextEditingElement(document.activeElement)){
      e.preventDefault(); e.stopPropagation();
      if(sinTowerPlayObjectUi.shortcutOpen) closeSinTowerShortcutHelp(true,false); else openSinTowerShortcutHelp();
      return;
    }
    if(e.shiftKey&&!e.ctrlKey&&!e.altKey&&!e.metaKey&&e.code==='KeyQ'&&!isTextEditingElement(document.activeElement)&&isSinTowerStairSceneActive()&&isPlayMode()&&!sinTowerPlayObjectUi.panelOpen&&!sinTowerPlayObjectUi.activePropId){
      e.preventDefault();e.stopPropagation();openSinTowerStairJump();return;
    }
    if(sinTowerPlayObjectUi.stairJumpOpen){
      if(e.code==='Escape'){e.preventDefault();e.stopPropagation();closeSinTowerStairJump(true,true);}return;
    }
    if(sinTowerPlayObjectUi.shortcutOpen){
      if(e.code === 'Escape'){ e.preventDefault(); e.stopPropagation(); closeSinTowerShortcutHelp(true,false); }
      return;
    }
    if(sinTowerPlayObjectUi.activePropId&&$('sinQuestionOverlay')?.classList.contains('open')&&(e.code==='ArrowLeft'||e.code==='ArrowRight')){
      e.preventDefault();e.stopPropagation();
      if(!e.repeat)answerSinTowerQuestion(e.code==='ArrowRight'?'yes':'no');
      return;
    }
    if(e.code === 'Escape' && sinTowerPlayObjectUi.activePropId){
      e.preventDefault(); e.stopPropagation(); closeSinTowerInteraction(true,true); return;
    }
    if(e.code === 'Escape' && sinTowerPlayObjectUi.panelOpen){
      e.preventDefault(); e.stopPropagation(); closeSinTowerPlayAddPanel(true,true); return;
    }
    if(!sinTowerPlayObjectUi.panelOpen && !sinTowerPlayObjectUi.activePropId && !isTextEditingElement(document.activeElement) && (e.code === 'NumpadAdd' || (e.code === 'Equal' && e.shiftKey))){
      e.preventDefault(); e.stopPropagation(); openSinTowerPlayAddPanel(); return;
    }
    if(shouldBypassSceneShortcut(e)) return;
    if(e.ctrlKey && !e.altKey && !e.metaKey && (e.code === 'Digit9' || e.code === 'Numpad9' || e.code === 'Digit0' || e.code === 'Numpad0')){
      e.preventDefault();
      e.stopPropagation();
      moveSinTowerSelectedPropVertical((e.code === 'Digit9' || e.code === 'Numpad9') ? .1 : -.1);
      return;
    }
    if(e.ctrlKey && !e.altKey && !e.metaKey && e.code === 'KeyZ' && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      undoLastStep();
      return;
    }
    if(e.ctrlKey && !e.altKey && !e.metaKey && e.code === 'KeyG' && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      createObjectGroupFromMultiSelection();
      return;
    }
    if(e.code === 'KeyX' && sandPileEnabled() && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      sandPileAtPreviewOrView();
      return;
    }
    if(e.code === 'KeyX' && chiselEnabled() && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      chiselAtPreviewOrView();
      return;
    }
    if(e.code === 'KeyP' && !e.ctrlKey && !e.altKey && !e.metaKey && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      SIN_TOWER_STAIRCASE.autoRun = !SIN_TOWER_STAIRCASE.autoRun;
      if(!SIN_TOWER_STAIRCASE.autoRun) playAction('idle');
      setStatus(SIN_TOWER_STAIRCASE.autoRun ? '自動前進已恢復。按 P 可停止。' : '自動前進已停止。按 P 可恢復。');
      return;
    }
    if(e.shiftKey && !e.ctrlKey && !e.altKey && !e.metaKey && (e.code==='Digit0' || e.code==='Numpad0') && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      toggleSinTowerStonePickMode();
      return;
    }
    if(e.shiftKey && !e.ctrlKey && !e.altKey && !e.metaKey && (e.code==='Digit1' || e.code==='Numpad1') && !isTextEditingElement(document.activeElement)){
      e.preventDefault();
      e.stopPropagation();
      debugIncreaseSinTowerInfectionByShortcut();
      return;
    }
    if(e.ctrlKey && !e.altKey && !e.metaKey && (e.code==='Digit1' || e.code==='Digit2' || e.code==='Digit3' || e.code==='Numpad1' || e.code==='Numpad2' || e.code==='Numpad3')){
      e.preventDefault();
      e.stopPropagation();
      if(e.code==='Digit1' || e.code==='Numpad1') setCameraViewPreset('top');
      if(e.code==='Digit2' || e.code==='Numpad2') setCameraViewPreset('angle45');
      if(e.code==='Digit3' || e.code==='Numpad3') setCameraViewPreset('level');
      return;
    }
    if(e.code==='KeyC' && e.shiftKey){ e.preventDefault(); toggleSinTowerEditorMode(); return; }
    if(e.code==='KeyA' && e.shiftKey){
      e.preventDefault();
      e.stopPropagation();
      if(sandPileEnabled() && getSelectedFloorPhysicsTarget?.()){ startSandPileHandleByShiftA(); return; }
      toggleScaleModeForSelection();
      return;
    }
    if(e.code==='KeyT' && e.shiftKey){ e.preventDefault(); activateWallRotationControls(); return; }
    if((e.code==='Enter' || e.code==='Escape') && sandPileHandleMode?.active){
      e.preventDefault();
      e.stopPropagation();
      if(e.code==='Enter') commitSandPileHandleMode(); else cancelSandPileHandleMode();
      return;
    }
    if((e.code==='Enter' || e.code==='Escape') && (wallScaleMode || artworkScaleMode || multiObjectScaleMode)){
      e.preventDefault();
      e.stopPropagation();
      stopScaleModesByKey(e.code);
      return;
    }
    if(e.code==='Enter' && sinTowerModelCarry.active){
      e.preventDefault();
      e.stopPropagation();
      toggleSinTowerModelCarry();
      return;
    }
    if(e.code==='Enter' && sinTowerPlayObjectUi.followPropId){
      e.preventDefault();
      e.stopPropagation();
      toggleSinTowerSelectedPropFollow();
      return;
    }
    if(e.code==='Enter' && sinTowerStoneCarry.active){
      e.preventDefault();
      e.stopPropagation();
      placeSinTowerCarriedStone();
      return;
    }
    if(e.code==='Enter'){
      if(pendingWallId || pendingArtworkId || pendingFloorTileId || pendingWaterBodyId){
        e.preventDefault();
        e.stopPropagation();
        if(confirmPendingPlacementPreservingWindows()) return;
      }
    }
    if(e.code==='Escape' && sinTowerStonePickMode.active){
      e.preventDefault();
      e.stopPropagation();
      setSinTowerStonePickMode(false);
      setStatus('已離開石頭選取模式，返回遊玩。');
      return;
    }
    if(e.code==='Escape'){
      e.preventDefault();
      e.stopPropagation();
      if(e.repeat) return;
      toggleCursorByEsc(e.type);
      return;
    }
    if(e.code==='Delete' || e.code==='Backspace'){
      if(e.defaultPrevented||e.isComposing||isTextEditingElement(e.target)||isTextEditingElement(document.activeElement)) return;
      if(deleteSinTowerSelectedPlayProp() || deleteSinTowerSelectedModel() || deleteSelectedArtwork() || deleteSelectedFloorTile() || deleteSelectedWaterBody() || deleteSelectedWall()){
        e.preventDefault();
        e.stopPropagation();
      }
      return;
    }
    if(e.code==='KeyW') keys.w = true;
    if(e.code==='KeyA') keys.a = true;
    if(e.code==='KeyS') keys.s = true;
    if(e.code==='KeyD') keys.d = true;
    if(e.code==='Space') jump();
    if(e.code==='KeyQ'){ addWallAhead(); }
    if(e.code==='KeyE'){ deleteWallAhead(); }
    if(e.code==='KeyR'){ resetPlayer(); }
  }, true);
  window.addEventListener('keyup', e=>{
    if(sinTowerPortalGate.active){clearMovementKeys();e.preventDefault();e.stopPropagation();return;}
    if(EXPORTED_GALLERY_VIEWER){
      handleExportedViewerKeyUp(e);
      return;
    }
    if(shouldBypassSceneShortcut(e)) return;
    if(e.code==='Escape' && pendingEscRelock){
      e.preventDefault();
      e.stopPropagation();
      pendingEscRelock = false;
      lockPointerAfterEscRelease();
      return;
    }
    if(e.code==='KeyW') keys.w = false;
    if(e.code==='KeyA') keys.a = false;
    if(e.code==='KeyS') keys.s = false;
    if(e.code==='KeyD') keys.d = false;
  }, true);
  window.addEventListener('pointerup', e=>{
    stopMiddleViewDrag(e);
  }, true);
  window.addEventListener('mouseup', e=>{
    if(!ctrlViewDrag) return;
    // 滾輪釋放時 e.button 仍可能是 1；不能因 isMiddleButtonEvent 而跳過清除。
    if(e.button === 1 || ((e.buttons || 0) & 4) === 0) stopMiddleViewDrag(e);
  }, true);
}


function hashUndoAssetString(str){
  let h = 2166136261;
  const step = Math.max(1, Math.floor(str.length / 4096));
  for(let i=0; i<str.length; i+=step){
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return `${str.length}_${(h >>> 0).toString(36)}`;
}

function encodeUndoValue(value){
  if(typeof value !== 'string' || value.length < UNDO_ASSET_THRESHOLD) return value;
  if(!(value.startsWith('data:image') || value.startsWith('data:video') || value.startsWith('data:application/octet-stream') || value.startsWith('data:model'))) return value;
  const id = hashUndoAssetString(value);
  undoAssetStore.set(id, value);
  return `${UNDO_ASSET_PREFIX}${id}`;
}

function decodeUndoValue(value){
  if(typeof value === 'string' && value.startsWith(UNDO_ASSET_PREFIX)){
    const id = value.slice(UNDO_ASSET_PREFIX.length);
    return undoAssetStore.get(id) || null;
  }
  return value;
}

function stateSnapshot(){
  return JSON.stringify(STATE, (key,value)=>encodeUndoValue(value));
}

function pruneUndoAssetStore(){
  if(!undoAssetStore.size) return;
  const used = new Set();
  for(const snap of undoStack){
    if(typeof snap !== 'string' || !snap.includes(UNDO_ASSET_PREFIX)) continue;
    for(const key of undoAssetStore.keys()){
      if(snap.includes(`${UNDO_ASSET_PREFIX}${key}`)) used.add(key);
    }
  }
  for(const key of Array.from(undoAssetStore.keys())){
    if(!used.has(key)) undoAssetStore.delete(key);
  }
}

function pushUndoState(label=''){
  if(undoApplying || !STATE) return;
  const snap = stateSnapshot();
  if(undoStack[undoStack.length - 1] === snap) return;
  undoStack.push(snap);
  while(undoStack.length > UNDO_LIMIT) undoStack.shift();
  pruneUndoAssetStore();
}

function rebuildAfterStateRestore(){
  selectedWallId = null;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedArtworkActive = false;
  pendingWallId = null;
  wallScaleMode = false;
  artworkScaleMode = false;
  wallFollowPlayer = false;
  pendingArtworkId = null;
  artworkFollowPlayer = false;
  pendingFloorTileId = null;
  floorTileFollowPlayer = false;
  selectedWaterBodyId = null;
  selectedGroupId = null;
  clearObjectMultiSelection();
  pendingWaterBodyId = null;
  waterBodyFollowPlayer = false;
  detachWallRotationControls();
  buildSkyBackground();
  buildAtmosphereEffect();
  buildRoom();
  buildWaterBodies();
  buildArtworks();
  applyActorSettings();
  syncActorEditor(); syncSinTowerTumorEditor();
syncSinTowerFireEditor();
  syncSurfaceEditor();
  syncObjectEditor();
  syncWallEditor();
  syncArtEditor();
  syncChiselPanel();
  renderObjectPanel();
  updateCursorVisibility();
}

function undoLastStep(){
  if(undoStack.length <= 1){
    setStatus('沒有可還原的上一步。');
    return;
  }
  undoApplying = true;
  try{
    const current = stateSnapshot();
    if(undoStack[undoStack.length - 1] !== current) undoStack.push(current);
    undoStack.pop();
    const snap = undoStack[undoStack.length - 1];
    STATE = sanitizeState(JSON.parse(snap, (key,value)=>decodeUndoValue(value)));
    rebuildAfterStateRestore();
    clearTimeout(saveTimer);
    saveStateNow();
    setStatus('已還原到上一步。');
  }catch(err){
    console.error(err);
    setStatus('還原失敗：狀態資料無法讀取。');
  }finally{
    undoApplying = false;
  }
}

function isTextEditingElement(el){
  if(!el) return false;
  const tag = String(el.tagName || '').toLowerCase();
  return tag === 'input' || tag === 'textarea' || tag === 'select' || !!el.isContentEditable;
}

function getActiveTextEditingElement(){
  const active = document.activeElement;
  return isTextEditingElement(active) ? active : null;
}

function isUserTyping(){
  return !!getActiveTextEditingElement();
}

function clearMovementKeys(){
  keys.w = false;
  keys.a = false;
  keys.s = false;
  keys.d = false;
}

function shouldBypassSceneShortcut(e){
  const active = getActiveTextEditingElement();
  if(!active) return false;
  // Any text/number/select/range control owns the keyboard while focused.
  // The global handler must not move the player, trigger tools, group objects, undo, delete, or scale while the user is typing/editing values.
  clearMovementKeys();
  return true;
}

function isTextEditingEventTarget(e){
  return isTextEditingElement(e?.target) || isTextEditingElement(document.activeElement);
}


function isPlayMode(){
  return sinTowerPortalGate.active || sinTowerPlayObjectUi.panelOpen || !!sinTowerPlayObjectUi.activePropId || sinTowerPlayObjectUi.cursorEditMode || sinTowerPlayObjectUi.shortcutOpen || sinTowerPlayObjectUi.stairJumpOpen || sinTowerStonePickMode.active || pointerLocked || fallbackMouseLook || (!cursorFreeMode && desiredPointerLocked);
}

function isPlayCursorDisabled(){
  if(sinTowerPlayObjectUi.panelOpen || sinTowerPlayObjectUi.activePropId || sinTowerPlayObjectUi.cursorEditMode || sinTowerPlayObjectUi.shortcutOpen || sinTowerPlayObjectUi.stairJumpOpen) return false;
  return isPlayMode() && !sinTowerStonePickMode.active;
}

function consumePlayModePointerEvent(event){
  if(!isPlayCursorDisabled()) return false;
  if(isInsideEditUi(event?.target) || isInsideMobileControls(event?.target)) return false;
  clearSelectableSelection();
  forceSelectableOpaque();
  hideChiselPreview();
  // A failed initial lock uses ordinary mouse movement temporarily. Every
  // later canvas click is still a valid user gesture and must retry Pointer
  // Lock; otherwise the hidden OS cursor eventually reaches a screen edge and
  // horizontal camera movement appears to freeze permanently.
  if(!pointerLocked && desiredPointerLocked) requestStablePointerLock();
  event?.preventDefault?.();
  event?.stopPropagation?.();
  return true;
}

function updateEditingWindowsVisibility(){
  const play = isPlayMode();
  document.body.classList.toggle('play-mode', play);
  updateLightMarkerVisibility();
  applyPlayModePerformanceLighting(play);
}

function getObjectState(type, id){
  if(type === 'artwork') return (STATE.artworks || []).find(a=>a.id===id) || null;
  if(type === 'customWall' || type === 'wall') return (STATE.customWalls || []).find(w=>w.id===id) || null;
  if(type === 'floorTile') return (STATE.floorTiles || []).find(t=>t.id===id) || null;
  if(type === 'waterBody' || type === 'water') return (STATE.waterBodies || []).find(w=>w.id===id) || null;
  if(type === 'roomSurface' || type === 'surface') return STATE.surfaces?.[id] || null;
  if(type === 'referenceArchitecture') return STATE.referenceArchitecture || null;
  if(type === 'light') return (STATE.lightSystem?.lights || []).find(l=>l.id===id) || null;
  if(type === 'objectGroup') return (STATE.objectGroups || []).find(g=>g.id===id) || null;
  return null;
}

function isObjectVisible(type, id){
  const obj = getObjectState(type, id);
  return !obj || obj.visible !== false;
}

function isObjectLocked(type, id){
  const obj = getObjectState(type, id);
  return !!obj?.locked;
}

function isObjectSelectable(type, id){
  return isObjectVisible(type, id) && !isObjectLocked(type, id);
}

function selectableCandidate(candidate){
  if(!candidate) return null;
  if(!isObjectSelectable(candidate.type, candidate.id)) return null;
  return candidate;
}

function clearSelectionIfObject(type, id){
  if(type === 'artwork' && selectedArtworkId === id){ selectedArtworkActive = false; }
  if((type === 'customWall' || type === 'wall') && selectedWallId === id) selectedWallId = null;
  if(type === 'floorTile' && selectedFloorTileId === id) selectedFloorTileId = null;
  if((type === 'waterBody' || type === 'water') && selectedWaterBodyId === id) selectedWaterBodyId = null;
  if((type === 'roomSurface' || type === 'surface') && selectedRoomWallKey === id) selectedRoomWallKey = null;
  if(type === 'referenceArchitecture') selectedReferenceArchitectureActive = false;
  if(type === 'light') selectedLightObjectActive = false;
  if(type === 'objectGroup' && selectedGroupId === id) selectedGroupId = null;
  multiSelectedObjectKeys.delete(makeObjectKey(type, id));
  detachWallRotationControls();
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  syncObjectEditor();
  renderObjectPanel();
}

function applyObjectVisibilityLocks(){
  for(const key of SURFACE_KEYS){
    const visible = !((STATE.deletedSurfaces || []).includes(key)) && STATE.surfaces?.[key]?.visible !== false;
    if(surfaces[key]) surfaces[key].visible = visible;
    const relief = groundReliefMeshes[`surface:${key}`] || (key === 'floor' ? groundReliefMeshes.floor : null);
    if(relief) relief.visible = visible;
  }
  for(const w of STATE.customWalls || []){
    const visible = w.visible !== false;
    if(customWallMeshes[w.id]) customWallMeshes[w.id].visible = visible;
    if(groundReliefMeshes[`wall:${w.id}`]) groundReliefMeshes[`wall:${w.id}`].visible = visible;
  }
  for(const t of STATE.floorTiles || []){
    const visible = t.visible !== false;
    if(floorTileMeshes[t.id]) floorTileMeshes[t.id].visible = visible;
    if(groundReliefMeshes[`floorTile:${t.id}`]) groundReliefMeshes[`floorTile:${t.id}`].visible = visible;
  }
  for(const water of STATE.waterBodies || []){
    if(waterBodyMeshes[water.id]) waterBodyMeshes[water.id].visible = water.visible !== false;
  }
  for(const art of STATE.artworks || []){
    if(artworkMeshes[art.id]) artworkMeshes[art.id].visible = art.visible !== false;
  }
  if(referenceArchitectureGroup){
    referenceArchitectureGroup.visible = STATE.referenceArchitecture?.enabled !== false && STATE.referenceArchitecture?.visible !== false;
  }
  for(const light of STATE.lightSystem?.lights || []){
    const group = lightControlObjects[light.id];
    if(group) group.visible = light.visible !== false;
  }
}

function selectedObjectKey(){
  if(selectedGroupId) return `objectGroup:${selectedGroupId}`;
  if(selectedArtworkActive && selectedArtworkId) return `artwork:${selectedArtworkId}`;
  if(selectedWallId) return `customWall:${selectedWallId}`;
  if(selectedFloorTileId) return `floorTile:${selectedFloorTileId}`;
  if(selectedWaterBodyId) return `waterBody:${selectedWaterBodyId}`;
  if(selectedRoomWallKey) return `roomSurface:${selectedRoomWallKey}`;
  if(selectedReferenceArchitectureActive) return 'referenceArchitecture:referenceArchitecture';
  if(selectedLightObjectActive && selectedLightId) return `light:${selectedLightId}`;
  return '';
}

function getObjectPanelBaseItems(){
  const items = [];
  if(STATE.referenceArchitecture && STATE.referenceArchitecture.enabled !== false){
    items.push({type:'referenceArchitecture', id:'referenceArchitecture', label:STATE.referenceArchitecture.title || '參考圖建築', kind:'整體建築', visible:STATE.referenceArchitecture.enabled !== false && STATE.referenceArchitecture.visible !== false, locked:!!STATE.referenceArchitecture.locked});
  }
  for(const key of SURFACE_KEYS){
    if((STATE.deletedSurfaces || []).includes(key)) continue;
    const cfg = STATE.surfaces?.[key] || {};
    items.push({type:'roomSurface', id:key, label:cfg.title || SURFACE_LABELS[key] || key, kind:'空間基底', visible:cfg.visible !== false, locked:!!cfg.locked});
  }
  for(const w of STATE.customWalls || []) items.push({type:'customWall', id:w.id, label:w.title || w.id, kind:isCurvedWall(w) ? '曲面牆' : '自建牆', visible:w.visible !== false, locked:!!w.locked});
  for(const t of STATE.floorTiles || []) items.push({type:'floorTile', id:t.id, label:t.title || t.id, kind:'地板塊', visible:t.visible !== false, locked:!!t.locked});
  for(const w of STATE.waterBodies || []) items.push({type:'waterBody', id:w.id, label:w.title || w.id, kind:w.shape === 'rect' ? '水體｜矩形' : (w.shape === 'oval' ? '水體｜橢圓' : '水體｜圓形'), visible:w.visible !== false, locked:!!w.locked});
  for(const l of STATE.lightSystem?.lights || []) items.push({type:'light', id:l.id, label:l.title || l.id, kind:l.type === 'directional' ? '光源｜平行光' : (l.type === 'spot' ? '光源｜聚光燈' : '光源｜點光源'), visible:l.visible !== false, locked:!!l.locked});
  for(const a of STATE.artworks || []) items.push({type:'artwork', id:a.id, label:a.title || a.id, kind:a.type === 'model' ? '3D作品' : '作品', visible:a.visible !== false, locked:!!a.locked});
  return items;
}

function getObjectPanelMemberKeySet(){
  const set = new Set();
  for(const g of STATE.objectGroups || []){
    for(const key of objectGroupMemberKeys(g)) set.add(key);
  }
  return set;
}

function getObjectPanelItems(){
  const baseItems = getObjectPanelBaseItems();
  const baseMap = new Map(baseItems.map(item=>[makeObjectKey(item.type, item.id), item]));
  const groupedKeys = new Set();
  const items = [];
  for(const g of STATE.objectGroups || []){
    const memberKeys = objectGroupMemberKeys(g).filter(key=>baseMap.has(key));
    for(const key of memberKeys) groupedKeys.add(key);
    items.push({type:'objectGroup', id:g.id, label:g.title || g.id, kind:`群組｜${memberKeys.length}件${g.expanded ? '｜展開' : '｜收合'}`, visible:g.visible !== false, locked:!!g.locked, depth:0, expanded:g.expanded === true});
    if(g.expanded === true){
      for(const key of memberKeys){
        const member = baseMap.get(key);
        if(member) items.push({...member, depth:1, parentGroupId:g.id});
      }
    }
  }
  for(const item of baseItems){
    const key = makeObjectKey(item.type, item.id);
    if(groupedKeys.has(key)) continue;
    items.push({...item, depth:0});
  }
  return items;
}

function getObjectPanelSelectableKeysInOrder(){
  return getObjectPanelItems()
    .filter(item=>item.type !== 'objectGroup' && isObjectSelectable(item.type, item.id))
    .map(item=>makeObjectKey(item.type, item.id));
}

function clearObjectMultiSelection(){
  multiSelectedObjectKeys = new Set();
  objectPanelRangeAnchorKey = null;
}

function objectGroupMemberKeys(group){
  return (group?.members || []).map(m=>makeObjectKey(m.type, m.id)).filter(k=>objectExistsByKey(k));
}

function addObjectKeyToPanelMultiSelection(type, id){
  const key = makeObjectKey(type, id);
  if(type === 'objectGroup'){
    const group = getObjectState(type, id);
    for(const memberKey of objectGroupMemberKeys(group)) multiSelectedObjectKeys.add(memberKey);
    return true;
  }
  if(!isObjectSelectable(type, id)) return false;
  multiSelectedObjectKeys.add(key);
  return true;
}

function objectPanelRangeSelect(type, id){
  const key = makeObjectKey(type, id);
  if(type === 'objectGroup'){
    const group = getObjectState(type, id);
    if(!group) return;
    for(const memberKey of objectGroupMemberKeys(group)) multiSelectedObjectKeys.add(memberKey);
    selectedGroupId = id;
    renderObjectPanel();
    setStatus(`已加入群組成員：${group.title || id}。`);
    return;
  }
  if(!isObjectSelectable(type, id)){ setStatus('該物件已鎖定或不可視，無法加入多選。'); return; }
  const ordered = getObjectPanelSelectableKeysInOrder();
  const anchor = objectPanelRangeAnchorKey && ordered.includes(objectPanelRangeAnchorKey) ? objectPanelRangeAnchorKey : key;
  const a = ordered.indexOf(anchor);
  const b = ordered.indexOf(key);
  if(a < 0 || b < 0){
    addObjectKeyToPanelMultiSelection(type, id);
    objectPanelRangeAnchorKey = key;
  }else{
    const [from, to] = a <= b ? [a,b] : [b,a];
    multiSelectedObjectKeys = new Set(ordered.slice(from, to + 1));
  }
  const preserved = new Set(multiSelectedObjectKeys);
  selectedGroupId = null;
  objectPanelSelect(type, id, {preserveMulti:true, fromRangeSelection:true});
  multiSelectedObjectKeys = preserved;
  selectedGroupId = null;
  renderObjectPanel();
  setStatus(`已選取連續物件：${multiSelectedObjectKeys.size} 件。Ctrl+G 可建立群組。`);
}

function toggleObjectPanelMultiSelection(type, id){
  const key = makeObjectKey(type, id);
  if(type === 'objectGroup'){
    const group = getObjectState(type, id);
    for(const memberKey of objectGroupMemberKeys(group)){
      if(multiSelectedObjectKeys.has(memberKey)) multiSelectedObjectKeys.delete(memberKey);
      else multiSelectedObjectKeys.add(memberKey);
    }
    selectedGroupId = id;
    renderObjectPanel();
    setStatus(`已切換群組成員多選：${group?.title || id}。`);
    return;
  }
  if(!isObjectSelectable(type, id)){ setStatus('該物件已鎖定或不可視，無法加入多選。'); return; }
  if(multiSelectedObjectKeys.has(key)) multiSelectedObjectKeys.delete(key);
  else multiSelectedObjectKeys.add(key);
  objectPanelRangeAnchorKey = key;
  const preservedMultiSelection = new Set(multiSelectedObjectKeys);
  selectedGroupId = null;
  objectPanelSelect(type, id, {preserveMulti:true});
  multiSelectedObjectKeys = preservedMultiSelection;
  selectedGroupId = null;
  renderObjectPanel();
  setStatus(`多選數量：${multiSelectedObjectKeys.size}。Ctrl+G 可建立群組。`);
}

function createObjectGroupFromMultiSelection(){
  const keys = new Set(multiSelectedObjectKeys);
  const single = selectedObjectKey();
  if(single && !single.startsWith('objectGroup:')) keys.add(single);
  const members = Array.from(keys).map(parseObjectKey).filter(m=>m.id && m.type !== 'objectGroup' && getObjectState(m.type, m.id));
  const deduped = [];
  const seen = new Set();
  for(const m of members){
    const key = makeObjectKey(m.type, m.id);
    if(seen.has(key)) continue;
    seen.add(key);
    deduped.push({type:m.type, id:m.id});
  }
  if(deduped.length < 2){
    setStatus('至少需要在物件視窗 Shift+左鍵多選兩個物件，才能 Ctrl+G 建立群組。');
    return false;
  }
  pushUndoState('create object group');
  STATE.objectGroups = Array.isArray(STATE.objectGroups) ? STATE.objectGroups : [];
  const selectedKeys = new Set(deduped.map(m=>makeObjectKey(m.type, m.id)));
  for(const g of STATE.objectGroups){
    g.members = (g.members || []).filter(m=>!selectedKeys.has(makeObjectKey(m.type, m.id)));
  }
  STATE.objectGroups = STATE.objectGroups.filter(g=>(g.members || []).length > 0);
  const group = {id:uid('group'), title:`群組 ${STATE.objectGroups.length + 1}`, members:deduped, visible:true, locked:false, expanded:false};
  STATE.objectGroups.push(group);
  selectedGroupId = group.id;
  multiSelectedObjectKeys = new Set(deduped.map(m=>makeObjectKey(m.type, m.id)));
  scheduleSave();
  renderObjectPanel();
  setStatus(`已建立群組：${group.title}，含 ${deduped.length} 個物件。雙擊名稱可重新命名。`);
  return true;
}

function startObjectPanelInlineRename(row){
  const type = row?.dataset?.type;
  const id = row?.dataset?.id;
  const nameEl = row?.querySelector?.('.object-name');
  const obj = getObjectState(type, id);
  if(!nameEl || !obj) return;
  const current = getObjectDisplayName(type, id);
  const input = document.createElement('input');
  input.className = 'object-rename-input';
  input.type = 'text';
  input.value = current;
  input.setAttribute('aria-label','重新命名物件');
  nameEl.innerHTML = '';
  nameEl.appendChild(input);
  input.focus();
  input.select();
  let done = false;
  const finish = commit=>{
    if(done) return;
    done = true;
    const title = String(input.value || '').trim();
    if(commit && title && title !== current){
      pushUndoState('rename object');
      setObjectDisplayName(type, id, title);
      scheduleSave();
      syncAllEditor();
      setStatus(`已重新命名：${title}`);
    }else{
      renderObjectPanel();
    }
  };
  input.addEventListener('click', ev=>ev.stopPropagation());
  input.addEventListener('mousedown', ev=>ev.stopPropagation());
  input.addEventListener('keydown', ev=>{
    if(ev.code === 'Enter'){ ev.preventDefault(); ev.stopPropagation(); finish(true); }
    if(ev.code === 'Escape'){ ev.preventDefault(); ev.stopPropagation(); finish(false); }
  });
  input.addEventListener('blur', ()=>finish(true));
}

function renameObjectFromPanel(type, id){
  const obj = getObjectState(type, id);
  if(!obj) return;
  const current = getObjectDisplayName(type, id);
  const next = prompt('重新命名', current);
  if(next === null) return;
  const title = String(next).trim();
  if(!title) return;
  pushUndoState('rename object');
  setObjectDisplayName(type, id, title);
  scheduleSave();
  syncAllEditor();
  setStatus(`已重新命名：${title}`);
}

function getObjectDisplayName(type, id){
  const obj = getObjectState(type, id);
  if(!obj) return id;
  if(type === 'roomSurface') return obj.title || SURFACE_LABELS[id] || id;
  if(type === 'referenceArchitecture') return obj.title || '參考圖建築';
  return obj.title || obj.name || id;
}

function setObjectDisplayName(type, id, title){
  const obj = getObjectState(type, id);
  if(!obj) return;
  obj.title = title;
  if(type === 'light') syncLightEditor();
  if(type === 'artwork') syncArtSelect();
  if(type === 'customWall') syncWallSelect();
  if(type === 'waterBody') syncWaterSelect?.();
}


function objectPanelSelect(type, id, options={}){
  if(type === 'objectGroup'){
    const group = getObjectState(type, id);
    if(!group){ setStatus('找不到此群組。'); return; }
    selectedGroupId = id;
    multiSelectedObjectKeys = new Set(objectGroupMemberKeys(group));
    if(options.toggleExpanded){
      group.expanded = group.expanded !== true;
      scheduleSave();
    }
    renderObjectPanel();
    setStatus(`已選取群組：${group.title || id}。${group.expanded ? '目前已展開。' : '目前已收合。'} 雙擊名稱可重新命名；Visible/Lock 會同步套用到群組成員。`);
    return;
  }
  if(!options.preserveMulti) selectedGroupId = null;
  if(!isObjectSelectable(type, id)){ setStatus('該物件已鎖定或不可視，無法選取。'); return; }
  if(type === 'artwork') selectArtworkById(id);
  else if(type === 'customWall') selectCustomWall(id);
  else if(type === 'floorTile') selectFloorTile(id);
  else if(type === 'waterBody') selectWaterBody(id);
  else if(type === 'roomSurface') selectRoomWall(id);
  else if(type === 'referenceArchitecture') selectReferenceArchitecture();
  else if(type === 'light') selectLightObject(id);
  renderObjectPanel();
}

function setObjectFlag(type, id, flag, value){
  const obj = getObjectState(type, id);
  if(!obj) return;
  pushUndoState(`${flag} object`);
  obj[flag] = value;
  if(type === 'objectGroup'){
    for(const m of obj.members || []){
      const member = getObjectState(m.type, m.id);
      if(!member) continue;
      member[flag] = value;
      if(m.type === 'referenceArchitecture' && flag === 'visible'){
        member.enabled = !!value;
        member.visible = !!value;
        if(value) buildReferenceArchitecture();
      }
    }
    if(flag === 'visible' && value === false) selectedGroupId = null;
  }
  if(type === 'referenceArchitecture' && flag === 'visible'){
    obj.enabled = !!value;
    obj.visible = !!value;
    if(value) buildReferenceArchitecture();
  }
  if(type === 'light'){
    rebuildLightSystem();
    if(flag === 'visible' && value !== false) attachLightTranslateControls(id);
    syncLightEditor();
  }
  if(type === 'objectGroup') rebuildLightSystem();
  if(flag === 'visible' && value === false) clearSelectionIfObject(type, id);
  if(flag === 'locked' && value === true) clearSelectionIfObject(type, id);
  applyObjectVisibilityLocks();
  renderObjectPanel();
  scheduleSave();
}

function renderObjectPanel(){
  const list = $('objectList');
  if(!list || !STATE) return;
  applyObjectVisibilityLocks();
  const selected = selectedObjectKey();
  const items = getObjectPanelItems();
  list.innerHTML = items.map(item=>{
    const key = makeObjectKey(item.type, item.id);
    const group = item.type === 'objectGroup' ? getObjectState(item.type, item.id) : null;
    const groupMemberSelected = group ? objectGroupMemberKeys(group).some(k=>multiSelectedObjectKeys.has(k)) : false;
    const multi = multiSelectedObjectKeys.has(key) || groupMemberSelected;
    const depth = safeFinite(item.depth,0);
    const arrow = item.type === 'objectGroup' ? `<span class="group-arrow">${item.expanded ? '▾' : '▸'}</span>` : (depth > 0 ? '<span class="group-arrow">↳</span>' : '');
    return `<div class="object-row" data-type="${escapeHtml(item.type)}" data-id="${escapeHtml(item.id)}" data-depth="${depth}" data-parent="${escapeHtml(item.parentGroupId || '')}" data-expanded="${item.expanded === true}" data-selected="${key===selected}" data-multiselected="${multi}" data-visible="${item.visible}" data-locked="${item.locked}">
      <div class="object-name" data-action="select" title="${escapeHtml(item.label)}">${arrow}${escapeHtml(item.label)}<span class="object-type">${escapeHtml(item.kind)}</span></div>
      <button data-action="visible">${item.visible ? 'Visible' : 'Hidden'}</button>
      <button data-action="locked">${item.locked ? 'Unlock' : 'Lock'}</button>
    </div>`;
  }).join('') || '<p class="small">目前沒有可列出的物件。</p>';
}

function escapeHtml(value){
  return String(value ?? '').replace(/[&<>"]/g, ch=>({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[ch]));
}



function installStrictObjectPanelRangeSelection(list){
  if(!list || list.dataset.strictRangeBound === '1') return;
  list.dataset.strictRangeBound = '1';

  const isLeftPointer = e => e.button === undefined || e.button === 0;
  const rowFromEvent = e => {
    const row = e.target?.closest?.('.object-row');
    return row && list.contains(row) ? row : null;
  };
  const isPanelNameTarget = e => !!e.target?.closest?.('.object-name');
  const isInlineRenameTarget = e => !!e.target?.closest?.('.object-rename-input');
  const isButtonLikeTarget = e => !!e.target?.closest?.('button,input,textarea,select');
  const rowKey = row => makeObjectKey(row?.dataset?.type, row?.dataset?.id);

  function visibleSelectableRows(){
    return Array.from(list.querySelectorAll('.object-row')).filter(row=>{
      const type = row.dataset.type;
      const id = row.dataset.id;
      if(type === 'objectGroup') return false;
      return isObjectSelectable(type, id);
    });
  }

  function selectSingleRowStrict(row){
    const type = row.dataset.type;
    const id = row.dataset.id;
    const key = rowKey(row);
    if(type === 'objectGroup'){
      clearObjectMultiSelection();
      objectPanelRangeAnchorKey = null;
      objectPanelSelect(type, id, {toggleExpanded:true});
      return;
    }
    if(!isObjectSelectable(type, id)){
      setStatus('該物件已鎖定或不可視，無法選取。');
      return;
    }
    clearObjectMultiSelection();
    objectPanelRangeAnchorKey = key;
    selectedGroupId = null;
    objectPanelSelect(type, id);
  }

  function selectRangeToRowStrict(row){
    const type = row.dataset.type;
    const id = row.dataset.id;
    if(type === 'objectGroup'){
      const group = getObjectState(type, id);
      if(!group) return;
      const keys = objectGroupMemberKeys(group);
      multiSelectedObjectKeys = new Set(keys);
      selectedGroupId = id;
      renderObjectPanel();
      setStatus(`已選取群組內物件：${keys.length} 件。Ctrl+G 可再建立新群組。`);
      return;
    }
    if(!isObjectSelectable(type, id)){
      setStatus('該物件已鎖定或不可視，無法加入多選。');
      return;
    }

    const rows = visibleSelectableRows();
    const keys = rows.map(rowKey);
    const targetKey = makeObjectKey(type, id);
    let anchorKey = objectPanelRangeAnchorKey;
    if(!anchorKey || !keys.includes(anchorKey)){
      const selectedKey = selectedObjectKey();
      anchorKey = selectedKey && keys.includes(selectedKey) ? selectedKey : targetKey;
    }
    const a = keys.indexOf(anchorKey);
    const b = keys.indexOf(targetKey);
    if(a < 0 || b < 0){
      multiSelectedObjectKeys.add(targetKey);
      objectPanelRangeAnchorKey = targetKey;
    }else{
      const from = Math.min(a,b);
      const to = Math.max(a,b);
      multiSelectedObjectKeys = new Set(keys.slice(from, to + 1));
    }

    const preserved = new Set(multiSelectedObjectKeys);
    selectedGroupId = null;
    objectPanelSelect(type, id, {preserveMulti:true, fromRangeSelection:true});
    multiSelectedObjectKeys = preserved;
    selectedGroupId = null;
    renderObjectPanel();
    setStatus(`已連續選取 ${multiSelectedObjectKeys.size} 件物件。Ctrl+G 建立群組。`);
  }

  function ownObjectPanelPointer(e){
    if(!isLeftPointer(e)) return false;
    if(isInlineRenameTarget(e)) return false;
    const row = rowFromEvent(e);
    if(!row) return false;
    if(isButtonLikeTarget(e)) return false;
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation?.();
    if(e.shiftKey) selectRangeToRowStrict(row);
    else selectSingleRowStrict(row);
    return true;
  }

  document.addEventListener('pointerdown', e=>{
    ownObjectPanelPointer(e);
  }, true);

  document.addEventListener('mousedown', e=>{
    const row = rowFromEvent(e);
    if(!row || isInlineRenameTarget(e) || isButtonLikeTarget(e) || !isLeftPointer(e)) return;
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation?.();
  }, true);

  document.addEventListener('click', e=>{
    const row = rowFromEvent(e);
    if(!row || isInlineRenameTarget(e) || isButtonLikeTarget(e)) return;
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation?.();
  }, true);

  document.addEventListener('dblclick', e=>{
    if(isInlineRenameTarget(e)) return;
    const row = rowFromEvent(e);
    if(!row || !isPanelNameTarget(e)) return;
    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation?.();
    startObjectPanelInlineRename(row);
  }, true);

  document.addEventListener('selectstart', e=>{
    if(isInlineRenameTarget(e)) return;
    if(rowFromEvent(e)){
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation?.();
    }
  }, true);
}

function bindObjectPanel(){
  const list = $('objectList');
  if(!list || list.dataset.bound) return;
  list.dataset.bound = '1';
  let suppressNextClick = false;

  function getObjectPanelRowFromEvent(e){
    const row = e.target?.closest?.('.object-row');
    if(!row || !list.contains(row)) return null;
    return row;
  }

  function getObjectPanelActionFromEvent(e){
    return e.target?.closest?.('[data-action]')?.dataset?.action || 'select';
  }

  function handleObjectPanelRowActivation(e, source='click'){
    if(e.target.closest('.object-rename-input')) return true;
    const row = getObjectPanelRowFromEvent(e);
    if(!row) return false;
    const type = row.dataset.type;
    const id = row.dataset.id;
    const action = getObjectPanelActionFromEvent(e);
    const obj = getObjectState(type, id);
    if(!obj) return true;

    e.preventDefault();
    e.stopPropagation();

    if(action === 'visible'){
      if(source === 'click') setObjectFlag(type, id, 'visible', obj.visible === false);
      return true;
    }
    if(action === 'locked'){
      if(source === 'click') setObjectFlag(type, id, 'locked', !obj.locked);
      return true;
    }

    if(e.shiftKey){
      objectPanelRangeSelect(type, id);
      suppressNextClick = true;
      return true;
    }

    if(source !== 'click') return true;
    if(type === 'objectGroup'){
      clearObjectMultiSelection();
      objectPanelSelect(type, id, {toggleExpanded:true});
      return true;
    }
    clearObjectMultiSelection();
    objectPanelRangeAnchorKey = makeObjectKey(type, id);
    objectPanelSelect(type, id);
    return true;
  }

  list.addEventListener('pointerdown', e=>{
    if(e.button !== undefined && e.button !== 0) return;
    if(e.target.closest('button,input,select,textarea')) return;
    const row = getObjectPanelRowFromEvent(e);
    if(!row) return;
    e.preventDefault();
    if(e.shiftKey){
      handleObjectPanelRowActivation(e, 'pointerdown');
    }
  }, true);

  list.addEventListener('mousedown', e=>{
    if(e.button !== undefined && e.button !== 0) return;
    if(e.target.closest('button,input,select,textarea')) return;
    const row = getObjectPanelRowFromEvent(e);
    if(!row) return;
    e.preventDefault();
    if(e.shiftKey){
      handleObjectPanelRowActivation(e, 'mousedown');
    }
  }, true);

  list.addEventListener('selectstart', e=>{
    if(!e.target.closest('.object-rename-input')) e.preventDefault();
  }, true);

  list.addEventListener('click', e=>{
    if(e.target.closest('.object-rename-input')) return;
    const row = getObjectPanelRowFromEvent(e);
    if(!row) return;
    e.preventDefault();
    e.stopPropagation();
    if(suppressNextClick){
      suppressNextClick = false;
      return;
    }
    if(e.detail > 1) return;
    handleObjectPanelRowActivation(e, 'click');
  }, true);

  list.addEventListener('dblclick', e=>{
    const name = e.target.closest('.object-name');
    if(!name || e.target.closest('.object-rename-input')) return;
    const row = name.closest('.object-row');
    if(!row) return;
    e.preventDefault();
    e.stopPropagation();
    startObjectPanelInlineRename(row);
  }, true);

  installStrictObjectPanelRangeSelection(list);
}

document.addEventListener('focusin', e=>{ if(isTextEditingElement(e.target)) clearMovementKeys(); }, true);
document.addEventListener('focusout', e=>{ if(isTextEditingElement(e.target)) clearMovementKeys(); }, true);

function captureFloatingWindowStates(){
  const states = {};
  for(const id of ['editor','hud','status','tumorPanel','sinTowerAssetPanel','sinTowerFirePanel','objectPanel','lightPanel','chiselPanel']){
    const el = $(id);
    if(!el) continue;
    states[id] = {
      minimized: el.classList.contains('is-minimized'),
      left: el.style.left || '', top: el.style.top || '', width: el.style.width || '', height: el.style.height || ''
    };
  }
  return states;
}

function restoreFloatingWindowStates(states={}){
  for(const [id, st] of Object.entries(states || {})){
    const el = $(id);
    if(!el || !st) continue;
    el.classList.toggle('is-minimized', !!st.minimized);
    const btn = el.querySelector('.window-minimize');
    if(btn) btn.textContent = el.classList.contains('is-minimized') ? '+' : '–';
    if(st.left) el.style.left = st.left;
    if(st.top) el.style.top = st.top;
    if(st.width) el.style.width = st.width;
    if(st.height) el.style.height = st.height;
  }
}

function confirmPendingPlacementPreservingWindows(){
  const windowStates = captureFloatingWindowStates();
  const confirmed = confirmPendingWall() || confirmPendingArtwork() || confirmPendingFloorTile() || confirmPendingWaterBody();
  restoreFloatingWindowStates(windowStates);
  return confirmed;
}

let sinTowerFloatingTopZ = 80;
function bringFloatingWindowToFront(el){
  if(!el) return;
  sinTowerFloatingTopZ = Math.max(sinTowerFloatingTopZ + 1, 80);
  el.style.zIndex = String(sinTowerFloatingTopZ);
}

function setupFloatingWindows(){
  for(const id of ['editor','hud','status','tumorPanel','sinTowerAssetPanel','sinTowerFirePanel','objectPanel','lightPanel','chiselPanel']){
    const el = $(id);
    if(!el || el.dataset.floatingReady) continue;
    el.dataset.floatingReady = '1';
    el.classList.add('edit-ui','floating-window');
    el.addEventListener('pointerdown', ()=>bringFloatingWindowToFront(el), true);
    el.addEventListener('mousedown', ()=>bringFloatingWindowToFront(el), true);
    el.addEventListener('focusin', ()=>bringFloatingWindowToFront(el), true);
    bringFloatingWindowToFront(el);
    const title = el.dataset.windowTitle || id;
    const body = document.createElement('div');
    body.className = 'window-body';
    while(el.firstChild) body.appendChild(el.firstChild);
    const header = document.createElement('div');
    header.className = 'window-header';
    header.innerHTML = `<span class="window-title">${escapeHtml(title)}</span><button class="window-minimize" type="button" title="最小化">–</button>`;
    el.insertBefore(header, el.firstChild);
    el.appendChild(body);
    const rect = el.getBoundingClientRect();
    el.style.left = rect.left + 'px';
    el.style.top = rect.top + 'px';
    el.style.right = 'auto';
    el.style.bottom = 'auto';
    el.style.width = Math.max(rect.width, id === 'status' ? 240 : 180) + 'px';
    if(id !== 'status' && rect.height > 48) el.style.height = Math.min(rect.height, window.innerHeight - 28) + 'px';
    const minBtn = header.querySelector('.window-minimize');
    minBtn.addEventListener('click', ev=>{
      ev.stopPropagation();
      el.classList.toggle('is-minimized');
      minBtn.textContent = el.classList.contains('is-minimized') ? '+' : '–';
    });
    let dragging = false, startX=0, startY=0, baseX=0, baseY=0;
    header.addEventListener('pointerdown', ev=>{
      if(ev.target === minBtn) return;
      dragging = true;
      startX = ev.clientX; startY = ev.clientY;
      const r = el.getBoundingClientRect();
      baseX = r.left; baseY = r.top;
      header.setPointerCapture?.(ev.pointerId);
      ev.preventDefault();
    });
    header.addEventListener('pointermove', ev=>{
      if(!dragging) return;
      const nx = clamp(baseX + ev.clientX - startX, 0, window.innerWidth - 48);
      const ny = clamp(baseY + ev.clientY - startY, 0, window.innerHeight - 36);
      el.style.left = nx + 'px';
      el.style.top = ny + 'px';
    });
    const stop = ev=>{ dragging = false; try{ header.releasePointerCapture?.(ev.pointerId); }catch{} };
    header.addEventListener('pointerup', stop);
    header.addEventListener('pointercancel', stop);
  }
  bindObjectPanel();
  renderObjectPanel();
  updateEditingWindowsVisibility();
}

function updateCursorVisibility(){
  syncSinGifCursor();
  if(EXPORTED_GALLERY_VIEWER){
    document.body.classList.add('exported-viewer','play-mode');
    document.body.style.cursor = IS_TOUCH_DEVICE ? 'default' : 'none';
    if(renderer?.domElement) renderer.domElement.style.cursor = IS_TOUCH_DEVICE ? 'default' : 'none';
    hideChiselPreview();
    applyPlayModePerformanceLighting(true);
    return;
  }
  const hidden = pointerLocked || fallbackMouseLook || (!cursorFreeMode && desiredPointerLocked);
  const value = hidden ? 'none' : 'default';
  document.body.style.cursor = value;
  if(renderer?.domElement) renderer.domElement.style.cursor = value;
  if(hidden){
    clearSelectableSelection();
    forceSelectableOpaque();
    hideChiselPreview();
  }
  updateEditingWindowsVisibility();
}

function clearSelectableSelection(){
  selectedWallId = null;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedWaterBodyId = null;
  selectedArtworkActive = false;
  selectedReferenceArchitectureActive = false;
  selectedLightObjectActive = false;
  selectedGroupId = null;
  clearObjectMultiSelection();
  detachWallRotationControls();
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  refreshWaterSelectionVisuals();
  syncWaterEditor();
  syncWallEditor();
  syncObjectEditor();
  renderObjectPanel();
}

function forceSelectableOpaque(){
  for(const mesh of Object.values(surfaces)) applyWallVisualState(mesh, false, false);
  for(const [id,mesh] of Object.entries(customWallMeshes)){
    const w = STATE.customWalls.find(item=>item.id===id);
    applyWallVisualState(mesh, false, !!w?.isDraft);
  }
  for(const [id,mesh] of Object.entries(floorTileMeshes)){
    const t = (STATE.floorTiles || []).find(item=>item.id===id);
    applyWallVisualState(mesh, false, !!t?.isDraft);
  }
  for(const body of STATE.waterBodies || []) applyWaterVisualState(waterBodyMeshes[body.id], false, !!body.isDraft);
  for(const art of STATE.artworks || []) applyArtworkVisualState(artworkMeshes[art.id], false, !!art.isDraft);
}

function showCursorByEsc(){
  if(SIN_TOWER_PUBLISHED)return;
  document.body.classList.remove('sin-cursor-closing');
  pendingEscRelock = false;
  desiredPointerLocked = false;
  cursorFreeMode = true;
  fallbackMouseLook = false;
  resetFallbackLookAnchor();
  const hadPointerLock = pointerLocked || hasActivePointerLock();
  pointerLocked = false;
  if(hadPointerLock){
    try{ document.exitPointerLock?.(); }catch(error){ console.warn('Pointer Lock release failed',error); }
  }
  updateCursorVisibility();
  setStatus('滑鼠游標已顯示。現在可直接點選場景物件；點選畫面不會讓游標消失。');
}

function handleSinTowerHideCursorShortcut(event){
  const keyMatches=event?.code==='KeyM'||String(event?.key||'').toLowerCase()==='m';
  const modifierMatches=!!event?.shiftKey&&!event?.ctrlKey&&!event?.altKey&&!event?.metaKey;
  const modalOpen=sinTowerPortalGate.active||sinTowerPlayObjectUi.panelOpen||!!sinTowerPlayObjectUi.activePropId||sinTowerPlayObjectUi.shortcutOpen||sinTowerPlayObjectUi.stairJumpOpen||sinTowerPortalLayoutEditor.active||sinTowerMobileLayoutEditor.active;
  const inGame=EXPORTED_GALLERY_VIEWER||document.body.classList.contains('play-mode')||isPlayMode();
  if(!keyMatches||!modifierMatches||event?.repeat||isTextEditingElement(document.activeElement)||modalOpen||!inGame)return false;
  event.preventDefault?.();
  event.stopPropagation?.();
  event.stopImmediatePropagation?.();
  lockPointerAfterEscRelease();
  setStatus('Shift+M：滑鼠游標已隱藏，錄影中可繼續旋轉視角。');
  return true;
}

function lockPointerAfterEscRelease(){
  finishSinTowerObjectCursorMode();
  clearSelectableSelection();
  forceSelectableOpaque();
  cameraViewMode = 'shoulder';
  desiredPointerLocked = true;
  cursorFreeMode = false;
  fallbackMouseLook = !pointerLocked && !IS_TOUCH_DEVICE;
  resetFallbackLookAnchor();
  updateCursorVisibility();
  requestStablePointerLock();
  setStatus('滑鼠游標已隱藏。按 ESC 可再次顯示游標。');
  setTimeout(()=>{
    if(!pointerLocked && desiredPointerLocked && !cursorFreeMode){
      fallbackMouseLook = !IS_TOUCH_DEVICE;
      updateCursorVisibility();
      setStatus('已進入遊玩模式。Pointer Lock 尚未維持；點擊畫面會重新嘗試鎖定視角，浮動視窗不會自動彈回。');
    }
  }, 220);
}

function toggleCursorByEsc(){
  cancelWallEditModes();
  if(pointerLocked || fallbackMouseLook || (!cursorFreeMode && desiredPointerLocked)){
    showCursorByEsc();
    return;
  }
  // 不在 keydown 當下 requestPointerLock。瀏覽器會把同一次 ESC 視為解除鎖定，
  // 造成「隱藏一瞬間又彈出游標」。改到 keyup 後再鎖定。
  clearSelectableSelection();
  forceSelectableOpaque();
  pendingEscRelock = true;
  desiredPointerLocked = true;
  cursorFreeMode = false;
  fallbackMouseLook = false;
  updateCursorVisibility();
}



function pointerNDC(event){
  const rect = renderer.domElement.getBoundingClientRect();
  return pointerLocked
    ? new THREE.Vector2(0,0)
    : new THREE.Vector2(((event.clientX-rect.left)/rect.width)*2-1, -((event.clientY-rect.top)/rect.height)*2+1);
}

function selectCustomWall(id){
  if(!id || !customWallMeshes[id]) return false;
  selectedWallId = id;
  selectedRoomWallKey = null;
  selectedFloorTileId = null;
  selectedWaterBodyId = null;
  selectedArtworkActive = false;
  selectedReferenceArchitectureActive = false;
  selectedGroupId = null;
  clearObjectMultiSelection();
  syncWallEditor();
  refreshWallSelectionVisuals();
  refreshArtworkSelectionVisuals();
  renderObjectPanel();
  return true;
}

function selectRoomWall(key){
  if(!SURFACE_KEYS.includes(key) || !surfaces[key]) return false;
  selectedRoomWallKey = key;
  selectedWallId = null;
  selectedFloorTileId = null;
  selectedWaterBodyId = null;
  selectedArtworkActive = false;
  selectedReferenceArchitectureActive = false;
