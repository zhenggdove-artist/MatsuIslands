us(e.target.files?.[0] ? ('已選擇模型貼圖：' + e.target.files[0].name) : '未另選貼圖，將使用 GLB 內建材質。');
  $('sinInteractionClose').onclick = ()=>closeSinTowerInteraction(true,true);
  if($('sinQuestionClose'))$('sinQuestionClose').onclick=()=>closeSinTowerInteraction(true,true);
  for(const [id,answer] of [['sinQuestionNo','no'],['sinQuestionYes','yes']]){
    const button=$(id);if(!button)continue;
    button.onpointerdown=event=>event.stopPropagation();
    button.onclick=event=>{event.preventDefault();event.stopPropagation();answerSinTowerQuestion(answer);};
  }
  if($('sinQuestionBar')){
    $('sinQuestionBar').onpointerdown=beginSinTowerQuestionSwipe;
    $('sinQuestionBar').onpointermove=moveSinTowerQuestionSwipe;
    $('sinQuestionBar').onpointerup=endSinTowerQuestionSwipe;
    $('sinQuestionBar').onpointercancel=endSinTowerQuestionSwipe;
  }
  $('sinSelectedPropClose').onclick = ()=>closeSinTowerPlayPropActions(true);
  $('sinSelectedPropFollow').onclick = toggleSinTowerSelectedPropFollow;
  $('sinSelectedPropRotate').onclick = rotateSinTowerSelectedProp;
  $('sinSelectedPropDelete').onclick = deleteSinTowerSelectedPlayProp;
  $('sinSelectedPropScale').oninput = event=>resizeSinTowerSelectedProp(event.target.value);
  $('sinSelectedPropScale').onchange = event=>resizeSinTowerSelectedProp(event.target.value);
  if($('sinSelectedObjectAudioFile'))$('sinSelectedObjectAudioFile').onchange=async event=>{const file=event.target.files?.[0];try{if(file)await importSinTowerSelectedObjectAudio(file);}catch(error){setStatus('物件音效匯入失敗：'+String(error?.message||error));}event.target.value='';};
  if($('sinSelectedObjectAudioVolume'))$('sinSelectedObjectAudioVolume').oninput=updateSinTowerSelectedObjectAudioFromUi;
  if($('sinSelectedObjectAudioDistance'))$('sinSelectedObjectAudioDistance').oninput=updateSinTowerSelectedObjectAudioFromUi;
  if($('sinSelectedObjectAudioLoop'))$('sinSelectedObjectAudioLoop').onchange=updateSinTowerSelectedObjectAudioFromUi;
  if($('sinSelectedObjectAudioClear'))$('sinSelectedObjectAudioClear').onclick=()=>{const object=getSinTowerSelectedAudioObject();if(!object)return;object.audio=sanitizeSinTowerAudio(null,true);scheduleSinTowerRuntimeSave();syncSinTowerSelectedObjectAudioControls(object);updateSinTowerAudioRuntime(true);setStatus('已移除物件音效。');};
  for(const id of ['sinSelectedInteractionRadius','sinSelectedInteractionTitle','sinSelectedInteractionText','sinSelectedInteractionFont','sinSelectedInteractionTitleSize','sinSelectedInteractionBodySize','sinSelectedDocRadius','sinSelectedDocOpacity','sinSelectedVhsIntensity','sinSelectedVhsScan','sinSelectedVhsOffset','sinSelectedVhsSpeed','sinSelectedVhsNoise','sinSelectedQuestionSpeed','sinSelectedQuestionTextSize','sinSelectedQuestionTextOpacity','sinSelectedDissolveParticles','sinSelectedDissolveDensity']) if($(id)) $(id).oninput=updateSinTowerSelectedInteractionStyle;
  for(const id of ['sinSelectedInfectionEnabled','sinSelectedInfectionDirection','sinSelectedInfectionLayers'])if($(id))$(id).onchange=updateSinTowerSelectedInteractionStyle;
  if($('sinSelectedInteractionType'))$('sinSelectedInteractionType').onchange=updateSinTowerSelectedInteractionStyle;
  if($('sinSelectedInteractionPreview'))$('sinSelectedInteractionPreview').onclick=previewSinTowerSelectedInteraction;
  if($('sinSelectedQuestionAdd'))$('sinSelectedQuestionAdd').onclick=addSinTowerSelectedQuestion;
  if($('sinSelectedInteractionGlow')) $('sinSelectedInteractionGlow').onchange=updateSinTowerSelectedInteractionStyle;
  if($('sinSelectedInteractionParticles')) $('sinSelectedInteractionParticles').oninput=updateSinTowerSelectedInteractionStyle;
  for(const id of ['sinSelectedParticleAxisX','sinSelectedParticleAxisY','sinSelectedParticleAxisZ']) if($(id)) $(id).onchange=updateSinTowerSelectedInteractionStyle;
  for(const id of ['sinSelectedDriftEnabled','sinSelectedDriftX','sinSelectedDriftY','sinSelectedDriftZ']) if($(id)) $(id).onchange=updateSinTowerSelectedDrift;
  for(const id of ['sinSelectedDriftDistance','sinSelectedDriftSpeed','sinSelectedDriftIrregularity']) if($(id)) $(id).oninput=updateSinTowerSelectedDrift;
  if($('sinSelectedPortalSource')) $('sinSelectedPortalSource').onchange=updateSinTowerSelectedPortalRoute;
  if($('sinSelectedPortalTarget')) $('sinSelectedPortalTarget').onchange=updateSinTowerSelectedPortalRoute;
  if($('sinSelectedPortalPasswordEnabled')) $('sinSelectedPortalPasswordEnabled').onchange=updateSinTowerSelectedPortalSecurity;
  if($('sinSelectedPortalPassword')){
    $('sinSelectedPortalPassword').oninput=event=>{event.target.value=String(event.target.value||'').toUpperCase().replace(/[^0-9A-F]/g,'').slice(0,4);updateSinTowerSelectedPortalSecurity(false);};
    $('sinSelectedPortalPassword').onchange=()=>updateSinTowerSelectedPortalSecurity(true);
  }
  $('sinShortcutClose').onclick = ()=>closeSinTowerShortcutHelp(true,true);
  syncSinPlayObjectPanelVisibility();
}

function nearestSinTowerPropVisual(rec){
  let nearest=null,bestSquared=Infinity;
  for(const visual of rec?.visuals||[]){const p=visual?.group?.position;if(!p||visual.group.visible===false)continue;const dx=player.position.x-p.x,dz=player.position.z-p.z,dy=(player.position.y+player.height*.42-p.y)*.35,distanceSquared=dx*dx+dz*dz+dy*dy;if(distanceSquared<bestSquared){bestSquared=distanceSquared;nearest={visual,distanceSquared,position:p};}}
  if(nearest)nearest.distance=Math.sqrt(bestSquared);return nearest;
}

function getSinTowerInteractionFontStack(key){
  if(key === 'mono') return "'Courier New','Noto Sans TC',monospace";
  if(key === 'sans') return "Arial,'Noto Sans TC',sans-serif";
  if(key === 'gothic') return "'Noto Serif TC','Microsoft JhengHei',Georgia,serif";
  return "Georgia,'Noto Serif TC',serif";
}

function applySinTowerInteractionStyle(config){
  const paper = document.querySelector('.sin-interaction-paper');
  if(!paper) return;
  const opacity=clamp(safeFinite(config?.backgroundOpacity,.85),.05,1);
  const intensity=clamp(safeFinite(config?.vhsIntensity,1),0,2);
  const density=clamp(safeFinite(config?.vhsScanDensity,6),1,12);
  const offset=clamp(safeFinite(config?.vhsOffset,10),0,24);
  const speed=clamp(safeFinite(config?.vhsSpeed,5),0,20);
  const noise=clamp(safeFinite(config?.vhsNoise,.24),0,1);
  const cornerRadius=clamp(safeFinite(config?.cornerRadius,6),0,32);
  const questionTextSize=clamp(safeFinite(config?.questionTextSize,23),1,48);
  const questionTextOpacity=clamp(safeFinite(config?.questionTextOpacity,1),.1,1);
  const lineSize=clamp(8.2-density*.48,1.6,7.8);
  const paperColor=validColor(getScreenFxConfig()?.monoPaper)?getScreenFxConfig().monoPaper:'#f4d66f';
  paper.style.setProperty('--sin-interaction-font',getSinTowerInteractionFontStack(config?.fontFamily));
  paper.style.setProperty('--sin-interaction-title-size',clamp(safeFinite(config?.titleSize,38),1,72)+'px');
  paper.style.setProperty('--sin-interaction-body-size',clamp(safeFinite(config?.bodySize,18),1,42)+'px');
  paper.style.setProperty('--sin-doc-opacity',opacity.toFixed(3));
  paper.style.setProperty('--sin-doc-radius',cornerRadius.toFixed(1)+'px');
  paper.style.setProperty('--sin-doc-vhs-line-size',lineSize.toFixed(2)+'px');
  paper.style.setProperty('--sin-doc-vhs-noise',clamp(noise*intensity,0,1).toFixed(3));
  paper.style.setProperty('--sin-doc-vhs-speed',speed>0?Math.max(.08,2.8/(speed+.35)).toFixed(3)+'s':'999s');
  paper.style.setProperty('--hud-light',paperColor);
  const questionBar=$('sinQuestionBar');
  if(questionBar){
    questionBar.style.setProperty('--sin-doc-opacity',opacity.toFixed(3));
    questionBar.style.setProperty('--sin-doc-radius',cornerRadius.toFixed(1)+'px');
    questionBar.style.setProperty('--sin-question-font-size',questionTextSize.toFixed(1)+'px');
    questionBar.style.setProperty('--sin-question-text-opacity',questionTextOpacity.toFixed(3));
    questionBar.style.setProperty('--sin-doc-vhs-line-size',lineSize.toFixed(2)+'px');
    questionBar.style.setProperty('--sin-doc-vhs-noise',clamp(noise*intensity,0,1).toFixed(3));
    questionBar.style.setProperty('--sin-doc-vhs-speed',speed>0?Math.max(.08,2.8/(speed+.35)).toFixed(3)+'s':'999s');
  }
  $('sinInteractionVhsDisplacement')?.setAttribute('scale',(offset*intensity*.26).toFixed(2));
  $('sinInteractionVhsBorderDisplacement')?.setAttribute('scale',(offset*intensity).toFixed(2));
  $('sinInteractionVhsNoise')?.setAttribute('baseFrequency','0.006 '+(0.07+density*.019).toFixed(3));
  $('sinInteractionVhsBorderNoise')?.setAttribute('baseFrequency','0.004 '+(0.15+density*.045).toFixed(3));
}

function getSinTowerActiveInteractionRecord(){
  const id=sinTowerPlayObjectUi.activePropId;
  return id?(sinTowerEditorRuntime.props.get(id)||sinTowerEditorRuntime.models.get(id)||null):null;
}

function startSinTowerQuestionTypewriter(text,cps=22){
  const node=$('sinQuestionText'),characters=Array.from(String(text||'')),token=++sinTowerPlayObjectUi.questionTypewriterToken;
  if(!node)return;node.textContent='';node.scrollTop=0;node.classList.add('typing');
  const rate=clamp(safeFinite(cps,22),5,80),interval=Math.max(12,1000/rate);
  let visible=0;
  const tick=()=>{
    if(token!==sinTowerPlayObjectUi.questionTypewriterToken||!sinTowerPlayObjectUi.activePropId)return;
    visible=Math.min(characters.length,visible+1);
    node.textContent=characters.slice(0,visible).join('');node.scrollTop=node.scrollHeight;
    if(visible<characters.length)setTimeout(tick,interval);else node.classList.remove('typing');
  };
  tick();
}

function setSinTowerQuestionDrag(value=0){
  const bar=$('sinQuestionBar');
  const drag=clamp(safeFinite(value,0),-260,260);
  sinTowerPlayObjectUi.questionDragX=drag;
  bar?.style.setProperty('--sin-question-drag-x',drag.toFixed(1)+'px');
  if(bar) bar.dataset.direction=drag>36?'yes':drag<-36?'no':'';
}

function renderSinTowerActiveQuestion(){
  const rec=getSinTowerActiveInteractionRecord();
  const config=(rec?.prop||rec?.model)?.interaction;
  const questions=Array.isArray(config?.questions)?config.questions:[];
  if(!questions.length){closeSinTowerInteraction(true,false,true);return false;}
  sinTowerPlayObjectUi.questionIndex=clamp(Math.floor(safeFinite(sinTowerPlayObjectUi.questionIndex,0)),0,questions.length-1);
  const question=questions[sinTowerPlayObjectUi.questionIndex];
  startSinTowerQuestionTypewriter(question.text,config?.questionTypewriterCps);
  $('sinQuestionBar')?.classList.remove('dragging','answered');
  setSinTowerQuestionDrag(0);
  return true;
}

function openSinTowerQuestionInteraction(rec,nearest){
  if(isSinTowerInteractionPlacementActive())return;
  const object=rec?.prop||rec?.model,config=object?.interaction,overlay=$('sinQuestionOverlay');
  if(!object||!config?.enabled||config.consumed||config.dissolving||!Array.isArray(config.questions)||!config.questions.length||!overlay||sinTowerPlayObjectUi.panelOpen||sinTowerPlayObjectUi.activePropId)return;
  sinTowerPlayObjectUi.resultSession={object,type:config.type,preview:false,applied:false};
  sinTowerPlayObjectUi.activePropId=object.id;
  sinTowerPlayObjectUi.dismissedPropId=null;
  sinTowerPlayObjectUi.dismissedWorldPosition=null;
  sinTowerPlayObjectUi.activeWorldPosition=nearest.position.clone();
  sinTowerPlayObjectUi.lastPlayerPosition.copy(player.position);
  sinTowerPlayObjectUi.previousAutoRun=!!SIN_TOWER_STAIRCASE.autoRun;
  sinTowerPlayObjectUi.questionIndex=0;
  SIN_TOWER_STAIRCASE.autoRun=false;
  applySinTowerInteractionStyle(config);
  overlay.classList.remove('closing');$('sinQuestionBar')?.classList.remove('answered');
  overlay.classList.add('open');overlay.setAttribute('aria-hidden','false');
  document.body.classList.add('play-mode','sin-question-open');
  renderSinTowerActiveQuestion();setSinTowerModalCursorFree();
}

function collectSinTowerDissolveMaterials(rec){
  const records=[],seen=new Set(),remember=material=>{if(!material||seen.has(material))return;seen.add(material);records.push({material,opacity:safeFinite(material.opacity,1),transparent:material.transparent,depthWrite:material.depthWrite});material.transparent=true;material.depthWrite=false;};
  const roots=rec?.model?[rec.object]:(rec?.visuals||[]).map(visual=>visual.sprite);
  for(const root of roots)root?.traverse?.(node=>{for(const material of (Array.isArray(node.material)?node.material:[node.material]))remember(material);});
  if(rec?.prop)for(const frame of rec.frames||[])remember(frame?.material);
  return records;
}

function startSinTowerQuestionDissolve(rec,object){
  if(!rec||!object?.interaction)return false;
  const config=object.interaction,count=clamp(Math.round(safeFinite(config.dissolveParticleCount,4200)),400,12000),density=clamp(safeFinite(config.dissolveDensity,1.6),.25,4),positions=new Float32Array(count*3),velocities=new Float32Array(count*3),seed=safeFinite(object.id?.length,1)*977+performance.now()*.001;
  let sourceKind='fallback',modelSources=[];
  if(rec.model&&rec.object){rec.group.updateMatrixWorld(true);rec.object.updateMatrixWorld(true);rec.object.traverse(node=>{const attr=node.isMesh?node.geometry?.getAttribute?.('position'):null;if(attr?.count)modelSources.push({node,attr});});if(modelSources.length)sourceKind='model-surface';}
  const visuals=(rec.visuals||[]).filter(visual=>visual.group?.visible!==false),right=new THREE.Vector3(1,0,0).applyQuaternion(camera.quaternion).normalize(),point=new THREE.Vector3(),center=new THREE.Vector3();
  if(rec.model)new THREE.Box3().setFromObject(rec.object).getCenter(center);else if(visuals.length)center.copy(visuals[0].group.getWorldPosition(new THREE.Vector3()));else center.copy(player.position);
  for(let i=0;i<count;i++){
    if(modelSources.length){const source=modelSources[i%modelSources.length],index=Math.floor(sinTowerRand(seed+i*31.7)*source.attr.count);point.fromBufferAttribute(source.attr,index);source.node.localToWorld(point);}
    else if(visuals.length){const visual=visuals[i%visuals.length],prop=rec.prop,h=clamp(safeFinite(prop?.height,2),.1,600),ratio=clamp(safeFinite(visual.frame?.ratio,1),.02,20),w=h*ratio*clamp(safeFinite(prop?.widthMul,1),.1,12),contour=getSinTowerBillboardAlphaContour(visual.frames||visual.frame),p=contour?.length?contour[Math.floor(sinTowerRand(seed+i*41.3)*contour.length)%contour.length]:{x:sinTowerSignedRand(seed+i*43.1),y:sinTowerSignedRand(seed+i*47.7)};point.copy(visual.group.getWorldPosition(new THREE.Vector3())).addScaledVector(right,p.x*w*.5);point.y+=(p.y+1)*h*.5;sourceKind=contour?.length?'alpha-contour':'billboard-surface';}
    else point.copy(center).add(new THREE.Vector3(sinTowerSignedRand(seed+i*7),sinTowerRand(seed+i*11),sinTowerSignedRand(seed+i*13)));
    const radial=point.clone().sub(center),radialLength=Math.max(.001,radial.length()),speed=(.34+sinTowerRand(seed+i*53.7)*.92)*(.72+density*.2),swirl=sinTowerSignedRand(seed+i*59.1)*.34*density;
    radial.multiplyScalar(1/radialLength);positions[i*3]=point.x;positions[i*3+1]=point.y;positions[i*3+2]=point.z;velocities[i*3]=radial.x*speed-radial.z*swirl;velocities[i*3+1]=.22+Math.abs(radial.y)*.42+sinTowerRand(seed+i*61.9)*.5;velocities[i*3+2]=radial.z*speed+radial.x*swirl;
  }
  const geometry=new THREE.BufferGeometry();geometry.setAttribute('position',new THREE.BufferAttribute(positions,3));
  const paper=validColor(getScreenFxConfig()?.monoPaper)?getScreenFxConfig().monoPaper:'#f4d66f',material=new THREE.PointsMaterial({color:new THREE.Color(paper),size:.018+density*.006,sizeAttenuation:true,transparent:true,opacity:.95,depthWrite:false,depthTest:false,blending:THREE.AdditiveBlending,toneMapped:false});
  const points=new THREE.Points(geometry,material);points.name='問答完成物件解體微粒';points.frustumCulled=false;points.renderOrder=20;scene.add(points);
  const materialRecords=collectSinTowerDissolveMaterials(rec);config.glowEnabledBeforeDissolve=config.glowEnabled!==false;config.glowEnabled=false;config.dissolving=true;
  if(rec.model)syncSinTowerModelInteractiveFx(rec);else for(const visual of rec.visuals||[])setSinTowerPropVisualGlowEnabled(visual,object,false);
  sinTowerPlayObjectUi.dissolves.push({rec,object,points,positions,velocities,materialRecords,started:performance.now(),duration:1700,density,sourceKind,lastTick:-1});return true;
}

function finishSinTowerQuestionDissolve(effect){
  effect.points?.parent?.remove(effect.points);effect.points?.geometry?.dispose?.();effect.points?.material?.dispose?.();
  if(effect.rec?.model&&effect.rec.group)effect.rec.group.visible=false;
  if(effect.rec?.prop&&effect.rec.root)effect.rec.root.visible=false;
  const objectType=effect.rec?.model?'model':'prop',canonical=getSinTowerEditorObjectById(effect.object?.id,objectType),targets=new Set([effect.object,canonical,effect.rec?.model,effect.rec?.prop].filter(Boolean));
  for(const target of targets)if(target.interaction){target.interaction.dissolving=false;target.interaction.consumed=true;target.interaction.glowEnabled=false;}
  if(objectType==='model'&&canonical)effect.rec.model=canonical;
  if(objectType==='prop'&&canonical)effect.rec.prop=canonical;
  for(const record of effect.materialRecords||[]){record.material.opacity=record.opacity;record.material.transparent=record.transparent;record.material.depthWrite=record.depthWrite;record.material.needsUpdate=true;}
  scheduleSinTowerRuntimeSave();
}

function updateSinTowerQuestionDissolves(){
  const now=performance.now(),effects=sinTowerPlayObjectUi.dissolves||[];
  for(let e=effects.length-1;e>=0;e--){const effect=effects[e],progress=clamp((now-effect.started)/effect.duration,0,1),ease=1-Math.pow(1-progress,3),tick=Math.floor(now/33);if(effect.lastTick!==tick){effect.lastTick=tick;const attr=effect.points?.geometry?.getAttribute?.('position'),array=attr?.array;if(array){for(let i=0;i<effect.velocities.length/3;i++){const k=i*3,wave=Math.sin(progress*10+i*.73)*.004*effect.density;array[k]+=effect.velocities[k]*.033+wave;array[k+1]+=effect.velocities[k+1]*.033+.008*progress;array[k+2]+=effect.velocities[k+2]*.033-wave;}attr.needsUpdate=true;}}
    if(effect.points?.material){effect.points.material.opacity=Math.pow(1-progress,1.35);effect.points.material.size=(.018+effect.density*.006)*(1+ease*.85);}
    for(const record of effect.materialRecords||[])record.material.opacity=record.opacity*Math.max(0,1-ease*1.08);
    if(progress>=1){finishSinTowerQuestionDissolve(effect);effects.splice(e,1);}
  }
}

function answerSinTowerQuestion(answer){
  const rec=getSinTowerActiveInteractionRecord(),object=rec?.prop||rec?.model,config=object?.interaction;
  const questions=Array.isArray(config?.questions)?config.questions:[],question=questions[sinTowerPlayObjectUi.questionIndex];
  if(!question||sinTowerPlayObjectUi.questionTimer)return false;
  config.answers=Array.isArray(config.answers)?config.answers:[];config.answers.push({questionId:question.id,answer:answer==='yes'?'yes':'no',at:Date.now()});config.answers=config.answers.slice(-120);applySinAnswerEffect(answer);scheduleSinTowerRuntimeSave();
  sinTowerPlayObjectUi.questionTypewriterToken+=1;const bar=$('sinQuestionBar'),text=$('sinQuestionText');if(bar){bar.dataset.direction=answer==='yes'?'yes':'no';bar.classList.remove('dragging');bar.classList.add('answered');}setSinTowerQuestionDrag(0);if(text){text.classList.remove('typing');text.textContent='我明白了';text.scrollTop=0;}
  sinTowerPlayObjectUi.questionTimer=setTimeout(()=>{sinTowerPlayObjectUi.questionTimer=null;if(sinTowerPlayObjectUi.questionIndex+1<questions.length){sinTowerPlayObjectUi.questionIndex+=1;renderSinTowerActiveQuestion();return;}const canonicalType=rec?.model?'model':'prop',canonicalObject=getSinTowerEditorObjectById(object?.id,canonicalType)||object;if(sinTowerPlayObjectUi.resultSession)sinTowerPlayObjectUi.resultSession.postReady=true;startSinTowerQuestionDissolve(rec,canonicalObject);syncSinTowerPlayPropActions();scheduleSinTowerRuntimeSave();setStatus('問答完成：物件正化為 '+canonicalObject.interaction.dissolveParticleCount+' 顆發光微粒並消散。');closeSinTowerInteraction(true,false);},1200);return true;
}

function beginSinTowerQuestionSwipe(event){
  if(!sinTowerPlayObjectUi.activePropId||event.button>0)return;
  sinTowerPlayObjectUi.questionPointerId=event.pointerId;
  sinTowerPlayObjectUi.questionPointerStartX=event.clientX;
  $('sinQuestionBar')?.classList.add('dragging');
  try{$('sinQuestionBar')?.setPointerCapture?.(event.pointerId);}catch{}
  event.preventDefault();
}

function moveSinTowerQuestionSwipe(event){
  if(event.pointerId!==sinTowerPlayObjectUi.questionPointerId)return;
  setSinTowerQuestionDrag(event.clientX-sinTowerPlayObjectUi.questionPointerStartX);event.preventDefault();
}

function endSinTowerQuestionSwipe(event){
  if(event.pointerId!==sinTowerPlayObjectUi.questionPointerId)return;
  const drag=sinTowerPlayObjectUi.questionDragX;
  sinTowerPlayObjectUi.questionPointerId=null;$('sinQuestionBar')?.classList.remove('dragging');
  try{$('sinQuestionBar')?.releasePointerCapture?.(event.pointerId);}catch{}
  if(Math.abs(drag)>=70)answerSinTowerQuestion(drag>0?'yes':'no');else setSinTowerQuestionDrag(0);
  event.preventDefault();
}

function updateSinTowerInteractionVhsEffect(){
  const rec=getSinTowerActiveInteractionRecord(),config=(rec?.prop||rec?.model)?.interaction;
  if(config?.type!=='text')return;
  const speed=clamp(safeFinite(config.vhsSpeed,5),0,20);if(speed<=0)return;
  const now=performance.now(),period=Math.max(45,620/(speed+.25));
  if(now-sinTowerPlayObjectUi.vhsSeedAt<period)return;
  sinTowerPlayObjectUi.vhsSeedAt=now;
  const seed=17+(Math.floor(now/period)%911);
  $('sinInteractionVhsNoise')?.setAttribute('seed',String(seed));
  $('sinInteractionVhsBorderNoise')?.setAttribute('seed',String(seed+37));
}

const SIN_RPS_IMAGES={"scissors":"data:image/png;base64,","rock":"data:image/png;base64,","paper":"data:image/png;base64,"};
const SIN_RPS_KINDS=['scissors','rock','paper'];
const SIN_RPS_NAMES={scissors:'剪刀',rock:'石頭',paper:'布'};
let sinRpsSession=null;
let sinRpsImagesReady=null;
function prepareSinTowerRpsImages(){return sinRpsImagesReady ||= Promise.all(SIN_RPS_KINDS.map(kind=>{const img=new Image();img.src=SIN_RPS_IMAGES[kind];return img.decode();}));}
function sanitizeSinTowerRpsLayout(raw){
  const defaults=[[-.15,.08,.115,.18],[0,.08,.115,.18],[.15,.08,.115,.18],[0,-.14,.13,.20]];
  return defaults.map((d,i)=>({x:clamp(safeFinite(raw?.[i]?.x,d[0]),-1,1),y:clamp(safeFinite(raw?.[i]?.y,d[1]),-1,1),w:clamp(safeFinite(raw?.[i]?.w,d[2]),.025,.8),h:clamp(safeFinite(raw?.[i]?.h,d[3]),.035,.8)}));
}
function sinTowerRpsOutcome(playerKind,opponentKind){
  if(playerKind===opponentKind)return 'draw';
  return ({scissors:'paper',paper:'rock',rock:'scissors'})[playerKind]===opponentKind?'win':'lose';
}
function ensureSinTowerRpsUi(){
  if($('sinRpsOverlay'))return;
  const style=document.createElement('style');style.id='sinRpsStyle';style.textContent=`
  #sinRpsOverlay{position:fixed;inset:0;z-index:9000;pointer-events:none;color:#ffe16b;font-family:inherit}
  #sinRpsOverlay[hidden]{display:none!important}
  body.sin-rps-active #sinPlayObjectActions{visibility:hidden}
  .sin-rps-card{position:absolute;box-sizing:border-box;border:1px solid transparent;border-radius:9px;background:transparent!important;padding:4px;pointer-events:auto;touch-action:none;cursor:pointer;min-width:0;min-height:0;box-shadow:none}
  .sin-rps-card img{width:100%;height:100%;object-fit:contain;pointer-events:none;mix-blend-mode:screen;filter:grayscale(1) sepia(1) saturate(2);display:block}
  .sin-rps-card.selected{border-color:#ffe16b;box-shadow:0 0 12px #ffe16b66}
  .sin-rps-card .rps-name{position:absolute;bottom:-23px;left:0;width:100%;text-align:center;font-size:16px;text-shadow:0 0 4px #000;color:#ffe16b}
  #sinRpsStatus{position:absolute;text-align:center;white-space:pre-line;font-size:22px;text-shadow:0 2px 6px #000;pointer-events:none}
  #sinRpsToolbar{position:absolute;top:12px;left:50%;transform:translateX(-50%);pointer-events:auto;display:flex;gap:8px}
  #sinRpsToolbar button{background:#15283a;color:#ffe16b;border:1px solid #ffe16b;border-radius:6px;padding:8px 14px}
  #sinRpsOverlay.editing .sin-rps-card{border:1px dashed #ffe16b}
  .rps-handle{display:none;position:absolute;width:12px;height:12px;background:#ffe16b;border:1px solid #15283a;z-index:2}
  #sinRpsOverlay.editing .rps-handle{display:block}
  .rps-handle[data-corner=nw]{left:-6px;top:-6px;cursor:nwse-resize}.rps-handle[data-corner=ne]{right:-6px;top:-6px;cursor:nesw-resize}
  .rps-handle[data-corner=sw]{left:-6px;bottom:-6px;cursor:nesw-resize}.rps-handle[data-corner=se]{right:-6px;bottom:-6px;cursor:nwse-resize}
  #sinRpsParticles{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
  `;document.head.append(style);
  const overlay=document.createElement('div');overlay.id='sinRpsOverlay';overlay.hidden=true;
  overlay.innerHTML='<canvas id="sinRpsParticles"></canvas><div id="sinRpsStatus" role="status"></div><div id="sinRpsToolbar" style="display:none"><button id="sinRpsResetLayout" hidden>重設版面</button><button id="sinRpsDone">完成</button></div>';
  for(let i=0;i<4;i++){
    const card=document.createElement('button');card.className='sin-rps-card';card.id='sinRpsCard'+i;card.type='button';card.setAttribute('aria-label',i<3?SIN_RPS_NAMES[SIN_RPS_KINDS[i]]:'對手出拳');
    card.innerHTML='<img draggable="false">'+['nw','ne','sw','se'].map(c=>'<span class="rps-handle" data-corner="'+c+'"></span>').join('');
    card.onclick=()=>{if(sinRpsSession&&!sinRpsSession.editing&&!sinRpsSession.revealed&&i<3){sinRpsSession.selected=i;updateSinTowerRps();}};
    card.onpointerdown=e=>beginSinTowerRpsDrag(e,i);overlay.append(card);
  }
  document.body.append(overlay);
  $('sinRpsDone').onclick=()=>closeSinTowerInteraction(true,false,true);
  $('sinRpsResetLayout').onclick=()=>{if(sinRpsSession){sinRpsSession.object.interaction.rpsLayout=sanitizeSinTowerRpsLayout(null);commitSinTowerRpsLayout();updateSinTowerRps();}};
}
// Embedded into the standalone game by the patch script. Keep assets in saved state.
function sanitizeSinAnswerEffects(raw,fallback){
  return {yes:sanitizeSinTowerInfectionEffect(raw?.yes??fallback),no:sanitizeSinTowerInfectionEffect(raw?.no??fallback)};
}
function sanitizeSinMediaRect(raw,defaultRect){
  return {x:clamp(safeFinite(raw?.x,defaultRect.x),0,1),y:clamp(safeFinite(raw?.y,defaultRect.y),0,1),w:clamp(safeFinite(raw?.w,defaultRect.w),.02,1),h:clamp(safeFinite(raw?.h,defaultRect.h),.02,1)};
}
function sanitizeSinAfterVideo(raw){
  return {monoFilter:raw?.monoFilter===true,enabled:raw?.enabled===true,src:typeof raw?.src==='string'&&/^data:video\/mp4[;,]/i.test(raw.src)?raw.src:'',name:String(raw?.name||'').slice(0,240),frameSrc:typeof raw?.frameSrc==='string'&&/^data:image\/gif[;,]/i.test(raw.frameSrc)?raw.frameSrc:'',frameName:String(raw?.frameName||'').slice(0,240),layout:{video:sanitizeSinMediaRect(raw?.layout?.video,{x:.5,y:.5,w:.58,h:.5}),frame:sanitizeSinMediaRect(raw?.layout?.frame,{x:.5,y:.5,w:.66,h:.62})}};
}
function sanitizeSinCustomCursor(raw){
  return {enabled:raw?.enabled!==false,src:typeof raw?.src==='string'&&/^data:image\/gif[;,]/i.test(raw.src)?raw.src:'',name:String(raw?.name||'').slice(0,240),size:clamp(safeFinite(raw?.size,40),8,160),anchorVersion:2,hotX:clamp(safeFinite(raw?.anchorVersion===2?raw.hotX:50,50),0,100),hotY:clamp(safeFinite(raw?.anchorVersion===2?raw.hotY:50,50),0,100)};
}
function measureSinCursorCenter(img){
  const w=img.naturalWidth,h=img.naturalHeight;if(!w||!h)return;
  // Measure once per source, before filtering; animation must not move the hotspot.
  const scale=Math.min(1,256/Math.max(w,h)),canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(w*scale));canvas.height=Math.max(1,Math.round(h*scale));
  try{const ctx=canvas.getContext('2d',{willReadFrequently:true});ctx.drawImage(img,0,0,canvas.width,canvas.height);const p=ctx.getImageData(0,0,canvas.width,canvas.height).data;let x0=canvas.width,y0=canvas.height,x1=-1,y1=-1;
    for(let y=0;y<canvas.height;y++)for(let x=0;x<canvas.width;x++)if(p[(y*canvas.width+x)*4+3]>16){x0=Math.min(x0,x);x1=Math.max(x1,x);y0=Math.min(y0,y);y1=Math.max(y1,y);}
    const fit=Math.max(w,h);img._sinCenter=x1<0?{x:.5,y:.5}:{x:(1-w/fit)/2+(x0+x1+1)/2/canvas.width*w/fit,y:(1-h/fit)/2+(y0+y1+1)/2/canvas.height*h/fit};
  }catch{img._sinCenter={x:.5,y:.5};}syncSinGifCursor();
}
function hideSinInteractionCursor(){
  sinCustomCursorPosition.inside=false;const img=$('sinGifCursor');if(img)img.hidden=true;
  document.body.classList.remove('sin-gif-cursor');document.body.classList.add('sin-cursor-closing');
}
let sinAfterVideoSession=null;
let sinCustomCursorPosition={x:0,y:0,inside:false};
function sinExtraObject(id){return SIN_TOWER_EDITOR.props.find(o=>o.id===id)||SIN_TOWER_EDITOR.models.find(o=>o.id===id);}
function commitSinExtraInteraction(object,patch){
  if(!object)return;
  const canonical=sinExtraObject(object.id)||object,rec=sinTowerEditorRuntime.props.get(object.id)||sinTowerEditorRuntime.models.get(object.id);
  for(const target of new Set([canonical,object,rec?.prop,rec?.model].filter(Boolean)))Object.assign(target.interaction,patch);
  scheduleSinTowerRuntimeSave();
}
function applySinAnswerEffect(answer){
  const session=sinTowerPlayObjectUi.resultSession;if(!session||session.preview)return;
  const cfg=session.object.interaction,effects=sanitizeSinAnswerEffects(cfg.answerEffects,cfg.infectionEffect),effect=effects[answer==='yes'?'yes':'no'];
  if(effect.enabled)changeSinTowerInfectionLayers((effect.direction==='remove'?-1:1)*effect.layers);
}
async function readSinLoopingGif(file){
  const bytes=new Uint8Array(await file.arrayBuffer());
  if(String.fromCharCode(...bytes.subarray(0,6))!=='GIF89a'&&String.fromCharCode(...bytes.subarray(0,6))!=='GIF87a')throw Error('請選擇有效的 GIF 檔案');
  const tag='NETSCAPE2.0';let found=false;
  for(let i=0;i<bytes.length-16;i++){if(bytes[i]!==33||bytes[i+1]!==255||bytes[i+2]!==11)continue;if(String.fromCharCode(...bytes.subarray(i+3,i+14))===tag&&bytes[i+14]===3&&bytes[i+15]===1){bytes[i+16]=0;bytes[i+17]=0;found=true;break;}}
  let result=bytes;if(!found){const offset=13+((bytes[10]&128)?3*(1<<((bytes[10]&7)+1)):0);const ext=new Uint8Array([33,255,11,...Array.from(tag,c=>c.charCodeAt(0)),3,1,0,0,0]);result=new Uint8Array(bytes.length+ext.length);result.set(bytes.subarray(0,offset));result.set(ext,offset);result.set(bytes.subarray(offset),offset+ext.length);result[4]=57;result[5]=97;}
  return readSinTowerBlobAsDataUrl(new Blob([result],{type:'image/gif'}));
}
function ensureSinExtraUi(){
