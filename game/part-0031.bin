  selectedGroupId = null;
  clearObjectMultiSelection();
  detachWallRotationControls();
  if($('surfaceSelect')) $('surfaceSelect').value = key;
  syncSurfaceEditor();
  syncWallEditor();
  refreshWallSelectionVisuals();
  renderObjectPanel();
